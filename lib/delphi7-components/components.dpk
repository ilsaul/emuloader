package components;

{$R *.res}
{$R 'barmenus\Source\BarMenuRegister.dcr'}
{$R 'ExTrackBar.dcr'}
{$R 'SplitterEx.dcr'}
{$R 'PanelEx.dcr'}
{$R 'AdvComponents\AdvGroupBoxReg.dcr'}
{$R 'AdvComponents\AdvOfficeButtonsReg.dcr'}
{$R 'ShadowLabel.dcr'}
{$R 'SevenZipVCL\SevenZipVCL.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Misc Components'}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide,
  vclactnband,
  vclx,
  vcljpg,
  dbrtl,
  vcldb;

contains
  GraphicEx in 'graphicex\graphicEx.pas',
  BarMenuRegister in 'barmenus\Source\BarMenuRegister.pas',
  RichEditURL in 'RichEditURL.pas',
  ExTrackBar in 'ExTrackBar.pas',
  SplitterEx in 'SplitterEx.pas',
  PanelEx in 'PanelEx.pas',
  AdvGroupBoxReg in 'AdvComponents\AdvGroupBoxReg.pas',
  AdvOfficeButtonsReg in 'AdvComponents\AdvOfficeButtonsReg.pas',
  ShadowLabel in 'ShadowLabel.pas',
  SevenZipVCL in 'SevenZipVCL\SevenZipVCL.pas',
  EditEx in 'EditEx.pas',
  ButtonsEx in 'ButtonsEx.pas',
  BevelEx in 'BevelEx.pas',
  ColorBoxEx in 'ColorBoxEx.pas',
  XiControls in 'XiControls\XiControls.pas';

end.
