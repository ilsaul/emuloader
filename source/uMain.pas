function TFormMain.VideoPreviewValidateSnapFolder(const FilePath: WideString): WideString;
var
  Search: TSearchRecW;
  FileExt: WideString;
  FoundValidFile: Boolean;
begin
  Result:= '';
  FoundValidFile:= False;
  if FindFirstW(FilePath+'.*', $37, Search) = 0 then
     begin
       repeat
         FileExt:= ExtractFileExtW(Search.Name);
         if (not SameText(FileExt, '.png')) and (not SameText(FileExt, '.jpg')) and (not SameText(FileExt, '.gif'))then
            FoundValidFile:= True;
       until FoundValidFile or (FindNextW(Search) <> 0);
       if FoundValidFile then
          Result:= FilePath+Search.Name;
     end;
  FindCloseW(Search);
end;

function TFormMain.VideoPreviewFindFile(sysID, CustomSysID: ShortInt; IsCustomGame: Boolean; const GameName, CloneOfName: WideString; const SoftwareName: String = ''): WideString;
var
  Search: TSearchRecW;
  Folder, FolderSoftware, FolderSnap, FolderVideoSnap, FolderEmuVideo, FolderVideoSnap_SL, FolderEmuVideo_SL, FolderVideoSnapDouble: String;
  FileToLoad, FileStr: WideString;
begin
  Result:= '';
  if VideoPreviewMediaPlayerExecutable = '' then
     Exit;

  Folder:= ''; // var to generate the full path from "ArcadeVideoPreviewDir[]" and "ConsoleComputerVideoPreviewDir[]" arrays
  if IsCustomGame then
     begin
       FileStr:= ChangeFileExtW(GameName, '');
       if ConsoleComputerVideoPreviewDir[CustomSysID] <> '' then
          Folder:= FullFolderFix(ConsoleComputerVideoPreviewDir[CustomSysID]);
     end
  else
     begin
       FileStr:= GameName;
       if ArcadeVideoPreviewDir[sysID] <> '' then
          Folder:= FullFolderFix(ArcadeVideoPreviewDir[sysID]);
     end;

  FolderSoftware:= '';
  if SoftwareName <> '' then
     FolderSoftware:= SoftwareName+'\';


  if Folder <> '' then
     begin
       FolderVideoSnapDouble:= 'videosnaps\';
       if FindFirstW(Folder+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
          Result:= Folder+FolderSoftware+Search.Name
       else
          begin
            // this is for arcade games only
            if GameIsClone(CloneOfName) and (VideoPreviewParentGameVideo) then
               begin
                 if FindFirstW(Folder+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                    Result:= Folder+FolderSoftware+Search.Name;
               end;
          end;
     end;
  if (Result = '') and (SoftwareName = '')  then
     begin
       FolderVideoSnapDouble:= 'videosnaps\';
       if FindFirstW(Folder+FolderVideoSnapDouble+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
          Result:= Folder+FolderVideoSnapDouble+FolderSoftware+Search.Name
       else
          begin
            // this is for arcade games only
            if GameIsClone(CloneOfName) and (VideoPreviewParentGameVideo) then
               begin
                 if FindFirstW(Folder+FolderVideoSnapDouble+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                    Result:= Folder+FolderVideoSnapDouble+FolderSoftware+Search.Name;
               end;
          end;
     end;

  if Result = '' then
     begin
       if IsCustomGame then
          begin
            FolderEmuVideo:= ''; // "emudir\" is NOT supported for EmuCon systems!!! //ExtractFilePath(EmulatorFile[CustomSysID])+'videosnaps\';
            FolderSnap:= FullFolderFix(SnapshotFolderCustom[CustomSysID, 1]);
            FolderEmuVideo_SL:= '';
          end
       else
          begin
            FolderEmuVideo:= ExtractFilePath(EmulatorFile[sysID])+'videosnaps\';
            FolderSnap:= FullFolderFix(imgFolder[sysID, 1], EmulatorFile[sysID]);
            FolderEmuVideo_SL:= ExtractFilePath(EmulatorFile[sysID])+'videosnaps_sl\';
          end;
       if (FolderSnap <> '') or (FolderEmuVideo <> '') then
       begin
         FolderVideoSnap:= FolderSnap+'videosnaps\';
         FolderVideoSnap_SL:= FolderSnap+'videosnaps_sl\';
         if FindFirstW(FolderEmuVideo+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
            Result:= FolderEmuVideo+FolderSoftware+Search.Name
         else
         if FindFirstW(FolderVideoSnap+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
            Result:= FolderVideoSnap+FolderSoftware+Search.Name
         else
         if SoftwareName <> '' then
            begin // scan "\videosnaps_sl\" sub-folder for MAME software list games
              if FindFirstW(FolderEmuVideo_SL+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
                 Result:= FolderEmuVideo_SL+FolderSoftware+Search.Name
              else
              if FindFirstW(FolderVideoSnap_SL+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
                 Result:= FolderVideoSnap_SL+FolderSoftware+Search.Name
            end
         else
            begin
              FileToLoad:= VideoPreviewValidateSnapFolder(FolderSnap+FolderSoftware+FileStr);
              if FileToLoad <> '' then
                 Result:= FileToLoad
              else
                 begin
                    if GameIsClone(CloneOfName) and (VideoPreviewParentGameVideo) then
                       begin
                         if FindFirstW(FolderEmuVideo+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                            Result:= FolderEmuVideo+FolderSoftware+Search.Name
                         else
                         if FindFirstW(FolderVideoSnap+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                            Result:= FolderVideoSnap+FolderSoftware+Search.Name
                         else
                            begin
                              FileToLoad:= VideoPreviewValidateSnapFolder(FolderSnap+FolderSoftware+CloneOfName);
                              if FileToLoad <> '' then
                                 Result:= FileToLoad;
                            end;
                       end;
                 end;
            end;
       end;
     end;
  FindCloseW(Search);
end;

procedure TFormMain.VideoPreviewPlay(StopCurrentPlayback: Boolean = False);
var
  cmdLine, iParams, iFileName: WideString;
begin
  case StopCurrentPlayback of
    True:
      begin
        iParams:= VideoPreviewDummyVideoParameters;
        if iParams = '' then
           iParams:= VideoPreviewMediaPlayerParameters;
        iFileName:= GetFolderFull(35)+'novideo.avi';
      end;
    False:
      begin
        iFileName:= VideoPreviewFile;
        iParams:= VideoPreviewMediaPlayerParameters;
        if iParams = '' then
           iParams:= '%1';
      end;
  end;
  if StopCurrentPlayback then
     begin
       if not FileExistsW(iFileName) then
       begin
         PlayDummyVideoPreview:= False;
         Exit;
       end;
     end;
  case StopCurrentPlayback of
    True:
      begin
        if Pos('%1', iParams) <> 0 then
           iParams:= StringReplaceW(iParams, '%1', '"'+iFileName+'"', [rfIgnoreCase]);
      end;
    False: iParams:= StringReplaceW(iParams, '%1', '"'+iFileName+'"', [rfIgnoreCase]);
  end;

  cmdLine:= SystemStr+VideoPreviewMediaPlayerExecutable+SystemStr+' ';
  cmdLine:= cmdLine+iParams;

  if IsExeBatchFile(VideoPreviewMediaPlayerExecutable) then
     cmdLine:= CommandPromptStr+SystemStr+cmdLine+SystemStr;

  if VideoPreviewPlayDummyVideo then
     PlayDummyVideoPreview:= not StopCurrentPlayback;

  RunProcess(cmdLine, False, SW_SHOWNORMAL);
end;

procedure TFormMain.VideoPreviewPlayDummy(ForcePlayback: Boolean = False);
begin
  if VideoPreviewPlayDummyVideo then
     begin
       if PlayDummyVideoPreview then
          begin
            if (VideoPreviewFile = '') or ForcePlayback then
               VideoPreviewPlay(True);
          end;
     end;
end;

procedure TFormMain.OpenGameManualPDF;
var
  CommandLine, ErrorMsgTitle, AppTitle, AssociatedApp, ManualsFolderDouble, SoftwareNameFolder: String;
  FileFullPath: WideString;

  function AddEmulatorHeader: Boolean;
  begin
    AddMsgText('Associated Application   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
    AddMsgText(AppTitle+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
    AddMsgText(#13#10);
  end;

  procedure ResetToFrontend;
  begin
    ThousandSeparator:= Char(',');
    DecimalSeparator:= Char('.');
    SetCurrentDir(FrontendPath);
    FocusGamesList;
  end;

begin
  if not ValidateSelectedGame then
     Exit;

  if MemGameInfo.eIsCustomGame then
     Exit;

  if not IsMAMEBasedSys(MemGameInfo.eSystemID) then
     Exit;

  //if MemGameInfo.eSoftwareName <> '' then
  //   Exit;

  ErrorMsgTitle:= 'Error: View Game Manual in PDF';
  AssociatedApp:= GetAssociatedApp('.pdf');
  if AssociatedApp = '' then
     begin
       AppTitle:= 'error';
       CallMessageBox;
       EnableMsgMediaTypeLabel(False, True);
       AddEmulatorHeader;
       AddMsgText('File extension');
       AddMsgText('.pdf', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' is not associated with any application!'+#13#10+#13#10+
                  '    Please associate PDF files in Windows with the application of your choice.');
       GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
       ResetToFrontend;
       Exit;
     end;
  AppTitle:= GetAssociatedApp('.pdf', True);
  if AppTitle <> '' then
     AppTitle:= GetFileInfoW(AppTitle, VersionInfo[2])
  else
     AppTitle:= AssociatedApp;

  ManualsFolderDouble:= 'manuals\';
  SoftwareNameFolder:= '';
  if MemGameInfo.eSoftwareName <> '' then
     SoftwareNameFolder:= MemGameInfo.eSoftwareName+'\';
  FileFullPath:= MAMEFolderManualPDF+SoftwareNameFolder+MemGameInfo.eName+'.pdf';
  if not FileExistsW(FileFullPath) then
     begin
       FileFullPath:= MAMEFolderManualPDF+ManualsFolderDouble+SoftwareNameFolder+MemGameInfo.eName+'.pdf';
       if not FileExistsW(FileFullPath) then
       begin
         if GameIsClone(MemGameInfo.eClone) then
            begin
              FileFullPath:= MAMEFolderManualPDF+SoftwareNameFolder+MemGameInfo.eClone+'.pdf';
              if not FileExistsW(FileFullPath) then
                 begin
                   FileFullPath:= MAMEFolderManualPDF+ManualsFolderDouble+SoftwareNameFolder+MemGameInfo.eClone+'.pdf';
                   if not FileExistsW(FileFullPath) then
                      Exit;
                 end;
            end
         else
            Exit;
       end;
     end;

  CommandLine:= StringReplaceW(AssociatedApp, '%1', FileFullPath, [rfIgnoreCase]);
  RunProcess(CommandLine);
  ResetToFrontend;
end;

procedure TFormMain.ELV_CheckItemVisible(ELV_Holder: TEasyListView; Item: TEasyItem; ShowInTheMiddle: Boolean);
var
  RectArray: TEasyRectArrayObject;
  R: TRect;
begin
  if IsRunningGame then
     Exit;
  Item.View.ItemRectArray(Item, ELV_Holder.Header.FirstVisibleColumn, ELV_Holder.Canvas, '', RectArray);
  R:= RectArray.BoundsRect;
  if not ContainsRect(ELV_Holder.ClientInViewportCoords, R) then
     begin
       case ShowInTheMiddle of
         True : Item.MakeVisible(emvMiddle); // this will only be used when changing filters or creating games lists
         False: Item.MakeVisible(emvAuto);   // it must be Auto to avoid bug when scrolling the list with UP/DOWN arrow keys
       end;
     end;
end;

procedure TFormMain.ELV_SetGhostedIcon(ELV_Item: TEasyItem);
begin
  case ELV_Item.Tag of
    0: // available system
      begin
        case ELV_Item.Checked of
          True : ELV_Item.State:= ELV_Item.State-[esosGhosted];
          False: ELV_Item.State:= ELV_Item.State+[esosGhosted];
        end;
      end;
    -1: // unavailable system
      begin
        ELV_Item.State:= ELV_Item.State+[esosGhosted];
      end;
  end;
end;

procedure TFormMain.ELV_SetGhostedIconText(ELV_Item: TEasyItem; ELV_Source: TEasyListView; CanvasDestination: TCanvas);
begin
  if ELV_Source.PaintInfoItem.CheckType = ectNone then
     begin
       if ELV_Item.Ghosted then
          begin
            if IsNightMode then
               CanvasDestination.Font.Color:= clrDarkGray
            else
               CanvasDestination.Font.Color:= clMedGray;
          end;
     end
  else
     begin
       case ELV_Item.Tag of
         0: // available system
           begin
             if ELV_Item.Ghosted then
                begin
                  if IsNightMode then
                     begin
                       if ELV_Item.Selected then
                          CanvasDestination.Font.Color:= clrDarkGray
                       else
                          CanvasDestination.Font.Color:= clMedGray;
                     end
                  else
                     CanvasDestination.Font.Color:= clMedGray;
                end;
             //if not ELV_Item.Checked then
             //   CanvasDestination.Font.Color:= clMedGray;
           end;
         -1: // unavailable system
           begin
             if IsNightMode then
                CanvasDestination.Font.Color:= clrDarkGray
             else
                CanvasDestination.Font.Color:= clMedGray;
           end;
       end;
     end;
end;

