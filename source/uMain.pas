function TFormMain.MountROMInfo(fileID, IsCRC32Collision: Integer; IsDisk: Boolean; const romName, romCRC32, romSize, romSHA1: String; IsBadDump: ShortInt; IsFileFromParentSet: Boolean = False; FileRegion: String = ''; FileOffset: String = ''): String;
begin
  //            FileID MediaType IsCRC32Collision IsBadDump IsFileFromParentSet <name>Filename/> <crc>CRC32/> <sha1>/SHA-1 or MD5/> <mediatype_title>Custom Media Type Title/> <region>Supermodel3_file_region/><offset>Supermode3_file_offset/>
  // positions:   12       3            4             5             6

  // IsBadDump
  // 1 -> yes; 0 -> no... good or "nodump"

  // IsParentSetFile
  // TRUE  -> yes, ROM/Cart/Floppy/Cassette/Disk is from a parent set (only for clone games)
  // FALSE -> no, file is from the game in question
  Result:= Format('%.2u', [fileID])+IntToStr(Ord(IsDisk))+IntToStr(IsCRC32Collision)+IntToStr(IsBadDump)+IntToStr(Ord(IsFileFromParentSet))+
           MountGameInfoFieldStr('name', romName); // '<name>'+romName+'/>';
  if romCRC32 <> '' then
     Result:= Result+MountGameInfoFieldStr('crc', romCRC32); // Result:= Result+'<crc>'+romCRC32+'/>';
  if romSHA1 <> '' then
     begin
       if Length(romSHA1) > 32 then
          Result:= Result+MountGameInfoFieldStr('sha1', romSHA1) // Result:= Result+'<sha1>'+romSHA1+'/>'
       else
          Result:= Result+MountGameInfoFieldStr('md5', romSHA1); // Result:= Result+'<md5>'+romSHA1+'/>'
     end;

  if romSize <> '' then
     Result:= Result+MountGameInfoFieldStr('size', romSize); // Result:= Result+'<size>'+romSize+'/>';

  // FileRegion and FileOffset and for Supermodel 3 emulator only (new "Config\Games.xml" file)
  if FileRegion <> '' then
     Result:= Result+MountGameInfoFieldStr('region', FileRegion); // Result:= Result+'<region>'+FileRegion+'/>';

  if FileOffset <> '' then
     Result:= Result+MountGameInfoFieldStr('offset', FileOffset); // Result:= Result+'<offset>'+FileOffset+'/>';

  // FileID
  // 0 -> ROM
  // 1 -> Device ROM
  // 2 -> BIOS ROM
  // 3, 4, 5: CHD file

  // MD5   -> 32 chars
  // SHA-1 -> 40 chars

  // IsCRC32Collision is only used by MAME v0.177 and newer

  // full info
  // 02010<name>fpr23718.ic36/><crc>a738ea1c/><sha1>b7b5a55a6a4cf0aa2df1b3dff62ff67f864c55e8/>

  // no CRC32 or SHA-1 (mark file as "nodump" automatically)
  // 00000<name>upd78081.655/>

  // CHD file entry
  // 03100<name>area51mx.chd/><sha1>5ff10f4e87094d4449eabf3de7549564ca568c7e/>
end;

function TFormMain.CreateGamesListMAME(sysID: Byte; SoftwareListsToProcess: THashedStringList): Boolean;
var
  EmuTitle, TitleErrorMsg, FileLine, tempFile, tempFile2, iVersion: String;
  IsXML: Boolean;
  Loop, iMAME: Integer;

  function Check_Temp_Files(const tempFileName: String; ShowErrorMessage: Boolean): Boolean;
  begin
    Result:= FileExists(tempFileName);
    case Result of
      True:
        begin
          Result:= (GetFileSize(tempFileName) > 0);
          if not Result then
             begin
               if ShowErrorMessage then
                  begin
                    CallMessageBox;
                    AddMsgText('File ');
                    AddMsgText(tempFileName, MsgTxtColors.colorFileName, [fsBold]);
                    AddMsgText(' is empty! Aborting...');
                    GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
                  end;
               DeleteFile(tempFileName);
             end
        end;
      False:
        begin
          if not ShowErrorMessage then
             Exit;
          CallMessageBox;
          AddMsgText('File ');
          AddMsgText(tempFileName, MsgTxtColors.colorFileName, [fsBold]);
          AddMsgText(' was not found! Aborting...');
          GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
        end;
    end;
  end;
  
begin
  Result:= True;
  EmuTitle:= GetArcadeEmulatorDescription(sysID, True);
  TitleErrorMsg:= 'Error: Create Games List ['+EmuTitle+']';
  if not FileExists(EmulatorFile[sysID]) then
     begin
       CallMessageBox;
       AddMsgText('File ');
       AddMsgText(EmulatorFile[sysID], MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not found. This task will be terminated.');
       GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
       Result:= False;
       Exit;
     end;

  FormStatus.SetProgressPos(0);
  CheckAndCreateFolder(GetGamesFolderEL);

  FormStatus.TitleStr('Create Games List: '+EmuTitle);

  if not FormStatus.Visible then
     FormStatus.Show;
  FormStatus.StartThreadClock;

  iMAME:= -1;

  FormStatus.MessageStr('Extracting emulator version.');
  EmulatorDateTime[sysID]:= FileAgeW(EmulatorFile[sysID]); // get emulator date/time stamp
  GetArcadeEmulatorVersion(sysID, EmulatorFile[sysID], EmulatorVersion[sysID], iVersion);

  if iVersion = '' then
     iVersion:= GetMAMEBinaryVersion(EmulatorFile[sysID]);
  case sysID of
    idMAME:
      begin
        if buildMAME <> iVersion then
           buildMAME:= iVersion;
      end;
    idHBMAME:
      begin
        if buildHBMAME <> iVersion then
           buildHBMAME:= iVersion;
      end;
  end;

  iMAME:= GetMAMEBuild(sysID);

  // call GetMAMEBuild(FALSE) ;;IsAlterMAME;; starting from version 70, MAME uses listxml; 0.69 still use -listinfo!!!!
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  // DO NOT try to create games list with -listinfo if version is 70 or higher!!!!!!!!!!!!!!!!!!!
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  // in this case, if the -listxml output is empty, return an error message to the user saying EL failed to create the file
  // to parse the games list...........
  // if it's HBMAME, it uses -listxml only...

  IsXML:= (iMAME = -1) or (iMAME >= 70);

  if IsXML then
  begin
    // for MAME v0.70 or newer (-listxml output) and for HBMAME
    tempFile:= GetArcadeSystemIniSection(sysID, True)+'_listxml.xml';
    FormStatus.MessageStr('Creating "'+tempFile+'" file.');

    FileLine:= SystemStr+EmulatorFile[sysID]+SystemStr+' -listxml > '+SystemStr+GetGamesFolderEL+tempFile+SystemStr;
    SetCurrentDir(ExtractFilePath(EmulatorFile[sysID]));
    RunProcess(CommandPromptStr+SystemStr+FileLine+SystemStr, True, GetWindowStateEmulator);

    SetCurrentDir(FrontendPath);
    FileLine:= '';

    Sleep(50); // small pause
    Result:= Check_Temp_Files(GetGamesFolderEL+tempFile, (sysID = idHBMAME));

    if not Result then
       Exit;
  end
  else
  begin
    // for MAME v0.69 and older (-listinfo output)
    // ...will try to create -listinfo output for old MAME builds (0.56 to 0.69)...
    tempFile:= GetArcadeSystemIniSection(sysID, True)+'_listinfo.txt';
    FormStatus.MessageStr('Creating "'+tempFile+'" file.');
    FileLine:= SystemStr+EmulatorFile[sysID]+SystemStr+' -listinfo > '+SystemStr+GetGamesFolderEL+tempFile+SystemStr;
    SetCurrentDir(ExtractFilePath(EmulatorFile[sysID]));
    RunProcess(CommandPromptStr+SystemStr+FileLine+SystemStr, True, GetWindowStateEmulator);

    SetCurrentDir(FrontendPath);
    FileLine:= '';
    if FormMain.Visible then
       FormMain.Refresh;

    Sleep(50); // small pause
    Result:= Check_Temp_Files(GetGamesFolderEL+tempFile, True);

    if not Result then
       Exit;

    // it's the old MAME, yikes!
    // create -listdetails to get driver name for each game...
    tempFile2:= GetArcadeSystemIniSection(sysID, True)+'_listdetails.txt';
    FormStatus.MessageStr('Creating "'+tempFile2+'" file.');
    FileLine:= SystemStr+EmulatorFile[sysID]+SystemStr+' -listdetails > '+SystemStr+GetGamesFolderEL+tempFile2+SystemStr;
    SetCurrentDir(ExtractFilePath(EmulatorFile[sysID]));
    RunProcess(CommandPromptStr+SystemStr+FileLine+SystemStr, True, GetWindowStateEmulator);

    SetCurrentDir(FrontendPath);
    FileLine:= '';
    if FormMain.Visible then
       FormMain.Refresh;

    Sleep(50); // small pause
    Result:= Check_Temp_Files(GetGamesFolderEL+tempFile2, True);

    if not Result then
       Exit;
  end;

  if FormMain.Visible then
     FormMain.Refresh;

  iVersion:= '';

  FormStatus.MessageStr('Deleting games list files.');

  DeleteFile(GetDeviceSetsFile(sysID));
  //if sysID = idMAME then
  DeleteFile(GetMAMEMachineSoftListFile(False, sysID)); // mame_machines.ini; hbmame_machines.ini

  DeleteFile(GetBiosSetFile(sysID));
  DeleteFile(GetAudioSamplesFile(sysID));
  DeleteFile(GetMemcardListFile(sysID));

  DeleteFile(GetMultiCartFileName(sysID, 'neogeo', True)); // no software list support, keep it arcade games only
  DeleteFile(GetMultiCartFileName(sysID, 'stv', True));    // no software list support, keep it arcade games only

  DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID));
    for Loop:=0 to 5 do
        DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID, Loop));

  Sleep(5); // a tiny pause

  // delete all files from "eldir\arcade\sysname_softwarelist_games\" folder (MAME/HBMAME)

  if not IsXML then
     SoftListDeleteGamesFiles(sysID, 0); // delete all software games list files
  //else
