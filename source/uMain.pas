procedure TFormMain.ClearThumb(ThumbItem: TEasyItem);
begin
  ClearThumbTempVars(ThumbItem);
  TEasyGameInfo(ThumbItem).eThumbnail.Free;
  TEasyGameInfo(ThumbItem).eThumbnail:= nil;
  FreeAndNil(TEasyGameInfo(ThumbItem).fThumbnail);
  TEasyGameInfo(ThumbItem).eThumbnailLoaded:= False;
  TEasyGameInfo(ThumbItem).eThumbnailLoading:= False;
  TEasyGameInfo(ThumbItem).eThumbnailFileName:= '';
  TEasyGameInfo(ThumbItem).eThumbnailIsZipped:= False;
  ThumbnailSettings.ArcadeCalculateIconPos:= True;
  ThumbnailSettings.ConsCompCalculateIconPos:= True;

end;

procedure TFormMain.ResetThumbnails(SelectedOnly: Boolean = False);
var
  Item: TEasyItem;
  Group: TEasyGroup;
  ReinitItem: Boolean;
begin
  if IsStartup then
     Exit;

  if not CheckTotal(GamesListView) then
     Exit;

  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // remove any pending requests before reloading them
  Sleep(50);
  GamesListView.BeginUpdate;
  if IsGroupedView then
  begin
    Group:= GamesListView.Groups.FirstGroup;
    repeat
      Item:= GamesListView.Groups.FirstInGroup(Group);
      repeat
        case SelectedOnly of
          True : ReinitItem:= Item.Selected;
          False: ReinitItem:= True;
        end;
        if ReinitItem then
           begin
             ClearThumb(Item);
             Item.Initialized:= False; // cause the Initialized event to be called again when the control needs the info
           end;
        Item:= GamesListView.Groups.NextInGroup(Group, Item);
      until Item = nil;
      Group:= GamesListView.Groups.NextGroup(Group);
    until Group = nil;
  end
  else
  begin
    Item:= GamesListView.Groups.FirstItem;
    repeat
      case SelectedOnly of
        True : ReinitItem:= Item.Selected;
        False: ReinitItem:= True;
      end;
      if ReinitItem then
         begin
           ClearThumb(Item);
           Item.Initialized:= False; // cause the Initialized event to be called again when the control needs the info
         end;
      Item:= GamesListView.Groups.NextItem(Item);
    until Item = nil;
  end;
  GamesListView.EndUpdate(False);
end;

procedure TFormMain.MenuShowImagesClick(Sender: TObject);
begin
  if MenuThumbnailShowImages.Checked <> MenuShowImages.Checked then
     MenuThumbnailShowImages.Checked:= MenuShowImages.Checked;

  if PopupThumbnailShowImages.Checked <> MenuShowImages.Checked then
     PopupThumbnailShowImages.Checked:= MenuShowImages.Checked;

  if not IsStartup then
     begin
       if IsThumbnailView then
       begin
         if MenuShowImages.Checked then
            InitZippedImagesCache; // do not allow to free zip lists while in thumbnails view
       end
       else
       begin
         if MenuShowImages.Checked then
            ShowInitZipImageMsgBox;

         InitImgZipLists(not MenuShowImages.Checked); // init or free zip lists
         InitImgSoftwareNameZipLists(not MenuShowImages.Checked);
         if MenuShowImages.Checked then
            HideInitZipImageMsgBox;
       end;
     end;
  if (not MenuShowImages.Checked) and (not IsStartUp) then
     begin
       if not IsSingleImageLayout then // single image layout is saved right after changing image category
          UpdateScreenshotLayout(ButtonScreenshotLayouts.Tag); // if user disable images, save current multiple layout
       if not IsThumbnailView then
          FreeImageZipVars;
     end;
