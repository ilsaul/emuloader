                 begin
                   // old tags... remove these (October 30, 2016)
                   // -1: none... invalid!
                   // 20: playback input
                   // 21: record input
                   // 22: load a save state
                   // 23: record wave
                   // 24: record mng
                   // 25: record avi
                   // 26: * left panel file select (not used anymore!!!)
                   // 27: play and use an effect overlay
                   // 28: Select Effect Overlay (MAME Settings)
                   // 29: Select Font Files, emulator (BDF)
                   // 30: Select Font Files, game, driver (BDF)
                   // 31: Select Shadow Mask Texture (MAME Settings)
                   // all these options are now MAME exclusive features

                   MAME_ExtraParamsCommandLine:= RunMAMEExtraParameters(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID], MachineNameStr);
                   // if var above is empty... no biggie, continue to run game!
                   if SameText(MAME_ExtraParamsCommandLine, 'abort') then
                      begin
                        ResetSettings;
                        Exit;
                      end;
                   //ShowMessage('"->'+MAME_ExtraParamsCommandLine+'<-"'); // for debugging only!!!
                 end;
            end;
          False:
            begin
              case MemGameInfo.eSystemID of
                idSupermodel:
                  begin
                    // Supermodel, need to add options before game, and it's .zip file with full path!
                    // need to create a function to merge these two here....!!!!!! Jan 26, 2014 --- huh ? ---
                    NewOption:= ReadSupermodelIni(MemGameInfo.eName+'.ini');
                    if NewOption = 'invalid_resolution' then
                       Exit
                    else
                    if NewOption = '' then
                       begin
                         NewOption:= ReadSupermodelIni(GetArcadeEmuIniFileName(MemGameInfo.eSystemID));
                         if NewOption = 'invalid_resolution' then
                            Exit;
                       end
                    else
                       SetCmdLineTitle(True);
                    NewOption:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID);
                    if NewOption = '' then
                       NewOption:= 'file not found';
                    CommandLine:= CommandLine+' "'+NewOption+'"';
                  end;
                idDaphne:
                  begin
                    CommandLine:= CommandLine+ReadDaphneIni;
                  end;
                idDemul: // Demul, need special parameters before the game name
                  begin
                    if MemGameInfo.eDriverName <> '' then
                       CommandLine:= CommandLine+'-run='+GetDemulMachineName(MemGameInfo.eDriverName, IsDemulOldVersion)+
                                     ' -rom='+MemGameInfo.eName
                    else
                       IsDemulEmptySystem:= True;
                    // do nothing else as Demul doesn't support custom game settings...
                    //if MemGameInfo.eDriverName <> '' then
                    //   CommandLine:= CommandLine+'-run='+GetDemulMachineName(MemGameInfo.eDriverName)+
                    //              ' -rom='+MemGameInfo.eName
                    //else
                    //   IsDemulEmptySystem:= True;
                    // do nothing else as Demul doesn't support custom game settings...
                  end;
                idZiNc:
                  begin
                    // ZiNc, needs special parameters before the game name
                    if MemGameInfo.eScreenType <> -1 then
                       CommandLine:= CommandLine+IntToStr(MemGameInfo.eScreenType) // ZiNc has game index in ScreenType
                    else
                       begin
                         CallMessageBox;
                         ShowGameNameEntryMsgBox;
                         case IsROM_Bios(MemGameInfo.eROMIdentification) of
                           True : GenerateMessage(msgBoxTitle, MemGameInfo.eTitle,
                                         'This is a BIOS set and ZiNc does not run BIOS sets, only games. Aborting...', 2);
                           False: GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle,
                                         'Invalid ZiNc game index (-1). Please create games list again. Aborting...', 2, False, 1);
                         end;
                         ResetSettings;
                         Exit;
                       end;
                    // first driver, second game, then default emulator options
                    SetCmdLineTitle(True);

                    NewOption:= GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID);
                    NewOption2:= ChangeFileExt(MemGameInfo.eDriverName, '.cfg'); // NewOption2 holds the filename (no path)
                    if not FileExists(NewOption+NewOption2) then
                       begin
                         NewOption2:= MemGameInfo.eName+'.cfg';
                         if not FileExists(NewOption+NewOption2) then
                            begin
                              // use default emulator settings
                              NewOption2:= GetArcadeEmuIniFileName(MemGameInfo.eSystemID);
                              SetCmdLineTitle;
                            end;
                        end;

                    // function "LongToShortPath()" cannot have last slash '\' or it does not work... the filename is also lost!!!!!
                    // NewOption will hold the .cfg file with full path!!! October 10, 2016
                    NewOption:= GetShortFileNameW(NewOption);
                    //NewOption:= ExtractShortPathName(NewOption); // this doesn't work!!!!!!!! :_((
                    if ValidateFile(NewOption+NewOption2) then
                    //if FileExists(NewOption+NewOption2) then
                       CommandLine:= CommandLine+' --use-config-file='+NewOption+NewOption2;

                    // get game.zip or parent.zip folder
                    NewOption:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID);
                    if NewOption <> '' then
                       NewOption:= GetShortFileNameW(ExtractFilePath(NewOption)) //NewOption:= ExtractShortPathName(ExtractFilePath(NewOption)) // this doesn't work!!!!!!!! :_((
                    else
                    if GameIsClone(MemGameInfo.eClone) then
                       begin
                         NewOption:= SearchZIPFolder(MemGameInfo.eClone, MemGameInfo.eSystemID);
                         if NewOption <> '' then
                            NewOption:= GetShortFileNameW(ExtractFilePath(NewOption)); //NewOption:= ExtractShortPathName(ExtractFilePath(NewOption)); // this doesn't work!!!!!!!! :_((
                       end;
                    if NewOption <> '' then
                       CommandLine:= CommandLine+' --roms-directory='+NewOption;
                  end;
              end;
            end;
        end;
      end;
  end;

  // need to check the correct MAME binary and also check all other emulators!!!
  if CommandLine <> '' then
    begin
      if (MemGameInfo.eSystemID = idDemul) and (CommandLine = '!error') then
         CommandLine:= '';

      if not MemGameInfo.eIsCustomGame then
      begin
        if MAME_ExtraParamsCommandLine <> '' then
           CommandLine:= CommandLine+MAME_ExtraParamsCommandLine; // playback/record input, load save state, insert memory card, record movie

        if MemGameInfo.eSoftwareName <> '' then
           begin
             // fix game snap name full folder path for software list games (path_mame.ini\softlist_name\gamename\)
             CommandLine:= CommandLine+' -statename '+MachineNameStr+'/'+MemGameInfo.eSoftwareName+'/'+MemGameInfo.eName;
             //CommandLine:= CommandLine+' -statename '+MemGameInfo.eSoftwareName+'/'+MemGameInfo.eName;//+'/%i'; // old code, invalid for MAME!!!!
             CommandLine:= CommandLine+' -snapname '+MemGameInfo.eSoftwareName+'/'+MemGameInfo.eName+'/%i';
             // fix state name full folder path for software list games (path_mame.ini\machine_name\softlist_name\gamename\)
           end;
      end;

      if MenuViewEmulatorFullCommandLine.Checked or IsDemulEmptySystem then
         begin
           CallMessageBox;
           case MemGameInfo.eIsCustomGame of
             True : EnableMsgMediaTypeLabel(False);
             False: ShowGameNameEntryMsgBox(IsMultiSlot, MultiSlotMachineName);
           end;

           FormMessageBox.ButtonYes.Caption:= 'Execute';
           FormMessageBox.ButtonNo.Caption:= 'Abort';

           //AddMsgText('Games List Version Info'+#13#10, $000053a6, [], taCenter, 9);
           //AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, clGray, [fsItalic, fsBold], taCenter);

           case MemGameInfo.eIsCustomGame of
             True :
               begin
                 TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
                 AddMsgText(TempStr, $000053a6, [fsItalic, fsBold], taCenter);//, 9, 'Trebuchet MS');
                 AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, clGray, [fsItalic, fsBold], taCenter);
               end;
             False:
               begin
                 AddMsgText('Games list   ', $000053a6, [fsItalic, fsBold], taCenter);//, 9, 'Trebuchet MS');
                 AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, clGray, [fsItalic, fsBold], taCenter);
               end;
           end;

           //AddMsgText(#13#10);
           case IsAlterMAME of
             True:
               begin
                 //AddMsgText(#13#10+'AlterMAME Emulator Version Info'+#13#10, $000053a6, [fsBold], taCenter, 9);
                 //AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);
                 AddMsgText({#13#10+}'AlterMAME Emulator   ', $000053a6, [fsItalic, fsBold], taCenter);
                 AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);
               end;
             False:
               begin
                 AddMsgText('Emulator   ', $000053a6, [fsItalic, fsBold], taCenter);
                 AddMsgText(EmulatorVersion[MemGameInfo.eSystemID]+#13#10, clGray, [fsItalic, fsBold], taCenter);
                 //AddMsgText(#13#10+'Emulator Version Info'+#13#10, $000053a6, [], taCenter, 9);
                 //AddMsgText(EmulatorVersion[MemGameInfo.eSystemID]+#13#10, clGray, [fsItalic, fsBold], taCenter);
               end;
           end;
            if IsMultiSlot then
              begin
                msItem:= FormArcadeMultiSlotGames.GamesList.Groups.FirstItem;
                repeat
                  if msItem.Index < 11 then
                     NewOption:= '0'+IntToStr(msItem.Index+1)
                  else
                     NewOption:= IntToStr(msItem.Index+1);
                  //AddMsgText(#13#10+IntToStr(msItem.Index+1)+' ', clOlive, [fsBold], taLeftJustify, 8, 'Tahoma');
                  AddMsgText(#13#10+NewOption+' ', clOlive, [fsBold], taLeftJustify, 8, 'Tahoma');
                  AddMsgText(msItem.Captions[1], clBlack, [fsBold], taLeftJustify, 8, 'Tahoma');
                  //AddMsgText(#13#10+'slot '+IntToStr(msItem.Index+1)+': '+msItem.Caption, clBlack, [], taLeftJustify, 8, 'Segoe UI Semibold');
                  msItem:= FormArcadeMultiSlotGames.GamesList.Groups.NextItem(msItem);
                until msItem = nil;
                FreeAndNil(FormArcadeMultiSlotGames);
                AddMsgText(#13#10);
              end;

           if not MemGameInfo.eIsCustomGame then
              begin
                 if MemGameInfo.eSoftwareName <> '' then
                    begin
                      AddMsgText(#13#10+'Machine: '+MachineToUse_Title+#13#10, $000053a6, [fsItalic, fsBold], taCenter);
                      AddMsgText(MemGameInfo.eCategory+#13#10, clGray, [fsItalic, fsBold], taCenter);
                    end;
              end
           else
              begin
                AddMsgText(#13#10+'MAME Machine   ', $000053a6, [fsItalic, fsBold], taCenter);
                AddMsgText(MachineToUse_Title+#13#10, clGray, [fsItalic, fsBold], taCenter);
                //AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, clGray, [fsItalic, fsBold], taCenter);
              end;

           //if MemGameInfo.eSoftwareUsageTip <> '' then
           //   begin
           //     AddMsgText(#13#10+'Usage tip: ', $000053a6, [fsBold]);//, taLeftJustify, 9);
           //     AddMsgText(MemGameInfo.eSoftwareUsageTip+#13#10, $0078695b, [fsBold], taLeftJustify, 9, 'Lucida Console');
           //     //AddMsgText(#13#10+'Usage tip: '+ MemGameInfo.eSoftwareUsageTip+#13#10, $0078695b, [fsBold], taLeftJustify, 9, 'Consolas');
           //   end;

           //AddMsgText(#13#10);
           if not IsDemulEmptySystem then
              AddMsgText(#13#10+CommandLine, $00600000, [], taLeftJustify, 10, 'Consolas') //'Lucida Console')
           else
              AddMsgText(#13#10+'    The system name is blank, Demul cannot run games without it. If this is a playable game, '+
                         'please post a message in the forum or contact by e-mail.'+#13#10+#13#10+
                         'forum: http://www.mameworld.info/ubbthreads/postlist.php?Cat=&Board=emuloader'+#13#10+
                         'e-mail: emuloader@gmail.com');


           if (not IsAlterMAME) and TryAgainAlterMAME then
              begin
                AddMsgText(#13#10+#13#10);
                AddMsgText('AlterMAME will be used to run "'+MemGameInfo.eName+'" if it fails '+
                           'to load with MAME.'+#13#10);//, clBlack, [], taLeftJustify, 9, 'Segoe UI');
                AddMsgText(#13#10+'AlterMAME Emulator  ', $000053a6, [fsItalic, fsBold], taCenter);
                AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);
                //AddMsgText('AlterMAME Emulator Version Info'+#13#10, $000053a6, [], taCenter, 9);
                //AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);
                NewOption:= StringReplace(CommandLine, EmulatorFile[MemGameInfo.eSystemID], AlterMAMEFile, [rfIgnoreCase]);
                if IsBatchFileAlterMAME then
                   NewOption:= CommandPromptStr+systemStr+NewOption+SystemStr;
                //AddMsgText(#13#10);
                AddMsgText(#13#10+NewOption, $00600000, [], taLeftJustify, 10, 'Consolas'); //'Lucida Console');
              end;
           if not IsMultiSlot then
              begin
                if not MemGameInfo.eIsCustomGame then
                begin
                  if (MemGameInfo.eGameSetStatus > 0) then
                     begin
                       AddMsgText(#13#10);
                       AddMsgText(#13#10+'WARNING: One on more ROMs/CHDs are missing, "'+
                                  MemGameInfo.eName+'" might not run properly!'+#13#10, clMaroon, [fsItalic], taCenter, 10);
                     end
                  else
                     if (MemGameInfo.eSystemID = idZiNc) and (NewOption = '') then
                        begin
                          AddMsgText(#13#10);
                          AddMsgText(#13#10+'WARNING: Zip file was not found. "'+MemGameInfo.eName+'" cannot be run!'+
                                     #13#10+'ZiNc might return "Error 1: Incorrect Function" message.'+#13#10, clMaroon, [fsItalic], taCenter, 10);
                        end;
                end;

                if (MAMEMachineItem <> nil) and (TEasyGameInfo(MAMEMachineItem).eGameSetStatus > 0) then
                   begin
                     if MemGameInfo.eGameSetStatus = 0 then
                        AddMsgText(#13#10+#13#10);

                     AddMsgText({#13#10+}'WARNING: One on more ROMs/CHDs are missing, "'+
                                MachineNameStr+'" machine might not run properly!'+#13#10, clMaroon, [fsItalic], taCenter, 10);
                   end;
              end;

           //if (MemGameInfo.eGameSetStatus > 0) and (not IsMultiSlot) then
           //   begin
           //     AddMsgText(#13#10);
           //     AddMsgText(#13#10+'WARNING: One on more ROMs/CHDs are missing, "'+
           //                MemGameInfo.eName+'" might not run properly!'+#13#10, clMaroon, [fsItalic], taCenter);
           //   end;

           case IsDemulEmptySystem of
             False:
               begin
                 if not IsMultiSlot then
                    begin
                      NewOption:= MemGameInfo.eTitle;
                      MsgType:= -1;
                    end
                 else
                    begin
                      MsgType:= 4; // set this so msgbox shows the system icon...
                      if MultiSlotMachineName = 'neogeo' then
                         begin
                           NewOption:= 'Neo-Geo Multi Video System';
                           //MsgType:= 4;
                         end
                      else
                      if MultiSlotMachineName = 'megatech' then
                         begin
                           NewOption:= 'Sega Mega-Tech System';
                           //MsgType:= 5;
                         end
                      else
                      if MultiSlotMachineName = 'playch10' then
                         begin
                           NewOption:= 'Nintendo PlayChoice-10';
                           //MsgType:= 6;
                         end
                      else
                      if MultiSlotMachineName = 'stv' then
                         begin
                           NewOption:= 'Sega Titan Video Game System';
                           //MsgType:= 7;
                         end;
                    end;
                 if GenerateMessage(msgboxTitle, NewOption, '', 1, False, MsgType) = mrNo then
                    begin
                      ResetSettings;
                      Exit;
                    end;
               end;
             True:
               begin
                 GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 2);
                 ResetSettings;
                 Exit;
               end;
           end;
         end;

      PlayDummyVideo(True); // stop current video playback...
      iPlayTime:= GetTickCount;

      case IsAlterMAME of
        True : SetCurrentDir(ExtractFilePath(AlterMAMEFile));
        False: SetCurrentDir(ExtractFilePath(EmulatorFile[MemGameInfo.eSystemID]));
      end;

      if Assigned(ZipForgeIcons) then
         ZipForgeIcons.CloseArchive;

      IsRunningGame:= True;
      ExitCode:= RunProcess(CommandLine, True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game!!!

      if ExitCode <> 0 then // = 2 ? // files are missing error code
         begin
           if (not IsAlterMAME) and TryAgainAlterMAME then
              begin
                IsAlterMAME:= True; // set this here to avoid problems below
                CommandLine:= StringReplace(CommandLine, EmulatorFile[MemGameInfo.eSystemID], AlterMAMEFile, [rfIgnoreCase]);
                if IsBatchFileAlterMAME then
                   CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;
                SetCurrentDir(ExtractFilePath(AlterMAMEFile));
                ExitCodeAlterMAME:= RunProcess(CommandLine, True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game with AlterMAME executable!!!
              end;
         end;
      IsRunningGame:= False;

      ThousandSeparator:= Char(',');
      DecimalSeparator:= Char('.');

      case FormMain.MemGameInfo.eIsCustomGame of
        True:
          begin
            UpdatePlayedCustomGame(iPlayTime, ItemToUpdate);
          end;
        False:
          begin
            UpdatePlayedGameArcade(iPlayTime, ItemToUpdate);
          end;
      end;

      Result:= ExitCode;
      if ExitCode = 0 then
         begin
           // all is well
           if not MemGameInfo.eIsCustomGame then
           begin
             if IsMAMEBasedSys(MemGameInfo.eSystemID) then
                begin
                  //if not IsAlterMAME then
                  //   AutoRenameSnapshots; // this is outdated code, no longer used! (October 30, 2016)
                  NewOption:= '';
                end;
             if ImageDetails[1].NoImageLoaded then
                begin
                  ImageDetails[1].NoImageLoaded:= False;
                  ImageDetails[1].PrevNoImageLoaded:= False;
                end;
             ToggleImagesPanel(True); // will force to reload snapshot, this is just in case user takes a new screenshots while gaming
             //MenuShowImages.OnClick(Self); // avoid this as EL was re-initializing the zipped image lists!!!!!
           end;
         end
      else
         begin
           CallMessageBox;
           case MemGameInfo.eIsCustomGame of
             True : EnableMsgMediaTypeLabel(False);
             False: ShowGameNameEntryMsgBox;
           end;
           //ShowGameNameEntryMsgBox;

           case MemGameInfo.eIsCustomGame of
             True:
               begin
                 TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
                 AddMsgText(TempStr, $000053a6, [fsItalic, fsBold], taCenter);
                 AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, clGray, [fsItalic, fsBold], taCenter);
               end;
             False:
               begin
                 AddMsgText('Games list   ', $000053a6, [fsItalic, fsBold], taCenter);
                 AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, clGray, [fsItalic, fsBold], taCenter);
               end;
           end;

           if (IsAlterMAME and (not TryAgainAlterMAME)) then
              begin
                AddMsgText('AlterMAME Emulator   ', $000053a6, [fsItalic, fsBold], taCenter);
                AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);
                //AddMsgText(#13#10+'AlterMAME Emulator Version Info'+#13#10, $000053a6, [], taCenter, 9); // RGB(0, 83, 166)
                //AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);
              end
           else
              begin
                AddMsgText('Emulator   ', $000053a6, [fsItalic, fsBold], taCenter);
                AddMsgText(EmulatorVersion[MemGameInfo.eSystemID]+#13#10, clGray, [fsItalic, fsBold], taCenter);
                //AddMsgText(#13#10+'Emulator Version Info'+#13#10, $000053a6, [], taCenter, 9); // RGB(0, 83, 166)
                //AddMsgText(EmulatorVersion[MemGameInfo.eSystemID]+#13#10, clGray, [fsItalic, fsBold], taCenter);
              end;

           if not MemGameInfo.eIsCustomGame then
              begin
                if MemGameInfo.eSoftwareName <> '' then
                   begin
                     AddMsgText(#13#10+'Machine: '+MachineToUse_Title+#13#10, $000053a6, [fsItalic, fsBold], taCenter);
                     AddMsgText(MemGameInfo.eCategory+#13#10, clGray, [fsItalic, fsBold], taCenter);
                   end;
              end
           else
              begin
                AddMsgText(#13#10+'Machine: '+MachineToUse_Title+#13#10, $000053a6, [fsItalic, fsBold], taCenter);
                AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, clGray, [fsItalic, fsBold], taCenter);
              end;

           AddMsgText(#13#10+'Error '+IntToStr(ExitCode), $00000060, [fsBold]);
           AddMsgText(': '+SysErrorMessage(ExitCode)+'.');
           //if ExitCode = 3221225786 then
           //   CheckPrecisionXAfterburner; // why, why, WHY ?
           // check this link for most common error messages:
           // http://www.febooti.com/products/automation-workshop/online-help/events/run-dos-cmd-command/exit-codes/
           if ExitCode = 2 then
              begin
                AddMsgText(#13#10);
                case MemGameInfo.eIsCustomGame of
                  True : AddMsgText(#13#10+'Required "'+MachineNameStr+'" machine files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, clMaroon, [fsItalic], taCenter, 10);
                  False: AddMsgText(#13#10+'Required files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, clMaroon, [fsItalic], taCenter, 10);
                end;
              end;

           if IsAlterMAME and TryAgainAlterMAME then
              begin
                if ExitCode <> 2 then
                   AddMsgText(#13#10);
                AddMsgText(#13#10+'AlterMAME Emulator   ', $000053a6, [fsItalic, fsBold], taCenter); // RGB(0, 83, 166)
                AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);

                if ExitCodeAlterMAME <> 0 then
                   begin
                     AddMsgText(#13#10+'Error '+IntToStr(ExitCodeAlterMAME), $00000060, [fsBold]);
                     AddMsgText(': '+SysErrorMessage(ExitCodeAlterMAME)+'.');
                     //AddMsgText(#13#10+'Error '+IntToStr(ExitCodeAlterMAME)+': '+SysErrorMessage(ExitCodeAlterMAME)+'.'+#13#10);
                     //if ExitCodeAlterMAME = 3221225786 then
                     //   CheckPrecisionXAfterburner;
                     if ExitCodeAlterMAME = 2 then
                        begin
                          AddMsgText(#13#10);
                          case MemGameInfo.eIsCustomGame of
                            True : AddMsgText(#13#10+'Required "'+MachineNameStr+'" machine files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, clMaroon, [fsItalic], taCenter, 10);
                            False: AddMsgText(#13#10+'Required files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, clMaroon, [fsItalic], taCenter, 10);
                          end;
                        end
                     else
                     if ExitCodeAlterMAME = 5 then
                        AddMsgText(#13#10);
                   end
                else
                   begin
                     AddMsgText(#13#10+'Success '+IntToStr(ExitCode), $00000060, [fsBold]);
                     AddMsgText(' :'+SysErrorMessage(ExitCodeAlterMAME)+'.');
                   end;
              end;

           if ExitCode = 2 then
              begin
                //AddMsgText(#13#10);
                if (MemGameInfo.eSoftwareName = '') and (not MemGameInfo.eIsCustomGame) then
                   AddMsgText(#13#10+'Please check for missing ROMs/CHDs. Would you like to '+
                              'view ROMs/CHDs details now ?')
                else
                   begin
                     // need to use MAMEMachineItem var here and use TempGameVars variables in GameDetails screen...
                     AddMsgText(#13#10+'Please check for missing ROMs/CHDs and make sure the machine ');
                     AddMsgText(MachineToUse_Title, clNavy, [fsItalic]);
                     AddMsgText(' ('+MachineNameStr+') ');
                     AddMsgText('doesn''t have missing ROMs/CHDs. Would you like to view ROMs/CHDs details now ?');
                   end;
                if GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 1) = mrYes then
                   PopupGameDetails.Click;
              end
           else
              GenerateMessage(msgboxTitle, MemGameInfo.eTitle, '', 2);
         end;
    end
  else
    GenerateMessage(ErrorMsgTitle, 'Command line is blank.',
                    '  "D''OH!"'+#13#10+
                    'Cannot execute with an empty command line.', 2, False, 1);
  ResetSettings;
end;

procedure TFormMain.EnableMsgMediaTypeLabel(MountImage: Boolean; AssociatedApplication: Boolean = False);
begin
  FormMessageBox.IconMediaType.Tag:= 0;

  //need to improve the media icon... it will display system icon for arcade games ??????
  //perhaps make it always visible ????
  //- also, remove the 32x32 smaller icon from the message box ????
  // 1: Cartridge
  // 2: Disc Image
  // 3: Floppy Disk
  // 4: Cassette Tape
  // 5: Hard Disk Drive
  with FormMessageBox do
  begin
    IconMediaType.Visible:= True;
    LabelGameNameCloneOf.Visible:= True;
    LabelTitle.Top:= 1;
    IconMediaType.Hint:= MediaTypeCustom[MemGameInfo.eCustomMediaType, 1];
    LabelGameNameCloneOf.Canvas.Lock;
    LabelGameNameCloneOf.Caption:= MediaTypeCustom[MemGameInfo.eCustomMediaType, 0];
    if not AssociatedApplication then
       begin
         if MountImage then
            LabelGameNameCloneOf.Caption:= LabelGameNameCloneOf.Caption+'; mount on virtual drive';
         //else
         //   LabelMediaTypeParameters.Caption:= LabelMediaTypeParameters.Caption+
         //               '; parameter '+IntToStr(EmulatorParameterIndexToUse[MemGameInfo.eSystemID, MemGameInfo.eMediaType]);
       end;

    if CheckMultipleSelected(GamesListView) then
       LabelGameNameCloneOf.Caption:= LabelGameNameCloneOf.Caption+'; '+IntToStr(GamesListView.Selection.Count)+' games selected'
    else
       LabelGameNameCloneOf.Caption:= LabelGameNameCloneOf.Caption+'; file extension '+ExtractFileExtW(MemGameInfo.eName);

    LabelGameNameCloneOf.Canvas.Unlock;
  end;
end;

function TFormMain.GameFoldersFound(CustomSystemID, CustomMediaType: Integer): Boolean;
begin
  Result:= Assigned(sysCustomFolders[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType]) and
           (sysCustomFolders[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType].Count > 0);
end;

function TFormMain.SearchGameFile(const GameName: WideString; CustomSystemID, CustomMediaType: Integer; SearchDiscFileCUE, ShowQuickMessageBox: Boolean; out VarFileFullPath: WideString; out DOSFileNameStr: String): Boolean;
var
  LoopSearch: Integer;
  FolderStr: String;
  SearchCUE: Boolean;
  FileToSearch: WideString;
  FileToSearchDOS: String;
begin
  Result:= False;
  FileToSearch:= '';
  FileToSearchDOS:= '';

  if not Assigned(sysCustomFolders[CustomSystemID, CustomMediaType]) then
     Exit;
  if sysCustomFolders[CustomSystemID, CustomMediaType].Count = 0 then
     Exit;
  if ShowQuickMessageBox then
     ShowFilterMsgBox('Execute Game', 'Searching game file, please wait...');

  SearchCue:= SearchDiscFileCue;
  if SearchCue then
     SearchCUE:= (CustomMediaType = 2) and ButtonImageCUE.Down;

  for LoopSearch:=0 to sysCustomFolders[CustomSystemID, CustomMediaType].Count-1 do
  begin
    FolderStr:= sysCustomFolders[CustomSystemID, CustomMediaType].Strings[LoopSearch];

    //if FindFile(FolderStr, GameName, VarFileFullPath, SearchCUE, DOSFileNameStr) then
    if FindFile(FolderStr, GameName, FileToSearch, SearchCUE, FileToSearchDOS) then
       begin
         VarFileFullPath:= FileToSearch;
         DOSFileNameStr:= FileToSearchDOS;
         Result:= True;
         Break;
       end;
  end;

  if ShowQuickMessageBox then
     HideFilterMsgBox;
end;

