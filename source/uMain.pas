    PlayedArcadeSysID:= ArcadeSystemID;
    FreeAndNil(PlayedListArcadeGames);
    Result:= ValidateFile(GetGamesPlayedIniFile(ArcadeSystemID));
    if Result then
      begin
        PlayedListArcadeGames:= THashedStringList.Create;
