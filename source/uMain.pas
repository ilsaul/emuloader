           end;

        FilterChanged(FormFiltersExtra.LabelInterfaceType.Tag, FormFiltersExtra.InterfaceType.ItemIndex);
        FormFiltersExtra.LabelInterfaceType.Tag:= FormFiltersExtra.InterfaceType.ItemIndex;

