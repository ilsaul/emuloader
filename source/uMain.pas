  function ParseMemCardDeviceTag(LineIndexXML: Integer): Boolean;
  var
    mcardStr, mCardExtStr, TempStr: String;
    IsNeoGeo: Boolean;
    LoopMemCardExt: Integer;
  begin
    Result:= True;
    IsNeoGeo:= IsNeoGeoDriver(TempGameVars.eSystemID, TempGameVars.eDriverName, TempGameVars.eBiosName, True);
    if IsNeoGeo and NeoGeoMemcardAdded then
       Exit;

    mcardStr:= TrimLeft(ListXML[LineIndexXML+1]);
    if mcardStr = '' then
       Exit;

    mcardStr:= XML_GetEntryValue(mcardStr, 'name');
    if mcardStr = '' then
       Exit;

    if not AddedMemoryCardFileExt then
    begin
      mCardExtStr:= '';
      if IsNeoGeo then
         begin
           mCardExtStr:= TrimLeft(ListXML[LineIndexXML+2]);
           mCardExtStr:= XML_GetEntryValue(mCardExtStr, 'name');
         end
      else
         begin
           LoopMemCardExt:= LineIndexXML+1;
           repeat
             TempStr:= TrimLeft(ListXML[LoopMemCardExt]);
             if PosEx('<extension ', TempStr) <> 0 then
                begin
                  if mCardExtStr <> '' then
                     mCardExtStr:= mCardExtStr+';';
                  mCardExtStr:= mCardExtStr+XML_GetEntryValue(TempStr, 'name');
                end;
             Inc(LoopMemCardExt);
           until TempStr = '</device>';
         end;
    end;

    if not Assigned(MemCardMachineList) then
       begin
         MemCardMachineList:= TStringList.Create;
         MemCardMachineList.BeginUpdate;
       end;
    if MemcardsCount = 0 then
       begin
         if MemCardMachineList.Count > 0 then
            MemCardMachineList.Add(''); // add an empty line to separate [sections]
         case IsNeoGeo of
           True:
             begin
               MemCardMachineList.Add('[neogeo]'); // add the machine/game name section
               NeoGeoMemcardAdded:= True;
             end;
           False: MemCardMachineList.Add('['+TempGameVars.eName+']'); // add the machine/game name section
         end;
         if not AddedMemoryCardFileExt then
            begin
              MemCardMachineList.Add(mCardExtStr);
              AddedMemoryCardFileExt:= True;
            end;
       end;
    MemCardMachineList.Add(mcardStr);
    Inc(MemcardsCount);
  end;

  function AddSoftListEntry(const SoftwareListName, Filter: String): Boolean;
  begin
    if not Assigned(SoftList) then
       begin
         SoftList:= TStringList.Create;
         SoftList.BeginUpdate;
         SoftList.Add('; Machine names with software lists');
       end;
    if not SoftListHeaderAdded then
       begin
         SoftList.Add(' ');
         SoftList.Add('['+TempGameVars.eName+']');
         SoftListHeaderAdded:= True;
       end;
    SoftList.Add(SoftwareListName);
  end;

  function AddSoftwareListMachine(const SoftwareNameSection, MachineName: String): Boolean;
  begin
    // mame_machines.ini
    if not Assigned(SoftNameMachinesList) then
       SoftNameMachinesList:= TMemIniFile.Create(GetMAMEMachineSoftListFile(False, sysID));
    SoftNameMachinesList.WriteString(SoftwareNameSection, MachineName, '');
  end;

  function AddToListSoftwareListXML(const slName: String): Boolean;
  begin
    // list var parameter to mount a list of softwarenames
    if not SoftwareListsToProcess.Sorted then
       begin
         SoftwareListsToProcess.Sorted:= True;
         SoftwareListsToProcess.Duplicates:= dupIgnore;
         SoftwareListsToProcess.BeginUpdate;
       end;
    SoftwareListsToProcess.Add(slName);
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ROMsList);
    FreeAndNil(BiosSet);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    FreeAndNil(ListCPU);
    FreeAndNil(games_bios);
    FreeAndNil(ListROMsDeviceSet);
    FreeAndNil(ListROMsBiosSet);
    FreeAndNil(DeviceSetSize);
    FreeAndNil(ListDeviceROMsGame);
    FreeAndNil(ListSamples);
    FreeAndNil(SoftList);
    FreeAndNil(SoftNameMachinesList);
    FreeAndNil(MemCardMachineList);
    FreeAndNil(ListDuplicateROMs);
    Result:= False;
  end;

  function IsDeviceSet: Boolean;
  begin
    Result:= PosEx('isdevice="yes"', FileLine) <> 0;
  end;

  function IsBiosSet: Boolean;
  begin
    Result:= PosEx('isbios="yes"', FileLine) <> 0;
    if not Result then
       begin
         if not IsDeviceSet then
            Result:= PosEx('runnable="no"', FileLine) <> 0; // double-ckeck for MAME 0.106u9 to 0.75 since they don't have device sets
       end;
  end;

  function IsMechanical: Boolean;
  begin
    Result:= PosEx('ismechanical="yes"', FileLine) <> 0;
  end;

  function GetDeviceSetSize(const SetName: String): String;
  begin
    Result:= DeviceSetSize.Values[SetName];
    if Result = '' then
       Result:= '0';
  end;

  function ReplaceChar(const iText: String; CharToReplace, NewChar: Char): String;
  var
    iPos: Integer;
  begin
    Result:= iText;
    iPos:= PosEx(CharToReplace, iText);
    while iPos > 0 do
    begin
      Result[iPos]:= NewChar;
      iPos:= PosEx(CharToReplace, iText);
    end;
  end;

  function ParseVideoEntry: Boolean;
  begin
    Result:= True;
    // build 0.106u9 down to 0.75
    if GetScreenRes then
       Exit; // already got the video info

    GetScreenRes:= True;
    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'screen');
    if TempString <> '' then
       TempGameVars.eScreenType:= Ord(TempString = 'vector');

    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'orientation');
    if TempString <> '' then
       TempGameVars.eScreenOrientation:= Ord(TempString = 'vertical');

    TempString:= XML_GetEntryValue(FileLine, 'width');
    if TempString <> '' then
       TempGameVars.eScreenResolution:= TempString+'x'+XML_GetEntryValue(FileLine, 'height');

    TempString:= XML_GetEntryValue(FileLine, 'refresh');
    if TempString <> '' then
       TempGameVars.eScreenRefreshRate:= TempString;
  end;

  function ParseDisplayEntry: Boolean;
  begin
    Result:= True;
    // for 0.106u12 and newer
    if GetScreenRes then
       Exit; // already got the screen info

    GetScreenRes:= True;
    TempString:= XML_GetEntryValue(FileLine, 'type');
    if TempString <> '' then
       TempGameVars.eScreenType:= GetScreenTypeIndex(TempString);

    TempString:= XML_GetEntryValue(FileLine, 'rotate');
    if TempString = '' then
       TempString:= '-1';

    case StrToInt(TempString) of
       0, 180: TempGameVars.eScreenOrientation:= 0; // horizontal
      90, 270: TempGameVars.eScreenOrientation:= 1; // vertical
    end;

    TempString:= '';
    case TempGameVars.eScreenOrientation of
      -1, 0: TempString:= XML_GetEntryValue(FileLine, 'width'); // horizontal orientation
          1: TempString:= XML_GetEntryValue(FileLine, 'height'); // vertical orientation
    end;
    if TempString <> '' then
       begin
         case TempGameVars.eScreenOrientation of
           -1, 0: TempGameVars.eScreenResolution:= TempString+'x'+XML_GetEntryValue(FileLine, 'height'); // horizontal orientation
               1: TempGameVars.eScreenResolution:= TempString+'x'+XML_GetEntryValue(FileLine, 'width'); // vertical orientation
         end;
       end;

    TempString:= XML_GetEntryValue(FileLine, 'refresh');
    if TempString <> '' then
       TempGameVars.eScreenRefreshRate:= TempString;
  end;

  function ParseSaveStateInfo: Boolean;
  begin
    TempString:= XML_GetEntryValue(FileLine, 'savestate');
    Result:= TempString <> '';
    if TempString <> '' then
       begin
         // supported|unsupported (from -listxml output)
         Result:= SameText(TempString, 'supported');
         TempGameVars.eSaveState:= Ord(Result);
       end;
  end;
  
  function ParseDriverStatusInfo: Boolean;
  begin
    Result:= True;
    TempGameVars.eDriverStatus:= SetIntegerValue('status', True);
    TempGameVars.eEmulationStatus:= SetIntegerValue('emulation', True);
    TempGameVars.eColorStatus:= SetIntegerValue('color', True);
    TempGameVars.eSoundStatus:= SetIntegerValue('sound', True);
    TempGameVars.eGraphicStatus:= SetIntegerValue('graphic', True);
    ParseSaveStateInfo;
  end;

  function ParseFeatureInfo: Boolean;
  var
    FeatureStr: String;
  begin
    // added August 28, 2017
    Result:= True;
    TempString:= XML_GetEntryValue(FileLine, 'type');
    if SameText(TempString, 'sound') then
       begin
         if TempGameVars.eSoundStatus = -1 then
            begin
              FeatureStr:= XML_GetEntryValue(FileLine, 'status');
              if FeatureStr = '' then
                 FeatureStr:= XML_GetEntryValue(FileLine, 'overall');

              if FeatureStr <> '' then
                 begin
                   if SameText(FeatureStr, 'unemulated') then
                      FeatureStr:= 'preliminary';
                   TempGameVars.eSoundStatus:= GetStatusIndex(FeatureStr);
                 end;
            end;
       end
    else
    if SameText(TempString, 'graphics') then
       begin
         if TempGameVars.eGraphicStatus = -1 then
            begin
              FeatureStr:= XML_GetEntryValue(FileLine, 'status');
              if FeatureStr = '' then
                 FeatureStr:= XML_GetEntryValue(FileLine, 'overall');

              if FeatureStr <> '' then
                 begin
                   if SameText(FeatureStr, 'unemulated') then
                      FeatureStr:= 'preliminary';
                   TempGameVars.eGraphicStatus:= GetStatusIndex(FeatureStr);
                 end;
            end;
       end
    else
    if SameText(TempString, 'palette') then
       begin
         if TempGameVars.eColorStatus = -1 then
            begin
              FeatureStr:= XML_GetEntryValue(FileLine, 'status');
              if FeatureStr = '' then
                 FeatureStr:= XML_GetEntryValue(FileLine, 'overall');

              if FeatureStr <> '' then
                 begin
                   if SameText(FeatureStr, 'unemulated') then
                      FeatureStr:= 'preliminary';
                   TempGameVars.eColorStatus:= GetStatusIndex(FeatureStr);
                 end;
            end;
       end;
  end;

  function ParseMainCPUInfo: Boolean;
  begin
    if CPUisAdded then
       Exit;
    TempString:= XML_GetEntryValue(FileLine, 'tag');
    if ((TempString = 'maincpu') or
        (TempString = ':maincpu')) then
       begin
         CPUisAdded:= True;
         ListCPU.Add(TempGameVars.eName+'='+XML_GetEntryValue(FileLine, 'name'));
       end;
  end;
  
  function ParseAudioDiscrete: Boolean;
  begin
    Result:= True;
    if IsDiscreteAudio then
       Exit; // if game is tagged as discrete audio, there's no need to check it again... it saves some CPU cycles
    TempString:= XML_GetEntryValue(FileLine, 'name');
    if SameText(TempString, 'discrete') then
       begin
         IsDiscreteAudio:= True;
         TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
       end;
  end;

  function ParseDeviceRef: Boolean;
  var
    LoopDevice, DeviceIndex: Integer;
  begin
    Result:= True;
    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'name');
    if SameText(TempString, 'discrete') then
       begin
         IsDiscreteAudio:= True;
         TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
         Exit;
       end;
    if SameText(TempString, 'software_list') then
       Exit;

    DeviceIndex:= ListROMsDeviceSet.IndexOf('['+TempString+']');
    if DeviceIndex <> -1 then
       begin
         TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(GetDeviceSetSize(TempString));
         ListDeviceROMsGame.WriteString(TempGameVars.eName, TempString, '1');
         for LoopDevice:= DeviceIndex+1 to ListROMsDeviceSet.Count-1 do
         begin
           if ListROMsDeviceSet[LoopDevice] = '' then
              Break
           else
              begin
                if not ROMsHeaderAdded then
                   begin
                     if ROMsList.Count > 0 then
                        ROMsList.Add('');
                     ROMsList.Add('['+TempGameVars.eName+']');
                     ROMsHeaderAdded:= True;
                   end;
                // add the device ROM into the game set; this must contain the full ROM info from "ROMInfoFull" var
                // ROMInfoFull var is filled and added to "ListROMsDeviceSet" in ParseROMDiskEntry() function
                // (February 19, 2018) added a "<devicename>devicename_str/>" new tag to know what device set is the ROM from
                //                     ... this is needed for the 2018 new MAME/HBMAME audit scan (device/bios .zip arrays in RAM)

                ROMsList.Add(ListROMsDeviceSet[LoopDevice]+MountGameInfoFieldStr('devicename', TempString)); // '<devicename>'+TempString+'/>');
              end;
         end;
       end;
  end;

  function CheckFileCRC32Collision(const iCRC32, iSHA1: String): Boolean;
  var
    cIndex: Integer;
  begin
    Result:= False;
    if IsCRC32Collision then
       Exit; // set already tagged as CRC32 collision, no need to check other files

    if iCRC32 = '' then
       Exit;

    if MAMEVersionNumber >= 177 then
       begin
         cIndex:= CRC32CollisionList.IndexOf(iCRC32);
         if (cIndex = -1) then //or ((cIndex = -1) and (TempGameVars.eName = 'seganetw')) then
            begin
              CRC32CollisionList.Add(iCRC32);
              SHA1CollisionList.Add(iSHA1);
            end
         else
            begin
              if SHA1CollisionList[cIndex] <> iSHA1 then
                 begin
                   IsCRC32Collision:= True;
                   Result:= True;
                 end;
            end;
       end;
  end;

  function ParseROMDiskEntry(FileID: ShortInt): Boolean; // "FileID", type of ROM being scanned -> 1: Device; 2: BIOS; 0: Game
  var
    FixedID, newFileID, IsBadDump: ShortInt; //IndexCHD
    ROMInfoFull, BiosInfoROM: String;
  begin
    ROMInfoFull:= '';
    RegionTagStr:= '';
    MediaTypeTagExtra:= '';
    newFileID:= FileID;
    romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD
    romName:= DecodeHTML(romName);

    romCRC32:= XML_GetEntryValue(FileLine, 'crc');
    romSHA1:= XML_GetEntryValue(FileLine, 'sha1');

    IsCHDFile:= PosEx('<disk ', FileLine) <> 0;

    IsOptionalROM:= PosEx('optional="yes"', FileLine) <> 0;

    romNameMerge:= XML_GetEntryValue(FileLine, 'merge'); // name of the file (ROM/CHD/Cart/Floppy/Cassette/Disc...) from parent game
    romNameMerge:= DecodeHTML(romNameMerge);

    if not IsCHDFile then
    begin
      if MAMEVersionNumber >= 130 then
       begin
         if (iDriver = 'segas24') or (iDriver = 'decocass') or (iDriver = 'ksys573') then
            RegionTagStr:= XML_GetEntryValue(FileLine, 'region');
       end;

      TempString:= romName+' == '+romCRC32+' == '+romSHA1;
      if ListDuplicateROMs.IndexOf(TempString) = -1 then
         ListDuplicateROMs.Add(TempString)
      else
         Exit; // file already added in the ROMs list... skip it
    end;

    if IsCHDFile then
       begin
         RegionTagStr:= XML_GetEntryValue(FileLine, 'region');
         // 1: Device; 2: BIOS; 0: Game
         case FileID of
           0: newFileID:= 12; // IndexCHD:= 12; // Game CHD files have   '3' in front
           1: newFileID:= 13; // IndexCHD:= 13; // Device CHD files have '5' in front
           2: newFileID:= 14; // IndexCHD:= 14; // BIOS CHD files have   '4' in front
         else
              newFileID:= 12; // IndexCHD:= 12; // default value is Game CHD!
         end;

         TempGameVars.eMediaType:= 1;
         if romNameMerge <> '' then
            begin
              if not SameText(ExtractFileExt(romNameMerge), '.chd') then
                 romNameMerge:= romNameMerge+'.chd';
            end;
         if not SameText(ExtractFileExt(romName), '.chd') then
            romName:= romName+'.chd';

         if romSHA1 = '' then
            romSHA1:= XML_GetEntryValue(FileLine, 'md5'); // for MAME 0.77 down to 0.69
       end
    else
       begin
         if (FileID in [1, 2]) and CheckFileCRC32Collision(romCRC32, romSHA1) then
            CRC32CollisionFile.Add(TempGameVars.eName)
         else
         if TempGameVars.eName = 'seganetw' then
            begin
              if FileID = 1 then
                 begin
                   CRC32CollisionList.Add(romCRC32);
                   SHA1CollisionList.Add(romSHA1);
                   IsCRC32Collision:= True;
                   CRC32CollisionFile.Add(TempGameVars.eName);
                 end;
            end;
       end;

    romSize:= XML_GetEntryValue(FileLine, 'size');
    if romSize <> '' then
       TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(romSize);

    IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
    ROMInfoFull:= MountROMInfo(newFileID, 0, IsCHDFile, romName, romCRC32, romSize, romSHA1, IsBadDump);

    if FileID = 0 then
       begin
         FixedID:= newFileID;
         // check is ROM is a bios ROM or normal ROM ... for games parsing only (4th pass parse)
         if FormMain.ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) then
            begin
              // here, I need to check for "BiosInfoROM=BiosName"
              if romNameMerge = '' then
                 BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName
              else
                 BiosInfoROM:='<name>'+romNameMerge+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName; // must use merge ROM name or the ROM will be set as game ROM instead of bios ROM

              if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                 begin
                   // ROMInfoFull:= 01 ; 02; 03; 04;... 20 (two chars, pos1 and pos2)
                   case IsCHDFile of
                     True : newFileID:= 14; // it's a bios CHD, change ID to #14
                     False: newFileID:= 02; // it's a bios ROM, change ID to #02
                   end;
                 end
              else
                 begin
                   if not IsCHDFile then
                      newFileID:= 00;

                   if romNameMerge <> '' then
                      ROMInfoFull[6]:= '1';
                 end;
            end
         else
            begin
              if not IsCHDFile then
                 newFileID:= 00;

              if romNameMerge <> '' then
                 ROMInfoFull[6]:= '1'; // ROM is from the parent set; change tag index in position 6
            end;
         if newFileID <> FixedID then
            begin
              // update the file entry with the new FileID tag
              TempString:= Format('%.2u', [newFileID]);
              ROMInfoFull[1]:= TempString[1];
              ROMInfoFull[2]:= TempString[2];
              TempString:= '';
            end;
       end;

    if FileID = 2 then // parsing bios sets
       BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;

    if not ROMsHeaderAdded then
       begin
         if ROMsList.Count > 0 then
            begin
              ROMsList.Add('');
              case FileID of
                1: ListROMsDeviceSet.Add(''); // temp device ROMs list
                2: ListROMsBiosSet.Add('');   // temp bios ROMs list
              end;
            end;
         ROMsList.Add('['+TempGameVars.eName+']');
         if FileID = 1 then // for Device sets parse only
            ListROMsDeviceSet.Add('['+TempGameVars.eName+']'); // temp device ROMs list
         ROMsHeaderAdded:= True;
       end;

    // check the region="" tag and change it if necessary
    if RegionTagStr <> '' then
       begin
         FixedID:= FixFileIDRegionROMCHD(newFileID, RegionTagStr, iDriver, IsCHDFile, MediaTypeTagExtra);
         if FixedID <> newFileID then
            begin
              TempString:= Format('%.2u', [FixedID]);
              ROMInfoFull[1]:= TempString[1];
              ROMInfoFull[2]:= TempString[2];
              TempString:= '';
            end;
       end;
    if SameText(romNameMerge, romName) then
       romNameMerge:= ''; // set to emtpy since the name is the same as of the file from parent game

    //ROMInfoFull --> 020000<name>sp-u2.sp1/><crc>e72943de/><sha1>5c6bba07d2ec8ac95776aa3511109f5e1e2e92eb/>
    if romNameMerge <> '' then
       ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('parentname', romNameMerge);

    if IsOptionalROM then
       ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('optional', '1');

    if MediaTypeTagExtra <> '' then
       ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('mediatype_tag', MediaTypeTagExtra); // new feature, mostly for "Disc" media type (CD, DVD, LaserDisc, CED VideoDisc, GD-ROM)

    if FileID = 1 then
       begin
         if TempGameVars.eName = 'seganetw' then
            ROMInfoFull[4]:= '1'; // force all ROMs from the device to be CRC32 collision (some games are not audited correctly without this) 
       end;

    ROMsList.Add(ROMInfoFull);

    case FileID of
      1: ListROMsDeviceSet.Add(ROMInfoFull); // temp device ROMs list; this must contain the full new ROM info from "ROMInfoFull" var
      2: ListROMsBiosSet.Add(BiosInfoROM); // 04399ab8=neogeo ----temp bios ROMs list (CRC32 only, MD5 for MAME 0.159 and newer... CHDs)
    end;

    if FileID = 1 then
       HasROMs:= True; // this is used only when creating device sets list!!!!!
  end;

begin
  EmuTitle:= GetArcadeEmulatorDescription(sysID, True);
  TitleErrorMsg:= 'Error: Create Games List ['+EmuTitle+']';

  FormStatus.SetProgressPos(0);
  tempFile:= GetArcadeSystemIniSection(sysID, True)+'_listxml.xml';
  IsGameEntry:= True;

  Result:= True;

  WarningMessagesList:= THashedStringList.Create;
  WarningMessagesList.BeginUpdate;
  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(GetGamesFolderEL+tempFile);

  if ListXML.Count > 0 then
  begin
    FormStatus.MessageStr('Parsing "'+tempFile+'" (1st pass). Creating device sets list.');

    ListCPU:= THashedStringList.Create;
  end;

  ListSamples:= THashedStringList.Create;
  ListSamples.BeginUpdate;

  ListROMsDeviceSet:= THashedStringList.Create; // will hold a temp list of ROMs for each device set

  DeviceSetSize:= THashedStringList.Create; // will hold device sets with their ROMs size "devicename=size" so bios/games can have proper "Game Size" info with device ROMs size included
  ListDeviceROMsGame:= TMemIniFile.Create(GetDeviceSetsFile(sysID));
  ListROMsBiosSet:= THashedStringList.Create; // will hold a temp list of ROMs for each bios set

  ListDuplicateROMs:= THashedStringList.Create; // will hold a temp list of ROMs to check for duplicates (CHDs are out of this list)
                                                // romname == CRC32 == SHA1

  BiosSet:= TMemIniFile.Create(GetBiosSetFile(sysID));

  Application.ProcessMessages;
  FormStatus.SetFocus;
  if ListXML.Count > 0 then
  begin
    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));
    ListGames.WriteString('info_file', 'description', '');

    ROMsList:= THashedStringList.Create;
    ROMsList.BeginUpdate;

    GetScreenRes:= False;
    CPUisAdded:= False;

    CRC32CollisionFile:= TStringList.Create; // this is for "sysname_crc32collision.txt" with set names (device/bios sets only)
    CRC32CollisionFile.BeginUpdate;
    CRC32CollisionList:= THashedStringList.Create; // a temp list with CRC32 list to check against new ROM files (device/bios sets only)
    SHA1CollisionList:= THashedStringList.Create;  // a temp list with SHA-1 list to check against new ROM files (device/bios sets only)

    IsResource:= False;
    ListROMsDeviceSet.BeginUpdate;
    DeviceSetSize.BeginUpdate;
    ListROMsBiosSet.BeginUpdate;
    // first tricky part, get all device sets before any game or bios
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
         begin
           GameIsDeviceSet:= IsDeviceSet;
           if GameIsDeviceSet then // isdevice="yes"
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                ROMsDetailsLine:= '';
                TempString:= '';
                SampleName:= '';
                AddedMemoryCardFileExt:= False;

                IsCRC32Collision:= False;
                CRC32CollisionList.Clear;
                SHA1CollisionList.Clear;

                Delete(FileLine, 1, 6);
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');

                TempGameVars.eDriverName:= FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile')); // fix driver name only for device sets

                TempGameVars.eMechanical:= IsMechanical;
                SampleName:= XML_GetEntryValue(FileLine, 'sampleof');
                TempGameVars.eGameSetStatus:= 2; // set to missing

                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');

                if (TempGameVars.eClone = '') and (ROMOf <> '') then
                   TempGameVars.eClone:= ROMOf;

                HasROMs:= False;
                GetScreenRes:= False;
                ROMsHeaderAdded:= False;
                IsDiscreteAudio:= PosEx('discrete', LowerCase(TempGameVars.eDriverName)) <> 0; // for UME and MAME 0.162+
                if IsDiscreteAudio then
                   TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
                TempString:= '';

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
                ListDuplicateROMs.BeginUpdate;
                IsResource:= True;
              end;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              begin
                TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15));
              end
           else
           // detection of CHD for device sets starting from MAME 0.159 - February 28, 2015
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then
              ParseROMDiskEntry(1)
           else
           if XML_CheckData(FileLine, '<sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, '<chip type="cpu" ') then
              ParseMainCPUInfo
           else

           if XML_CheckData(FileLine, '<chip type="audio" ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, '<display ') then
              ParseDisplayEntry
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                TempGameVars.eControls:= XML_GetEntryValue(FileLine, 'control');
                GetButtonsEntry(False); // get buttons count (for MAME v0.172 and older)
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // 0.107 to 0.139 use type="joy4way"... etc
                // for 0.144 and newer, get type="joy" and "ways="; "ways2="; "ways3="
                TempString:= XML_GetEntryValue(FileLine, 'type');
                if TempString <> '' then
                begin
                  if GetNewControlTags(TempString) then // will get new control tags "joy" "ways=?" only if there is "type" in <control entry
                     GetButtonsEntry(True); // for MAME 0.173 and newer (no more buttons="" tag in "<input" entry need to sum all buttons (includes buttons frp, keypad, keyboard, mahjong)
                     // only add if control is not found in "eControls" to avoid duplicating buttons count (April 27, 2016)
                end;
              end
           else
           if XML_CheckData(FileLine, '<driver ') then
              ParseDriverStatusInfo
           else
           if XML_CheckData(FileLine, '<feature ') then
              ParseFeatureInfo
           else
           //if XML_CheckData(FileLine, '<softwarelist ') then // no need to check for software lists in device sets... yet!
           //   begin
           //   end
           //else
           if XML_CheckData(FileLine, '</machine>') or XML_CheckData(FileLine, '</game>') then
              begin
                // device ID
                case sysID of
                  idMAME  : TempGameVars.eROMIdentification:= 07; // MAME
                  idHBMAME: TempGameVars.eROMIdentification:= 29; // HBMAME
                end;
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;

                if HasROMs or (MenuAddMAMEDeviceSetsWithNoROMs.Tag = 1) then // prevent from adding device sets with no ROMs
                   begin
                     ROMDataLine:= PopulateROMDataLineArcade;
                     ListGames.WriteString('devices', TempGameVars.eName, ROMDataLine);
                     GameStatusList.Add(PopulateGameStatusDataLine);
                                        
                     if TempGameVars.eGameSize > 0 then
                        DeviceSetSize.Add(TempGameVars.eName+'='+IntToStr(TempGameVars.eGameSize)); // add game size of device set for games later (May 17, 2015)
                   end;
                   
                ListDuplicateROMs.Clear;
                ListDuplicateROMs.EndUpdate;

                iDriver:= '';
                IsResource:= False;
              end;
         end;
      Application.ProcessMessages;
    end;
    ListGames.UpdateFile;
    ListROMsDeviceSet.EndUpdate;
    DeviceSetSize.EndUpdate;

    // now the 2nd tricky part, get all bios sets before games
    FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass). Creating BIOS sets list.');

    IsResource:= False;
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
         begin
           if IsBiosSet then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                ROMsDetailsLine:= '';
                TempString:= '';
                SampleName:= '';
                AddedMemoryCardFileExt:= False;

                IsCRC32Collision:= False;
                CRC32CollisionList.Clear;
                SHA1CollisionList.Clear;

                Delete(FileLine, 1, 6);
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                TempGameVars.eBiosName:= TempGameVars.eName;
                TempGameVars.eMechanical:= IsMechanical;
                GameIsDeviceSet:= IsDeviceSet;
                TempGameVars.eGameSetStatus:= 2; // missing
                IsResource:= True;
                CPUisAdded:= False;
                GetScreenRes:= False;
                BiosTitleAdded:= False;
                DefaultBiosAdded:= False;
                ROMsHeaderAdded:= False;
                IsDiscreteAudio:= False;
                TempGameVars.eDriverName:= XML_GetEntryValue(FileLine, 'sourcefile'); // no need to fix driver name here (yet) // FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile'));
                SampleName:= XML_GetEntryValue(FileLine, 'sampleof');

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');

                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');

                if (TempGameVars.eClone = '') and (ROMOf <> '') then
                   TempGameVars.eClone:= ROMOf;

                ListDuplicateROMs.BeginUpdate;
              end;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
                BiosSet.WriteString('Descriptions', TempGameVars.eName, TempGameVars.eTitle); // write description
                BiosTitleAdded:= True;
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              begin
                TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15));
              end
           else
           if XML_CheckData(FileLine, '<biosset ') then
              begin
                if not BiosTitleAdded then
                   begin
                     BiosSet.WriteString('Descriptions', TempGameVars.eName, TempGameVars.eTitle);
                     BiosTitleAdded:= True;
                   end;
                ROMsDetailsLine:= XML_GetEntryValue(FileLine, 'name'); // name of the biosset
                TempString:= DecodeHTML(XML_GetEntryValue(FileLine, 'description')); // description of the biosset
                if not DefaultBiosAdded then
                   begin
                     BiosSet.WriteString(TempGameVars.eName, 'default_bios', '');
                     DefaultBiosAdded:= True;
                   end;
                if PosEx('default="yes"', FileLine) <> 0 then
                   BiosSet.WriteString(TempGameVars.eName, 'default_bios', ROMsDetailsLine);
                BiosSet.WriteString(TempGameVars.eName, ROMsDetailsLine, TempString);
              end
           else
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then // bios "<disk" entry for MAME 0.159 and newer
              ParseROMDiskEntry(2)
           else
           if XML_CheckData(FileLine, '<device_ref ') then
              ParseDeviceRef
           else
           if XML_CheckData(FileLine, '<sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, '<chip type="cpu" ') then
              ParseMainCPUInfo
           else
           if XML_CheckData(FileLine, '<chip type="audio" ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, '<video ') then
              ParseVideoEntry // build 0.106u9 down to 0.70
           else
           if XML_CheckData(FileLine, '<display ') then
              ParseDisplayEntry // for 0.106u12 and newer
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                TempGameVars.eControls:= XML_GetEntryValue(FileLine, 'control');
                GetButtonsEntry(False); // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // 0.107 to 0.139 use type="joy4way"... etc
                // for 0.144 and newer, get type="joy" and "ways="; "ways2="; "ways3="
                TempString:= XML_GetEntryValue(FileLine, 'type');
                if TempString <> '' then
                begin
                  if GetNewControlTags(TempString) then // will get new control tags "joy" "ways=?" only if there is "type" in <control entry
                     GetButtonsEntry(True); // for MAME 0.173 and newer (no more buttons="" tag in "<input" entry need to sum all buttons (includes buttons from keypad, keyboard, mahjong)
                      // only add if control is not found in "eControls" to avoid duplicating buttons count (April 27, 2016)
                end;
              end
           else
           if XML_CheckData(FileLine, '<driver ') then
              ParseDriverStatusInfo
           else
           if XML_CheckData(FileLine, '<feature ') then
              ParseFeatureInfo
           else
           //if XML_CheckData(FileLine, '<softwarelist ') then // no need to check for software lists in BIOS sets (yet)
           //   begin
           //   end
           //else
           if XML_CheckData(FileLine, '</machine>') or XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty
                // bios ID
                case sysID of
                  idMAME  : TempGameVars.eROMIdentification:= 06; // MAME
                  idHBMAME: TempGameVars.eROMIdentification:= 28; // HBMAME
                end;
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                ListGames.WriteString('bios', TempGameVars.eName, ROMDataLine);
                GameStatusList.Add(PopulateGameStatusDataLine);

                ListDuplicateROMs.Clear;
                ListDuplicateROMs.EndUpdate;

                iDriver:= '';
                IsResource:= False;
              end;
         end;
      Application.ProcessMessages;
    end;
    ListROMsBiosSet.EndUpdate;
    BiosSet.UpdateFile;
    ListGames.UpdateFile;

    FreeAndNil(ListGames);

    CRC32CollisionFile.EndUpdate;
    FreeAndNil(CRC32CollisionList); // games do not have CRC32 collisions, yet! (February 15, 2018)
    FreeAndNil(SHA1CollisionList);
    if CRC32CollisionFile.Count > 0 then
       CRC32CollisionFile.SaveToFile(GetCRC32CollisionFile(sysID));
    FreeAndNil(CRC32CollisionFile);

    tmpList:= THashedStringList.Create;
    tmpList.LoadFromFile(GetGamesFolderEL+GetSystemFileName(sysID));
    tmpList.BeginUpdate;

    // get name, cloneof, romof fields
    // if romof, check if a bios is part of the game (parent games only)
    // Parsing "hbmame_listxml.xml" (3rd pass). Adding parent sections and listing parents with BIOS.

    FormStatus.MessageStr('Parsing "'+tempFile+'" (3rd pass). Adding parent sections and listing parents with BIOS.');
    //FormStatus.MessageStr('Parsing "'+tempFile+'" (3rd pass).'+#13#10+
    //                      'Creating parent games sections and a temporary list of parent games with BIOS.');
    games_bios:= THashedStringList.Create; // this is a temp list of parent games that have bios
    games_bios.BeginUpdate;

    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
         begin
           if (PosEx('cloneof="', FileLine) = 0) then
              begin
                if (not IsBiosSet) and (not IsDeviceSet) then
                   begin
                     TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                     tmpList.Add(' ');
                     tmpList.Add('['+TempGameVars.eName+']');
                     tmpList.Add(TempGameVars.eName+'=');
                     ROMOf:= XML_GetEntryValue(FileLine, 'romof');
                     if ROMOf <> '' then
                        games_bios.Add(TempGameVars.eName+'='+ROMOf);
                   end;
              end;
         end;
    end;
    games_bios.EndUpdate;
    tmpList.EndUpdate;
    tmpList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID));
    FreeAndNil(tmpList);
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    FormStatus.MessageStr('Parsing "'+tempFile+'" (4th and final pass). Creating games list.');
    FormStatus.SetProgressPos(0);

    // now, the games, excluding device/bios
    IsGameEntry:= False;
    GetScreenRes:= False;
    CPUisAdded:= False;
    NeoGeoMemcardAdded:= False;
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
         begin
           if ((not IsBiosSet) and
               (not IsDeviceSet)) then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                SampleName:= '';
                ROMsDetailsLine:= '';
                TempString:= '';
                AddedMemoryCardFileExt:= False;
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');
                SampleName:= XML_GetEntryValue(FileLine, 'sampleof');
                TempGameVars.eDriverName:= XML_GetEntryValue(FileLine, 'sourcefile'); // no need to fix driver name (yet) //FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile'));
                TempGameVars.eMechanical:= IsMechanical;
                TempGameVars.eGameSetStatus:= 2; // set to missing
                ROMsHeaderAdded:= False;
                SoftListHeaderAdded:= False;
                MemcardsCount:= 0;
                IsGameEntry:= True;
                CPUisAdded:= False;
                IsDiscreteAudio:= PosEx('discrete', LowerCase(TempGameVars.eDriverName)) <> 0; // for UME and MAME 0.162+
                if IsDiscreteAudio then
                   TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
                GetScreenRes:= False;
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if Assigned(BiosSet) then
                       begin
                         if BiosSet.ValueExists('Descriptions', ROMOf) and (TempGameVars.eBiosName = '') then
                            TempGameVars.eBiosName:= ROMOf;
                       end;
                   end;

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
                ListDuplicateROMs.BeginUpdate;
              end
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              begin
                TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15));
              end
           else
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then
              ParseROMDiskEntry(0)
           else
           if XML_CheckData(FileLine, '<device_ref ') then
              ParseDeviceRef
           else
           if XML_CheckData(FileLine, '<sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, '<chip type="cpu" ') then
              ParseMainCPUInfo
           else
           if XML_CheckData(FileLine, '<chip type="audio" ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, '<video ') then
              ParseVideoEntry // build 0.106u9 down to 0.70
           else
           if XML_CheckData(FileLine, '<display ') then
              ParseDisplayEntry // for 0.106u12 and newer
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                TempGameVars.eControls:= XML_GetEntryValue(FileLine, 'control');
                GetButtonsEntry(False); // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // 0.107 to 0.139 use type="joy4way"... etc
                // for 0.144 and newer, get type="joy" and "ways="; "ways2="; "ways3="
                TempString:= XML_GetEntryValue(FileLine, 'type');
                if TempString <> '' then
                begin
                  if GetNewControlTags(TempString) then // will get new control tags "joy" "ways=?" only if there is "type" in <control entry
                     GetButtonsEntry(True); // for MAME 0.173 and newer (no more buttons="" tag in "<input" entry need to sum all buttons (includes buttons from keypad, keyboard, mahjong)
                      // only add if control is not found in "eControls" to avoid duplicating buttons count (April 27, 2016)
                end;
              end
           else
           if XML_CheckData(FileLine, '<driver ') then
              ParseDriverStatusInfo
           else
           if XML_CheckData(FileLine, '<feature ') then
              ParseFeatureInfo
           else
           if XML_CheckData(FileLine, '<device type="memcard" ') then
              ParseMemCardDeviceTag(MainLoop)
           else
           if XML_CheckData(FileLine, '<softwarelist ') then
              begin
                TempString:= XML_GetEntryValue(FileLine, 'name');
                TempString2:= XML_GetEntryValue(FileLine, 'filter');
                if not IsMultiSlotSoftwareList(TempString) then
                   begin
                     AddSoftListEntry(TempString, TempString2); // add to machines list
                     AddToListSoftwareListXML(TempString);

                     AddSoftwareListMachine(TempString, TempGameVars.eName); // add to software names list with supported machines
                   end;
                if TempGameVars.eName = 'vectrex' then // vectrex is not arcade...
                   begin
                     AddSoftListEntry(TempString, TempString2);
                     AddToListSoftwareListXML(TempString);
                     AddSoftwareListMachine(TempString, TempGameVars.eName);
                   end;
                TempString:= '';
                TempString2:= '';
              end
           else
           if XML_CheckData(FileLine, '</machine>') or XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty!!!
                // must verify if is clone or parent, neogeo or classic, raster or vector
                if TempGameVars.eClone = '' then
                   begin
                     // it's a parent game
                     case sysID of
                       idMAME  : TempGameVars.eROMIdentification:= 04; // MAME Parent
                       idHBMAME: TempGameVars.eROMIdentification:= 26; // HBMAME Parent
                     end;
                   end
                else
                   begin
                     // it's a clone game
                     case sysID of
                       idMAME  : TempGameVars.eROMIdentification:= 05; // MAME Clone
                       idHBMAME: TempGameVars.eROMIdentification:= 27; // HBMAME Clone
                     end;
                   end;
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);

                iDriver:= '';
                ListDuplicateROMs.Clear;
                ListDuplicateROMs.EndUpdate;
                
                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    ListDeviceROMsGame.UpdateFile;
    GameStatusList.EndUpdate;
    if Assigned(SoftList) then
       SoftList.EndUpdate;

    SoftwareListsToProcess.EndUpdate;
    SoftwareListsToProcess.Sorted:= False;
    //if Assigned(SoftwareListsToCreate) then
    //   begin
    //     SoftwareListsToCreate.EndUpdate;
    //     SoftwareListsToCreate.Sorted:= False;
    //   end;
  end;

  WarningMessagesList.EndUpdate;
  if WarningMessagesList.Count > 0 then
     begin
       GenerateMessage('Warning', 'Warning messages.', WarningMessagesList.Text);
     end;
  FormStatus.MessageStr('Saving files and freeing memory.');

  FreeAndNil(WarningMessagesList);
  FreeAndNil(ListDuplicateROMs); // free this THashedStringList here since it will not be used for software list games....

  ListCPU.SaveToFile(GetMainCPUFile(sysID));
  ListSamples.SaveToFile(GetAudioSamplesFile(sysID));

  Application.ProcessMessages;
  ListGames.WriteString('info_file', 'description', EmuTitle+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[sysID]);

  ListGames.UpdateFile;
  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 2));

  DeleteFile(GetGamesFolderEL+tempFile); // delete temp "listxml.xml" file

  if Assigned(SoftList) then
     begin
       if SoftList.Count > 0 then
          SoftList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 5));
     end;
     
  if Assigned(SoftNameMachinesList) then
     SoftNameMachinesList.UpdateFile;

  if Assigned(MemCardMachineList) then
     begin                                
       MemCardMachineList.EndUpdate;
       if MemCardMachineList.Count > 0 then
          MemCardMachineList.SaveToFile(GetMemcardListFile(sysID));
       FreeAndNil(MemCardMachineList);
     end;

  Application.ProcessMessages;
  if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
     ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1))
  else
     begin
       CallMessageBox;
       AddMsgText('ROMs list file ');
       AddMsgText(GetGamesFolderEL+GetSystemFileName(sysID, 1), MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
       GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
     end;
  FreeMemVariables;

  if MAMEVersionNumber >= 177 then
     CheckCRC32Collisions(sysID);

  // this loop will remove the = sign from the machine names
  if FileExists(GetMAMEMachineSoftListFile(False, sysID)) then
     begin
       SoftList:= TStringList.Create;
       SoftList.LoadFromFile(GetMAMEMachineSoftListFile(False, sysID));
       SoftList.BeginUpdate;

       for MainLoop:= SoftList.Count-1 downto 0 do
       begin
         TempString:= SoftList[MainLoop];
         if (TempString <> '') and (TempString[1] <> '[') then
         begin
           TempString:= Copy(TempString, 1, Length(TempString)-1);
           SoftList[MainLoop]:= TempString;
         end;
       end;

       SoftList.EndUpdate;
       SoftList.SaveToFile(GetMAMEMachineSoftListFile(False, sysID));
       FreeAndNil(SoftList);
     end;

  // remove the '=0' from device set names
  case ValidateFile(GetDeviceSetsFile(sysID)) of
    True:
      begin
        ListDuplicateROMs:= THashedStringList.Create;
        ListDuplicateROMs.LoadFromFile(GetDeviceSetsFile(sysID));
        IsGameEntry:= False;
        ListDuplicateROMs.BeginUpdate;
        for MainLoop:=0 to ListDuplicateROMs.Count-1 do
        begin
          TempString:= ListDuplicateROMs[MainLoop];
          iCount:= PosEx('=', TempString);
          if iCount <> 0 then
             begin
               IsGameEntry:= True;
               Delete(TempString, iCount, 2);
               ListDuplicateROMs[MainLoop]:= TempString;
             end;
        end;
        ListDuplicateROMs.EndUpdate;
        if IsGameEntry then
           ListDuplicateROMs.SaveToFile(GetDeviceSetsFile(sysID));
        FreeAndNil(ListDuplicateROMs);        
      end;
    False: DeleteFile(GetDeviceSetsFile(sysID));
  end;

  Application.ProcessMessages;

  FormStatus.TitleStr('Create Multi-Slot Software List: '+EmuTitle);
  CreateSoftwareListXML(sysID, 'neogeo', True);
  CreateSoftwareListXML(sysID, 'stv', True);

  if MenuCreateMAMESoftwareListGames.Tag = 0 then
     SoftListDeleteGamesFiles(sysID, 0) // delete all sofware games list files since there are no software lists in "SoftwareListsToCreate" var
  else
  if Assigned(SoftwareListsToProcess) then
     begin
       // this holds a list of all MAME software lists to create their games list; 'eldir\softwarelist' folder
       case MenuCreateMAMESoftwareListGames.Tag of
         1: FormStatus.TitleStr('Create '+EmuTitle+' Software Games Lists (Update Mode)');
         2: FormStatus.TitleStr('Create '+EmuTitle+' Software Games Lists (Overwrite Mode)');
       end;

       //FormStatus.TitleStr('Create Software List: '+EmuTitle);

       // 0 -> disabled, don't create softlists;
       // 1 -> update mode: create softlist games and update existing ones
       // 2 -> overwrite mode: delete all softlists and create new ones
       if SoftwareListsToProcess.Count > 0 then
          begin
            SoftListRemoveExcludedList(sysID, SoftwareListsToProcess);
            SoftListValidateListsXML(sysID, SoftwareListsToProcess);
            SoftListDeleteGamesFiles(sysID, MenuCreateMAMESoftwareListGames.Tag, SoftwareListsToProcess); // delete softlist files from '\arcade\games\mame_softwarelist_games\"
          end;
       if SoftwareListsToProcess.Count > 0 then
          begin
            iCount:= SoftwareListsToProcess.Count;
            if iCount > 1 then
               SetLabelSoftwareScanCountVisible(True);

            for MainLoop:= 0 to SoftwareListsToProcess.Count-1 do
            begin
              if FormStatus.LabelSoftwareScanCount.Visible then
                 FormStatus.LabelSoftwareScanCount.Caption:= Format(FormStatus.LabelSoftwareScanCount.Hint, [MainLoop+1, iCount]);
              CreateSoftwareListXML(sysID, SoftwareListsToProcess[MainLoop], False);
            end;
            SetLabelSoftwareScanCountVisible(False);
          end;
       // FreeAndNil(SoftwareListsToCreate); // cannot free this here (March 29, 2018)
     end;
end;

function TFormMain.CreateGamesList_ListInfo(sysID: Byte): Boolean;
var
  ListXML, ROMsList, games_bios, ListCPU, ListSamples, ListROMsBiosSet, ListDrivers: THashedStringList;
  FileLine, ROMsDetailsLine, TempString, ROMDataLine, ROMOf: String;
  MainLoop: Integer;
  IsResource, IsGameEntry, IsCHDFile, GetScreenRes: Boolean;
  BiosSet: TMemIniFile;
  tempFile, tempDriverFile, romName, romCRC32, romSize, romSHA1, SampleName: String;
  CPUisAdded, BiosTitleAdded, DefaultBiosAdded: Boolean;
  TitleErrorMsg, EmuTitle: String;
  tmpList: THashedStringList;
  HasROMs, ROMsHeaderAdded, IsDiscreteAudio: Boolean;
  GameStatusList: TStringList;
  IsBadDump: ShortInt;

  function GetStatusIndex(const StatusString: String): ShortInt;
  begin
    Result:= -1;
    if SameText(StatusString, 'good') then
       Result:= 0
    else
    if SameText(StatusString, 'imperfect') then
       Result:= 1
    else
    if SameText(StatusString, 'preliminary') then
       Result:= 2;
  end;

  function GetScreenTypeIndex(const ScreenTypeString: String): Integer;
  begin
    Result:= -1;
    if SameText(ScreenTypeString, 'raster') then
       Result:= 0
    else
    if SameText(ScreenTypeString, 'vector') then
       Result:= 1
    else
    if SameText(ScreenTypeString, 'lcd') then
       Result:= 2
    else
    if SameText(ScreenTypeString, 'svg') then
       Result:= 3
    else
    if SameText(ScreenTypeString, 'unknown') then
       Result:= 4
    else
       begin
         CallMessageBox;
         AddMsgText('New screen type found: ');
         AddMsgText(ScreenTypeString, MsgTxtColors.colorFileName, [fsBold]);
         AddMsgText(#13#10+'Game: ');
         AddMsgText(TempGameVars.eTitle, MsgTxtColors.colorFileName, [fsBold]);
         AddMsgText(#13#10+'Name: ');
         AddMsgText(TempGameVars.eName, MsgTxtColors.colorFileName, [fsBold]);
         AddMsgText(#13#10+'Driver: ');
         AddMsgText(TempGameVars.eDriverName, MsgTxtColors.colorFileName, [fsBold]);
         AddMsgText(#13#10+#13#10+'   This type is not yet supported. Please contact the author '+
                         'with this new info. In the mean time, the screen type for this '+
                         'game will be set as "none".');
         GenerateMessage(TitleErrorMsg, 'Screen type', '', 2);
       end;
  end;

  function SetIntegerValue(const strValue: String; DriverStatus: Boolean): Integer;
  begin
    Result:= -1;
    TempString:= '';
    TempString:= ListInfo_GetEntryValue(FileLine, strValue, ' ');
    if TempString <> '' then
       begin
         case DriverStatus of
           True : Result:= GetStatusIndex(TempString);
           False: Result:= StrToInt(TempString);
         end;
       end;
  end;

  function AddButtonsControl: Boolean;
  begin
    Result:= TempGameVars.eButtonsCount > 0;
    if not Result then
       Exit;
    if TempGameVars.eControls = '' then
       TempGameVars.eControls:= 'buttons';
  end;

  function GetButtonsEntry: Boolean;
  var
    bStr: String;
  begin
    bStr:= ListInfo_GetEntryValue(FileLine, 'buttons', ' ');
    Result:= bStr <> '';
    if Result then
       TempGameVars.eButtonsCount:= StrToInt(bStr);
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ListDrivers);
    FreeAndNil(ROMsList);
    FreeAndNil(BiosSet);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    FreeAndNil(ListCPU);
    FreeAndNil(games_bios);
    FreeAndNil(ListROMsBiosSet);
    FreeAndNil(ListSamples);
    Result:= False;
  end;

  function ReplaceChar(const iText: String; CharToReplace, NewChar: Char): String;
  var
    iPos: Integer;
  begin
    Result:= iText;
    iPos:= PosEx(CharToReplace, iText);
    while iPos > 0 do
    begin
      Result[iPos]:= NewChar;
      iPos:= PosEx(CharToReplace, iText);
    end;
  end;

  function ParseVideoEntry: Boolean;
  begin
    Result:= True;
    // build v0.37 beta 15 to v0.68
    if GetScreenRes then
       Exit; // already got the video info

    GetScreenRes:= True;
    TempString:= '';
    TempGameVars.eScreenType:= Ord(PosEx('screen vector', FileLine) <> 0);

    TempGameVars.eScreenOrientation:= Ord(PosEx('orientation vertical', FileLine) <> 0);

    TempString:= ListInfo_GetEntryValue(FileLine, 'x', ' ');
    if TempString <> '' then
       TempGameVars.eScreenResolution:= TempString+'x'+ListInfo_GetEntryValue(FileLine, 'y', ' ');

    TempString:= ListInfo_GetEntryValue(FileLine, 'freq', ' ');
    if TempString <> '' then
       TempGameVars.eScreenRefreshRate:= TempString;
  end;

  function ParseDriverStatusInfo: Boolean;
  begin
    Result:= True;
    TempGameVars.eDriverStatus:= SetIntegerValue('status', True);
    //TempGameVars.eEmulationStatus:= SetIntegerValue('emulation', True);
    TempGameVars.eColorStatus:= SetIntegerValue('color', True);
    TempGameVars.eSoundStatus:= SetIntegerValue('sound', True);
    //TempGameVars.eGraphicStatus:= SetIntegerValue('graphic', True);
  end;

  function ParseMainCPUInfo: Boolean;
  begin
    if CPUisAdded then
       Exit;
    TempString:= ListInfo_GetEntryValue(FileLine, 'name', ' ');
    CPUisAdded:= True;
    if TempString <> '' then
       ListCPU.Add(TempGameVars.eName+'='+TempString);
  end;
  
  function ParseAudioDiscrete: Boolean;
  begin
    Result:= True;
    if IsDiscreteAudio then
       Exit; // if game is tagged as discrete audio, there's no need to check it again; it saves some CPU cycles
    if PosEx('discrete', LowerCase(FileLine)) <> 0 then
       begin
         IsDiscreteAudio:= True;
         TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
       end;
  end;

  function ParseROMDiskEntry(FileID: ShortInt; IsDisk: Boolean = False): Boolean; // FileID (type of ROM being scanned) -> 1: Device; 2: BIOS; 0: Game
  var
    ROMInfoFull, BiosInfoROM: String;
    IndexCHD: ShortInt;
  begin
    romName:= ListInfo_GetEntryValue(FileLine, 'name', ' '); //name of the ROM
    romName:= DecodeHTML(romName);

    romCRC32:= ListInfo_GetEntryValue(FileLine, 'crc', ' ');
    romSHA1:= ListInfo_GetEntryValue(FileLine, 'sha1', ' ');

    IsCHDFile:= IsDisk;

    if IsCHDFile then
       begin
         TempGameVars.eMediaType:= 1;
         if not SameText(ExtractFileExt(romName), '.chd') then
            romName:= romName+'.chd';
         IndexCHD:= 12; // it's a normal CHD file... old MAME builds do not have the region="" tag...

         if romSHA1 = '' then // for MAME 0.159 and newer
            romSHA1:= ListInfo_GetEntryValue(FileLine, 'md5', ' '); // for MAME 0.77 down to 0.69
       end;

    // FileID -> 1: Device (not used by -listinfo); 2: BIOS; 0: Game
    romSize:= ListInfo_GetEntryValue(FileLine, 'size', ' ');
    if romSize <> '' then
       TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(romSize);

    IsBadDump:= PosEx('baddump', FileLine);
    case IsCHDFile of
      True : ROMInfoFull:= MountROMInfo(IndexCHD, 0, IsCHDFile, romName, romCRC32, romSize, romSHA1, IsBadDump);
      False: ROMInfoFull:= MountROMInfo(FileID, 0, IsCHDFile, romName, romCRC32, romSize, romSHA1, IsBadDump);
    end;

    if (FileID = 0) and (not IsCHDFile) then
       begin
         // check is ROM is a BIOS ROM or normal ROM, for games parsing only (4th pass parse)
         BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;

         if FormMain.ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) then
            begin
              if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                 ROMInfoFull[2]:= '2' // yes, it's a BIOS ROM, it contains the '2' in front
              else
                 ROMInfoFull[2]:= '0'; // no, it's a game ROM... it contains the '0' in front
            end
         else
            ROMInfoFull[2]:= '0'; // set game ID tag
       end;

    if FileID = 2 then // parsing BIOS sets
       BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;

    if not ROMsHeaderAdded then
       begin
         if ROMsList.Count > 0 then
            begin
              ROMsList.Add(' ');
              if FileID = 2 then
                 ListROMsBiosSet.Add(' '); // temp bios ROMs list
            end;
         ROMsList.Add('['+TempGameVars.eName+']');
         ROMsHeaderAdded:= True;
       end;

    ROMsList.Add(ROMInfoFull); // add ROM to ROMs list
    if FileID = 2 then
       ListROMsBiosSet.Add(BiosInfoROM); // 04399ab8=neogeo ----temp bios ROMs list (CRC32 only, MD5 for MAME 0.159 and newer... CHDs)!!!
       //ListROMsBiosSet: --> <name>sp-u2.sp1<crc>e72943de<sha1>5c6bba07d2ec8ac95776aa3511109f5e1e2e92eb=neogeo
       
    if not IsCHDFile then
       HasROMs:= True;
  end;

begin
  EmuTitle:= GetArcadeEmulatorDescription(sysID, True);
  TitleErrorMsg:= 'Error: Create Games List ['+EmuTitle+']';

  FormStatus.SetProgressPos(0);

  tempFile:= GetArcadeSystemIniSection(sysID, True)+'_listinfo.txt';
  tempDriverFile:= GetArcadeSystemIniSection(sysID, True)+'_listdetails.txt';
  IsGameEntry:= True;

  Result:= True;
  FormStatus.MessageStr('Parsing "'+tempDriverFile+'"');
  ListDrivers:= THashedStringList.Create;
  ListDrivers.LoadFromFile(GetGamesFolderEL+tempDriverFile);
  ListDrivers.BeginUpdate;
  for MainLoop:=0 to ListDrivers.Count -1 do
      ListDrivers[MainLoop]:= Trim(Copy(ListDrivers[MainLoop], 1, 8))+'='+Trim(Copy(ListDrivers[MainLoop], 10, 10));
  ListDrivers.EndUpdate;

  FormStatus.MessageStr('Parsing "'+tempFile+'" (1st pass). Creating BIOS sets list.');
  
  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(GetGamesFolderEL+tempFile);

  ListCPU:= THashedStringList.Create;

  ListSamples:= THashedStringList.Create;
  ListSamples.BeginUpdate;
  ListROMsBiosSet:= THashedStringList.Create; // a temp list of ROMs for each bios set

  BiosSet:= TMemIniFile.Create(GetBiosSetFile(sysID));

  Application.ProcessMessages;
  FormStatus.SetFocus;
  if ListXML.Count > 0 then
  begin
    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;

    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    ListGames.WriteString('info_file', 'description', '');

    ROMsList:= THashedStringList.Create;
    ROMsList.BeginUpdate;

    GetScreenRes:= False;
    CPUisAdded:= False;

    IsResource:= False;
    ListROMsBiosSet.BeginUpdate;

    // the tricky part, get all bios sets before games
    // there's nothing beyond rom () entry... no need to check for them (April 04, 2015)

    IsResource:= False;
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, 'resource (') then
         begin
           ClearMemGameInfo(TempGameVars);
           TempGameVars.eSystemID:= sysID;
           ROMsDetailsLine:= '';
           TempString:= '';
           SampleName:= '';
           ROMOf:= '';
           TempGameVars.eGameSetStatus:= 2; // set to missing
           IsResource:= True;
           CPUisAdded:= False;
           GetScreenRes:= False;
           BiosTitleAdded:= False;
           DefaultBiosAdded:= False;
           ROMsHeaderAdded:= False;
           IsDiscreteAudio:= False;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, 'name ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eName:= FileLine;
                TempGameVars.eBiosName:= TempGameVars.eName;
                TempGameVars.eDriverName:= TempGameVars.eName+'.c';// ListDrivers.Values[TempGameVars.eName]; // bios drivers not listed in -listdetails!!!
              end
           else
           if XML_CheckData(FileLine, 'description ') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, Length(FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, False);
                BiosSet.WriteString('Descriptions', TempGameVars.eName, TempGameVars.eTitle);
                BiosTitleAdded:= True;
              end
           else
           if XML_CheckData(FileLine, 'year ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eYear:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'manufacturer ') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, Length(FileLine)-15))
           else
           if XML_CheckData(FileLine, 'history ') then
              begin
                // do nothing, added this check to make parsing faster (it does make a difference)
              end
           else
           if XML_CheckData(FileLine, 'rom ') then
              ParseROMDiskEntry(2)
           else
           if FileLine = ')' then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty
                // bios ID
                TempGameVars.eROMIdentification:= 06; // MAME
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                ListGames.WriteString('bios', TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);
                IsResource:= False;
              end;
         end;
      Application.ProcessMessages;
    end;
    ListROMsBiosSet.EndUpdate;
    BiosSet.UpdateFile;
    ListGames.UpdateFile;

    FreeAndNil(ListGames);
    tmpList:= THashedStringList.Create;
    tmpList.LoadFromFile(GetGamesFolderEL+GetSystemFileName(sysID));
    tmpList.BeginUpdate;

    // get name, cloneof, romof fields
    // if romof, check if a bios is part of the game (parent games only)
    FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass). Adding parent sections and listing parents with BIOS.');
    //FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass).'+#13#10+
    //                      'Creating parent games sections and a temporary list of parent games with BIOS.');
    games_bios:= THashedStringList.Create; // a parent games list that have bios
    games_bios.BeginUpdate;

    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, 'game (') then
         begin
           ClearMemGameInfo(TempGameVars);
           TempString:= '';
           IsResource:= True;
           ROMOf:= '';
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, 'name ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eName:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'history ') then
              begin
                // do nothing, added this check to make parsing faster (it does make a difference)
              end
           else
           if XML_CheckData(FileLine, 'cloneof ') then
              begin
                Delete(FileLine, 1, 8);
                TempGameVars.eClone:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'romof ') then
              begin
                Delete(FileLine, 1, 6);
                ROMOf:= FileLine;
              end
           else
           if FileLine = ')' then
              begin
                IsResource:= False;
                if TempGameVars.eClone = '' then
                   begin
                     // add parent game entry in games list file "mame.el"
                     tmpList.Add(' ');
                     tmpList.Add('['+TempGameVars.eName+']');
                     tmpList.Add(TempGameVars.eName+'=');
                     if ROMOf <> '' then
                        games_bios.Add(TempGameVars.eName+'='+ROMOf); // temporary parent games with bios sets
                   end;
              end;
         end;
      //FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      //Application.ProcessMessages;
    end;
    games_bios.EndUpdate;
    tmpList.EndUpdate;
    tmpList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID));

    FreeAndNil(tmpList);
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    FormStatus.MessageStr('Parsing "'+tempFile+'" (3rd and final pass). Creating games list.');
    FormStatus.SetProgressPos(0);

    // now, the parent and clone games (no device/bios)
    IsGameEntry:= False;
    GetScreenRes:= False;
    CPUisAdded:= False;
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, 'game (') then
         begin
           ClearMemGameInfo(TempGameVars);
           TempGameVars.eSystemID:= sysID;
           SampleName:= '';
           ROMsDetailsLine:= '';
           TempString:= '';
           ROMOf:= '';
           TempGameVars.eGameSetStatus:= 2; // set to missing
           ROMsHeaderAdded:= False;
           IsGameEntry:= True;
           CPUisAdded:= False;
           IsDiscreteAudio:= False;
           GetScreenRes:= False;
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, 'name ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eName:= FileLine;
                TempGameVars.eDriverName:= ListDrivers.Values[TempGameVars.eName];
              end
           else
           if XML_CheckData(FileLine, 'description ') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, Length(FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, False);
              end
           else
           if XML_CheckData(FileLine, 'year ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eYear:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'manufacturer ') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, Length(FileLine)-15))
           else
           if XML_CheckData(FileLine, 'history ') then
              begin
                // do nothing, added this check to make parsing faster (it does make a difference)
              end
           else
           if XML_CheckData(FileLine, 'cloneof ') then
              begin
                Delete(FileLine, 1, 8);
                TempGameVars.eClone:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'romof ') then
              begin
                Delete(FileLine, 1, 6);
                ROMOf:= FileLine;
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if Assigned(BiosSet) then
                       begin
                         if BiosSet.ValueExists('Descriptions', ROMOf) and (TempGameVars.eBiosName = '') then
                            TempGameVars.eBiosName:= ROMOf;
                       end;
                   end;
              end
           else
           if XML_CheckData(FileLine, 'rom ') then
              ParseROMDiskEntry(0)
           else
           if XML_CheckData(FileLine, 'disk ') then
              ParseROMDiskEntry(0, True)
           else
           if XML_CheckData(FileLine, 'sampleof ') then
              begin
                Delete(FileLine, 1, 9);
                SampleName:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, 'chip ( type cpu ') then
              ParseMainCPUInfo
           else
           if XML_CheckData(FileLine, 'chip ( type audio ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, 'video ') then
              ParseVideoEntry
           else
           if XML_CheckData(FileLine, 'input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= ListInfo_GetEntryValue(FileLine, 'players', ' ');
                TempGameVars.eControls:= ListInfo_GetEntryValue(FileLine, 'control', ' ');
                GetButtonsEntry; // get buttons count
              end
           else
           if XML_CheckData(FileLine, 'driver ') then
              ParseDriverStatusInfo
           else
           if FileLine = ')' then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if Assigned(BiosSet) then
                       begin
                         if BiosSet.ValueExists('Descriptions', ROMOf) and (TempGameVars.eBiosName = '') then
                            TempGameVars.eBiosName:= ROMOf;
                       end;
                   end;

                // must verify if is clone or parent
                if TempGameVars.eClone = '' then
                   TempGameVars.eROMIdentification:= 04 // MAME Parent
                else
                   TempGameVars.eROMIdentification:= 05; // MAME Clone

                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);
                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    GameStatusList.EndUpdate;
  end;
  FormStatus.MessageStr('Saving files and freeing memory.');
  ListCPU.SaveToFile(GetMainCPUFile(sysID));

  ListSamples.SaveToFile(GetGamesFolderEL+GetArcadeSystemIniSection(sysID, True)+'_samples.el');

  Application.ProcessMessages;
  ListGames.WriteString('info_file', 'description', EmuTitle+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[sysID]);

  ListGames.UpdateFile;

  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 2));

  DeleteFile(GetGamesFolderEL+tempFile); // delete temp lisinfo.txt file
  DeleteFile(GetGamesFolderEL+tempDriverFile);

  Application.ProcessMessages;
  if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
     ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1))
  else
     begin
       CallMessageBox;
       AddMsgText('ROMs list file ');
       AddMsgText(GetGamesFolderEL+GetSystemFileName(sysID, 1), MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
       GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
     end;
  FreeMemVariables;
  Application.ProcessMessages;
end;

procedure TFormMain.CheckCRC32Collisions(sysID: Byte);
var
  ROMsFileDB, CRC32List, FullChecksumList: THashedStringList;
  Loop, CollisionIndex, FirstROMIndex: Integer;
  LineStr, PrevLineStr, romCRC32, romSHA1, SetName, ChecksumStr: String;
  IsModified, NewGame: Boolean;
begin
  if not FileExists(GetGamesFolderEL+GetSystemFileName(sysID, 1)) then
     Exit;

  if FormStatus.Visible then
     FormStatus.MessageStr('Checking for CRC32 collisions in the same set.');

  IsModified:= False;
  NewGame:= False;

  ROMsFileDB:= THashedStringList.Create;
  ROMsFileDB.LoadFromFile(GetGamesFolderEL+GetSystemFileName(sysID, 1));
  ROMsFileDB.BeginUpdate;

  CRC32List:= THashedStringList.Create;
  CRC32List.BeginUpdate;

  FullChecksumList:= THashedStringList.Create;
  FullChecksumList.BeginUpdate;

  for Loop:=0 to ROMsFileDB.Count-1 do
  begin
    LineStr:= ROMsFileDB[Loop];
    if LineStr = '' then
       begin
         NewGame:= False;
       end
    else
    if NewGame then
    begin
      if FirstROMIndex = -1 then
         FirstROMIndex:= Loop;
      romCRC32:= SoftListGetEntryValue(LineStr, 'crc');
      romSHA1:= SoftListGetEntryValue(LineStr, 'sha1');
      ChecksumStr:= romCRC32+'='+romSHA1;

      if StrToInt(LineStr[1]+LineStr[2]) < 12 then // only check ROMs
      begin
        if romCRC32 <> '' then
        begin
          if FullChecksumList.IndexOf(ChecksumStr) = -1 then
          begin
            CollisionIndex:= CRC32List.IndexOf(romCRC32);
            if CollisionIndex <> -1 then
            begin
              LineStr[4]:= '1';
              ROMsFileDB[Loop]:= LineStr;
              PrevLineStr:= ROMsFileDB[FirstROMIndex+CollisionIndex];
              if PrevLineStr[4] <> '1' then
                 begin
                   PrevLineStr[4]:= '1';
                   ROMsFileDB[FirstROMIndex+CollisionIndex]:= PrevLineStr;
                 end;
              IsModified:= True;
            end;
          end;
        end;
      end;

      // always add the current ROM being scanned AFTER the collision check; all ROMs and CHD files must be added or the CollisionIndex will be messed up!
      CRC32List.Add(romCRC32);
      FullChecksumList.Add(ChecksumStr);
    end
    else
    begin
      if LineStr[1] = '[' then
         begin
           NewGame:= True;
           FirstROMIndex:= -1;
           CollisionIndex:= -1;
           CRC32List.Clear;
           FullChecksumList.Clear;
           SetName:= LineStr;
           Delete(SetName, 1, 1);
           Delete(SetName, Length(SetName), 1);
         end;
    end;
    if not NewGame then
    begin
      CRC32List.Clear;
      FullChecksumList.Clear;
      FirstROMIndex:= -1;
      CollisionIndex:= -1;
    end;
    Application.ProcessMessages;
  end;

  ROMsFileDB.EndUpdate;
  CRC32List.EndUpdate;
  FreeAndNil(CRC32List);
  FullChecksumList.EndUpdate;
  FreeAndNil(FullChecksumList);

  if IsModified then
     ROMsFileDB.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1));
  FreeAndNil(ROMsFileDB);
end;

function TFormMain.CreateGamesListDaphne: Boolean;
var
  configXML: THashedStringList;
  TempString, ROMDataLine,
  strMainDescription, strMainDriverName, FileLine: String;
  MainLoop: Integer;
  IsGameEntry, XML_IsGameList: Boolean;
  iVersion: String;
  GameStatusList: TStringList;
begin
  Result:= FileExists(EmulatorFile[idDaphne]);
  if not Result then
     Exit;
  CheckAndCreateFolder(GetGamesFolderEL);
  TempString:= ExtractFilePath(EmulatorFile[idDaphne])+'config.xml';
  if not ValidateFile(TempString) then
     begin
       CallMessageBox;
       AddMsgText('File ');
       AddMsgText(TempString, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not found or is blank. Aborting...');
       GenerateMessage('Error', GetArcadeEmulatorDescription(idDaphne)+#13#10+'File access error.', '', 2, False, 1);
       Result:= False;
       Exit;
     end;
  FormStatus.SetProgressPos(0);
  FormStatus.TitleStr('Create Games List: '+GetArcadeEmulatorDescription(idDaphne));
  FormStatus.MessageStr('Parsing "config.xml" (1st pass). Adding parent sections in .ini file.');
  //FormStatus.MessageStr('Parsing "config.xml" (1st pass).'+#13#10+
  //                      'Creating parent games sections in .ini file.');
  if not FormStatus.Visible then
     FormStatus.Show;
  configXML:= THashedStringList.Create;
  configXML.LoadFromFile(TempString);
  if configXML.Count > 0 then
  begin
    DeleteFile(GetGamesFolderEL+GetSystemFileName(idDaphne));
    DeleteFile(GetGamesFolderEL+GetSystemFileName(idDaphne, 2));

    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;
    
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(idDaphne));
    ListGames.WriteString('info_file', 'description', '');
    XML_IsGameList:= False;

    // get all parent names first
    for MainLoop:=0 to configXML.Count -1 do
    begin
      FileLine:= TrimLeft(configXML[MainLoop]);
      if XML_CheckData(FileLine, '<gamelist>') then
         XML_IsGameList:= True
      else
      if XML_IsGameList then
         begin
           if (XML_CheckData(FileLine, '<game ')) then
              begin
                FileLine:= TrimLeft(configXML[MainLoop+1]);
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= idDaphne;
                TempString:= '';
                Delete(FileLine, 1, 6);
                TempGameVars.eName:= ChangeFileExt(XML_GetEntryValue(FileLine, 'driver'), '');
                if not ListGames.SectionExists(TempGameVars.eName) then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, '');
              end
           else
           if (XML_CheckData(FileLine, '</gamelist>')) then
              Break;
         end;
      Application.ProcessMessages;
    end;

    FormStatus.MessageStr('Parsing "config.xml" (2nd and final pass). Creating games list.');
    IsGameEntry:= False;
    for MainLoop:=0 to configXML.Count -1 do
    begin
      FileLine:= TrimLeft(configXML[MainLoop]);
      if XML_CheckData(FileLine, '<gamelist>') then
         begin
           XML_IsGameList:= True;
           strMainDescription:= '';
         end
      else
      if XML_IsGameList then
         begin
           if XML_CheckData(FileLine, '<game ') then
              begin
                TempString:= '';
                Delete(FileLine, 1, 6);
                strMainDescription:= XML_GetEntryValue(FileLine, 'name');
                strMainDriverName:= '';
                IsGameEntry:= True;
              end
           else
           if IsGameEntry then
              begin
                if XML_CheckData(FileLine, '<!-- ') then
                   Delete(FileLine, 1, 5);
                if XML_CheckData(FileLine, '--> ') then
                   Delete(FileLine, 1, 4);
                FileLine:= TrimLeft(configXML[MainLoop]);

                if XML_CheckData(FileLine, '<version ') then
                   begin
                     ClearMemGameInfo(TempGameVars);
                     TempGameVars.eSystemID:= idDaphne;
                     if StrMainDriverName = '' then
                        strMainDriverName:= ChangeFileExt(XML_GetEntryValue(FileLine, 'driver'), '');
                     TempString:= XML_GetEntryValue(FileLine, 'name');
                     if TempString <> '' then
                        begin
                          if strMainDriverName <> 'astron' then
                             TempGameVars.eTitle:= strMainDescription+ '('+TempString+')'
                          else
                             TempGameVars.eTitle:= TempString;
                        end;

                     TempGameVars.eName:= XML_GetEntryValue(FileLine, 'driver');
                     if TempGameVars.eName <> StrMainDriverName then
                        TempGameVars.eClone:= StrMainDriverName;

                     if TempGameVars.eClone = '' then
                        TempGameVars.eROMIdentification:= 14 // it's a parent game
                     else
                        TempGameVars.eROMIdentification:= 15; // it's a clone game

                     TempGameVars.eDriverName:= strMainDriverName+'.c';
                     // set values non-existant on xml file
                     TempGameVars.eMediaType:= 1; // laserdisc
                     TempGameVars.eScreenType:= 0; // raster
                     TempGameVars.eScreenOrientation:= 0; // horizontal

                     TempGameVars.eDriverStatus:= 0; // good
                     TempGameVars.eGameSetStatus:= 2; // missing

                     ROMDataLine:= PopulateROMDataLineArcade;
                     case GameIsClone(TempGameVars.eClone) of
                       True:
                         begin
                           TempString:= ListGames.ReadString(TempGameVars.eClone, TempGameVars.eName, '');
                           if TempString = '' then
                              ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);
                         end;
                       False: ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine);
                     end;

                     GameStatusList.Add(PopulateGameStatusDataLine);
                   end
                 else
                 if XML_CheckData(FileLine, '</game>') then
                    begin
                      IsGameEntry:= False;
                    end;
              end
           else
           if (XML_CheckData(FileLine, '</gamelist>')) then
              Break;
         end;
      FormStatus.UpdateProgressBar(MainLoop, configXML.Count-1);
      Application.ProcessMessages;
    end;
    GameStatusList.EndUpdate;
  end;

  FormStatus.MessageStr('Saving files and freeing memory.');
  FreeAndNil(configXML);
  EmulatorDateTime[idDaphne]:= FileAgeW(EmulatorFile[idDaphne]);
  GetArcadeEmulatorVersion(idDaphne, EmulatorFile[idDaphne], EmulatorVersion[idDaphne], iVersion);
  ListGames.WriteString('info_file', 'description', GetArcadeEmulatorDescription(idDaphne)+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[idDaphne]);
  ListGames.UpdateFile;
  FreeAndNil(ListGames);
  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(idDaphne, 2));
  FreeAndNil(GameStatusList);

  Application.ProcessMessages;
end;

function TFormMain.CreateGamesClrMAMEProXML(sysID: Byte): Boolean;
var
  ListXML, ROMsList, games_bios, MAMEGames, BiosSet, DemulDriverName, ListROMsBiosSet, ListDuplicateROMs: THashedStringList;
  FileLine, ROMsDetailsLine, TempString, ROMDataLine, ROMOf: String;
  MainLoop, tmpIndex: Integer;
  IsResource, IsGameEntry, IsCHDFile, ROMsHeaderAdded: Boolean;
  tempFile, tmpEmuVersion, romName, romNameMerge, romCRC32, romSize, romSHA1, iDriver, MediaTypeTagExtra: String;

  TitleErrorMsg: String;
  DemulROMOf: String;
  iVersion: String;
  GameStatusList: TStringList;
  newFileID: ShortInt;
  ROMInfoFull, BiosInfoROM: String;
  IsBadDump: ShortInt;

  CRC32CollisionList: THashedStringList;
  SHA1CollisionList: THashedStringList;
  CRC32CollisionFile: TStringList;
  IsCRC32Collision: Boolean;

  function Check_Temp_Files(const tempFileName: String): Boolean;
  begin
    Result:= FileExists(tempFileName);
    case Result of
      True:
        begin
          Result:= (GetFileSize(tempFileName) > 0);
          if not Result then
             begin
               CallMessageBox;
               AddMsgText('File ');
               AddMsgText(tempFileName, MsgTxtColors.colorFileName, [fsBold]);
               AddMsgText(' is empty! Aborting...');
               GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
               DeleteFile(tempFileName);
             end
        end;
      False:
        begin
          CallMessageBox;
          AddMsgText('File ');
          AddMsgText(tempFileName, MsgTxtColors.colorFileName, [fsBold]);
          AddMsgText(' was not found! Aborting...');
          GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
        end;
    end;
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ROMsList);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    FreeAndNil(games_bios);
    FreeAndNil(BiosSet);
    FreeAndNil(MAMEGames);
    FreeAndNil(ListROMsBiosSet);
    if sysID = idDemul then
       FreeAndNil(DemulDriverName);
    Result:= False;
  end;

  function IsBiosSet(const StringLine: String): Boolean;
  begin
    Result:= PosEx('isbios="yes"', StringLine) <> 0;
  end;

  function FixDemulBiosTitle: String;
  begin
    if TempGameVars.eName = 'crp' then
       Result:= 'CRP Bios'
    else
    if TempGameVars.eName = 'dc' then
       Result:= 'Dreamcast BIOS'
    else
    if TempGameVars.eName = 'awbios' then
       Result:= 'Atomiswave BIOS'
    else
    if TempGameVars.eName ='naomi2' then
       Result:= 'Naomi 2 BIOS'
    else
    if TempGameVars.eName = 'naomi' then
       Result:= 'Naomi BIOS'
    else
    if TempGameVars.eName = 'aurora' then
       Result:= 'Aurora BIOS'
    else
    if TempGameVars.eName = 'mie' then
       Result:= 'Sega 315-6146 MIE'
    else
    if TempGameVars.eName = 'hikaru' then
       Result:= 'Hikaru BIOS'
    else
    if TempGameVars.eName = 'segasp' then
       Result:= 'Sega System SP (Spider) BIOS'
    else
    if (TempGameVars.eName = 'dimm') or (TempGameVars.eName = 'segadimm') then
       Result:= 'Sega DIMM BIOS'
    else
       Result:= TempGameVars.eTitle;
  end;

  function FixDemulBiosName: Boolean;
  begin
    // required due to a discrepancy between Demul's internal bios name set
    // and the listxml output
    Result:= (sysID = idDemul) and (ROMOf <> '');
    if not Result then
       Exit;
    DemulROMOf:= ROMOf;
    if SameText(ROMOf, 'awave') then
       ROMOf:= 'awbios'
    else
    if SameText(ROMOf, 'naomigd') then
       ROMOf:= 'naomi'
    else
    if SameText(ROMOf, 'naomi2gd') then
       ROMOf:= 'naomi2';
  end;

  function FixCRCEmptySpaces(const CRC32String: String): String;
  var
    crcLoop: Integer;
  begin
    Result:= CRC32String;
    if sysID <> idDemul then // for Demul only
       Exit;

    if Result = '' then
       Exit;

    if Result[1] <> ' ' then
       Exit;

    for crcLoop:= 1 to 8 do
    begin
      if Result[crcLoop] = ' ' then
         Result[crcLoop]:= '0'
      else
         Break;
    end;
  end;

  procedure SetDefaultSettings(sysID: Byte);
  var
    FoundMAMEList: Boolean;
  begin
    if sysID = idDICE then
       begin
         TempGameVars.eDriverStatus:= 0; // good
         TempGameVars.eScreenType:= 0; // raster
         TempGameVars.eGameSize:= 0;
         Exit; // do not get extra info for DICE games
       end;
    FoundMAMEList:= Assigned(MAMEGames);
    if FoundMAMEList then
       begin
         tmpIndex:= MAMEGames.IndexOfName(TempGameVars.eName);
         if tmpIndex <> -1 then
            GetROMFields(MAMEGames, tmpIndex, sysID);
       end;
    TempGameVars.eDriverStatus:= 0;
    TempGameVars.eGameSetStatus:= 2; // set to missing
    TempGameVars.eGameSize:= 0;
    case sysID of
      idZiNc:
        begin
          TempGameVars.eBiosName:= '';
          TempGameVars.eScreenType:= -1; // game index is -1 if not found in .xml file (for bios sets)
          if TempGameVars.eScreenResolution = '' then
             TempGameVars.eScreenResolution:= '640x480';
          if TempGameVars.eScreenRefreshRate = '' then
             TempGameVars.eScreenRefreshRate:= '60.000000';
        end;
      idDemul:
        begin
          TempGameVars.eClone:= '';
          TempGameVars.eBiosName:= '';
          TempGameVars.eDriverName:= '';
        end;
      idSegaModel2:
        begin
          TempGameVars.eClone:= '';
          if TempGameVars.eScreenOrientation = -1 then
             TempGameVars.eScreenOrientation:= 0; // horizontal games
          if TempGameVars.eScreenResolution = '' then
             TempGameVars.eScreenResolution:= '496x384';
          if TempGameVars.eScreenRefreshRate = '' then
             TempGameVars.eScreenRefreshRate:= '57.524160';
          if TempGameVars.eDriverName = '' then
             TempGameVars.eDriverName:= 'model2.cpp';
        end;
      idSupermodel:
        begin
          TempGameVars.eClone:= '';
          if TempGameVars.eScreenOrientation = -1 then
             TempGameVars.eScreenOrientation:= 0; // horizontal games
          if TempGameVars.eScreenResolution = '' then
             TempGameVars.eScreenResolution:= '496x384';
          if TempGameVars.eScreenRefreshRate = '' then
             TempGameVars.eScreenRefreshRate:= '60.000000';
          if TempGameVars.eDriverName = '' then
             TempGameVars.eDriverName:= 'model3.cpp';
        end;
    end;
    TempGameVars.eSystemID:= sysID;
  end;

  function AddControlsList(const ctrlString: String): Boolean;
  begin
    Result:= True;
    if TempGameVars.eControls <> '' then
       TempGameVars.eControls:= TempGameVars.eControls+','+ctrlString
    else
       TempGameVars.eControls:= ctrlString;
  end;

  function AddButtonsControl: Boolean;
  begin
    Result:= TempGameVars.eButtonsCount > 0;
    if not Result then
       Exit;
    if TempGameVars.eControls = '' then
       TempGameVars.eControls:= 'buttons';
  end;

  function GetButtonsEntry: Boolean;
  var
    bStr: String;
  begin
    bStr:= XML_GetEntryValue(FileLine, 'buttons');
    Result:= bStr <> '';
    if Result then
       TempGameVars.eButtonsCount:= StrToInt(bStr);
  end;

  function CheckFileCRC32Collision(const iCRC32, iSHA1: String): Boolean;
  var
    cIndex: Integer;
  begin
    Result:= False;
    if IsCRC32Collision then
       Exit; // set already tagged as CRC32 collision, no need to check other files

    if iCRC32 = '' then
       Exit;

    cIndex:= CRC32CollisionList.IndexOf(iCRC32);
    if cIndex = -1 then
       begin
         CRC32CollisionList.Add(iCRC32);
         SHA1CollisionList.Add(iSHA1);
       end
    else
       begin
         if SHA1CollisionList[cIndex] <> iSHA1 then
            begin
              IsCRC32Collision:= True;
              Result:= True;
            end;
       end;
  end;

begin
  TitleErrorMsg:= 'Error: Create Games List ['+GetArcadeEmulatorDescription(sysID)+']';
  if not FileExists(EmulatorFile[sysID]) then
     begin
       CallMessageBox;
       AddMsgText('File ');
       AddMsgText(EmulatorFile[sysID], MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not found. This task will be terminated.');
       GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
       Result:= False;
       Exit;
     end;
  FormStatus.SetProgressPos(0);
  if sysID = idSegaModel2 then
     begin
       if IsSEGAModel2NewVersion(EmulatorFile[sysID]) then
          tempFile:= GetFolderFull(42)+GetArcadeSystemIniSection(sysID)+'_xml.dat'
       else
          tempFile:= GetFolderFull(42)+GetArcadeSystemIniSection(sysID)+'-v1.0_xml.dat';
     end
  else
     tempFile:= GetFolderFull(42)+GetArcadeSystemIniSection(sysID)+'_xml.dat';

  if not FileExists(tempFile) then
     begin
       if sysID <> idDemul then
          begin
            CallMessageBox;
            AddMsgText('ClrMAME XML database file ');
            AddMsgText(tempFile, MsgTxtColors.colorFileName, [fsBold]);
            AddMsgText(' was not found. Make sure the file exists and click ');
            AddMsgText('Yes', MsgTxtColors.colorFileName, [fsBold]);
            AddMsgText(' to try again or ');
            AddMsgText('No', MsgTxtColors.colorFileName, [fsBold]);
            AddMsgText(' to abort.'+#13#10+#13#10+'Continue ?');
            if GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 1, False, 1) = mrNo then
               begin
                 Result:= False;
                 Exit;
               end
            else
               begin
                 if not FileExists(tempFile) then
                    begin
                      CallMessageBox;
                      AddMsgText('ClrMAME XML database file ');
                      AddMsgText(tempFile, MsgTxtColors.colorFileName, [fsBold]);
                      AddMsgText(' still was not found. This task will be terminated...');
                      GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
                      Result:= False;
                      Exit;
                    end;
               end;
          end
       else
          begin
            // Demul, generate listxml with -listxml cmdline parameter
            tempFile:= FrontendPath+'temp\demul-listxml.dat';
            FormStatus.MessageStr('Creating "'+ExtractFileName(tempFile)+'" file.');
            FileLine:= SystemStr+EmulatorFile[sysID]+SystemStr+' -listxml > '+SystemStr+tempFile+SystemStr;
            SetCurrentDir(ExtractFilePath(EmulatorFile[sysID]));
            RunProcess(CommandPromptStr+SystemStr+FileLine+SystemStr, True, GetWindowStateEmulator);
            SetCurrentDir(FrontendPath);
            if not FileExists(tempFile) then
               begin
                 GenerateMessage(TitleErrorMsg, 'Could not create the games list.', '    Failed to create '+
                                 'a list of ROMs for Demul (-listxml output). This task will be terminated.', 2, False, 1);
                 Result:= False;
                 Exit;
               end
            else
               romName:= tempFile;
            FileLine:= '';
          end;
     end;

  CheckAndCreateFolder(GetGamesFolderEL);

  Result:= Check_Temp_Files(tempFile);
  if not Result then
     Exit;

  tmpEmuVersion:= '';
  iVersion:= '';

  FormStatus.TitleStr('Create Games List: '+GetArcadeEmulatorDescription(sysID));
  FormStatus.MessageStr('');
  if not FormStatus.Visible then
     FormStatus.Show;
  FormStatus.StartThreadClock;
  SetCurrentDir(FrontendPath);
  FileLine:= '';

  if FormMain.Visible then
     FormMain.Refresh;

  MAMEGames:= THashedStringList.Create;
  if not GetGamesList(MAMEGames, idMAME) then
     FreeAndNil(MAMEGames);

  if sysID = idDemul then
     begin
       // for Demul emulator only, for now
       CRC32CollisionFile:= TStringList.Create; // "sysname_crc32collision.txt" with set names (device/bios sets)
       CRC32CollisionFile.BeginUpdate;
       CRC32CollisionList:= THashedStringList.Create; // a temp list with CRC32 list to check against new ROM files (device/bios sets)
       SHA1CollisionList:= THashedStringList.Create;  // a temp list with SHA-1 list to check against new ROM files (device/bios sets)
     end;

  FormStatus.MessageStr('Parsing "'+ExtractFileName(tempFile)+'" (1st pass). Creating BIOS sets list.');
  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(tempFile);

  BiosSet:= THashedStringList.Create; // list of bios sets, to handle romof="gameset" entry
  ListROMsBiosSet:= THashedStringList.Create; // a temp list of ROMs for each bios set
  ListROMsBiosSet.BeginUpdate;

  if sysID = idDemul then
     ListDuplicateROMs:= THashedStringList.Create; // a temp list of ROMs to check for duplicates (no CHDs)
                                                   // romname == CRC32 == SHA1

  FormStatus.SetFocus;
  if ListXML.Count > 0 then
  begin
    DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID));
    for MainLoop:=1 to 3 do
        DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID, MainLoop));

    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;

    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    ListGames.WriteString('info_file', 'description', '');

    ROMsList:= THashedStringList.Create;
    ROMsList.BeginUpdate;
    IsResource:= False;
    GetArcadeEmulatorVersion(sysID, EmulatorFile[sysID], tmpEmuVersion, iVersion);

    BiosSet.BeginUpdate;
    // now is the tricky part, get all bios sets first
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<game ') then
         begin
           if IsBiosSet(FileLine) then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                ROMsDetailsLine:= '';
                TempString:= '';
                Delete(FileLine, 1, 6);
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                SetDefaultSettings(sysID); // parse info from MAME
                if sysID <> idSupermodel then
                   TempGameVars.eDriverName:= FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile')); // for DICE and ZiNc

                TempGameVars.eBiosName:= TempGameVars.eName;
                ROMsHeaderAdded:= False;

                if sysID = idDemul then
                   begin
                     ListDuplicateROMs.BeginUpdate;
                     IsCRC32Collision:= False;
                     CRC32CollisionList.Clear;
                     SHA1CollisionList.Clear;
                   end;

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
                IsResource:= True;
              end;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                if sysID = idDemul then
                   TempGameVars.eTitle:= FixDemulBiosTitle;
                BiosSet.Add(TempGameVars.eName);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15))
           else
           //if XML_CheckData(FileLine, '<biosset ') then
           //   begin
           //     // only usefull for Demul emulator; can you choose between bios sets for a game ? (February 17, 2018)
           //     if not BiosSet.ValueExists('Descriptions', MemGameVariables.eName) then
           //        BiosSet.WriteString('Descriptions', MemGameVariables.eName, MemGameVariables.eDescription);
           //     ROMsDetailsLine:= XML_GetEntryValue(FileLine, 'name'); // name of the biosset
           //     TempString:= DecodeHTML(XML_GetEntryValue(FileLine, 'description')); // description of the biosset
           //     if not BiosSet.ValueExists(MemGameVariables.eName, 'default_bios') then
           //        BiosSet.WriteString(MemGameVariables.eName, 'default_bios', '');
           //     if not BiosSet.ValueExists(MemGameVariables.eName, 'selected_bios') then
           //        BiosSet.WriteString(MemGameVariables.eName, 'selected_bios', '');
           //     if Pos('default="yes"', FileLine) <> 0 then
           //        BiosSet.WriteString(MemGameVariables.eName, 'default_bios', ROMsDetailsLine);
           //     BiosSet.WriteString(MemGameVariables.eName, ROMsDetailsLine, TempString);
           //   end
           //else
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then
              begin
                ROMInfoFull:= '';
                MediaTypeTagExtra:= '';

                romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD
                romName:= DecodeHTML(romName);

                romCRC32:= XML_GetEntryValue(FileLine, 'crc');
                romCRC32:= FixCRCEmptySpaces(romCRC32); // for Demul emulator only
                romSHA1:= XML_GetEntryValue(FileLine, 'sha1');
                romSize:= XML_GetEntryValue(FileLine, 'size');
                if romSize <> '' then
                   TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(romSize);

                newFileID:= 2; // newFileID is the var that will be used to generate the final "ROMInfoFull" string
                BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eName;

                IsCHDFile:= PosEx('<disk ', FileLine) <> 0; // this will always be false because there is no bios CHD files
                if sysID <> idSupermodel then
                   newFileID:= 2 // is BIOS ROM, Supermodel 3 uses no BIOS sets
                else
                   newFileID:= 0; // set game ROM for Supermodel 3, just in case

                if (sysID = idDemul) and (not IsCHDFile) then
                   begin
                      TempString:= romName+' == '+romCRC32+' == '+romSHA1;
                      if ListDuplicateROMs.IndexOf(TempString) = -1 then
                         ListDuplicateROMs.Add(TempString)
                      else
                         Exit; // file already added in the ROMs list, skip it
                    end;

                if sysID <> idSupermodel then
                   ListROMsBiosSet.Add(BiosInfoROM); // ----temp bios ROMs list

                if sysID = idDemul then
                   begin
                     if CheckFileCRC32Collision(romCRC32, romSHA1) then
                        CRC32CollisionFile.Add(TempGameVars.eName);
                   end;

                // this will go last
                IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
                ROMInfoFull:= MountROMInfo(newfileID, 0, IsCHDFile, romName, romCRC32, romSize, romSHA1, IsBadDump);

                if not ROMsHeaderAdded then
                   begin
                     if ROMsList.Count > 0 then
                        ROMsList.Add('');
                     ROMsList.Add('['+TempGameVars.eName+']');
                     ROMsHeaderAdded:= True;
                   end;
                ROMsList.Add(ROMInfoFull);
              end
           else
           if XML_CheckData(FileLine, '<display ') then
              begin
                TempString:= XML_GetEntryValue(FileLine, 'orientation');
                if TempString <> '' then
                   TempGameVars.eScreenOrientation:= Ord(TempString = 'vertical');
              end
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                GetButtonsEntry; // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // type="joy4way"... etc
                TempString:= XML_GetEntryValue(FileLine, 'type');
                AddControlsList(TempString);
              end
           else
           if XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty
                // bios ID
                case sysID of
                  idDemul: TempGameVars.eROMIdentification:= 21; // Demul
                  idZiNc : TempGameVars.eROMIdentification:= 43; // ZiNc
                end;
                ROMDataLine:= PopulateROMDataLineArcade;
                ListGames.WriteString('bios', TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);

                if sysID = idDemul then
                   begin
                     ListDuplicateROMs.Clear;
                     ListDuplicateROMs.EndUpdate;
                   end;
                iDriver:= '';
                IsResource:= False;
              end;
         end;
    end;
    BiosSet.EndUpdate;
    ListROMsBiosSet.EndUpdate;
    ListGames.UpdateFile;

    if sysID = idDemul then
       begin
         CRC32CollisionFile.EndUpdate;
         FreeAndNil(CRC32CollisionList); // games do not have CRC32 collisions, yet! (February 15, 2018)
         FreeAndNil(SHA1CollisionList);
         if CRC32CollisionFile.Count > 0 then
            CRC32CollisionFile.SaveToFile(GetCRC32CollisionFile(sysID));
         FreeAndNil(CRC32CollisionFile);
       end;

    // get name, cloneof, romof fields
    // if romof, check if a bios is part of the game (parent games only!)
    //FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass).'+#13#10+
    //                      'Creating parent games sections in .ini file and a temporary list with parent games.');
    FormStatus.MessageStr('Parsing "'+ExtractFileName(tempFile)+'" (2nd pass). Adding parent sections and listing parents sets.');

    games_bios:= THashedStringList.Create; // a list of parent games that have bios
    games_bios.BeginUpdate;
    FormStatus.SetProgressPos(0);
    if sysID = idDemul then
       begin
         DemulDriverName:= THashedStringList.Create; // a list of parent game and their driver names (machine name for Demul)
         DemulDriverName.BeginUpdate;
       end;
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<game ') then
         begin
           if (PosEx('cloneof="', FileLine) = 0) then
              begin
                if not IsBiosSet(FileLine) then
                   begin
                     TempGameVars.eName:= '';
                     TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                     if not ListGames.SectionExists(TempGameVars.eName) then
                        ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, '');

                     if PosEx('romof="', FileLine) <> 0 then
                        begin
                          ROMOf:= XML_GetEntryValue(FileLine, 'romof');
                          if sysID = idDemul then
                             begin
                               TempGameVars.eDriverName:= ROMOf+'.c';
                               DemulDriverName.Add(TempGameVars.eName+'='+TempGameVars.eDriverName);
                             end;
                          FixDemulBiosName; // fix bios name from "awave" to "awbios" and NaomiGD/Naomi2GD (Demul only)
                          if BiosSet.IndexOf(ROMOf) <> -1 then
                             games_bios.Add(TempGameVars.eName+'='+ROMOf); // add parent game to the temp list
                        end;
                   end;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    games_bios.EndUpdate;
    if sysID = idDemul then
       DemulDriverName.EndUpdate;

    FormStatus.SetProgressPos(0);
    FormStatus.MessageStr('Parsing "'+ExtractFileName(tempFile)+'" (3rd and final pass). Creating games list.');
    // now, the games
    IsGameEntry:= False;

    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if (PosEx('<game ', FileLine) <> 0) then
         begin
           if not IsBiosSet(FileLine) then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');

                SetDefaultSettings(sysID); // get all fixed values for the system
                if sysID <> idSupermodel then
                   TempGameVars.eDriverName:= FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile')); // for DICE and ZiNc

                if sysID = idZiNc then
                   begin
                     // set game index for ZiNc emulator
                     TempGameVars.eScreenType:= -1;
                     TempString:= XML_GetEntryValue(FileLine, 'gameindex');
                     if TempString <> '' then
                        TempGameVars.eScreenType:= StrToInt(TempString);
                   end;

                ROMsDetailsLine:= '';
                TempString:= '';
                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');

                if sysID = idDemul then
                   begin
                     // get the correct driver name for the machine name
                     if TempGameVars.eClone <> '' then
                        TempGameVars.eDriverName:= DemulDriverName.Values[TempGameVars.eClone]
                     else
                        TempGameVars.eDriverName:= DemulDriverName.Values[TempGameVars.eName];
                     if ROMOf = 'spider' then
                        TempGameVars.eBiosName:= 'segasp'; // bios name manual fix
                   end;

                FixDemulBiosName;
                ROMsHeaderAdded:= False;
                IsGameEntry:= True;
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if (BiosSet.IndexOf(ROMOf) <> -1) and (TempGameVars.eBiosName = '') then
                        TempGameVars.eBiosName:= ROMOf;
                   end;
                if sysID = idDICE then
                   TempGameVars.eBiosName:= XML_GetEntryValue(FileLine, 'versionadded');
                if ((sysID = idSegaModel2) and (TempGameVars.eName = 'model2')) then
                   ListROMsBiosSet.BeginUpdate;

                if sysID = idDemul then
                   ListDuplicateROMs.BeginUpdate;

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
              end
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                if sysID = idDemul then // Demul still need this fix: "Kind of Fighters, The"
                  TempGameVars.eTitle:= FixDescriptionFormat(idDemul, TempGameVars.eTitle, False);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15))
           else
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then
              begin
                ROMInfoFull:= '';
                MediaTypeTagExtra:= '';

                romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD
                romName:= DecodeHTML(romName);

                romNameMerge:= XML_GetEntryValue(FileLine, 'merge'); // name of the file (ROM/CHD/Cart/Floppy/Cassette/Disc/HD/Flash Card/Video Tape) from parent game
                romNameMerge:= DecodeHTML(romNameMerge);

                romCRC32:= XML_GetEntryValue(FileLine, 'crc');
                romCRC32:= FixCRCEmptySpaces(romCRC32); // for Demul emulator
                romSHA1:= XML_GetEntryValue(FileLine, 'sha1');

                IsCHDFile:= PosEx('<disk ', FileLine) <> 0;

                romSize:= XML_GetEntryValue(FileLine, 'size');
                if romSize <> '' then
                   TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(romSize);
                TempString:= '';

                newFileID:= 0; // newFileID is the var that will be used to generate the final "ROMInfoFull" string

                if IsCHDFile then
                   begin
                     TempGameVars.eMediaType:= 1; // must set media type to DISC (December 29, 2017)

                     newFileID:= 12; // it's a game CHD file, not a ROMs

                     if sysID = idZiNc then
                        begin
                          newFileID:= 15; // ZiNc games use CDs and not HDDs
                          MediaTypeTagExtra:= 'cdrom';
                        end;

                     if romNameMerge <> '' then
                        begin
                          if not SameText(ExtractFileExt(romNameMerge), '.chd') then
                             romNameMerge:= romNameMerge+'.chd';
                        end;
                        
                     if not SameText(ExtractFileExt(romName), '.chd') then
                        romName:= romName+'.chd';
                   end;

                if sysID = idSegaModel2 then
                   begin
                     BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'=model2';
                     if TempGameVars.eName <> 'model2' then
                        begin
                          if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                             newFileID:= 2 // yes, it's a board ROM
                          else
                             newFileID:= 0; // no, it's a game ROM
                        end
                     else
                        begin
                          newFileID:= 2; // it's a Board ROM but the frontend uses this internally as a bios... kinda
                          BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eName;
                          ListROMsBiosSet.Add(BiosInfoROM); // add the bios ROM from the model2.zip file (board ROMs)
                        end;
                   end
                else
                   begin
                     BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;
                     if sysID = idSupermodel then
                        newFileID:= 0
                     else
                        begin
                        if not IsCHDFile then
                        // check if ROM is a bios ROM or not, Supermodel 3 emulator doesn't have any bios ROMs
                           begin
                             if FormMain.ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) then
                                begin
                                  if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                                     newFileID:= 2 // yes, it's a bios ROM
                                  else
                                     newFileID:= 0; // no, it's a game ROM
                                end
                             else
                                newFileID:= 0;
                           end;
                        end;
                   end;
                if sysID = idDemul then
                   begin
                     if IsCHDFile then
                        begin
                          if TempGameVars.eDriverName = 'spider.c' then
                             newFileID:= 18 // "spider" machine name is from naomi and it requires 'segasp' bios (SEGA SP System); it's a Flash Card, not a CD or HDD
                          else
                             begin
                               newFileID:= 15; // all other <disk entries are CD, not HDD
                               if (TempGameVars.eDriverName = 'naomigd.c') or (TempGameVars.eDriverName = 'naomi2gd.c') then
                                  MediaTypeTagExtra:= 'gdrom';
                             end;
                        end;
                   end;

                IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
                ROMInfoFull:= MountROMInfo(newFileID, 0, IsCHDFile, romName, romCRC32, romSize, romSHA1, IsBadDump);


                if (romNameMerge <> '') and (newFileID = 0) then // newFileID = 0 -> for game ROM only
                   ROMInfoFull[6]:= '1'; // it's a file from the parent set

                if SameText(romNameMerge, romName) then
                   romNameMerge:= ''; // set to emtpy since the filename is the same from parent game

                if romNameMerge <> '' then
                   ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('parentname', romNameMerge);

                if MediaTypeTagExtra <> '' then
                   ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('mediatype_tag', MediaTypeTagExtra);

                if not ROMsHeaderAdded then
                   begin
                     if ROMsList.Count > 0 then
                        ROMsList.Add('');
                     ROMsList.Add('['+TempGameVars.eName+']');
                     ROMsHeaderAdded:= True;
                   end;

                ROMsList.Add(ROMInfoFull);
              end
           else
           if XML_CheckData(FileLine, '<display ') then
              begin
                TempString:= XML_GetEntryValue(FileLine, 'orientation');
                if TempString <> '' then
                   TempGameVars.eScreenOrientation:= Ord(TempString = 'vertical');
              end
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                GetButtonsEntry; // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // type="joy4way"... etc
                TempString:= XML_GetEntryValue(FileLine, 'type');
                AddControlsList(TempString);
              end
           else
           if XML_CheckData(FileLine, '</game>') then
              begin
                GetButtonsEntry; // get buttons count
                if ((sysID = idSegaModel2) and (TempGameVars.eName = 'model2')) then
                   ListROMsBiosSet.EndUpdate;

                // must verify if is clone or parent
                if TempGameVars.eClone = '' then
                   begin
                     // it's a parent game
                     case sysID of
                       idSupermodel: TempGameVars.eROMIdentification:= 10; // Supermodel: SEGA Model 3
                       idDemul     : TempGameVars.eROMIdentification:= 19; // Demul
                       idDICE      : TempGameVars.eROMIdentification:= 32; // DICE
                       idSegaModel2: TempGameVars.eROMIdentification:= 36; // SEGA Model 2
                       idZiNc      : TempGameVars.eROMIdentification:= 41; // ZiNc
                     end;
                   end
                else
                   begin
                     // it's a clone game
                     case sysID of
                       idSupermodel: TempGameVars.eROMIdentification:= 11; // Supermodel: SEGA Model 3
                       idDemul     : TempGameVars.eROMIdentification:= 20; // Demul
                       idDICE      : TempGameVars.eROMIdentification:= 33; // DICE
                       idSegaModel2: TempGameVars.eROMIdentification:= 37; // SEGA Model 2
                       idZiNc      : TempGameVars.eROMIdentification:= 42; // ZiNc
                     end;
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);

                if sysID = idDemul then
                   begin
                     ListDuplicateROMs.Clear;
                     ListDuplicateROMs.EndUpdate;
                   end;

                iDriver:= '';
                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    GameStatusList.EndUpdate;
  end;
  FormStatus.MessageStr('Saving files and freeing memory.');

  if sysID = idDemul then
     FreeAndNil(ListDuplicateROMs);

  EmulatorDateTime[sysID]:= FileAgeW(EmulatorFile[sysID]);
  if tmpEmuVersion = '' then
     begin
       FormStatus.MessageStr('Extracting emulator version.');
       GetArcadeEmulatorVersion(sysID, EmulatorFile[sysID], EmulatorVersion[sysID], iVersion);
     end
  else
     EmulatorVersion[sysID]:= tmpEmuVersion;
  ListGames.WriteString('info_file', 'description', GetArcadeEmulatorDescription(sysID)+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[sysID]);
  ListGames.UpdateFile;

  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 2));
  
  if sysID = idDemul then
     begin
       FreeAndNil(DemulDriverName);
       if FileExists(FrontendPath+'temp\demul-listxml.dat') then
          DeleteFile(FrontendPath+'temp\demul-listxml.dat');
     end;

  if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
     ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1))
  else
     begin
       CallMessageBox;
       AddMsgText('ROMs list file ');
       AddMsgText(GetGamesFolderEL+GetSystemFileName(sysID, 1), MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
       GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
     end;

  FreeMemVariables;
  Application.ProcessMessages;
  if sysID = idDemul then
     CheckCRC32Collisions(sysID);
end;

function TFormMain.ReadMAMEHashFolder(sysID: ShortInt; EmulatorFileName: String; out HashFolderVar: String): Boolean;
var
  MAMEIniFile: THashedStringList;
  TextLine, IniFile, EntryString: String;
  Loop: Integer;
begin
  HashFolderVar:= '';
  iniFile:= GetArcadeEmuIniFileName(sysID, EmulatorFileName);
  if not FileExists(iniFile) then
     Exit;

  MAMEIniFile:= THashedStringList.Create;
  MAMEIniFile.LoadFromFile(iniFile);
  for Loop:=0 to MAMEIniFile.Count -1 do
  begin
    TextLine:= MAMEIniFile[Loop];
    if TextLine <> '' then
       begin
         EntryString:= XML_GetEntryName(TextLine);
         if EntryString <> '' then
            EntryString:= EntryString+' ';
         if (EntryString = 'hashpath ') or
            (EntryString = 'hash_directory ') or
            (EntryString = 'hash ') then
            HashFolderVar:= ExtractMAMEIniValue(TextLine);
       end;
  end;
  FreeAndNil(MAMEIniFile);
  if HashFolderVar = '' then
     HashFolderVar:= 'hash';

  HashFolderVar:= FullFolderFix(HashFolderVar, EmulatorFileName);
end;

function TFormMain.FixMediaParameterStr(const ParamStr: string): String;
begin
  // for MAME/HBMAME
  Result:= ParamStr;
  if (ParamStr = 'cart') or (ParamStr = 'flop') or (ParamStr = 'cass') or
     (ParamStr = 'hard')  then
     Result:= ParamStr+'1'
  else
  if (ParamStr = 'card') or (ParamStr = 'card1') or (ParamStr = 'rom') or
     (ParamStr = 'rom1') or (ParamStr = 'socket') then
     Result:= 'cart1'
  else
  if (ParamStr = 'cpm1') or (PosEx('disk', ParamStr) <> 0) or
     (PosEx('flop', ParamStr) <> 0) then
     Result:= 'flop1'
  else
  if (PosEx('cass', ParamStr) <> 0) then
     Result:= 'cass1'
  else
  if (ParamStr = 'hdd') or (ParamStr = 'hdd1') then
     Result:= 'hard1'
  else
  if (ParamStr = 'disc') then
     Result:= 'cdrom'
  else
  if (PosEx('cdrom', ParamStr) <> 0) then
     Result:= 'cdrom';
end;

function TFormMain.CreateSoftwareListXML(sysID: Byte; const SoftwareListName: String; IsMultiSlot: Boolean): Boolean;
var
  ListXML, ROMsList: THashedStringList;
  FileLine, TempString, ROMDataLine: String;
  MainLoop: Integer;
  IsGameEntry, GetGameFiles, IsComment, ParseData: Boolean;
  tempFile, romName, romCRC32, romSize, romSHA1: String;
  PartName, PartTitle: String;
  Requirement: String;
  TitleErrorMsg, EmuTitle: String;
  tmpList: THashedStringList;
  HasROMs, ROMsHeaderAdded, MediaTypeAdded: Boolean;
  gFileFullPath, HashFolder: String;
  GameStatusList: TStringList;
  RequirementList: TMemIniFile;
  iPos: Integer;

  function ParseROMDiskEntry(FileID: ShortInt): Boolean; // FileID (type of ROM being scanned) -> 0: <rom; 3: <disk
  var
    ROMInfoFull: String;
    newID, FixedID, IsBadDump: ShortInt;
    IsCHDFile: Boolean;
  begin
    Result:= True;
    ROMInfoFull:= '';
    romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD
    if romName = '' then
       Exit; // some games have WRAM on cartridge, for backup or maybe save state (hash\nes.xml -> "xuanyuan")
    romName:= DecodeHTML(romName);

    romCRC32:= XML_GetEntryValue(FileLine, 'crc');
    romSHA1:= XML_GetEntryValue(FileLine, 'sha1');

    newID:= FileID;
    IsCHDFile:= FileID = 3;
    if IsCHDFile then
       begin
         newID:= 12; // game CHD file type
         TempGameVars.eMediaType:= 1;
         if not SameText(ExtractFileExt(romName), '.chd') then
            romName:= romName+'.chd';

         if romSHA1 = '' then
            romSHA1:= XML_GetEntryValue(FileLine, 'md5'); // for MAME 0.77 down to 0.69 .... MD5 will never be found in software list games ("mamedir\hash\" folder)
       end;

    romSize:= XML_GetEntryValue(FileLine, 'size');
    if romSize <> '' then
       begin
         if romSize[1] <> '?' then
            TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(romSize);
       end;

    // 0000<name>goonies, the (japan) (alt 2).rom/><crc>38f04741/><sha1>b7b4d5c83d8c336dbfe32833bba974cea7f0cb8d/>

    IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
    ROMInfoFull:= MountROMInfo(newID, 0, IsCHDFile, romName, romCRC32, romSize, romSHA1, IsBadDump);
    FixedID:= newID;

    if TempGameVars.eSoftwareExecParameter <> '' then
    begin
      if IsCHDFile then
        begin
          if (TempGameVars.eSoftwareExecParameter = 'cdrom') or
             (TempGameVars.eSoftwareExecParameter = 'cdrom1') then
             FixedID:= newID+3;
        end
      else
        begin
          if TempGameVars.eSoftwareExecParameter = 'cart1' then
             FixedID:= 3
          else
          if TempGameVars.eSoftwareExecParameter = 'flop1' then
             FixedID:= 6
          else
          if (TempGameVars.eSoftwareExecParameter = 'cass1') or
             (TempGameVars.eSoftwareExecParameter = 'tape') then
             FixedID:= 9;
        end;
    end;
    if FixedID <> newID then
    begin
      TempString:= Format('%.2u', [FixedID]);
      ROMInfoFull[1]:= TempString[1];
      ROMInfoFull[2]:= TempString[2];
      TempString:= '';
    end;

    if not ROMsHeaderAdded then
       begin
         if ROMsList.Count > 0 then
            ROMsList.Add(' ');            
         ROMsList.Add('['+TempGameVars.eName+']');
         ROMsHeaderAdded:= True;
       end;
    if PartName <> '' then
       begin
         ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('part_name', PartName); // '<part_name>'+PartName+'/>';
         if PartTitle <> '' then
            ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('part_title', PartTitle); // '<part_title>'+PartTitle+'/>';
       end;
    ROMsList.Add(ROMInfoFull);

    PartName:= '';  // clear this var for multi disks/cassettes
    PartTitle:= ''; // clear this var for multi disks/cassettes
    HasROMs:= True;
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ROMsList);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    Result:= False;
  end;

  function ReplaceChar(const iText: String; CharToReplace, NewChar: Char): String;
  var
    iPos: Integer;
  begin
    Result:= iText;
    iPos:= PosEx(CharToReplace, iText);
    while iPos > 0 do
    begin
      Result[iPos]:= NewChar;
      iPos:= PosEx(CharToReplace, iText);
    end;
  end;

  function CheckCommentInOut(const LineStr: String): Boolean;
  var
    commentInStr, commentOutStr: String;
  begin
    Result:= LineStr <> '';
    if LineStr = '<!--' then
       IsComment:= True
    else
    if LineStr = '-->' then
       IsComment:= False
    else
    begin
      commentInStr:= Copy(LineStr, 1, 4);
      commentOutStr:= Copy(LineStr, Length(LineStr)-2, 3);

      if (commentInStr = '<!--') and (commentOutStr = '-->') then
         IsComment:= False
      else
      if commentInStr = '<!--' then
         IsComment:= True
      else
      if commentOutStr = '-->' then
         IsComment:= False;
    end;
  end;

  function CheckCommentOutGameFile(const LineStr: String): Boolean;
  //var
  //  commentOutStr: String;
  begin
    if PosEx('<!-- verified -->', LowerCase(LineStr)) <> 0 then
       Result:= False
    else
    Result:= Copy(LineStr, 1, 4) = '<!--';
    //   begin
    //     commentOutStr:= Copy(LineStr, Length(LineStr)-2, 3);
    //     Result:= commentOutStr = '-->';
    //   end;
  end;

begin
  EmuTitle:= GetArcadeEmulatorDescription(sysID, True);
  TitleErrorMsg:= 'Error: Create Software List ['+EmuTitle+']';
  if not FileExists(EmulatorFile[sysID]) then
     begin
       CallMessageBox;
       AddMsgText('File ');
       AddMsgText(EmulatorFile[sysID], MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not found. This task will be terminated.');
       GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
       Result:= False;
       Exit;
     end;

  ReadMAMEHashFolder(sysID, EmulatorFile[sysID], HashFolder);
  tempFile:= HashFolder+SoftwareListName+'.xml';
  if not FileExists(tempFile) then
     begin
       FreeMemVariables;
       Application.ProcessMessages;
       Exit;
     end;
  FormStatus.SetProgressPos(0);

  FormStatus.MessageStr('Parsing "'+SoftwareListName+'.xml" file.');

  if not FormStatus.Visible then
     FormStatus.Show;
  if not IsMultiSlot then // no need for neogeo, stv as this function will be called when creating MAME games list
     FormStatus.StartThreadClock; // only for MAME softwarelist.xml files (mamedir\hash\ folder)

  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(tempFile);

  gFileFullPath:= GetGamesFolderEL(Ord(not IsMultiSlot), sysID);
  FormStatus.SetFocus;

  if IsMultiSlot then
  begin
    // generates a list of games for the arcade multi-slot loading (neogeo; stv)
    if ListXML.Count > 0 then
    begin
      CheckAndCreateFolder(gFileFullPath);
      DeleteFile(gFileFullPath+GetMultiCartFileName(sysID, SoftwareListName, False));

      tmpList:= THashedStringList.Create;
      tmpList.BeginUpdate;
      for MainLoop:=0 to ListXML.Count -1 do
      begin
        FileLine:= TrimLeft(ListXML[MainLoop]);
        if FileLine <> '' then
        begin
          if XML_CheckData(FileLine, '<software ') then
             begin
               if PosEx('supported="no"', FileLine) = 0 then
                  begin
                    TempGameVars.eName:= '';
                    TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                    if TempGameVars.eName <> '' then
                       tmpList.Add(TempGameVars.eName);
                  end;
             end;
        end;
        Application.ProcessMessages;
      end;
      tmpList.EndUpdate;
      tmpList.SaveToFile(gFileFullPath+GetMultiCartFileName(sysID, SoftwareListName, False));
      FreeAndNil(tmpList);
    end;
  end
  else
  begin
    // generates a list of games with full info and ROMs list (vectrex and others from mamedir\hash folder, only if MAME machine have softwarelist tag)
    if ListXML.Count > 0 then
    begin
      CheckAndCreateFolder(gFileFullPath);
      for MainLoop:=0 to 3 do
          DeleteFile(gFileFullPath+GetSystemFileName(sysID, MainLoop, SoftwareListName));

      ParseData:= False;
      IsComment:= False;

      tmpList:= THashedStringList.Create;
      tmpList.BeginUpdate;

      tmpList.Add('[info_file]');
      tmpList.Add('description=');
      tmpList.Add('xmlfile_datetime='+IntToStr(FileAgeW(tempFile)));
      tmpList.Add('xmlfile_crc32='+CalcFileCRC32(tempFile));

      GameStatusList:= TStringList.Create;
      GameStatusList.BeginUpdate;

      // 1st pass: create EL's games list file with parent sets and their .ini sections
      for MainLoop:=0 to ListXML.Count -1 do
      begin
        FileLine:= TrimLeft(ListXML[MainLoop]);
        if FileLine <> '' then
        begin
          if not ParseData then
             begin
               if XML_CheckData(FileLine, '<softwarelist') then
                  ParseData:= True;
             end
          else
          begin
            CheckCommentInOut(FileLine);
            if not IsComment then
            begin
              if XML_CheckData(FileLine, '<software ') then
                 begin
                   if (PosEx('cloneof="', FileLine) = 0) then
                      begin
                        TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                        tmpList.Add(' ');
                        tmpList.Add('['+TempGameVars.eName+']');
                        tmpList.Add(TempGameVars.eName+'=');
                      end;
                 end;
            end;
          end;
        end;
      end;

      tmpList.EndUpdate;
      tmpList.SaveToFile(gFileFullPath+GetSystemFileName(sysID, 0, SoftwareListName));

      FreeAndNil(tmpList);
      Application.ProcessMessages;

      ListGames:= TMemIniFile.Create(gFileFullPath+GetSystemFileName(sysID, 0, SoftwareListName));

      ROMsList:= THashedStringList.Create;
      ROMsList.BeginUpdate;

      RequirementList:= TMemIniFile.Create(GetSoftListRequirementFile(sysID)); // file "system_name.elsoftlistreq'

      IsGameEntry:= False;
      ParseData:= False;
      IsComment:= False;
      for MainLoop:=0 to ListXML.Count-1 do
      begin
        //'<softwarelist name="neogeo" description="SNK Neo-Geo cartridges">
        FileLine:= TrimLeft(ListXML[MainLoop]);
        if FileLine <> '' then
        begin
          if not ParseData then
             begin
               if XML_CheckData(FileLine, '<softwarelist') then
                  begin
                    ParseData:= True;
                    TempString:= DecodeHTML(XML_GetEntryValue(FileLine, 'description'));
                    if TempString = '' then
                       TempString:= SoftwareListName;
                    ListGames.WriteString('info_file', 'description', TempString);
                   end
             end
          else
          begin
            CheckCommentInOut(FileLine);
            if not IsComment then
            begin
              // <software name="bstarsh" cloneof="bstars">
              if (PosEx('<software ', FileLine) <> 0) then
                 begin
                   ClearMemGameInfo(TempGameVars);
                   HasROMs:= False;
                   TempGameVars.eSystemID:= sysID;
                   TempGameVars.eSystemType:= 1; // is non-arcade - 0: arcade; 1: MAME machines/software lists
                   TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                   TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');

                   // driver status
                   // -1 -> none; 0 -> Good; 1 -> Imperfect; 2 -> Preliminary
                   TempGameVars.eDriverStatus:= 0;
                   TempGameVars.eEmulationStatus:= 0;
                   if PosEx('supported="no"', FileLine) <> 0 then
                      begin
                        // the game support is preliminary and might not work; set driver/emulation to Preliminary
                        TempGameVars.eDriverStatus:= 2;
                        TempGameVars.eEmulationStatus:= 2;
                      end
                   else
                   if PosEx('supported="partial"', FileLine) <> 0 then
                      begin
                        // the game support is imperfect and might not work; set driver/emulation to Impefect
                        TempGameVars.eDriverStatus:= 1;
                        TempGameVars.eEmulationStatus:= 1;
                      end;

                   if SoftwareListName = 'vectrex' then
                      begin
                        TempGameVars.eScreenType:= 1; // vector
                        TempGameVars.eScreenOrientation:= 1; // vertical orientation
                      end;

                   IsGameEntry:= True;
                   GetGameFiles:= False;
                   ROMsHeaderAdded:= False;
                   MediaTypeAdded:= False;
                   PartName:= '';
                   PartTitle:= '';
                   Requirement:= '';
                 end
              else
              if IsGameEntry then
                 begin
                   if XML_CheckData(FileLine, '<description>') then
                      begin
                        TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                        TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
                      end
                   else
                   if XML_CheckData(FileLine, '<year>') then
                      TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
                   else
                   if XML_CheckData(FileLine, '<publisher>') then
                      TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 12, PosEx('</publisher>', FileLine)-12))
                   else
                   if XML_CheckData(FileLine, '<info name="alt_title"') then
                      TempGameVars.ePlayedDateText:= XML_GetEntryValue(FileLine, 'value')
                   else
                   if XML_CheckData(FileLine, '<sharedfeat name="compatibility"') then
                      TempGameVars.eSoftwareCompatible:= XML_GetEntryValue(FileLine, 'value')
                   else
                   if XML_CheckData(FileLine, '<sharedfeat name="requirement"') then
                      begin
                        // <sharedfeat name="requirement" value="scdsys"/>
                        if Requirement = '' then
                           Requirement:= XML_GetEntryValue(FileLine, 'value');
                        //else
                        //   beep; // for debugging only
                        if Requirement <> '' then
                           begin
                             if SameText('a2600_cass', SoftwareListName) then
                                Requirement:= 'a2600:'+Requirement
                             else
                             if SameText('segacd', SoftwareListName) then
                                begin
                                  if SameText('32x', Requirement) then
                                     Requirement:= ''; // Sega CD games that require 32X hardware must be run with a "Sega CD with 32X" machine (there's no extra param!)
                                end
                             else
                             begin
                               iPos:= PosEx(' -', Requirement);
                               if iPos <> 0 then
                                  Requirement:= StringReplace(Requirement, ' -', ':', [rfIgnoreCase]);
                             end;
                             if Requirement <> '' then
                                RequirementList.WriteString(SoftwareListName, TempGameVars.eName, Requirement);
                           end;
                      end
                   else
                   // <info name="usage" value="Requires a Japanese system" />
                   // <info name="usage" value="Requires an Arabic MSX2" />
                   // <info name="usage" value="Requires F-Zero X cart" />
                   if XML_CheckData(FileLine, '<info name="usage"') then
                      TempGameVars.eSoftwareUsageTip:= DecodeHTML(XML_GetEntryValue(FileLine, 'value')); // value="Requires a Japanese system" />
                   // amigaaga_flop.xml
                   // <part name="flop7" interface="floppy_3_5">
                   //    <feature name="part_id" value="Disk 7" />
                   //      <dataarea name="flop" size="1049612">
                   // 	     <rom name="(sps442)biing!_diskette7.ipf" size="1049612" crc="6053d78d" sha1="b0b9ff5e400c7bc29da10d902da540b42f6370fb" offset="0"/>
                   //      </dataarea>
                   // </part>

                   // neocd.xml
                   // <part name="cdrom" interface="neocd_cdrom">
                   //   <diskarea name="cdrom">
                   //     <disk name="art of fighting 3 - path of the warrior (1996)(snk)(jp-us)[!][art of fighting - ryuuko no ken gaiden][ngcd-096, ngcd-096e]" sha1="39502261dc15f4279659ed074b1b4e62b683f266"/>
                   //   </diskarea>
                   // </part>
                   if XML_CheckData(FileLine, '<part ') then // this is the cmdline parameters that is used to load game (cart, disk, cass, flop ???)
                      begin
                        GetGameFiles:= True;
                        PartName:= XML_GetEntryValue(FileLine, 'name');
                        if not MediaTypeAdded then
                           begin
                             if SoftwareListName <> 'vgmplay' then
                                TempGameVars.eSoftwareExecParameter:= FixMediaParameterStr(PartName)
                             else
                                TempGameVars.eSoftwareExecParameter:= 'quik';
                             MediaTypeAdded:= True;
                           end;
                      end
                   else
                   // <rom name="nus-ngee-0.u1" size="12582912" crc="8b70cb5b" sha1="7dd376e996d77d108316ac7ced087125c5674fa4" offset="000000" />
                   //if XML_CheckData(FileLine, '<dataarea ') or XML_CheckData(FileLine, '<diskarea ') then
                   //   begin
                   if XML_CheckData(FileLine, '<feature ') then
                      begin
                        if PosEx('name="part_id"', FileLine) <> 0 then
                           begin
                             PartTitle:= XML_GetEntryValue(FileLine, 'value');
                             PartTitle:= DecodeHTML(PartTitle);
                           end;
                      end
                   else
                   if XML_CheckData(FileLine, '<rom ') then
                      begin
                        if GetGameFiles and (not IsComment) and (not CheckCommentOutGameFile(FileLine)) then
                           ParseROMDiskEntry(0);
                      end
                   else
                   if XML_CheckData(FileLine, '<disk ') then
                      begin
                        if GetGameFiles and (not IsComment) and (not CheckCommentOutGameFile(FileLine)) then
                           ParseROMDiskEntry(3);
                      end
                   else
                   if XML_CheckData(FileLine, '</software>') then
                      begin
                        // must verify if is clone or parent
                        if TempGameVars.eClone = '' then
                           begin
                             // it's a parent game
                             case sysID of
                               idMAME  : TempGameVars.eROMIdentification:= 04; // MAME Parent
                               idHBMAME: TempGameVars.eROMIdentification:= 26; // HBMAME Parent
                             end;
                           end
                        else
                           begin
                             // it's a clone game
                             case sysID of
                               idMAME  : TempGameVars.eROMIdentification:= 05; // MAME Clone
                               idHBMAME: TempGameVars.eROMIdentification:= 27; // HBMAME Clone
                             end;
                           end;

                        ROMDataLine:= PopulateROMDataLineArcade(1);

                        if TempGameVars.eClone = '' then
                           ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                        else
                           ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                        GameStatusList.Add(PopulateGameStatusDataLine);
                      
                        IsGameEntry:= False;
                        MediaTypeAdded:= False;
                      end;
                 end;
              //FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1); // do not uncomment this, it causes massive flickering; don't remove it either...
            end;
          end;
          Application.ProcessMessages;
        end; // end of "if FileLine <> '' then"
      end;
    end;

    ListGames.UpdateFile;
    GameStatusList.EndUpdate;
    Application.ProcessMessages;
    GameStatusList.SaveToFile(gFileFullPath+GetSystemFileName(sysID, 2, SoftwareListName));

    if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
       ROMsList.SaveToFile(gFileFullPath+GetSystemFileName(sysID, 1, SoftwareListName));

    RequirementList.UpdateFile;
    FreeAndNil(RequirementList);
  end;
  FreeMemVariables;
  Application.ProcessMessages;
end;

procedure TFormMain.UpdateGamesFilterHint;
var
  filters_file: THashedStringList;
  strFilter: String;
begin
  if SelectedFilterName = 'favorites' then
     Exit;
  if not FileExists(GetFolderFull(43)+'mame_filters.ini') then
     Exit;

  try
    filters_file:= THashedStringList.Create;
    filters_file.LoadFromFile(GetFolderFull(43)+'mame_filters.ini');
    strFilter:= filters_file.Values[SelectedFilterName];
  finally
    FreeAndNil(filters_file);
  end;
  if strFilter <> '' then
     ButtonArcadeGamesFilters.Hint:= 'Selected MAME and arcade games filter'+#13#10+' -> '+strFilter
  else
     ButtonArcadeGamesFilters.Hint:= 'Selected MAME and arcade games filter';
end;

function TFormMain.GetROMFields(const ListHolder: THashedStringList; Index: Integer; ForceSysID: ShortInt = -1): Boolean;
var
  TempField, tmpString: String;
  BiosEmptyMsg, IsArcadeEntry: Boolean;
begin
  TempField:= '';
  TempGameVars.eName:= ListHolder.Names[Index];
  TempGameVars.eMechanical:= False; // reset mechanical tag to FALSE to avoid errors
  TempGameVars.eGameSize:= 0; // set to zero just in case
  tmpString:= ListHolder.ValueFromIndex[Index];
  Result:= tmpString <> '';
  if not Result then
     Exit;

  BiosEmptyMsg:= False;

  IsArcadeEntry:= PosEx('<softfile>', tmpString) = 0; // </softfile> tag is always added to software list games

  // ROM_ID GameSetStatus ScanMode MergedSet are merged into the final string (uMain.GetGamesList())
  // for arcade games and MAME software list
  TempGameVars.eROMIdentification:= StrToInt(tmpString[1]+tmpString[2]);
  TempGameVars.eGameSetStatus:= StrToInt(tmpString[3]); // 0 - have; 1 - missing ROMs/CHDs; 2 - missing
  TempGameVars.eScanMode:= StrToInt(tmpString[4]); // 0 -> full scan; 1 -> quick scan; 2 -> force available
  TempGameVars.eIsMerged:= Boolean(StrToInt(tmpString[5]));

  if ForceSysID = -1 then
  begin
    case TempGameVars.eROMIdentification of
          -1: TempGameVars.eSystemID:= -1; // Unknown, error... this case should NEVER happen
      00..07: TempGameVars.eSystemID:= idMAME;
      08..11: TempGameVars.eSystemID:= idSupermodel;
      12..15: TempGameVars.eSystemID:= idDaphne;
      16..21: TempGameVars.eSystemID:= idDemul;
      22..29: TempGameVars.eSystemID:= idHBMAME;
      30..33: TempGameVars.eSystemID:= idDICE;
      34..37: TempGameVars.eSystemID:= idSegaModel2;
      38..43: TempGameVars.eSystemID:= idZiNc;
    end;
  end;

  if IsArcadeEntry then
  begin
    TempGameVars.eMediaType:= StrToInt(tmpString[6]); // 0 -> ROM; 1 -> CHD

    TempGameVars.eTitle:= SoftListGetEntryValue(tmpString, 'title');
    TempGameVars.eYear:= SoftListGetEntryValue(tmpString, 'year');
    TempGameVars.eManufacturer:= SoftListGetEntryValue(tmpString, 'manuf');
    TempGameVars.eControls:= SoftListGetEntryValue(tmpString, 'ctrl');
    TempField:= SoftListGetEntryValue(tmpString, 'btn');
    if TempField <> '' then
       TempGameVars.eButtonsCount:= StrToInt(TempField);

    TempField:= SoftListGetEntryValue(tmpString, 'scrtype');
    if TempField <> '' then
       TempGameVars.eScreenType:= StrToInt(TempField);

    TempField:= SoftListGetEntryValue(tmpString, 'scrorient');
    if TempField <> '' then
       TempGameVars.eScreenOrientation:= StrToInt(TempField);

    TempGameVars.eScreenResolution:= SoftListGetEntryValue(tmpString, 'scrres');
    TempGameVars.eScreenRefreshRate:= SoftListGetEntryValue(tmpString, 'scrrefresh');

    TempField:= SoftListGetEntryValue(tmpString, 'audiotype');
    if TempField <> '' then
       TempGameVars.eAudioType:= StrToInt(TempField);

    TempField:= SoftListGetEntryValue(tmpString, 'drvstat');
    if TempField <> '' then
       TempGameVars.eDriverStatus:= StrToInt(TempField);
    TempGameVars.eBiosName:= SoftListGetEntryValue(tmpString, 'bios');
    TempGameVars.eClone:= SoftListGetEntryValue(tmpString, 'cloneof');
    TempGameVars.eDriverName:= SoftListGetEntryValue(tmpString, 'drvname');
    TempGameVars.eNumberPlayers:= SoftListGetEntryValue(tmpString, 'nplayer');

    if PosEx('<mech>', tmpString) <> 0 then
       TempGameVars.eMechanical:= True;

    TempField:= SoftListGetEntryValue(tmpString, 'size');
    if TempField = '' then
       TempField:= '0';
    TempGameVars.eGameSize:= StrToInt64(TempField);

    if TempGameVars.eSystemID = idDaphne then
       begin
         TempGameVars.eROMsAllNoDump:= False;
         TempGameVars.eHaveGameROMs:= 1; // game have ROMs; this is needed so EL can search for gamename.zip files (October 10, 2017)
       end;

    if IsMAMEBasedSys(TempGameVars.eSystemID) then
    begin
      if TempGameVars.eDriverStatus = 0 then
      begin
        // set all to good
        TempGameVars.eEmulationStatus:= 0;
        TempGameVars.eColorStatus:= 0;
        TempGameVars.eSoundStatus:= 0;
        TempGameVars.eGraphicStatus:= 0;
      end
      else
      begin
        TempField:= SoftListGetEntryValue(tmpString, 'emustat');
        if TempField <> '' then
           TempGameVars.eEmulationStatus:= StrToInt(TempField);

        TempField:= SoftListGetEntryValue(tmpString, 'clrstat');
        if TempField <> '' then
           TempGameVars.eColorStatus:= StrToInt(TempField);

        TempField:= SoftListGetEntryValue(tmpString, 'sndstat');
        if TempField <> '' then
           TempGameVars.eSoundStatus:= StrToInt(TempField);

        TempField:= SoftListGetEntryValue(tmpString, 'grpstat');
        if TempField <> '' then
           TempGameVars.eGraphicStatus:= StrToInt(TempField);
      end;
      TempField:= SoftListGetEntryValue(tmpString, 'sta');
      if TempField <> '' then
         TempGameVars.eSaveState:= StrToInt(TempField);
    end;
  end
  else
  begin
    // software lists games (mame\hash\ folder)
    // MAME machines are handled as arcade since they are from mame -listxml output

    // gamename = MediaType (1 char) <title>.........
    // polepos=1<title>Pole Position</title><year>1983</year><publisher>GCE / Namco Ltd.</publisher><media>cart</media>
    // poleposa=1<title>Pole Position (Alt)</title><year>1983</year><publisher>GCE / Namco Ltd.</publisher><cloneof>polepos</cloneof><media>cart</media>

    TempGameVars.eMediaType:= StrToInt(tmpString[6]); // 0 -> roms/cart/floppy/cassette/card; 1 -> CHD
    TempGameVars.eDriverStatus:= StrToInt(tmpString[7]); // 0 -> good; 1 -> imperfect; 2 -> preliminary (game="mygame" supported="no" supported="partial")
    TempGameVars.eEmulationStatus:= StrToInt(tmpString[8]);

    //TempGameVars.eScreenType:= StrToInt(tmpString[9]+tmpString[10]); // for future improvement ? software list games doesn't have the screen type tag
    //TempGameVars.eScreenOrientation:= StrToInt(tmpString[11]+tmpString[12]); // for future improvement ? software list games don't have the screen orientation tag

    TempGameVars.eTitle:= SoftListGetEntryValue(tmpString, 'title');
    TempGameVars.eYear:= SoftListGetEntryValue(tmpString, 'year');
    TempGameVars.eManufacturer:= SoftListGetEntryValue(tmpString, 'publisher');

    TempGameVars.eScreenType:= 0; // set to raster by default
    TempGameVars.eScreenOrientation:= 0; // set to horizontal by default

    TempGameVars.eAudioType:= 0; // set to "audio chip" by default; there are no wav samples or discrete audio in software list games

    TempGameVars.eClone:= SoftListGetEntryValue(tmpString, 'cloneof');

    TempField:= SoftListGetEntryValue(tmpString, 'size');
    if TempField = '' then
       TempField:= '0';
    TempGameVars.eGameSize:= StrToInt64(TempField);

    TempGameVars.eSoftwareName:= SoftListGetEntryValue(tmpString, 'softfile');
    TempGameVars.eSoftwareExecParameter:= SoftListGetEntryValue(tmpString, 'media');
    TempGameVars.eSoftwareCompatible:= SoftListGetEntryValue(tmpString, 'compat');
    TempGameVars.eSoftwareUsageTip:= SoftListGetEntryValue(tmpString, 'usage');
    TempGameVars.eCategory:= SoftListGetEntryValue(tmpString, 'softtitle'); // description of software list files

    TempGameVars.eSystemType:= 1; // is non-arcade since game is from MAME software lists (mame\hash\ folder)

    if TempGameVars.eSoftwareName = 'vectrex' then
       begin
         TempGameVars.eScreenType:= 1; // Vectrex is vector screen type
         TempGameVars.eScreenOrientation:= 1; // Vextrex is a vertical oriented video game
       end;
  end;

  if not IsArcadeEntry then
     Exit;

  if (TempGameVars.eBiosName = '') and (TempGameVars.eSystemID <> idDICE) then
     begin
       if IsROM_Bios(TempGameVars.eROMIdentification) then
          begin
            if TempGameVars.eBiosName <> TempGameVars.eName then
               begin
                 BiosEmptyMsg:= True;
                 TempGameVars.eBiosName:= TempGameVars.eName; // this is a bios set, set biosname = setname, for MAMu_ icons
               end;
          end;
     end;
  if BiosEmptyMsg then
     begin
       CallMessageBox;
       AddMsgText('    This is a BIOS set but ');
       AddMsgText('eBiosName', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' field is blank! Emu Loader requires this field to have the same value as ');
       AddMsgText('eName', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' field, except for DICE. '+#13#10+
                  'Please contact the author with details about this error.'+#13#10+#13#10+
                  'Title: ');
       AddMsgText(TempGameVars.eTitle, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(#13#10+'Name: ');
       AddMsgText(TempGameVars.eName, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(#13#10+'Driver: ');
       AddMsgText(TempGameVars.eDriverName, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(#13#10+'System: ');
       AddMsgText(GetArcadeSystemShortTitle(TempGameVars.eSystemID), MsgTxtColors.colorFileName, [fsBold]);
       GenerateMessage('Warning', 'BIOS set name is blank.', '', 2, False, 1);
     end;

  if TempGameVars.eSystemID = idDICE then
     begin
       // DICE doesn't have bios sets
       // version added is stored in the BiosName tag, that's all (May 18, 2015)
       TempGameVars.eVersionAdded:= TempGameVars.eBiosName;
       TempGameVars.eBiosName:= '';
     end;
end;

procedure TFormMain.ShowFilterMsgBox(const TitleMessageStr, MessageStr: WideString; ForceShowDialog: Boolean = False);
begin
  if IsStartup then
     Exit;
  if IsGroupedView or ForceShowDialog then
     begin
       FormApplyFilterMsgBox.LabelBoxMessageTitle.Caption:= TitleMessageStr;
       FormApplyFilterMsgBox.LabelBoxMessage.Caption:= MessageStr;
       FormApplyFilterMsgBox.Show;
       Application.ProcessMessages;
     end
end;

procedure TFormMain.HideFilterMsgBox;
begin
  if not IsStartup then
     FormApplyFilterMsgBox.Close;
end;

procedure TFormMain.LoadLanguagesList(var ListHolder: THashedStringList);
var
  Loop, Loop2: Integer;
  LanguagesList: TMemIniFile;
  listSections, listValues: THashedStringList;
begin
  if not FileExists(GetFolderFull(43)+'languages.ini') then
     begin
       FreeAndNil(ListHolder);
       Exit;
     end;

  LanguagesList:= TMemIniFile.Create(GetFolderFull(43)+'languages.ini');
  listSections:= THashedStringList.Create;
  LanguagesList.ReadSections(listSections);
  if listSections.Count > 0 then
     begin
       ListHolder:= THashedStringList.Create;
       ListHolder.BeginUpdate;
       listValues:= THashedStringList.Create;
       for Loop:=0 to listSections.Count -1 do
       begin
         listValues.Clear;
         LanguagesList.ReadSectionValues(listSections[Loop], listValues);
         for Loop2:=0 to listValues.Count-1 do
             ListHolder.Add(listValues[Loop2]+'='+listSections[Loop]);
       end;
       ListHolder.EndUpdate;
       FreeAndNil(listValues);
     end;
  FreeAndNil(listSections);
  FreeAndNil(LanguagesList);
  if Assigned(ListHolder) then
     begin
       if ListHolder.Count = 0 then
          FreeAndNil(ListHolder);
     end;
end;

procedure TFormMain.LoadCategoryMESS(var CatListHolder: THashedStringList; var VerListholder: THashedStringList; IsHBMAME: Boolean);
var
  FoundCat, FoundVer, FoundMature: Boolean;
  ExtraStr: String;
  AntoPISA_matureIni: THashedStringList;

  function ParseIni(const iFileName: String; IsCategory: Boolean): Boolean;
  var
    MESSList: TMemIniFile;
    Loop, Loop2: Integer;
    listSections, listValues: THashedStringList;
    IsMatureCat: Boolean;
  begin

    MESSList:= TMemIniFile.Create(GetFolderFull(43)+iFileName);
    listSections:= THashedStringList.Create;
    MESSList.ReadSections(listSections);
    Result:= listSections.Count > 0;
    if Result then
       begin
         if IsCategory then
            begin
              CatListHolder:= THashedStringList.Create;
              CatListHolder.BeginUpdate;
            end
         else
            begin
              VerListHolder:= THashedStringList.Create;
              VerListHolder.BeginUpdate;
            end;
         listValues:= THashedStringList.Create;
         for Loop:=0 to listSections.Count -1 do
         begin
           listValues.Clear;
           MESSList.ReadSectionValues(listSections[Loop], listValues);
           for Loop2:=0 to listValues.Count-1 do
           begin
             if IsCategory then
                begin
                  IsMatureCat:= FoundMature;
                  if FoundMature then
                     IsMatureCat:= AntoPISA_matureIni.IndexOf(listValues[Loop2]) <> -1;

                  case IsMatureCat of
                    True : CatListHolder.Add(listValues[Loop2]+'='+listSections[Loop]+' * Mature *');
                    False: CatListHolder.Add(listValues[Loop2]+'='+listSections[Loop]);
                  end;
                end
             else
                VerListHolder.Add(listValues[Loop2]+'='+listSections[Loop]);
           end;
         end;
         if IsCategory then
            CatListHolder.EndUpdate
         else
            VerListHolder.EndUpdate;
         FreeAndNil(listValues);
       end;
    FreeAndNil(listSections);
    FreeAndNil(MESSList);
  end;

begin
  // load category from category.ini into a HashedStringList "gamename=category" (from MAME 0.171, file contains categories for arcade/non-arcade (ALL sets)
  // load version from version.ini into a HashedStringList "gamename=version" (from MAME 0.171, file contains versions for arcade/non-arcade (ALL sets)

  // merge contents of "mature.ini" into "category.ini" and "mature_hb.ini" contents into "category_hb.ini", adding a * Mature * string at the end of categories

  ExtraStr:= '';
  if IsHBMAME then
     ExtraStr:= '_hb';

  FoundCat:= FileExists(GetFolderFull(43)+'category'+ExtraStr+'.ini');
  FoundVer:= FileExists(GetFolderFull(43)+'version'+ExtraStr+'.ini');
  FoundMature:= FileExists(GetFolderFull(43)+'mature'+ExtraStr+'.ini');

  if not FoundCat then
     FreeAndNil(CatListHolder);
  if not FoundVer then
     FreeAndNil(VerListHolder);
  if (not FoundCat) and (not FoundVer) then
     Exit;

  if FoundMature then
     begin
       AntoPISA_matureIni:= THashedStringList.Create;
       AntoPISA_matureIni.LoadFromFile(GetFolderFull(43)+'mature'+ExtraStr+'.ini');
     end;
  ParseIni('category'+ExtraStr+'.ini', True); // category for MAME arcade
  ParseIni('version'+ExtraStr+'.ini', False); // added version for MAME arcade
  if Assigned(CatListHolder) then
     begin
       if CatListHolder.Count = 0 then
          FreeAndNil(CatListHolder);
     end;
  if Assigned(VerListHolder) then
     begin
       if VerListHolder.Count = 0 then
          FreeAndNil(VerListHolder);
     end;

  if FoundMature then
     FreeAndNil(AntoPISA_matureIni);
end;

procedure TFormMain.SetGamesDateTime(LastPlayed: Boolean; TotalPlaytime: Boolean);
var
  Item: TEasyItem;
begin
  if not CheckTotal(GamesListView) then
     Exit;
  if FormMain.IsStartup then
     Exit;
  if (not LastPlayed) and (not TotalPlaytime) then
     Exit;

  ShowFilterMsgBox('Games Date/Time', 'Updating date/time format in games list.', IsGroupedView);

  GamesListView.BeginUpdate;
  Item:= GamesListView.Groups.FirstItem;
  repeat
    if LastPlayed then
       begin
         if TEasyGameInfo(Item).ePlayedDate <> 0 then
            begin
              TempGameVars.ePlayedDateText:= GetDateTimeStr(TEasyGameInfo(Item).ePlayedDate, True, FormPreferences.LastPlayedHideSeconds.Checked);
              TEasyGameInfo(Item).ePlayedDateText:= TempGameVars.ePlayedDateText;
            end;
       end;
    if TotalPlaytime then
       begin
         if TEasyGameInfo(Item).eTotalPlaytime <> 0 then
            begin
              TempGameVars.eTotalPlaytimeText:= GetPlayTime(TEasyGameInfo(Item).eTotalPlaytime, True, FormPreferences.TotalPlayTimeHideSeconds.Checked);
              TEasyGameInfo(Item).eTotalPlaytimeText:= TempGameVars.eTotalPlaytimeText;
            end;
       end;

    Item:= GamesListView.Groups.NextItem(Item);
    Application.ProcessMessages;
  until Item = nil;
  GamesListView.EndUpdate(False);

  HideFilterMsgBox;
end;

procedure TFormMain.LoadROMsDatabase(addedItem: TEasyItem; sysID: ShortInt; var LoadedDBsysID: ShortInt; const GameName: String; const SoftwareList: String; var LoadedDBSoftwareList: String; ROMsListHolder: TStringList);
var
  romName, romCRC32, romSHA1, LineStr: String;
  FileID, MediaTypeID, ArcadeCHDMediaTypeID: ShortInt;
  Loop: Integer;
  CountROM, CountCHD, CountGameROMs, CountParentGameROMs: Byte;
  HaveROMs: Boolean;
  IsNewFileFormat, IsParentROM: Boolean;
  HaveHDD: Boolean;
begin
  if not IsROMsListBasedSys(sysID) then
     begin // for Daphne
       TEasyGameInfo(addedItem).eROMsAllNoDump:= False; // this will NEVER be set to "True"
       TEasyGameInfo(addedItem).eHaveGameROMs:= 1; // game have ROMs, this is needed so EL can search for gamename.zip files (October 10, 2017)
       Exit;
     end;

  if (sysID <> LoadedDBsysID) or (SoftwareList <> LoadedDBSoftwareList) then
     begin
       FreeAndNil(ListROMs);
       ListROMs:= TMemIniFile.Create(GetGamesFolderEL(Ord(SoftwareList <> ''), sysID)+GetSystemFileName(sysID, 1, SoftwareList));
       LoadedDBsysID:= sysID;
       LoadedDBSoftwareList:= SoftwareList;
     end;

   TEasyGameInfo(addedItem).eROMsAllNoDump:= True; // will be FALSE if at least one ROM has CRC checksum (will be false for Taito Type X games)
   CountROM:= 0; // this means ALL ROMs: game ROMs; device ROMs; bios ROMs; ".eHaveGameROMs" is only for game ROMs (device/bios ROMs are excluded)
   CountCHD:= 0;
   CountGameROMs:= 0;
   CountParentGameROMs:= 0;
   HaveHDD:= False; // only for arcade games with CHD game files; if one HDD is found, game is set as HDD, not Disc or Compact Flash Card
   ArcadeCHDMediaTypeID:= -1;

   //if TEasyGameInfo(addedItem).eName = 'nfsgt' then
   //   beep; // this is for testing only, do not enable
   ListROMs.ReadSectionValues(TEasyGameInfo(addedItem).eName, ROMsListHolder);
   TEasyGameInfo(addedItem).eHaveGameROMs:= 1; // have game ROMs, set to TRUE for all systems

   if not (TEasyGameInfo(addedItem).eSystemID in [idSupermodel, idDICE, idSegaModel2]) then
      begin
        if IsROM_Device(TEasyGameInfo(addedItem).eROMIdentification) or
           IsROM_Bios(TEasyGameInfo(addedItem).eROMIdentification) then
           TEasyGameInfo(addedItem).eHaveGameROMs:= 1 // bios set and device set must have this to TRUE no matter what
        else
           TEasyGameInfo(addedItem).eHaveGameROMs:= 0;
      end;

   TEasyGameInfo(addedItem).eGameROMsNoDump:= False;
   //TEasyGameInfo(addedItem).eParentGameROMsNoDump:= False;

   // still need to find a way to tag parent set that have game ROMs and they are all "nodump" so to audit clones correctly
   // and to avoid showing "parent set not found" in game details screen (see "quizard2_22", clone of "quizard2")

   HaveROMs:= ROMsListHolder.Count > 0;
   //if ROMsListHolder.Count > 25 then
   //   ShowMessage(TEasyGameInfo(addedItem).eTitle+#13#10+TEasyGameInfo(addedItem).eName+#13#10+'count: '+IntToStr(ROMsListHolder.Count));
   if HaveROMs then
   begin
     //if TEasyGameInfo(addedItem).eName = '2spicy' then
     //   beep;
     if IsMAMEBasedSys(TEasyGameInfo(addedItem).eSystemID) then //and (TEasyGameInfo(addedItem).eHaveGameROMs = 1) then
        begin
          if TEasyGameInfo(addedItem).eSoftwareName = '' then
             TEasyGameInfo(addedItem).eGameROMsNoDump:= True;
        end;
     //   GameROMsAllNoDump:= True;
     TEasyGameInfo(addedItem).eROMInfo:= TStringList.Create;
     IsNewFileFormat:= PosEx('<name>', ROMsListHolder[0]) <> 0;

     // new format (December 28, 2017)
     // file_ID MediaType IsCRC32Collision <name> rom_name /> <crc> crc32 /> <sha1> sha-1 or md5 /> <mediatype_title> custom media title />
     // FileID MediaType IsCRC32Collision IsBadDump IsParentSetFile<name>Filename/><crc>CRC32/><sha1>/SHA-1 or MD5/><part_name>MediaID/><part_title>MediaTitle/><parentname>parent_filename/><optional>1/><mediatype_tag>media_tag_index/><devicename>device_setname/>

     // 121000<name>nflfoot.chd/><mediatype_title>CED VideoDisc/>
     // 201000<name>mda-c0004a_revb_lindyellow_v2.4.20_mvl31a_boot_2.01.chd/><sha1>e13da5f827df852e742b594729ee3f933b387410/>
     // 151000<name>dlair.chd/><mediatype_title>Laserdisc/>

     // fileID always at index 1 and 2; MediaType at index 3; IsCRCCollision at position 4
     // if there is no CRC / SHA-1 / MD5... these tags will not appear in the ROM info
     // <mediatype_title> is mostly used for "Disc" media type since it can have different media types, not just CD; for EL v8.4.1 and newer (December 28, 2017)

     // 00   Game ROM
     // 01   Device ROM
     // 02   BIOS ROM

     // 03   Game Cartridge
     // 04   Device Cartridge
     // 05   BIOS Cartridge

     // 06   Game Floppy Disk
     // 07   Device Floppy Disk
     // 08   BIOS Floppy Disk

     // 09   Game Cassette Tape
     // 10   Device Cassette Tape
     // 11   BIOS Cassette Tape

     // 12   Game HDD (also used as a general MAME "CHD" ID)
     // 13   Device HDD (also used as a general MAME "CHD" ID)
     // 14   BIOS HDD (also used as a general MAME "CHD" ID)

     // 15   Game CD (CD/DVD/Laserdisc/GD-ROM/Audio CD/CED VideoDisc)
     // 16   Device CD (CD/DVD/Laserdisc/GD-ROM/Audio CD/CED VideoDisc)
     // 17   BIOS CD (CD/DVD/Laserdisc/GD-ROM/Audio CD/CED VideoDisc)

     // 18   Game Compact Flash Card
     // 19   Device Compact Flash Card
     // 20   BIOS Compact Flash Card

     // 21   Game Video Tape (VHS)
     // 22   Device Video Tape (VHS)
     // 23   BIOS Video Tape (VHS)

     // Konami System 573 and old Demul v5.8.2 (naomigd2, naomigd) have ROMs with CHD "fileID" tags
     TEasyGameInfo(addedItem).eROMInfo.BeginUpdate;
     for Loop:=0 to ROMsListHolder.Count-1 do
     begin
       LineStr:= ROMsListHolder[Loop];
       case IsNewFileFormat of
         True:
           begin
             FileID:= StrToInt(LineStr[1]+LineStr[2]);
             MediaTypeID:= StrToInt(LineStr[3]); // 0 -> ROM/Cart/Flop/Cass; 1 -> CHDs
             romCRC32:= SoftListGetEntryValue(LineStr, 'crc');
             romSHA1:= SoftListGetEntryValue(LineStr, 'sha1');
             TEasyGameInfo(addedItem).eROMInfo.Add(LineStr);
             IsParentROM:= Boolean(StrToInt(LineStr[6]));
           end;
         False:
           begin
             FileID:= StrToInt(LineStr[1]);
             romName:= ROMsListHolder.Names[Loop];
             romCRC32:= ROMsListHolder.ValueFromIndex[Loop];
             romSHA1:= '';
             IsParentROM:= False;
             TEasyGameInfo(addedItem).eROMInfo.Add(romCRC32+'='+romName);
           end;
       end;

       // MediaTypeID
       // 0 -> ROM/Cart/Floppy/Cassette
       // 1 -> all CHDs (HDD, CD, Flash Card, VHS)
       if not (TEasyGameInfo(addedItem).eSystemID in [idSupermodel, idDICE, idSegaModel2]) then
          begin
            if IsFileID_GameROM(FileID) or
               (IsFileID_GameCHD(FileID) and (MediaTypeID = 0)) then // this will check for "<rom" entries that are HDD, CD, Compact Flash Cards, Video Tape (they are not CHD files) Konami System 573 games use this and old Demul v5.8.2 (naomigd, naomigd2 games)
               TEasyGameInfo(addedItem).eHaveGameROMs:= 1
            else
            if (MediaTypeID = 1) and (FileID >= 12) then
               Inc(CountCHD);

            if (CountCHD > 0) and (FileID >= 12) then
               begin
                 if TEasyGameInfo(addedItem).eSoftwareName = '' then
                 begin
                   if IsROM_Device(TEasyGameInfo(addedItem).eROMIdentification) then
                      begin
                        if IsFileID_DeviceCHD(FileID) then
                        begin
                          ArcadeCHDMediaTypeID:= FileID;
                          if FileID = 13 then
                             HaveHDD:= True;
                        end;
                      end
                   else
                   if IsROM_Bios(TEasyGameInfo(addedItem).eROMIdentification) then
                      begin
                        if IsFileID_BiosCHD(FileID) then
                        begin
                          ArcadeCHDMediaTypeID:= FileID;
                          if FileID = 14 then
                             HaveHDD:= True;
                        end;
                      end
                   else
                   begin
                     if IsFileID_GameCHD(FileID) then
                        begin
                          if FileID = 12 then
                             HaveHDD:= True;
                          ArcadeCHDMediaTypeID:= FileID;
                        end;
                    end;
                 end;
               end;
          end;

       // what if all ROMs and all CHDs are "nodump" ? the .eROMsAllNoDump doesn't include CHD files (September 26, 2016)
       if (MediaTypeID = 0) and TEasyGameInfo(addedItem).eROMsAllNoDump then
          begin
            // for Konami System 573 and old Demul v5.8.2 (naomigd2, naomigd) games
            if romCRC32 <> '' then
               TEasyGameInfo(addedItem).eROMsAllNoDump:= False;
          end;

       if not IsMAMEBasedSys(TEasyGameInfo(addedItem).eSystemID) then
       if MediaTypeID = 0 then
          Inc(CountROM); // for MAME/HBMAME this will be counted below

       //if Assigned(GameROMsNoDumpFile) then
       //begin
         if IsMAMEBasedSys(TEasyGameInfo(addedItem).eSystemID) then
         if TEasyGameInfo(addedItem).eSoftwareName = '' then
            begin
              if IsROM_Device(TEasyGameInfo(addedItem).eROMIdentification) then
                 begin
                   if IsFileID_DeviceROM(FileID) and (romCRC32 <> '') and (not IsParentROM) then
                      TEasyGameInfo(addedItem).eGameROMsNoDump:= False; // GameROMsAllNoDump:= False;

                   if IsFileID_DeviceROM(FileID) then //FileID = 1 then
                      begin
                        Inc(CountGameROMs);
                        Inc(CountROM);

                        if IsParentROM then
                           Inc(CountParentGameROMs);
                      end;
                 end
              else
              if IsROM_Bios(TEasyGameInfo(addedItem).eROMIdentification) then
                 begin
                   if IsFileID_BiosROM(FileID) and (romCRC32 <> '') and (not IsParentROM) then
                      TEasyGameInfo(addedItem).eGameROMsNoDump:= False; //GameROMsAllNoDump:= False;

                   if IsFileID_BiosROM(FileID) then // FileID = 2 then
                      begin
                        Inc(CountGameROMs);
                        Inc(CountROM);

                        if IsParentROM then
                           Inc(CountParentGameROMs);
                      end;
                 end
              else
                 begin
                   if IsFileID_GameROM(FileID) or
                      (IsFileID_GameCHD(FileID) and (MediaTypeID = 0)) then
                      begin
                        Inc(CountGameROMs);
                        Inc(CountROM);
                        if (romCRC32 <> '') and (not IsParentROM) then
                           TEasyGameInfo(addedItem).eGameROMsNoDump:= False;

                        if IsParentROM then
                           Inc(CountParentGameROMs);
                      end;

                   //if IsFileID_GameROM(FileID) and (romCRC32 <> '') then
                   //   TEasyGameInfo(addedItem).eGameROMsNoDump:= False;
                   //
                   //if IsFileID_GameROM(FileID) then
                   //   begin
                   //     Inc(CountGameROMs);
                   //     Inc(CountROM);
                   //   end;
                 end;
            end;
       //end;
     end;

     {if TEasyGameInfo(addedItem).eName = 'alto2' then //'bhead2k' then
        beep;
     if TEasyGameInfo(addedItem).eName = 'bhead2k' then
        beep;
     if TEasyGameInfo(addedItem).eName = '2spicy' then //'bhead2k' then
        beep;}
     if TEasyGameInfo(addedItem).eROMsAllNoDump then
        begin
          if (CountROM = 0) and (CountCHD > 0) then
          begin
             TEasyGameInfo(addedItem).eROMsAllNoDump:= False; // if game is CHD only ("ZERO" game/device/bios ROMs), set this to false
             // this is for softlist games and arcade games with only CHD files
          end;
        end;

     //if Assigned(GameROMsNoDumpFile) then
     //   begin
     if IsMAMEBasedSys(TEasyGameInfo(addedItem).eSystemID) then
     if TEasyGameInfo(addedItem).eSoftwareName = '' then
        begin
          if (CountGameROMs = 0) then //and (CountCHD = 0) then
             TEasyGameInfo(addedItem).eGameROMsNoDump:= True; //GameROMsAllNoDump:= True;

          if (CountGameROMs > 0) and (CountCHD > 0) then
             begin
               if CountParentGameROMs = CountGameROMs then
                  begin
                    TEasyGameInfo(addedItem).eCHDParentROMsOnlyCloneSet:= True;
                    // ShowMessage(TEasyGameInfo(addedItem).eName+' -> parent: '+TEasyGameInfo(addedItem).eClone+#13#10+TEasyGameInfo(addedItem).eTitle);
                  end;
             end;
          //if CountROM = 0 then
          //   TEasyGameInfo(addedItem).eHaveGameROMs:= 0;

          //if GameROMsAllNoDump then
          //   begin
          //     if GameROMsNoDumpFile.IndexOf(TEasyGameInfo(addedItem).eName) = -1 then
          //        GameROMsNoDumpFile.Add(TEasyGameInfo(addedItem).eName);
          //   end;
        end;

     if ArcadeCHDMediaTypeID <> -1 then
        begin
          if HaveHDD then
          begin
            case ArcadeCHDMediaTypeID of
              15, 18, 21: ArcadeCHDMediaTypeID:= 12; // Game CD - Game Compact Flash Card - Game Video Tape (VHS)
              16, 19, 22: ArcadeCHDMediaTypeID:= 13; // Device CD - Device Compact Flash Card - Device Video Tape (VHS)
              17, 20, 23: ArcadeCHDMediaTypeID:= 14; // Bios CD - Bios Compact Flash Card - Bios Video Tape (VHS)
              //15: ArcadeCHDMediaTypeID:= 12;
              //16: ArcadeCHDMediaTypeID:= 13;
              //17: ArcadeCHDMediaTypeID:= 14;
              //18: ArcadeCHDMediaTypeID:= 12;
              //19: ArcadeCHDMediaTypeID:= 13;
              //20: ArcadeCHDMediaTypeID:= 14;
              //21: ArcadeCHDMediaTypeID:= 12;
              //22: ArcadeCHDMediaTypeID:= 13;
              //23: ArcadeCHDMediaTypeID:= 14;
            end;
          end;
        end;

     TEasyGameInfo(addedItem).eArcadeCHDMediaType:= ArcadeCHDMediaTypeID;

     TEasyGameInfo(addedItem).eROMInfo.EndUpdate;
     TEasyGameInfo(addedItem).eCHDsCount:= CountCHD;

     //if TEasyGameInfo(addedItem).eName = '2spicy' then
     //   ShowMessage('GameROMsAllNoDump = '+IntToStr(Ord(GameROMsAllNoDump)));

     //if GameROMsAllNoDump then //and (not TEasyGameInfo(addedItem).eROMsAllNoDump) then
     //   ShowMessage(TEasyGameInfo(addedItem).eName+#13#10+TEasyGameInfo(addedItem).eTitle);

     // for debug purposes... do not remove
     //if (not HaveGameROMs) and (not HaveBiosROMs) then
     //   begin
     //     if HaveDeviceROMs and HaveCHDs then
     //        showmessage('Game have device set and CHD file only'+#13#10+
     //                    'game: '+TEasyGameInfo(Item).eName+#13#10+
     //                    'title: '+TEasyGameInfo(Item).eTitle);
     //   end;
     //if TEasyGameInfo(Item).eROMsAllNoDump then
     //   NoDumpSets.Add(GetSystemShortTitle(TEasyGameInfo(Item).eSystemID)+'='+TEasyGameInfo(Item).eName+' ['+TEasyGameInfo(Item).eDriverName+'] '+TEasyGameInfo(Item).eTitle);
   end
   else
      TEasyGameInfo(addedItem).eROMsAllNoDump:= False; // if there are no ROMs/CHDs, it CANNOT be all ROMs "nodump"... DUH!!!!
   //if TEasyGameInfo(addedItem).eROMsAllNoDump and (CountCHD > 0) then
   //   ShowMessageW(TEasyGameInfo(addedItem).eTitle); // for debugging only, do not remove (February 16, 2018)
end;

procedure TFormMain.GetPlayedGameInfoIni(const LineStr: String;
                                         var TimesPlayedVar: Cardinal; var LastPlayedVar: Integer; var TotalPlaytimeVar: Int64);
var
  iPos, iPos2: Integer;
  iInfoStr: String;
begin
  // softlistname\gamename=times_played;last_played;total_playtime
  // a2600\elevator=1;1187870114;4243

  if LineStr = '' then
     Exit;

  iInfoStr:= LineStr;
  iPos:= PosEx('<title>', iInfoStr);
  if iPos <> 0 then
     Delete(iInfoStr, iPos, Length(iInfoStr));
  iPos:= PosEx(';', iInfoStr);
  if iPos <> 0 then
     begin
       iPos2:= PosEx(';', iInfoStr, iPos+1);
       TimesPlayedVar:= StrToInt(Copy(iInfoStr, 1, iPos-1));
       if iPos2 <> 0 then
          begin
            LastPlayedVar:= StrToInt(Copy(iInfoStr, iPos+1, iPos2-(iPos+1)));
            TotalPlaytimeVar:= StrToInt64(Copy(iInfoStr, iPos2+1, Length(iInfoStr)));
          end
       else
          LastPlayedVar:= StrToInt(Copy(iInfoStr, iPos+1, Length(iInfoStr)));
     end
  else
     TimesPlayedVar:= StrToInt(iInfoStr);
end;

function TFormMain.FixUnicodeGameTitle(TitleIn: WideString): WideString;
begin
  // for MSX games, to make games sorting and ELV incremental search easier
  // and because PC keyboards do not have an "alpha" key in them
  if Copy(TitleIn, 1, 2) = 'Î±' then
     Result:= 'Alpha '+Copy(TitleIn, 3, Length(TitleIn))
  else
     Result:= TitleIn;
end;

function TFormMain.EncodeUnicodeStr(const iUnicodeStr: WideString): String;
begin
  if iUnicodeStr = '' then
     begin
       Result:= '';
       Exit;
     end;

  Result:= UTF8Encode(iUnicodeStr);
end;

function TFormMain.DecodeUnicodeStr(const iAnsiStr: String): WideString;
var
  wStr: WideString;
begin
  if iAnsiStr = '' then
     begin
       Result:= '';
       Exit;
     end;
  wStr:= UTF8Decode(iAnsiStr);
  if wStr <> '' then
     Result:= wStr
  else
     Result:= iAnsiStr;
end;

procedure TFormMain.SetVersionInfoFormat;
var
  InfoStr: String;
  sbPos: Integer;
  Item: TEasyItem;
  Group: TEasyGroup;
  UpdateGamesList: Boolean;
begin
  if IsStartup then
     Exit;
  if not CheckTotal(GamesListView) then
     Exit;
  Screen.Cursor:= crHourGlass;
  sbPos:= GetHorizontalBarPos;
  UpdateGamesList:= False;
  GamesListView.BeginUpdate;
  GamesListView.Items.ReIndexDisable:= True;
  if IsGroupedView then
  begin
    if FormPreferences.AddLeadingZeroVersionInfoMAME.Checked then
       ShowFilterMsgBox('Add Leading Zero to Version Info Column', 'Updating MAME version info texts, please wait...', True)
    else
       ShowFilterMsgBox('Remove Leading Zero From Version Info Column', 'Updating MAME version info texts, please wait...', True);
    Group:= GamesListView.Groups.FirstGroup;
    repeat
      Item:= GamesListView.Groups.FirstInGroup(Group);
      repeat
        InfoStr:= FixVersionInfoColumn(TEasyGameInfo(Item).eVersionAdded, FormPreferences.AddLeadingZeroVersionInfoMAME.Checked);
        if not SameText(InfoStr, TEasyGameInfo(Item).eVersionAdded) then
           begin
             TEasyGameInfo(Item).eVersionAdded:= InfoStr;
             UpdateGamesList:= True;
           end;
        Item:= GamesListView.Groups.NextInGroup(Group, Item);
      until Item = nil;
      Group:= GamesListView.Groups.NextGroup(Group);
    until Group = nil;
  end
  else
  begin
    Item:= GamesListView.Groups.FirstItem;
    repeat
      InfoStr:= FixVersionInfoColumn(TEasyGameInfo(Item).eVersionAdded, FormPreferences.AddLeadingZeroVersionInfoMAME.Checked);
      if not SameText(InfoStr, TEasyGameInfo(Item).eVersionAdded) then
         begin
           TEasyGameInfo(Item).eVersionAdded:= InfoStr;
           UpdateGamesList:= True;
         end;
      Item:= GamesListView.Groups.NextItem(Item);
    until Item = nil;
  end;
  if UpdateGamesList then
     GamesListView.Sort.SortAll;
  GamesListView.Items.ReIndexDisable:= False;
  GamesListView.EndUpdate;
  HideFilterMsgBox;
  RestoreHorizontalBarPos(sbPos);
  Screen.Cursor:= crDefault;
  //if UpdateGamesList then
  //   if CheckSelected(GamesListView) then
  //   SelectedEasyItem.MakeVisible(emvMiddle);

end;

function TFormMain.FixVersionInfoColumn(const InfoStr: String; ShowLeadingZero: Boolean): String;
begin
  Result:= InfoStr;
  if InfoStr = '' then
     Exit;

  if ShowLeadingZero then
     begin
       if InfoStr[1] = '.' then
          Result:= '0'+InfoStr;
     end
  else
     begin
       if InfoStr[1] <> '.' then
          begin
            if InfoStr[1] = '0' then
               Delete(Result, 1, 1);
          end;
     end;
end;
 
