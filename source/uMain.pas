  SetMainToolBarIcon(ButtonViewMode);
  SetMainToolBarIcon(ButtonSystemsQuickFilter);
  //SetMainToolBarIcon(ButtonGameFilterArcadeSystems);
  //SetMainToolBarIcon(ButtonGameFilterConsoleComputerSystems);
