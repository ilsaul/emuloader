procedure TFormMain.UpdatePlayedCustomGame(GamePlayTime: Cardinal; ELV_ItemToUpdate: TEasyItem);
var
  iSectionPlayTime: Cardinal;
  PlayedList: THashedStringList;
  iStr, iFileStr: String;
  iPos: Integer;
begin
  iSectionPlayTime:= GetTickCount-GamePlayTime; // get total play time in milliseconds

  TEasyGameInfo(ELV_ItemToUpdate).ePlayed:= MemGameInfo.ePlayed+1;
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate:= DateTimeToFileDate(Now);
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText:= GetDateTimeStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate, True, FormPreferences.LastPlayedHideSeconds.Checked);

  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime+iSectionPlayTime;
  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText:= GetPlayTime(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime, True, FormPreferences.TotalPlayTimeHideSeconds.Checked);

  if SelectedEasyItem = ELV_ItemToUpdate then
     begin
       MemGameInfo.ePlayed:= TEasyGameInfo(ELV_ItemToUpdate).ePlayed;
       MemGameInfo.ePlayedDate:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate;
       MemGameInfo.ePlayedDateText:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText;

       MemGameInfo.eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime;
       MemGameInfo.eTotalPlaytimeText:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText;

     end;
  CheckAndCreateFolder(GetFolderFull(39));
  iFileStr:= GetCustomGamePlayedFile(TEasyGameInfo(ELV_ItemToUpdate).eCustomSystemID);

  PlayedList:= THashedStringList.Create;
  PlayedList.BeginUpdate;
  if MemGameInfo.eIsUnicode then
     iStr:= '<file>'+Utf8Encode(TEasyGameInfo(ELV_ItemToUpdate).eName)+'/>'
  else
     iStr:= '<file>'+TEasyGameInfo(ELV_ItemToUpdate).eName+'/>';
  if FileExists(iFileStr) then
     begin
       PlayedList.LoadFromFile(iFileStr);
       iPos:= GetPlayedGamePosIndex(PlayedList, iStr, False);
       //iPos:= PlayedList.IndexOfName(iStr);
       if iPos <> -1 then
          PlayedList.Delete(iPos);
     end;

  // <file> Game filename/> MediaType IsUnicode PlayedTimes;PlayedDate;TotalPlayTime

  // <file>Knife Edge - Nose Gunner (U) [!].zip/>10 1;1191539653;124020
  PlayedList.Insert(0, iStr+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eCustomMediaType)+IntToStr(Ord(TEasyGameInfo(ELV_ItemToUpdate).eIsUnicode))+' '+
                       IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayed)+';'+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate)+';'+
                       IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime));
  PlayedList.EndUpdate;
  PlayedList.SaveToFile(iFileStr);
  FreeAndNil(PlayedList);
end;

procedure TFormMain.UpdatePlayedGameArcade(GamePlayTime: Cardinal; ELV_ItemToUpdate: TEasyItem);
var
  PlayedList: THashedStringList;
  iSectionPlayTime: Cardinal;
  iGameName, iFileStr, StrToAdd: String;
  iPos: Integer;
begin
  iSectionPlayTime:= GetTickCount-GamePlayTime; // get total play time in milliseconds

  // edit the TEasyItem directly in case the user selected another game while the emulator is running!!!! September 08, 2015
  TEasyGameInfo(ELV_ItemToUpdate).ePlayed:= TEasyGameInfo(ELV_ItemToUpdate).ePlayed+1;
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate:= DateTimeToFileDate(Now);
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText:= GetDateTimeStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate, True, FormPreferences.LastPlayedHideSeconds.Checked);

  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime+GamePlayTime;
  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText:= GetPlayTime(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime, True, FormPreferences.TotalPlayTimeHideSeconds.Checked);

  if SelectedEasyItem = ELV_ItemToUpdate then
     begin
       // update MemGameInfo vars with new info!
       MemGameInfo.ePlayed:= TEasyGameInfo(ELV_ItemToUpdate).ePlayed;
       MemGameInfo.ePlayedDate:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate;
       MemGameInfo.ePlayedDateText:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText;

       MemGameInfo.eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime;
       MemGameInfo.eTotalPlaytimeText:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText;


       {MemGameInfo.ePlayed:= TEasyGameInfo(SelectedEasyItem).ePlayed;
       MemGameInfo.ePlayedDate:= TEasyGameInfo(SelectedEasyItem).ePlayedDate;
       MemGameInfo.ePlayedDateText:= TEasyGameInfo(SelectedEasyItem).ePlayedDateText;

       MemGameInfo.eTotalPlaytime:= TEasyGameInfo(SelectedEasyItem).eTotalPlaytime;
       MemGameInfo.eTotalPlaytimeText:= TEasyGameInfo(SelectedEasyItem).eTotalPlaytimeText;}

     end;

  ForceDirectories(GetFolderFull(41)); // create "arcade\played_games\" folder if it doesn't exist
  iFileStr:= GetGamesPlayedIniFile(TEasyGameInfo(SelectedEasyItem).eSystemID);

  PlayedList:= THashedStringList.Create;
  PlayedList.BeginUpdate;

  iGameName:= GetPlayedGamesNameEntry(TEasyGameInfo(ELV_ItemToUpdate).eName, TEasyGameInfo(ELV_ItemToUpdate).eSoftwareName); // software_name\gamename

  if FileExists(iFileStr) then
     begin
       PlayedList.LoadFromFile(iFileStr);
       iPos:= PlayedList.IndexOfName(iGameName); // for EmuCon games: GetPlayedGamePosIndex(PlayedList, iStr, False);
       if iPos <> -1 then
          PlayedList.Delete(iPos);
     end;

  StrToAdd:= IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayed)+';'+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate)+';'+
             IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime)+'<title>'+TEasyGameInfo(ELV_ItemToUpdate).eTitle+'/><media>'+
             IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eMediaType)+'/>';

  if TEasyGameInfo(ELV_ItemToUpdate).eSoftwareExecParameter <> '' then
     StrToAdd:= StrToAdd+'<execparam>'+TEasyGameInfo(ELV_ItemToUpdate).eSoftwareExecParameter+'/>';

  PlayedList.Insert(0, iGameName+'='+StrToAdd);

  //PlayedList.Insert(0, iGameName+'='+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayed)+';'+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate)+';'+
  //                                   IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime));

  PlayedList.EndUpdate;
  PlayedList.SaveToFile(iFileStr);
  FreeAndNil(PlayedList);

  if ELV_ItemToUpdate <> nil then
     TEasyGameInfo(ELV_ItemToUpdate).Invalidate(False);
end;

function TFormMain.EditApple2GScfg(const emuFile, gameFile: String; GameFilesList: TStringList; ClearEntry: Boolean): Boolean;
var
  sFolder, cfgFile: String;
  sFile: THashedStringList;
  Index, IndexDisk1, Loop: Integer;
  SlotDrive7: array[1..11] of String;
  MultiDisks: Boolean;

  function GetSlotPos(const SlotIndex: Integer): Integer;
  var
    LoopIdx: Integer;
    tmpStr: String;
  begin
    Result:= -1;
    for LoopIdx:=0 to sFile.Count-1 do
    begin
      tmpStr:= 's7d'+IntToStr(SlotIndex);
      if Pos(tmpStr+' =', sFile[LoopIdx]) <> 0 then
         begin
           Result:= LoopIdx;
           Break;
         end
      else
      if Pos(tmpStr+'=', sFile[LoopIdx]) <> 0 then
         begin
           Result:= LoopIdx;
           Break;
         end;
    end;
  end;

begin
  sFolder:= ExtractFileName(emuFile);
  Result:= IsAppleIIGS(sFolder);
  if not Result then
     Exit;
  sFolder:= ExtractFilePath(emuFile);
  cfgFile:= 'config.kegs';
  Result:= FileExists(sFolder+cfgFile);
  if not Result then
     begin
       cfgFile:= 'config.txt';
       Result:= FileExists(sFolder+cfgFile);
       if not Result then
          begin
            CallMessageBox;
            EnableMsgMediaTypeLabel(False);
            AddEmulatorHeader(emuFile);
            AddMsgText('    The emulator config file was not found. ');
            AddMsgText('KEGS32', clBlack, [fsBold]);
            AddMsgText(' and ');
            AddMsgText('GSport', clBlack, [fsBold]);
            AddMsgtext(' emulators do not support loading disks from the command line. Disk file names '+
                       'must be added manually in the config file.'+#13#10+#13#10+
                       '    Please make sure file ');
            AddMsgText('config.kegs', $00a65300, [fsBold]);
            AddMsgtext(' exist for ');
            AddMsgText('KEGS32', clBlack, [fsBold]);
            AddMsgtext(' emulator or ');
            AddMsgText('config.txt', $00a65300, [fsBold]);
            AddMsgtext(' exist for ');
            AddMsgText('GSport', clBlack, [fsBold]);
            AddMsgtext(' emulator.'+#13#10+#13#10+'Aborting...');

            GenerateMessage('Warning! Load Floppy Game on Apple IIGS', MemGameInfo.eTitle);

            Exit;
          end;
     end;
  for Index:=Low(SlotDrive7) to High(SlotDrive7) do
      SlotDrive7[Index]:= '';
  MultiDisks:= GameFilesList <> nil;

  sFile:= THashedStringList.Create;
  sFile.LoadFromFile(sFolder+cfgFile);
  Result:= True;
  
  if ClearEntry then
     begin
       sFile.BeginUpdate;
       Index:= GetSlotPos(1);
       sFile[Index]:= 's7d1 =';
       for Loop:= 2 to High(SlotDrive7) do
       begin
         Index:= GetSlotPos(Loop);
         if Index <> -1 then
            sFile.Delete(Index);
       end;
       sFile.EndUpdate;
       sFile.SaveToFile(sFolder+cfgFile);
       FreeAndNil(sFile);
       Exit;
     end;
     
  if MultiDisks then
     begin
       for Index:= 0 to GameFilesList.Count-1 do
       begin
         if Index > 10 then
            Break;
         SlotDrive7[Index+1]:= GameFilesList[Index];
       end;
     end
  else
     begin
       SlotDrive7[1]:= gameFile;
     end;

  sFile.BeginUpdate;
  for Loop:=Low(SlotDrive7) to High(SlotDrive7) do
  begin
    if Loop = 1 then
       begin
         IndexDisk1:= GetSlotPos(1);
         Index:= IndexDisk1+1;
         sFile[IndexDisk1]:= 's7d1 = '+SlotDrive7[1];
       end
    else
       begin
         if SlotDrive7[Loop] <> '' then
            begin
              IndexDisk1:= GetSlotPos(Loop);
              if IndexDisk1 = -1 then
                 sFile.Insert(Index, 's7d'+IntToStr(Loop)+' = '+SlotDrive7[Loop])
              else
                 sFile[IndexDisk1]:= 's7d'+IntToStr(Loop)+' = '+SlotDrive7[Loop];
              Inc(Index);
            end;
       end;
  end;
  sFile.EndUpdate;
  sFile.SaveToFile(sFolder+cfgFile);
  FreeAndNil(sFile);
end;

function TFormMain.FindDiskCFG(MenuItemHolder: TMenuItem; out cfgFileFullPathVar: WideString): Boolean; //(const sysID: Integer; GameFileName: String): Boolean;
var
  emuFile, FileExt: String;
  cfgFile: WideString;
begin
  cfgFileFullPathVar:= '';
  Result:= CheckSelected(GamesListView);
  if not Result then
     Exit;
  Result:= MemGameInfo.eCustomSystemID in [39, 49, 56, 44];

  emuFile:= ExtractFileName(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]);
  FileExt:= '';
  case MemGameInfo.eCustomSystemID of
    39, 49, 56: // Commodore 64 / 128 / VIC-20
      begin
        Result:= MemGameInfo.eCustomMediaType = IsFloppy;// 4; // flip
        if not Result then
           Exit;
        Result:= IsWinVice(emuFile);
        if not Result then
           Exit;
        cfgFile:= GetFolderFull(38)+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+'\'+
                  ChangeFileExt(MemGameInfo.eName, '.vfl'); // WinVice flip list file
        Result:= FileExists(cfgFile);
        if not Result then
           Exit;
        cfgFileFullPathVar:= cfgFile;
        if MenuItemHolder <> nil then
           begin
             MenuItemHolder.Caption:= 'Edit Flip List File with notepad.exe';
             MenuItemHolder.Hint:= '.vfl'; //ChangeFileExt(MemGameInfo.eGameFileName, '.vfl'); // WinVice flip list file

           end;
      end;
    44: // Amiga
      begin
        Result:= IsAmigaUAE(emuFile);
        if not Result then
           Exit;
           
        cfgFile:= FormMain.GetFolderFull(38)+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+'\'+
                  MemGameInfo.eName;

        if SameText('FS-UAE.exe', emuFile) then
           FileExt:= '.fs-uae'
        else
           FileExt:= '.uae';

        cfgFile:= ChangeFileExtW(cfgFile, FileExt);
        Result:= FileExistsW(cfgFile);
        if not Result then
           Exit;
        cfgFileFullPathVar:= cfgFile;
        if MenuItemHolder <> nil then
           begin
             MenuItemHolder.Caption:= 'Edit Game Config File with notepad.exe';
             MenuItemHolder.Hint:= FileExt; //ChangeFileExt(MemGameInfo.eGameFileName, '.vfl'); // WinVice flip list file
           end;
      end;
  end;
  //if MenuItemHolder <> nil then
  //   MenuPlaySeparatorCommodore.Hint:= SystemsList[MemGameInfo.eSystemID, 0];

  //Result:= FileExists(GetFolderID(7)+SystemsList[MemGameInfo.eSystemID, 0]+'\'+cfgFile);
end;

function CompareDescending(List: TStringList; Index1, Index2: Integer): Integer;
begin
  // this must be natural sorting to sort filenames correctly 1, 2, 11, 20...
  Result:= NaturalCompareText(List[Index2], List[Index1]);
end;

procedure TFormMain.MenuCustomPlayReadUsageRulesClick(Sender: TObject);
var
  rFile: String;
begin
  if not FormMain.CheckSelected(GamesListView) then
     Exit;
  rFile:= GetUsageRulesFile(MemGameInfo.eCustomSystemID);
  if not FileExists(rFile) then
     begin
       CallMessageBox;
       AddMsgText('    File ');
       AddMsgText(rFile, $00a65300, [fsBold]);
       AddMsgText(' was not found! Cannot display the system''s usage rules.');
       GenerateMessage('Error', SystemsListCustom[MemGameInfo.eCustomSystemID, 0]);
       Exit;
     end;
  // re-enable these later
  if not Assigned(FormConsCompSystemRules) then
     FormConsCompSystemRules:= TFormConsCompSystemRules.Create(nil);
  IL_StandardIconsExtraLarge.GetIcon(MaxGameID+MemGameInfo.eCustomSystemID, FormConsCompSystemRules.SystemIcon.Picture.Icon);
  FormConsCompSystemRules.LabelTitle.Caption:= SystemsListCustom[MemGameInfo.eCustomSystemID, 0];
  FormConsCompSystemRules.RulesFile.Lines.LoadFromFile(rFile);
  FormConsCompSystemRules.ShowModal;
  FreeAndNil(FormConsCompSystemRules);
end;

function TFormMain.MountMultiFloppyCommandLine2(var CmdLineVar: WideString): Boolean;
const
  SelectValidEmulatorText: String =
    '    If you''re using more than one emulator for this system, please change your selected emulator (mouse right-click on game).';
var
  GamesFiles: TStringList;
  selItem: TEasyItem;
  MediaType: ShortInt;
  sysID, {Loop, }DriveIndex, EmuIconIndex: Integer;
  emuFile: String;
  FileFullPath, FloppyCommand: WideString;
  IsWinUAE: Boolean;
  iMsgTitle: String;
  StrDOSName, tStr: String;
  HaveYearInfo, HaveManufacturerInfo: Boolean;

  function SearchGameFiles(const SearchName: WideString): WideString;
  var
    LoopSearch: Integer;
    FolderStr: String;
  begin
    Result:= '';
    if not Assigned(sysCustomFolders[sysID, MediaType]) then
       Exit;
    if sysCustomFolders[sysID, MediaType].Count = 0 then
       Exit;

    for LoopSearch:=0 to sysCustomFolders[sysID, MediaType].Count-1 do
    begin
      FolderStr:= sysCustomFolders[sysID, MediaType].Strings[LoopSearch];
      if FindFile(FolderStr, SearchName, Result, False, StrDOSName) then
         Break;
    end;
  end;

  function ShowMsg: Boolean;
  begin
    Result:= True;
    GenerateMessage('Emu Loader', iMsgTitle);
  end;

  function GetSelectedEmulatorMulti: Boolean;
  begin
    Result:= True;
    AddMsgText('    Emulator in use not supported for multiple disks: '+#13#10);
    AddMsgText(EmulatorVersionCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10, $00a65300, [fsBold]);
    AddMsgText(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10+#13#10, clGray { $00a65300 }, [fsBold, fsItalic]);
  end;

begin
  CmdLineVar:= '';
  sysID:= MemGameInfo.eCustomSystemID; // use the system of the last selected game by the user

  Result:= sysID in [39, 44, 49, 52, 53, 56, 59, 48]; // 48 -> Atari 800 (for Altirra v2.60 beta 9 and newer)

  iMsgTitle:= 'Load Multi-Floppy Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';

  if Result then
     Result:= MemGameInfo.eCustomMediaType = IsFloppy;

  if not Result then
     begin
       CallMessageBox;
       if MemGameInfo.eCustomMediaType = IsFloppy then
          AddMsgText('    Multiple floppy disks loading is only supported on following ')
       else
          AddMsgText('    '+MediaTypeCustom[MemGameInfo.eCustomMediaType, 0]+' game selected. '+
                     'Multiple floppy disks loading is only supported on following ');
       AddMsgText('systems', $00a65300, [fsBold]); AddMsgText('/'); AddMsgText('emulators', clBlack, [fsBold]);
       AddMsgText(':'+#13#10+#13#10);
       AddMsgText('Amiga', $00a65300, [fsBold]);
       AddMsgText(': ');
       AddMsgText('FS-UAE', clBlack, [fsBold]);
       AddMsgText(' / ');
       AddMsgText('WinUAE'+#13#10, clBlack, [fsBold]);
       AddMsgText('Commodore 64 / 128 / VIC-20', $00a65300, [fsBold]);
       AddMsgText(': ');
       AddMsgText('WinVICE'+#13#10, clBlack, [fsBold]);
       AddMsgText('Atari 400/800/XL', $00a65300, [fsBold]);
       AddMsgText(': ');
       AddMsgText('Altirra', clBlack, [fsBold]);
       AddMsgText(' (15 disks max) / ');
       AddMsgText('Atari++', clBlack, [fsBold]);
       AddMsgText(' (4 disks max)'+#13#10+' / ');
       AddMsgText('Apple II', $00a65300, [fsBold]);
       AddMsgText(': ');
       AddMsgText('AppleWin', clBlack, [fsBold]);
       AddMsgText(' / ');
       AddMsgText('JACE', clBlack, [fsBold]);
       AddMsgText(' (2 disks max)'+#13#10);
       AddMsgText('Apple IIGS', $00a65300, [fsBold]);
       AddMsgText(': ');
       AddMsgText('GSport', clBlack, [fsBold]);
       AddMsgText(' / ');
       AddMsgText('KEGS32', clBlack, [fsBold]);
       AddMsgText(' (11 disks max)'+#13#10);
       AddMsgText('Amstrad CPC', $00a65300, [fsBold]);
       AddMsgText(': ');
       AddMsgText('WinAPE', clBlack, [fsBold]);
       AddMsgText(' (2 disks max)'+#13#10+#13#10+
                  '    For ');
       AddMsgText('MSX', clBlack, [fsBold]);
       AddMsgText(' multiple disks, use the ');
       AddMsgText('v-DRIVE', $00a65300, [fsBold]);
       AddMsgText(' feature from ');
       AddMsgText('blueMSX', $00a65300, [fsBold]);
       AddMsgText(' emulator'+#13#10+#13#10+'Aborting...');
       ShowMsg;
       Exit;
     end;

  MediaType:= IsFloppy; // floppy disks only!!!
  emuFile:= ExtractFileName(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]]);
  case sysID of
    39, 49, 56: // Commodore 64 / Commodore 128 / VIC-20
      begin
        if not IsWinVice(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('WinVICE', $00a65300, [fsBold]);
             AddMsgText(' emulator can be used to load multiple floppy disks in the command line! '+
                        'For this feature to work, WinVICE filename must be one of the following:'+#13#10);
             AddMsgText('x64.exe        x64sc.exe        x128.exe        x64dtv.exe'+#13#10, $00a65300, [fsBold], taCenter);
             AddMsgText(#13#10+'    Also, a ');
             AddMsgText('flip list file', $00a65300, [fsBold]);
             AddMsgText(' will be created by EmuCon, named the same as the first disk, but with a ');
             AddMsgText('.vfl', $00a65300, [fsBold]);
             AddMsgText(' extension. This file only needs to be created once and it is required '+
                        'by WinVICE for disk swap during the game.'+#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    44: // Amiga
      begin
        if not IsAmigaUAE(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('FS-UAE', $00a65300, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('WinUAE', $00a65300, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('FS-UAE.exe        WinUAE.exe'+#13#10, $00a65300, [fsBold], taCenter);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    48: // Atari 400/800/XL (for Altirra only!!!)
      begin
        if (not IsAltirra(emuFile)) and
           (not IsAtariPlusPlus(emuFile)) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('Altirra', $00a65300, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('Atari++', $00a65300, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('Altirra.exe        Altirra64.exe        atari++.exe'+#13#10, $00a65300, [fsBold], taCenter);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    52: // Apple II
      begin
        //if (not SameText(emuFile, 'AppleWin.exe')) and
        if (not IsAppleWinEmu(emuFile)) and
           (not SameText(emuFile, 'jace.bat')) and
           (not SameText(emuFile, 'jace.cmd')) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('AppleWin', $00a65300, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('JACE', $00a65300, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks (2 disks max) in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('AppleWin.exe        jace.bat        jace.cmd'+#13#10, $00a65300, [fsBold], taCenter);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    53: // Apple IIGS
      begin
        if not IsAppleIIGS(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             AddMsgText('    Only ');
             GetSelectedEmulatorMulti;
             AddMsgText('KEGS32', $00a65300, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('GSport', $00a65300, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks (11 disks max) in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('KEGS32.exe        GSport.exe'+#13#10, $00a65300, [fsBold], taCenter);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    59: // Amstrad PC
      begin
        if not IsWinApe(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('WinApe', $00a65300, [fsBold]);
             AddMsgText(' emulator can be used to load multiple floppy disks (2 disks max) in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('WinApe.exe'+#13#10, $00a65300, [fsBold], taCenter);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
  end;

  HaveYearInfo:= False;
  HaveManufacturerInfo:= False;
  if not Assigned(FormConsCompMultiFloppyGames) then
     FormConsCompMultiFloppyGames:= TFormConsCompMultiFloppyGames.Create(nil);

  tStr:= GetFolderFull(32);
  AddDefaultIcons('favorite_game.ico', tStr, FormConsCompMultiFloppyGames.IL_LoadMultiFloppy); // index 0

  for DriveIndex:= 1 to Length(MediaTypeCustom) do
      AddDefaultIcons(MediaTypeCustom[DriveIndex, 1], tStr, FormConsCompMultiFloppyGames.IL_LoadMultiFloppy);

  case MemGameInfo.eIsCustomGame of
    True : IL_StandardIconsExtraLarge.GetIcon(MaxGameID+MemGameInfo.eCustomSystemID, FormConsCompMultiFloppyGames.SystemIcon.Picture.Icon);
    False: IL_ArcadeSystem_ExtraLarge.GetIcon(FormMain.MemGameInfo.eSystemID, FormConsCompMultiFloppyGames.SystemIcon.Picture.Icon)
  end;
  FormConsCompMultiFloppyGames.LabelSystemTitle.Caption:= SystemsListCustom[sysID, 0];

  if EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]] <> '' then
     begin
       EmuIconIndex:= GetAppIcon(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]],
                     FormConsCompMultiFloppyGames.IL_EmulatorIcon);
       if EmuIconIndex <> -1 then
          FormConsCompMultiFloppyGames.IL_EmulatorIcon.GetIcon(0, FormConsCompMultiFloppyGames.EmulatorIcon.Picture.Icon)
       else
          begin
            EmuIconIndex:= 4+Ord(IsExeBatchFile(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]));
            IL_PopupPlayCustomEmulators.GetIcon(EmuIconIndex, FormConsCompMultiFloppyGames.EmulatorIcon.Picture.Icon);
          end;
       FormConsCompMultiFloppyGames.LabelEmulatorTitle.Caption:=
                 'emulator: '+EmulatorVersionCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10+
                 'filename: '+EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]];
     end;

  FormConsCompMultiFloppyGames.GamesList.BeginUpdate;
  FormConsCompMultiFloppyGames.GamesList.Items.ReIndexDisable:= True;

  FormConsCompMultiFloppyGames.GamesList.Height:= (GamesListView.Selection.Count*FormConsCompMultiFloppyGames.GamesList.CellSizes.Report.Height)+
                                                  FormConsCompMultiFloppyGames.GamesList.Header.Height+
                                                  FormConsCompMultiFloppyGames.GamesList.PaintInfoItem.Border+2;
                                                  
  selItem:= GamesListView.Selection.First;
  repeat
    if (TEasyGameInfo(selItem).eCustomSystemID = sysID) and (TEasyGameInfo(selItem).eCustomMediaType = MediaType) then
       begin
         if (TEasyGameInfo(selItem).eIsUnicode and (sysID = 44)) or // Amiga
            (not TEasyGameInfo(selItem).eIsUnicode) then
         begin
           // add game to the list
           FileFullPath:= SearchGameFiles(TEasyGameInfo(selItem).eName);
           if FileFullPath <> '' then
           begin
             tStr:= '';
             if TEasyGameInfo(selItem).eYear <> '' then
                HaveYearInfo:= True;
             if TEasyGameInfo(selItem).eManufacturer <> '' then
                HaveManufacturerInfo:= True;

             with FormConsCompMultiFloppyGames.GamesList.Items.Add do
             begin
               ImageIndex:= -1;
               ImageIndexes[1]:= TEasyGameInfo(selItem).eCustomSystemID;
               case TEasyGameInfo(selItem).eIsFavorite of
                 True : StateImageIndexes[1]:= 0; //5;
                 False: StateImageIndexes[1]:= 500;
               end;
               StateImageIndexes[4]:= 3;
               Captions[1]:= TEasyGameInfo(selItem).eTitle;
               Captions[2]:= TEasyGameInfo(selItem).eYear;
               Captions[3]:= TEasyGameInfo(selItem).eManufacturer;
               Captions[4]:= LowerCase(ExtractFileExtW(TEasyGameInfo(selItem).eName));
               if TEasyGameInfo(selItem).ePlayed <> 0 then
                  tStr:= IntToStr(TEasyGameInfo(selItem).ePlayed)+'x';
               if TEasyGameInfo(selItem).ePlayedDate <> 0 then
                  begin
                    if tStr <> '' then
                       tStr:= tStr+' ';
                    tStr:= tStr+GetDateTimeStr(TEasyGameInfo(selItem).ePlayedDate, True);
                  end;
               Captions[5]:= tStr;
               Captions[6]:= FileFullPath;
             end;
           end;
         end;
       end;
    selItem:= GamesListView.Selection.Next(selItem);
  until selItem = nil;

  FormConsCompMultiFloppyGames.GamesList.Items.ReIndexDisable:= False;
  FormConsCompMultiFloppyGames.GamesList.EndUpdate(False);

  Result:= CheckTotal(FormConsCompMultiFloppyGames.GamesList);
  if not Result then
     begin
       FreeAndNil(FormConsCompMultiFloppyGames);
       Exit;
     end;

  if not HaveYearInfo then
     begin
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[2].Visible:= False;
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width:= FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width+
                                                                        FormConsCompMultiFloppyGames.GamesList.Header.Columns[2].Width;
     end;

  if not HaveManufacturerInfo then
     begin
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[3].Visible:= False;
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width:= FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width+
                                                                        FormConsCompMultiFloppyGames.GamesList.Header.Columns[3].Width;
     end;

  FloppyCommand:= '';

  FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].SortDirection:= esdAscending;
  case sysID of
    39, 49, 56: // Commodore 64 / 128 / VIC-20
      begin
        FormConsCompMultiFloppyGames.PanelWinViceLabel.Visible:= True;
        FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].SortDirection:= esdDescending;
      end;
    44: // Amiga
      begin
        isWinUAE:= SameText(emuFile, 'WinUAE.exe');
        case isWinUAE of
          True : FloppyCommand:= '"%s"';// FloppyCommand:='-diskswapper="%s"';//  oldCODE ???('-s diskimage%u="%s"';) // WinUAE disk swapper (up to 20 drives!)
          False: FloppyCommand:= '--floppy_image_%u="%s"'; // FS-UAE
        end;
        DriveIndex:= 0; // starts with zero!
      end;
    48: // Atari 400/800/XL
      begin
        DriveIndex:= 1; // Atari++ starts with one!
        if IsAltirra(emuFile) then
           FloppyCommand:= '/disk "%s"' // Altirra v2.60 beta 9 and newer
        else
           FloppyCommand:= {'-enable.%u on }'-image.%u "%s"'; // Atari++ supports 4 disk drives max
      end;
    52: // Apple II
      begin
        case IsAppleWinEmu(emuFile) of
          True : FloppyCommand:= '-d%u "%s"'; // AppleWin emulator
          False: FloppyCommand:= '-s6.d%u "%s"'; // JACE emulator
        end;
        DriveIndex:= 1; // starts with one!
      end;
    53: // Apple IIGS
      begin
        FloppyCommand:= '';
      end;
    59: // Amstrad CPC
      begin
        FloppyCommand:= ''; // not needed here!!!
        DriveIndex:= 0; // starts with zero!
      end;
  end;
  FormConsCompMultiFloppyGames.GamesList.Sort.SortAll;
  FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].SortDirection:= esdNone;

  FormConsCompMultiFloppyGames.ClientHeight:= FormConsCompMultiFloppyGames.PanelGameTitle.Height+
                                              FormConsCompMultiFloppyGames.GamesList.Height+
                                              FormConsCompMultiFloppyGames.BottomBarButtons.Height;

  Result:= FormConsCompMultiFloppyGames.ShowModal = mrYes;
  if not Result then
     begin
       FreeAndNil(FormConsCompMultiFloppyGames);
       Exit;
     end;

  if sysID in [39, 49, 56, 53, 59] then // Commodore 64 / 128 / VIC-20 / Apple IIGS / Amstrad CPC
     begin
       GamesFiles:= TStringList.Create;
       GamesFiles.BeginUpdate;
     end;
  // mount command line / write to custom emulator ini files...
  selItem:= FormConsCompMultiFloppyGames.GamesList.Groups.FirstItem;
  repeat
    case sysID of
      39, 49, 56: // Commodore 64 / 128 / VIC-20
        begin
          GamesFiles.Add(selItem.Captions[6]);
        end;
      44: // Amiga
        begin
          // create the command line string
          case IsWinUAE of
            True: // WinUAE
              begin
                if CmdLineVar <> '' then
                   CmdLineVar:= CmdLineVar+',' // disk images are separated by comma, not space
                else
                   CmdLineVar:= '-0 "'+selItem.Captions[6]+'" -diskswapper=';
                CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [selItem.Captions[6]]);
              end;

            False: // FS-UAE
             begin
                if CmdLineVar <> '' then
                   CmdLineVar:= CmdLineVar+' '
                else
                   CmdLineVar:= '--floppy_drive_0="'+selItem.Captions[6]+'" ';
                 CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [DriveIndex, selItem.Captions[6]]);
              end;
          end;
        end;
      48: // Atari 400/800/XL (Altirra, Atari++)
        begin
          if CmdLineVar <> '' then
             CmdLineVar:= CmdLineVar+' ';
          if IsAltirra(emuFile) then
             CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [selItem.Captions[6]])
          else
             begin
               if DriveIndex = 1 then
                  CmdLineVar:= CmdLineVar+WideFormat('"%s"', [selItem.Captions[6]]) // first image can't have the -image param
               else
                  CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [DriveIndex, selItem.Captions[6]]);
             end;
        end;
      52: // Apple II
        begin
          if CmdLineVar <> '' then
             CmdLineVar:= CmdLineVar+' ';
          CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [DriveIndex, selItem.Captions[6]]);
        end;
      53: // Apple IIGS
        begin
          GamesFiles.Add(selItem.Captions[6]);//[Loop]:= FileFullPath;
        end;
      59:// Amstrad CPC
        begin
          GamesFiles.Add(selItem.Captions[6]);// [Loop]:= FileFullPath;
        end;
    end;
    Inc(DriveIndex);

    selItem:= FormConsCompMultiFloppyGames.GamesList.Groups.NextItem(selItem);
  until selItem = nil;

  if sysID in [39, 49, 56, 53, 59] then // Commodore 64 / 128 / VIC-20 / Apple IIGS / Amstrad CPC
     GamesFiles.EndUpdate;

  if sysID in [39, 49, 56] then
     begin
       try
         GamesFiles.Insert(0, 'UNIT 8');
         GamesFiles.Insert(0, '');
         GamesFiles.Insert(0, '# Vice fliplist file');

         FloppyCommand:= GetFolderFull(38)+SystemsListCustom[sysID, 0]+'\';
         ForceDirectories(FloppyCommand);
         FileFullPath:= FloppyCommand+ExtractFileName(ChangeFileExt(FileFullPath, '.vfl'));
         //ShowMessage('save flip list file: '+#13#10+FileFullPath);
         GamesFiles.SaveToFile(FileFullPath); // save the flip list file!!!!!
       except
         CallMessageBox;
         EnableMsgMediaTypeLabel(False);
         AddEmulatorHeader(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]]);
         AddMsgText('    Flip list file ');
         AddMsgText(FileFullPath, $00a65300, [fsBold]);
         AddMsgText(' could not be saved. Please make sure the destination folder exists and try again. Aborting...');
         GenerateMessage(iMsgTitle, MemGameInfo.eTitle);
       end;
     end;
  if sysID = 53 then // Apple IIGS
     begin
       Result:= EditApple2GScfg(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]], '', GamesFiles, False);
     end;

  if sysID = 59 then // Amstrad CPC
     begin
       WinApeGetCartridgeFile(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]], StrDOSName); // FileFullPath
       WinApeEditIni(4, EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]], StrDOSName, GamesFiles[0], GamesFiles[1], ''); // FileFullPath
     end;

  //ShowMessageW(CmdLineVar);
  FreeAndNil(GamesFiles);
  FreeAndNil(FormConsCompMultiFloppyGames);
end;

function TFormMain.WinApeGetCartridgeFile(const emuFile: String; out CartVariable: String): Boolean;
var
  emuIni: TMemIniFile;
  iniStr: String;
begin
  iniStr:= ChangeFileExt(emuFile, '.ini');
  Result:= FileExists(iniStr);
  if not Result then
     begin
       CartVariable:= 'CPC_PLUS.CPR';
       Exit;
     end;
  emuIni:= TMemIniFile.Create(iniStr);
  CartVariable:= emuIni.ReadString('ROMS', 'Cartridge', 'CPC_PLUS.CPR');
  FreeAndNil(emuIni);
end;

function TFormMain.WinApeEditIni(MediaType: ShortInt; const emuFile, CartridgeFile, Floppy0File, Floppy1File, CassetteFile: String): Boolean;
var
  emuIni: TMemIniFile;
  iniStr: String;
begin
  iniStr:= ChangeFileExt(emuFile, '.ini');
  Result:= FileExists(iniStr);
  if not Result then
     begin
       CallMessageBox;
       AddMsgText('    File ');
       AddMsgText(iniStr, $00a65300, [fsBold]);
       AddMsgText(' was not found. Unable to edit file.'+
                        #13#10+#13#10+'The game cannot be run!');
       GenerateMessage('Warning', 'Edit .ini file');
       Exit;
     end;
  emuIni:= TMemIniFile.Create(iniStr);
  emuIni.WriteString('ROMS', 'Cartridge', CartridgeFile); // should reset to OS ROM
  emuIni.WriteString('Tape', 'File Name', CassetteFile);

  emuIni.WriteString('Drives', 'Drive(0)', Floppy0File);
  emuIni.WriteString('Drives', 'Drive(1)', Floppy1File);

  emuIni.UpdateFile;
  FreeAndNil(emuIni);
end;

// this function is no longer used... November 30, 2017
{procedure TFormMain.AutoRenameSnapshots;
var
  Loop: Integer;
  FilesList, gameFiles: THashedStringList;
  newName, srcFolder, destFolder: String;
  lastIndex: Byte;

  procedure ResetFeature;
  begin
    FreeAndNil(FilesList);
    SetCurrentDir(FrontendPath);
  end;

begin
  if not ImagesAutoRenameSnaps.Checked then
     Exit;
  if MemGameInfo.eSoftwareName <> '' then
     Exit; // no renaming for software list games
  destFolder:= GetFolderFull(1, MemGameInfo.eSystemID);
  srcFolder:= destFolder+MemGameInfo.eName+'\';
  if not DirectoryExists(srcFolder) then
     Exit;
  FilesList:= THashedStringList.Create;
  GetFilesList(srcFolder, '.png', '*.png', FilesList, False, True, True);
  if FilesList.Count = 0 then
     begin
       ResetFeature;
       Exit;
     end;
  case FileExists(destFolder+MemGameInfo.eName+'.png') of
    True:
      begin
        // max filename index is "gamename0099.png" (support for 100 images!!!!)
        gameFiles:= THashedStringList.Create;
        GetFilesList(destFolder, '.png', MemGameInfo.eName+'00??.png', gameFiles, False, True, False);
        if gameFiles.Count = 0 then
           lastIndex:= 2 // gamename0000.png
        else
           begin
             newName:= gameFiles[gameFiles.Count-1];
             newName:= Copy(newName, Length(newName)-7, 4);
             // add 3 to the last index to build the new filename without overwriting files
             lastIndex:= StrToInt(newName)+3;
           end;
        FreeAndNil(gameFiles);
      end;
    False:
      begin
        // 1st image not found, will overwrite all existing files and start from zero
        lastIndex:= 1;
      end;
  end;

  for Loop:=0 to FilesList.Count-1 do
  begin
    newName:= GetImageName(MemGameInfo.eName, lastIndex, 0)+'.png';
    CopyFile(PChar(FilesList[Loop]), PChar(destFolder+newName), False);
    if ImagesAutoDeleteSnaps.Checked then
       DeleteFile(FilesList[Loop]);
    Inc(lastIndex);
  end;
  if ImagesAutoDeleteSnaps.Checked then
     RemoveDir(srcFolder);
  ResetFeature;
end;}

function TFormMain.FixDescriptionFormat(sysID: Byte; const tGameTitle: String; IsMechanical: Boolean): String;
var
  sPosition: Integer;
  newTitle: String;
begin
  Result:= tGameTitle;
  if (sysID = idDemul) or (IsMAMEBasedSys(sysID) and IsMechanical) then
     begin
       sPosition:= PosEx(', the', LowerCase(tGameTitle));
       if sPosition > 0 then
          begin
            newTitle:= tGameTitle;
            Delete(newTitle, sPosition, 5);
            Result:= 'The '+newTitle;
          end;
     end;
end;

procedure TFormMain.SetDescriptionFormat(LoadingGames: Boolean = False);
var
  GameTitle: String;
  Item: TEasyItem;
  Group: TEasyGroup;

  function SetFormat(NewFormat: Boolean): Boolean;
  begin
    case NewFormat of
      True:
        begin
          Result:= SameText(Copy(GameTitle, 1, 4), 'The ');
          if Result then
             GameTitle:= Copy(GameTitle, 5, Length(GameTitle))+', The'
          else
          begin
            Result:= SameText(Copy(GameTitle, 1, 3), 'Le ');
            if Result then
               GameTitle:= Copy(GameTitle, 4, Length(GameTitle))+', Le';
          end;
        end;
      False:
        begin
          Result:= SameText(Copy(GameTitle, Length(GameTitle)-4, 5), ', The');
          if Result then
             GameTitle:= 'The '+Copy(GameTitle, 1, Length(GameTitle)-5)
          else
          begin
            Result:= SameText(Copy(GameTitle, Length(GameTitle)-3, 4), ', Le');
            if Result then
               GameTitle:= 'Le '+Copy(GameTitle, 1, Length(GameTitle)-4);
          end;
        end;
    end;
  end;

begin
  if LoadingGames then
     begin
       if NewTitleFormat.Checked then
          begin
            GameTitle:= TempGameVars.eTitle;
            if SetFormat(True) then
               TempGameVars.eTitle:= GameTitle;
          end;
       Exit;
     end;

  if not CheckTotal(GamesListView) then
     Exit;
  GamesListView.BeginUpdate;
  GamesListView.Items.ReIndexDisable:= True;
  if IsGroupedView then
  begin
    ShowFilterMsgBox('Alternate Title Format [Game, The]', 'Updating game titles, please wait...');
    Group:= GamesListView.Groups.FirstGroup;
    repeat
      Item:= GamesListView.Groups.FirstInGroup(Group);
      repeat
        GameTitle:= TEasyGameInfo(Item).eTitle;
        SetFormat(NewTitleFormat.Checked);
        if not SameText(GameTitle, TEasyGameInfo(Item).eTitle) then
           TEasyGameInfo(Item).eTitle:= GameTitle;
        Item:= GamesListView.Groups.NextInGroup(Group, Item);
      until Item = nil;
      Group:= GamesListView.Groups.NextGroup(Group);
    until Group = nil;
  end
  else
  begin
    Item:= GamesListView.Groups.FirstItem;
    repeat
      GameTitle:= TEasyGameInfo(Item).eTitle;
      SetFormat(NewTitleFormat.Checked);
      if not SameText(GameTitle, TEasyGameInfo(Item).eTitle) then
         TEasyGameInfo(Item).eTitle:= GameTitle;
      Item:= GamesListView.Groups.NextItem(Item);
    until Item = nil;
  end;
  GamesListView.Sort.SortAll;
  GamesListView.Items.ReIndexDisable:= False;
  GamesListView.EndUpdate;
  HideFilterMsgBox;
end;

procedure TFormMain.SetCustomGameTitle(ItemHolder: TEasyItem);
var
  //GameTitleStr, SoftNameStr, sysName, LineStr: String;
  //Item: TEasyItem;
  //Group: TEasyGroup;
  iPos: Integer;
  //SoftList: THashedStringList;
  //IsArcadeEntry: Boolean;
  //sysID: ShortInt;

  function GetShortTitle: WideString;
  begin
    iPos:= Pos('(', TEasyGameInfo(ItemHolder).eTitle);
    if iPos = 0 then
       Result:= ''
    else
       Result:= Copy(TEasyGameInfo(ItemHolder).eTitle, 1, iPos-1);
  end;

begin
  if ItemHolder = nil then
     Exit; // no item to work with... I'm outta here!!!

  //WorkTitle:= TEasyGameInfo(ItemHolder).eTitle;

  case MenuGameTitleExtraInfo.Tag of
    0: TEasyGameInfo(ItemHolder).eTitleShort:= ''; // full title (empty eTitleShort to free RAM usage)
    1: // remove from parent sets only
      begin
        case GameIsClone(TEasyGameInfo(ItemHolder).eClone) of
          True : TEasyGameInfo(ItemHolder).eTitleShort:= '';
          False: TEasyGameInfo(ItemHolder).eTitleShort:= GetShortTitle;
        end;
      end;
    2: // remove from clone sets only
      begin
        case GameIsClone(TEasyGameInfo(ItemHolder).eClone) of
          True : TEasyGameInfo(ItemHolder).eTitleShort:= GetShortTitle;
          False: TEasyGameInfo(ItemHolder).eTitleShort:= '';
        end;
      end;
    3: TEasyGameInfo(ItemHolder).eTitleShort:= GetShortTitle; // remove from all sets (parent+clone)
  end;
end;

function TFormMain.FullFolderFix(const FileFolderString: String; const emuFileFullPath: String = ''; IsFileString: Boolean = False): String;
begin
  Result:= '';
  if FileFolderString = '' then
     Exit;
  if PosEx(':', FileFolderString) <> 0 then
     Result:= FileFolderString
  else
     begin
       if emuFileFullPath = '' then
          Result:= FrontendPath+FileFolderString
       else
          Result:= ExtractFilePath(emuFileFullPath)+FileFolderString; // added March 14, 2016
     end;
  if not IsFileString then
     Result:= IncludeTrailingPathDelimiter(Result);
end;

function TFormMain.FullEmuFolderFix(const FolderString: String; SysID: Byte; CheckZipExtension: Boolean; IsAlterMAME: Boolean = False): String;
begin
  Result:= '';
  if FolderString = '' then
     Exit;
  if PosEx(':', FolderString) <> 0 then
     Result:= FolderString
  else
     begin
       if IsAlterMAME then
          Result:= ExtractFilePath(AlterMAMEFile)+FolderString
       else
          Result:= ExtractFilePath(EmulatorFile[SysID])+FolderString;
     end;
  case CheckZipExtension of
    True:
      begin
        // current being used by zipped images only...
        if (PosEx('.zip', LowerCase(Result)) = 0) then// and
           //(PosEx('.7z',  LowerCase(Result)) = 0) then
           Result:= IncludeTrailingPathDelimiter(Result);
      end;
    False: Result:= IncludeTrailingPathDelimiter(Result);
  end;
end;

