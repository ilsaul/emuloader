function TFormMain.ValidateVideoPreviewSnapFolder(const FilePath: WideString): WideString;
var
  Search: TSearchRecW;
  FileExt: WideString;
  FoundValidFile: Boolean;
begin
  Result:= '';
  FoundValidFile:= False;
  if FindFirstW(FilePath+'.*', $37, Search) = 0 then
     begin
       repeat
         FileExt:= ExtractFileExtW(Search.Name);
         if (not SameText(FileExt, '.png')) and (not SameText(FileExt, '.jpg')) then
            FoundValidFile:= True;
       until FoundValidFile or (FindNextW(Search) <> 0);
       if FoundValidFile then
          Result:= FilePath+Search.Name;
     end;
  FindCloseW(Search);
end;

function TFormMain.FindVideoPreviewFile(sysID, CustomSysID: ShortInt; IsCustomGame: Boolean; const GameName, CloneOfName: WideString; const SoftwareName: String = ''): WideString;
var
  Search: TSearchRecW;
  Folder, FolderSoftware, FolderSnap, FolderVideoSnap, FolderEmuVideo: String;
  FileToLoad, FileStr: WideString;
begin
  Result:= '';
  if VideoPreviewMediaPlayerExecutable = '' then
     Exit;

  Folder:= ''; // this is the custom folder defined in preferences screen (values stored in VideoPreviewDir[] array)
  if IsCustomGame then
     begin
       FileStr:= ChangeFileExtW(GameName, '');
       if ConsoleComputerVideoPreviewDir[CustomSysID] <> '' then
          Folder:= FullFolderFix(ConsoleComputerVideoPreviewDir[CustomSysID]);
     end
  else
     begin
       FileStr:= GameName;
       if ArcadeVideoPreviewDir[sysID] <> '' then
          Folder:= FullFolderFix(ArcadeVideoPreviewDir[sysID]);
     end;

  FolderSoftware:= '';
  if SoftwareName <> '' then
     FolderSoftware:= SoftwareName+'\';

  if Folder <> '' then
     begin
        if FindFirstW(Folder+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
           Result:= Folder+FolderSoftware+Search.Name
        else
           begin
             // this is for arcade games only
             if GameIsClone(CloneOfName) and (VideoPreviewParentGameVideo) then
                begin
                  if FindFirstW(Folder+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                     Result:= Folder+FolderSoftware+Search.Name;
                end;
           end;
     end;
  if Result = '' then
     begin
       if IsCustomGame then
          begin
            FolderEmuVideo:= ''; // "emudir\" is NOT supported for EmuCon systems!!! //ExtractFilePath(EmulatorFile[CustomSysID])+'videosnaps\';
            FolderSnap:= FullFolderFix(SnapshotFolderCustom[CustomSysID, 1]);
          end
       else
          begin
            FolderEmuVideo:= ExtractFilePath(EmulatorFile[sysID])+'videosnaps\';
            FolderSnap:= FullFolderFix(imgFolder[sysID, 1], EmulatorFile[sysID]);
          end;
       if (FolderSnap <> '') or (FolderEmuVideo <> '') then
       begin
         FolderVideoSnap:= FolderSnap+'videosnaps\';
         if FindFirstW(FolderEmuVideo+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
            Result:= FolderEmuVideo+FolderSoftware+Search.Name
         else
         if FindFirstW(FolderVideoSnap+FolderSoftware+FileStr+'.*', $37, Search) = 0 then
            Result:= FolderVideoSnap+FolderSoftware+Search.Name
         else
            begin
              //if FindFirst(FolderSnap+FolderSoftware+GameName+'.*', $37, Search) = 0 then
              //   Result:= FolderSnap+FolderSoftware+Search.Name
              FileToLoad:= ValidateVideoPreviewSnapFolder(FolderSnap+FolderSoftware+FileStr);//GameName);
              if FileToLoad <> '' then
                 Result:= FileToLoad
              else
                 begin
                    if GameIsClone(CloneOfName) and (VideoPreviewParentGameVideo) then
                       begin
                         if FindFirstW(FolderEmuVideo+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                            Result:= FolderEmuVideo+FolderSoftware+Search.Name
                         else
                         if FindFirstW(FolderVideoSnap+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                            Result:= FolderVideoSnap+FolderSoftware+Search.Name
                         else
                            begin
                              FileToLoad:= ValidateVideoPreviewSnapFolder(FolderSnap+FolderSoftware+CloneOfName);
                              if FileToLoad <> '' then
                                 Result:= FileToLoad;
                              //if FindFirst(FolderSnap+FolderSoftware+CloneOfName+'.*', $37, Search) = 0 then
                              //   Result:= FolderSnap+FolderSoftware+Search.Name
                            end;
                       end;
                 end;
            end;
       end;
     end;
  FindCloseW(Search);
end;

procedure TFormMain.CallPlayVideoPreview(StopCurrentPlayback: Boolean = False);
var
  cmdLine, iParams, iFileName: WideString;
begin
  case StopCurrentPlayback of
    True:
      begin
        iParams:= VideoPreviewDummyVideoParameters;
        if iParams = '' then
           iParams:= VideoPreviewMediaPlayerParameters;
        iFileName:= GetFolderFull(35)+'novideo.avi';
      end;
    False:
      begin
        iFileName:= VideoPreviewFile;
        iParams:= VideoPreviewMediaPlayerParameters;
        if iParams = '' then
           iParams:= '%1';
      end;
  end;
  if StopCurrentPlayback then
     begin
       if not FileExistsW(iFileName) then
       begin
         PlayDummyVideoPreview:= False;
         Exit;
       end;
     end;
  case StopCurrentPlayback of
    True:
      begin
        if Pos('%1', iParams) <> 0 then
           iParams:= StringReplaceW(iParams, '%1', '"'+iFileName+'"', [rfIgnoreCase]);
      end;
    False: iParams:= StringReplaceW(iParams, '%1', '"'+iFileName+'"', [rfIgnoreCase]);
  end;

  //iParams:= StringReplace(iParams, '%1', '"'+ButtonPlayVideoPreview.HelpKeyword+'"', [rfIgnoreCase]);
  cmdLine:= SystemStr+VideoPreviewMediaPlayerExecutable+SystemStr+' ';
  cmdLine:= cmdLine+iParams;

  if IsExeBatchFile(VideoPreviewMediaPlayerExecutable) then
     cmdLine:= CommandPromptStr+SystemStr+cmdLine+SystemStr;

  if VideoPreviewPlayDummyVideo then
     PlayDummyVideoPreview:= not StopCurrentPlayback;

  RunProcess(cmdLine, False, SW_SHOWNORMAL);//, False);
end;

procedure TFormMain.PlayDummyVideo(ForcePlayback: Boolean = False);
begin
  if VideoPreviewPlayDummyVideo then
     begin
       if PlayDummyVideoPreview then
          begin
            if (VideoPreviewFile = '') or ForcePlayback then
               CallPlayVideoPreview(True);
          end;
     end;
end;

procedure TFormMain.ELV_CheckItemVisible(ELV_Holder: TEasyListView; Item: TEasyItem; ShowInTheMiddle: Boolean);
var
  RectArray: TEasyRectArrayObject;
  R: TRect;
begin
  if IsRunningGame then
     Exit;
  Item.View.ItemRectArray(Item, ELV_Holder.Header.FirstVisibleColumn, ELV_Holder.Canvas, '', RectArray);
  R:= RectArray.BoundsRect;
  if not ContainsRect(ELV_Holder.ClientInViewportCoords, R) then
     begin
       case ShowInTheMiddle of
         True : Item.MakeVisible(emvMiddle); // this will only be used when changing filters or creating games lists!!!!
         False: Item.MakeVisible(emvAuto);   // it must be Auto to avoid bug when scrolling the list with UP/DOWN arrow keys!!!!
       end;
     end;
end;

