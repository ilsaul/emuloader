  if CheckTotal(GamesListView) then
     GamesListView.BeginUpdate;

  SetTilesViewCellSize;
  if CheckTotal(GamesListView) then
     GamesListView.EndUpdate(False);

  if IsStartup then
     Exit;

  if PopupEnableMAMu_Icons.Checked then // no need to reload EL default game icons or re-init items TEastyItem
     ResetMAMu_ImageList(True);
  ELV_MakeVisible;
end;

procedure TFormMain.MenuUpdateFavoritesProfilesClick(Sender: TObject);
var
  OldArcadeFavFolder, ConsCompFavFolder: String;
  ArcadeFavList, ConsCompFavList: THashedStringList;
  OldFileName, NewFileName: String;
  Loop, tIndex, ArcadeFilesCopied, ConsCompFilesCopied, ConsCompProfilesMerged: Integer;
  DestinationFavProfile, ConsCompFavProfile: THashedStringList;
begin
  OldArcadeFavFolder:= FrontendPath+'ini_files\favorites\';
  ConsCompFavFolder:= GetConsoleComputerFolder+'favorites\';
  CallMessageBox;
  FormMain.AddMsgText('    This function will copy and covert favorite profiles to the new format required by Emu Loader v8.3 and newer.'+#13#10+
                      'Emu Loader and EmuCon frontend profiles that have the same filename are merged into a single profile, saved in ');
  FormMain.AddMsgText(GetFavoritesFolder, MsgTxtColors.colorFileName, [fsBold], taLeftJustify, -1, 'Consolas');
  FormMain.AddMsgText(' new folder. Existing files in this folder will be overwritten.'+#13#10+#13#10+
                      '    If you have EmuCon profiles that you want to use, make sure to copy them in ');
  FormMain.AddMsgText(ConsCompFavFolder, MsgTxtColors.colorFileName, [fsBold], taLeftJustify, -1, 'Consolas');
  FormMain.AddMsgText(' folder. Make sure EmuCon profiles are already updated to EmuCon version 2.7.6 or newer (with .txt file extension).'+#13#10+#13#10+
                      '    Files from ');
  FormMain.AddMsgText(OldArcadeFavFolder, MsgTxtColors.colorFileName, [fsBold], taLeftJustify, -1, 'Consolas');
  FormMain.AddMsgText(' and ');
  FormMain.AddMsgText(ConsCompFavFolder, MsgTxtColors.colorFileName, [fsBold], taLeftJustify, -1, 'Consolas');

  FormMain.AddMsgText(' folders will not be deleted after the conversion is completed. Make sure to manually delete those two folders (or not) '+
                      'as they will not be used anymore.'+#13#10+#13#10+'Do you want to continue ?');
  if GenerateMessage('Instructions', 'Convert Favorite Profiles to New Format', '', 1) = mrNo then
     Exit;

  FormStatus.TitleStr('Convert Favorites Profiles to New Format');
  FormStatus.MessageStr('Building files lists.');
  FormStatus.Show;
  ArcadeFavList:= THashedStringList.Create;
  ConsCompFavList:= THashedStringList.Create;

  GetFilesList(OldArcadeFavFolder, '.ini', '*.ini', ArcadeFavList, False, False, False);
  GetFilesList(ConsCompFavFolder, '.txt', '*.txt', ConsCompFavList, False, False, False);

  if (ArcadeFavList.Count = 0) and (ConsCompFavList.Count = 0) then
     begin
       FreeAndNil(ArcadeFavList);
       FreeAndNil(ConsCompFavList);
       FormStatus.Close;
       GenerateMessage('Info', 'Convert Favorites Profiles to New Format', 'No files were found. Aborting...');
       Exit;
     end;

  ArcadeFilesCopied:= 0;
  ConsCompFilesCopied:= 0;
  ConsCompProfilesMerged:= 0;

  if ArcadeFavList.Count > 0 then
     begin
       FormStatus.MessageStr('Copying arcade profiles to new folder. Existing files will be overwritten.');
       for Loop:=0 to ArcadeFavList.Count-1 do
       begin
         OldFileName:= OldArcadeFavFolder+ArcadeFavList[Loop];
         NewFileName:= GetFavoritesFolder+ChangeFileExt(ArcadeFavList[Loop], '.txt');
         if CopyFile(PChar(OldFileName), PChar(NewFileName), False) then
            Inc(ArcadeFilesCopied);
         //if CopyFileW(PWideChar(OldFileName), PWideChar(NewFileName), False) then // CopyfileW() DOESN'T WORK! :_((
         //   Inc(ArcadeFilesCopied);
       end;
     end;
  Sleep(50); // give Windows some time to update files cache

  if ConsCompFavList.Count > 0 then
     begin
       FormStatus.MessageStr('Copying console/computer profiles to new folder and merging contents with existing profiles.');
       for Loop:=0 to ConsCompFavList.Count-1 do
       begin
         OldFileName:= ConsCompFavFolder+ConsCompFavList[Loop];
         NewFileName:= GetFavoritesFolder+ConsCompFavList[Loop];
         if FileExistsW(WideString(NewFileName)) then
         begin
           DestinationFavProfile:= THashedStringList.Create; // file "eldir\favorites\profilename.txt"
           DestinationFavProfile.LoadFromFile(NewFileName);
           ConsCompFavProfile:= THashedStringList.Create; // file "eldir\console_computer\favorites\profilename.txt"
           ConsCompFavProfile.LoadFromFile(OldFileName);
           tIndex:= ConsCompFavProfile.IndexOfName('favorite_title'); // "favorite_title" entry index... remove it for non-default fav profile
           if tIndex <> -1 then
              ConsCompFavProfile.Delete(tIndex);
           DestinationFavProfile.BeginUpdate;
           DestinationFavProfile.AddStrings(ConsCompFavProfile);
           DestinationFavProfile.EndUpdate;
           DestinationFavProfile.SaveToFile(NewFileName);
           Inc(ConsCompProfilesMerged);
           FreeAndNil(DestinationFavProfile);
           FreeAndNil(ConsCompFavProfile);
         end
         else
           begin
             //if CopyFileW(PWideChar(OldFileName), PWideChar(NewFileName), False) then
             if CopyFile(PChar(OldFileName), PChar(NewFileName), False) then
                Inc(ConsCompFilesCopied);
           end;
       end;
     end;

  FreeAndNil(ArcadeFavList);
  FreeAndNil(ConsCompFavList);
  FormStatus.Close;

  CallMessageBox;
  FormMain.AddMsgText('    Here''s what happened... :)'+#13#10+#13#10+
                      'Arcade profiles copied: ');
  FormMain.AddMsgText(IntToStr(ArcadeFilesCopied), MsgTxtColors.colorFileName, [fsBold]);
  FormMain.AddMsgText(#13#10+'Console/computer profiles copied: ');
  FormMain.AddMsgText(IntToStr(ConsCompFilesCopied), MsgTxtColors.colorFileName, [fsBold]);
  FormMain.AddMsgText(#13#10+'Console/computer profiles merged with arcade profiles: ');
  FormMain.AddMsgText(IntToStr(ConsCompProfilesMerged), MsgTxtColors.colorFileName, [fsBold]);
  FormMain.AddMsgText(#13#10+#13#10+'    Restart the frontend so the active favorites profile can be properly loaded in the games list.');
  GenerateMessage('Info', 'Convert Favorite Profiles to New Format');
end;

procedure TFormMain.ButtonGameFilterMachineTypeSystemsMultiClick(
  Sender: TObject);
var
  ApplyFilters, ApplyMachinesListPanelFilter: Boolean;
begin
  if not Assigned(FormSelectFilterSystemMega) then
     FormSelectFilterSystemMega:= TFormSelectFilterSystemMega.Create(nil);

  FormSelectFilterSystemMega.Left:= FormMain.Left+ButtonGameFilterMachineTypeSystemsMulti.Left+10;
  FormSelectFilterSystemMega.Top:= FormMain.Top+28+10+ToolBarButtons.ButtonHeight+1;

  ApplyFilters:= False;
  ApplyMachinesListPanelFilter:= False;

  if IsNightMode then
     SetPopupMenuNightColors(FormSelectFilterSystemMega.PopupSystems);
     
  if FormSelectFilterSystemMega.ShowModal <> mrOk then
     begin
       FreeAndNil(FormSelectFilterSystemMega);
       Exit;
     end;

  ApplyFilters:= FormSelectFilterSystemMega.FiltersHaveChanged;
  ApplyMachinesListPanelFilter:= FormSelectFilterSystemMega.MAMEMachinesListPanelChanged;
  FreeAndNil(FormSelectFilterSystemMega);
  if (not ApplyFilters) and (not ApplyMachinesListPanelFilter) and (not IsSystemQuickFilterEnabled) then
     Exit;

  if IsSystemQuickFilterEnabled then
     begin
       ApplyFilters:= True;
       ApplyMachinesListPanelFilter:= True;
     end;

  IsSystemQuickFilterEnabled:= False; // disable the systems quick filter since user clicked "Apply" button
  SetMainToolBarIcon(ButtonSystemsQuickFilter);

  if ApplyMachinesListPanelFilter then
     ToggleMachinesListSidePanel; // in here, need to load machines in the EasyListView before calling ApplyFilter...

  if ApplyFilters or ApplyMachinesListPanelFilter then
     SetGameType(False);
end;

procedure TFormMain.ButtonSystemsQuickFilterClick(Sender: TObject);
var
  Item: TEasyItem;
  FilterChanged: Boolean;
begin
  if not Assigned(FormSelectFilterSystemSimple) then
     FormSelectFilterSystemSimple:= TFormSelectFilterSystemSimple.Create(nil);

  FormSelectFilterSystemSimple.Left:= FormMain.Left+ButtonSystemsQuickFilter.Left+10;
  FormSelectFilterSystemSimple.Top:= FormMain.Top+28+10+ToolBarButtons.ButtonHeight+1;

  FormSelectFilterSystemSimple.ResetToMachineTypeSystemsMegaFilter.Visible:= IsSystemQuickFilterEnabled;

  if IsSystemQuickFilterEnabled then
     FormSelectFilterSystemSimple.Caption:= FormSelectFilterSystemSimple.Caption+' [enabled]'
  else
     FormSelectFilterSystemSimple.Caption:= FormSelectFilterSystemSimple.Caption+' [disabled]';

  if IsNightMode then
     begin
       SetPopupMenuNightColors(FormSelectFilterSystemSimple.PopupSystems);
     end;

  if FormSelectFilterSystemSimple.ShowModal <> mrOk then
     begin
       if FormSelectFilterSystemSimple.Tag = 500 then // user clicked the "Reset To Default" button
          begin
            FreeAndNil(FormSelectFilterSystemSimple);
            IsSystemQuickFilterEnabled:= False; // disable the systems quick filter since user clicked "Apply" button
            SetMainToolBarIcon(ButtonSystemsQuickFilter);
            SetGameType(False); // re-apply the "Machine Type / Systems" mega filter
            Exit;
          end
       else
          begin
            FreeAndNil(FormSelectFilterSystemSimple);
            Exit;
          end;
     end;

  FilterChanged:= False;

  Item:= FormSelectFilterSystemSimple.ConsCompSystemsListView.Groups.FirstItem;
  repeat
    if ELV_IsArcadeSystemMulti(Item) then
       begin
         if FilterSysArcadeQuick[Item.ImageIndex] <> Item.Selected then
            begin
              FilterSysArcadeQuick[Item.ImageIndex]:= Item.Selected;
              FilterChanged:= True;
            end;
       end
    else
       begin
         if FilterSysConsCompQuick[Item.StateImageIndex] <> Item.Selected then
            begin
              FilterSysConsCompQuick[Item.StateImageIndex]:= Item.Selected;
              FilterChanged:= True;
            end;
       end;
    Item:= FormSelectFilterSystemSimple.ConsCompSystemsListView.Groups.NextItem(Item);
  until Item = nil;

  FreeAndNil(FormSelectFilterSystemSimple);

  if FilterChanged or (not IsSystemQuickFilterEnabled) then
     begin
       if FilterMachineType.MAMEMachinesFilterPanel_Enabled then
          begin
            FilterMachineType.MAMEMachinesFilterPanel_Enabled:= False;
            ToggleMachinesListSidePanel; // disable the MAME Machines Filter Panel to avoid problems with the quick filter
          end;

       IsSystemQuickFilterEnabled:= True;
       SetMainToolBarIcon(ButtonSystemsQuickFilter);
       SetGameType(False);
     end;
end;

