              CreateSplitter(1, alLeft, PanelImage, Images);

              CreatePanel(alRight); // "ImagePnl"
              CreateSplitter(2, alRight, PanelImage, ImagePnl);
              ImagePnl.Width:= ImgSize[1];

              CreateImage(2, alClient, PanelImage);
              
              CreateImage(3, alTop, ImagePnl);
              ImageScr[3].Height:= ImgSize[2];
              CreateSplitter(3, alTop, ImagePnl, ImageScr[3]);

              CreateImage(4, alClient, ImagePnl);
            end;
          26:
            begin
              // quad, layout 17
              AlignMainImage(alRight, PanelImage);
              DestroyImageLayoutControls;

              Images.Width:= ImgSize[0];
              CreateSplitter(1, alRight, PanelImage, Images);

              CreatePanel(alLeft); // "ImagePnl"
              CreateSplitter(2, alLeft, PanelImage, ImagePnl);
              ImagePnl.Width:= ImgSize[1];

              CreateImage(2, alClient, PanelImage);

              CreateImage(3, alTop, ImagePnl);
              ImageScr[3].Height:= ImgSize[2];
              CreateSplitter(3, alTop, ImagePnl, ImageScr[3]);

              CreateImage(4, alClient, ImagePnl);
            end;
        end;
      end;
    False:
      begin
        DestroyImageLayoutControls;
      end;
  end;

  ButtonscreenshotLayouts.Hint:= 'Layout -> '+GetScrLayoutSection(ButtonScreenshotLayouts.Tag)+' <-';
  UpdateImageLayoutSplittersStyle;
  PanelScreenshotsArea.Canvas.Unlock;

  if MenuShowImages.Checked then
     begin
       if not IsStartUp then
          InitZippedImagesCache;
       ToggleImagesPanel(True); // added TRUE parameter to avoid calling uMain.UpdateScreenshotsPanel function (January 30, 2018)
     end;
end;

procedure TFormMain.SetGripIcon(var SplitterHolder: TSplitterEx; ShowGrip: Boolean);
begin
  if not Assigned(SplitterHolder) then
     Exit;
  case ShowGrip of
    True : SplitterHolder.GripStyle:= sgDots;
    False: SplitterHolder.GripStyle:= sgNone;
  end;
end;

procedure TFormMain.SetSplitterColors(SplitterHolder: TSplitterEx; SingleColor, SingleColorHot: TColor);
begin
  if not Assigned(SplitterHolder) then
     Exit;

  if SplitterHolder.Style = tsSolidColor then
     begin
       if SplitterHolder.Appearance.SingleColor <> SingleColor then
          SplitterHolder.Appearance.SingleColor:= SingleColor;
       if SplitterHolder.Appearance.SingleColorHot <> SingleColorHot then
          SplitterHolder.Appearance.SingleColorHot:= SingleColorHot;
     end;
end;

procedure TFormMain.UpdateSplitterStyle(SplitterHolder: TSplitterEx; NewSplitterStyle: TTMSStyle; SingleColor, SingleColorHot: TColor);
begin
  if not Assigned(SplitterHolder) then
     Exit;

  if SplitterHolder.Style <> NewSplitterStyle then
     SplitterHolder.Style:= NewSplitterStyle;
  if NewSplitterStyle = tsSolidColor then
     begin
       if SplitterHolder.Appearance.SingleColor <> SingleColor then
          SplitterHolder.Appearance.SingleColor:= SingleColor;
       if SplitterHolder.Appearance.SingleColorHot <> SingleColorHot then
          SplitterHolder.Appearance.SingleColorHot:= SingleColorHot;
     end;
end;

