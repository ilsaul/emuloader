function TFormMain.GetDemulMachineName(const DriverName: String; IsOldBuild: Boolean): String;
begin
  if (DriverName = 'naomigd.c') or (DriverName = 'naomi2.c') or (DriverName = 'naomi2gd.c') or (DriverName = 'spider.c') then
     Result:= 'naomi'
  else
