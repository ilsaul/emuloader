procedure TFontDialog.DoShow;
const
  SMyColorName: PChar = 'Custom...';
begin
  SendDlgItemMessage(Handle, IDCOLORCMB, CB_INSERTSTRING, 0, Integer(SMyColorName));
  SendDlgItemMessage(Handle, IDCOLORCMB, CB_SETITEMDATA, 0, ColorToRGB(Font.Color));
  inherited;
end;

procedure TFontDialog.WndProc(var Message: TMessage);
begin
  inherited;
  with Message do
    if (Msg = WM_COMMAND) and (WParamHi = CBN_SELENDOK) and (WParamLo = IDCOLORCMB) and (SendDlgItemMessage(Handle, IDCOLORCMB, CB_GETCURSEL, 0, 0) = 0) then
    begin
      with TColorDialog.Create(Self) do
        try
          Color := TColor(SendDlgItemMessage(Self.Handle, IDCOLORCMB, CB_GETITEMDATA, 0, 0));
          Options := [cdFullOpen];
          if Execute then //(Self.Handle) then
             SendDlgItemMessage(Self.Handle, IDCOLORCMB, CB_SETITEMDATA, 0, ColorToRGB(Color));
        finally
          Free;
        end;
    end;
end;

function MyTerminateAppEnum(hHwnd: HWND; dwData: LPARAM): Boolean;
var
  vID: DWORD;
begin
  GetWindowThreadProcessID(hHwnd, @vID);
  if vID = dwData then
  begin
    PostMessage(hHwnd, WM_CLOSE, 0, 0); // tell window to close gracefully
    Result:= False;  // can stop enumerating
  end
  else
  begin
    Result:= True; // keep enumerating until you find your ID
  end;
end;

function TGroupInfo.GetCaptions(Column: Integer): WideString;
begin
  case Column of
    0: Result:= eTitle;
    1: Result:= eYear;
    2: Result:= eManufacturer;
    7: Result:= eName;
  end;
end;

function TEasyGameInfo.GetCaptions(Column: Integer): WideString;
begin
  case Column of
    00:
      begin
        if eTitleShort = '' then
           Result:= eTitle
        else
           Result:= eTitleShort;
      end;
    01: Result:= eYear;
    02: Result:= eManufacturer;
    03: Result:= aOrientation[eScreenOrientation];
    04: Result:= eScreenResolution;
    05:
      begin
        if eScreenRefreshRate <> '' then
           Result:= eScreenRefreshRate+' Hz'
        else
           Result:= '';
      end;
    06: Result:= eCategory;
    07: Result:= eVersionAdded;
    08: Result:= eName;
    09: Result:= eClone;
    10: Result:= eDriverName;
    11: Result:= FormMain.GetNumberPlayersInfo(eNumberPlayers, eNumberPlayersIni);
    12: Result:= FormMain.AbbreviateStatusText(aStatus[eDriverStatus]);
    13: Result:= FormMain.AbbreviateStatusText(aStatus[eEmulationStatus]);
    14: Result:= FormMain.AbbreviateStatusText(aStatus[eColorStatus]);
    15: Result:= FormMain.AbbreviateStatusText(aStatus[eSoundStatus]);
    16: Result:= FormMain.AbbreviateStatusText(aStatus[eGraphicStatus]);
    17:
      begin
        if ePlayed = 0 then
           Result:= ''
        else
           Result:= IntToStr(ePlayed)+'x'
      end;
    18: Result:= eLanguage;
    19: Result:= eGameSizeText;
    20: Result:= ePlayedDateText;
    21: Result:= eTotalPlaytimeText;
    22: Result:= eSoftwareName;
    23:
      begin
        if eIsSpecial then
           Result:= 'Yes'
        else
           Result:= '';
      end;
    
    50: // for tiles view mode, details "1"
      begin
        if ePlayed = 0 then
           Result:= 'Played: (none)'
        else
           begin
             if ePlayedDateText = '' then
                Result:= 'Played '+IntToStr(ePlayed)+'x'
             else
                Result:= 'Played '+IntToStr(ePlayed)+'x '+ePlayedDateText;
           end;
      end;
  end;
end;

function TEasyGameInfo.GetImageIndexes(Column: Integer): TCommonImageIndexInteger;
begin
  if Column = 0 then
     begin
       case eIsCustomGame of
         True : Result:= MaxGameID+eCustomSystemID;
         False: Result:= FormMain.GetMAMEImageIndex(eImageIndex, eSoftwareName, eIconLoaded)
       end;
     end
  else
     Result:= -1;
end;

function TEasyGameInfo.GetStateImageIndexes(Column: Integer): TCommonImageIndexInteger;
begin
  Result:= -1;
  if (not FormMain.IsDetailsView) and (not FormMain.IsGroupedView) then
     Exit;
  if FormMain.IsGroupedView then
     begin
       if (Column = 0) and (not FormPreferences.DisableCloneIndent.Checked) then
          begin
            if FormMain.GameIsClone(eClone) then
               Result:= 100; // non-existing index to show an empty space in place of the game icon
          end;
     end
  else
  if FormMain.IsDetailsView and (FormMain.MenuShowFavoriteIconInGamesList.Checked) then
     begin
       if not FormMain.PopupEnableFavorites.Checked then
          begin
            if Column = 0 then
            if eIsFavorite then
               Result:= 3
            else
               Result:= 100; // non-existing index to show an empty space in place of the fav icon
          end;
     end;

  if FormPreferences.DisableDriverStatusIcons.Checked then
     Exit;
  if Column = 12 then
     Result:= eDriverStatus
  else
  begin
     if not (eSystemID in [idMAME, idHBMAME]) then
        Exit;
    case Column of
      13: Result:= eEmulationStatus;
      14: Result:= eColorStatus;
      15: Result:= eSoundStatus;
      16: Result:= eGraphicStatus;
    end;
  end;
end;

