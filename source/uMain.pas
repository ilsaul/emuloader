function TFormMain.GetMAMEImageIndex(CurrentImageIndex: Integer; const SoftwareName: String; IsMAMu_IconLoaded: Boolean = False): Integer;
begin
  if SoftwareName = '' then
     Result:= CurrentImageIndex
  else
     begin
       case CurrentImageIndex of
         00: Result:= 44; // MAME parent have
         01: Result:= 45; // MAME clone have
         04: Result:= 46; // MAME parent miss
         05: Result:= 47; // MAME clone miss
       else
         begin
           if CurrentImageIndex > MaxGameID then
              Result:= CurrentImageIndex
           else
              Result:= 44; // MAME parent have
         end;
       end;
     end;
end;

function TFormMain.CallSelectArcadeSystem(FeatureType: ShortInt = -1; SelectSysID: ShortInt = 0): Integer;
var
  Item: TEasyItem;
  StrResult: String;
begin
  Result:= -1; // "cancel" is the default result
  // 0 -> all systems
  // 1..MaxArcadeSystems -> valid EL systems

  if not Assigned(FormArcadeSelectSystem) then
     FormArcadeSelectSystem:= TFormArcadeSelectSystem.Create(nil);

  FormArcadeSelectSystem.ActionMode:= FeatureType;
  FormArcadeSelectSystem.selSysID:= SelectSysID;

  // PopupScanGames.HelpContext will hold last fixed MAME Scan Sets mode so it can be restored later
  // 1    -> create games list
  // 4, 5 -> scan games feature
  // 6    -> create MAME/HBMAME software list
  if FeatureType in [1, 4, 5, 6] then
     PopupScanGames.HelpContext:= MenuCreateMAMESoftwareListGames.HelpContext;

  if FormArcadeSelectSystem.ShowModal = mrOk then
     begin
       if FormArcadeSelectSystem.MAMESoftwareListBox.Visible then
          MenuCreateMAMESoftwareListGames.Tag:= FormArcadeSelectSystem.MAMESoftwareListBox.Tag;

       if FormArcadeSelectSystem.ScanMAMESetsBox.Visible then
          MenuCreateMAMESoftwareListGames.HelpContext:= FormArcadeSelectSystem.ScanMAMESetsBox.Tag;

       if FormArcadeSelectSystem.AddMAMEDeviceSetWithNoROMs.Visible then
          MenuAddMAMEDeviceSetsWithNoROMs.Tag:= Ord(FormArcadeSelectSystem.AddMAMEDeviceSetWithNoROMs.Checked);

       case FormArcadeSelectSystem.SystemsListView.Selection.MultiSelect of
         True:
           begin
             if FeatureType in [1, 4, 5, 6] then
                begin
                  // create games list, scan games feature
                  // .HelpContext will hold last fixed scan mode so it can be restored later
                  PopupSelectScanGamesMode.HelpContext:= -1;
                  if FormArcadeSelectSystem.ScanModeCurrentTaskOnly.Checked then
                     PopupSelectScanGamesMode.HelpContext:= PopupSelectScanGamesMode.Tag
                  else
                     PopupScanGames.HelpContext:= -1; // avoid tag from being changed since "For This Task Only" is selected (create games list feature)

                  // 0 -> full scan
                  // 1 -> quick scan
                  // 2 -> force all available
                  PopupSelectScanGamesMode.Tag:= FormArcadeSelectSystem.ScanModeBox.Tag;
                end;
             Item:= FormArcadeSelectSystem.SystemsListView.Selection.First;
             if Item <> nil then // make sure a system is selected to avoid errors (double-check mode ON)
             begin
               if Item.ImageIndex > 0 then
                  begin
                    if FormArcadeSelectSystem.SystemsListView.Selection.Count = 1 then
                       Result:= Item.ImageIndex
                    else
                       begin
                         StrResult:= '';
                         repeat
                           if not Item.Ghosted then // check if system is NOT disabled
                              StrResult:= StrResult+IntToStr(Item.ImageIndex);
                           Item:= FormArcadeSelectSystem.SystemsListView.Selection.Next(Item);
                         until Item = nil;
                         if StrResult <> '' then // must check if there is any system available (user select "all systems" and NO system is enabled)
                            Result:= StrToInt(StrResult);
                       end;
                  end
               else
                  begin
                    // option "all systems" were selected, get all available systems
                    StrResult:= '';
                    Item:= FormArcadeSelectSystem.SystemsListView.Groups.NextItem(Item);
                    repeat
                      if not Item.Ghosted then // check if system is NOT disabled!!!
                         StrResult:= StrResult+IntToStr(Item.ImageIndex);
                      Item:= FormArcadeSelectSystem.SystemsListView.Groups.NextItem(Item);
                    until Item = nil;
                    if StrResult <> '' then // must check if there is any system available (user select "all systems" and NO system is enabled)
                       Result:= StrToInt(StrResult);
                    //ShowMessage(StrResult); // debugging only, do not enable
                  end;
             end;
           end;
         False:
           begin
             if FeatureType = 6 then
                begin
                  // create MAME/HBMAME software games list
                  // .HelpContext will hold last fixed scan mode so it can be restored later
                  PopupSelectScanGamesMode.HelpContext:= -1;
                  if FormArcadeSelectSystem.ScanModeCurrentTaskOnly.Checked then
                     PopupSelectScanGamesMode.HelpContext:= PopupSelectScanGamesMode.Tag
                  else
                     PopupScanGames.HelpContext:= -1; // avoid tag from being changed since "For This Task Only" is selected

                  // 0 -> full scan
                  // 1 -> quick scan
                  // 2 -> force all available
                  PopupSelectScanGamesMode.Tag:= FormArcadeSelectSystem.ScanModeBox.Tag;
                end;
             Result:= FormArcadeSelectSystem.SystemsListView.Selection.First.ImageIndex; // single selection
           end;
       end;
     end;
  FreeAndNil(FormArcadeSelectSystem);
end;

procedure TFormMain.LoadThumbnailFavIcon(Size: Integer; IconHolder: TIcon; IsAlphaBlend: Boolean);
var
  Icon32: TExIcon;
  tmpIcon: TIcon;
  Loop: Integer;
  iFileStr: String;
begin
  //iFileStr:= 'favorite_thumbnail.ico';
  case IsAlphaBlend of
    True : iFileStr:= 'favorite_thumbnail.ico';
    False: iFileStr:= 'favicon_thumbnail.ico';
  end;

  if not FileExists(GetFolderFull(32)+iFileStr) then
     Exit;

  case IsAlphaBlend of
    True:
      begin
        Icon32:= TExIcon.Create;
        Icon32.LoadFromFile(GetFolderFull(32)+iFileStr);
        for Loop:=0 to Icon32.ImageCount-1 do
        begin
          if (Icon32.Images[Loop].Width = Size) and
             (Icon32.Images[Loop].Height = Size) and
             (Icon32.Images[Loop].PixelFormat = pf32bit) then
             begin
               Icon32.CurrentImage:= Loop;
               tmpIcon:= TIcon.Create;
               tmpIcon.Handle:= Icon32.Handle;
               IconHolder.Assign(tmpIcon);
               Icon32.ReleaseHandle;
               FreeAndNil(tmpIcon);
               Break;
             end;
        end;
        FreeAndNil(Icon32);
      end;
    False: IconHolder.LoadFromFile(GetFolderFull(32)+iFileStr);
  end;
end;

