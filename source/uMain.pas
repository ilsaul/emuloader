  TGameInfo = record
    //eSortIndex: Integer;
    eImageIndex: Integer;
    eROMIdentification: Integer;
    eMediaType: ShortInt; // 0 -> ROM/Cartridge/Floppy/Cassette; 1 -> CHD... perhaps expand this to include 'cartridge', 'floppy', 'cassete' (MESS)
    eSystemID: ShortInt;
    eSystemType: ShortInt; // 0 -> arcade; 1 -> MESS (everything not arcade machines); this is for filtering only and requires "mess.ini" from AntoPISA (version.ini pack)
    eCustomSystemID: ShortInt;
    eCustomMediaType: ShortInt; // 0 -> ROM; 1 -> Cartridge; 2 -> Disc Image; 3 -> Floppy; 4 -> Cassette; 5 -> Hard Disk Drive
    eIsCustomGame: Boolean;
    eIsUnicode: Boolean; // for EmuCon games only
    eIconLoaded: Boolean;
    eTitle: WideString;

    eYear: String;
    eManufacturer: WideString;

    eControls: String;
    eButtonsCount: Byte; // 0 for games with no "buttons" tag in "<input" entry
    eAudioType: ShortInt; // 0 -> Standard Audio (Sound Chip); 1 -> Discrete Audio; 2 -> Sound Samples (FLAC/WAV files)

    eScreenType: ShortInt; //  -1 -> none; 0 -> raster; 1 -> vector; 2 -> LCD; 3 -> SVG; 4 -> unknown
    eScreenOrientation: SmallInt; // -1 -> none/unknown; 0 -> horizontal; 1 -> vertical
    eScreenResolution: String;
    eScreenRefreshRate: String;

    eDriverStatus: ShortInt; // -1 -> none; 0 -> Good; 1 -> Imperfect; 2 -> Preliminary
    eEmulationStatus: ShortInt; // MAME / HBMAME only
    eColorStatus: ShortInt; // MAME / HBMAME only
    eSoundStatus: ShortInt; // MAME / HBMAME only
    eGraphicStatus: ShortInt; // MAME / HBMAME only

    eCategory: WideString;
    eVersionAdded: String;
    eLanguage: WideString;

    eName: WideString;
    eClone: String;
    eDriverName: String;
    eBiosName: String;

    eNumberPlayers: String;
    eNumberPlayersIni: String;

    eChipCPU: String;
    ePlayed: Cardinal;
    ePlayedDate: Integer; // Int64; // no need for Int64 here...
    ePlayedDateText: String;
    eTotalPlaytime: Int64;
    eTotalPlaytimeText: String;
    eMechanical: Boolean;

    eSaveState: ShortInt; // -1 -> unknown (empty); 0 -> unsupported; 1 -> supported

    eIsFavorite: Boolean;
    eGameSize: Int64;
    eGameSizeText: String;
    eGameSetStatus: ShortInt; // 0 - have (available); 1 - missing ROMs/CHDs; 2 - missing (no .zip and no ROMs found... even if CHDs are found)
    eHaveGameROMs: ShortInt; // 1 - have game ROMs; 0 -> no game ROMs, maybe only bios ROMs, device ROMs

    eSoftwareName: String; // softwarelist name "msx1_cart" (games from MSX1 cartridge software list); a800; vectrex; empty: is arcade game or MESS machine or EmuCon game
    eSoftwareExecParameter: String; // list MESS parameter for each media type -cart1; -flop1; -cass1; etc...
    eSoftwareCompatible: String; // compatibility tag for MESS games from hash\softwarelist.xml files...
    eSoftwareUsageTip: WideString; // usage info for MESS software list games

    eScanMode: Byte; // 0 -> full scan; 1 -> quick scan (file search only); 2 -> force available
    eIsMerged: Boolean;
    eCHDsCount: Byte;
    eROMsAllNoDump: Boolean;
  end;

  TImageDetailsRecord = packed record
    FileName: WideString;
    NoImageLoaded: Boolean;
    PrevNoImageLoaded: Boolean;
    SystemID: ShortInt;
    CustomSystemID: ShortInt; // for console/computer games (EmuCon)
