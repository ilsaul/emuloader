procedure TFormMain.CycleImageLayout(MoveForward: Boolean);
var
  LayoutEnabled: Boolean;
  Index: ShortInt;
begin
  if ButtonInternetGameInfo.Down then
     Exit;
     
  Index:= ButtonScreenshotLayouts.Tag;
  repeat
    case MoveForward of
      True:
        begin
          Inc(Index);
          if Index > MaxImageLayouts then
             Index:= 0;
        end;
      False:
        begin
          Dec(Index);
          if Index < 0 then
             Index:= MaxImageLayouts;
        end;
    end;
    if Index = 0 then
       LayoutEnabled:= True
    else
       LayoutEnabled:= ImageLayoutVisible[Index];

    if LayoutEnabled then
       CallSelectImageLayout(Index, False);

  until LayoutEnabled;
end;

