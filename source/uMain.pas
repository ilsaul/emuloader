procedure TFormMain.LoadROMFolders(sysID: ShortInt; IsAlterMAME: Boolean = False);
begin
  case IsMAMEBasedSys(sysID) of
    True : LoadFolders_MAME(sysID, '', IsAlterMAME);
    False: LoadFoldersArcade2(sysID);
  end;
