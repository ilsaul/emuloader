begin
  Result:= FormNightMode.NightModeCheckBoxRadioButtonProfile.ItemIndex > 0;
end;

procedure TFormMain.SetButtonExColorsColorBox(ButtonSource: TBitBtnEx; SetDefaultColor: Boolean; ForceUpdate: Boolean = False; ForceNightColors: Boolean = False);

  function GetColorState(ColorBoxSource: TColorBoxEx): TColor;
  begin
    if SetDefaultColor then
       Result:= ColorBoxSource.DefaultColorColor
    else
       Result:= ColorBoxSource.Selected;
  end;

begin
  // this can be used if button colors must be the default ones... redundant ? function since you can use uMain.SetButtonExColors()
  ButtonSource.Font.Color:= GetColorState(FormNightMode.NightModeButtonColorFontColor);
  ButtonSource.GradientColorTop:= GetColorState(FormNightMode.NightModeButtonColorGradientTop);
  ButtonSource.GradientColorBottom:= GetColorState(FormNightMode.NightModeButtonColorGradientBottom);
  ButtonSource.FrameColor:= GetColorState(FormNightMode.NightModeButtonColorFrameColor);

  ButtonSource.FrameColor_Focused:= GetColorState(FormNightMode.NightModeButtonColorFrameColorFocused);

  ButtonSource.GradientColorTop_Hover:= GetColorState(FormNightMode.NightModeButtonColorGradientTopHover);
  ButtonSource.GradientColorBottom_Hover:= GetColorState(FormNightMode.NightModeButtonColorGradientBottomHover);
  ButtonSource.FrameColor_Hover:= GetColorState(FormNightMode.NightModeButtonColorFrameColorHover);

  ButtonSource.GradientColorTop_Disabled:= GetColorState(FormNightMode.NightModeButtonColorGradientTopDisabled);
  ButtonSource.GradientColorBottom_Disabled:= GetColorState(FormNightMode.NightModeButtonColorGradientBottomDisabled);
  ButtonSource.FrameColor_Disabled:= GetColorState(FormNightMode.NightModeButtonColorFrameColorDisabled);

  ButtonSource.FontColorDisabled:= GetColorState(FormNightMode.NightModeButtonColorFontColorDisabled);

  ButtonSource.FontShadowColorDisabled:= GetColorState(FormNightMode.NightModeButtonColorFontShadowColorDisabled);

  ToggleButtonExCustomDraw(ButtonSource, ForceNightColors);

  if ForceUpdate then
     ButtonSource.Invalidate;
end;

function TFormMain.GetSoftwareListTitle(const SoftwareName: String; sysID: ShortInt): WideString;
var
  sIni: TStringList;
begin
  Result:= '';
  if not FileExists(GetGamesFolderEL(1, sysID)+SoftwareName+'.el') then
     Exit;
  sIni:= TStringList.Create;
  sIni.LoadFromFile(GetGamesFolderEL(1, sysID)+SoftwareName+'.el');
  Result:= sIni.Values['description'];
  FreeAndNil(sIni);
end;

function TFormMain.GetLastUsedMachineSoftwareList(const SoftwareName: String; sysID: ShortInt): String;
var
  MachinesIni: THashedStringList;
begin
  Result:= '';
  if not FileExists(GetMAMEMachineSoftListFile(True, sysID)) then
     Exit;
  MachinesIni:= THashedStringList.Create;
  MachinesIni.LoadFromFile(GetMAMEMachineSoftListFile(True, sysID));
  Result:= MachinesIni.Values[SoftwareName];
  FreeAndNil(MachinesIni);
end;

function TFormMain.GetLastUsedMachineCustomGame(CustomSystemID, CustomMediaTypeID: Integer): String;
var
  MachinesIni: TMemIniFile;
  iSystemStr, iMediaStr: String;
begin
  Result:= '';
  iSystemStr:= SystemsListCustom[CustomSystemID, 0];
  iMediaStr:= MediaTypeCustom[CustomMediaTypeID, 2];

  if FileExists(GetMAMEMachineCustomGames(idMAME)) then
     begin
       MachinesIni:= TMemIniFile.Create(GetMAMEMachineCustomGames(idMAME));
       Result:= MachinesIni.ReadString(iSystemStr, iMediaStr, '');
       FreeAndNil(MachinesIni);
     end;
end;

