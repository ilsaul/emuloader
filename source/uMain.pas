procedure TFormMain.FormActivate(Sender: TObject);
begin
  if TerminateEmuLoader then
     Exit;

  if not IsStartup then
     Exit;

  Font_TilesViewDetailsText.Color:= GetContrastColor(GamesListView.Color);
  SetMainToolBarIcon(ButtonViewMode);
  SetMainToolBarIcon(ButtonSystemsQuickFilter);
  ResetFavoriteSettings; // if selected filter is favorites then check TMenuItem and other settings
  SetMainToolBarIcon(ButtonArcadeGamesFilters);
  SetMainToolBarIcon(ButtonGameFilterParentClone);
  SetMainToolBarIcon(ButtonGameFilterHaveMiss);
  SetMainToolBarIcon(ButtonGameFilterDriverStatus);
  SetMainToolBarIcon(ButtonImageCue);

  GetGameDataListView(SelectedEasyItem);

  if FormMain.Tag = 1 then
     WindowState:= wsMaximized
  else
     begin
       if ((FormMain.Top = 0) and (FormMain.Left = 0)) then
          begin
            FormMain.Top:= (Screen.Height-FormMain.Height) div 2;
            FormMain.Left:= (Screen.Width-FormMain.Width) div 2;
          end;
     end;

  if MenuImageUseSingleBackgroundColor.Checked then
     MenuImageUseSingleBackgroundColor.OnClick(Self);
  if MenuShowImages.Tag = 0 then
     MenuShowImages.Click;

  //if MenuViewFullScreen.Tag = 1 then
  //   MenuViewFullScreen.Click; // no longer used (June 04, 2018)

  //if MenuShowImages.Tag = 0 then
  //   MenuShowImages.Click;

  //GetGameDataListView(SelectedEasyItem);

  LoadImgSoftwareListNames;

  SetThumbGridSize(ThumbnailSettings.Width, ThumbnailSettings.Height); // only set grid size, need to call ResetThumbnails below (thumbnails view only)

  if not IsDetailsView then
     begin
       PopupMenuViewMode.Items[ButtonViewMode.Tag].Click;
     end;

  // must set image layout after main form size is set to last used or layout splitter do not work correctly (April 12, 2018)
  if IsSingleImageLayout then
     SetImageCategoryButtonsVisible // this will set image category tool bar buttons visible/invisible
  else
     CallSelectImageLayout(ButtonScreenshotLayouts.Tag, False);

  if MenuShowImages.Checked then
     InitZippedImagesCache;

  if FormArcadeFiltersExtra.FilterGamesMainCPU.Tag = 1 then
     FormMain.InitFilterCPU_MAME;

  if ButtonFilterTitlePanelMode.Tag > 0 then
     begin
       ButtonFilterTitlePanelMode.Tag:= ButtonFilterTitlePanelMode.Tag-1;
       ButtonFilterTitlePanelMode.Click;
     end;

  if FormPreferences.RestoreInternetGameInfoStartup.Checked then
     if ButtonInternetGameInfo.Down then
        ButtonInternetGameInfo.Click; // re-enable Internet Game Info button

  IsStartup:= False; // code in FormMain.OnActivate should not execute anymore

  // need to set games view mode AFTER image view mode

  HideInitZipImageMsgBox;

  ELV_ResetNormalColors(GamesListView); // set games list selection bar colors to user custom colors
  ELV_ResetNormalColors(MachinesListSidePanel);

  if IsNightMode then
     SetPreferencesColors;

  SetGameType(False); // apply games filters
  
  if CheckSelected(GamesListView) then
     begin
       if FormStatus.Visible then
          FormStatus.MessageStr('Loading selected game details.');
       // fix for the selected game not loading MAMu_ icon
       GamesListView.BeginUpdate;
       Sleep(50); // a small delay to prevent memory leaks in thumbnails view with images panel enabled; only happens at startup
       if PopupEnableMAMu_Icons.Checked and (not IsThumbnailView) then
          begin
            TEasyGameInfo(SelectedEasyItem).eIconLoaded:= False;
            TEasyGameInfo(SelectedEasyItem).Initialized:= False;
          end;
       GamesListView.EndUpdate(False);

       //GamesListView.Scrollbars.OffsetX:= 0;
       Application.ProcessMessages;

       //SetSelectedGame(True); // reload selected game info, just to make sure... no need for this as it's called in SetGameType(False) above (April 25, 2018)
     end;

  UpdateStatusBarGame; // to clear icons and labels
  UpdateStatusBarMachine; // to clear icons and labels

  PopupEnableFavorites.Hint:= FavoriteProfile[0];

  if (buildMAME = '') and (EmulatorFile[idMAME] <> '') then
     buildMAME:= GetMAMEBinaryVersion(EmulatorFile[idMAME]);

  if (buildHBMAME = '') and (EmulatorFile[idHBMAME] <> '') then
     buildHBMAME:= GetMAMEBinaryVersion(EmulatorFile[idHBMAME]);

  if (buildAlterMAME[1] = '') and (AlterMAMEFile[1] <> '') then
     buildAlterMAME[1]:= GetMAMEBinaryVersion(AlterMAMEFile[1]);

  if (buildAlterMAME[2] = '') and (AlterMAMEFile[2] <> '') then
     buildAlterMAME[2]:= GetMAMEBinaryVersion(AlterMAMEFile[2]);

  AlterMAME_ValidateMAME;

  FormStatus.Close;
  Application.ProcessMessages;
  FormMain.SetFocus;
  FocusGamesList;
  if IsThumbnailView then
     ResetThumbnails; // reset thumbs here or they might not show at startup
end;

procedure TFormMain.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
var
  Loop, Loop2: Integer;
begin
  ShowFilterMsgBox('Exit Frontend', 'Updating config files and freeing resources.', True);
  VideoPreviewPlayDummy(True);
  // free any created vars, arrays, etc
  FreeAndNil(FDrawBuffer);
  FreeAndNil(FDrawBufferBottom);
  FreeAndNil(ControlType);

  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // flush images threads cache (opened/pending threads)

  ZipForge.CloseArchive; // make sure there are no .zip files opened
  ZipForge.FileName:= '';

  ClearScreenshots;

  if not TerminateEmuLoader then
     begin
       WriteLightModeSettings;
       WriteSplashSettings;
       UpdateExtraIni;
       UpdateIniFile;

       if FileExists(GetSysEmulators) then
          UpdateCustomEmulatorsInfo(False); // update emulator to use, param index, never update emulators filenames here

       if not PanelMachinesList.Visible then
          UpdateColumnProfile
       else
          begin
            GamesListView.BeginUpdate;
            FilterMachineType.MAMEMachinesFilterPanel_Enabled:= False;
            ToggleMachinesListSidePanel; // will update columns when machines list is enabled
            GamesListView.EndUpdate(False);
          end;
       if IsNightMode then
          WriteNightModeSettings;
     end;

  DeInitEmulatorVariables;

  for Loop:=1 to MaxConsoleComputerSystems do
  begin
    for Loop2:= Low(MediaTypeCustom) to High(MediaTypeCustom) do
        FreeAndNil(sysCustomFolders[Loop, Loop2]);
    FreeAndNil(Font_ConsoleComputer[Loop]);
  end;

  if not TerminateEmuLoader then
     begin
       if Assigned(FormImageLayoutDimensions) then
          FormImageLayoutDimensions.Close;

       if not ButtonInternetGameInfo.Down then // web mode save current image layout settings before enabled
          begin
            if MenuShowImages.Checked then
               UpdateScreenshotLayout(ButtonScreenshotLayouts.Tag); // save current multiple layout, if images is enabled
          end;
     end;

  // games list must be cleared here, not above or below, or frontend crashes in thumbnails view (November 20, 2016)
  FormMain.ClearMemGameInfo(MemGameInfo);
  FormMain.ClearMemGameInfo(TempGameVars);

  ClearListView(GamesListView);
  ClearListView(MachinesListSidePanel);

  InitImgZipLists(True);
  InitImgSoftwareNameZipLists(True);
  InitImgSoftwareNameZipLists_SL(True);

  FreeImageZipVars;
  FreeMAMu_ZipVars;

  DestroyImageLayoutControls;

  if PopupAutomaticGameInformation.Checked then
     PopupAutomaticGameInformation.Click;

  if not ValidateFile(GetColumnProfile) then
     DeleteFile(GetColumnProfile);

  FreeAndNil(Font_Parent);
  FreeAndNil(Font_Clone);
  FreeAndNil(Font_Preliminary);
  FreeAndNil(Font_MissingROMs);
  FreeAndNil(Font_MissingROMsPreliminary);

  FreeAndNil(Font_TilesViewDetailsText);

  FreeAndNil(FormArcadeFiltersExtra);
  FreeAndNil(FormArcadeFiltersDriverStatus);
  //FreeAndNil(FormNightMode);

  FreeAndNil(FormStatus);

  HideFilterMsgBox;
  FreeAndNil(FormApplyFilterMsgBox);
end;

