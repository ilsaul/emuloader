procedure TFormMain.CycleImageLayout(MoveForward: Boolean);
var
  LayoutEnabled: Boolean;
  Index: ShortInt;
begin
  if not IsImageLayoutView then
     Exit;
     
  Index:= ButtonScreenshotLayouts.Tag;
  repeat
    case MoveForward of
      True:
        begin
          Inc(Index);
          if Index > 8 then
             Index:= 0;
        end;
      False:
        begin
          Dec(Index);
          if Index < 0 then
             Index:= 8;
        end;
    end;
    LayoutEnabled:= PopupScreenshotLayouts.Items[Index].Visible;
    if LayoutEnabled then
       PopupScreenshotLayouts.Items[Index].Click;
  until LayoutEnabled;
end;

