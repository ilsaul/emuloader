procedure TFormMain.UpdateScreenshotsPanel;
begin
  case MenuShowImages.Checked of
    True:
      begin
        case PanelGameDocuments.Visible of
          True:
            begin
              SplitterMAMEInfo.Visible:= True;
              PanelGameDocuments.Visible:= True;
              SetLayoutGameDocuments;
            end;
          False:
            begin
              if not PanelScreenshotsArea.Visible then
                 PanelScreenshotsArea.Visible:= True;
              if not Splitter.Visible then
                 Splitter.Visible:= True;
            end;
        end;
        if not PanelImage.Visible then
           PanelImage.Visible:= True;
        if ButtonImageCategory.Tag < High(ImageCategoryArray) then
           if not PanelImagesDocuments.Visible then
              PanelImagesDocuments.Visible:= True;
      end;
    False:
      begin
        case PanelGameDocuments.Visible of
          True:
            begin
              PanelImage.Visible:= False;
              SplitterMAMEInfo.Visible:= False;
              PanelGameDocuments.Align:= alClient;
              MAMEInfoTextHolder.Refresh;
              if not PanelScreenshotsArea.Visible then
                 PanelScreenshotsArea.Visible:= True;
              if not Splitter.Visible then
                 Splitter.Visible:= True;
            end;
          False:
            begin
              Splitter.Visible:= False;
              PanelScreenshotsArea.Visible:= False;
            end;
        end;
      end;
  end;
end;

procedure TFormMain.ToggleGameDocuments(Enabled: Boolean);
var
  pathFile, emuPath, ValueStr: String;
  emuDATPaths, mameIni: THashedStringList;
  Loop: Integer;

  function LocateDATFile(const DATFileName: String): String;
  var
    fLoop: Integer;
  begin
    Result:= '';
    for fLoop:=0 to emuDATPaths.Count -1 do
    begin
      if emuDATPaths[fLoop] <> '.' then
         begin
           if FileExists(emuDATPaths[fLoop]+DATFileName) then
           begin
             Result:= emuDATPaths[fLoop]+DATFileName;
             Break;
           end;
         end;
    end;
    if Result = '' then
       Result:= emupath+DATFileName;
  end;

  function LoadDAT(var StringListHolder: THashedStringList; MergeFileContents: Boolean = False): Boolean;
  var
    tmpFile: THashedStringList;
  begin
    Result:= pathFile <> '';
    if Result then
       Result:= FileExists(pathFile);

    if Result then
       begin
         if not Assigned(StringListHolder) then
            StringListHolder:= THashedStringList.Create;
         case MergeFileContents of
           True:
             begin
               tmpFile:= THashedStringList.Create;
               tmpFile.LoadFromFile(pathFile);
               if tmpFile.Count > 0 then
               begin
                 StringListHolder.BeginUpdate;
                 StringListHolder.AddStrings(tmpFile);
                 StringListHolder.EndUpdate;
               end;
               FreeAndNil(tmpFile);
             end;
           False: StringListHolder.LoadFromFile(pathFile);
         end;
       end;
  end;

begin
  ResetGameDocsQuickMenus;

  case Enabled of
    True:
      begin
        emuPath:= ExtractFilePath(EmulatorFile[idMAME]);
        if FileExists(emuPath+'ui.ini') then
        begin
          mameIni:= THashedStringList.Create;
          mameIni.LoadFromFile(emuPath+'ui.ini');
          for Loop:=0 to mameIni.Count-1 do
          begin
            if XML_CheckData(mameIni[Loop], 'historypath ') then
            begin
              ValueStr:= ExtractMAMEIniValue(mameIni[Loop]);
              Break;
            end;
          end;
          FreeAndNil(mameIni);
          if ValueStr = '' then
             ValueStr:= 'dats';
          ExtractFolders2MAME(idMAME, ValueStr, emuDATPaths);
        end;

        if emuDATPaths = nil then
           begin
             emuDATPaths:= THashedStringList.Create;
             emuDATPaths.Insert(0, emuPath);
           end;

        pathFile:= LocateDATFile('mameinfo.dat');
        LoadDAT(AutoMAMEInfoDATFile);

        pathFile:= LocateDATFile('messinfo.dat');
        LoadDAT(AutoMAMEInfoDATFile, True);

        pathFile:= LocateDATFile('history.dat');
        LoadDAT(AutoHistoryDATFile);

        pathFile:= LocateDATFile('story.dat');
        LoadDAT(AutoStoryDATFile);

        pathFile:= LocateDATFile('marp.dat');
        LoadDAT(AutoMarpDATFile);

        pathFile:= LocateDATFile('gameinit.dat');
        LoadDAT(AutoGameInitDATFile);

        FreeAndNil(emuDATPaths);
        PanelGameDocuments.Visible:= True;
        UpdateScreenshotsPanel;
      end;
    False:
      begin
        FreeAndNil(AutoMAMEInfoDATFile);
        FreeAndNil(AutoHistoryDATFile);
        FreeAndNil(AutoStoryDATFile);
        FreeAndNil(AutoMarpDATFile);
        FreeAndNil(AutoGameInitDATFile);

        GameDocsGoToInformation.Visible:= False;
        GameDocsGoToHistory.Visible:= False;
        GameDocsGoToDriverInfo.Visible:= False;
        GameDocsGoToStory.Visible:= False;
        GameDocsGoToMarp.Visible:= False;
        GameDocsGoToGameInit.Visible:= False;

        MAMEInfoTextHolder.Lines.Clear;
        SplitterMAMEInfo.Visible:= False;
        PanelGameDocuments.Visible:= False;
        if PanelGameDocuments.Align = alClient then
           begin
             PanelGameDocuments.Align:= alTop;
             if PanelGameDocuments.Tag <> 1 then
                PanelGameDocuments.Height:= PanelGameDocuments.Tag
             else
                PanelGameDocuments.Height:= 151;
           end;
        UpdateScreenshotsPanel;
      end;
  end;
end;

