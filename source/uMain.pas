procedure TFormMain.MenuViewFullScreenClick(Sender: TObject);
begin
  Separator_FullScreen.Visible:= MenuViewFullScreen.Checked;
  PopupReturnToWindowMode.Visible:= MenuViewFullScreen.Checked;
  PopupExitApplication.Visible:= MenuViewFullScreen.Checked;

  case MenuViewFullScreen.Checked of
    True:
      begin
        PopupMainMenu.Visible:= True;
        MenuViewFullScreen.Tag:= Ord(FormMain.WindowState = wsMaximized);
        if FormMain.WindowState = wsMaximized then
           FormMain.WindowState:= wsNormal;
        FormMainWidth:= FormMain.Width;
        FormMainHeight:= FormMain.Height;
        FormMainTop:= FormMain.Top;
        FormMainLeft:= FormMain.Left;
        if ToolBarButtons.Tag = 1 then
           PanelToolBar.Visible:= False; // ToolBarButtons.Visible:= False;
        if StatusBarPanel.Visible then
           StatusBarPanel.Visible:= False;

        SetWindowLong(FormMain.Handle, GWL_STYLE, GetWindowLong(FormMain.Handle, GWL_STYLE) and not WS_CAPTION);
        SetWindowPos(FormMain.Handle, HWND_TOP, 0, 0, GetSystemMetrics(SM_CXSCREEN),
                     GetSystemMetrics(SM_CYSCREEN), SWP_SHOWWINDOW or SWP_NOACTIVATE);

        SetForegroundWindow(FormMain.Handle); //SetForegroundWindow(Application.Handle); // this was not in the original function (October 11, 2015)

        SetActiveWindow(Application.Handle);
      end;
    False:
      begin
        PopupMainMenu.Visible:= not MenuEnableToolBar.Checked;
        SetWindowLong(FormMain.Handle, GWL_STYLE, GetWindowLong(FormMain.Handle, GWL_STYLE) or WS_CAPTION);
        SetWindowPos(FormMain.Handle, HWND_TOP, 0, 0, GetSystemMetrics(SM_CXSCREEN),
                     GetSystemMetrics(SM_CYSCREEN), SWP_SHOWWINDOW or SWP_NOACTIVATE);

        SetForegroundWindow(FormMain.Handle); //SetForegroundWindow(Application.Handle); // this was not in the original function (October 11, 2015)
        SetActiveWindow(Application.Handle);
        LockWindowUpdate(FormMain.Handle);
        FormMain.WindowState:= wsNormal;

        // Make the form normal
        MoveWindow(FormMain.Handle, FormMainLeft, FormMainTop, FormMainWidth, FormMainHeight, True);
        LockWindowUpdate(0);

        if ToolBarButtons.Tag = 1 then
           PanelToolBar.Visible:= True ; // ToolBarButtons.Visible:= True;
        if (not StatusBarPanel.Visible) and MenuShowGamesStatusBar.Checked then
           StatusBarPanel.Visible:= True;
        if MenuViewFullScreen.Tag = 1 then
           FormMain.WindowState:= wsMaximized;
      end;
  end;

  if IsStartup then
     Exit;
  Application.BringToFront;
  Application.ProcessMessages;
  FormMain.BringToFront;
  FormMain.Refresh;
  ELV_MakeVisible;
  FocusGamesList;
end;

