  SetCustomColorValue(FormStatus.SplashScreenProgressBarColorBarTop,     'ProgressBarCustomBarTop');
  SetCustomColorValue(FormStatus.SplashScreenProgressBarColorBarDown,    'ProgressBarCustomBarDown');

