procedure TFormMain.InitImgZipLists(FreeLists: Boolean = False);
var
  sysLoop: Integer;
begin
  // arcade systems
  for sysLoop:=1 to MaxArcadeSystems do
      InitImgZipSystem(sysLoop, FreeLists);

  // console/computer/handheld systems (EmuCon)
  for sysLoop:=1 to MaxConsoleComputerSystems do
      InitImgZipSystemConsComp(sysLoop, FreeLists);
end;

procedure TFormMain.InitImgZipSystem(sysID: Integer; FreeList: Boolean = False);
var
  imgLoop: Integer;
begin
  case FreeList of
    True:
      begin
        for imgLoop:=Low(imgZipFileList[sysID]) to High(imgZipFileList[sysID]) do
            FreeAndNil(imgZipFileList[sysID, imgLoop]);
      end;
    False:
      begin
        if ImageDetails[1].ImageCategoryIndex_AllSystems <> -1 then
           ImgZipParseFilesList(sysID, ImageDetails[1].ImageCategoryIndex_AllSystems);
        for imgLoop:=2 to MaxImagePanels do
        begin
          if Assigned(ImageScr[imgLoop]) then
             begin
               if ImageDetails[imgLoop].ImageCategoryIndex_AllSystems <> -1 then
                  ImgZipParseFilesList(sysID, ImageDetails[imgLoop].ImageCategoryIndex_AllSystems);
             end;
        end;
      end;
  end;
end;

procedure TFormMain.ImgZipParseFilesList(sysID, imageCategoryID: Integer);
var
  imgFile: String;
  ArchiveItem: TZFArchiveItem;
  tResult: Boolean;
begin
  if (not IsSystemAvailable(sysID)) or (imgFolder[sysID, imageCategoryID] = '') then
     begin
       FreeAndNil(imgZipFileList[sysID, imageCategoryID]);
       Exit;
     end;
  if ZipForge.Active then
     begin
       CallMessageBox;
       AddMsgText('    Unable to open ');
       AddMsgText(GetImgZipFileName(imageCategoryID), MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' file as there is another .zip file already opened.');
       GenerateMessage('Error! ImgZipParseFilesList()', GetArcadeEmulatorDescription(sysID, True));
       Exit;
     end;

  imgFile:= GetFolderFull(imageCategoryID, sysID)+GetImgZipFileName(imageCategoryID);
  tResult:= FileExists(imgFile);
  if not tResult then
     begin
       FreeAndNil(imgZipFileList[sysID, imageCategoryID]);
       Exit;
     end;

  if PanelInitZipFile.Visible then
     begin
       if InitZipSystemIcon.Tag <> sysID then
          begin
            LoadIconIntoImage(GetArcadeSystemIconFileName(sysID, ''), InitZipSystemIcon);
            InitZipSystemIcon.Tag:= sysID;
          end;
       LabelInitZipSystemTitle.Caption:= GetArcadeEmulatorDescription(sysID, True);
       LabelInitZipImageCategory.Caption:= GetImageCategoryTitle(imageCategoryID);
       LabelInitZipFile.Caption:= 'Parsing "'+GetImgZipFileName(imageCategoryID)+LabelInitZipFile.Hint;
       Application.ProcessMessages;
       //Sleep(2000); // for debugging only, do not enable
     end;
  
  case Assigned(imgZipFileList[sysID, imageCategoryID]) of
    True : imgZipFileList[sysID, imageCategoryID].Clear;
    False: imgZipFileList[sysID, imageCategoryID]:= THashedStringList.Create;
  end;
  imgZipFileList[sysID, imageCategoryID].BeginUpdate;

  with ZipForge do
  begin
    FileName:= imgFile;
    // Open existing archive file
    try
      OpenArchive(fmOpenRead or fmShareDenyNone);
      if FileCount > 0 then
         begin
           // Search text files stored inside the archive
           if FindFirst('*.*', ArchiveItem) then
              begin
                repeat
                  if (not ArchiveItem.ExternalFileAttributes and $10 = $10) then // do not add folders into the list
                     imgZipFileList[sysID, imageCategoryID].Add(LowerCase(ArchiveItem.StoredPath+ArchiveItem.FileName));
                until (not FindNext(ArchiveItem));                        // "StoredPath" is for "softwarename\gamename" file format
              end;
         end;
    except
      CloseArchive;
      FileName:= '';
      FreeAndNil(imgZipFileList[sysID, imageCategoryID]);
      Exit;
    end;
  end;
  imgZipFileList[sysID, imageCategoryID].EndUpdate;
  ZipForge.CloseArchive;
  ZipForge.FileName:= '';
  // for debugging only... leave it commented
  //if (sysID = idMAME) and (imageCategoryID = 1) then
  //   imgZipFileList[sysID, imageCategoryID].SaveToFile(FrontendPath+'snap-zip_contents.txt');
end;

// for software lists: "snap\msx1_cart.zip"; instead of having "msx1_cart\gamename.png" inside the main "snap.zip"
//              added: "snap\msx1_cart\msx1_cart.zip" support (February 12, 2018)

function TFormMain.LoadImgSoftwareListNames: Boolean;
var
  SoftLists: THashedStringList;
begin
  Result:= False;
  case Assigned(imgSoftwareNameZipList) of
    True:
      begin
        if imgSoftwareNameZipList.Count > 0 then
           begin
             Result:= True;
             Exit;
           end;
      end;
    False: imgSoftwareNameZipList:= THashedStringList.Create;
  end;

  SoftLists:= THashedStringList.Create;
  if not GetSoftListFilesToAudit(idMAME, SoftLists) then
     begin
       FreeAndNil(SoftLists);
       FreeAndNil(imgSoftwareNameZipList);
       Exit;
     end;
  imgSoftwareNameZipList.AddStrings(SoftLists);
  FreeAndNil(SoftLists);
  SetLength(imgZipFileSoftList, imgSoftwareNameZipList.Count);
  Result:= True;
end;

procedure TFormMain.InitImgSoftwareNameZipLists(FreeLists: Boolean = False);
var
  Loop: Integer;
  ExcludedList: THashedStringList;
begin
  case FreeLists of
    True:
      begin
        for Loop:= Low(imgZipFileSoftList) to High(imgZipFileSoftList) do
            InitImgSoftwareNameZipSystem(idMAME, Loop, imgSoftwareNameZipList[Loop], True);

        SetLength(imgZipFileSoftList, 0); // set the array size to zero
        FreeAndNil(imgSoftwareNameZipList);
      end;
    False:
      begin
        if not LoadImgSoftwareListNames then
           Exit;

        ExcludedList:= THashedStringList.Create;
        SoftListGetExcludedList(idMAME, ExcludedList);
        if ExcludedList.Count = 0 then
           FreeAndNil(ExcludedList);

        if PanelInitZipFile.Visible then
           InitZipSystemIcon.Tag:= -1;

        for Loop:=0 to imgSoftwareNameZipList.Count-1 do
        begin
          case Assigned(ExcludedList) of
            True:
              begin
                if ExcludedList.IndexOf(imgSoftwareNameZipList[Loop]) = -1 then
                   InitImgSoftwareNameZipSystem(idMAME, Loop, imgSoftwareNameZipList[Loop]);
              end;
            False: InitImgSoftwareNameZipSystem(idMAME, Loop, imgSoftwareNameZipList[Loop]);
          end;
        end;
        FreeAndNil(ExcludedList);
      end;
  end;
end;

procedure TFormMain.InitImgSoftwareNameZipSystem(sysID, SoftwareNameIndex: Integer; const SoftwareName: String; FreeList: Boolean = False);
var
  imgLoop: Integer;
begin
  case FreeList of
    True:
      begin
        for imgLoop:=Low(imgZipFileSoftList[SoftwareNameIndex]) to High(imgZipFileList[SoftwareNameIndex]) do
