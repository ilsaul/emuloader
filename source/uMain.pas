procedure TFormMain.GamesListViewThreadCallBack(
  Sender: TCustomEasyListview; Msg: TWMThreadRequest);
var
  Request: TMyThreadRequest;
  Item: TEasyGameInfo;
begin
  // Unpack the Request from the Structure
  Request:= TMyThreadRequest(Msg.Request);
  Item:= TEasyGameInfo(Request.Item);
  // Is it a Thumbnail Request?
  case Request.ID of
    1: // thumbs
     begin
       case IsThumbnailView of
         True:
           begin
             if not Request.Image.Empty then
                begin
                  Item.eThumbnail:= TPNGGraphic.Create;
                  Item.eThumbNail.Assign(Request.Image);
                  if Item.eThumbNail.Width <= Item.eThumbNail.Height then
                     begin
                       Item.eThumbnailLeftMargin:= (Request.Width - Item.eThumbnail.Width) div 2;
                       if Item.eThumbnail.Height >= GamesListView.CellSizes.Thumbnail.Height then
                          Item.eThumbnailTopMargin:= 0
                       else
                          Item.eThumbnailTopMargin:= (Request.Height - Item.eThumbnail.Height) div 2;
                     end
                  else
                     begin
                       if Item.eThumbnail.Width >= GamesListView.CellSizes.Thumbnail.Width then
                          Item.eThumbnailLeftMargin:= 0
                       else
                          Item.eThumbnailLeftMargin:= (Request.Width - Item.eThumbnail.Width) div 2;

                       Item.eThumbnailTopMargin:= (Request.Height - Item.eThumbnail.Height) div 2;
                     end;
                  Item.eThumbnailLoaded:= True;
                  Item.eThumbnailFileName:= Request.FileName;
                  Item.Invalidate(True); // Redraw it
                end;
           end;
         False:
           begin
             // why these are here ???
             Item.eThumbnailLoaded:= False;
             Item.eThumbnailIsZipped:= False;
             Item.eThumbnailFileName:= Request.FileName;
           end;
       end;
     end;
  end;
  Request.Release;
end;

