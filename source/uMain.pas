    PopupThumbnailShowParentThumbs.Checked:= MenuThumbnailShowParentThumbs.Checked;
    GamesListView.PaintInfoItem.HideCaption:= not Boolean(INIFile.ReadInteger('Thumbnails', 'ShowTitle', 1));

    ThumbnailSettings.MaintainAspectRatio:= Boolean(INIFile.ReadInteger('Thumbnails', 'MaintainAspectRatio', 1));

    ThumbnailSettings.ShowSystemIcon:= Boolean(INIFile.ReadInteger('Thumbnails', 'SystemIconVisible', 1));
    ThumbnailSettings.SystemIconSize:= INIFile.ReadInteger('Thumbnails', 'SystemIconSize', 1);

    ThumbnailSettings.ShowGameIcon:= Boolean(INIFile.ReadInteger('Thumbnails', 'GameIconVisible', 1));
    ThumbnailSettings.ShowFavoriteIcon:= Boolean(INIFile.ReadInteger('Thumbnails', 'FavoriteIconVisible', 1));

    ThumbnailSettings.LeftAlignIcons:= Boolean(INIFile.ReadInteger('Thumbnails', 'LeftAlignIcons', 1));

    PopupGameIconSize.Tag:= INIFile.ReadInteger('Preferences', 'GameIconSize', 2);
    case PopupGameIconSize.Tag of
      0: PopupIconSizeExtraLarge.Click;
      1: PopupIconSizeLarge.Click;
      3: PopupIconSizeSmall.Click;
    end;

    PopupTilesViewGameIconsSize.Tag:= INIFile.ReadInteger('Preferences', 'TilesViewCellSize', 3);

    if PopupTilesViewGameIconsSize.Tag <> 3 then
       PopupTilesViewGameIconsSize.Items[PopupTilesViewGameIconsSize.Tag].Click;

    // columns settings
    ReadColumnProfile;

    // IsCustomGame IsUnicode GameName
    //      1           2        4...n
    tmpString:= INIFile.ReadString('Selected', 'LastSelected', '');
    if tmpString <> '' then
       begin
         if tmpString[1] = '0' then
            SelectedGameIsCustom:= False
         else
            SelectedGameIsCustom:= True;

         //SelectedGameIsCustom:= Boolean(Ord(tmpString[1]));
         SelectedGameName:= tmpString;
         Delete(SelectedGameName, 1, 3);
         if tmpString[2] = '1' then
            SelectedGameName:= DecodeUnicodeStr(SelectedGameName);
       end;

    //SelectedGameName:= INIFile.ReadString('Selected', 'LastSelected', '');
    SelectedGameSysID:= INIFile.ReadInteger('Selected', 'LastSelectedSysID', -1);
    //SelectedGameIsCustom:= Boolean(INIFile.ReadInteger('Selected', 'LastSelectedIsCustomGame', 0));
    SelectedGameSoftwareName:= INIFile.ReadString('Selected', 'LastSelectedSoftwareName', '');

    PopupStartupGameSelectionGameSelected.Tag:= INIFile.ReadInteger('SelectGameStartup', 'SystemID', -1);

    if PopupStartupGameSelectionGameSelected.Tag <> -1 then
       begin
         SelectGameStartup.SystemID:= PopupStartupGameSelectionGameSelected.Tag;
         SelectGameStartup.ROMIdentification:= INIFile.ReadInteger('SelectGameStartup', 'ROMIdentification', -1); // this is for arcade games only

         tmpString:= INIFile.ReadString('SelectGameStartup', 'GameTitle', '');
         SelectGameStartup.Title:= tmpString;
         Delete(SelectGameStartup.Title, 1, 2);
         if tmpString[1] = '1' then
            SelectGameStartup.Title:= DecodeUnicodeStr(SelectGameStartup.Title);

         tmpString:= INIFile.ReadString('SelectGameStartup', 'GameName', '');
         if tmpString[1] = '0' then
            SelectGameStartup.IsCustomGame:= False
         else
            SelectGameStartup.IsCustomGame:= True;
         SelectGameStartup.GameName:= tmpString;
         Delete(SelectGameStartup.GameName, 1, 3);
         if tmpString[2] = '1' then
            SelectGameStartup.GameName:= DecodeUnicodeStr(SelectGameStartup.GameName);

         SelectGameStartup.SoftwareName:= INIFile.ReadString('SelectGameStartup', 'SoftwareName', '');

         case SelectGameStartup.IsCustomGame of
           True : PopupStartupGameSelectionGameSelected.ImageIndex:= MaxGameID+SelectGameStartup.SystemID;
           False: PopupStartupGameSelectionGameSelected.ImageIndex:= GetMAMEImageIndex(SelectGameStartup.ROMIdentification, SelectGameStartup.SoftwareName);
         end;

         SelectGameStartup.GameNameDetails:= INIFile.ReadString('SelectGameStartup', 'GameNameDetails', '');

         PopupStartupGameSelectionGameSelected.Caption:= SelectGameStartup.Title;
       end;

    PopupSelectScanGamesMode.Tag:= INIFile.ReadInteger('Preferences', 'ScanGamesMode', 0); // 0 -> full; 1 -> simple; 2 -> set all available
    SetScanModePopupHint(PopupSelectScanGamesMode.Tag);

    MenuCreateMAMESoftwareListGames.Tag:= INIFile.ReadInteger('Preferences', 'CreateMAMESoftwareListGames', 1); // 0 -> don't create softlists; 1 -> create softlist games
    MenuCreateMAMESoftwareListGames.HelpContext:= INIFile.ReadInteger('Preferences', 'ScanSetsModeMAME', 0); // 0 -> all sets; 1 -> arcade/machines only; 2 -> soflist games only

    MenuAddMAMEDeviceSetsWithNoROMs.Tag:= INIFile.ReadInteger('Preferences', 'AddMAMEDeviceSetsWithNoROMs', 0);

    MenuShowPlayersInfoFromNplayersIniOnly.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'PlayersInfoFromIniOnly', 0));

    NewTitleFormat.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'NewTitleFormat', 0));
    MenuGameTitleExtraInfo.Tag:= INIFile.ReadInteger('Preferences', 'TitleRemoveExtraText', 0);
    if MenuGameTitleExtraInfo.Tag > 0 then
       MenuGameTitleExtraInfo.Items[MenuGameTitleExtraInfo.Tag].Checked:= True;

    MenuShowGamesStatusBar.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'ShowGamesStatusBar', 1));
    if not MenuShowGamesStatusBar.Checked then
       StatusBarPanel.Visible:= False;

    PopupAutoRunGameAlterMAME.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'AutoRunArcadeMAMEWithAlterMAME', 0));

    PopupEnableAutoRunCustomGamesWithMAME.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'EnableAutoRunConsoleComputerGamesWithMAME', 0));
    with FormPreferences do
    begin
      DisableMinimize.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'DisableMinimize', 0));
      AllowOnlyOneInstance.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'AllowOneInstance', 1));

      IgnoreExitCode1InvalidFunction.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'IgnoreExitCode1InvalidFunction', 1));

      DisableDeleteSelectedGames.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'DisableDeleteSelectedGames', 0));

      // "Games List" main menu
      MenuIncrementalSearch.Tag:= INIFile.ReadInteger('Preferences', 'IncrementalSearch', 0);
      MenuIncrementalSearch.Items[MenuIncrementalSearch.Tag].Checked:= True;

      // Miscellaneous
      MenuViewEmulatorFullCommandLine.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'ShowEmulatorFullCommandLine', 1));

      SplitterGripIcon.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'ShowSplitterGrip', 1));
      //SplitterGripIcon.OnClick(Self);
      FormPreferences.SplitterSingleColor.Selected:= INIFile.ReadInteger('Preferences', 'SplitterSingleColor', FormPreferences.SplitterSingleColor.DefaultColorColor);
      FormPreferences.SplitterSingleColorHot.Selected:= INIFile.ReadInteger('Preferences', 'SplitterSingleColorHot', FormPreferences.SplitterSingleColorHot.DefaultColorColor);
      SetSelectedComboBox(INIFile.ReadInteger('Preferences', 'SplitterStyle', 6), FormPreferences.SplitterStyleSelector);

      // General Folders
      // Emu Loader Folders & Zip Files
      //FolderGamesFAQ.Text:= INIFile.ReadString('Folders', 'GamesFAQ', '');
      //FolderPCBInfo.Text:= INIFile.ReadString('Folders', 'PCBInfo', '');

      FormPreferences.InternetGameInfoLink.Text:= INIFile.ReadString('Preferences', 'InternetGameInfoLink', 'http://www.progettoemma.net/gioco.php?game=%s');
      FormPreferences.InternetMAMESoftwareListGameInfoLink.Text:= INIFile.ReadString('Preferences', 'InternetGameSoftwareListInfoLink', 'http://www.progettoemma.net/mess/gioco.php?game=%s&list=%s');
    end;

    // Machines List Side Panel
    SelectedMachineListName:= INIFile.ReadString('MachinesList_SidePanel', 'LastSelectedMachine', '');
    PanelMachinesList.Width:= INIFile.ReadInteger('MachinesList_SidePanel', 'PanelSize', 230);
    PopupMachinesListSidePanelFiltersHaveMiss.Tag:= INIFile.ReadInteger('MachinesList_SidePanel', 'Filter_HaveMiss', 0);
    PopupMachinesListSidePanelFiltersDriver.Tag:= INIFile.ReadInteger('MachinesList_SidePanel', 'Filter_DriverStatus', 0);
    PopupMachinesListSidePanelFiltersSaveState.Tag:= INIFile.ReadInteger('MachinesList_SidePanel', 'Filter_SaveState', 0);
    // set tool bar buttons checked menu items
    PopupMachinesListSidePanelFiltersHaveMiss.Items[PopupMachinesListSidePanelFiltersHaveMiss.Tag].Checked:= True;
    PopupMachinesListSidePanelFiltersDriver.Items[PopupMachinesListSidePanelFiltersDriver.Tag].Checked:= True;
    PopupMachinesListSidePanelFiltersSaveState.Items[PopupMachinesListSidePanelFiltersSaveState.Tag].Checked:= True;

    // read column width for machines list side panel EasyListView (not main games list)
    MachinesListSidePanel.BeginUpdate;
    for Loop:=0 to MachinesListSidePanel.Header.Columns.Count-1 do
        MachinesListSidePanel.Header.Columns[Loop].Width:= INIFile.ReadInteger('MachinesList_SidePanel', aColumnsMachinesList[Loop], aColumnsWidthMachinesList[Loop]);
    MachinesListSidePanel.EndUpdate;


    PopupMachinesListSidePanelIconSize.Tag:= INIFile.ReadInteger('MachinesList_SidePanel', 'GameIconSize', 3);
    case PopupMachinesListSidePanelIconSize.Tag of
      0: PopupMachinesListSidePanelExtraLarge48x48.Click;
      1: PopupMachinesListSidePanelLarge32x32.Click;
      2: PopupMachinesListSidePanelStandard242x4.Click;
    end;

    // set image type settings
    for Loop:=Low(ImageCategoryArray) to High(ImageCategoryArray) do
    begin
      if Loop < High(ImageCategoryArray) then
         PopupMenuImageCategories.Items[Loop].Tag:= INIFile.ReadInteger('Images', ImageCategoryArray[Loop, 1]+'_bkcolor', 0);
      if Loop <> 1 then
         PopupMenuImageCategories.Items[Loop].Visible:= Boolean(INIFile.ReadInteger('Images', ImageCategoryArray[Loop, 1]+'_enabled', 1));
    end;

    for Loop:=0 to 8 do
    begin
      if Loop > 0 then
         begin
           tmpString:= INIFile.ReadString('Images_Layout', 'layout'+IntToStr(Loop)+'_visible', '1');
           if PopupScreenshotLayouts.Items[Loop].Visible <> Boolean(StrToInt(tmpString)) then
              PopupScreenshotLayouts.Items[Loop].Visible:= Boolean(StrToInt(tmpString));
         end;
    end;

    FormPreferences.ImagePanelOuterFrameColor.Selected:= INIFile.ReadInteger('Images', 'PanelOuterFrameColor', 0);
    PanelImage.Color:= FormPreferences.ImagePanelOuterFrameColor.Selected;

    Loop:= INIFile.ReadInteger('Images', 'ImageResampler', 2);
    if Loop <> 2 then
       begin
         if Loop <> 0 then
            MenuImageResampler.Items[Loop-1].Click
         else
            MenuImageFilterOff.Click;
       end
    else
       MenuImageResampler.Tag:= Loop;

    // images classic view mode
    ButtonImageCategory.Tag:= INIFile.ReadInteger('Images', 'CategoryIndex', 1);
    SelectImageMenu(PopupMenuImageCategories.Items[ButtonImageCategory.Tag]);

    // images layouts view mode (multi-screenshots)
    ButtonScreenshotLayouts.Tag:= INIFile.ReadInteger('Images', 'LayoutIndex', 0);
    // MenuImageCategoryLayoutSettings.Tag:= INIFile.ReadInteger('Images', 'LayoutIndex', 0); // original code!!!!!!!!
    PopupImageShowLayoutDimensions.Checked:= Boolean(INIFile.ReadInteger('Images', 'ShowLayoutDimensions', 0));

    FormPreferences.ImageLayoutSplitterSingleColor.Selected:= INIFile.ReadInteger('Images', 'SplitterSingleColor', FormPreferences.ImageLayoutSplitterSingleColor.DefaultColorColor);
    FormPreferences.ImageLayoutSplitterSingleColorHot.Selected:= INIFile.ReadInteger('Images', 'SplitterSingleColorHot', FormPreferences.ImageLayoutSplitterSingleColorHot.DefaultColorColor);

    Loop:= INIFile.ReadInteger('Images', 'ViewMode', 0);
    case Loop of
      0:
        begin
          MenuImageViewMode.Tag:= Loop;
          ToggleImageViewMode;
        end;
      1:
        begin
          //MenuImageViewMode.Tag:= 1;
          MenuImageViewModeLayouts.Click;
        end;
    end;

    // need to set games view mode AFTER image view mode
    //if not IsDetailsView then
    //   PopupMenuViewMode.Items[ButtonViewMode.Tag].Click;

    PopupImageStretch.Tag:= INIFile.ReadInteger('Images', 'Stretch', 1);
    PopupImageStretchLarger.Tag:= INIFile.ReadInteger('Images', 'StretchLargerImages', 0);

    PopupDisplayGameSnapshotifGameArtworkNotFound.Checked:= Boolean(INIFile.ReadInteger('Images', 'DisplayGameSnapWhenNoArtwork', 0));
    MenuImageCategoryPrevNextAutoSwitch.Checked:= Boolean(INIFile.ReadInteger('Images', 'CategoryAutoCycle', 0));
    MenuImageLayoutPrevNextAutoSwitch.Checked:= Boolean(INIFile.ReadInteger('Images', 'LayoutAutoCycle', 0));

    PopupImageDisplayParent.Checked:= Boolean(INIFile.ReadInteger('Images', 'DisplayParent', 1));
    if PopupImageStretchLarger.Tag = 1 then
       PopupImageStretchLarger.Checked:= True;
    case PopupImageStretch.Tag of
      0: //False
        begin
          PopupImageStretch.Checked:= False;
          SetImageScaleMode;
        end;
      1: PopupImageStretch.Tag:= 0;
    end;
    if not Boolean(INIFile.ReadInteger('Images', 'ShowSplitterGrip', 1)) then
       PopupImageShowSplitterGrip.Click;
       
    MenuShowImages.Tag:= INIFile.ReadInteger('Images', 'ShowImages', 1);

    ButtonImageEnableThreads.Down:= Boolean(INIFile.ReadInteger('Images', 'EnableThreads', 1));

    MenuArcadeControlSlikStik_SwapStick.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'ArcadeSlikStik_Swap2ndStick', 0));
    MenuArcadeBrowseGames.Tag:= INIFile.ReadInteger('Preferences', 'BrowseGameWithArcadeControl', 0);
    //MenuArcadeControlPlayer1StickNumLockFixXArcade.Checked:= Boolean(INIFile.ReadInteger('Preferences', 'ArcadeX-Arcade_Stick1NumLockFix', 0));
    if MenuArcadeBrowseGames.Tag > 0 then
       MenuArcadeBrowseGames.Items[MenuArcadeBrowseGames.Tag].Click;

    PopupCustomMAME.Tag:= INIFile.ReadInteger('Preferences', 'MAMESettings_ValidateAllCustomFiles', 0);

    tmpString:= INIFile.ReadString('ToolBar', 'Buttons_Main', '');
    if tmpString = '' then
       begin
         for Loop:=0 to ToolBarButtons.ButtonCount-1 do
             tmpString:= tmpString+'1';
       end;
    for Loop:=0 to ToolBarButtons.ButtonCount-1 do
    begin
      if tmpString[Loop+1] <> '' then
         ToolBarButtons.Buttons[Loop].Visible:= Boolean(StrToInt(tmpString[Loop+1]))
      else
         ToolBarButtons.Buttons[Loop].Visible:= True;
    end;

    if not Boolean(INIFile.ReadInteger('ToolBar', 'Visible_TextBar', 1)) then
       ToolBarFilterTitle.Visible:= False;

    if not Boolean(INIFile.ReadInteger('ToolBar', 'Visible_MainBar', 1)) then
       MenuEnableToolBar.Click;

    if not Boolean(INIFile.ReadInteger('ToolBar', 'Visible_ImagesBar', 1)) then
       MenuImagesEnableToolBar.Click;
  finally
    FreeAndNil(INIFile);
  end;
end;

procedure TFormMain.UpdateIniFile;
var
  INIFile: TMemIniFile;
  Loop: Integer;
  tmpString: String;
  gColumn: TEasyColumn;
begin
  if not CheckReadOnly(FrontendPath+'EmuLoader.ini') then
  begin
    try
      DeleteFile(FrontendPath+'EmuLoader.ini');
      INIFile:= TMemIniFile.Create(FrontendPath+'EmuLoader.ini');
      //INIFile.Clear;

      INIFile.WriteInteger('Configuration', 'ViewMode', ButtonViewMode.Tag);
      tmpString:= 'Normal';
      case MenuViewFullScreen.Checked of
        True:
          begin
            if MenuViewFullScreen.Tag = 1 then
               tmpString:= 'Maximized';
          end;
        False:
          begin
            if FormMain.WindowState = wsMaximized then
               tmpString:= 'Maximized';
          end;
      end;
      INIFile.WriteString('Configuration', 'WindowState', tmpString);
      tmpString:= '';

      if ((FormMain.WindowState <> wsMaximized) and (not MenuViewFullScreen.Checked)) then
         begin
           INIFile.WriteInteger('Configuration', 'ScreenTop', FormMain.Top);
           INIFile.WriteInteger('Configuration', 'ScreenLeft', FormMain.Left);
           INIFile.WriteInteger('Configuration', 'ScreenWidth', FormMain.Width);
           INIFile.WriteInteger('Configuration', 'ScreenHeight', FormMain.Height);
         end;
      INIFile.WriteInteger('Configuration', 'MainSplitterPos', PanelScreenshotsArea.Width);

      INIFile.WriteInteger('Configuration', 'FullScreen', Ord(MenuViewFullScreen.Checked));

      INIFile.WriteInteger('Configuration', 'HideDOSBoxEmuVersionCreateGames', Ord(FormPreferences.HideDOSBoxEmuVersionCreateGames.Checked));
      INIFile.WriteInteger('Configuration', 'HideDOSBoxRunGame', Ord(FormPreferences.HideDOSBoxRunGame.Checked));

      INIFile.WriteInteger('Preferences', 'TilesViewCellSize', PopupTilesViewGameIconsSize.Tag);

      INIFile.WriteInteger('Preferences', 'GameIconSize', PopupGameIconSize.Tag);
      INIFile.WriteInteger('Preferences', 'DisableCloneIndent', Ord(FormPreferences.DisableCloneIndent.Checked));
      INIFile.WriteInteger('Preferences', 'DisableStatusIcons', Ord(FormPreferences.DisableDriverStatusIcons.Checked));
      INIFile.WriteInteger('Preferences', 'ShowStatusFirstLetterOnly', Ord(FormPreferences.DriverStatusShowFirstLetterOnly.Checked));
      INIFile.WriteInteger('Preferences', 'ShowHideStatusTexts', Ord(FormPreferences.HideDriverStatusTexts.Checked));
      INIFile.WriteInteger('Preferences', 'ShortDriverStatusColumnTitles', Ord(FormPreferences.ShortDriverColumnTitles.Checked));

      INIFile.WriteInteger('Preferences', 'ColumnsHeaderFontColor', GamesListView.Header.Font.Color);
      INIFile.WriteString('Preferences', 'ColumnsHeaderFontName', GamesListView.Header.Font.Name);
      INIFile.WriteInteger('Preferences', 'ColumnsHeaderFontSize', GamesListView.Header.Font.Size);
      INIFile.WriteInteger('Preferences', 'ColumnsHeaderFontStyle', Byte(GamesListView.Header.Font.Style));

      INIFile.WriteInteger('Preferences', 'HideSecondsLastPlayed', Ord(FormPreferences.LastPlayedHideSeconds.Checked));
      INIFile.WriteInteger('Preferences', 'HideSecondsTotalPlaytime', Ord(FormPreferences.TotalPlayTimeHideSeconds.Checked));

      INIFile.WriteInteger('Preferences', 'DisableNaturalSorting', Ord(FormPreferences.DisableNaturalSorting.Checked));

      INIFile.WriteInteger('Preferences', 'GameMultilineCaptions', Ord(FormPreferences.GameMultilineCaptions.Checked));

      INIFile.WriteInteger('Thumbnails', 'WidthSize', ThumbnailSettings.Width); // set thumbnails grid size directly in EasListView (April 05, 2017)
      INIFile.WriteInteger('Thumbnails', 'HeightSize', ThumbnailSettings.Height); // set thumbnails grid size directly in EasListView (April 05, 2017)

      INIFile.WriteInteger('Thumbnails', 'ImageListSize', IL_StandardIconsThumbnail.Width);

      //INIFile.WriteInteger('Thumbnails', 'WidthSize', GamesListView.CellSizes.Thumbnail.Width); // set thumbnails grid size directly in EasListView (April 05, 2017)
      //INIFile.WriteInteger('Thumbnails', 'HeightSize', GamesListView.CellSizes.Thumbnail.Height); // set thumbnails grid size directly in EasListView (April 05, 2017)

      //INIFile.WriteInteger('Thumbnails', 'GridSize', GamesListView.CellSizes.Thumbnail.Width); // not used anymore (April 09, 2017)
      INIFile.WriteInteger('Thumbnails', 'BorderColor', GamesListView.PaintInfoItem.BorderColor);
      INIFile.WriteInteger('Thumbnails', 'ShowBorder', Ord(GamesListView.PaintInfoItem.ShowBorder));
      INIFile.WriteInteger('Thumbnails', 'ShowParent', Ord(MenuThumbnailShowParentThumbs.Checked));
      INIFile.WriteInteger('Thumbnails', 'ShowTitle', Ord(not GamesListView.PaintInfoItem.HideCaption));
      INIFile.WriteInteger('Thumbnails', 'MaintainAspectRatio', Ord(ThumbnailSettings.MaintainAspectRatio));

      INIFile.WriteInteger('Thumbnails', 'SystemIconVisible', Ord(ThumbnailSettings.ShowSystemIcon));
      INIFile.WriteInteger('Thumbnails', 'SystemIconSize', ThumbnailSettings.SystemIconSize);
      INIFile.WriteInteger('Thumbnails', 'GameIconVisible', Ord(ThumbnailSettings.ShowGameIcon));
      INIFile.WriteInteger('Thumbnails', 'FavoriteIconVisible', Ord(ThumbnailSettings.ShowFavoriteIcon));

      INIFile.WriteInteger('Thumbnails', 'LeftAlignIcons', Ord(ThumbnailSettings.LeftAlignIcons));

      tmpString:= SelectedGameName;
      if tmpString <> SelectedGameName then
         tmpString:= '1 '+UTF8Encode(SelectedGameName)
      else
         tmpString:= '0 '+tmpString;

      case SelectedGameIsCustom of
        True : tmpString:= '1'+tmpString;
        False: tmpString:= '0'+tmpString;
      end;
      INIFile.WriteString('Selected', 'LastSelected', tmpString);//SelectedGameName);
      INIFile.WriteInteger('Selected', 'LastSelectedSysID', SelectedGameSysID);
      //INIFile.WriteInteger('Selected', 'LastSelectedIsCustomGame', Ord(SelectedGameIsCustom));
      INIFile.WriteString('Selected', 'LastSelectedSoftwareName', SelectedGameSoftwareName);


      // 0 -> all; 500 -> multiple systems selected
      if (MemGameInfo.eSystemID <> -1) or (MemGameInfo.eCustomSystemID <> -1) then
         begin
           if MemGameInfo.eSystemID <> -1 then
              SelectedGameSysID:= MemGameInfo.eSystemID
           else
           if MemGameInfo.eCustomSystemID <> -1 then
              SelectedGameSysID:= MemGameInfo.eCustomSystemID;

           {if CheckMultiSysFilters then
              begin
                if MemGameInfo.eSystemID <> -1 then
                   SelectedGameSysID:= MemGameInfo.eSystemID
                else
                if MemGameInfo.eCustomSystemID <> -1 then
                   SelectedGameSysID:= MemGameInfo.eCustomSystemID;
              end
           else
           if ButtonGameFilterArcadeSystems.Tag = idMAME then
              begin
                SelectedGameSoftwareName[1]:= MemGameInfo.eSoftwareName;
              end;}
         end;

      if PopupStartupGameSelectionGameSelected.Tag <> -1 then // .Tag is used to hold SystemID
         begin
           INIFile.WriteInteger('SelectGameStartup', 'SystemID', SelectGameStartup.SystemID);
           INIFile.WriteInteger('SelectGameStartup', 'ROMIdentification', SelectGameStartup.ROMIdentification);
           //INIFile.WriteInteger('SelectGameStartup', 'IsCustomGame', Ord(SelectGameStartup.IsCustomGame));

           tmpString:= SelectGameStartup.Title;
           if tmpString <> SelectGameStartup.Title then
              tmpString:= '1 '+UTF8Encode(SelectGameStartup.Title)
           else
              tmpString:= '0 '+tmpString;

           INIFile.WriteString('SelectGameStartup', 'GameTitle', tmpString);

           tmpString:= SelectGameStartup.GameName;
           if tmpString <> SelectGameStartup.GameName then
              tmpString:= '1 '+UTF8Encode(SelectGameStartup.GameName)
           else
              tmpString:= '0 '+tmpString;

           case SelectGameStartup.IsCustomGame of
             True : tmpString:= '1'+tmpString;
             False: tmpString:= '0'+tmpString;
           end;

           INIFile.WriteString('SelectGameStartup', 'GameName', tmpString);
           INIFile.WriteString('SelectGameStartup', 'SoftwareName', SelectGameStartup.SoftwareName);
           INIFile.WriteString('SelectGameStartup', 'GameNameDetails', SelectGameStartup.GameNameDetails);
         end;

      for Loop:=Low(FilterSysArcade) to High(FilterSysArcade) do
          INIFile.WriteInteger('ListFilter_Arcade', GetArcadeSystemIniSection(Loop), Ord(FilterSysArcade[Loop]));

      for Loop:=Low(FilterSysConsComp) to High(FilterSysConsComp) do
          INIFile.WriteInteger('ListFilter_ConsoleComputer', SystemsListCustom[Loop, 0], Ord(FilterSysConsComp[Loop]));

      for Loop:=Low(FilterSysArcadeQuick) to High(FilterSysArcadeQuick) do
          INIFile.WriteInteger('ListFilter_ArcadeQuick', GetArcadeSystemIniSection(Loop), Ord(FilterSysArcadeQuick[Loop]));

      for Loop:=Low(FilterSysConsCompQuick) to High(FilterSysConsCompQuick) do
          INIFile.WriteInteger('ListFilter_ConsoleComputerQuick', SystemsListCustom[Loop, 0], Ord(FilterSysConsCompQuick[Loop]));

      INIFile.WriteInteger('ListFilter', 'SystemQuickFilterEnabled', Ord(IsSystemQuickFilterEnabled));
      
      INIFile.WriteString('ListFilter', 'ArcadeGames', SelectedFilterName);
      INIFile.WriteString('ListFilter', 'ArcadeGames_LastFilter', LastFilterName);
      INIFile.WriteInteger('ListFilter', 'ParentClone', ButtonGameFilterParentClone.Tag);
      INIFile.WriteInteger('ListFilter', 'HaveMiss', ButtonGameFilterHaveMiss.Tag);

      INIFile.WriteInteger('ListFilter', 'DriverStatus', ButtonGameFilterDriverStatus.Tag);
      if FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex = -1 then
         FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex:= 0;
      INIFile.WriteInteger('ListFilter', 'DriverStatusCategory', FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex);


      // Machine Type Filters
      INIFile.WriteInteger('ListFilter', 'MachineTypeArcadeSystems', Ord(FilterMachineType.ArcadeSystems_Enabled));
      INIFile.WriteInteger('ListFilter', 'MachineTypeConsoleSystems', Ord(FilterMachineType.ConsoleSystems_Enabled));
      INIFile.WriteInteger('ListFilter', 'MachineTypeComputerSystems', Ord(FilterMachineType.ComputerSystems_Enabled));
      INIFile.WriteInteger('ListFilter', 'MachineTypeHandheldSystems', Ord(FilterMachineType.HandheldSystems_Enabled));
      INIFile.WriteInteger('ListFilter', 'MachineTypeMAMEMachinesWithSoftwareList', Ord(FilterMachineType.MAMEMachinesWithSoftwareList_Enabled));
      INIFile.WriteInteger('ListFilter', 'MachineTypeMAMEMachinesWithoutSoftwareList', Ord(FilterMachineType.MAMEMachinesWithoutSoftwareList_Enabled));
      INIFile.WriteInteger('ListFilter', 'MachineTypeMAMESoftwareListGames', Ord(FilterMachineType.MAMESoftwareListGames_Enabled));
      INIFile.WriteInteger('ListFilter', 'EnableMAMEMachinesFilterPanel', Ord(FilterMachineType.MAMEMachinesFilterPanel_Enabled));

      INIFile.WriteInteger('ListFilter', 'CPUFilter', Ord(FormArcadeFiltersExtra.FilterGamesMainCPU.Checked));

      INIFile.WriteInteger('ListFilter', 'BiosNoBios', FormArcadeFiltersExtra.LabelBios.Tag);
      INIFile.WriteInteger('ListFilter', 'HideBiosSets', Ord(FormArcadeFiltersExtra.HideBiosSets.Checked));
      INIFile.WriteInteger('ListFilter', 'InterfaceType', FormArcadeFiltersExtra.LabelInterfaceType.Tag);
      INIFile.WriteInteger('ListFilter', 'AudioType', FormArcadeFiltersExtra.LabelAudioType.Tag);
      INIFile.WriteInteger('ListFilter', 'DevicesNoDevices', FormArcadeFiltersExtra.LabelDeviceROMs.Tag);
      INIFile.WriteInteger('ListFilter', 'HideDeviceSets', Ord(FormArcadeFiltersExtra.HideDeviceSets.Checked));

      INIFile.WriteInteger('ListFilter', 'GamesROMs', FormArcadeFiltersExtra.LabelGamesROMs.Tag);

      INIFile.WriteInteger('ListFilter', 'CategoryCasino', Ord(FormArcadeFiltersExtra.CategoryCasino.Checked));
      INIFile.WriteInteger('ListFilter', 'CategoryFruitMachines', Ord(FormArcadeFiltersExtra.CategoryFruitMachines.Checked));
