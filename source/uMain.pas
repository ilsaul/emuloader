procedure TFormMain.ViewModeToggle;

  function SetColumnState(Enabled: Boolean): Boolean;
  var
    Column: TEasyColumn;
  begin
    Column:= GamesListView.Header.FirstColumn;
    Result:= Column.Clickable = Enabled;
    if Result then
       Exit;
    repeat
      Column.Clickable:= Enabled;
      Column:= GamesListView.Header.NextColumn(Column);
    until Column = nil;
  end;

begin
  IsMultiColumnSort:= False;
  if IsThumbnailView then
     begin
       ThumbnailSettings.ArcadeCalculateIconPos:= True;
       ThumbnailSettings.ConsCompCalculateIconPos:= True;
       InitImgZipThumbnail; // initialize zipped in-game snapshots
       AddGamesSystemsIcons(IL_StandardIconsThumbnail, False);
     end;

  case ButtonViewMode.Tag of
    0, 1: if GamesListView.View <> elsReport then GamesListView.View:= elsReport; // details, grouped view
    2: if GamesListView.View <> elsSmallIcon then GamesListView.View:= elsSmallIcon; // small icon (disabled view)
    3: if GamesListView.View <> elsIcon then GamesListView.View:= elsIcon; // large icon
    4: if GamesListView.View <> elsTile then GamesListView.View:= elsTile;// tile
    5: if GamesListView.View <> elsThumbnail then GamesListView.View:= elsThumbnail;// thumbnail (disabled view)
  end;
  case GamesListView.View = elsTile of
    True : GamesListView.PaintInfoItem.Border:= 1;
    False: GamesListView.PaintInfoItem.Border:= 4;
  end;
  SetGamesImageList;
  SetColumnState(ButtonViewMode.Tag <> 1);
end;

procedure TFormMain.ButtonViewModeDetailsClick(Sender: TObject);
var
  LastViewIndex: Byte;
begin
  case IsStartup of
    True:
      begin
        // frontend startup only
        if ButtonViewMode.Tag <> TMenuItem(Sender).ImageIndex then
           ButtonViewMode.Tag:= TMenuItem(Sender).ImageIndex;
        PopupMenuViewMode.Items[TMenuItem(Sender).ImageIndex].Checked:= TMenuItem(Sender).Checked;
        ViewModeToggle;
      end;
    False:
      begin
        if TMenuItem(Sender).ImageIndex = ButtonViewMode.Tag then
           begin
             PopupMenuViewMode.Items[TMenuItem(Sender).ImageIndex].Checked:= True;
             Exit;
           end
        else
           begin
             LastViewIndex:= ButtonViewMode.Tag;
             ButtonViewMode.Tag:= TMenuItem(Sender).ImageIndex;
             if LastViewIndex = 5 then // last view was Thumbnail view
                begin
                  InitImgZipThumbnail(True);
                  ClearImageList(IL_StandardIconsThumbnail);
                  ThumbClearTempVarsAll;
                end;
             ViewModeToggle;
             if ((LastViewIndex = 1) or IsGroupedView) then
                begin
                  FormStatus.Show;
                  FormStatus.StartThreadClock;
                  SetGameType(True); // ResetMAMu_ImageList() is done here
                  FormStatus.Close;
                end
             else
                begin
                  ResetMAMu_ImageList(True, (LastViewIndex = 5)); // this function already have a ELV FlushMessageCache call
                  if CheckSelected(GamesListView) then
                     begin
                       if (LastViewIndex <> 5) or IsThumbnailView then
                          SelectedEasyItem.MakeVisible(emvMiddle)
                       else
                          SetSelectedGame(True);
                     end;
                end;
           end;
      end;
  end;
  SetMainToolBarIcon(ButtonViewMode);
end;

procedure TFormMain.ThumbClearTempVarsAll;
var
  Item: TEasyItem;
begin
  if not CheckTotal(GamesListView) then
     Exit;

  Item:= GamesListView.Groups.FirstItem;
  repeat
    ClearThumbTempVars(Item);
    Item:= GamesListView.Groups.NextItem(Item);
  until Item = nil;
end;

procedure TFormMain.SetGamesImageList;

function ValidateIL_ExtraLarge(IL_Destination: TImageList): Boolean;
begin
  Result:= GamesListView.ImagesExLarge <> IL_Destination;
  if Result then
     GamesListView.ImagesExLarge:= IL_Destination;
end;

begin
 if IsThumbnailView then
     ValidateIL_ExtraLarge(IL_StandardIconsThumbnail)
  else
  //if IsTileView then
  //   begin
  //     case PopupTilesViewGameIconsSize.Tag of
  //       0: ValidateIL_ExtraLarge(IL_StandardIconsThumbnail); // insane... 128x128
  //       1: ValidateIL_ExtraLarge(IL_StandardIconsMegaLarge); // extra large 68x68
  //       2: ValidateIL_ExtraLarge(IL_StandardIconsExtraLarge); // standard 48x48
  //     end;
  //   end
  //else
  if IsDetailsView or IsGroupedView then
     begin
       if GamesListView.CellSizes.Report.Height <> ELV_CellSize[PopupGameIconSize.Tag] then
          GamesListView.CellSizes.Report.Height:= ELV_CellSize[PopupGameIconSize.Tag];
       case PopupGameIconSize.Tag of
         0: GamesListView.ImagesSmall:= IL_StandardIconsExtraLarge;
         1: GamesListView.ImagesSmall:= IL_StandardIconsLarge;
         2: GamesListView.ImagesSmall:= IL_StandardIconsStandard;
         3: GamesListView.ImagesSmall:= IL_StandardIconsSmall;
       end;
       if PopupGameIconSize.Tag in [0, 1] then
          GamesListView.PaintInfoItem.CaptionLines:= Ord(FormPreferences.GameMultilineCaptions.Checked)+1
       else
          GamesListView.PaintInfoItem.CaptionLines:= 1;
     end
  else
  if IsSmallIconView then
     begin
       if GamesListView.ImagesSmall <> IL_StandardIconsSmall then
          GamesListView.ImagesSmall:= IL_StandardIconsSmall;
     end
  else
     ValidateIL_ExtraLarge(IL_StandardIconsExtraLarge);
end;

procedure TFormMain.SetTilesViewCellSize;
var
  tWidth, tHeight: Integer;

  function ValidateCellSize: Boolean;
  begin
    Result:= True;
    if GamesListView.CellSizes.Tile.Width <> tWidth then
       GamesListView.CellSizes.Tile.Width:= tWidth;
    if GamesListView.CellSizes.Tile.Height <> tHeight then
       GamesListView.CellSizes.Tile.Height:= tHeight;
  end;

begin
  // need to set GamesListView.Font to the higher font so thumbs look the same no matter what font is used
  //AddGamesSystemsIcons(IL_StandardIconsMegaLarge, False);
  //ClearImageList(IL_StandardIconsMegaLarge);
  case PopupTilesViewGameIconsSize.Tag of
    0: // insane... 128x128
      begin
        tWidth:= 450;//648;
        tHeight:= 148;
        ValidateCellSize;
        Font_TilesViewDetailsText.Size:= 12;
      end;
    1: // mega large 96x96
      begin
        tWidth:= 396;
        tHeight:= 106;
        ValidateCellSize;
        Font_TilesViewDetailsText.Size:= 12;
      end;
    2: // extra large 68x68
      begin
        tWidth:= 385;
        tHeight:= 88;
        ValidateCellSize;
        Font_TilesViewDetailsText.Size:= 12;
      end;
    3: // standard 48x48
      begin
        tWidth:= 260;
        tHeight:= 58;
        ValidateCellSize;
        Font_TilesViewDetailsText.Size:= 9;
      end;
  end;
end;

