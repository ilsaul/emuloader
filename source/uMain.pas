  function SaveSnapFolderZipFile(SystemID: Integer): Boolean;
  var
    Section: String;
    imgLoop: ShortInt;
  begin
    Result:= True;
    if IsMAMEBasedSys(SystemID) then
      begin
        if WriteMAMESettingUI(SystemID) then
           Result:= False;
      end;

    if (not Result) or (Result and (not WriteImagesSettings)) then
       Exit; // system ID is MAME/HBMAME and mamedir\ui.ini was found... or images should not be updated

    Section:= GetArcadeSystemIniSection(SystemID);

    //if (not Result) and IsMAMEBasedSys(SystemID) then
    //   INIFile.EraseSection(Section);


    UpdateImgIni:= True;
    Section:= GetArcadeSystemIniSection(SystemID);
    for imgLoop:=Low(ImageCategoryArray) to High(ImageCategoryArray)-1 do
    begin
      //if (SystemID in [idMAME, idHBMAME]) and (imgLoop = 1) then
      //   INIFile.DeleteKey(Section, ImageCategoryArray[imgLoop, 1]+'_folder')
      //else
      //if not ((SystemID in [idMAME, idHBMAME]) and (imgLoop = 1)) then
      if not (IsMAMEBasedSys(SystemID) and (imgLoop = 1)) then
      begin
        if imgFolder[SystemID, imgLoop] <> '' then
           INIFile.WriteString(Section, ImageCategoryArray[imgLoop, 4], imgFolder[SystemID, imgLoop])
        else
           INIFile.DeleteKey(Section, ImageCategoryArray[imgLoop, 4]);

        //if imgFolder[SystemID, imgLoop] <> '' then
        //   INIFile.WriteString(Section, ImageCategoryArray[imgLoop, 1]+'_folder', imgFolder[SystemID, imgLoop])
        //else
        //   INIFile.DeleteKey(Section, ImageCategoryArray[imgLoop, 1]+'_folder');
      end;
    end;
  end;

begin
  //if WriteEmulatorsSettings then
  //   DeleteFile(GetFoldersEmulatorsFile);

  INIFile:= TMemIniFile.Create(GetImageCategoriesFile);
  UpdateImgIni:= False;

  try
    if WriteImagesSettings or WriteMAMu_Setting then
    begin
      for Loop:=1 to MaxArcadeSystems do
          SaveSnapFolderZipFile(Loop);
    end;

    if WriteMAMu_Setting and (not IsMAME_uiIni) then
       begin
         // check if "mamedir\ui.ini" exists; if not, save MAMu_ icons folder setting into "\arcade\image_categories.ini"
         INIFile.WriteString(GetArcadeSystemIniSection(idMAME), 'icons_directory', FormPreferences.MAMu_IconsFolder.Text);
         UpdateImgIni:= True;
       end;
       
  finally
    if UpdateImgIni then
       INIFile.UpdateFile;
    FreeAndNil(INIFile);
  end;
end;

function TFormMain.IsSameFont(SourceFont, DestinationFont: TFont): Boolean;
begin
  Result:= (DestinationFont.Color = SourceFont.Color) and
           (DestinationFont.Name = SourceFont.Name) and
           (DestinationFont.Size = SourceFont.Size) and
           (DestinationFont.Style = SourceFont.Style);
end;

procedure TFormMain.SetFont(SourceFont: TFont; var DestinationFont: TFont; AutoCreateDestinationFontVar: Boolean = False);
begin
  if not Assigned(DestinationFont) then
     begin
       if AutoCreateDestinationFontVar then
          DestinationFont:= TFont.Create
       else
          Exit; // auto-create is disabled and font var is not initialized; abort!!! useful for console/computer font settings (EmuCon systems)
     end;
  DestinationFont.Color:= SourceFont.Color;
  DestinationFont.Name:= SourceFont.Name;
  DestinationFont.Size:= SourceFont.Size;
  DestinationFont.Style:= SourceFont.Style;
end;

procedure TFormMain.ReadCustomGameFontFile;
var
  FontIniFile: TMemIniFile;
  Loop: Integer;
  tmpFont: TFont;

  function ReadEntry(const EntryTitle: String; DestinationFont: TFont; DefaultFontColor: TColor; const DefaultFontName: String; DefaultFontSize: Integer; DefaultFontStyle: Byte): Boolean;
  begin
    DestinationFont.Color:= FontIniFile.ReadInteger(EntryTitle, 'FontColor', DefaultFontColor);
    DestinationFont.Name:= FontIniFile.ReadString(EntryTitle, 'FontName', DefaultFontName);
    DestinationFont.Size:= FontIniFile.ReadInteger(EntryTitle, 'FontSize', DefaultFontSize);
    DestinationFont.Style:= TFontStyles(Byte(FontIniFile.ReadInteger(EntryTitle, 'FontStyle', DefaultFontStyle)));
  end;
  
begin
  if not ValidateFile(GetCustomFontIniFile) then
     Exit;

  if FormStatus.Visible then
     FormStatus.MessageStr('Loading systems custom fonts.');

  try
    FontIniFile:= TMemIniFile.Create(GetCustomFontIniFile);

    ReadEntry('Parent Game', Font_Parent, 0, 'Segoe UI', 9, 0);
    ReadEntry('Clone Game', Font_Clone, 0, 'Segoe UI', 9, 0);
    ReadEntry('Preliminary Game', Font_Preliminary, TColor(clGray), 'Segoe UI', 9, 8);
    ReadEntry('Missing ROMs Game', Font_MissingROMs, TColor(clRed), 'Segoe UI', 9, 0);
    ReadEntry('Missing ROMs Preliminary Game', Font_MissingROMsPreliminary, TColor(clRed), 'Segoe UI', 9, 8);

    GamesListView.Font:= Font_Parent;
    //SetFont(Font_Parent, GamesListView.Font);

    if FontIniFile.SectionExists('All Systems') then
       ReadEntry('All Systems', GamesListView.Font, Font_Parent.Color, Font_Parent.Name, Font_Parent.Size, Byte(Font_Parent.Style));

    tmpFont:= TFont.Create;
    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      ReadEntry(SystemsListCustom[Loop, 0], tmpFont, GamesListView.Font.Color, GamesListView.Font.Name, GamesListView.Font.Size, Byte(GamesListView.Font.Style));
      if not (IsSameFont(GamesListView.Font, tmpFont)) then
         begin
           //if not Assigned(Font_ConsoleComputer[Loop]) then
           //   Font_ConsoleComputer[Loop]:= TFont.Create;
           SetFont(tmpFont, Font_ConsoleComputer[Loop], True);
         end
      else
         FreeAndNil(Font_ConsoleComputer[Loop]); // free TFont var from RAM
    end;
    FreeAndNil(tmpFont);
  finally
    FreeAndNil(FontIniFile);
  end;
end;

procedure TFormMain.UpdateCustomGameFontFile;
var
  FontIniFile: TMemIniFile;
  Loop: Integer;

  function WriteEntry(EntryTitle: String; SourceFont: TFont): Boolean;
  begin
    FontIniFile.WriteInteger(EntryTitle, 'FontColor', SourceFont.Color);
    FontIniFile.WriteString(EntryTitle,  'FontName',  SourceFont.Name);
    FontIniFile.WriteInteger(EntryTitle, 'FontSize',  SourceFont.Size);
    FontIniFile.WriteInteger(EntryTitle, 'FontStyle', Byte(SourceFont.Style));
  end;

begin
  if CheckReadOnly(GetCustomFontIniFile) then
     Exit;

  DeleteFile(GetCustomFontIniFile);
  try
    FontIniFile:= TMemIniFile.Create(GetCustomFontIniFile);

    WriteEntry('Parent Game', Font_Parent);
    WriteEntry('Clone Game', Font_Clone);
    WriteEntry('Preliminary Game', Font_Preliminary);
    WriteEntry('Missing ROMs Game', Font_MissingROMs);
    WriteEntry('Missing ROMs Preliminary Game', Font_MissingROMsPreliminary);
    WriteEntry('All Systems', GamesListView.Font);

    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      if Assigned(Font_ConsoleComputer[Loop]) then
         begin
           if not IsSameFont(Font_ConsoleComputer[Loop], GamesListView.Font) then
              WriteEntry(SystemsListCustom[Loop, 0], Font_ConsoleComputer[Loop]) // "GamesListView.Font" is the "All Systems" font
           else
             FreeAndNil(Font_ConsoleComputer[Loop]);
         end;
    end;
  finally
    FontIniFile.UpdateFile;
    FreeAndNil(FontIniFile);
  end;
end;

