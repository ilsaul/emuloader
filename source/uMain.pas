function TFormMain.GetHorizontalBarPos: Integer;
begin
  Result:= 0;
  if FormMain.Visible and (IsDetailsView or IsGroupedView) then
     begin
       if GamesListView.Scrollbars.HorzBarVisible then
          Result:= GamesListView.Scrollbars.OffsetX;
     end;
end;

procedure TFormMain.RestoreHorizontalBarPos(ScrollBarPosition: Integer);
begin
  if ScrollbarPosition = 0 then
     Exit;
  if IsDetailsView or IsGroupedView then
     begin
       if GamesListView.Scrollbars.HorzBarVisible then
          begin
            if GamesListView.Scrollbars.OffsetX <> ScrollBarPosition then
               GamesListView.Scrollbars.OffsetX:= ScrollBarPosition;
          end;
     end;
end;

procedure TFormMain.ApplyFilters;
var
  KeepGame: Boolean;
  elvGroup: TEasyGroup;
  FirstItem: TEasyItem;
  sbPos: Integer;

  function ValidateStatusID(DriverCategoryVar: ShortInt): Boolean;
  begin
    case ButtonGameFilterDriverStatus.Tag of
      1: Result:= DriverCategoryVar in [0, 1];// working (good + imperfect)
      2: Result:= DriverCategoryVar = 0;// working (good)
      3: Result:= DriverCategoryVar = 1;// working (imperfect)
      4: Result:= DriverCategoryVar = 2;// non-working (preliminary)
    end;
  end;

  function VerifyFilterOptions: Boolean;
  begin
    case MemGameInfo.eIsCustomGame of
      True : KeepGame:= CheckConsCompSystemFilter;
      False: KeepGame:= CheckArcadeMainFilter; // main filter
    end;

    if KeepGame and (SelectedFilterName = 'favorites') then
       KeepGame:= MemGameInfo.eIsFavorite;

    if not MemGameInfo.eIsCustomGame then
    begin
      if KeepGame and (ButtonGameFilterDriverStatus.Tag > 0) then
         begin
           if FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex > 0 then
              KeepGame:= IsMAMEBasedSys(MemGameInfo.eSystemID); // other systems only support "Driver Status"

           if KeepGame then
              begin
                case FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex of
                  0: KeepGame:= ValidateStatusID(MemGameInfo.eDriverStatus);
                  1: KeepGame:= ValidateStatusID(MemGameInfo.eEmulationStatus);
                  2: KeepGame:= ValidateStatusID(MemGameInfo.eColorStatus);
                  3: KeepGame:= ValidateStatusID(MemGameInfo.eSoundStatus);
                  4: KeepGame:= ValidateStatusID(MemGameInfo.eGraphicStatus);
                end;
              end;
         end;

      if KeepGame then
         begin
           case ButtonGameFilterHaveMiss.Tag of
             2: KeepGame:= MemGameInfo.eGameSetStatus = 2; // missing games
             3: KeepGame:= MemGameInfo.eGameSetStatus = 1; // found with missing ROMs/CHDs
             4: KeepGame:= MemGameInfo.eGameSetStatus in [1, 2]; // missing games and found with missing ROMs/CHDs
           end;
         end;
    end;

    if not MemGameInfo.eIsCustomGame then
    begin
      if KeepGame and (SelectedFilterName = 'biossets') then
         KeepGame:= MemGameInfo.eBiosName = MemGameInfo.eName;

      if KeepGame and (SelectedFilterName = 'devicesets') then
         KeepGame:= IsROM_Device(MemGameInfo.eROMIdentification);

      if KeepGame then
         begin
           case MemGameInfo.eSystemType of
             0: KeepGame:= FilterMachineType.ArcadeSystems_Enabled;
             1:
               begin
                  if KeepGame then
                  begin
                    if MemGameInfo.eSoftwareName = '' then
                    begin
                      if Length(TEasyGameInfo(SelectedEasyItem).eSoftwareList) > 0 then
                         KeepGame:= FilterMachineType.MAMEMachinesWithSoftwareList_Enabled
                      else
                         KeepGame:= FilterMachineType.MAMEMachinesWithoutSoftwareList_Enabled;
                    end
                    else
                       KeepGame:= FilterMachineType.MAMESoftwareListGames_Enabled;
                  end;
               end;
           end;
         end;
    end;

    if MemGameInfo.eIsCustomGame and KeepGame then
       begin
         if SystemIsConsole(MemGameInfo.eCustomSystemID) then
            KeepGame:= FilterMachineType.ConsoleSystems_Enabled
         else
         if SystemIsComputer(MemGameInfo.eCustomSystemID) then
            KeepGame:= FilterMachineType.ComputerSystems_Enabled
         else
         if SystemIsHandheld(MemGameInfo.eCustomSystemID) then
            KeepGame:= FilterMachineType.HandheldSystems_Enabled
       end;

    if KeepGame then
       KeepGame:= ApplyMiscFilters(KeepGame);

    if KeepGame and (not MemGameInfo.eIsCustomGame) then
       begin
         if KeepGame and (SelectedFilterName <> 'favorites') then
            KeepGame:= not FilterGamesList(SelectedFilterName); // validate "Arcade Filters" in "uMain."FilterGamesList" function

         if KeepGame and (FormArcadeFiltersExtra.ControlName <> '') then
            KeepGame:= CheckGameControlType(MemGameInfo.eSystemID, MemGameInfo.eControls, FormArcadeFiltersExtra.ControlName, MemGameInfo.eSoftwareName, MemGameInfo.eButtonsCount);
       end;
  end;

begin
  if not CheckTotal(GamesListView) then
     Exit;

  if FormStatus.Visible then
     FormStatus.MessageStr('Applying filters.');

  sbPos:= GetHorizontalBarPos;

  LoadMultiSlotArray(idMAME);   // load NeoGeo MVS and ST-V multi-slow compatible games list (arcade only)
  LoadMultiSlotArray(idHBMAME);

  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // flush cache, just in case
  SelectedEasyItem:= nil;
  GamesListView.BeginUpdate;
  case IsGroupedView of
    True:
      begin
        GamesListView.Groups.MakeAllVisible; // set all visible first
        GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
        Application.ProcessMessages;
        elvGroup:= GamesListView.Groups.LastGroup;
        repeat
          SelectedEasyItem:= GamesListView.Groups.FirstInGroup(elvGroup);
          FirstItem:= SelectedEasyItem;
          repeat
            ClearMemGameInfo(MemGameInfo);
            FillMemGameInfo(MemGameInfo);
            VerifyFilterOptions;
            SelectedEasyItem.Visible:= KeepGame;
            if SelectedEasyItem <> FirstItem then
               begin
                 if SelectedEasyItem.Visible then
                    FirstItem.Visible:= True;
               end;
            SelectedEasyItem:= GamesListView.Groups.NextInGroup(elvGroup, SelectedEasyItem);
            Application.ProcessMessages;
          until SelectedEasyItem = nil;
          //elvGroup.Visible:= elvGroup.VisibleCount > 0; // cannot hide groups here (do not remove this)
          elvGroup:= GamesListView.Groups.PrevGroup(elvGroup);
        until elvGroup = nil;
        GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
        HideGroupsFilter(GamesListView); // hide groups with no visible items for last
      end;
    False:
      begin
        if GamesListView.Groups.VisibleItemCount = 0 then
           begin
             GamesListView.Groups.MakeAllVisible; // set all visible before applying the filters again
             GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
           end;
        SelectedEasyItem:= GamesListView.Groups.FirstItem;
        repeat
          ClearMemGameInfo(MemGameInfo);
          FillMemGameInfo(MemGameInfo);
          VerifyFilterOptions;
          SelectedEasyItem.Visible:= KeepGame;
          SelectedEasyItem:= GamesListView.Groups.NextItem(SelectedEasyItem);
        until SelectedEasyItem = nil;
      end;
  end;
  GamesListView.EndUpdate(False);
  UpdateTotalEntriesLabel;

  FreeAndNil(MultiCartListMAME[0]);
  FreeAndNil(MultiCartListMAME[1]);
  FreeAndNil(MultiCartListHBMAME[0]);
  FreeAndNil(MultiCartListHBMAME[1]);
  ReselectItem(True);
  if not CheckTotalVisible(GamesListView) then
     begin
       ClearScreenshots;
       UpdateStatusBarGame;
     end;
  RestoreHorizontalBarPos(sbPos);
end;

function TFormMain.MachinesListIndexOf(const MachineName: String; const MachinesList: TSoftwareListMESS): Integer;
var
  Loop: Integer;
begin
  Result:= -1;
  if Length(MachinesList) = 0 then
     Exit;
     
  for Loop:=0 to Length(MachinesList)-1 do
  begin
    if MachinesList[Loop] = MachineName then
    begin
      Result:= Loop;
      Break;
    end;
  end;
end;

function TFormMain.ScanMainFilterMachinesList: Boolean;
begin
  Result:= False;
  if SelectedMachineItem = nil then
     Exit;
  if (MemGameInfo.eSystemID <> idMAME) or (MemGameInfo.eSoftwareName = '') then
     Exit;

  case MemGameInfo.eROMIdentification of
    00: Result:= (not PopupShowClone.Checked) and (not PopupShowMiss.Checked);   // MAME Parent (have)
    01: Result:= (not PopupShowParent.Checked) and (not PopupShowMiss.Checked);  // MAME Clone (have)

    04: Result:= (not PopupShowClone.Checked) and (not PopupShowHave.Checked);   // MAME Parent (miss)
    05: Result:= (not PopupShowParent.Checked) and (not PopupShowHave.Checked);  // MAME Clone (miss)
    else
       Result:= True;
  end;
end;

procedure TFormMain.ApplyFiltersMachinesList;
var
  KeepGame: Boolean;
  elvGroup: TEasyGroup;
  FirstItem: TEasyItem;
  sbPos: Integer;

  function ValidateStatusID(DriverCategoryVar: ShortInt): Boolean;
  begin
    case ButtonGameFilterDriverStatus.Tag of
      1: Result:= DriverCategoryVar in [0, 1];// working (good + imperfect)
      2: Result:= DriverCategoryVar = 0;// working (good)
      3: Result:= DriverCategoryVar = 1;// working (imperfect)
      4: Result:= DriverCategoryVar = 2;// non-working (preliminary)
    end;
  end;

  function VerifyFilterOptions: Boolean;
  begin
    KeepGame:= ScanMainFilterMachinesList;

    if KeepGame then
       KeepGame:= MachinesListIndexOf(MemGameInfo.eSoftwareName, TMachineGameInfo(SelectedMachineItem).eSoftwareList) <> -1;

    if KeepGame and (ButtonGameFilterDriverStatus.Tag > 0) then
       begin
         if FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex > 0 then
            KeepGame:= MemGameInfo.eSystemID = idMAME; // other systems only support "Driver Status"; also for now, machines list is MAME only; HBMAME needs more work

         if KeepGame then
            begin
              case FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex of
                0: KeepGame:= ValidateStatusID(MemGameInfo.eDriverStatus);
                1: KeepGame:= ValidateStatusID(MemGameInfo.eEmulationStatus);
                2: KeepGame:= ValidateStatusID(MemGameInfo.eColorStatus);
                3: KeepGame:= ValidateStatusID(MemGameInfo.eSoundStatus);
                4: KeepGame:= ValidateStatusID(MemGameInfo.eGraphicStatus);
              end;
            end;
       end;

    if KeepGame then
       begin
         case ButtonGameFilterHaveMiss.Tag of
           2: KeepGame:= MemGameInfo.eGameSetStatus = 2; // missing games
           3: KeepGame:= MemGameInfo.eGameSetStatus = 1; // found with missing ROMs/CHDs
           4: KeepGame:= MemGameInfo.eGameSetStatus in [1, 2]; // missing games and found with missing ROMs/CHDs
         end;
       end;
    //if KeepGame and (ButtonGameFilterHaveMiss.Tag = 3) then
    //   KeepGame:= MemGameInfo.eGameSetStatus = 1;

    if KeepGame and (SelectedFilterName = 'favorites') then
       KeepGame:= MemGameInfo.eIsFavorite;
  end;

begin
  if not CheckTotal(GamesListView) then
     Exit;

  // this filter show/hide games in main games list, not in machines list filter panel
  if FormStatus.Visible then
     FormStatus.MessageStr('Applying filters.');

  sbPos:= GetHorizontalBarPos;

  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // flush cache just in case (thumbnails view only)

  SelectedEasyItem:= nil;
  GamesListView.BeginUpdate;
  case IsGroupedView of
    True:
      begin
        GamesListView.Groups.MakeAllVisible; // set all visible first
        GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
        elvGroup:= GamesListView.Groups.LastGroup;
        repeat
          SelectedEasyItem:= GamesListView.Groups.FirstInGroup(elvGroup);
          FirstItem:= SelectedEasyItem;
          repeat
            ClearMemGameInfo(MemGameInfo);
            FillMemGameInfo(MemGameInfo);
            VerifyFilterOptions;
            SelectedEasyItem.Visible:= KeepGame;
            if SelectedEasyItem <> FirstItem then
               begin
                 if SelectedEasyItem.Visible then
                    FirstItem.Visible:= True;
               end;
            SelectedEasyItem:= GamesListView.Groups.NextInGroup(elvGroup, SelectedEasyItem);
          until SelectedEasyItem = nil;
          //elvGroup.Visible:= elvGroup.VisibleCount > 0; // cannot hide groups here (do not remove this)
          elvGroup:= GamesListView.Groups.PrevGroup(elvGroup);
        until elvGroup = nil;
        GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
        HideGroupsFilter(GamesListView); // hide groups with no visible items for last
      end;
    False:
      begin
        if GamesListView.Groups.VisibleItemCount = 0 then
           begin
             GamesListView.Groups.MakeAllVisible; // set all visibile before applying the filters again
             GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
           end;
        SelectedEasyItem:= GamesListView.Groups.FirstItem;
        repeat
          ClearMemGameInfo(MemGameInfo);
          FillMemGameInfo(MemGameInfo);
          VerifyFilterOptions;
          SelectedEasyItem.Visible:= KeepGame;
          SelectedEasyItem:= GamesListView.Groups.NextItem(SelectedEasyItem);
        until SelectedEasyItem = nil;
      end;
  end;
  GamesListView.EndUpdate(False);
  UpdateTotalEntriesLabel;

  ReselectItem(True);
  if not CheckTotalVisible(GamesListView) then
     begin
       ClearScreenshots;
       UpdateStatusBarGame;
     end;
  RestoreHorizontalBarPos(sbPos);
end;

procedure TFormMain.HideGroupsFilter(ELV_Holder: TEasyListView);
var
  elvGroup: TEasyGroup;
begin
  elvGroup:= ELV_Holder.Groups.FirstGroup;
  repeat
    if elvGroup.VisibleCount = 0 then
       elvGroup.Visible:= False;
    elvGroup:= ELV_Holder.Groups.NextGroup(elvGroup);
    Application.ProcessMessages;
  until elvGroup = nil;
end;

function TFormMain.GetCustomMediaTypeID(const MAMESoftListExecParameter: String; MAMESoftwareName: String): Integer;
begin
  // assign non-arcade MediaArrayCustom[] into software list games, to run MAME softlist games with EmuCon emulators
  Result:= 1;
  if MAMESoftListExecParameter = 'cart1' then
     Result:= 1
  else
  if (MAMESoftListExecParameter = 'cdrom') or
     (MAMESoftListExecParameter = 'cdrom1') then
     Result:= 2
  else
  if MAMESoftListExecParameter = 'flop1' then
     Result:= 3
  else
  if (MAMESoftListExecParameter = 'cass1') or
     (MAMESoftListExecParameter = 'tape') then
     Result:= 4
  else
  if MAMESoftListExecParameter = 'hard1' then
     Result:= 5
  else
  if SameText(MAMESoftwareName, 'vgmplay') then
     Result:= 6; 
end;

function TFormMain.GetMediaTypeIconMsgBox(CustomMediaTypeIndex: Integer; IsCustomGame: Boolean; ArcadeMediaType: Integer; ArcadeCHDMediaType: Integer; IconHolder: TImage; MAMESoftListExecParameter: String; MAMESoftwareName: String; UseLargeIcon: Boolean = False; IsThumbnail: Boolean = False): Integer;
var
  Continue: Boolean;
begin
  Result:= -1;
  Continue:= True;
  if IconHolder <> nil then
     Continue:= IconHolder.Tag <> -1;

  // "IconHolder = nil" is only used in "Last Played Games (MRU)" 
  if not Continue then
     Exit;

  if CustomMediaTypeIndex <> -1 then
  begin
    // for EmuCon games only
    case CustomMediaTypeIndex of
      1: Result:= 16; // cart
      2: Result:= 20; // cdrom
      3: Result:= 17; // floppy
      4: Result:= 18; // cassette tape
      5: Result:= 22; // hard-drive
      6: Result:= 24; // video music file
    end;
  end
  else
  begin
    if not IsCustomGame then
    begin
      // MAME and arcade games only
      if MAMESoftListExecParameter <> '' then
         begin
           Result:= GetCustomMediaTypeID(MAMESoftListExecParameter, MAMESoftwareName);
           case Result of
             1: Result:= 16;
             2: Result:= 20;
             3: Result:= 17;
             4: Result:= 18;
             5: Result:= 22;
             6: Result:= 24; 
           end;
         end
      else
         begin
           case ArcadeMediaType of
             0: Result:= 15;
             1:
               begin
                 Result:= 22;
               end;
           end;

           if ArcadeCHDMediaType <> -1 then
              begin
                case ArcadeCHDMediaType of
                  12, 13, 14: Result:= 22; // Game HDD
                  15, 16, 17: Result:= 20; // Game CD
                  18, 19, 20: Result:= 21; // Compact Flash Card
                  21, 22, 23: Result:= 23; // Game Video Tape (VHS)
                end;
              end;
         end;

     // 12   Game HDD (also used as a general MAME "CHD" ID)
     // 13   Device HDD (also used as a general MAME "CHD" ID)
     // 14   BIOS HDD (also used as a general MAME "CHD" ID)

     // 15   Game CD (CD/DVD/Laserdisc/GD-ROM/Audio CD/CED VideoDisc)
     // 16   Device CD (CD/DVD/Laserdisc/GD-ROM/Audio CD/CED VideoDisc)
     // 17   BIOS CD (CD/DVD/Laserdisc/GD-ROM/Audio CD/CED VideoDisc)

     // 18   Game Compact Flash Card
     // 19   Device Compact Flash Card
     // 20   BIOS Compact Flash Card

     // 21   Game Video Tape (VHS)
     // 22   Device Video Tape (VHS)
     // 23   BIOS Video Tape (VHS)

     // AddDefaultIcons('chd.ico', tempFolder, IL_LeftPanel);                  // 19
     // AddDefaultIcons('media_disc.ico', tempFolder, IL_LeftPanel);           // 20
     // AddDefaultIcons('media_flashcard.ico', tempFolder, IL_LeftPanel);      // 21
     // AddDefaultIcons('media_harddisk.ico', tempFolder, IL_LeftPanel);       // 22
     // AddDefaultIcons('media_vhs.ico', tempFolder, IL_LeftPanel);            // 23
     // AddDefaultIcons('media_videogamemusic.ico', tempFolder, IL_LeftPanel); // 24
    end;
  end;

  if Result = -1 then
     Result:= 15; // default to "ROM" media type

  if IsThumbnail then
     Result:= Result-15;
  if IconHolder <> nil then
     begin
       if UseLargeIcon then
          begin
            Result:= Result-15; // IL_MediaType starts at ZERO, not 15
            IL_MediaType.GetIcon(Result, IconHolder.Picture.Icon);
          end
       else
          IL_LeftPanel.GetIcon(Result, IconHolder.Picture.Icon);
     end;
end;

// load games from files into main games list

procedure TFormMain.LoadMAMESoftList(sysID: Integer; var SoftListVar: THashedStringList; RemoveFileExtension: Boolean);
var
  Loop: Integer;
begin
  GetFilesList(GetGamesFolderEL(1, sysID), '.el', '*.el', SoftListVar, False, True, False);
  if SoftListVar.Count = 0 then
     Exit;

  if RemoveFileExtension then
     begin
       SoftListVar.Sorted:= False;
       SoftListVar.BeginUpdate;
       for Loop:=0 to SoftListVar.Count-1 do
           SoftListVar[Loop]:= ChangeFileExt(SoftListVar[Loop], '');
       SoftListVar.EndUpdate;
     end;
end;

procedure TFormMain.LoadGames(LoadArcade, LoadSoftwareListMESS, LoadCustomGames: Boolean; ClearGamesList: Boolean = False);
var
  Loop: Integer;
  SoftwareGames: THashedStringList;
begin
  if FormStatus.Visible then
     begin
       FormStatus.TitleStr('Load Games List');
       FormStatus.MessageStr('Loading games list.');
     end;
  FormStatus.SetProgressPos(0);
  if CheckTotal(GamesListView) then
     begin
       GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // flush cache just in case
       if ClearGamesList then
          ClearListView(GamesListView);
       Application.ProcessMessages;
     end;
  if PopupEnableMAMu_Icons.Checked then
     ResetMAMu_ImageList(True); // reset EL's default games icons; no need to reset item icons

  CompleteGamesList:= THashedStringList.Create;

  if LoadArcade then
  begin
    for Loop:= 1 to MaxArcadeSystems do
        GetGamesList(CompleteGamesList, Loop);
  end;

  if LoadSoftwareListMESS then
  begin
    FormStatus.MessageStr('Loading MAME software list games.');
    SoftwareGames:= THashedStringList.Create;
    LoadMAMESoftList(idMAME, SoftwareGames, True);
    //GetFilesList(GetGamesFolderEL(1, idMAME), '.el', '*.el', SoftwareGames, False, True, False);
    if SoftwareGames.Count > 0 then
       begin
         //SoftwareGames.Sorted:= False;
         //SoftwareGames.BeginUpdate;
         //for Loop:=0 to SoftwareGames.Count-1 do
         //    SoftwareGames[Loop]:= ChangeFileExt(SoftwareGames[Loop], '');
         //SoftwareGames.EndUpdate;
         for Loop:=0 to SoftwareGames.Count-1 do
         begin
           GetGamesList(CompleteGamesList, idMAME, 1, SoftwareGames[Loop]);
           Application.ProcessMessages;
         end;
       end;
    FreeAndNil(SoftwareGames);

    FormStatus.MessageStr('Loading HBMAME software list games.');
    SoftwareGames:= THashedStringList.Create;
    LoadMAMESoftList(idHBMAME, SoftwareGames, True);
    //GetFilesList(GetGamesFolderEL(1, idHBMAME), '.el', '*.el', SoftwareGames, False, True, False);
    if SoftwareGames.Count > 0 then
       begin
         //SoftwareGames.Sorted:= False;
         //SoftwareGames.BeginUpdate;
         //for Loop:=0 to SoftwareGames.Count-1 do
         //    SoftwareGames[Loop]:= ChangeFileExt(SoftwareGames[Loop], '');
         //SoftwareGames.EndUpdate;
         for Loop:=0 to SoftwareGames.Count-1 do
         begin
           GetGamesList(CompleteGamesList, idHBMAME, 1, SoftwareGames[Loop]);
           Application.ProcessMessages;
         end;
       end;
    FreeAndNil(SoftwareGames);
  end;

  if LoadCustomGames then
  begin
    FormStatus.MessageStr('Loading EmuCon games.');
    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      GetGamesListCustom(CompleteGamesList, Loop);
      Application.ProcessMessages;
    end;
  end;

  //CompleteGamesList.EndUpdate; // no need; done in GetGamesList() function; do not remove this line, it's here for information
  //CompleteGamesList.SaveToFile('d:\EmuLoader\completelist.txt'); ShowMessage('stop'); // for debugging only

  FormStatus.MessageStr('Adding games to games list.');
  AddGames;
  FreeAndNil(CompleteGamesList);

  if FormStatus.Visible then
     FormStatus.SetFocus;
end;

procedure TFormMain.SetMainToolBarIcon(const ButtonName: TToolButton);
var
  tempString: String;

begin
  // 00 -> main menu (never changes)
  // 01 -> view mode
  // 02 -> machine type and systems filter: arcade/console/computer/handheld/MAME (never changes)
  // 03 -> systems quick filter
  // 04 -> favorites (never changes)
  // 05 -> arcade games filters
  // 06 -> parent/clone
  // 07 -> have/miss
  // 08 -> driver status (working/non-working)
  // 09 -> MAMu_ icons (never changes)
  // 10 -> extra filters (never changes)
  // 11 -> load game with image .cue (never changes)
  // 12 -> EmuCon emulator parameters to use (never changes)
  // 13 -> last played games MRU (never changes)
  // 14 -> select main emulators to play with EmuCon (never changes)
  // 15 -> Search Games Panel

  // OverlayIndex
  // 0 -> tool bar multi icon
  // 1 -> tool bar single icon
  tempString:= '';
  if ButtonName = ButtonViewMode then
     begin
       case ButtonViewMode.Tag of
         0: tempString:= 'viewmode_01_details.ico';
         1: tempString:= 'viewmode_02_grouped.ico';
         2: tempString:= 'viewmode_03_small.ico';
         3: tempString:= 'viewmode_04_large.ico';
         4: tempString:= 'viewmode_05_tile.ico';
         5: tempString:= 'viewmode_06_thumbnail.ico';
       end;
       SetToolBarIcon(tempString, GetFolderFull(40), IL_ToolBarButtons, 1, 1); //SetIcon(IL_ViewMode_Large, IL_ViewMode_Small, IL_ToolBarButtons, ButtonViewMode.Tag, 1)
     end
  else
  if ButtonName = ButtonSystemsQuickFilter then
     begin
       if IsSystemQuickFilterEnabled then
          begin
            SetToolBarIcon('filter_systems_quick_enabled.ico', GetFolderFull(40), IL_ToolBarButtons, 3, 1);
            ButtonSystemsQuickFilter.Hint:= 'Select systems filter, quick mode (enabled)';
          end
       else
          begin
            SetToolBarIcon('filter_systems_quick_disabled.ico', GetFolderFull(40), IL_ToolBarButtons, 3, 1);
            ButtonSystemsQuickFilter.Hint:= 'Select systems filter, quick mode (disabled)';
          end;
     end
  else
  if ButtonName = ButtonArcadeGamesFilters then
     begin
       ButtonArcadeGamesFilters.Enabled:= (SelectedFilterName <> 'favorites') and (not PanelMachinesList.Visible);
       tempString:= GetFolderFull(32);
       case ButtonArcadeGamesFilters.Enabled of
         True : SetToolBarIcon(SelectedFilterName, tempString+'arcade_filters\', IL_ToolBarButtons, 5, Ord(SelectedFilterName <> 'allgames'));
         False: SetToolBarIcon(LastFilterName, tempString+'arcade_filters\', IL_ToolBarButtons, 5, Ord(LastFilterName <> 'allgames'));
       end;

       {case MenuSmallToolBar.Checked of
         True:
           begin
             // arcade main filter icon doesn't change when small icons are enabled; there are no 28x22 icons in "resources\main_icons\arcade_filters\" files
             SetToolBarIcon('allgames', tempString+'arcade_filters\', IL_ToolBarButtons, 5, 0);
           end;
         False:
           begin
             case ButtonGameFilterMain.Enabled of
               True : SetToolBarIcon(SelectedFilterName, tempString+'arcade_filters\', IL_ToolBarButtons, 5, Ord(SelectedFilterName <> 'allgames'));
               False: SetToolBarIcon(LastFilterName, tempString+'arcade_filters\', IL_ToolBarButtons, 5, Ord(LastFilterName <> 'allgames'));
             end;
           end;
       end;}
     end
  else
  if ButtonName = ButtonGameFilterParentClone then
     begin
