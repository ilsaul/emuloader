procedure TFormMain.ButtonGameFilterDriverStatusClick(
  Sender: TObject);
var
  UpdateFilters: Boolean;
  LeftPos: Integer;
begin
  LeftPos:= FormMain.Left+ButtonGameFilterDriverStatus.Left+10;
  if LeftPos+ButtonGameFilterDriverStatus.Width > Screen.Width then
     LeftPos:= ((LeftPos+ButtonGameFilterDriverStatus.Width)-Screen.Width)-10;
  FormArcadeFiltersDriverStatus.Left:= LeftPos;
  FormArcadeFiltersDriverStatus.Top:= FormMain.Top+28+10+ToolBarButtons.ButtonHeight+1;

  if FormArcadeFiltersDriverStatus.ShowModal = mrOk then
     begin
       UpdateFilters:= False;
       if ButtonGameFilterDriverStatus.Tag <> FormArcadeFiltersDriverStatus.LabelFilterStatus.Tag then
          begin
            UpdateFilters:= True;
            ButtonGameFilterDriverStatus.Tag:= FormArcadeFiltersDriverStatus.LabelFilterStatus.Tag;
            SetMainToolBarIcon(ButtonGameFilterDriverStatus);
          end;

       if FormArcadeFiltersDriverStatus.DriverStatusCategory.Tag <> FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex then
          begin
            FormArcadeFiltersDriverStatus.DriverStatusCategory.Tag:= FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex;
            UpdateFilters:= True;
          end;
       if UpdateFilters then
          SetGameType(False);
     end
  else
     begin
       if FormArcadeFiltersDriverStatus.LabelFilterStatus.Tag <> ButtonGameFilterDriverStatus.Tag then
          begin
            FormArcadeFiltersDriverStatus.LabelFilterStatus.Tag:= ButtonGameFilterDriverStatus.Tag;
            SetDriverStatusCategory;
          end;
       if FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex <> FormArcadeFiltersDriverStatus.DriverStatusCategory.Tag then
          FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex:= FormArcadeFiltersDriverStatus.DriverStatusCategory.Tag;
     end;
end;

