procedure TFormMain.ReadIniFile;
const
  ReadIniFileMsg: String = 'Reading initialization file.';
var
  INIFile: TMemIniFile;
  Loop: ShortInt;
  Index: Integer;
  tmpString: String;
  iUnicodeStr: WideString;
  Continue: Boolean;

  function SetMiscFilterCheckBox(CheckBoxHolder: TAdvOfficeCheckBoxEx): Boolean;
  begin
    Result:= True;
    if CheckBoxHolder.Checked <> (Boolean(CheckBoxHolder.Tag)) then
       CheckBoxHolder.Checked:= Boolean(CheckBoxHolder.Tag);
    //if FormFiltersExtra.HideBiosSets.Checked <> Boolean(FormFiltersExtra.HideBiosSets.Tag) then
    //   FormFiltersExtra.HideBiosSets.Checked:= Boolean(FormFiltersExtra.HideBiosSets.Tag);
  end;

begin
  if FormStatus.Visible then
     FormStatus.MessageStr(ReadIniFileMsg);

  ReadLightModeSettings;
  if not IsStartup then
     ReadSplashSettings;
  LoadImageCategoryLayoutSettings; // image category "bkcolor/visible" and image layout "visible" settings
  ReadSingleLayoutCategory(True);
  ReadImageSingleBackground(False);

  if not ValidateFile(FrontendPath+'EmuLoader.ini') then
     Exit;

  try
    INIFile:= TMemIniFile.Create(FrontendPath+'EmuLoader.ini');
    MenuBoundToGamesPanel.Tag:= INIFile.ReadInteger('ToolBar', 'GamesFilters_BoundToGamesPanel', 0);

    MenuBoundToGamesPanel.Checked:= Boolean(MenuBoundToGamesPanel.Tag);
    MenuBoundToGamesPanel.OnClick(Self);

    MenuFontSettings.Tag:= INIFile.ReadInteger('Appearance', 'GamesFontDialogShowAvailableOnly', 0);
    MenuFontSettings.HelpContext:= INIFile.ReadInteger('Appearance', 'GamesFontShowFontName', 0);

    if FormStatus.Visible then
       FormStatus.MessageStr(ReadIniFileMsg);

    FormMain.Tag:= Ord(INIFile.ReadString('Configuration', 'WindowState', 'Normal') = 'Maximized');

    FormMain.Width:= INIFile.ReadInteger('Configuration', 'ScreenWidth', 1009);
    FormMain.Height:= INIFile.ReadInteger('Configuration', 'ScreenHeight', 654);
    PanelScreenshotsArea.Width:= INIFile.ReadInteger('Configuration', 'MainSplitterPos', 370);
    FormMain.Left:= INIFile.ReadInteger('Configuration', 'ScreenLeft', (Screen.Width shr 1)-(Width shr 1)-1);
    FormMain.Top:= INIFile.ReadInteger('Configuration', 'ScreenTop', (Screen.Height shr 1)-(Height shr 1)-1);
    MenuViewFullScreen.Tag:= INIFile.ReadInteger('Configuration', 'FullScreen', 0);

    FormPreferences.HideDOSBoxEmuVersionCreateGames.Checked:= Boolean(INIFile.ReadInteger('Configuration', 'HideDOSBoxEmuVersionCreateGames', 1));
    FormPreferences.HideDOSBoxRunGame.Checked:= Boolean(INIFile.ReadInteger('Configuration', 'HideDOSBoxRunGame', 0));

    IsSystemQuickFilterEnabled:= Boolean(INIFile.ReadInteger('ListFilter', 'SystemQuickFilterEnabled', 0));

    for Loop:=Low(FilterSysArcade) to High(FilterSysArcade) do
    begin
      Index:= INIFile.ReadInteger('ListFilter_Arcade', GetArcadeSystemIniSection(Loop), 1);
      FilterSysArcade[Loop]:= Boolean(Index);
    end;

    for Loop:=Low(FilterSysConsComp) to High(FilterSysConsComp) do
    begin
      Index:= INIFile.ReadInteger('ListFilter_ConsoleComputer', SystemsListCustom[Loop, 0], 1);
      FilterSysConsComp[Loop]:= Boolean(Index);
    end;

    Continue:= False; // to validate quick filter... to make sure at least one system is selected for the quick filter
    for Loop:=Low(FilterSysArcadeQuick) to High(FilterSysArcadeQuick) do
    begin
      Index:= INIFile.ReadInteger('ListFilter_ArcadeQuick', GetArcadeSystemIniSection(Loop), 0);
      FilterSysArcadeQuick[Loop]:= Boolean(Index);
      if Boolean(Index) then
         Continue:= True;
    end;

    for Loop:=Low(FilterSysConsCompQuick) to High(FilterSysConsCompQuick) do
    begin
      Index:= INIFile.ReadInteger('ListFilter_ConsoleComputerQuick', SystemsListCustom[Loop, 0], 0);
      FilterSysConsCompQuick[Loop]:= Boolean(Index);
      if Boolean(Index) then
         Continue:= True;
    end;

    if IsSystemQuickFilterEnabled and (not Continue) then
       IsSystemQuickFilterEnabled:= False; // system quick filter was enabled but there are no systems selected for the quick filter... disable quick filter!!!!

    SelectedFilterName:= INIFile.ReadString('ListFilter', 'ArcadeGames', 'allgames');
    if SelectedFilterName = '' then
       SelectedFilterName:= 'allgames';
    LastFilterName:= INIFile.ReadString('ListFilter', 'ArcadeGames_LastFilter', '');
    ButtonArcadeGamesFilters.Tag:= INIFile.ReadInteger('ListFilter', 'ArcadeGames_IconSize', 1); // 0 -> extra large; 1 -> large; 2 -> small
    ButtonGameFilterParentClone.Tag:= INIFile.ReadInteger('ListFilter', 'ParentClone', 0);
    ButtonGameFilterHaveMiss.Tag:= INIFile.ReadInteger('ListFilter', 'HaveMiss', 0);

    ButtonGameFilterDriverStatus.Tag:= INIFile.ReadInteger('ListFilter', 'DriverStatus', 0);
    FormArcadeFiltersDriverStatus.LabelFilterStatus.Tag:= ButtonGameFilterDriverStatus.Tag;
    FormArcadeFiltersDriverStatus.DriverStatusCategory.Tag:= INIFile.ReadInteger('ListFilter', 'DriverStatusCategory', 0);
    FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex:= FormArcadeFiltersDriverStatus.DriverStatusCategory.Tag;
    SetDriverStatusCategory;

    // Machine Type Filters
    FilterMachineType.ArcadeSystems_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'MachineTypeArcadeSystems', 1));
    FilterMachineType.ConsoleSystems_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'MachineTypeConsoleSystems', 1));
    FilterMachineType.ComputerSystems_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'MachineTypeComputerSystems', 1));
    FilterMachineType.HandheldSystems_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'MachineTypeHandheldSystems', 1));
    FilterMachineType.MAMEMachinesWithSoftwareList_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'MachineTypeMAMEMachinesWithSoftwareList', 1));
    FilterMachineType.MAMEMachinesWithoutSoftwareList_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'MachineTypeMAMEMachinesWithoutSoftwareList', 1));
    FilterMachineType.MAMESoftwareListGames_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'MachineTypeMAMESoftwareListGames', 1));
    FilterMachineType.MAMEMachinesFilterPanel_Enabled:= Boolean(INIFile.ReadInteger('ListFilter', 'EnableMAMEMachinesFilterPanel', 0));

    // extra filters (misc tool bar button!)
    FormArcadeFiltersExtra.LabelBios.Tag:= INIFile.ReadInteger('ListFilter', 'BiosNoBios', 0);
    FormArcadeFiltersExtra.HideBiosSets.Tag:= INIFile.ReadInteger('ListFilter', 'HideBiosSets', 0);
    FormArcadeFiltersExtra.LabelInterfaceType.Tag:= INIFile.ReadInteger('ListFilter', 'InterfaceType', 0);
    FormArcadeFiltersExtra.LabelAudioType.Tag:= INIFile.ReadInteger('ListFilter', 'AudioType', 0);
    FormArcadeFiltersExtra.LabelDeviceROMs.Tag:= INIFile.ReadInteger('ListFilter', 'DevicesNoDevices', 0);
    FormArcadeFiltersExtra.HideDeviceSets.Tag:= INIFile.ReadInteger('ListFilter', 'HideDeviceSets', 0);
    //FormArcadeFiltersExtra.HideDeviceSetsNoROMs.Tag:= INIFile.ReadInteger('ListFilter', 'HideDeviceSetsNoROMs', 0); // no longer used (December 24, 2017)
    FormArcadeFiltersExtra.LabelGamesROMs.Tag:= INIFile.ReadInteger('ListFilter', 'GamesROMs', 0);

    FormArcadeFiltersExtra.CategoryCasino.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryCasino', 1);
    FormArcadeFiltersExtra.CategoryFruitMachines.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryFruitMachines', 1);
    FormArcadeFiltersExtra.CategorySlotMachines.Tag:= INIFile.ReadInteger('ListFilter', 'CategorySlotMachines', 1);
    FormArcadeFiltersExtra.CategoryRhythm.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryRhythm', 1);
    FormArcadeFiltersExtra.CategoryMature.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryMature', 1);
    FormArcadeFiltersExtra.CategoryMahjong.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryMahjong', 1);
    FormArcadeFiltersExtra.CategoryTabletop.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryTabletop', 1);
    FormArcadeFiltersExtra.CategoryPinMAME.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryPinMAME', 1);
    FormArcadeFiltersExtra.CategoryBoardGame.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryBoardGame', 1);

    FormArcadeFiltersExtra.CategoryQuiz.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryQuiz', 1);

    FormArcadeFiltersExtra.CategoryUtilities.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryUtilities', 1);
    FormArcadeFiltersExtra.CategoryCalculator.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryCalculator', 1);
    FormArcadeFiltersExtra.CategoryEducational.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryEducational', 1);
    FormArcadeFiltersExtra.CategoryElectronic.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryElectronic', 1);
    FormArcadeFiltersExtra.CategoryPrinters.Tag:= INIFile.ReadInteger('ListFilter', 'CategoryPrinters', 1);
