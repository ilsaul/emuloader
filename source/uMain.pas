procedure TFormMain.ButtonArcadeGamesFiltersClick(Sender: TObject);
begin
  if not FileExists(GetFolderFull(43)+'mame_filters.ini') then
     begin
       CallMessageBox;
       AddMsgText('    File ');
       AddMsgText(GetFolderFull(43)+'mame_filters.ini', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not found. Filters list cannot be built.'+#13#10+'Aborting...');
       GenerateMessage('Error', 'Main filter', '', 2, False, 1);
       Exit;
     end;

  ShowFilterMsgBox('Arcade Games Filters', 'Building filters list, please wait...', True);
  if not Assigned(FormArcadeGamesFilter) then
     FormArcadeGamesFilter:= TFormArcadeGamesFilter.Create(nil);
  //if Screen.Height = 480 then
  //   FormArcadeGamesFilter.ClientHeight:= 400;
  FormArcadeGamesFilter.Left:= FormMain.Left+ButtonArcadeGamesFilters.Left+10;
  FormArcadeGamesFilter.Top:= FormMain.Top+28+10+ToolBarButtons.ButtonHeight+1;

  FormArcadeGamesFilter.ShowModal;
  if (FormArcadeGamesFilter.SelNodeName <> SelectedFilterName) and
     (FormArcadeGamesFilter.SelNodeName <> 'cancel') then
     begin
       SelectedFilterName:= FormArcadeGamesFilter.SelNodeName;
       FreeAndNil(FormArcadeGamesFilter);
       SetMainToolBarIcon(ButtonArcadeGamesFilters);
       SetGameType(False);
     end
  else
     FreeAndNil(FormArcadeGamesFilter);
  UpdateGamesFilterHint;
end;

procedure TFormMain.DrawDisabledImage(DC: HDC; ImageList: TCustomImageList; Index, X, Y: Integer; BlendColor: TColor = clNone);
var
  Options: TImageListDrawParams;
begin
  ZeroMemory(@Options, SizeOf(Options));
  Options.cbSize := SizeOf(Options);
  Options.himl := ImageList.Handle;
  Options.i := Index;
  Options.hdcDst := DC;
  Options.x := X;
  Options.y := Y;
  if BlendColor <> clNone then
     begin
       //Options.rgbBk:= ColorToRGB(clNone);
       Options.rgbFg:= ColorToRGB(BlendColor);
       Options.fState := ILD_BLEND50; //ILS_ALPHA;
       //Options.Frame:= 20;
     end
  else
     Options.fState := ILS_SATURATE;
  ImageList_DrawIndirect(@Options);
end;

// dark menu colors
procedure TFormMain.BcDrawModuleDrawMenuItem(Sender: TObject;
  AMenuItem: TMenuItem; ACanvas: TCanvas; ARect: TRect;
  State: TOwnerDrawState; ABarVisible: Boolean; var DefaultDraw: Boolean);
{const
  //menu_background_color: Integer = $00fafafa;
  //hint_line_color: Integer = $00c5c5c5;
  //hint_text_color: Integer = $00993300; // $006e1500;
  //item_caption_active_color: Integer = clBlack;
  //item_caption_disabled_color: Integer = $00c5c5c5;
  //item_shortcut_color: Integer = $006e1500;
  //item_caption_selected_color: Integer = $006e1500;
  //checked_framecolor: Integer = $00399bf7;
  //selection_frame_color: Integer = $009bcddc;
  //selection_singlecolor: Integer = $00fac8b5;
  //selection_uppergradient_colorstart: Integer = $00ecfdff;
  //selection_uppergradient_colorend: Integer = $00b4ebff;
  //selection_lowergradient_colorstart: Integer = $006ed7ff;
  //selection_lowergradient_colorend: Integer = $009de5ff;

  // position 0 -> light mode; position 1 -> night mode
  menu_background_color: array[0..1] of Integer = ($00fafafa, $00272727);
  hint_line_color: array[0..1] of Integer = ($00c5c5c5, $00c5c5c5);
  hint_text_color: array[0..1] of Integer = ($00993300, $00af912b);
  item_caption_active_color: array[0..1] of Integer = (clBlack, $00bfdfe0);
  item_caption_disabled_color: array[0..1] of Integer = ($00c5c5c5, clGray);
  item_shortcut_color: array[0..1] of Integer = ($006e1500, clrLightBlue);
  item_shortcut_selected_color: array[0..1] of Integer = ($006e1500, clrDarkBlue);
  item_caption_selected_color: array[0..1] of Integer = ($006e1500, $006e1500);
  help_text_color: array[0..1] of Integer = (clMedGray, clGray); // RGB(255, 255, 255) - night mode (new March 17, 2019)
  help_text_selected_color: array[0..1] of Integer = (clGray, clrDarkSilver); // RGB(255, 255, 255) - night mode (new March 17, 2019) ... $00c5c5c5 color is unreadable!
  checked_framecolor: array[0..1] of Integer = ($00399bf7, $00399bf7);//, $00fce489);
  checked_innerframecolor: array[0..1] of Integer = ($00f1f1f1, $005d5d5d);// ($009ccefc, $009ccefc); // (new March 17, 2019)
  selection_frame_color: array[0..1] of Integer = ($0000b7ff, $0000a2ff); // RGB(255, 162, 0)   - night mode
  selection_singlecolor: array[0..1] of Integer = ($0000b7ff, $0000a2ff); // RGB(255, 162, 0)   - night mode
  selection_uppergradient_colorstart: array[0..1] of Integer = ($00daecfd, $00c6ddfa);  // RGB(250, 221, 198) - night mode
  selection_uppergradient_colorend: array[0..1] of Integer = ($00bde0fd, $00abd0fa);    // RGB(250, 208, 171) - night mode
  selection_lowergradient_colorstart: array[0..1] of Integer = ($0069ceff, $005db9ff);  // RGB(255, 185, 93)  - night mode
  selection_lowergradient_colorend: array[0..1] of Integer = ($009af6ff, $0085e7ff);    // RGB(255, 231, 133) - night mode
  selection_gradient_outerframecolor: array[0..1] of Integer = ($00f4f9fe, $00e9f2fc);  // RGB(252, 242, 233) - night mode (new March 17, 2019)
  selection_frame_round_ish_pixels: array[0..1] of Integer = ($0000dcff, $0000c9ff);    // RGB(255, 201, 0)   - night mode (new March 17, 2019)}

  // colors from Delphi 7 code panel
  // $00272727 - background color
  // $00bfdfe0 - white color
  // $00af912b - blue font
  // $008080ff - red font (light)
  // $001e1ee8 - red font (dark)
  // Lime      - green font
  // Gray      - comment font
  // Yellow    - simbols (, . : ' " \...)

var
  R, IconR, HelpTextR, TriangleR: TRect;
  ImageList: TCustomImageList;
  strShortCut, strHelpText: String;
  ShowHelpText, IsEnabled: Boolean;
  ShowDarkColors: Integer;
  strCaptionW, strHelpTextW: WideString;
  strCaptionW_Size, strHelpTextW_Size: TSize;

  procedure DrawCheckedPattern(Inflate: Boolean);
  var
    CheckRect: TRect;
  begin
    if (odChecked in State) and (AMenuItem.ImageIndex <> -1) then
    begin
      if Inflate then InflateRect(R, -2, -2);
      ACanvas.Brush.Color:= checked_framecolor[ShowDarkColors];
      ACanvas.Pen.Color:= ACanvas.Brush.Color;
      CheckRect:= ARect;
      case Assigned(ImageList) of
        True:
          begin
            case ImageList.Width of
              32: CheckRect.Right:= 40;
              30: CheckRect.Right:= 38; // added June 07, 2018
              28: CheckRect.Right:= 36;
              24: CheckRect.Right:= 32;
              16: CheckRect.Right:= 24;
            end;
          end;
        False: CheckRect.Right:= 24;
      end;

      // draw outer frame
      InflateRect(CheckRect, -2, -2);
      ACanvas.Brush.Style:= bsClear; // draw frame only
      ACanvas.RoundRect(CheckRect.Left, CheckRect.Top, CheckRect.Right, CheckRect.Bottom, 2, 2); // round corners

      // draw inner frame
      {InflateRect(CheckRect, -1, -1);
      ACanvas.Brush.Color:= BrightenColor(menu_background_color[ShowDarkColors], 5); //checked_innerframecolor[ShowDarkColors];
      ACanvas.Pen.Color:= ACanvas.Brush.Color;
      ACanvas.Brush.Style:= bsClear; // draw frame only
      ACanvas.Rectangle(CheckRect.Left, CheckRect.Top, CheckRect.Right, CheckRect.Bottom);
      if Inflate then InflateRect(R, 3, 3);}
       if Inflate then InflateRect(R, 2, 2);
    end;
  end;

  procedure DrawSubMenuTriangle;
  var
    Glyph: TBitmap;
    P: TPoint;
    OldBrushColor: TColor;
  begin
    Glyph := TBitmap.Create;
    try
      Glyph.Transparent := True;
      Glyph.Handle := LoadBitmap(HInstance, PChar(BcResourceSubMenuItem2));

      OldBrushColor := ACanvas.Font.Color;
      if odSelected in State then
         ACanvas.Font.Color := clBlack
      else
         ACanvas.Font.Color := clCream;

      //sbRect:= ARect;

      //R := Rect(ARect.Right - 8, ARect.Top, ARect.Right - 5, ARect.Bottom);

      P.X := TriangleR.Right - 12;
      P.Y := TriangleR.Top+((TriangleR.Bottom-TriangleR.Top) div 2)-6;

      ACanvas.Draw(P.X, P.Y, Glyph);
      ACanvas.Font.Color := OldBrushColor;
    finally
      FreeAndNil(Glyph);
    end;
  end;

begin
  DefaultDraw:= False;
  ACanvas.Lock;
  ShowDarkColors:= Ord(IsNightMode); // or Ord(ShowDarkPopupMenu);
  // menuitem drawing
  if not IsInTopMainMenu(AMenuItem) then
     begin
       with AMenuItem do
       begin
         ImageList:= GetImageList;
       end;
       IconR:= ARect;
       case Assigned(ImageList) of
         True:
           begin
             case ImageList.Width of
               32: IconR.Right:= 44;
               30: IconR.Right:= 42; // added June 07, 2018
               28: IconR.Right:= 40;
               24: IconR.Right:= 36;
               16: IconR.Right:= 26;
             end;
           end;
         False: IconR.Right:= 26;
       end;
       ACanvas.Brush.Color:= menu_background_color[ShowDarkColors];
       ACanvas.FillRect(IconR);
     end;
  strShortCut:= ShortCutToText(AMenuItem.ShortCut);
  strHelpText:= AMenuItem.Hint;
  ShowHelpText:= ((ARect.Bottom-ARect.Top) > 22) and (strHelpText <> '')
                  and (strHelpText <> AMenuItem.Caption); // small menu has height 22!

  strCaptionW:= DecodeUnicodeStr(AMenuItem.Caption);
  strHelpTextW:= DecodeUnicodeStr(AMenuItem.Hint);

  strCaptionW_Size:= TextExtentW(strCaptionW, ACanvas);
  strHelpTextW_Size:= TextExtentW(strHelpTextW, ACanvas);

  IsEnabled:= not ((odDisabled in State) or (odGrayed in State));

  TriangleR:= ARect;

  if (AMenuItem.Caption = cLineCaption) then
  begin
    // draw line with hints, background
    ACanvas.Brush.Color:= menu_background_color[ShowDarkColors];
    case Assigned(ImageList) of
      True:
        begin
          case ImageList.Width of
            32: ARect.Left:= 44;
            30: ARect.Left:= 42; // added June 07, 2018
            28: ARect.Left:= 40;
            24: ARect.Left:= 36;
            16: ARect.Left:= 26;
          end;
        end;
      False: ARect.Left:= 26;
    end;
    ACanvas.FillRect(ARect);

    // align the text and draw it
    R:= ARect;
    R.Left:= (R.Right - strHelpTextW_Size.cx - 15);
    //R.Left:= (R.Right - TextExtentW(strHelpTextW, ACanvas).cx - 15); // R.Left:= (R.Right - ACanvas.TextWidth(AMenuItem.Hint) - 15);
    ACanvas.Brush.Style:= bsClear;
    ACanvas.Font.Color:= hint_text_color[ShowDarkColors];
    DrawTextW(ACanvas.Handle, PWideChar(strHelpTextW), Length(strHelpTextW), R, 0);

    // draw the line so that it won't draw over text
    R:= ARect;
    Inc(R.Top, (R.Bottom - R.Top) div 2);
    R.Bottom:= R.Top + 1;
    Dec(R.Right, strHelpTextW_Size.cx + 20);
    //Dec(R.Right, TextExtentW(strHelpTextW, ACanvas).cx + 20); // Dec(R.Right, ACanvas.TextWidth(AMenuItem.Hint) + 20);
    ACanvas.Brush.Color:= hint_line_color[ShowDarkColors];
    ACanvas.FillRect(R);
  end else
  begin
    with ACanvas do
    begin
      // draw selected items
      if AMenuItem.Default then
         Font.Style:= Font.Style+[fsBold];
      R:= ARect;
      if (odSelected in State) then
      begin
        // draw frame and selection band
        Brush.Style:= bsClear;
        Brush.Color:= selection_frame_color[ShowDarkColors]; // border frame of selection band
        Pen.Color:= selection_frame_color[ShowDarkColors];

        // round corners... always
        RoundRect(R.Left, R.Top, R.Right, R.Bottom, 2, 2);
        // FrameRect(R); no round corners

        InflateRect(R, -1, -1);
        Brush.Color:= selection_singlecolor[ShowDarkColors];

        // ACanvas.FillRect(R); // solid background color
        DrawGradient(ACanvas, R, gsVertical, True,
                     selection_uppergradient_colorstart[ShowDarkColors], selection_uppergradient_colorend[ShowDarkColors],
                     selection_lowergradient_colorstart[ShowDarkColors], selection_lowergradient_colorend[ShowDarkColors],
                     selection_gradient_outerframecolor[ShowDarkColors]);

        // single pixels to make selection border frame more round-ish
        // needs to be draw AFTER calling DrawGradient
        Pixels[R.Left, R.Top]:= selection_frame_round_ish_pixels[ShowDarkColors];
        Pixels[R.Right-1, R.Top]:= selection_frame_round_ish_pixels[ShowDarkColors];
        Pixels[R.Left, R.Bottom-1]:= selection_frame_round_ish_pixels[ShowDarkColors];
        Pixels[R.Right-1, R.Bottom-1]:= selection_frame_round_ish_pixels[ShowDarkColors];

        DrawCheckedPattern(False);
        InflateRect(R, 0, 1); // this is needed to avoid text moving 1 pixel to left, top
        case IsInTopMainMenu(AMenuItem) of
          True : Inc(R.Left, 5);
          False:
            begin
              case Assigned(ImageList) of
                True:
                  begin
                    case ImageList.Width of
                      32: Inc(R.Left, 40);
                      30: Inc(R.Left, 38); // added June 07, 2018
                      28: Inc(R.Left, 36);
                      24: Inc(R.Left, 32);
                      16: Inc(R.Left, 24);
                    end;
                  end;
                False: Inc(R.Left, 24);
              end;
            end;
        end;
        //InflateRect(R, 0, 1); // this is needed to avoid text moving 1 pixel to left, top
        Font.Color:= item_caption_selected_color[ShowDarkColors]; // caption color
      end else
      begin
        // draw not selected items
        // draw background
        case IsInTopMainMenu(AMenuItem) of
          True : Brush.Color:= clBtnFace;
          False: Brush.Color:= menu_background_color[ShowDarkColors]; // menu background
        end;

        if not IsInTopMainMenu(AMenuItem) then
           begin
             // change where caption will appear
             case Assigned(ImageList) of
               True:
                 begin
                   case ImageList.Width of
                     32: R.Left:= 41;
                     30: R.Left:= 39; // added June 07, 2018
                     28: R.Left:= 37;
                     24: R.Left:= 33;
                     16: R.Left:= 25;
                   end;
                 end;
               False: R.Left:= 25;
             end;
           end;
        ACanvas.FillRect(R);
        //DrawGradient(ACanvas, ARect, 16777215, 15657958, gsHorizontal); // gradient menu bk
        DrawCheckedPattern(True);

        case IsInTopMainMenu(AMenuItem) of
          True : Inc(R.Left, 6);
          False: Inc(R.Left, 0); // leave space for menuitem image
        end;
        Font.Color:= item_caption_active_color[ShowDarkColors]; // caption color
      end;
      if (odDisabled in State) or (odGrayed in State) then
         Font.Color:= item_caption_disabled_color[ShowDarkColors];

      if not IsInTopMainMenu(AMenuItem) and (AMenuItem.Count > 0) then
         DrawSubmenuTriangle;

      // draw caption
      Brush.Style:= bsClear;
      if ShowHelpText then
         begin
           HelpTextR:= R;
           InflateRect(R, 0, -2);
           DrawTextW(Handle, PWideChar(strCaptionW), Length(strCaptionW), R, 0);
           ACanvas.Font.Size:= ACanvas.Font.Size-1;
           if not (odDisabled in State) and (odSelected in State) then
              ACanvas.Font.Color:= help_text_selected_color[ShowDarkColors] // paint help text with gray color
           else
              begin
                if not (odDisabled in State) then
                   ACanvas.Font.Color:= help_text_color[ShowDarkColors] // paint help text with gray color
                else
                   ACanvas.Font.Color:= item_caption_disabled_color[ShowDarkColors]; //use gray color here ???!!! (March 17, 2019) clGray; // paint help text with gray color
              end;
           if AMenuItem.Default then
              ACanvas.Font.Style:= [];

           HelpTextR.Top:= HelpTextR.Top+strHelpTextW_Size.cy-1; // HelpTextR.Top:= HelpTextR.Top+ACanvas.TextHeight(strHelpText)-1;
           DrawTextW(Handle, PWideChar(strHelpTextW), Length(strHelpTextW), HelpTextR, 0);
           ACanvas.Font.Size:= ACanvas.Font.Size+1;
         end
      else
         begin
           InflateRect(R, 0, -((R.Bottom - R.Top - strCaptionW_Size.cy) div 2)); // InflateRect(R, 0, -((R.Bottom - R.Top - TextHeight(AMenuItem.Caption)) div 2));
           DrawTextW(Handle, PWideChar(strCaptionW), Length(strCaptionW), R, 0);
         end;

      if strShortCut <> '' then
         begin
           if odSelected in State then
              R.Left:= R.Right-(ACanvas.TextWidth(strShortCut)+11)
           else
              R.Left:= R.Right-(ACanvas.TextWidth(strShortCut)+12);

           //ACanvas.Font.Size:= ACanvas.Font.Size-1; // commented this so shortcut text will right-align correctly (do not remove)
           if (odDisabled in State) or (odGrayed in State) then
              ACanvas.Font.Color:= item_caption_disabled_color[ShowDarkColors]
           else
              begin
                if (odSelected in State) then
                   ACanvas.Font.Color:= item_shortcut_selected_color[ShowDarkColors]
                else
                   ACanvas.Font.Color:= item_shortcut_color[ShowDarkColors];
              end;

           if AMenuItem.Default then
              ACanvas.Font.Style:= [];
           //R.Top:= R.Top+1; // keep commented
           DrawText(Handle, PChar('['+strShortCut+']'), Length(strShortCut)+2, R, 0);
         end;

      // option_check.ico         -> 00
      // option_radiogroup_on.ico -> 01

      // draw menuitem image
      with AMenuItem do
      begin
        if Assigned(ImageList) then
           begin
             if ImageIndex <> -1 then
                begin
                  if (AMenuItem = MenuCustomPlayReadUsageRules) or (AMenuItem = MenuCustomPlayEditFlipListFile) then
                     begin
                       // show 16x16 icons instead of 24x24 for "Play (Custom Emulators)" sub-menu (PopupMenuGamesList)
                       ImageList:= IL_MenuPopup; // set custom image before drawing it!
                       ImageList.Draw(ACanvas, ARect.Left + 4,
                                      ARect.Top + (ARect.Bottom - ARect.Top - ImageList.Height) div 2, ImageIndex, IsEnabled);
                     end
                  else
                     ImageList.Draw(ACanvas, ARect.Left + 4,
                                    ARect.Top + (ARect.Bottom - ARect.Top - ImageList.Height) div 2, ImageIndex, IsEnabled);
                end
             else
                begin
                  if odChecked in State then
                     begin
                       case AMenuItem.RadioItem of
                         True : ImageList.Draw(ACanvas, ARect.Left + 4,
                                               ARect.Top + (ARect.Bottom - ARect.Top - ImageList.Height) div 2, 01, IsEnabled); // radio group
                         False: ImageList.Draw(ACanvas, ARect.Left + 4,
                                               ARect.Top + (ARect.Bottom - ARect.Top - ImageList.Height) div 2, 00, IsEnabled); // check box
                       end;
                     end;
                end;
           end;
      end;
    end;
  end;
  ACanvas.UnLock;
end;

procedure TFormMain.BcDrawModuleMeasureMenuItem(Sender: TObject;
  AMenuItem: TMenuItem; ACanvas: TCanvas; var Width, Height: Integer;
  ABarVisible: Boolean; var DefaultMeasure: Boolean);
var
  ImageList: TCustomImageList;
  FullWidth, CaptionWidth: Integer;
  strShortCut: String;

  strCaptionW, strHelpTextW: WideString;
  function SetItemHeight: Boolean;
  begin
    Result:= True;
    case ImageList.Width of
      32: Height:= 38;
      30: Height:= 34; // added June 07, 2018
      28: Height:= 32;
      24: Height:= 34;
      16: Height:= 22;
    end;
  end;

begin
  if IsInTopMainMenu(AMenuItem) then
     Exit;
  DefaultMeasure:= False;
  if AMenuItem.Caption = cLineCaption then
     Exit;
  FullWidth:= Width;

  if AMenuItem = PopupScanForceSelectedGamesAvailable then
     begin
       FullWidth:= Width;
     end
  else
  if AMenuItem.Hint <> '' then
     begin
       strCaptionW:=  DecodeUnicodeStr(AMenuItem.Caption);
       strHelpTextW:= DecodeUnicodeStr(AMenuItem.Hint);

       CaptionWidth:= TextExtentW(strCaptionW, ACanvas).cx; // CaptionWidth:= ACanvas.TextWidth(AMenuItem.Caption);
       FullWidth:= TextExtentW(strHelpTextW, ACanvas).cx; // FullWidth:= ACanvas.TextWidth(AMenuItem.Hint);
       if AMenuItem = PopupEnableFavorites then
          begin
            // special treatment for the popup "Enable Favorites" in tool bar button
            strShortCut:= ShortCutToText(AMenuItem.ShortCut);
            if strShortCut <> '' then
               CaptionWidth:= CaptionWidth+ACanvas.TextWidth(strShortCut);
          end;
       if FullWidth > CaptionWidth then
          FullWidth:= FullWidth-10 // add -10 to reduce width a little bit
       else
          FullWidth:= Width;
     end;

  ImageList:= AMenuItem.GetImageList;
  case Assigned(ImageList) of
    True:
      begin
        if (AMenuItem.Parent = PopupPlayGameWithCustomSystem) then
        begin
          if (AMenuItem.HelpContext = 50) then
             Height:= 24 //Height:= 22  // modified June 07, 2018
          else
          if AMenuItem.Hint = '' then
             Height:= 24 //Height:= 22  // modified June 07, 2018
          else
             SetItemHeight;
        end
        else
        begin
          if (AMenuItem = PopupSelectScanGamesMode) or (AMenuItem = PopupAutoRunGameAlterMAME) or (AMenuItem = PopupAutoRunGameAlterMAME2) or (AMenuItem = PopupVideoPreviewPlay) or
             (AMenuItem = PopupEnableAutoRunCustomGamesWithMAME) or
             (AMenuItem.Parent = PopupGameIconSize) or (AMenuItem.Parent = PopupTilesViewGameIconsSize) or (AMenuItem = PopupDeleteSelectedGamesFromGamesList) or
             (AmenuItem = PopupMachinesListSidePanelFiltersMachinesList_Customize) then
             Height:= 34 // old value = 32 (changed June 09, 2019)
          else
          if (AMenuItem.GetParentMenu = MainMenuOptions) or ((AMenuItem.GetParentMenu = PopupMenuViewMode) and (not AMenuItem.RadioItem)) or
             (AMenuItem.GetParentMenu = PopupFilterGameTitle) or (AMenuItem.Parent = PopupSelectGameStartup) or (AMenuItem.Parent = PopupThumbnails) or
             (AMenuItem.GetParentMenu = PopupMenuImages) or
             (AMenuItem.GetParentMenu.Name = 'PopupMenuOptions') // for "Systems View Mode" options popup menus (various screens)
             then
             begin
               if AMenuItem.Hint <> '' then
                  Height:= 34 // old value = 32 (changed June 09, 2019)
               else
                  Height:= 24 //Height:= 22; // modified June 07, 2018
             end
          else
             SetItemHeight;
        end;
        Width:= FullWidth+ImageList.Width;
      end;
    False:
      begin
        Height:= 24; //Height:= 22; // modified June 07, 2018
        Width:= Width+16;
      end;
  end;
end;

function TFormMain.SelectFileName(FeatureIndex: Byte; sysID: ShortInt; const EmuFileStr: String; out SelectedFileName: String; CustomFolders: String = ''): Boolean;
var
  tempList: THashedStringList;
  ListFolders: TStringList;
  destFolder, destFile, SoftwareNameFolder: String;
  Loop: Integer;
  iDir: String;
begin
  // FeatureIndex (all MAME related)
  // 20: Playback Input
  // 21: Record Input
  // 22: Load Save State (not used anymore)...............
  // 23: Record Wave Output (run game)
  // 24: Record MNG Ouput (run game)
  // 25: Record AVI Output (run game)
  // 26: not used anymore.... used to be left panel
  // 27: Play with Effect Overlay (run game)... uses "ArtworkDir"
  // 28: Select Effect Overlay (MAME Settings)... uses "ArtworkDir"
  // 29: Select Font Files, .BDF (MAME Settings, emulator settings)
  // 30: Select Font Files, game, driver, .BDF (MAME Settings)
  // 31: Select HLSL Shadow Mask Texture (MAME Settings)... uses "ArtworkDir"
  // 32: Select BGFX Shadow Mask Texture (MAME Settings)... uses "ArtworkDir"
  // 33: Tool Bar Overlay icons (games filters and image categories)

  // March 16, 2016 -> I need to pass sysID, emulator filename (not just from uMain.EmulatorFile[] array)
  // this feature is used only in the uMain.ExecuteGame() function and in MAME settings screen, and the MemGameInfo var is filled with current
  // selected game
  // the "GameName" parameter here is NOT needed
  Result:= False;
  SelectedFileName:= '';
  destFolder:= '';
  destFile:= '';
  SoftwareNameFolder:= '';
  if not (FeatureIndex in [26, 28..32]) then
     begin
       if not ValidateSelectedGame then
          Exit;
     end;
  if FeatureIndex in [29, 30] then
     begin
       if CustomFolders = '' then
          Exit;
     end;

  if FeatureIndex in [20, 21, 22, 23..32] then
     tempList:= THashedStringList.Create;

  if FeatureIndex in [20, 21, 22, 23, 24, 25] then
  begin
    if MemGameInfo.eSoftwareName <> '' then
       SoftwareNameFolder:= MemGameInfo.eSoftwareName+'\'+MemGameInfo.eName+'\';
  end;

  case FeatureIndex of
    20, 21: // Playback input; record input
      begin
        iDir:= LoadFolderSpecial_MAME(sysID, EmuFileStr, 1);
        if iDir <> '' then
           begin
             iDir:= FullFolderFix(iDir, EmuFileStr);
             GetFilesList(iDir+SoftwareNameFolder, '.inp', '*.inp', tempList, False, True, True);
           end;
      end;
    22: // load a Save state file
      begin
        iDir:= LoadFolderSpecial_MAME(sysID, EmuFileStr, 3);
        if iDir <> '' then
           begin
             iDir:= FullFolderFix(iDir, EmuFileStr);
             GetFilesList(iDir+SoftwareNameFolder, '.sta', '*.sta', tempList, False, True, True);
           end;
      end;
    23: GetFilesList(GetFolderFull(1, MemGameInfo.eSystemID)+'multimedia_files\'+SoftwareNameFolder, '.wav', '*.wav', tempList, False, True, True);
    24: GetFilesList(GetFolderFull(1, MemGameInfo.eSystemID)+'multimedia_files\'+SoftwareNameFolder, '.mng', '*.mng', tempList, False, True, True);
    25: GetFilesList(GetFolderFull(1, MemGameInfo.eSystemID)+'multimedia_files\'+SoftwareNameFolder, '.avi', '*.avi', tempList, False, True, True);
    {26:
      begin
        // load a left panel file... not used anymore. need to delete this
        GetFilesList(GetLeftPanelFolder, '.ini', '*.ini', tempList, False, True, True);
        if tempList.Count = 0 then
           begin
             FreeAndNil(tempList);
             GenerateMessage('[INFO] Select a File', 'Edit a left panel filter.',
                             'No filter files were found!'+#13#10+
                             'Search path: '+GetLeftPanelFolder, 2);
             Exit;
           end;
      end;}
    27..32:
      begin
        case FeatureIndex of
          27, 28, 31, 32:
            begin
              //ListFolders:= THashedStringList.Create;
              //ListFolders.AddStrings(ArtworksDir[Ord(sysID = idMAME)]); // ArtworksDir[] array is not used anymore (March 17, 2016)
              iDir:= LoadFolderSpecial_MAME(sysID, EmuFileStr, 0);
              ExtractFolders2MAME(sysID, iDir, ListFolders, True, EmuFileStr);

              //ListFolders.AddStrings(ArtworksDir[Ord(MemGameInfo.eSystemID = idMAME)]); // not used anymore (March 17, 2016)
              //ExtractFolders2MAME(sysID, ArtworksDir[Ord(sysID = idMAME)], ListFolders); // not used anymore
            end;
          29, 30: ExtractFolders2MAME(sysID, CustomFolders, ListFolders, True, EmuFileStr);
          //29, 30: ExtractFolders2MAME(MemGameInfo.eSystemID, CustomFolders, ListFolders);
        end;
        if Assigned(ListFolders) and (ListFolders.Count > 0) then
           begin
             for Loop:=0 to ListFolders.Count-1 do
             begin
               if DirectoryExists(ListFolders[Loop]) then
                  begin
                    case FeatureIndex of
                      27, 28, 31, 32: GetFilesList(ListFolders[Loop], '.png', '*.png', tempList, False, False, True);
                      29, 30: GetFilesList(ListFolders[Loop], '.bdf', '*.bdf', tempList, False, False, True);
                    end;
                  end;
             end;
           end;
        FreeAndNil(ListFolders);
      end;
  end;

  case FeatureIndex of
    20..22, 23..32:
      begin
        // 20: Playback Input... uses "iDir"
        // 21: Record Input ... uses "iDir"
        // 22: Load Save State (not used anymore)
        // 23: Record Wave Output (run game)
        // 24: Record MNG Ouput (run game)
        // 25: Record AVI Output (run game)
        // 26: not used anymore.... used to be left panel
        // 27: Play with Effect Overlay (run game)... uses "iDir"
        // 28: Select Effect Overlay (MAME Settings)... uses "iDir"
        // 29: Select Font Files, .BDF (MAME Settings, emulator settings)
        // 30: Select Font Files, game, driver, .BDF (MAME Settings)
        // 31: Select HLSL Shadow Mask Texture (MAME Settings)... uses "iDir"
        // 32: Select BGFX Shadow Mask Texture (MAME Settings)... uses "ArtworkDir"
        FormSelectFile:= TFormSelectFile.Create(nil);
        FormSelectFile.Tag:= FeatureIndex;
        if FormSelectFile.Tag = 20 then
           begin
             FormSelectFile.LabelNewFilename.Caption:= 'Filename To Use (file extension not required)';
             FormSelectFile.LabelNewFilename.Enabled:= False;
             FormSelectFile.NewFilename.Enabled:= False;
           end;

        case FormSelectFile.Tag of
          20..22, 23, 24, 25, 27: // 26,
            begin
              // run game
              FormSelectFile.sysID:= MemGameInfo.eSystemID;
              IL_ArcadeSystem_Large.GetIcon(MemGameInfo.eSystemID, FormSelectFile.SystemIcon.Picture.Icon);
              FormSelectFile.LabelGameTitle.Caption:= MemGameInfo.eTitle;
              FormSelectFile.LabelEmulatorVersion.Caption:= StatusBar_GamesGameName.Caption;
            end;
          28..32:
            begin
              // select a file in MAME Settings screen... can be from a game or MAME
              // these indexes are not used anywhere else!!!
              if FormMAMESettings.Tag = 0 then
                 begin
                   // is emulator settings
                   FormSelectFile.sysID:= FormMAMESettings.sysID;
                   IL_ArcadeSystem_Large.GetIcon(FormMAMESettings.sysID, FormSelectFile.SystemIcon.Picture.Icon);
                   FormSelectFile.LabelGameTitle.Caption:= GetArcadeEmulatorDescription(FormMAMESettings.sysID, True);
                   FormSelectFile.LabelEmulatorVersion.Caption:= EmuFileStr; //EmulatorFile[FormMAMESettings.sysID];
                 end
              else
                 begin
                   // is game/driver settings
                   FormSelectFile.sysID:= MemGameInfo.eSystemID;
                   IL_ArcadeSystem_Large.GetIcon(MemGameInfo.eSystemID, FormSelectFile.SystemIcon.Picture.Icon);
                   FormSelectFile.LabelGameTitle.Caption:= MemGameInfo.eTitle;
                   FormSelectFile.LabelEmulatorVersion.Caption:= StatusBar_GamesGameName.Caption;
                 end;
            end;
        end;

        if FeatureIndex = 22 then
           FormSelectFile.FilesFolder.Caption:= iDir+SoftwareNameFolder;
        case FeatureIndex of
          20, 21: FormSelectFile.FilesFolder.Caption:= iDir+SoftwareNameFolder;
          23, 24, 25: FormSelectFile.FilesFolder.Caption:= GetFolderFull(1, MemGameInfo.eSystemID)+'multimedia_files\'+SoftwareNameFolder;
          //26:
          //  begin
          //    FormSelectFile.LabelGameTitle.Caption:= 'Select a file to edit in the left panel editor.';
          //    FormSelectFile.FilesFolder.Text:= GetLeftPanelFolder;
          //    FormSelectFile.LabelNewFilename.Visible:= False;
          //    FormSelectFile.NewFilename.Visible:= False;
          //  end;
          27, 28..32, 22:
            begin
              FormSelectFile.LabelNewFilename.Visible:= False;
              FormSelectFile.NewFilename.Visible:= False;
              FormSelectFile.Height:= FormSelectFile.Height-24;
            end;
        end;
        if Assigned(tempList) then
           begin
             FormSelectFile.tmpList.Assign(tempList);
             FreeAndNil(tempList);
           end;
        case FeatureIndex of
          20: FormSelectFile.Caption:= 'Run Game and Playback Input';
          21: FormSelectFile.Caption:= 'Run Game and Record Input';
          22: FormSelectFile.Caption:= 'Load a Save State File';
          23: FormSelectFile.Caption:= 'Run Game and Record Wave Output';
          24: FormSelectFile.Caption:= 'Run Game and Record MNG Output';
          25: FormSelectFile.Caption:= 'Run Game and Record AVI Output';
          //26: FormSelectFile.Caption:= 'Left Panel Filter File';
          27: FormSelectFile.Caption:= 'Run Game with Effect Overlay File';
          28: FormSelectFile.Caption:= 'Select an Effect Overlay File';
          29, 30: FormSelectFile.Caption:= 'Select an User Interface Font File';
          31: FormSelectFile.Caption:= 'Select a HLSL Shadow Mask Texture File';
          32: FormSelectFile.Caption:= 'Select a BGFX Shadow Mask Texture File';
        end;

        FormSelectFile.ShowModal;
        if FormSelectFile.MsgResult = mrOk then
           begin
             if FormSelectFile.NewFilename.Text <> '' then
                begin
                  case FeatureIndex of
                    23: SelectedFileName:= FormSelectFile.FilesFolder.Caption+ChangeFileExt(FormSelectFile.NewFilename.Text, '.wav');
                    24: SelectedFileName:= 'multimedia_files\'+SoftwareNameFolder+ChangeFileExt(FormSelectFile.NewFilename.Text, '.mng');
                    25: SelectedFileName:= 'multimedia_files\'+SoftwareNameFolder+ChangeFileExt(FormSelectFile.NewFilename.Text, '.avi');
                    //26: SelectedFileName:= ChangeFileExt(FormSelectFile.NewFilename.Text, '.ini');
                    29, 30, 22: SelectedFileName:= ChangeFileExt(FormSelectFile.NewFilename.Text, '');
                    else
                        SelectedFileName:= SoftwareNameFolder+FormSelectFile.NewFilename.Text; // 20, 21, 27, 28 (effect overlay options), 31 (shadow mask texture option)
                  end;
                  Result:= True;
                end;
           end;
        FreeAndNil(FormSelectFile);
      end;
  end;
end;

