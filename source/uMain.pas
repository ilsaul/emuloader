         //HaveCHDs:= False;
         HaveROMs:= ROMsTemp.Count > 0;
         if HaveROMs then
         begin
           TEasyGameInfo(Item).eROMInfo:= TStringList.Create;

           TEasyGameInfo(Item).eROMInfo.BeginUpdate;
           for Loop:=0 to ROMsTemp.Count-1 do
           begin
             romName:= ROMsTemp.Names[Loop];
