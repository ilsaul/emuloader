procedure TFormMain.SetImageScaleMode;
var
  iLoop: Integer;

  procedure UpdateScale(ImageHolder: TImage32);
  begin
    case PopupImageStretch.Checked of
      True:
        begin
          case PopupImagesDisableAspectRatio.Checked of
            True:
              begin
                if ImageHolder.ScaleMode <> smStretch then
                   ImageHolder.ScaleMode:= smStretch;
              end;
            False:
              begin
                case PopupImageStretchLarger.Checked of
                  True:
                    begin
                      if (ImageHolder.Bitmap.Width > ImageHolder.Width) or (ImageHolder.Bitmap.Height > ImageHolder.Height) then
                         begin
                           if ImageHolder.ScaleMode <> smResize then
                              ImageHolder.ScaleMode:= smResize
                         end
                      else
                         begin
                           if ImageHolder.ScaleMode <> smNormal then
                              ImageHolder.ScaleMode:= smNormal;
                         end;
                    end;
                  False:
                    begin
                      if ImageHolder.ScaleMode <> smResize then
                         ImageHolder.ScaleMode:= smResize;
                    end;
                end;
              end;
          end;
        end;
      False:
        begin
          if ImageHolder.ScaleMode <> smNormal then
             ImageHolder.ScaleMode:= smNormal;
        end;
    end;
    if (PopupImageStretch.Tag = 0) and (not IsStartup) then
       FocusGamesList;
  end;

begin
  UpdateScale(Images);
  for iLoop:= Low(ImageScr) to High(ImageScr) do
  begin
    if Assigned(ImageScr[iLoop]) then
       UpdateScale(ImageScr[iLoop]);
  end;
end;

function TFormMain.GetImageName(const GameName: String; ImageIndex: ShortInt; FormatIndex: ShortInt; SoftwareName: String = ''): String;
var
  SoftwareFolder: String;
begin
  SoftwareFolder:= '';
  if SoftwareName <> '' then
     SoftwareFolder:= SoftwareName+'\';
  case FormatIndex of
    0: // Emu Loader Format [elevator0005.png]
      begin
        if ImageIndex = 1 then
           Result:= SoftwareFolder+GameName
        else
           Result:= SoftwareFolder+GameName+Format('%.4u', [ImageIndex-2]);
      end;
    1: Result:= SoftwareFolder+GameName+'\'+Format('%.4u', [ImageIndex-1]); // MAME Format [elevator\0005.png]
  end;
end;

procedure TFormMain.CycleImageCategory(MoveForward: Boolean);
var
  CategoryEnabled: Boolean;
  ImgIndex: ShortInt;
begin
  if not IsSingleImageLayout then
     Exit;
  if ButtonInternetGameInfo.Down then
     Exit;
     
  ImgIndex:= ButtonImageCategory.Tag;
  repeat
    case MoveForward of
      True: // next type
        begin
          Inc(ImgIndex);
          if ImgIndex > High(ImageCategoryArray) then
             ImgIndex:= 0;
        end;
      False: // previous type
        begin
          Dec(ImgIndex);
          if ImgIndex < Low(ImageCategoryArray) then
             ImgIndex:= High(ImageCategoryArray);
        end;
    end;
    CategoryEnabled:= ImageCategorySettings[ImgIndex].Visible;
    if CategoryEnabled then
       CallSelectImageCategory(ImgIndex, True, False, False, True);
  until CategoryEnabled;
end;

function TFormMain.VerifyZipType(ZipString: String; GetFolder: Boolean; FullZipPath: Boolean = False): String;
begin
  case SameText(ExtractFileExt(ZipString), '.zip') of
    True:
      begin
        case GetFolder of
          True: Result:= ExtractFilePath(ZipString);
          False:
            begin
              case FullZipPath of
                True : Result:= ZipString;
                False: Result:= ExtractFileName(ZipString);
              end;
            end;
        end;
      end;
    False:
      begin
        case GetFolder of
          True : Result:= ZipString;
          False: Result:= 'dummy.zip'; // assign a dummy filename... for what exactly I can't remember (February 17, 2018)
        end;
      end;
  end;
end;

function TFormMain.GetFolderFull(const FolderType: ShortInt; SystemID: Integer = -1): String;
begin
  case FolderType of
    0..Length(imgFolder[SystemID])-1: Result:= imgFolder[SystemID, FolderType];
    //30: Result:= FormPreferences.FolderPCBInfo.Text; // index for future use ?
    //31: Result:= FormPreferences.FolderGamesFAQ.Text; // index for future use ?
    32: Result:= FrontendPath+'resources\main_icons\'; // Frontend Icons Folder
    33: Result:= FrontendPath+'resources\gameslist_icons\'; // Default Game Icons
    34: Result:= GetConsoleComputerFolder+'system_icons\'; // for console/computer systems from EmuCon (January 01, 2017)
    35: Result:= FrontendPath+'resources\images\'; // Images Folder
    36: Result:= GetConsoleComputerFolder+'icons\'; // for custom emulators feature (January 02, 2017)
    37: Result:= FrontendPath+'docs\console_computer\special_rules\'; // special system rules (EmuCon)
    38: Result:= GetConsoleComputerFolder+'game_cfg\';
    39: Result:= GetConsoleComputerFolder+'played_games\';
    40: Result:= FrontendPath+'resources\main_icons\toolbar_filters\'; // frontend tool bar filter icons
    41: Result:= GetArcadeFolder+'played_games\';
    42: Result:= GetArcadeFolder+'db_xml\';
    43: Result:= GetArcadeFolder+'filters\'; // for arcade systems (April 03, 2017)
  end;
  if not (FolderType > 31) then //  in [32..35]) then
     begin
       if (Result <> '') and (SystemID <> -1) then
          Result:= FullEmuFolderFix(Result, SystemID, True); // for zipped images
     end;
end;

