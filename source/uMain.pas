procedure TFormMain.PopupRenameCurrentImageClick(Sender: TObject);
var
  Result, FileExtensionStr: String;
begin
  if not ValidateSelectedGame then
     Exit;

  Result:= '';
  if not Assigned(FormImageDeleteRename) then
     FormImageDeleteRename:= TFormImageDeleteRename.Create(nil);
  FormImageDeleteRename.Tag:= 1; // 0 -> delete image; 1 -> rename image
  FormImageDeleteRename.LabelFilename.Hint:= ImageDetails[PopupMenuImages.Tag].FileName;
  FileExtensionStr:= ExtractFileExt(ImageDetails[PopupMenuImages.Tag].FileName);
  FormImageDeleteRename.ImageCategoryIcon.Tag:= ImageDetails[PopupMenuImages.Tag].ImageCategoryIndex;

  FormImageDeleteRename.ShowModal;
  if FormImageDeleteRename.mmResult = mrOk then
     begin
       Result:= FormImageDeleteRename.RenameImageEditBox.Text;
       if Result = '' then
          begin
            FreeAndNil(FormImageDeleteRename);
            Exit;
          end;
       Result:= ChangeFileExt(Result, FileExtensionStr); // make sure the file extension is the same

       //if not SameText(ExtractFileExt(Result), FileExtensionStr) then
       //   Result:= ChangeFileExt(Result, FileExtensionStr); // make sure the file extension is the same

       if not SameText(Result, ExtractFileName(ImageDetails[PopupMenuImages.Tag].FileName)) then
          begin
            RenameFile(ImageDetails[PopupMenuImages.Tag].FileName, ExtractFilePath(ImageDetails[PopupMenuImages.Tag].FileName)+Result);
            Sleep(50);
            ToggleImagesPanel(True);
            //MenuShowImages.OnClick(Self);
          end;
     end;
  FreeAndNil(FormImageDeleteRename);
end;

procedure TFormMain.PopupDeleteCurrentImageClick(Sender: TObject);
begin
  if Sender is TToolButton then
     PopupMenuImages.Tag:= 1;
  if not ValidateSelectedGame then
     Exit;

  if not Assigned(FormImageDeleteRename) then
     FormImageDeleteRename:= TFormImageDeleteRename.Create(nil);
  FormImageDeleteRename.Tag:= 0; // 0 -> delete image; 1 -> rename image
  FormImageDeleteRename.LabelFilename.Hint:= ImageDetails[PopupMenuImages.Tag].FileName;
  FormImageDeleteRename.ImageCategoryIcon.Tag:= ImageDetails[PopupMenuImages.Tag].ImageCategoryIndex;
  FormImageDeleteRename.ShowModal;
  if FormImageDeleteRename.mmResult = mrOk then
     begin
       DeleteFile(ImageDetails[PopupMenuImages.Tag].FileName);
       Sleep(50);
       ToggleImagesPanel(True);
       //MenuShowImages.OnClick(Self);
     end;
  FreeAndNil(FormImageDeleteRename);
end;

procedure TFormMain.LoadMessageIcon(Dest: TImage; const Filename: String; IsMainIconFolder: Boolean = False);
var
  Icon32: TExIcon;
  tmpIcon: TIcon;
  Loop: Integer;
  iFolder: String;
  //ColorDepth: TPixelFormat;
begin
  iFolder:= GetFolderFull(32);
  if not IsMainIconFolder then
     iFolder:= iFolder+'msgbox_icons\';
     
  if not FileExists(iFolder+Filename) then
     begin
       Dest.Picture.Icon:= nil;
       Exit;
     end;
  Icon32:= TExIcon.Create;
  Icon32.LoadFromFile(iFolder+Filename);
  for Loop:=0 to Icon32.ImageCount-1 do
  begin
    if (Icon32.Images[Loop].Width = Dest.Width) and
       (Icon32.Images[Loop].Height = Dest.Height) and
       (Icon32.Images[Loop].PixelFormat = pf32bit) then
       begin
         Icon32.CurrentImage:= Loop;
         tmpIcon:= TIcon.Create;
         tmpIcon.Handle:= Icon32.Handle;
         Dest.Picture.Icon:= tmpIcon;
         Icon32.ReleaseHandle;
         FreeAndNil(tmpIcon);
         Break;
       end;
  end;
  FreeAndNil(Icon32);
end;

