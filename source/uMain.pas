  function GetStatusIndex(const StatusString: String): ShortInt;
  begin
    Result:= -1;
    if SameText(StatusString, 'good') then
       Result:= 0
    else
    if SameText(StatusString, 'imperfect') then
       Result:= 1
    else
    if SameText(StatusString, 'preliminary') then
       Result:= 2;
  end;

  function GetScreenTypeIndex(const ScreenTypeString: String): Integer;
  begin
    Result:= -1;
    if SameText(ScreenTypeString, 'raster') then
       Result:= 0
    else
    if SameText(ScreenTypeString, 'vector') then
       Result:= 1
    else
    if SameText(ScreenTypeString, 'lcd') then
       Result:= 2
    else
    if SameText(ScreenTypeString, 'svg') then
       Result:= 3
    else
    if SameText(ScreenTypeString, 'unknown') then
       Result:= 4
    else
       begin
         if WarningMessagesList.Count > 0 then
            begin
              if WarningMessagesList.IndexOf('New screen type found: '+ScreenTypeString) = -1 then
                 begin
                   WarningMessagesList.Add(#13#10);
                   WarningMessagesList.Add('New screen type found: '+ScreenTypeString);
                 end;
            end
         else
            WarningMessagesList.Add('New screen type found: '+ScreenTypeString);

         {CallMessageBox;
         AddMsgText('New screen type found: ');
         AddMsgText(ScreenTypeString, $00a65300, [fsBold]);
         AddMsgText(#13#10+'Game: ');
         AddMsgText(TempGameVars.eTitle, $00a65300, [fsBold]);
         AddMsgText(#13#10+'Name: ');
         AddMsgText(TempGameVars.eName, $00a65300, [fsBold]);
         AddMsgText(#13#10+'Driver: ');
         AddMsgText(TempGameVars.eDriverName, $00a65300, [fsBold]);
         AddMsgText(#13#10+#13#10+'   This type is not yet supported. Please contact the author '+
                         'with this new info. In the mean time, the screen type for this '+
                         'game will be set as "none".');
         GenerateMessage(TitleErrorMsg, 'Screen type', '', 2);}
       end;
  end;

  function SetIntegerValue(const strValue: String; DriverStatus: Boolean): Integer;
  begin
    Result:= -1;
    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, strValue);
    if TempString <> '' then
       begin
         case DriverStatus of
           True : Result:= GetStatusIndex(TempString);
           False: Result:= StrToInt(TempString);
         end;
       end;
  end;

  function FixControlTag(const WaysStr: String): String;
  begin
    // for "joy", "doublejoy" and "triplejoy" only
    if WaysStr = '' then
       Result:= '';
    if WaysStr = '3 (half4)' then
       Result:= 'joy3way'
    else
    if WaysStr = '5 (half8)' then
       Result:= 'joy5way'
    else
    if WaysStr = 'vertical2' then
       Result:= 'vjoy2way'
    else
    if WaysStr = 'strange2' then
       Result:= 'joy2way'
       //Result:= 'joystrange2' // huh??? I don't know what this means!!!! game: name="bmcpokr" title="Dongfang Shenlong"
    else
       Result:= 'joy'+WaysStr+'way';
  end;

  function GetNewControlTags(const ControlName: String): Boolean;
  var
    ctrl1, ctrl2, ctrl3, ctrlString: String;
  begin
    ctrlString:= ControlName;
    Result:= (ctrlString = 'joy') or (ctrlString = 'doublejoy') or (ctrlString = 'triplejoy');
    case Result of
      True:
        begin
          ctrl2:= '';
          ctrl3:= '';
          ctrl1:= FixControlTag(XML_GetEntryValue(FileLine, 'ways'));

          if ctrlString = 'doublejoy' then
             begin
               ctrlString:= 'doublejoy,';
               ctrl2:= FixControlTag(XML_GetEntryValue(FileLine, 'ways2'));
               ctrlString:= ctrlString+ctrl1+','+ctrl2;
               //if ctrl1 <> ctrl2 then
               //   begin
               //     ShowMessage('doublejoy has different values!'+#13#10+'name: '+TempGameVars.eName+#13#10+'title: '+TempGameVars.eTitle+#13#10+
               //     'ways: '+ctrl1+#13#10+'ways2: '+ctrl2);
               //   end;
             end
          else
          if ctrlString = 'triplejoy' then
             begin
               ctrlString:= 'triplejoy,';
               ctrl2:= FixControlTag(XML_GetEntryValue(FileLine, 'ways2'));
               ctrl3:= FixControlTag(XML_GetEntryValue(FileLine, 'ways3'));
               ctrlString:= ctrlString+ctrl1+','+ctrl2+','+ctrl3;
               //if (ctrl1 <> ctrl2) and (ctrl1 <> ctrl3) and (ctrl2 <> ctrl3) then
               //   begin
               //     ShowMessage('triplejoy has different values!'+#13#10+'name: '+TempGameVars.eName+#13#10+'title: '+TempGameVars.eTitle+#13#10+
               //     'ways: '+ctrl1+#13#10+'ways2: '+ctrl2+#13#10+'ways3: '+ctrl3);
               //   end;
             end
          else
             ctrlString:= ctrl1;
        end;
      False: ctrlString:= ControlName;
    end;
    if ctrlString = 'only_buttons' then // from MAME v0.173... to avoid duplicate "Buttons" control type
       ctrlString:= 'buttons';

    Result:= True; // need to force TRUE result; will be set to false if there are more controls in "eControls" var and they are NOT already added!
    if TempGameVars.eControls <> '' then
       begin
         // only add a new control if it doesn't already exist
         Result:= PosEx(ctrlString, TempGameVars.eControls) = 0;
         if Result then
            TempGameVars.eControls:= TempGameVars.eControls+','+ctrlString;
       end
    else
       TempGameVars.eControls:= ctrlString;
  end;

