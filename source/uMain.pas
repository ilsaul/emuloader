function TFormMain.GetArcadeEmuVersionXML(sysID: Byte): String;
var
  fileXML: THashedStringList;
  Loop: Integer;
  FileLine: String;
begin
  Result:= '';
  FileLine:= GetFolderFull(42)+GetArcadeSystemIniSection(sysID)+'_xml.dat';
  if not FileExists(FileLine) then
     Exit;
  fileXML:= THashedStringList.Create;
  fileXML.LoadFromFile(FileLine);
  for Loop:=0 to fileXML.Count-1 do
  begin
    FileLine:= TrimLeft(fileXML[Loop]);
    if XML_CheckData(FileLine, '<description>') then
       begin
         Result:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
         Break;
       end;
  end;
  FreeAndNil(fileXML);
end;

function TFormMain.IsSEGAModel2NewVersion(emuFile: String): Boolean;
var
  iFile: THashedStringList;
  tFile: String;
begin
  // True  = new version 1.1 or newer that have the FSAA entry
  // False = old version 1.0
  tFile:= ExtractFilePath(emuFile)+'emulator.ini';
  Result:= FileExists(tFile);
  if not Result then
     begin
       Result:= True; // assume it's the new version 1.1 or newer
       Exit;
     end;

  iFile:= THashedStringList.Create;
  iFile.LoadFromFile(tFile);
  Result:= iFile.IndexOfName('FSAA') <> -1;
  FreeAndNil(iFile);
end;

function TFormMain.GetMAMEBuild(sysID: Byte; IsAlterMAME: Boolean = False): Integer;
var
  tBuild: String;
begin
  Result:= -1; // version "-1" means latest MAME builds! July 25, 2016
  case IsAlterMAME of
    True : tBuild:= buildAlterMAME;
    False:
      begin
        case sysID of
          idMAME  : tBuild:= buildMAME;
          idHBMAME: tBuild:= buildHBMAME;
        end;
      end;
  end;
  if tBuild <> '' then
     begin
       Delete(tBuild, 1, 2);
       Result:= StrToInt(tBuild);
     end;
end;

