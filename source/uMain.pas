procedure TFormMain.ReadVideoPreviewIni(LoadMediaPlayerSettings, LoadMediaPlayerParameters, LoadDummyParameters: Boolean);
var
  INIFile: TMemIniFile;
  Loop: Byte;
  videoFile, iParameters: String;
  //SectionFound: Boolean;
begin
  // this function is called only once at startup; "Video Preview Settings" dialog does NOT use this!!! (October 05, 2017)
  if not ValidateFile(GetVideoPreviewIniFile) then
     Exit;

  try
    INIFile:= TMemIniFile.Create(GetVideoPreviewIniFile);
    if LoadMediaPlayerSettings then
       begin
         for Loop:=1 to MaxArcadeSystems do
             ArcadeVideoPreviewDir[Loop]:= INIFile.ReadString('Arcade Folders', GetArcadeSystemIniSection(Loop, True), '');

         for Loop:=1 to MaxConsoleComputerSystems do
             ConsoleComputerVideoPreviewDir[Loop]:= INIFile.ReadString('Console/Computer Folders', ChangeFileExt(SystemsListCustom[Loop, 2], ''), '');

         VideoPreviewMediaPlayerExecutable:= INIFile.ReadString('MediaPlayer', 'File', '');
         VideoPreviewEnabled:= Boolean(INIFile.ReadInteger('MediaPlayer', 'Enabled', 1));
         VideoPreviewAutoPlay:= Boolean(INIFile.ReadInteger('MediaPlayer', 'AutoPlay', 0));
         VideoPreviewParentGameVideo:= Boolean(INIFile.ReadInteger('MediaPlayer', 'ParentGameVideo', 0));
         VideoPreviewPlayDummyVideo:= Boolean(INIFile.ReadInteger('MediaPlayer', 'PlayDummyVideo', 0));
       end;

    if LoadMediaPlayerParameters then
    begin
      VideoFile:= VideoPreviewMediaPlayerExecutable;
      if VideoFile <> '' then
         VideoFile:= ExtractFileName(VideoFile);
      if VideoFile <> '' then
         begin
           iParameters:= INIFile.ReadString('Parameters', VideoFile, '');
           if iParameters = '' then
              iParameters:= '%1'
           else
              begin
                if PosEx('%1', iParameters) = 0 then
                   iParameters:= '%1 '+iParameters;
              end;
           iParameters:= StringReplace(iParameters, '"%1"', '%1', [rfIgnoreCase]);
           VideoPreviewMediaPlayerParameters:= iParameters;
         end;
    end;

    if LoadDummyParameters then
    begin
      VideoPreviewDummyVideoParameters:= INIFile.ReadString('MediaPlayer', 'DummyVideoParameters', '');
         if VideoPreviewDummyVideoParameters <> '' then
         begin
           if PosEx('"%1"', VideoPreviewDummyVideoParameters) <> 0 then
              VideoPreviewDummyVideoParameters:= StringReplace(VideoPreviewDummyVideoParameters,
                                                                      '"%1"', '%1', [rfIgnoreCase]);
         end;
    end;
  finally
    FreeAndNil(INIFile);
  end;
  SetVideoPreviewState;
end;

procedure TFormMain.UpdateVideoPreviewIni;
var
  INIFile: TMemIniFile;
  Loop: Byte;
  VideoFile, iParameters: String;
begin
  if CheckReadOnly(GetVideoPreviewIniFile) then
     Exit;
  try
    INIFile:= TMemIniFile.Create(GetVideoPreviewIniFile);

    for Loop:= 1 to MaxArcadeSystems do
    begin
      iParameters:= GetArcadeSystemIniSection(Loop, True);
      if ArcadeVideoPreviewDir[Loop] <> '' then
         INIFile.WriteString('Arcade Folders', iParameters, ArcadeVideoPreviewDir[Loop])
      else
         INIFile.DeleteKey('Arcade Folders', iParameters);
    end;

    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      iParameters:= ChangeFileExt(SystemsListCustom[Loop, 2], '');
      if ConsoleComputerVideoPreviewDir[Loop] <> '' then
         INIFile.WriteString('Console/Computer Folders', iParameters, ConsoleComputerVideoPreviewDir[Loop])
      else
         INIFile.DeleteKey('Console/Computer Folders', iParameters);
    end;

    VideoFile:= VideoPreviewMediaPlayerExecutable;
    INIFile.WriteString('MediaPlayer', 'File', VideoFile);
    INIFile.WriteInteger('MediaPlayer', 'Enabled', Ord(VideoPreviewEnabled));
    INIFile.WriteInteger('MediaPlayer', 'AutoPlay', Ord(VideoPreviewAutoPlay));
    INIFile.WriteInteger('MediaPlayer', 'ParentGameVideo', Ord(VideoPreviewParentGameVideo));
    INIFile.WriteInteger('MediaPlayer', 'PlayDummyVideo', Ord(VideoPreviewPlayDummyVideo));
    INIFile.WriteString('MediaPlayer', 'DummyVideoParameters', VideoPreviewDummyVideoParameters);

    if VideoFile <> '' then
       VideoFile:= ExtractFileName(VideoFile);

    if VideoFile <> '' then
       begin
         iParameters:= VideoPreviewMediaPlayerParameters;
         if iParameters = '' then
            iParameters:= '%1'
         else
            begin
              if PosEx('%1', iParameters) = 0 then
                 iParameters:= '%1 '+iParameters;
            end;
         iParameters:= StringReplace(iParameters, '"%1"', '%1', [rfIgnoreCase]);
         VideoPreviewMediaPlayerParameters:= iParameters;
       end;
    INIFile.WriteString('Parameters', VideoFile, VideoPreviewMediaPlayerParameters);
    INIFile.UpdateFile;
  finally
    FreeAndNil(INIFile);
  end;
  if not VideoPreviewEnabled then
     VideoPreviewFile:= ''; // ButtonPlayVideoPreview.HelpKeyword:= '';
end;

