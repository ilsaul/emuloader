    ClearImageInfo(3);
    ResetFavoriteSettings; // reset TMenuItem and other settings
    //ApplyFilters(SelectedFilterName, True); // for the future...!!!!!
    SetGameType(False);
  end;

begin
  if LastFilterName = '' then
     begin
       if (SelectedFilterName <> 'favorites') and
          (SelectedFilterName <> '') then
          begin
            LastFilterName:= SelectedFilterName;
            SelectedFilterName:= 'favorites';
            ResetGamesList;
          end;
     end
