  //     else
  //        iUpdateGamesText:= FormMain.GetSystemIniSection(TempGameVars.eSystemID, True)+': '+TempGameVars.eName+iUpdateGamesText;

  //     iUpdatedGames.Add(iUpdateGamesText);
  //   end;
end;
