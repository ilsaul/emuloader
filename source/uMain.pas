procedure TFormMain.PopupDeleteSelectedGamesClick(Sender: TObject);
var
  Item: TEasyItem;
  dCFG, dNVRAM, sValue: String;
  ROMsContinue, Continue: Boolean;
  CheckDelROM, CheckDelCHD, CheckDelCFG, bValue: Boolean;

  function LoadIcons: Boolean;
  var
    tempFolder: String;
    Loop: ShortInt;
  begin
    Result:= True;
    if Assigned(FormDeleteMultipleGamesFiles) then
       begin
          tempFolder:= GetFolderFull(32);
          for Loop:=1 to MaxArcadeSystems do
              AddDefaultIcons(GetSystemIconFileName(Loop), tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          for Loop:=Low(aMediaType)+1 to High(aMediaType) do
              AddDefaultIcons(aMediaType[Loop, 1]+'.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          AddDefaultIcons('settings.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          //-1 -> none; 0 -> Good; 1 -> Imperfect; 2 -> Preliminary
          //AddDefaultIcons('scanresult_ok.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          //AddDefaultIcons('scanresult_missroms.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          //AddDefaultIcons('scanresult_badcrc.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
       end;
    //else
    //if Assigned(FormDeleteGamesFiles) then
    //   begin
    //     tempFolder:= GetFolderFull(32);
    //     for Loop:=Low(aMediaType)+1 to High(aMediaType) do
    //         AddDefaultIcons(aMediaType[Loop, 1]+'.ico', tempFolder, FormDeleteGamesFiles.IL_DeleteGameIcons);
    //     AddDefaultIcons('settings.ico', tempFolder, FormDeleteGamesFiles.IL_DeleteGameIcons);
    //   end;
  end;

  function CheckDelSettings(ReadMode: Boolean): Boolean;
  var
    INIFile: TMemIniFile;
    SectionStr: String;
  begin
    Result:= FileExists(FrontendPath+'el_extras.ini');
    if not Result then
       Exit;
    SectionStr:= 'DeleteFiles';
    if TMenuItem(Sender).Tag > 0 then
       SectionStr:= 'CopyMoveFiles';
    try
      INIFile:= TMemIniFile.Create(FrontendPath+'el_extras.ini');
      if ReadMode then
         begin
           CheckDelROM:= Boolean(INIFile.ReadInteger(SectionStr, 'ROM_AlwaysSelect', 1));
           CheckDelCHD:= Boolean(INIFile.ReadInteger(SectionStr, 'CHD_AlwaysSelect', Ord(TMenuItem(Sender).Tag > 0)));
           if SectionStr = 'DeleteFiles' then
              CheckDelCFG:= Boolean(INIFile.ReadInteger(SectionStr, 'CFG_AlwaysSelect', 1));
           if SectionStr = 'CopyMoveFiles' then
              begin
                sValue:= INIFile.ReadString(SectionStr, 'DestinationFolder', '');
                bValue:= Boolean(INIFile.ReadInteger(SectionStr, 'OverwriteFiles', 0));
              end;
         end
      else
         begin
           if INIFile.ValueExists('DeleteFiles', 'DeleteROM_AlwaysSelect') then
              begin
                INIFile.DeleteKey('DeleteFiles', 'DeleteROM_AlwaysSelect');
                INIFile.DeleteKey('DeleteFiles', 'DeleteCHD_AlwaysSelect');
                INIFile.DeleteKey('DeleteFiles', 'DeleteCFG_AlwaysSelect');
              end;
           INIFile.WriteInteger(SectionStr, 'ROM_AlwaysSelect', Ord(CheckDelROM));
           INIFile.WriteInteger(SectionStr, 'CHD_AlwaysSelect', Ord(CheckDelCHD));
           if SectionStr = 'DeleteFiles' then
              INIFile.WriteInteger(SectionStr, 'CFG_AlwaysSelect', Ord(CheckDelCFG));
           if SectionStr = 'CopyMoveFiles' then
              begin
                INIFile.WriteString(SectionStr, 'DestinationFolder', sValue);
                INIFile.WriteInteger(SectionStr, 'OverwriteFiles', Ord(bValue));
              end;
         end;
    finally
      if not ReadMode then
         INIFile.UpdateFile;
      FreeAndNil(INIFile);
    end;
  end;

begin
  CheckDelROM:= True; // default value
  CheckDelCHD:= (TMenuItem(Sender).Tag > 0); // default value; delete = false; copy/move = true
  CheckDelCFG:= True; // default value
  sValue:= '';
  bValue:= False;

  if CheckMultipleSelected(GamesListView) then
     begin
       if GamesListView.Selection.Count > 10 then
          begin
            FormStatus.TitleStr(TMenuItem(Sender).Caption);
            FormStatus.MessageStr('Searching files of selected games...');
            FormStatus.Show;
            FormStatus.StartThreadClock;
            Application.ProcessMessages;
          end;
       if not Assigned(FormDeleteMultipleGamesFiles) then
          FormDeleteMultipleGamesFiles:= TFormDeleteMultipleGamesFiles.Create(nil);
       CheckDelSettings(True);
       if Screen.Height < 1024 then
          begin
            FormDeleteMultipleGamesFiles.GamesList.ImagesSmall:= FormMain.IL_StandardIconsStandard;
            FormDeleteMultipleGamesFiles.GamesList.CellSizes.Report.Height:= 28;
            FormDeleteMultipleGamesFiles.GamesList.PaintInfoItem.CaptionLines:= 1;
          end;

       LoadIcons;
       FormDeleteMultipleGamesFiles.DeleteROMs.Tag:= MaxArcadeSystems+0;
       FormDeleteMultipleGamesFiles.DeleteCHDs.Tag:= MaxArcadeSystems+1;
       FormDeleteMultipleGamesFiles.DeleteCFGsNVRAMs.Tag:= MaxArcadeSystems+2;
       FormDeleteMultipleGamesFiles.DeleteROMs.Checked:= CheckDelROM;
       FormDeleteMultipleGamesFiles.DeleteCHDs.Checked:= CheckDelCHD;
       FormDeleteMultipleGamesFiles.DeleteCFGsNVRAMs.Checked:= CheckDelCFG;

       FormDeleteMultipleGamesFiles.DestinationFolder.Text:= sValue;
       FormDeleteMultipleGamesFiles.CopyMoveOverwriteFiles.Checked:= bValue;

       FormDeleteMultipleGamesFiles.ActionMode:= TMenuItem(Sender).Tag;
       FormDeleteMultipleGamesFiles.Hint:= TMenuItem(Sender).Caption;
       FormDeleteMultipleGamesFiles.Caption:= TMenuItem(Sender).Caption;

       FormDeleteMultipleGamesFiles.ShowModal;
       CheckDelROM:= FormDeleteMultipleGamesFiles.DeleteROMs.Checked;
       CheckDelCHD:= FormDeleteMultipleGamesFiles.DeleteCHDs.Checked;
       CheckDelCFG:= FormDeleteMultipleGamesFiles.DeleteCFGsNVRAMs.Checked;
       sValue:= FormDeleteMultipleGamesFiles.DestinationFolder.Text;
       bValue:= FormDeleteMultipleGamesFiles.CopyMoveOverwriteFiles.Checked;

       CheckDelSettings(False);

       FreeAndNil(FormDeleteMultipleGamesFiles);
       FocusGamesList;
       Exit;
     end;

  if not ValidateSelectedGame then
     Exit;
  // now for single selected game

  Continue:= True;
  ROMsContinue:= (Assigned(emuROMsFolders[MemGameInfo.eSystemID])) and
                 (emuROMsFolders[MemGameInfo.eSystemID].Count > 0);
  if TMenuItem(Sender).Tag > 0 then
     begin
       if not ROMsContinue then
          begin
            CallMessageBox;
            ShowGameNameEntryMsgBox;
            AddMsgText('    There is nothing to do as this game uses no ROMs or CHDs files.'+#13#10+#13#10);
            AddMsgText(FormMain.GetEmulatorDescription(FormMain.MemGameInfo.eSystemID, True)+#13#10, clGray, [fsBold, fsItalic], taCenter);
            AddMsgText('Emulator File: ');
            AddMsgText(EmulatorFile[MemGameInfo.eSystemID], clBlack, [fsBold]);
            GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
            FocusGamesList;
            Exit; // games with no ROMs cannot be deleted/copied/moved!!!
          end;
     end;

  if MemGameInfo.eSystemID = idDaphne then
     begin
       // special case. ROMs folder cannot be customized and there is no need
       // to load the DeleteGameFiles form if gamename.zip is not found!!!
        if ROMsContinue then
           begin
             dCFG:= IncludeTrailingPathDelimiter(emuROMsFolders[idDaphne].Strings[0])+MemGameInfo.eName+'.zip';
             if not FileExists(dCFG) then
                begin
                  CallMessageBox;
                  ShowGameNameEntryMsgBox;
                  AddMsgText('    File does not exist, you haven''t selected a Daphne '+
                                  'executable or the ROMs folder could not be found.'+#13#10+#13#10+'Search file: ');
                  AddMsgText(dCFG, $00a65300, [fsBold]);
                  AddMsgText(#13#10+#13#10);
                  AddMsgText(FormMain.GetEmulatorDescription(FormMain.MemGameInfo.eSystemID, True)+#13#10, clGray, [fsBold, fsItalic], taCenter);
                  AddMsgText('Emulator File: ');
                  AddMsgText(EmulatorFile[MemGameInfo.eSystemID], clBlack, [fsBold]);
                  GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
                  FocusGamesList;
                  Exit; // file not found or ROMs folder doesn't exist
                end;
           end
        else
           begin
             CallMessageBox;
             ShowGameNameEntryMsgBox;
             AddMsgText('    ROMs folder is blank. There are no folders set for the emulator.'+
                        #13#10+'Please make sure the emulator is properly configured before using this feature.'+
                        #13#10+#13#10);
             AddMsgText(FormMain.GetEmulatorDescription(FormMain.MemGameInfo.eSystemID, True)+#13#10, clGray, [fsBold, fsItalic], taCenter);
             AddMsgText('Emulator File: ');
             AddMsgText(EmulatorFile[MemGameInfo.eSystemID], clBlack, [fsBold]);
             GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
             FocusGamesList;
             Exit; // Daphne emulator was not selected in "Emulator Setup" screen (probably)
           end;
     end;

  if TMenuItem(Sender).Tag = 0 then
    begin
      // delete games files
      LoadFolders_ConfigFiles(MemGameInfo.eSystemID, dCFG, dNVRAM);
      case IsMAMEBasedSys(MemGameInfo.eSystemID) of
        True:
          begin
            if (dCFG = '') and (dNVRAM = '') then
               begin
                 if not ROMsContinue then
                    Continue:= False;
               end;
          end;
        False:
          begin
            case MemGameInfo.eSystemID of
              idDemul:
                begin
                  if (dNVRAM = '') and (not ROMsContinue) then
                     Continue:= False;
                end;
              idSegaModel2:
                begin
                  if (dCFG = '') and (dNVRAM = '') and (not ROMsContinue) then
                     Continue:= False;
                end;
              idZiNc:
                begin
                  if (dCFG = '') and (not ROMsContinue) then
                     Continue:= False;
                end;
            end;
          end;
      end;
      if not Continue then
         begin
           CallMessageBox;
           ShowGameNameEntryMsgBox;
           AddMsgText('    ROM, CFG, NVRAM folders are blank. There are no folders set for the emulator.'+
                      #13#10+'Please make sure the emulator is properly configured before using this feature.'+
                      #13#10+#13#10);
           AddMsgText(FormMain.GetEmulatorDescription(FormMain.MemGameInfo.eSystemID, True)+#13#10, clGray, [fsBold, fsItalic], taCenter);
           AddMsgText('Emulator File: ');
           AddMsgText(EmulatorFile[MemGameInfo.eSystemID], clBlack, [fsBold]);
           GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
           FocusGamesList;
           Exit; // no ROMs, CHDs or config folders are set... cannot continue
         end;
    end;

  if not Assigned(FormDeleteGamesFiles) then
     FormDeleteGamesFiles:= TFormDeleteGamesFiles.Create(nil);
  CheckDelSettings(True);
  //LoadIcons; // not used anymore... July 26, 2015
  FormDeleteGamesFiles.DeleteROMs.Tag:= 0;//MaxGameID+MaxArcadeSystems+1;
  FormDeleteGamesFiles.DeleteCHDs.Tag:= 1;//MaxGameID+MaxArcadeSystems+2;
  FormDeleteGamesFiles.DeleteCFGsNVRAMs.Tag:= 2;//MaxGameID+MaxArcadeSystems+3;
  FormDeleteGamesFiles.DeleteROMs.Checked:= CheckDelROM;
  FormDeleteGamesFiles.DeleteCHDs.Checked:= CheckDelCHD;
  FormDeleteGamesFiles.DeleteCFGsNVRAMs.Checked:= CheckDelCFG;

  FormDeleteGamesFiles.FolderCFG:= dCFG;
  FormDeleteGamesFiles.FolderNVRAM:= dNVRAM;

  FormDeleteGamesFiles.DestinationFolder.Text:= sValue;
  FormDeleteGamesFiles.CopyMoveOverwriteFiles.Checked:= bValue;

  FormDeleteGamesFiles.ActionMode:= TMenuItem(Sender).Tag;
  FormDeleteGamesFiles.Caption:= TMenuItem(Sender).Caption;
  FormDeleteGamesFiles.ShowModal;
  CheckDelROM:= FormDeleteGamesFiles.DeleteROMs.Checked;
  CheckDelCHD:= FormDeleteGamesFiles.DeleteCHDs.Checked;
  CheckDelCFG:= FormDeleteGamesFiles.DeleteCFGsNVRAMs.Checked;
  sValue:= FormDeleteGamesFiles.DestinationFolder.Text;
  bValue:= FormDeleteGamesFiles.CopyMoveOverwriteFiles.Checked;

  CheckDelSettings(False);
  case FormDeleteGamesFiles.GameChanged of
    True:
      begin
        FreeAndNil(FormDeleteGamesFiles);
        if ButtonGameFilterHaveMiss.Tag <> 0 then
           SelectNearGame(Item);
        PopupScanAllSelectedGames.Click; // single scan as only one game is selected!!!! 
      end;
    False: FreeAndNil(FormDeleteGamesFiles);
  end;
  FocusGamesList;
end;

