procedure TFormMain.ELV_MakeVisible(ListHolder: TEasyListView = nil; Item: TEasyItem = nil; CenterSelected: Boolean = True);
var
  Result: Boolean;
  itemPosition: TEasyMakeVisiblePos;
begin
  Result:= False;
  if ListHolder = nil then
     Result:= CheckSelected(GamesListView) // for uMain.GamesList
  else
     Result:= CheckSelected(ListHolder);

  if not Result then
     Exit;

  case CenterSelected of
    True : itemPosition:= emvMiddle;
    False: itemPosition:= emvAuto;
  end;

  if ListHolder = nil then
     ELV_CheckItemVisible(GamesListView, SelectedEasyItem, itemPosition = emvMiddle)
  else
     ELV_CheckItemVisible(ListHolder, Item, itemPosition = emvMiddle);
end;

function TFormMain.ELV_SelectItem(DestListView: TEasyListView; Index: Integer; strCaption: String = ''; ColumnIndex: Byte = 0): Boolean;
var
  Item: TEasyItem;
  strToSearch: String;
begin
  // column 0 (zero) is only for the main games list when ELV is in virtual mode!!!!!!
  Result:= False;
  if not CheckTotalVisible(DestListView) then
     Exit;
  Item:= DestListView.Groups.FirstVisibleItem;
  if strCaption = '' then
     begin
       repeat
         if Item.Index <> Index then
            Item:= DestListView.Groups.NextVisibleItem(Item);
       until (Item = nil) or (Item.Index = Index);
     end
  else
     begin
       strToSearch:= '';
       repeat
         if ColumnIndex = 0 then
            begin
              if DestListView = GamesListView then
                 strToSearch:= TEasyGameInfo(Item).eTitle
              else
                 strToSearch:= Item.Caption;
            end
         else
            strToSearch:= Item.Captions[ColumnIndex];
         if not SameText(strToSearch, strCaption) then
            Item:= DestListView.Groups.NextVisibleItem(Item);
       until (Item = nil) or (SameText(strToSearch, strCaption));
     end;
  if Item = nil then
     Item:= DestListView.Groups.FirstVisibleItem;
  Result:= Item <> nil;
  if Result then
     begin
       Item.Selected:= True;
       DestListView.Selection.FocusedItem:= Item;
       Item.MakeVisible(emvMiddle);//(emvAuto);
     end;
end;

procedure TFormMain.ELV_MoveItem(ELV_Holder: TEasyListView; MoveUp: Boolean);
var
  selItem, newPosItem: TEasyItem;
begin
  if not FormMain.CheckSelected(ELV_Holder) then
     Exit;
  selItem:= ELV_Holder.Selection.First;
  case MoveUp of
    True : newPosItem:= ELV_Holder.Groups.PrevItem(selItem);
    False: newPosItem:= ELV_Holder.Groups.NextItem(selItem);
  end;
  if newPosItem <> nil then
     ELV_Holder.Items.Exchange(selItem.Index, newPosItem.Index);
  ELV_Holder.SetFocus;
end;

procedure TFormMain.ELV_ItemPaintText_General(EasyListViewHolder: TCustomEasyListView; ELV_Item: TEasyItem; out CanvasHolder: TCanvas);
begin
  if ELV_Item.Selected then
     begin
       if ELV_Item.Ghosted then
          CanvasHolder.Font.Color:= ListSelectionColorInactive[1, EasyListViewHolder.HelpContext]
       else
       if EasyListViewHolder.Focused then
          CanvasHolder.Font.Color:= ListSelectionColors[4, EasyListViewHolder.HelpContext]
       else
          CanvasHolder.Font.Color:= ListSelectionColorInactive[3, EasyListViewHolder.HelpContext];
     end;
end;

procedure TFormMain.ELV_BlinkEdit(EditHolder: TEasyListView);
var
  CurrentColor, BlinkColor: TColor;
begin
  CurrentColor:= EditHolder.EditManager.Color;
  BlinkColor:= $7878e6; // 7895270 -> RGB(230,120,120)........ $001E1EEB; // 1973995 -> RGB(235, 30, 30)
  EditHolder.EditManager.Color:= BlinkColor;
  Application.ProcessMessages;
  Sleep(300);
  EditHolder.EditManager.Color:= CurrentColor;
  Application.ProcessMessages;
  Sleep(300);
  EditHolder.EditManager.Color:= BlinkColor;
  Application.ProcessMessages;
  Sleep(300);
  EditHolder.EditManager.Color:= CurrentColor;
  Application.ProcessMessages;
end;

procedure TFormMain.ELV_PopulateImageCategory(const DestListView: TEasyListView; CaptionType: Integer = -1);
var
  Loop, MaxIndex: ShortInt;
  IsCheckBox: Boolean;
begin
  IsCheckBox:= DestListView.PaintInfoItem.CheckType = ectBox;
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;

  // no need for the "AddInternetInfo" anymore as it only appears in category settings, with a checkbox
  // no other feature show Internet Game Info for selection, as it's not needed!!!!
  case IsCheckBox of
    True : MaxIndex:= High(ImageCategoryArray);
    False: MaxIndex:= High(ImageCategoryArray)-1;
  end;

  for Loop:=Low(ImageCategoryArray) to MaxIndex do
  begin
    with DestListView.Items.Add do
    begin
      ImageIndex:= Loop;
      Tag:= PopupMenuImageCategories.Items[ImageIndex].Tag; // background color
      case CaptionType of
        -1: Caption:= PopupMenuImageCategories.Items[Loop].Caption; // full title
         0: Caption:= ''; // empty title
         1:
           begin
             // short title
             case ImageIndex of
               0: Caption:= 'Title';
               1: Caption:= 'Snap';
               5: Caption:= 'CPanel';
               6: Caption:= 'Cover';
               8: Caption:= 'Game Artwork';
               15: Caption:= 'How To';
             else
                  Caption:= ImageCategoryArray[ImageIndex, 1];
             end;
           end;
      end;
      if not PopupMenuImageCategories.Items[Loop].Visible then
         State:= State+[esosGhosted];

      if IsCheckBox then
         Checked:= PopupMenuImageCategories.Items[Loop].Visible;
    end;
  end;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

procedure TFormMain.ELV_ImageCategoriesShortTitle(const DestListView: TEasyListView);
var
  Item: TEasyItem;
begin
  Item:= DestListView.Groups.FirstItem;
  DestListView.BeginUpdate;
