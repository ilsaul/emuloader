procedure TFormMain.InitializeEmulatorVariables;
var
  Loop, Loop2: Integer;
begin
  // define values for all arrays or exception error will occur...
  try
    for Loop:= 1 to MaxArcadeSystems do
    begin
      IniFilesDir[Loop]:= '';
      EmulatorFile[Loop]:= '';
      EmulatorVersion[Loop]:= '';
      EmulatorDateTime[Loop]:= -1;

      emuROMsFolders[Loop]:= nil;
      ArcadeVideoPreviewDir[Loop]:= '';
    end;
    buildMAME:= '';
    buildHBMAME:= '';
    buildAlterMAME:= '';
    AlterMAMEIniFilesDir:= '';
    AlterMAMEDateTime:= -1;

    for Loop:=1 to MaxArcadeSystems do
    begin
      for Loop2:=0 to High(imgFolder[1]) do
          imgFolder[Loop, Loop2]:= '';
    end;
    for Loop:=Low(ImageScr) to High(ImageScr) do
        ImageScr[Loop]:= nil;
    ImagePnl:= nil;
    for Loop:=Low(SplitterImg) to High(SplitterImg) do
        SplitterImg[Loop]:= nil;
    for Loop:=Low(ImageDetails) to High(ImageDetails) do
    begin
      ImageDetails[Loop].SystemID:= -1;
      //ImageDetails[Loop].SystemType:= 0; // always reset to arcade
      ImageDetails[Loop].ImageCategoryIndex:= -1;
      ImageDetails[Loop].NoImageLoaded:= False;
      ImageDetails[Loop].PrevNoImageLoaded:= False;
      ImageDetails[Loop].IsZipped:= False;
    end;
    for Loop:=Low(UnZipActive) to High(UnZipActive) do
        UnZipActive[Loop]:= False;
    MAMu_Folder:= '';
    for Loop:=Low(FilterSysArcade) to High(FilterSysArcade) do
        FilterSysArcade[Loop]:= True;

    for Loop:=Low(FilterSysConsComp) to High(FilterSysConsComp) do
        FilterSysConsComp[Loop]:= True;

    for Loop:=Low(FilterSysArcadeQuick) to High(FilterSysArcadeQuick) do
        FilterSysArcadeQuick[Loop]:= False;

    for Loop:=Low(FilterSysConsCompQuick) to High(FilterSysConsCompQuick) do
        FilterSysConsCompQuick[Loop]:= False;

    FilterMachineType.ArcadeSystems_Enabled:= True;
    FilterMachineType.ConsoleSystems_Enabled:= True;
    FilterMachineType.ComputerSystems_Enabled:= True;
    FilterMachineType.HandheldSystems_Enabled:= True;
    FilterMachineType.MAMEMachinesWithSoftwareList_Enabled:= True;
    FilterMachineType.MAMEMachinesWithoutSoftwareList_Enabled:= True;
    FilterMachineType.MAMESoftwareListGames_Enabled:= True;
    FilterMachineType.MAMEMachinesFilterPanel_Enabled:= False;
  except
    GenerateMessage('Startup', 'Failed to initialize emulator variables.',
                    '    One or more memory variables could not be initialized '+
                    '(uMain.InitializeEmulatorVariables).', 2, False, 1);
  end;
end;

