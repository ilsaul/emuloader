  function CheckDelSettings(ReadMode: Boolean): Boolean;
  var
    INIFile: TMemIniFile;
    SectionStr: String;
  begin
    Result:= FileExists(FrontendPath+'el_extras.ini');
    if not Result then
       Exit;
    SectionStr:= 'DeleteFiles';
    if TMenuItem(Sender).Tag > 0 then
       SectionStr:= 'CopyMoveFiles';
    try
      INIFile:= TMemIniFile.Create(FrontendPath+'el_extras.ini');
      if ReadMode then
         begin
           CheckDelROM:= Boolean(INIFile.ReadInteger(SectionStr, 'ROM_AlwaysSelect', 1));
           CheckDelCHD:= Boolean(INIFile.ReadInteger(SectionStr, 'CHD_AlwaysSelect', Ord(TMenuItem(Sender).Tag > 0)));
           if SectionStr = 'DeleteFiles' then
              begin
                CheckDelCFG:= Boolean(INIFile.ReadInteger(SectionStr, 'CFG_AlwaysSelect', 1));

                CheckDelGameFromGamesList:= Boolean(INIFile.ReadInteger(SectionStr, 'DeleteGameFromGamesList', 1));
                CheckDelGameFileFromDisk:= Boolean(INIFile.ReadInteger(SectionStr, 'DeleteGameFileFromDisk', 1));
              end;

           if SectionStr = 'CopyMoveFiles' then
              begin
                sValue:= INIFile.ReadString(SectionStr, 'DestinationFolder', '');
                bValue:= Boolean(INIFile.ReadInteger(SectionStr, 'OverwriteFiles', 0));
              end;
         end
      else
         begin
           if INIFile.ValueExists('DeleteFiles', 'DeleteROM_AlwaysSelect') then
              begin
                INIFile.DeleteKey('DeleteFiles', 'DeleteROM_AlwaysSelect');
                INIFile.DeleteKey('DeleteFiles', 'DeleteCHD_AlwaysSelect');
                INIFile.DeleteKey('DeleteFiles', 'DeleteCFG_AlwaysSelect');
              end;
           INIFile.WriteInteger(SectionStr, 'ROM_AlwaysSelect', Ord(CheckDelROM));
           INIFile.WriteInteger(SectionStr, 'CHD_AlwaysSelect', Ord(CheckDelCHD));
           if SectionStr = 'DeleteFiles' then
              begin
                INIFile.WriteInteger(SectionStr, 'CFG_AlwaysSelect', Ord(CheckDelCFG));

                INIFile.WriteInteger(SectionStr, 'DeleteGameFromGamesList', Ord(CheckDelGameFromGamesList));
                INIFile.WriteInteger(SectionStr, 'DeleteGameFileFromDisk', Ord(CheckDelGameFileFromDisk));
              end;
              
           if SectionStr = 'CopyMoveFiles' then
              begin
                INIFile.WriteString(SectionStr, 'DestinationFolder', sValue);
                INIFile.WriteInteger(SectionStr, 'OverwriteFiles', Ord(bValue));
              end;
         end;
    finally
      if not ReadMode then
         INIFile.UpdateFile;
      FreeAndNil(INIFile);
    end;
  end;

