procedure TFormMain.UpdateImageHintBoxPosition(HintBoxSource: TPanelEx; ImageSource: TImage32; PositionIndex: Integer);
var
  pIndex, xPos, yPos: Integer;
begin
  pIndex:= PositionIndex;
  if pIndex = -1 then
     begin
       if IsNightMode then
          pIndex:= FormNightMode.NightModeHintBox_Position.Position
       else
          pIndex:= FormPreferences.HintBox_Position.Position;
     end;

  case pIndex of
    1: // top / left
      begin
        xPos:= 20;
        yPos:= 20;
      end;
    2: // top / middle
      begin
        xPos:= (ImageSource.Width div 2) - (HintBoxSource.Width div 2);
        yPos:= 20;
      end;
    3: // top / right
      begin
        xPos:= ImageSource.Width-HintBoxSource.Width-20;
        yPos:= 20;
      end;
    4: // middle / left
      begin
        xPos:= 20;
        yPos:= (ImageSource.Height div 2) - (HintBoxSource.Height div 2);
      end;
    5: // middle / right
      begin
        xPos:= ImageSource.Width-HintBoxSource.Width-20;
        yPos:= (ImageSource.Height div 2) - (HintBoxSource.Height div 2);
      end;
    6: // bottom / left
      begin
        xPos:= 20;
        yPos:= ImageSource.Height-HintBoxSource.Height-20;
      end;
    7: // bottom / middle
      begin
        xPos:= (ImageSource.Width div 2) - (HintBoxSource.Width div 2);
        yPos:= ImageSource.Height-HintBoxSource.Height-20;
      end;
    8: // bottom / right
      begin
        xPos:= ImageSource.Width-HintBoxSource.Width-20;
        yPos:= ImageSource.Height-HintBoxSource.Height-20;
      end;
  end;
  if HintBoxSource.Left <> xPos then
     HintBoxSource.Left:= xPos;
  if HintBoxSource.Top <> yPos then
     HintBoxSource.Top:= yPos;
end;

procedure TFormMain.ChangeImageCategory(CategoryIndex: Integer);
var
  iLoop: Integer;
begin
  // this function is only used by single image layout
  ResetImageTagTo1;

  for iLoop:= Low(ImageDetails) to High(ImageDetails) do
  begin
    ImageDetails[iLoop].NoImageLoaded:= False;
    ImageDetails[iLoop].PrevNoImageLoaded:= False;
  end;

  if IsSingleImageLayout then
     begin
       ImageDetails[1].ImageCategoryIndex:= CategoryIndex;
       ImageDetails[1].ImageCategoryIndex_AllSystems:= CategoryIndex;
       ImageDetails[1].ImageCategoryIndex_ConsComp:= CategoryIndex;
       UpdateImageHintPanelText(1);

       ImagePreviewMouseLeave(Images);
       if not IsStartup then
          begin
            // free cache THashedStringList vars; will load it again in MenuImages.OnClick() event
            FreeImageZipVars;
            InitImgZipLists(True); // for MAME/arcade/EmuCon systems
            InitImgSoftwareNameZipLists(True);
          end;
     end;

  if (CategoryIndex < Low(ImageCategoryArray)) or (CategoryIndex > High(ImageCategoryArray)) then
     GenerateMessage('Image Preview', 'Failed to select image category.', '    Invalid image category index. '+
                     'Cannot set filename to update the image icon in tool bar buttons.'+#13#10+'Index: '+IntToStr(CategoryIndex), 2, False, 1)
  else
  if ImageCategoryArray[CategoryIndex, 0] = '' then
     GenerateMessage('Image Preview', 'Image category filename is blank.', 'Invalid filename for "'+GetImageCategoryTitle(CategoryIndex)+'".', 2, False, 1);

  ButtonImageCategory.Tag:= CategoryIndex;

  if IsSingleImageLayout then
     Images.Color:= GetImageBackgroundColor(ButtonImageCategory.Tag); // change background color

  ButtonImageCategory.Hint:= 'Category -> '+GetImageCategoryTitle(ButtonImageCategory.Tag)+' <-';

  ChangeImageCategoryIcon(ButtonImageCategory.Tag, IL_ImagesToolBarButtons, 2); // update image category button icon

  if (not FormStatus.Visible) and IsSingleImageLayout then
     MenuShowImages.OnClick(Self); // make sure image layout is in single image, force load the new image category for selected game

  FocusGamesList;
end;

