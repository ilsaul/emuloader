function TMyThreadRequest.GetImageType(iMemStream: TWideMemoryStream): TImageType;
const
  JPG_HEADER: array[0..2] of Byte  = ($FF, $D8, $FF);
  GIF_HEADER: array[0..2] of Byte  = ($47, $49, $46);
  BMP_HEADER: array[0..1] of Byte  = ($42, $4D);
  PNG_HEADER: array[0..3] of Byte  = ($89, $50, $4E, $47);
  TIF_HEADER: array[0..2] of Byte  = ($49, $49, $2A);
  TIF_HEADER2: array[0..2] of Byte = (77, 77, 00); // special case ?
var
  MemStr: TWideMemoryStream;
begin
  Result:= ifUnknown;
  if iMemStream = nil then
     Exit;
  MemStr:= TWideMemoryStream.Create;
  try
    iMemStream.Position:= 0;
    MemStr.CopyFrom(iMemStream, 5);
    if MemStr.Size > 4 then
      begin
      // uncomment these lines to detect "unknown types"
      // MemStr.Position:=0;
      // MemStr.Read(buf,1);
      // showmessage(inttostr(ord(buf)));
      // MemStr.Read(buf,1);
      // showmessage(inttostr(ord(buf)));
      // MemStr.Read(buf,1);
      // showmessage(inttostr(ord(buf)));

      if CompareMem(MemStr.Memory, @JPG_HEADER, SizeOf(JPG_HEADER)) then
         Result:= ifJPG
      else
      if CompareMem(MemStr.Memory, @GIF_HEADER, SizeOf(GIF_HEADER)) then
         Result:= ifGIF
      else
      if CompareMem(MemStr.Memory, @PNG_HEADER, SizeOf(PNG_HEADER)) then
         Result:= ifPNG
      else
      if CompareMem(MemStr.Memory, @BMP_HEADER, SizeOf(BMP_HEADER)) then
         Result:= ifBMP
      else
      if CompareMem(MemStr.Memory, @TIF_HEADER, SizeOf(TIF_HEADER)) then
         Result:= ifTIF
      else
      if CompareMem(MemStr.Memory, @TIF_HEADER2, SizeOf(TIF_HEADER2)) then
         Result:= ifTIF;
    end;
  finally
    FreeAndNil(MemStr);
  end;
  iMemStream.Position:= 0;
end;

procedure TMyThreadRequest.MakeThumbNail(abmp: TPNGGraphic; NuWidth, NuHeight: Integer); // using Scanline mode, fastest :)
type
  TRGBArray = array[0..32767] of TRGBTriple;
  pRGBArray = ^TRGBArray;
var
  xscale, yscale: Single;
  sfrom_y, sfrom_x: Single;
  ifrom_y, ifrom_x: Integer;
  to_y, to_x: Integer;
  weight_x, weight_y: array[0..1] of Single;
  weight: Single;
  new_red, new_green: Integer;
  new_blue: Integer;
  total_red, total_green: Single;
  total_blue: Single;
  ix, iy: Integer;
  bTmp: TPNGGraphic;
  sli, slo: pRGBArray;
  // pointers for scanline access
  liPByte, loPByte, p: PByte;
  // offset increment
  liSize, loSize: integer;
begin
  abmp.PixelFormat:= pf24bit;
  bTmp:= TPNGGraphic.Create;
  bTmp.PixelFormat:= pf24bit;
  bTmp.Width:= NuWidth;
  bTmp.Height:= NuHeight;
  bTmp.Canvas.Lock;
  xscale:= bTmp.Width / (abmp.Width - 1);
  yscale:= bTmp.Height / (abmp.Height - 1);
  liPByte:= abmp.Scanline[0];
  liSize:= Integer(abmp.Scanline[1]) - Integer(liPByte);
  loPByte:= bTmp.Scanline[0];
  loSize:= Integer(bTmp.Scanline[1]) - Integer(loPByte);
  for to_y:= 0 to bTmp.Height - 1 do
  begin
    sfrom_y:= to_y / yscale;
    ifrom_y:= Trunc(sfrom_y);
    weight_y[1]:= sfrom_y - ifrom_y;
    weight_y[0]:= 1 - weight_y[1];
    for to_x:= 0 to bTmp.Width - 1 do
    begin
      sfrom_x:= to_x / xscale;
      ifrom_x:= Trunc(sfrom_x);
      weight_x[1]:= sfrom_x - ifrom_x;
      weight_x[0]:= 1 - weight_x[1];
      total_red:= 0.0;
      total_green:= 0.0;
      total_blue:= 0.0;
      for ix:= 0 to 1 do
      begin
        for iy:= 0 to 1 do
        begin
          p:= liPByte;
          Inc(p, liSize * (ifrom_y + iy));
          sli:= pRGBArray(p);
          new_red:= sli[ifrom_x + ix].rgbtRed;
          new_green:= sli[ifrom_x + ix].rgbtGreen;
          new_blue:= sli[ifrom_x + ix].rgbtBlue;
          weight:= weight_x[ix] * weight_y[iy];
          total_red:= total_red + new_red * weight;
          total_green:= total_green + new_green * weight;
          total_blue:= total_blue + new_blue * weight;
        end;
      end;
      p:= loPByte;
      Inc(p, loSize * to_y);
      slo:= pRGBArray(p);
      slo[to_x].rgbtRed:= Round(total_red);
      slo[to_x].rgbtGreen:= Round(total_green);
      slo[to_x].rgbtBlue:= Round(total_blue);
    end;
  end;
  bTmp.Canvas.UnLock;
  abmp.Width:= bTmp.Width;
  abmp.Height:= bTmp.Height;
  abmp.Canvas.Draw(0, 0, bTmp);
  FreeAndNil(bTmp);
end;

procedure TMyThreadRequest.BiReSample(Src: TPNGGraphic; NuWidth, NuHeight: Integer; Sharpen: Boolean);
type
  PRGB24 = ^TRGB24;
  TRGB24 = record
    B, G, R: Byte;
  end;
  PRGBArray = ^TRGBArray;
  TRGBArray = array[0..0] of TRGB24;
var
  x, y, px, py: Integer;
  i, x1, x2, z, z2, iz2: Integer;
  w1, w2, w3, w4: Integer;
  Ratio: Integer;
  sDst, sDstOff: Integer;
  sScanLine: array[0..255] of PRGBArray;
  Src1, Src2: PRGBArray;
  C, C1, C2: TRGB24;
  y1, y2, y3, x3, iRed, iGrn, iBlu: Integer;
  p1, p2, p3, p4, p5: PRGB24;
  Dest: TPNGGraphic;
begin
  Src.PixelFormat:= pf24bit;
  Dest:= TPNGGraphic.Create;
  Dest.PixelFormat:= pf24bit;
  Dest.Width:= NuWidth;
  Dest.Height:= NuHeight;

  Dest.Canvas.Lock;

  // ScanLine buffer for Source
  sDst:= Integer(src.Scanline[0]);
  sDstOff:= Integer(src.Scanline[1]) - sDst;
  for i:= 0 to src.Height - 1 do
  begin
    sScanLine[i]:= PRGBArray(sDst);
    sDst:= sDst + sDstOff;
  end;
  // ScanLine for Destiantion
  sDst:= Integer(Dest.Scanline[0]);
  y1:= sDst; // only for sharpening...
  sDstOff:= Integer(Dest.Scanline[1]) - sDst;
  // Ratio is same for width and height
  Ratio:= ((src.Width - 1) shl 15) div Dest.Width;
  py:= 0;
  for y:= 0 to Dest.Height - 1 do
  begin
    i:= py shr 15;
    if i > src.Height - 1 then
       i:= src.Height - 1;
    Src1:= sScanLine[i];
    if i < src.Height - 1 then
       Src2:= sScanLine[i + 1]
    else
       Src2:= Src1;
    z2:= py and $7FFF;
    iz2:= $8000 - z2;
    px:= 0;
    for x:= 0 to Dest.Width - 1 do
    begin
      x1:= px shr 15;
      x2:= x1 + 1;
      C1:= Src1[x1];
      C2:= Src2[x1];
      z:= px and $7FFF;
      w2:= (z * iz2) shr 15;
      w1:= iz2 - w2;
      w4:= (z * z2) shr 15;
      w3:= z2 - w4;
      C.R:= (C1.R * w1 + Src1[x2].R * w2 + C2.R * w3 + Src2[x2].R * w4) shr 15;
      C.G:= (C1.G * w1 + Src1[x2].G * w2 + C2.G * w3 + Src2[x2].G * w4) shr 15;
      C.B:= (C1.B * w1 + Src2[x2].B * w2 + C2.B * w3 + Src2[x2].B * w4) shr 15;
      // Set destination pixel
      PRGBArray(sDst)[x]:= C;
      Inc(px, Ratio);
    end;
    sDst:= sDst + sDstOff;
    Inc(py, Ratio);
  end;

  if not Sharpen then
    Exit;

  // Sharpening...
  y2:= y1 + sDstOff;
  y3:= y2 + sDstOff;
  for y:= 1 to Dest.Height - 2 do
  begin
    for x:= 0 to Dest.Width - 3 do
    begin
      x1:= x * 3;
      x2:= x1 + 3;
      x3:= x1 + 6;
      p1:= PRGB24(y1 + x1);
      p2:= PRGB24(y1 + x3);
      p3:= PRGB24(y2 + x2);
      p4:= PRGB24(y3 + x1);
      p5:= PRGB24(y3 + x3);
      // -15 -11                       // -17 - 13
      iRed:= (p1.R + p2.R + (p3.R * -15) + p4.R + p5.R) div -11;
      iGrn:= (p1.G + p2.G + (p3.G * -15) + p4.G + p5.G) div -11;
      iBlu:= (p1.B + p2.B + (p3.B * -15) + p4.B + p5.B) div -11;
      if iRed < 0 then
         iRed:= 0
      else
      if iRed > 255 then
         iRed:= 255;

      if iGrn < 0 then
         iGrn:= 0
      else
      if iGrn > 255 then
         iGrn:= 255;

      if iBlu < 0 then
         iBlu:= 0
      else
      if iBlu > 255 then
         iBlu:= 255;

      PRGB24(y2 + x2).R:= iRed;
      PRGB24(y2 + x2).G:= iGrn;
      PRGB24(y2 + x2).B:= iBlu;
    end;
    Inc(y1, sDstOff);
    Inc(y2, sDstOff);
    Inc(y3, sDstOff);
  end;

  Dest.Canvas.UnLock;
  Src.Width:= Dest.Width;
  Src.Height:= Dest.Height;
  Src.Canvas.Draw(0, 0, Dest);
  FreeAndNil(Dest);
end;

{
// new function using the Graphics32 library... fast ???? untested!
procedure CreateThumbnal(const Src: TBitmap32; ThumbSize: Integer; BGColour: TColor32;
  var ThumbBM: TBitmap);
var
  ThumbBM32      : TBitmap32;
  s, s1, s2      : Double;
  w1, h1, w2, h2 : Integer;
  DstRect        : TRect;
begin
  // Define the resampling quality - fixed at present
  with TKernelResampler.Create(Src) do
  begin
    Kernel := TBoxKernel.Create;
    KernelMode := kmTableNearest;
    TableSize := 4;
  end;

  // Set up scaling
  s1 := Src.Width / ThumbSize;
  s2 := Src.Height / ThumbSize;
  s := Max(s1, s2);
  w1 := Round(Src.Width / s);
  h1 := Round(Src.Height / s);
  w2 := ThumbSize;
  h2 := ThumbSize;

  // Define and create the scaled thumbnail
  ThumbBM32 := TBitmap32.Create;
  ThumbBM32.SetSize(ThumbSize, ThumbSize);
  DstRect := ThumbBM32.BoundsRect;
  InflateRect(DstRect, (w1 - w2) div 2, (h1 - h2) div 2);
  ThumbBM32.Clear(BGColour);
  Src.DrawTo(ThumbBM32, DstRect);

  // Finally, convert the small TBitmap32 to a normal TBitmap
  ThumbBM.Assign(ThumbBM32);
  ThumbBM32.Free;
end;
}
function TMyThreadRequest.HandleRequest: Boolean;
var
  newWidth,
  newHeight: Integer;//, xPosFav, yPosFav, imgHeightLeft, iRightAlignDiff: Integer;
  jpgPic: TJPEGImage;
  gifPic: TGIFGraphic;
  bmpPic: TBitmap;
begin
  // Do the extraction here.... NOTICE this IS in the context of the thread so
  // think thread safety. If you have to access the form you will get into trouble.
  // Pass all the information you need here in the ThreadRequest object and you will
  // stay out of trouble
  // VERY IMPORTANT to lock the canvas when used in a Thread!
  Result:= True;
  ZipStream:= TWideMemoryStream.Create;

  Image.Canvas.Lock;
  case IsZipped of
    True:
      begin
        // for zipped images only
        try
          ZipForgeHolder:= TZipForge.Create(nil);
          ZipForgeHolder.FileName:= ZipFile;

          // Open existing archive file
          ZipForgeHolder.OpenArchive(fmOpenRead or fmShareDenyNone);
          ZipForgeHolder.ExtractToStream(FileName, ZipStream)
        except
          Result:= False;
        end;
        ZipForgeHolder.CloseArchive;
        ZipForgeHolder.FileName:= '';

        ZipForgeHolder.Free;
        ZipForgeHolder:= nil;
      end;
    False:
      begin
        try
          ZipStream.LoadFromFile(FileName);
        except
          Result:= False;
        end;
      end;
  end;

  if Result then
     begin
       ImageTypeDetected:= GetImageType(ZipStream);
       // ZipStream.Position:= 0; // no need; this is set in GetImageType() function
       case ImageTypeDetected of
         ifPNG:
           begin
             try
               Image.LoadFromStream(ZipStream);
             except
               //Result:= False;
             end;
           end;
         ifJPG:
           begin
             jpgPic:= TJPEGImage.Create;
              try
                jpgPic.LoadFromStream(ZipStream);
                Image.Assign(jpgPic);
                FreeAndNil(jpgPic);
              except
                //Result:= False;
              end;
           end;
         ifGIF:
           begin
             gifPic:= TGIFGraphic.Create;
              try
                gifPic.LoadFromStream(ZipStream);
                Image.Assign(gifPic);
                FreeAndNil(gifPic);
              except
                //Result:= False;
              end;
           end;
         ifBMP:
           begin
             bmpPic:= TBitmap.Create;
              try
                bmpPic.LoadFromStream(ZipStream);
                Image.Assign(bmpPic);
                FreeAndNil(bmpPic);
              except
                //Result:= False;
              end;
           end;
       else
         begin
           //Result:= False;
         end;
       end;
     end;

  ZipStream.Free;
  ZipStream:= nil;

  Result:= not Image.Empty;
  if not Result then
     begin
       Image.Canvas.Unlock;
       Exit;
     end;

  if Image.PixelFormat <> pf32bit then
     Image.PixelFormat:= pf32bit;

  if MaintainAspectRatio then
     begin
        if (Image.Width/Image.Height) <= (Width/Height) then
           begin
             // stretch height to match
             NewWidth:= MulDiv(Height, Image.Width, Image.Height);
             MakeThumbNail(Image, NewWidth, Height);
           end
        else
           begin
             // stretch width to match
             NewHeight:= MulDiv(Width, Image.Height, Image.Width);
             MakeThumbNail(Image, Width, NewHeight);
           end;
     end
  else
     MakeThumbNail(Image, Width, Height);
     //BiReSample(Image, Width, Height, True); // doesn't work... accces violation!!!

// this code is no longer used (draws the icons inside the image file, not as overlay icons)
{
  iRightAlignDiff:= SystemIconSize-24; // game icon / favorite icon are 24x24 only!!!

  case LeftAlignIcons of
    True:
      begin
        xPosFav:= 2;
        iRightAlignDiff:= 0;
      end;
    False:
      begin
        xPosFav:= Image.Width-SystemIconSize-2; // -2 is the border
        iRightAlignDiff:= SystemIconSize-24; // game icon / favorite icon are 24x24 only!!!
      end;
  end;
  yPosFav:= 2;

  if not SystemIcon.Empty then
     begin
       Image.Canvas.Draw(xPosFav, yPosFav, SystemIcon);
       yPosFav:= SystemIconSize+6; // SystemIcon.Height+4; (TIcon doesn't return width/height)
     end;

  if not GameIcon.Empty then
     begin
       if not SystemIcon.Empty then
       begin
         imgHeightLeft:= Image.Height-(yPosFav+24);
         case LeftAlignIcons of
           True:
             begin
               if imgHeightLeft < 0 then
                  begin
                    xPosFav:= yPosFav;
                    yPosFav:= 2;
                  end;
             end;
           False:
             begin
               if imgHeightLeft < 0 then
                  begin
                    xPosFav:= xPosFav-28;
                    yPosFav:= 2;
                  end
               else
                  xPosFav:= xPosFav+iRightAlignDiff;
             end;
         end;

         //yPosFav:= SystemIconSize+4; // SystemIcon.Height+4; (TIcon doesn't return width/height)... do not remove this (March 29, 2018)
       end;
       Image.Canvas.Draw(xPosFav, yPosFav, GameIcon);
     end;

  if not FavoriteIcon.Empty then
     begin
       if not GameIcon.Empty then
          begin
            imgHeightLeft:= Image.Height-(yPosFav+24+4+24);
            case LeftAlignIcons of
              True:
                begin
                  if imgHeightLeft < 0 then
                     xPosFav:= xPosFav+28
                  else
                     yPosFav:= yPosFav+28;
                end;
              False:
                begin
                  if imgHeightLeft < 0 then
                     xPosFav:= xPosFav-28
                  else
                     yPosFav:= yPosFav+28;
                end;
            end;
          end
       else
       if not SystemIcon.Empty then
          begin
            imgHeightLeft:= Image.Height-(yPosFav+24);
            case LeftAlignIcons of
              True:
                begin
                  if imgHeightLeft < 0 then
                     begin
                       xPosFav:= SystemIconSize+6;
                       yPosFav:= 2;
                     end;
                end;
              False:
                begin
                  if imgHeightLeft < 0 then
                     begin
                       xPosFav:= xPosFav-28;
                       yPosFav:= 2;
                     end
                  else
                     xPosFav:= xPosFav+iRightAlignDiff; // right align icon
                end;
            end;
          end
       else
          xPosFav:= xPosFav+iRightAlignDiff;

       Image.Canvas.Draw(xPosFav, yPosFav, FavoriteIcon);
     end;}

  Image.Canvas.Unlock;
end;

procedure TMyThreadRequest.Assign(Source: TPersistent);
begin
  inherited;
  // YOU MUST IMPLEMENT THIS METHOD IF YOU ADD NEW PROPERITIES TO A REQUEST OR
  // IT WON'T WORK
  // Also this is called in the context of the thread so BE THREAD CAREFUL
  if Source is TMyThreadRequest then
     begin
       BkColor:= TMyThreadRequest(Source).BkColor;
       Image.Assign(TMyThreadRequest(Source).Image);

       //FavoriteIcon.Assign(TMyThreadRequest(Source).FavoriteIcon);
       //SystemIcon.Assign(TMyThreadRequest(Source).SystemIcon);
       //SystemIconSize:= TMyThreadRequest(Source).SystemIconSize;
       //GameIcon.Assign(TMyThreadRequest(Source).GameIcon);

       //LeftAlignIcons:= TMyThreadRequest(Source).LeftAlignIcons;

       Width:= TMyThreadRequest(Source).Width;
       Height:= TMyThreadRequest(Source).Height;
       MaintainAspectRatio:= TMyThreadRequest(Source).MaintainAspectRatio;
       FileName:= TMyThreadRequest(Source).FileName;
       SoftwareName:= TMyThreadRequest(Source).SoftwareName;
       ZipFile:= TMyThreadRequest(Source).ZipFile;
       ZipForgeHolder:= TMyThreadRequest(Source).ZipForgeHolder;
       ZipStream:= TMyThreadRequest(Source).ZipStream;
       IsZipped:= TMyThreadRequest(Source).IsZipped;
     end;
end;

procedure TFormMain.AddRequestThumbExtraction(Item: TEasyItem);
var
  Request: TMyThreadRequest;
  //{folderScan, }SoftwareDir, ExtraFolderStrMAME, zipFile, SoftListZipFile, SoftListZipFile_SL: String;
  //FoundZipped, FoundZippedSoftList, FoundZippedSoftList_SL, Continue: Boolean;
  //SoftIndex: Integer;
  //Continue: Boolean;
  //folderScan{, fileScan, fileExt}: WideString;

  function SearchImageFile(IsNewImageNamingMAME: Boolean; SearchInZip: Boolean = False): Boolean;
  begin
    TEasyGameInfo(Item).fThumbTempVars.fileExt:= '.png';
    Result:= False;
    case SearchInZip of
      True:
        begin
          case TEasyGameInfo(Item).eIsCustomGame of
            True:
              begin
                Result:= not TEasyGameInfo(Item).eIsUnicode; // no Unicode filenames support in .zip files
                if not Result then
                   Exit;
                Result:= Assigned(imgZipFileListConsComp[TEasyGameInfo(Item).eCustomSystemID, 1]);
                if not Result then
                   Exit;
                Result:= imgZipFileListConsComp[TEasyGameInfo(Item).eCustomSystemID, 1].IndexOf(TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt) <> -1;
                if not Result then
                   begin
                     TEasyGameInfo(Item).fThumbTempVars.fileExt:= '.jpg';
                     Result:= imgZipFileListConsComp[TEasyGameInfo(Item).eCustomSystemID, 1].IndexOf(TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt) <> -1;
                   end;
                if Result then
                   TEasyGameInfo(Item).fThumbTempVars.FoundZipped:= True;
              end;
            False:
              begin
                Result:= (TEasyGameInfo(Item).fThumbTempVars.SoftIndex <> -1) and (TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile <> '') and (not IsNewImageNamingMAME);
                if Result then
                   begin
                     Result:= Assigned(imgZipFileSoftList[TEasyGameInfo(Item).fThumbTempVars.SoftIndex, 1]);
                     //if not Result then
                     //   Exit;
                     if Result then
                        begin
                          Result:= imgZipFileSoftList[TEasyGameInfo(Item).fThumbTempVars.SoftIndex, 1].IndexOf(TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt) <> -1;
                          if Result then
                             begin
                               TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList:= True;
                               TEasyGameInfo(Item).fThumbTempVars.zipFile:= TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile;
                             end;
                        end;
                   end;
                if not Result then
                   begin
                     if (TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile_SL <> '') and (not IsNewImageNamingMAME) then
                        begin
                          Result:= Assigned(imgZipFileSoftList_SL[1]);
                          if not Result then
                             Exit;
                          Result:= imgZipFileSoftList_SL[1].IndexOf(TEasyGameInfo(Item).fThumbTempVars.SoftwareDir+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt) <> -1;
                          if Result then
                             begin
                               TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList_SL:= True;
                               TEasyGameInfo(Item).fThumbTempVars.zipFile:= TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile_SL;
                             end;
                        end;
                   end;

                if (not Result) and (not IsNewImageNamingMAME) then // search in snap.zip
                   begin
                     //imgZipFileList: packed array[1..MaxArcadeSystems] of packed array[0..High(ImageCategoryArray)] of THashedStringList;
                     Result:= Assigned(imgZipFileList[TEasyGameInfo(Item).eSystemID, 1]);
                     if Result then
                        begin
                          Result:= imgZipFileList[TEasyGameInfo(Item).eSystemID, 1].IndexOf(TEasyGameInfo(Item).fThumbTempVars.SoftwareDir+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt) <> -1;
                          if Result then
                             begin
                               TEasyGameInfo(Item).fThumbTempVars.FoundZipped:= True;
                             end;
                        end;

                   end;
              end
          end;
        end;
      False:
        begin
          case TEasyGameInfo(Item).eIsCustomGame of
            True:
              begin
                TEasyGameInfo(Item).fThumbTempVars.ExtraFolderStrMAME:= '';
                Result:= FileExistsW(TEasyGameInfo(Item).fThumbTempVars.folderScan+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt);
                if not Result then //and (not IsNewImageNamingMAME) then
                   begin
                     Result:= FileExistsW(TEasyGameInfo(Item).fThumbTempVars.folderScan+WideString(ImageCategoryArray[1, 3]+'\')+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt);
                     if Result then
                        TEasyGameInfo(Item).fThumbTempVars.ExtraFolderStrMAME:= ImageCategoryArray[1, 3]+'\';
                   end;

                if not Result then
                   begin
                     TEasyGameInfo(Item).fThumbTempVars.fileExt:= '.jpg';
                     Result:= FileExistsW(TEasyGameInfo(Item).fThumbTempVars.folderScan+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt);
                     if not Result then //and (not IsNewImageNamingMAME) then
                        begin
                          Result:= FileExistsW(TEasyGameInfo(Item).fThumbTempVars.folderScan+WideString(ImageCategoryArray[1, 3]+'\')+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt);
                          if Result then
                             TEasyGameInfo(Item).fThumbTempVars.ExtraFolderStrMAME:= ImageCategoryArray[1, 3]+'\';
                        end;
                   end;
              end;
            False:
              begin
                // arcade systems check for .png files only (no support for .jpg in game snaps)
                TEasyGameInfo(Item).fThumbTempVars.ExtraFolderStrMAME:= '';
                Result:= FileExistsW(TEasyGameInfo(Item).fThumbTempVars.folderScan+TEasyGameInfo(Item).fThumbTempVars.SoftwareDir+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt);
                if not Result then //and (not IsNewImageNamingMAME) then
                   begin
                     Result:= FileExistsW(TEasyGameInfo(Item).fThumbTempVars.folderScan+WideString(ImageCategoryArray[1, 3]+'\'+TEasyGameInfo(Item).fThumbTempVars.SoftwareDir)+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt);
                     if Result then
                        TEasyGameInfo(Item).fThumbTempVars.ExtraFolderStrMAME:= ImageCategoryArray[1, 3]+'\';
                   end;
              end;
          end;
        end;
    end;
  end;

  function GetImageFileName(IsNewImageNamingMAME: Boolean; SearchInZip: Boolean = False): Boolean;
  begin
    TEasyGameInfo(Item).fThumbTempVars.FileExt:= '.png';
    case TEasyGameInfo(Item).eIsCustomGame of
      True:
        begin
           TEasyGameInfo(Item).fThumbTempVars.fileScan:= ChangeFileExtW(TEasyGameInfo(Item).eName, '');
        end;
      False:
        begin
          case IsNewImageNamingMAME of
            True : TEasyGameInfo(Item).fThumbTempVars.fileScan:= TEasyGameInfo(Item).eName+'\0000';
            False: TEasyGameInfo(Item).fThumbTempVars.fileScan:= TEasyGameInfo(Item).eName;
          end;
        end;
    end;

    Result:= SearchImageFile(IsNewImageNamingMAME, SearchInZip);
    if not TEasyGameInfo(Item).eIsCustomGame then
    begin
      if (not Result) and MenuThumbnailShowParentThumbs.Checked then
         begin
           if GameIsClone(TEasyGameInfo(Item).eClone) then
              begin
                case IsNewImageNamingMAME of
                  True : TEasyGameInfo(Item).fThumbTempVars.fileScan:= TEasyGameInfo(Item).eClone+'\0000';
                  False: TEasyGameInfo(Item).fThumbTempVars.fileScan:= TEasyGameInfo(Item).eClone;
                end;
                Result:= SearchImageFile(IsNewImageNamingMAME, SearchInZip);
              end;
         end;
    end;
  end;

begin
  ClearThumbTempVars(Item);

  TEasyGameInfo(Item).eThumbnailLoading:= True;

  case TEasyGameInfo(Item).eIsCustomGame of
    True : TEasyGameInfo(Item).fThumbTempVars.folderScan:= FullFolderFix(SnapshotFolderCustom[TEasyGameInfo(Item).eCustomSystemID, 1]);
    False: TEasyGameInfo(Item).fThumbTempVars.folderScan:= GetFolderFull(1, TEasyGameInfo(Item).eSystemID);
  end;

  TEasyGameInfo(Item).fThumbTempVars.zipFile:= TEasyGameInfo(Item).fThumbTempVars.folderScan+GetImgZipFileName(1); // snap.zip
  
  if not TEasyGameInfo(Item).eIsCustomGame then
  begin
    if TEasyGameInfo(Item).eSoftwareName <> '' then
       begin
         TEasyGameInfo(Item).fThumbTempVars.SoftwareDir:= TEasyGameInfo(Item).eSoftwareName+'\';
         if Assigned(imgSoftwareNameZipList) then
            begin
              TEasyGameInfo(Item).fThumbTempVars.SoftIndex:= imgSoftwareNameZipList.IndexOf(TEasyGameInfo(Item).eSoftwareName);
              if TEasyGameInfo(Item).fThumbTempVars.SoftIndex <> -1 then
                 TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile:= TEasyGameInfo(Item).fThumbTempVars.folderScan+TEasyGameInfo(Item).eSoftwareName+'.zip';
            end;
         if TEasyGameInfo(Item).eSystemID = idMAME then // IsMAMEBasedSys(TEasyGameInfo(Item).eSystemID) then
            begin
              if Assigned(imgZipFileSoftList_SL[1]) then
                 TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile_SL:= TEasyGameInfo(Item).fThumbTempVars.folderScan+GetImgZipFileName_SL(1); // thumbs use in-game snaps only
            end;
       end;
  end;

  TEasyGameInfo(Item).fThumbTempVars.Continue:= GetImageFileName(False);
  if not TEasyGameInfo(Item).fThumbTempVars.Continue then
     begin
       case TEasyGameInfo(Item).eIsCustomGame of
         True:
           begin
             TEasyGameInfo(Item).fThumbTempVars.Continue:= FileExistsW(TEasyGameInfo(Item).fThumbTempVars.zipFile);
             if TEasyGameInfo(Item).fThumbTempVars.Continue then
                begin
                  TEasyGameInfo(Item).fThumbTempVars.Continue:= GetImageFileName(False, True);
                  if not TEasyGameInfo(Item).fThumbTempVars.Continue then
                     begin
                       TEasyGameInfo(Item).eThumbnailLoading:= False;
                       ClearThumbTempVars(Item);
                       Exit;
                     end;
                end
             else
                begin
                  TEasyGameInfo(Item).eThumbnailLoading:= False;
                  ClearThumbTempVars(Item);
                  Exit;
                end;
           end;
         False:
           begin
             if IsMAMEBasedSys(TEasyGameInfo(Item).eSystemID) then
                TEasyGameInfo(Item).fThumbTempVars.Continue:= GetImageFileName(True);
             if not TEasyGameInfo(Item).fThumbTempVars.Continue then
                begin
                  TEasyGameInfo(Item).fThumbTempVars.Continue:=
                             ((TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile <> '')    and (FileExistsW(TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile))) or
                             ((TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile_SL <> '') and (FileExistsW(TEasyGameInfo(Item).fThumbTempVars.SoftListZipFile_SL))) or
                             FileExistsW(TEasyGameInfo(Item).fThumbTempVars.zipFile);

                  case TEasyGameInfo(Item).fThumbTempVars.Continue of
                    True:
                      begin
                        TEasyGameInfo(Item).fThumbTempVars.Continue:= GetImageFileName(False, True);
                        if not TEasyGameInfo(Item).fThumbTempVars.Continue then
                           begin
                             TEasyGameInfo(Item).eThumbnailLoading:= False;
                             ClearThumbTempVars(Item);
                             Exit; // there's nothing to load
                           end;
                      end;
                    False:
                      begin
                        TEasyGameInfo(Item).eThumbnailLoading:= False;
                        ClearThumbTempVars(Item);
                        Exit; // exit and do not load thumb for the current game as there is nothing to load
                      end;
                  end;
                end;
           end;
       end;
     end;

  TEasyGameInfo(Item).eThumbnailIsZipped:= TEasyGameInfo(Item).fThumbTempVars.FoundZipped or TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList or TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList_SL;

  Request:= TMyThreadRequest.Create;
  Request.Item:= Item; // Save what Item this request is for
  Request.ID:= 1; // Allows us to distinguish between user defined requests
  Request.Window:= GamesListView; // This MUST be set to the ListView as this is used to direct the messages back to the correct window

  Request.Width:=  RectWidth (Item.View.ItemRect(Item, nil, ertIcon)) - (2*Item.Border);
  Request.Height:= RectHeight(Item.View.ItemRect(Item, nil, ertIcon)) - (2*Item.Border);
  Request.MaintainAspectRatio:= ThumbnailSettings.MaintainAspectRatio;
  Request.BkColor:= $00fdde99; // cyan, light blue
  Request.IsUnicode:= TEasyGameInfo(Item).eIsUnicode;

  if TEasyGameInfo(Item).fThumbTempVars.FoundZipped or TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList_SL then
     Request.FileName:= TEasyGameInfo(Item).fThumbTempVars.SoftwareDir+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt
  else
  if TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList then
     Request.FileName:= TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt
  else
     Request.FileName:= TEasyGameInfo(Item).fThumbTempVars.folderScan+TEasyGameInfo(Item).fThumbTempVars.ExtraFolderStrMAME+TEasyGameInfo(Item).fThumbTempVars.SoftwareDir+TEasyGameInfo(Item).fThumbTempVars.fileScan+TEasyGameInfo(Item).fThumbTempVars.fileExt;
     
  Request.SoftwareName:= TEasyGameInfo(Item).eSoftwareName;

  Request.ImageTypeDetected:= ifUnknown;
  Request.ZipFile:= TEasyGameInfo(Item).fThumbTempVars.zipFile;
  Request.IsZipped:= TEasyGameInfo(Item).fThumbTempVars.FoundZipped or TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList or TEasyGameInfo(Item).fThumbTempVars.FoundZippedSoftList_SL;

  ClearThumbTempVars(Item);
  GlobalThreadManager.AddRequest(Request, True);
end;

