function TFormMain.ApplyMiscFilters(KeepGameStatus: Boolean): Boolean;
var
  KeepGame: Boolean;
  CategoryStr: WideString;

  function VerifyCategoryFilter(CheckBoxHolder: TAdvOfficeCheckBox; const CategoryName: WideString): Boolean;
  begin
    // CategoryName values
    // casino
    // reel
    // fruit
    // rhythm
    // mature
    // mahjong
    // tabletop
    // mechanic
    // quiz
    // utilities
    // gun
    // gallery
    Result:= KeepGame;
    if Result then
       begin
         if not CheckBoxHolder.Checked then
            begin
              //if MemGameInfo.eSoftwareName = '' then (no-no...)
                 Result:= Pos(CategoryName, CategoryStr) <> 0;
              if Result then
                 KeepGame:= False; // 'casino' is found in MemGameInfo.eCategory
            end;
       end;
  end;
  
begin
  KeepGame:= KeepGameStatus;

  if KeepGame then
     begin
       case FormFiltersExtra.LabelScreenOrientation.Tag of
         1: KeepGame:= MemGameInfo.eScreenOrientation = 0;  // horizontal
         2: KeepGame:= MemGameInfo.eScreenOrientation = 1;  // vertical
         3: KeepGame:= MemGameInfo.eScreenOrientation = -1; // unknown
       end;
     end;
     
  if KeepGame and (MemGameInfo.eMediaType = 1) then
     KeepGame:= not FormFiltersExtra.HideGamesWithCHDFiles.Checked;

  if KeepGame and FormFiltersExtra.HideNoDumpROMsGames.Checked then
     KeepGame:= not MemGameInfo.eROMsAllNoDump;

  if KeepGame and FormFiltersExtra.ShowMergedSetsOnly.Checked then
     KeepGame:= MemGameInfo.eIsMerged;

  if KeepGame then
     begin
       case FormFiltersExtra.LabelBios.Tag of
         1: KeepGame:= MemGameInfo.eBiosName <> '';
         2: KeepGame:= MemGameInfo.eBiosName = '';
       end;
     end;

  if KeepGame then
     begin
       case FormFiltersExtra.LabelDeviceROMs.Tag of
         1: KeepGame:= (TEasyGameInfo(SelectedEasyItem).eDeviceSets <> nil) or IsROM_Device(MemGameInfo.eROMIdentification);
         2: KeepGame:= TEasyGameInfo(SelectedEasyItem).eDeviceSets = nil;
       end;
     end;

  if MemGameInfo.eCategory <> '' then
     CategoryStr:= LowerCase(MemGameInfo.eCategory)
  else
     CategoryStr:= '';
  if KeepGame and (FormFiltersExtra.LabelInterfaceType.Tag <> 0) then
     begin
       case FormFiltersExtra.LabelInterfaceType.Tag of
         1: // classic (-listxml and catver.ini)
           begin
             KeepGame:= (not MemGameInfo.eMechanical); // = 0;
             if KeepGame then
                begin
                  if CategoryStr <> '' then
                     begin
                       KeepGame:= Pos('mechanic', CategoryStr) = 0;
                     end;
                end;
           end;
         2: // mechanical (-listxml and catver.ini)
           begin
             KeepGame:= MemGameInfo.eMechanical; // = 1;
           end;
       end;
     end;

  if KeepGame and (FormFiltersExtra.LabelAudioType.Tag <> 0) then
     begin
       case FormFiltersExtra.LabelAudioType.Tag of
         1: KeepGame:= MemGameInfo.eAudioType = 0; // standard audio
         2: KeepGame:= MemGameInfo.eAudioType = 1; // discrete audio
         3: KeepGame:= MemGameInfo.eAudioType = 2; // wave samples
         else
            KeepGame:= True; // -1 or 4 (this can be removed on a future version!)
       end;
     end;

  if KeepGame and IsROM_Device(MemGameInfo.eROMIdentification) then
     begin
       KeepGame:= not FormFiltersExtra.HideDeviceSets.Checked;
       //if KeepGame and FormFiltersExtra.HideDeviceSetsNoROMs.Checked then
       //   KeepGame:= TEasyGameInfo(SelectedEasyItem).eROMInfo <> nil; // TEasyGameInfo(SelectedEasyItem).eROMInfo.Count > 0;
     end;

  if KeepGame then
     begin
       case FormFiltersExtra.LabelGamesROMs.Tag of
         1: KeepGame:= (MemGameInfo.eSystemID = 3) or (TEasyGameInfo(SelectedEasyItem).eROMInfo <> nil);
         2: KeepGame:= (MemGameInfo.eSystemID <> 3) and (TEasyGameInfo(SelectedEasyItem).eROMInfo = nil);
         3: KeepGame:= (MemGameInfo.eHaveGameROMs = 0) and (TEasyGameInfo(SelectedEasyItem).eROMInfo <> nil) and
                       (not IsROM_Bios(MemGameInfo.eROMIdentification)) and
                       (not IsROM_Device(MemGameInfo.eROMIdentification));

         //1: KeepGame:= (MemGameInfo.eSystemID = 3) or (TEasyGameInfo(SelectedEasyItem).eROMInfo.Count > 0);
         //2: KeepGame:= (MemGameInfo.eSystemID <> 3) and (TEasyGameInfo(SelectedEasyItem).eROMInfo.Count = 0);
         //3: KeepGame:= (MemGameInfo.eHaveGameROMs = 0) and (TEasyGameInfo(SelectedEasyItem).eROMInfo.Count > 0) and
         //              (not IsROM_Bios(MemGameInfo.eROMIdentification)) and
         //              (not IsROM_Device(MemGameInfo.eROMIdentification));
       end;
         //Item.Visible:= FormMain.IsMAMEBasedSys(TEasyGameInfo(Item).eSystemID) and (TEasyGameInfo(Item).eHaveGameROMs = 0) and
         //          (TEasyGameInfo(Item).eROMInfo.Count > 0) and (not IsROM_Bios(TEasyGameInfo(Item).eROMIdentification)) and
         //          (not IsROM_Device(TEasyGameInfo(Item).eROMIdentification));
     end;

  if KeepGame and (FormFiltersExtra.NeoGeoMVS.Checked) and (MemGameInfo.eSystemID in [idMAME, idHBMAME]) then
     begin
       // for MAME/UME only!!!!!!
       if MemGameInfo.eSystemID = idHBMAME then
          KeepGame:= False // HBMAME emulator doesn't support Neo-Geo MVS multi-slot loading yet!!!
       else
       if MultiCartList[0] <> nil then
          begin
            if IsNeoGeoDriver(MemGameInfo.eSystemID, MemGameInfo.eDriverName, MemGameInfo.eBiosName, True) then
               KeepGame:= MultiCartList[0].IndexOf(MemGameInfo.eName) <> -1; // Neo-Geo MVS multi-slot machine only
          end;
     end;

  if KeepGame and (FormFiltersExtra.STVMultiSlot.Checked) and (MemGameInfo.eSystemID in [idMAME, idHBMAME]) then
     begin
       // for MAME/UME only!!!!!!
       if MemGameInfo.eSystemID = idHBMAME then
          KeepGame:= False // HBMAME emulator doesn't support Neo-Geo MVS multi-slot loading yet!!!
       else
       if MultiCartList[1] <> nil then
          begin
            if ChangeFileExt(MemGameInfo.eDriverName, '') = 'stv' then
               KeepGame:= MultiCartList[1].IndexOf(MemGameInfo.eName) <> -1; // ST-V multi-slot machine only
          end;
     end;

  if KeepGame and (not FormFiltersExtra.CategoryLightGun.Checked) then
     begin
       if MemGameInfo.eControls <> '' then
          KeepGame:= PosEx('lightgun', MemGameInfo.eControls) = 0;
     end;
     
  if KeepGame and (CategoryStr <> '') then
     begin
       VerifyCategoryFilter(FormFiltersExtra.CategoryCasino, 'casino');
       VerifyCategoryFilter(FormFiltersExtra.CategoryFruitMachines, 'reel');
       VerifyCategoryFilter(FormFiltersExtra.CategoryFruitMachines, 'fruit');
       VerifyCategoryFilter(FormFiltersExtra.CategoryRhythm, 'rhythm');
       VerifyCategoryFilter(FormFiltersExtra.CategoryMature, 'mature');
       VerifyCategoryFilter(FormFiltersExtra.CategoryMahjong, 'mahjong');
       VerifyCategoryFilter(FormFiltersExtra.CategoryTabletop, 'tabletop');
       VerifyCategoryFilter(FormFiltersExtra.CategoryPinMAME, 'mechanic');
       VerifyCategoryFilter(FormFiltersExtra.CategoryQuiz, 'quiz');
       VerifyCategoryFilter(FormFiltersExtra.CategoryUtilities, 'utilities');
       VerifyCategoryFilter(FormFiltersExtra.CategoryLightGun, 'gun');
       VerifyCategoryFilter(FormFiltersExtra.CategoryLightGun, 'gallery');
     end;
  Result:= KeepGame;
end;

function TFormMain.GetHorizontalBarPos: Integer;
begin
  Result:= 0;
  if FormMain.Visible and (IsDetailsView or IsGroupedView) then
     begin
          if GamesListView.Scrollbars.HorzBarVisible then
             Result:= GamesListView.Scrollbars.OffsetX;
     end;
end;

procedure TFormMain.RestoreHorizontalBarPos(ScrollBarPosition: Integer);
begin
  if ScrollbarPosition = 0 then
     Exit;
  if IsDetailsView or IsGroupedView then
     begin
       if GamesListView.Scrollbars.HorzBarVisible then
          begin
            if GamesListView.Scrollbars.OffsetX <> ScrollBarPosition then
               GamesListView.Scrollbars.OffsetX:= ScrollBarPosition;
          end;
     end;

end;

