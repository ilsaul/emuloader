procedure TFormMain.ToggleFavoriteLastFilter;

  procedure ResetGamesList;
  var
    iLoop: Integer;
  begin
    for iLoop:= 1 to MaxImagePanels do
        ClearImageInfo(iLoop);
        
    ResetFavoriteSettings; // reset TMenuItem and other settings
    SetGameType(False);
  end;

begin
  if LastFilterName = '' then
     begin
       if (SelectedFilterName <> 'favorites') and
          (SelectedFilterName <> '') then
          begin
            LastFilterName:= SelectedFilterName;
            SelectedFilterName:= 'favorites';
            ResetGamesList;
          end;
     end
  else
     begin
       if SelectedFilterName = 'favorites' then
          begin
            SelectedFilterName:= LastFilterName;
            LastFilterName:= '';
            ResetGamesList;
          end;
     end;
end;

procedure TFormMain.ValidateImagesMenu(IsImagePopupMenu: Boolean);
begin
  case IsImagePopupMenu of
    True:
      begin
        if PopupMenuImages.PopupComponent = Images then
           begin
             ImagePanelSeparator.Hint:= GetImageCategoryTitle(ImageDetails[1].ImageCategoryIndex);
             PopupMenuImages.Tag:= 1;
           end
        else
        if PopupMenuImages.PopupComponent = ImageScr[2] then
           begin
             ImagePanelSeparator.Hint:= GetImageCategoryTitle(ImageDetails[2].ImageCategoryIndex);
             PopupMenuImages.Tag:= 2;
           end
        else
        if PopupMenuImages.PopupComponent = ImageScr[3] then
           begin
             ImagePanelSeparator.Hint:= GetImageCategoryTitle(ImageDetails[3].ImageCategoryIndex);
             PopupMenuImages.Tag:= 3;
           end
        else
        if PopupMenuImages.PopupComponent = ImageScr[4] then
           begin
             ImagePanelSeparator.Hint:= GetImageCategoryTitle(ImageDetails[4].ImageCategoryIndex);
             PopupMenuImages.Tag:= 4;
           end
      end;
    False: PopupMenuImages.Tag:= 1;
  end;

  if not ValidateSelectedGame then
     begin
       if IsImagePopupMenu then
          begin
            PostMessage(Handle, WM_LBUTTONDOWN, MK_LBUTTON, 0);
            PostMessage(Handle, WM_LBUTTONUP, MK_LBUTTON, 0);
          end;
       Exit;
     end;

  if PopupMenuImages.Tag = 1 then
     PopupShowFirstImage.Enabled:= Images.Tag > 1
  else
  if PopupMenuImages.Tag in [2..MaxImagePanels] then
     PopupShowFirstImage.Enabled:= ImageScr[PopupMenuImages.Tag].Tag > 1
  else
     PopupShowFirstImage.Enabled:= False;

  PopupRenameCurrentImage.Enabled:= (not ImageDetails[PopupMenuImages.Tag].NoImageLoaded) and (not ImageDetails[PopupMenuImages.Tag].IsZipped);
  PopupDeleteCurrentImage.Enabled:= (not ImageDetails[PopupMenuImages.Tag].NoImageLoaded) and (not ImageDetails[PopupMenuImages.Tag].IsZipped);
  PopupImageCenterAllSplitters.Enabled:= not IsSingleImageLayout;
end;

function TFormMain.FixRetroArchImageFileNames(const ImageFileNameStr: String): String;
var
  iLoop: Integer;
begin
  Result:= ImageFileNameStr;
  if not FormPreferences.FixRetroArchImageFileNames.Checked then
     Exit;
  if Result = '' then
     Exit;
  // replace the following chars by underscore " _ " for RetroArch
  // &*/:`<>?\|
  for iLoop:= 1 to Length(Result) do
  begin
    if (Result[iLoop] = '&') or (Result[iLoop] = '*') or (Result[iLoop] = '`') or
       (Result[iLoop] = '<') or (Result[iLoop] = '>') or (Result[iLoop] = '?') or
       (Result[iLoop] = '|') then
       Result[iLoop]:= '_';
  end;
end;

