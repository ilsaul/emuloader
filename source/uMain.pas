procedure TFormMain.ELV_PopulateSystemsMulti(const DestListView: TEasyListView; ShowDisabledMode: Integer; ShortTitle: Boolean; HideAllSystems: Boolean; UnavailableSystemsGhostedIcon: Boolean; AddSystemTypeLabel: Boolean = False);
var
  Loop: ShortInt;
  ShowItem: Boolean;
  SysHave: Boolean;
begin
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;

  // StateImageIndex
  // -1 > MAME/arcade;
  //  1..MaxConsoleComputerSystems -> console/computer "system ID" tag!!!

  // ImageIndex
  // 1..MaxArcadeSystems -> MAME/arcade "system ID" tag and icon indexes
  // MaxArcadeSystems+1+Loop -> console/computer icon indexes

  // ShowDisabledMode:
  // 0 -> show all systems, no matter if they are enabled or disabled
  // 1 -> check if system is available... IsSystemAvailable() function only checks for games list files, not emulator files...
  // 2 -> check if last played games files are available (for the MRU screen)

  for Loop:=1 to MaxConsoleComputerSystems do
  begin
    case ShowDisabledMode of
      0: SysHave:= True; // same as TRUE
      1: SysHave:= IsSystemAvailable(Loop, True); // games list only... emulator files are no included
      2: SysHave:= FormMain.ValidateFile(GetCustomGamePlayedFile(Loop));
    end;
    ShowItem:= SysHave;

    //if not ShowUnavailableSystems then
    //   ShowItem:= SysHave;

    with DestListView.Items.Add do
    begin
      Caption:= SystemsListCustom[Loop, 0]; // EmuCon systems cannot be shortened yet!!!
      //case ShortTitle of
      //  True : Caption:= GetSystemShortTitle(Loop);
      //  False: Caption:= SystemsListCustom[Loop, 0];
      //end;
      ImageIndex:= MaxArcadeSystems+1+Loop;
      StateImageIndex:= Loop; // console/computer system tag
      if (not SysHave) and (DestListView.PaintInfoItem.CheckType <> ectNone) then
         Tag:= -1; // Tag -1 is for systems without games list... (disabled systems)

      if AddSystemTypeLabel then
         begin
           Captions[1]:= '      '+LowerCase(GetSystemTypeTitle(StateImageIndex, False));
           Details[1]:= 1;
         end;

      if not SysHave then
         begin
           if UnavailableSystemsGhostedIcon then
              State:= State+[esosGhosted]
           else
              Visible:= False;
         end;

      //if ShowItem then
      //   begin
      //     if (not SysHave) and UnavailableSystemsGhostedIcon then
      //        State:= State+[esosGhosted]
      //   end
      //else
      //   Visible:= False;
    end;
  end;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.Sort.SortAll;

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[56, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[39, 0]).Index); // Commodore 64 and 128

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[31, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[2, 0]).Index); // Game Boy Color and Game Boy Advance

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[48, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[5, 0]).Index); // Atari 400/800/XL and Atari 2600

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[65, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[3, 0]).Index); // Nintendo 8-bit and Nintendo 3DS

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[65, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[29, 0]).Index); // Nintendo 3DS and Nintendo DS


  DestListView.Items.ReIndexDisable:= True;

  for Loop:=MaxArcadeSystems downto 1 do
  begin
    case ShowDisabledMode of
      0: SysHave:= True; // same as TRUE
      1: SysHave:= IsSystemAvailable(Loop); // games list only... emulator files are no included
      2: SysHave:= FormMain.ValidateFile(GetGamesPlayedIniFile(Loop));
    end;
    ShowItem:= SysHave;

    //SysHave:= IsSystemAvailable(Loop); //FormMain.ValidateEmulatorFile(Loop) and IsSystemAvailable(Loop);
    //ShowItem:= ShowUnavailableSystems;
    //if not ShowUnavailableSystems then
    //   ShowItem:= SysHave;

    with DestListView.Items.Insert(0) do
    begin
      Caption:= GetArcadeSystemShortTitle(Loop);
      //case ShortTitle of
      //  True : Caption:= GetSystemShortTitle(Loop);
      //  False: Caption:= GetEmulatorDescription(Loop);
      //end;
      ImageIndex:= Loop;
      StateImageIndex:= -1; // MAME/arcade tag
      if (not SysHave) and (DestListView.PaintInfoItem.CheckType <> ectNone) then
         Tag:= -1; // Tag -1 is for systems without games list... (disabled systems)

      if AddSystemTypeLabel then
         begin
           Captions[1]:= '      '+LowerCase(GetSystemTypeTitle(ImageIndex, True));
           Details[1]:= 1;
         end;

      if not SysHave then
         begin
           if UnavailableSystemsGhostedIcon then
              State:= State+[esosGhosted]
           else
              Visible:= False;
         end;

      //if ShowItem then
      //   begin
      //     if (not SysHave) and UnavailableSystemsGhostedIcon then
      //        State:= State+[esosGhosted]
      //   end
      //else
      //   Visible:= False;
    end;
  end;

  if not HideAllSystems then
     begin
       with DestListView.Items.Insert(0) do
       begin
         Caption:= 'All Console / Computer / Handheld Systems';
         ImageIndex:= MaxArcadeSystems+1;
         Bold:= False;
         StateImageIndex:= 0;
         if AddSystemTypeLabel then
            begin
              Captions[1]:= '';
              Details[1]:= 1;
            end;
         //if not ShowItem then
         //   State:= State+[esosGhosted];
       end;
       with DestListView.Items.Insert(0) do
       begin
         Caption:= 'All Arcade Systems';
         ImageIndex:= 0;
         Bold:= False;
         StateImageIndex:= -1; // MAME/arcade tag
         if AddSystemTypeLabel then
            begin
              Captions[1]:= '';
              Details[1]:= 1;
            end;
         //if not ShowItem then
         //   State:= State+[esosGhosted];
       end;
     end;

  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

