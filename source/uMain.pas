    //idSegaModel2: Result:= BasePath+'segamodel2_ini\';
    idZiNc: Result:= BasePath+'zinc_cfg\';
  end;
end;

function TFormMain.AddMenuItem(MenuHolder: TMenuItem; Description, HintName: String; Duplicate: Boolean;
                               IsAutoCheck: Boolean = True; IsRadioItem: Boolean = True; ImageIndex: Integer = -1): TMenuItem;
var
  NewMenuItem: TMenuItem;
  Loop: Integer;
begin
  Result:= nil;
  if not Duplicate then
     begin
       if MenuHolder.Count > 0 then
          begin
            for Loop:=0 to MenuHolder.Count-1 do
            begin
              if SameText(MenuHolder.Items[Loop].Caption, Description) then
                 Exit;
            end;
          end;
     end;

  NewMenuItem:= TMenuItem.Create(MenuHolder);
  NewMenuItem.Caption:= Description;
  if IsAutoCheck then
     NewMenuItem.AutoCheck:= True;
  if IsRadioItem then
     NewMenuItem.RadioItem:= True;
     
  NewMenuItem.Hint:= HintName;
  if ImageIndex <> -1 then
     NewMenuItem.ImageIndex:= ImageIndex;
  MenuHolder.Add(NewMenuItem);
  if SameText(HintName, 'disabled') then
     NewMenuItem.Checked:= True;
  Result:= NewMenuItem;
end;

procedure TFormMain.CreateMAMEIniFile(const EmulatorFileName: String);
