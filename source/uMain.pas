function TFormMain.GetDateTimeStr(dtInfo: Integer; Hours24Format: Boolean = True; HideSeconds: Boolean = False): String;
begin
  case Hours24Format of
    True:
      begin
        case HideSeconds of
          False: DateTimeToString(Result, 'mmm/dd/yyyy hh:nn:ss', FileDateToDateTime(dtInfo));
          True : DateTimeToString(Result, 'mmm/dd/yyyy hh:nn', FileDateToDateTime(dtInfo));
        end;
      end;
    False:
      begin
        case HideSeconds of
          False: DateTimeToString(Result, 'mmm/dd/yyyy hh:nn:ss AM/PM', FileDateToDateTime(dtInfo));
          True : DateTimeToString(Result, 'mmm/dd/yyyy hh:nn AM/PM', FileDateToDateTime(dtInfo));
        end;
      end;
  end;
end;

