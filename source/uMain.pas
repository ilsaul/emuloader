  CurrentTotalPlayTimeHideSeconds:= FormPreferences.TotalPlayTimeHideSeconds.Checked;

  CurrentGameDocsSingleDisplayPanel:= FormPreferences.GameDocsDisplayModeSinglePanel.Checked;

  CurrentLeadingZeroVerInfo:= FormPreferences.AddLeadingZeroVersionInfoMAME.Checked;
  
  FormPreferences.ShowModal;

  if FormStatus.LabelSoftwareScanCount.Visible then
     SetLabelSoftwareScanCountVisible(False);
     
  if UpdateMAMu_ScanFolder then
     begin
       // this will execute only if user selected another folder for MAMu_ Icons  (compared with "uMain.MAMu_Folder" string var)
       // it will if user change MAME binary in Emulator Setup screen!
       WriteArcadeImageCategories(False, True, imgFolder); // save MAMEu_ folder setting to MAME's "ui.ini" or "eldir\arcade\image_categories.ini" file
       case PopupEnableMAMu_Icons.Checked of
         True : ResetMAMu_ImageList(True);
         False: PopupEnableMAMu_Icons.Enabled:= DirectoryExists(MAMu_Folder);
       end;
     end;

  if FormPreferences.MAMEGameManualsPDFFolder.Text <> CurrentMAMEFolderPDF then
     begin
       UpdateMAMEFolderManualPDF;
       SetMAMEManualPDF_Folder(FormPreferences.MAMEGameManualsPDFFolder.Text);
     end;

  ShortDriverColumnTitle;
  SetGamesDateTime(CurrentLastPlayedHideSeconds <> FormPreferences.LastPlayedHideSeconds.Checked,
                   CurrentTotalPlayTimeHideSeconds <> FormPreferences.TotalPlayTimeHideSeconds.Checked);
  if not VideoPreviewPlayDummyVideo then
     PlayDummyVideoPreview:= False;

  if not CheckReadOnly(FrontendPath+'EmuLoader.ini') then
  begin
    elIni:= TMemIniFile.Create(FrontendPath+'EmuLoader.ini');
    elIni.WriteInteger('Preferences', 'AllowOneInstance', Ord(FormPreferences.AllowOnlyOneInstance.Checked));
    elIni.WriteInteger('Images', 'DisableThreadedLoading', Ord(FormPreferences.ImageDisableThreadedLoading.Checked));
    elIni.UpdateFile;

    FreeAndNil(elIni);
  end;

  AlignEmuGameText:= GetAlignEmuGameText;

  WriteLightModeSettings;
  WriteSplashSettings; // just in case...
  
  SetImageHintBoxColors(1, True); // update ImageHintPanel
  SetImageHintBoxColors(2, True); // update ImageHintPanel2[2]
  SetImageHintBoxColors(3, True); // update ImageHintPanel2[3]
  SetImageHintBoxColors(4, True); // update ImageHintPanel2[4]

  if not IsNightMode then
     begin
       UpdateImageHintPanelText(1, True);
       UpdateImageHintPanelText(2, True);
       UpdateImageHintPanelText(3, True);
       UpdateImageHintPanelText(4, True);

       SetColorsGamesListStatusBar;
     end;

  if IsStartup then
     Exit; // sanity check ??? I still need to double-check if preferences is called at startup or on a clean install (March 01, 2018)

  if FormPreferences.GameDocsDisplayModeSinglePanel.Checked <> CurrentGameDocsSingleDisplayPanel then
     begin
       GameDocsDisplayTabsToggleButtons;
       UpdateScreenshotsPanel; // will change panels to match game docs display mode
       if PanelScreenshotsArea.Visible and (not ButtonInternetGameInfo.Down) then
          begin
            if IsGameDocsSinglePanelDisplay then
            begin
              // force reload images and/or game docs
              if MenuShowImages.Checked then
                 DisplayImage;
              if ShowGameInfoValidate then
                 ShowGameInfoAll;
            end;
          end;
     end;
  if FormPreferences.AddLeadingZeroVersionInfoMAME.Checked <> CurrentLeadingZeroVerInfo then
     SetVersionInfoFormat;
  GamesListView.BeginUpdate;
  ELV_ResetNormalColors(GamesListView);
  GamesListView.EndUpdate;
  MachinesListSidePanel.BeginUpdate;
  ELV_ResetNormalColors(MachinesListSidePanel);
  MachinesListSidePanel.EndUpdate;
end;

