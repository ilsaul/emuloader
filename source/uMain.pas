procedure TFormMain.LoadListCPU(BoxHolder: TComboBox);
var
  ListCPU, SortedList: THashedStringList;
  Loop: Integer;
  tmpString, StrCPU: String;
begin
  if not FileExists(GetIniFilesFolder+'cpu.ini') then
     Exit;
  ListCPU:= THashedStringList.Create;
  ListCPU.LoadFromFile(GetIniFilesFolder+'cpu.ini');
  SortedList:= THashedStringList.Create;
  SortedList.BeginUpdate;
  for Loop:=0 to ListCPU.Count-1 do
  begin
    tmpString:= ListCPU[Loop];
    if (tmpString <> '') and (tmpString[1] <> '[') then
       begin
         StrCPU:= ListCPU.ValueFromIndex[Loop];
         if SortedList.IndexOf(StrCPU) = -1 then
            SortedList.Add(StrCPU);
       end;

  end;
  SortedList.Sort;
  SortedList.EndUpdate;
  FreeAndNil(ListCPU);
  if SortedList.Count > 0 then
     begin
       BoxHolder.Items.BeginUpdate;
       BoxHolder.Clear;
       BoxHolder.Items.Add('[None]');
       BoxHolder.Items.AddStrings(SortedList);
       BoxHolder.Items.EndUpdate;
       BoxHolder.ItemIndex:= 0;

     end;
  FreeAndNil(SortedList);
end;

{procedure ComboBox_AutoWidth(const theComboBox: TCombobox);
const
  HORIZONTAL_PADDING = 4;
var
  itemsFullWidth: integer;
  idx: integer;
  itemWidth: integer;
begin
  itemsFullWidth := 0;

  // get the max needed with of the items in dropdown state
  for idx := 0 to -1 + theComboBox.Items.Count do
  begin
    itemWidth := theComboBox.Canvas.TextWidth(theComboBox.Items[idx]);
    Inc(itemWidth, 2 * HORIZONTAL_PADDING);
    if (itemWidth > itemsFullWidth) then itemsFullWidth := itemWidth;
  end;

  // set the width of drop down if needed
  if (itemsFullWidth > theComboBox.Width) then
  begin
    //check if there would be a scroll bar
    if theComboBox.DropDownCount < theComboBox.Items.Count then
      itemsFullWidth := itemsFullWidth + GetSystemMetrics(SM_CXVSCROLL);

    SendMessage(theComboBox.Handle, CB_SETDROPPEDWIDTH, itemsFullWidth, 0);
  end;
end;}

function TFormMain.CheckGameControlType(const StringHolder: String): Boolean;
var
  Loop: Integer;
  TempString: String;
begin
  Result:= False;
  if StringHolder = '' then
     Exit;

  for Loop:=1 to Length(StringHolder) do
  begin
    if (StringHolder[Loop] = ',') or (Loop = Length(StringHolder)) then
       begin
         if Loop = Length(StringHolder) then
            TempString:= TempString+StringHolder[Loop];
         if TempString <> '' then
            begin
              if SameText(TempString, FormFiltersExtra.ControlName) then
                 begin
                   Result:= True;
                   Break;
                 end
              else
                 TempString:= '';
            end;
       end
    else
       TempString:= TempString+StringHolder[Loop];
  end;
end;

procedure TFormMain.UpdateStatusBarGame;
var
  UpdateIconStatus: Boolean;

  function UpdateStatusIconTag(NewStatusIndex: Integer): Boolean;
  var
    UpdateStatusID: Integer;
  begin
    case NewStatusIndex of
      0: UpdateStatusID:= 0;
      1: UpdateStatusID:= 3;
      2: UpdateStatusID:= 1;
    end;
    Result:= IconGameStatus.Tag <> UpdateStatusID;
    if Result then
       IconGameStatus.Tag:= UpdateStatusID;
  end;

begin
  if not StatusBarPanel.Visible then
     Exit;
  if not CheckSelected(GamesListView) then
     begin
       StatusBar_GamesGameName.Caption:= '';
       IconGameStatus.Picture.Icon:= nil;
       Exit;
     end;
  // IconGameStatus -> 0 -> have; 1 -> have with missing ROMs/CHDs; 2 -> miss

  if IconGameStatus.Picture.Icon.Empty then
     IconGameStatus.Tag:= -1;

  UpdateIconStatus:= UpdateStatusIconTag(MemGameInfo.eGameSetStatus);

  if UpdateIconStatus then
     IL_LeftPanel.GetIcon(IconGameStatus.Tag, IconGameStatus.Picture.Icon);

  StatusBar_GamesGameName.Canvas.Lock;
  case GameIsClone(MemGameInfo.eClone) of
    True : StatusBar_GamesGameName.Caption:= MemGameInfo.eName+' [clone of '+MemGameInfo.eClone+']';
    False: StatusBar_GamesGameName.Caption:= MemGameInfo.eName;
  end;
  if ValidateBiosName(MemGameInfo.eBiosName, MemGameInfo.eName) then
     StatusBar_GamesGameName.Caption:= StatusBar_GamesGameName.Caption+' [bios: '+MemGameInfo.eBiosName+']';

  if MemGameInfo.eIsMerged then
     StatusBar_GamesGameName.Caption:= StatusBar_GamesGameName.Caption+' [merged set]';
  if MemGameInfo.eSoftwareName <> '' then
     StatusBar_GamesGameName.Caption:= StatusBar_GamesGameName.Caption+' [xml file: '+MemGameInfo.eSoftwareName+']';

  StatusBar_GamesGameName.Canvas.UnLock;
end;

// images procedures
procedure TFormMain.SetImageScaleMode;

  procedure UpdateScale(ImageHolder: TImage32);
  begin
    case PopupImageStretch.Checked of
      True:
        begin
          case PopupImageStretchLarger.Checked of
            True:
              begin
                if (ImageHolder.Bitmap.Width > ImageHolder.Width) or (ImageHolder.Bitmap.Height > ImageHolder.Height) then
                   begin
                     if ImageHolder.ScaleMode <> smResize then
                        ImageHolder.ScaleMode:= smResize
                   end
                else
                   begin
                     if ImageHolder.ScaleMode <> smNormal then
                        ImageHolder.ScaleMode:= smNormal;
                   end;
              end;
            False:
              begin
                if ImageHolder.ScaleMode <> smResize then
                   ImageHolder.ScaleMode:= smResize;
              end;
          end;
        end;
      False:
        begin
          if ImageHolder.ScaleMode <> smNormal then
             ImageHolder.ScaleMode:= smNormal;
        end;
    end;
    if (PopupImageStretch.Tag = 0) and (not IsStartup) then
       FocusGamesList;
  end;

begin
  UpdateScale(Images);
  if Assigned(ImageScr[2]) then
     UpdateScale(ImageScr[2]);
  if Assigned(ImageScr[3]) then
     UpdateScale(ImageScr[3]);
end;

function TFormMain.GetImageName(const GameName: String; const ImageIndex: ShortInt; const FormatIndex: ShortInt; SoftwareName: String = ''): String;
var
  SoftwareFolder: String;
begin
  SoftwareFolder:= '';
  if SoftwareName <> '' then
     SoftwareFolder:= SoftwareName+'\';
  case FormatIndex of
    0: // EL Format [elevator0005.png]
      begin
        if ImageIndex = 1 then
           Result:= SoftwareFolder+GameName
        else
           Result:= SoftwareFolder+GameName+Format('%.4u', [ImageIndex-2]);
      end;
    1: Result:= SoftwareFolder+GameName+'\'+Format('%.4u', [ImageIndex-1]); // New MAME Format [elevator\0005.png]
  end;
end;

procedure TFormMain.CycleImageCategory(MoveForward: Boolean);
var
  CategoryEnabled: Boolean;
  ImgIndex: ShortInt;
begin
  if IsImageLayoutView then
     Exit;
  ImgIndex:= ButtonImageCategory.Tag;
  repeat
    case MoveForward of
      True: // next type
        begin
          Inc(ImgIndex);
          if ImgIndex > High(ImageCategoryArray) then
             ImgIndex:= 0;
        end;
      False: // previous type
        begin
          Dec(ImgIndex);
          if ImgIndex < Low(ImageCategoryArray) then
             ImgIndex:= Length(ImageCategoryArray)-1;
        end;
    end;
    CategoryEnabled:= PopupMenuImageCategories.Items[ImgIndex].Visible;
    if CategoryEnabled then
       PopupMenuImageCategories.Items[ImgIndex].Click;
  until CategoryEnabled;
end;

function TFormMain.VerifyZipType(ZipString: String; GetFolder: Boolean; FullZipPath: Boolean = False): String;
begin
  case SameText(ExtractFileExt(ZipString), '.zip') of
    True:
      begin
        case GetFolder of
          True: Result:= ExtractFilePath(ZipString);
          False:
            begin
              case FullZipPath of
                True : Result:= ZipString;
                False: Result:= ExtractFileName(ZipString);
              end;
            end;
        end;
      end;
    False:
      begin
        case GetFolder of
          True : Result:= ZipString;
          False: Result:= 'dummy.zip';
        end;
      end;
  end;
end;

function TFormMain.GetFolderFull(const FolderType: ShortInt; SystemID: Integer = -1): String;
begin
  case FolderType of
    0..Length(imgFolder[SystemID])-1: Result:= imgFolder[SystemID, FolderType];
    //30: Result:= FormPreferences.FolderPCBInfo.Text; // index for future use ?
    //31: Result:= FormPreferences.FolderGamesFAQ.Text; // index for future use ?
    32: Result:= FrontendPath+'resources\main_icons\'; // Frontend Icons Folder
    33: Result:= FrontendPath+'resources\gameslist_icons\'; // Default Game Icons
    35: Result:= FrontendPath+'resources\images\'; // Images Folder
  end;
  if not (FolderType in [32..35]) then
     begin
       if (Result <> '') and (SystemID <> -1) then
          Result:= FullEmuFolderFix(Result, SystemID, True); // for zipped images...
     end;
end;

