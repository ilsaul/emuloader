function TFormMain.ELV_SelectItem(DestListView: TEasyListView; Index: Integer; strCaption: String = ''; ColumnIndex: Byte = 0): Boolean;
var
  Item: TEasyItem;
  strToSearch: String;
begin
  // column 0 (zero) is only for the main games list when ELV is in virtual mode!!!!!!
  Result:= False;
  if not CheckTotalVisible(DestListView) then
     Exit;
  Item:= DestListView.Groups.FirstVisibleItem;
  if strCaption = '' then
     begin
       repeat
         if Item.Index <> Index then
            Item:= DestListView.Groups.NextVisibleItem(Item);
       until (Item = nil) or (Item.Index = Index);
     end
  else
     begin
       strToSearch:= '';
       repeat
         if ColumnIndex = 0 then
            begin
              if DestListView = GamesListView then
                 strToSearch:= TEasyGameInfo(Item).eTitle
              else
                 strToSearch:= Item.Caption;
            end
         else
            strToSearch:= Item.Captions[ColumnIndex];
         if not SameText(strToSearch, strCaption) then
            Item:= DestListView.Groups.NextVisibleItem(Item);
       until (Item = nil) or (SameText(strToSearch, strCaption));
     end;
  if Item = nil then
     Item:= DestListView.Groups.FirstVisibleItem;
  Result:= Item <> nil;
  if Result then
     begin
       Item.Selected:= True;
       DestListView.Selection.FocusedItem:= Item;
       Item.MakeVisible(emvMiddle);//(emvAuto);
     end;
end;

procedure TFormMain.ELV_MoveItem(ELV_Holder: TEasyListView; MoveUp: Boolean);
