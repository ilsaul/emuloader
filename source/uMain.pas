procedure TFormMain.DrawGradient(Canvas: TCanvas; ARect: TRect; Style: TGradientStyle; DualGradient: Boolean;
                                 UpperGradientColorStart, UpperGradientColorEnd,
                                 LowerGradientColorStart, LowerGradientColorEnd, GradientColorOuterFrame: Integer);
var
  FullBar: TBitmap;
  TopGradHeight: Integer;
begin
  DrawBuffer.Canvas.Lock;

  case DualGradient of
    True:
      begin
        TopGradHeight:= Trunc(RectHeight(ARect) / 2);
        TopGradHeight:= Trunc(TopGradHeight - (TopGradHeight * 0.2))-1;
        DrawBuffer.Height:= TopGradHeight;
        DrawBuffer.Width:= RectWidth(ARect)-2;
      end;
    False:
      begin
        DrawBuffer.Height:=  RectHeight(ARect); // single gradient
        DrawBuffer.Width:= RectWidth(ARect);
      end;
  end;

  BarMenus.DrawGradient(DrawBuffer, nil, BitmapRect(DrawBuffer),
                        UpperGradientColorStart,
                        UpperGradientColorEnd, Style);

  if DualGradient then
     begin
       DrawBufferBottom.Canvas.Lock;
       DrawBufferBottom.Height:= (RectHeight(ARect)-TopGradHeight)-2;
       //ShowMessage('total height: '+IntToStr(RectHeight(ARect))+#13#10+
       //             'grad top height: '+IntToStr(TopGradHeight)+#13#10+
       //             'grad bottom height: '+IntToStr(DrawBufferBottom.Height));
       DrawBufferBottom.Width:= RectWidth(ARect)-2;
       BarMenus.DrawGradient(DrawBufferBottom, nil, BitmapRect(DrawBufferBottom),
                             LowerGradientColorStart,
                             LowerGradientColorEnd, Style);
     end;

  FullBar:= TBitmap.Create;
  FullBar.Canvas.Lock;
  FullBar.Width:= RectWidth(ARect);
  DrawBuffer.Canvas.Unlock;
  if DualGradient then
     DrawBufferBottom.Canvas.Unlock;
  case DualGradient of
    True : FullBar.Height:= DrawBuffer.Height+DrawBufferBottom.Height+2; // dual gradient
    False: FullBar.Height:= DrawBuffer.Height; // gradient
  end;

  case DualGradient of
    True:
      begin
        FullBar.Canvas.Brush.Color:= GradientColorOuterFrame; // dual-gradient outer frame
        FullBar.Canvas.FrameRect(FullBar.Canvas.ClipRect);
        FullBar.Canvas.Draw(1, 1, DrawBuffer);
        FullBar.Canvas.Draw(1, DrawBuffer.Height+1, DrawBufferBottom);
      end;
    False:
      begin
        FullBar.Canvas.Draw(0, 0, DrawBuffer);
      end;
  end;
  FullBar.Canvas.UnLock;
  Canvas.Draw(ARect.Left, ARect.Top, FullBar);
  DrawBuffer.Height:= 0;
  DrawBuffer.Width:= 0;
  if DualGradient then
     begin
       DrawBufferBottom.Height:= 0;
       DrawBufferBottom.Width:= 0;
     end;
  FreeAndNil(FullBar);
end;

function TFormMain.GetSizeType(Value: Extended; Bits: Boolean; ShortTag: Boolean = False): String;
var
  TagStr: String;
  //Format file byte size
  function FormatByteSize(const Bytes: Extended): String;
  const
    B = 1; // Byte
    KB = 1024 * B; // KiloByte
    MB = 1024 * KB; //MegaByte
    GB = 1024 * MB; //GigaByte
  begin
    if bytes >= GB then
       begin
         if Bits then
            Result:= FormatFloat('# G', Bytes / GB)
         else
            Result:= FormatFloat('#.## G', Bytes / GB)
       end
    else
    if bytes >= MB then
      begin
          if Bits then
            Result:= FormatFloat('# M', Bytes / MB)
         else
            Result:= FormatFloat('#.## M', Bytes / MB)
       end
    else
    if bytes >= KB then
       begin
       if Bits then
          Result:= FormatFloat('# K', Bytes / KB)
       else
          Result:= FormatFloat('#.## K', Bytes / KB)
       end
    else
       begin
       if Bits then
          Result:= FormatFloat('# ', Bytes)
       else
          Result:= FormatFloat('#.## ', Bytes);
       end;
  end;

