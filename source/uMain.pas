procedure TFormMain.ImgZipParseFilesList(sysID, imageCategoryID: Integer);
var
  imgFile: String;
  ArchiveItem: TZFArchiveItem;
  tResult: Boolean;
begin
  if (not IsSystemAvailable(sysID)) or (imgFolder[sysID, imageCategoryID] = '') then
     begin
       FreeAndNil(imgZipFileList[sysID, imageCategoryID]);
       Exit;
     end;
  if ZipForge.Active then
     begin
       CallMessageBox;
       AddMsgText('    Unable to open ');
       AddMsgText(GetImgZipFileName(imageCategoryID), $00a65300, [fsBold]);
       AddMsgText(' file as there is another .zip file already opened.');
       GenerateMessage('Error! ImgZipParseFilesList()', GetEmulatorDescription(sysID, True));
       Exit;
     end;

  imgFile:= GetFolderFull(imageCategoryID, sysID)+GetImgZipFileName(imageCategoryID);
  tResult:= FileExists(imgFile);
  if not tResult then
     begin
       FreeAndNil(imgZipFileList[sysID, imageCategoryID]);
       Exit;
     end;
  if FormStatus.Visible then
     FormStatus.MessageStr(GetEmulatorDescription(sysID, True)+#13#10+
                           'Loading "'+GetImgZipFileName(imageCategoryID)+'" contents in RAM for fast access.');
  case Assigned(imgZipFileList[sysID, imageCategoryID]) of
    True : imgZipFileList[sysID, imageCategoryID].Clear;
    False: imgZipFileList[sysID, imageCategoryID]:= THashedStringList.Create;
  end;
  imgZipFileList[sysID, imageCategoryID].BeginUpdate;

  with ZipForge do
  begin
    FileName:= imgFile;
    // Open existing archive file
    try
      OpenArchive(fmOpenRead or fmShareDenyNone);
      if FileCount > 0 then
         begin
           // Search text files stored inside the archive
           if FindFirst('*.*', ArchiveItem) then
              begin
                //ArchiveItem.StoredPath
                repeat
                  if (not ArchiveItem.ExternalFileAttributes and $10 = $10) then // do not add folders into the list
                  imgZipFileList[sysID, imageCategoryID].Add(LowerCase(ArchiveItem.StoredPath+ArchiveItem.FileName));
                until (not FindNext(ArchiveItem));                     // StoredPath is for softwarename\gamename format...
              end;
         end;
    except
      CloseArchive;
      FileName:= '';
      FreeAndNil(imgZipFileList[sysID, imageCategoryID]);
      Exit;
    end;
  end;
  imgZipFileList[sysID, imageCategoryID].EndUpdate;
  ZipForge.CloseArchive;
  ZipForge.FileName:= '';
  // for debugging only... leave it commented!
  //if (sysID = idMAME) and (imageCategoryID = 1) then
  //   imgZipFileList[sysID, imageCategoryID].SaveToFile(FrontendPath+'snap-zip_contents.txt');
end;

