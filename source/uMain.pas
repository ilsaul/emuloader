function TFormMain.FixMAMENVRAMFileType(const FileName: String): Integer;
var
  FileStr, FileExt: String;
begin
  // 0 -> CFG
  // 1 -> NVRAM
  // 2 -> EEPROM
  // 3 -> SRAM
  // 4 -> FLASH

  // this function is only used by "Delete Selected Game Files" feature only (uDeleteGamesFiles.pas; uDeleteMultipleGamesFiles.pas)
  Result:= 1;
  FileExt:= LowerCase(ExtractFileExt(FileName));
  if FileExt = '.nv' then
     Exit; // for old MAME builds
  FileStr:= LowerCase(ExtractFileName(FileName));
  if PosEx('eeprom', FileStr) > 0 then
     Result:= 2
  else
  if (PosEx('sram', Filestr) > 0) or (PosEx('saveram', FileStr) > 0) then
     Result:= 3
  else
  if PosEx('flash', FileStr) > 0 then
     Result:= 4;
end;

function TFormMain.GetFileTypeText(sysID, MediaType, FileID: ShortInt; IsConsoleComputerSystem: Boolean; MediaTypeConsoleComputer: ShortInt = -1): String;
begin
  case MediaType of
    -1: // for config files
      begin
        case FileID of
          0:
            begin
              if sysID <> idSegaModel2 then
                 Result:= '  Config File [.cfg]'
              else
                 Result:= '  Input File [.input]';
            end;
          1:
            begin
              if sysID <> idSegaModel2 then
                 Result:= '  Non-Volatile RAM'
              else
                 Result:= '  Non-Volatile Data [.dat]'; // for SEGA Model 2 emu

              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [NVRAM]' // MAME, HBMAME; .nv -> old NVRAM file; misc -> sub-folder!
              else
              if sysID in [idSupermodel, idDemul] then
                 Result:= Result+' [.nv]'; // Supermodel: SEGA Model 3
            end;
          2:
            begin
              Result:= '  Electrically Erasable Programmable Read-Only Memory';
              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [EEPROM]'
              else
              if sysID = idDemul then //4
                 Result:= Result+' [.eeprom]'; // for Demul
            end;
          3:
            begin
              Result:= '  Static Random Access Memory';
              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [SRAM]' // MAME, HBMAME
              else
              if sysID = idDemul then //4
                 Result:= Result+' [.sram]'; // for Demul
            end;
          4:
            begin
              Result:= '  Non-Volative Memory Storage';
              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [FLASH]'
              else
              if sysID = idDemul then //4
                 Result:= Result+' [.flash]'; // for Demul
            end;
        end;
      end;
    0:
      begin
        case IsConsoleComputerSystem of
          True:
            begin
              if MediaTypeConsoleComputer = -1 then
                 begin
                   // arcade games
                   if SystemUseSevenZip(sysID) then
                      Result:= '  Game ROMs [.zip / .7z]'
                   else
                      Result:= '  Game ROMs [.zip]';
                 end
              else
                 begin
                   // for EmuCon games... only if game file is not zipped (.zip; .7z)
                   Result:= '  '+MediaTypeCustom[MediaTypeConsoleComputer, 0];
                 end;
            end;
          False:
            begin
              // arcade games
              if SystemUseSevenZip(sysID) then
                 Result:= '  Game ROMs [.zip / .7z]'
              else
                 Result:= '  Game ROMs [.zip]';
            end;
        end;
      end;
    1: // for arcade games
      begin
        Result:= '  Compressed Hunks of Data: ';
        case FileID of
          12, 13, 14: Result:= Result+'Hard Drive';
          15, 16, 17: Result:= Result+'Disc';
          18, 19, 20: Result:= Result+'Compact Flash Card';
          21, 22, 23: Result:= Result+'Video Tape';
        end;
        Result:= Result+' [.chd]';
      end;
  end;
end;

procedure TFormMain.SetDefaultFont(tFont: TFont; FontID: ShortInt; SetFontColorNightMode: Boolean = False);
var
  tmpColor: TColor;
  tmpStyle: Byte;
begin
  if SetFontColorNightMode then
     tmpColor:= clWhite
  else
     tmpColor:= clBlack;
     
  tmpStyle:= 0; // no style format
  case FontID of
    2:
      begin
        if SetFontColorNightMode then
           tmpColor:= clSilver
        else
           tmpColor:= clGray; // preliminary
      end;
    3:
      begin
        if SetFontColorNightMode then
           tmpColor:= clrLightRed
        else
           tmpColor:= clRed;  // missing ROMs
      end;
    4:
      begin
        if SetFontColorNightMode then
           tmpColor:= clrLightRed
        else
           tmpColor:= clRed;  // missing ROMs preliminary
      end;
  end;
  tFont.Color:= tmpColor;
  tFont.Name:= 'Segoe UI';
  tFont.Size:= 9;
  if FontID in [2, 4] then
     tmpStyle:= 8; // preliminary
  tFont.Style:= TFontStyles(tmpStyle);
end;

procedure TFormMain.GetCanvasFont(sysID, CustomSystemID: Integer; IsConsoleComputerSystem: Boolean; gGameSetStatus: ShortInt; gDriverStatus: ShortInt; const gCloneOf: String; const CanvasHolder: TCanvas; CheckHaveMissFilter: Boolean; ELV_Source: TEasyListView);

  //function CheckGameSet: Boolean;
  //begin
  //  Result:= gGameSetStatus = 1;
  //  if (Result and CheckHaveMissFilter) then
  //     Result:= ButtonGameFilterHaveMiss.Tag <> 3;
  //end;

  function AssignFontParams(FontHolder: TFont): Boolean;
  begin
    Result:= Assigned(FontHolder);
    if Result then
       CanvasHolder.Font:= FontHolder
    else
       CanvasHolder.Font:= ELV_Source.Font;
  end;

begin
  if gGameSetStatus = 1 then //CheckGameSet then
     begin
       if gDriverStatus = 2 then
          AssignFontParams(Font_MissingROMsPreliminary)
       else
          AssignFontParams(Font_MissingROMs);
     end
  else
  if gDriverStatus = 2 then
     AssignFontParams(Font_Preliminary)
  else
     begin
       if IsConsoleComputerSystem then
          AssignFontParams(Font_ConsoleComputer[CustomSystemID])
       else
          begin
            case GameIsClone(gCloneOf) of
              True : AssignFontParams(Font_Clone);
              False: AssignFontParams(Font_Parent);
            end;
          end;
     end;
end;

procedure TFormMain.GetCanvasFontCustom(sysID: ShortInt; gGameSetStatus: ShortInt; gDriverStatus: ShortInt; const gCloneOf: String;
                                        CanvasHolder: TCanvas; CheckHaveMissFilter, GetNightModeColors: Boolean);
var
  tmpFont: TFont;

  //function CheckGameSet: Boolean;
  //begin
  //  Result:= gGameSetStatus = 1;
  //  if (Result and CheckHaveMissFilter) then
  //     Result:= ButtonGameFilterHaveMiss.Tag <> 3;
  //end;

begin
  // this function always gets default arcade game fonts, even for console/computer systems (EmuCon)
  tmpFont:= TFont.Create;
  if gGameSetStatus = 1 then //CheckGameSet then
     SetDefaultFont(tmpFont, 2, GetNightModeColors)
  else
  case gDriverStatus of
    2: SetDefaultFont(tmpFont, 0, GetNightModeColors) //2) // why show red font color for preliminary drivers ? (May 19, 2018)
  else
    SetDefaultFont(tmpFont, Ord(GameIsClone(gCloneOf)), GetNightModeColors);
  end;
  CanvasHolder.Font:= tmpFont;
  FreeAndNil(tmpFont);
end;

procedure TFormMain.GetCanvasDefaultFont(CanvasHolder: TCanvas; gGameSetStatus: ShortInt; gDriverStatus: ShortInt; GetNightModeColors: Boolean);
var
  tmpFont: TFont;
begin
  // this function always gets default arcade game fonts, even for console/computer systems (EmuCon)
  tmpFont:= TFont.Create;
  if gDriverStatus = 2 then
     begin
       if gGameSetStatus = 1 then
          SetDefaultFont(tmpFont, 4, GetNightModeColors)
       else
          SetDefaultFont(tmpFont, 2, GetNightModeColors);
     end
  else
     begin
       if gGameSetStatus = 1 then
          SetDefaultFont(tmpFont, 3, GetNightModeColors)
       else
          SetDefaultFont(tmpFont, 0, GetNightModeColors);
     end;
  CanvasHolder.Font:= tmpFont;
  FreeAndNil(tmpFont);
end;

