procedure TFormMain.CallSetDeleteOptions(const FileName: String; MenuHolder: TMenuItem; IsDriver: Boolean = False);
begin
  // FileName has NO extension
  if not ValidateSelectedGame then
     Exit;
  case IsDriver of
    True:
      begin
        if MemGameInfo.eDriverName = '' then
           Exit;
      end;
    False:
      begin
        if MemGameInfo.eName = '' then
           Exit;
      end;
  end;

  case MenuHolder.Tag of
    0: SetCustomOptions(FileName, IsDriver);
    1: DeleteCustomOptions(FileName, IsDriver);
  end;
end;

procedure TFormMain.PopupSetCustomOptionsClick(Sender: TObject);
begin
  CallSetDeleteOptions(MemGameInfo.eName, TMenuItem(Sender));
end;

procedure TFormMain.PopupSetGameDriverCustomOptionsClick(Sender: TObject);
begin
  CallSetDeleteOptions(ChangeFileExt(MemGameInfo.eDriverName, ''), TMenuItem(Sender), True);
end;

procedure TFormMain.PopupSetMAMEHorizontalGamesOptionsClick(
  Sender: TObject);
begin
  CallSetDeleteOptions(TMenuItem(Sender).Hint, TMenuItem(Sender));
end;

function TFormMain.AppendText(ARichEdit: TRichEditURL; const AText: WideString; AFontColor: TColor = clBlack; AFontStyle: TFontStyles = [];
         AAlignment: TAlignment = taLeftJustify; const AFontName: String = 'default'; AFontSize: Integer = -1;
         AFontCharSet: TFontCharSet = DEFAULT_CHARSET): Integer;
var
  reFontName: String;
  reFontCharSet: TFontCharSet;
  reFontSize: Integer;
begin
  if AFontName <> 'default' then
     reFontName:= ARichEdit.Font.Name;
  if AFontCharSet <> DEFAULT_CHARSET then
     reFontCharSet:= ARichEdit.Font.Charset;
  if AFontSize <> -1 then
     reFontSize:= ARichEdit.Font.Size;

  ARichEdit.SelStart:= ARichEdit.GetTextLen;
  Result:= ARichEdit.Lines.Count; // line index of added text
  ARichEdit.SelLength:= 0;

  //if ATextBackgroundColor <> Graphics.clNone then
  //   ARichEdit.TextBKColor(ATextBackGroundColor); // doesn't work ? (March 01, 2018)

  if AAlignment <> taLeftJustify then
     ARichEdit.Paragraph.Alignment:= AALignment;

  ARichEdit.SelAttributes.Color:= AFontColor;
  ARichEdit.SelAttributes.Style:= AFontStyle;

  if AFontName <> 'default' then
     ARichEdit.SelAttributes.Name:= AFontName;
  if AFontCharSet <> DEFAULT_CHARSET then
     ARichEdit.SelAttributes.Charset:= aFontCharset;
  if AFontSize <> -1 then
     ARichEdit.SelAttributes.Size:= AFontSize;
  ARichEdit.SelText:= AText;

  // restore defaults or next texts will have format of last added text
  if AAlignment <> taLeftJustify then
     ARichEdit.Paragraph.Alignment:= taLeftJustify;
  if AFontName <> 'default' then
     ARichEdit.SelAttributes.Name:= reFontName;
  if AFontSize <> -1 then
     ARichEdit.SelAttributes.Size:= reFontSize;
end;

procedure TFormMain.AddMsgText(const iTextToAdd: WideString; iFontColor: TColor = clBlack; iFontStyle: TFontStyles = []; iTextAlign: TAlignment = taLeftJustify;
                               iFontSize: Integer = -1; const iFontName: String = 'default'; const iFontCharSet: TFontCharSet = DEFAULT_CHARSET);
begin
  if (iFontColor = clBlack) and IsNightMode then
     iFontColor:= FormMessageBox.LabelMessage.Font.Color;
  AppendText(FormMessageBox.LabelMessage, iTextToAdd, iFontColor, iFontStyle, iTextAlign, iFontName, iFontSize, iFontCharSet);
end;

procedure TFormMain.SetSinglePanelLayoutGameDocuments;

  procedure SetAllNone;
  begin
    SplitterMAMEInfo.Align:= alNone;
    PanelImage.Align:= alNone;
    PanelGameDocuments.Align:= alNone;
  end;

begin
  if (PanelGameDocuments.Align = alClient) and (not MenuShowImages.Checked) then
     Exit;

  if not IsGameDocsSinglePanelDisplay then
     Exit;

  SetAllNone;

  case PanelGameDocuments.Tag of
    0: // info top, images bottom
      begin
        PanelGameDocuments.Align:= alTop;
        PanelGameDocuments.Height:= GameDocumentsLayout1_Top.Tag;
        SplitterMAMEInfo.Height:= 7;
        SplitterMAMEInfo.Top:= PanelGameDocuments.Height+7;
        SplitterMAMEInfo.Align:= alTop;
      end;
    1: // info bottom, images top
      begin
        PanelGameDocuments.Align:= alBottom;
        PanelGameDocuments.Height:= GameDocumentsLayout2_Bottom.Tag;
        SplitterMAMEInfo.Height:= 7;
        SplitterMAMEInfo.Top:= PanelGameDocuments.Top-7;
        SplitterMAMEInfo.Align:= alBottom;
      end;
    2: // info left, images right
      begin
        PanelGameDocuments.Align:= alLeft;
        PanelGameDocuments.Width:= GameDocumentsLayout3_Left.Tag;
        SplitterMAMEInfo.Width:= 7;
        SplitterMAMEInfo.Left:= PanelGameDocuments.Width+7;
        SplitterMAMEInfo.Align:= alLeft;
      end;
    3: // info right, images left
      begin
        PanelGameDocuments.Align:= alRight;
        PanelGameDocuments.Width:= GameDocumentsLayout4_Right.Tag;
        SplitterMAMEInfo.Width:= 7;
        SplitterMAMEInfo.Left:= PanelGameDocuments.Left-7;
        SplitterMAMEInfo.Align:= alRight;
      end;
  end;
  PanelImage.Align:= alClient;
end;

procedure TFormMain.UpdateScreenshotsPanel;
begin
  // only executed when toggle "images" and "game docs" on/off, nowhere else
  case IsGameDocsSinglePanelDisplay of
    True: // images and game docs in same panel
      begin
        case MenuShowImages.Checked of
          True:
            begin
              case PopupAutomaticGameInformation.Checked of
                True:
                  begin
                    SplitterMAMEInfo.Visible:= True;
                    PanelGameDocuments.Visible:= True;
                    SetSinglePanelLayoutGameDocuments;
                  end;
                False:
                  begin
                    if not PanelScreenshotsArea.Visible then
                       PanelScreenshotsArea.Visible:= True;
                    if not Splitter.Visible then
                       Splitter.Visible:= True;
                  end;
              end;
              if not PanelImage.Visible then
                 PanelImage.Visible:= True;
              if not PanelImagesDocuments.Visible then
                 PanelImagesDocuments.Visible:= True;
            end;
          False:
            begin
              case PopupAutomaticGameInformation.Checked of
                True:
                  begin
                    PanelImage.Visible:= False;
                    SplitterMAMEInfo.Visible:= False;
                    PanelGameDocuments.Align:= alClient;
                    PanelGameDocuments.Visible:= True;
                    if not IsStartup then
                       MAMEInfoTextHolder.Refresh;
                    if not PanelScreenshotsArea.Visible then
                       PanelScreenshotsArea.Visible:= True;
                    if not Splitter.Visible then
                       Splitter.Visible:= True;
                  end;
                False:
                  begin
                    Splitter.Visible:= False;
                    PanelScreenshotsArea.Visible:= False;
                  end;
              end;
            end;
        end;
      end;
    False: // images and game docs in separate panels (Game Docs "Display Mode")
      begin
        PanelScreenshotsArea.Visible:= MenuShowImages.Checked or PopupAutomaticGameInformation.Checked;
        SplitterMAMEInfo.Visible:= False;
        PanelImage.Visible:= TabbedImageGameDocSeparator.Tag = 0;
        PanelGameDocuments.Visible:= TabbedImageGameDocSeparator.Tag = 1;
        PanelGameDocuments.Align:= alClient;
      end;
  end;
end;

procedure TFormMain.ToggleGameDocuments(Enabled: Boolean);
var
  pathFile, emuPath, ValueStr: String;
  mameIni: THashedStringList;
  emuDATPaths: TStringList;
  Loop: Integer;

  function LocateDATFile(const DATFileName: String): String;
  var
    fLoop: Integer;
  begin
    Result:= '';
    for fLoop:=0 to emuDATPaths.Count -1 do
    begin
      if emuDATPaths[fLoop] <> '.' then
         begin
           if FileExists(emuDATPaths[fLoop]+DATFileName) then
           begin
             Result:= emuDATPaths[fLoop]+DATFileName;
             Break;
           end;
         end;
    end;
    if Result = '' then
       Result:= emupath+DATFileName;
  end;

  function LoadDAT(var StringListHolder: THashedStringList; MergeFileContents: Boolean = False): Boolean;
  var
    tmpFile: THashedStringList;
  begin
    Result:= pathFile <> '';
    if Result then
       Result:= FileExists(pathFile);

    if Result then
       begin
         if not Assigned(StringListHolder) then
            StringListHolder:= THashedStringList.Create;
         case MergeFileContents of
           True:
             begin
               tmpFile:= THashedStringList.Create;
               tmpFile.LoadFromFile(pathFile);
               if tmpFile.Count > 0 then
               begin
                 StringListHolder.BeginUpdate;
                 StringListHolder.AddStrings(tmpFile);
                 StringListHolder.EndUpdate;
               end;
               FreeAndNil(tmpFile);
             end;
           False: StringListHolder.LoadFromFile(pathFile);
         end;
       end;
  end;

begin
  ResetGameDocsQuickMenus;

  case Enabled of
    True:
      begin
        emuPath:= ExtractFilePath(EmulatorFile[idMAME]);
        if FileExists(emuPath+'ui.ini') then
        begin
          mameIni:= THashedStringList.Create;
          mameIni.LoadFromFile(emuPath+'ui.ini');
          for Loop:=0 to mameIni.Count-1 do
          begin
            if XML_CheckData(mameIni[Loop], 'historypath ') then
            begin
              ValueStr:= ExtractMAMEIniValue(mameIni[Loop]);
              Break;
            end;
          end;
          FreeAndNil(mameIni);
          if ValueStr = '' then
             ValueStr:= 'dats';
          ExtractFolders2MAME(idMAME, ValueStr, emuDATPaths);
        end;

        if emuDATPaths = nil then
           begin
             emuDATPaths:= THashedStringList.Create;
             emuDATPaths.Insert(0, emuPath);
           end;

        pathFile:= LocateDATFile('mameinfo.dat');
        LoadDAT(AutoMAMEInfoDATFile);

        pathFile:= LocateDATFile('messinfo.dat');
        LoadDAT(AutoMAMEInfoDATFile, True);

        pathFile:= LocateDATFile('history.dat');
        LoadDAT(AutoHistoryDATFile);

        pathFile:= LocateDATFile('story.dat');
        LoadDAT(AutoStoryDATFile);

        pathFile:= LocateDATFile('scores3.htm');
        if not LoadDAT(AutoMarpDATFile) then
           begin
             pathFile:= LocateDATFile('marp.dat');
             LoadDAT(AutoMarpDATFile);
           end;

        pathFile:= LocateDATFile('gameinit.dat');
        LoadDAT(AutoGameInitDATFile);

        FreeAndNil(emuDATPaths);
        PanelGameDocuments.Visible:= True;
        UpdateScreenshotsPanel;
      end;
    False:
      begin
        FreeAndNil(AutoMAMEInfoDATFile);
        FreeAndNil(AutoHistoryDATFile);
        FreeAndNil(AutoStoryDATFile);
        FreeAndNil(AutoMarpDATFile);
        FreeAndNil(AutoGameInitDATFile);

        GameDocsGoToInformation.Visible:= False;
        GameDocsGoToHistory.Visible:= False;
        GameDocsGoToDriverInfo.Visible:= False;
        GameDocsGoToStory.Visible:= False;
        GameDocsGoToMarp.Visible:= False;
        GameDocsGoToGameInit.Visible:= False;

        MAMEInfoTextHolder.Lines.Clear;
        SplitterMAMEInfo.Visible:= False;
        PanelGameDocuments.Visible:= False;

        if PanelGameDocuments.Align = alClient then
           begin
             PanelGameDocuments.Align:= alTop;
             if PanelGameDocuments.Tag <> 1 then
                PanelGameDocuments.Height:= PanelGameDocuments.Tag
             else
                PanelGameDocuments.Height:= 151;
           end;
        UpdateScreenshotsPanel;
      end;
  end;
end;

procedure TFormMain.ResetGameDocsQuickMenus;
begin
  GameDocsGoToInformation.Tag:= -1;
  GameDocsGoToHistory.Tag:= -1;
  GameDocsGoToDriverInfo.Tag:= -1;
  GameDocsGoToStory.Tag:= -1;
  GameDocsGoToMarp.Tag:= -1;
  GameDocsGoToGameInit.Tag:= -1;
end;

function TFormMain.ShowGameInfoValidate: Boolean;
begin
  Result:= (not ProcessingGameDocuments) and PopupAutomaticGameInformation.Checked;
  if Result then
     begin
       if not IsGameDocsSinglePanelDisplay then
          Result:= ButtonDocsPanelToggle.Down;
     end;
end;

procedure TFormMain.ShowGameInfoAll;
var
  LineIndex: Integer;
  AddLine, NoFilesMsg: Boolean;
  DATVersion: String;
  docItem: TEasyItem;

  function AddTextLine(const TextLine: String): Boolean;
  begin
    Result:= True;
    MAMEInfoTextHolder.Lines.Add(TextLine);
  end;

  function AddTitleTextLine(const TextLine: String): Integer;
  begin
    Result:= AppendText(MAMEInfoTextHolder, TextLine, MAMEInfoTextHolder.Font.Color, [fsBold], taCenter);
  end;

  function InformationData: Boolean;
  begin
    Result:= MemGameInfo.eSoftwareName = '';
    if Result then
    begin
      Result:= Assigned(AutoMAMEInfoDATFile);
      AddLine:= False;
      if Result then
         begin
           NoFilesMsg:= False;
           LineIndex:= AutoMAMEInfoDATFile.IndexOf('$info='+MemGameInfo.eName);
           Result:= LineIndex <> -1;

           if not Result then
              begin
                if GameIsClone(MemGameInfo.eClone) then
                   begin
                     LineIndex:= AutoMAMEInfoDATFile.IndexOf('$info='+MemGameInfo.eClone);
                     Result:= LineIndex <> -1;
                   end;
              end;
           if Result then
              begin
                Inc(LineIndex);
                while Trim(AutoMAMEInfoDATFile[LineIndex]) <> '$end' do
                begin
                  case AddLine of
                    False:
                      begin
                        if Trim(AutoMAMEInfoDATFile[LineIndex]) = '$mame' then
                           begin
                             AddLine:= True;
                             GameDocsGoToInformation.Tag:= AddTitleTextLine('---------- Information Data ----------'+#13#10);
                           end;
                      end;
                    True: AddTextLine(AutoMAMEInfoDATFile[LineIndex]);
                  end;
                  Inc(LineIndex);
                end;
              end;
         end;
    end;
    GameDocsGoToInformation.Visible:= GameDocsGoToInformation.Tag <> -1;// Result;
  end;

  function AddHistoryURL(const strLine: String; linkIndex: Integer): Boolean;
  var
    titleText, linkText: String;
    endLink: Integer;
  begin
    if linkIndex > 0 then
       titleText:= Copy(strLine, 1, linkIndex-1);

    endLink:= PosEx('">', strLine);
    linkText:= 'http://www.arcade-history.com/index.php'+Copy(strLine, linkIndex+9, endLink-linkIndex-9);

    titleText:= TitleText+Copy(strLine, endLink+2, Length(strLine));
    endLink:= PosEx('</a>', titleText);
    if endLink <> 0 then
       Delete(titleText, endLink, 3);

    Result:= (titleText <> '') and (linkText <> '');
    if Result then
       AddTextLine(titleText+': '+linkText);
  end;

  function HistoryData: Boolean;
  var
    Loop, Loop2, webIndex, TagStrSize: Integer;
    TagString, TagEndInfo: String;
    FoundData: Boolean;
  begin
    Result:= Assigned(AutoHistoryDATFile);
    if Result then
       begin
         NoFilesMsg:= False;
         AddLine:= False;
         FoundData:= False;
         if MemGameInfo.eSoftwareName = '' then
              TagString:= '$info'
           else
              TagString:= '$'+MemGameInfo.eSoftwareName;
           TagStrSize:= Length(TagString);
         TagEndInfo:= '$end';
         for Loop:=0 to AutoHistoryDATFile.Count -1 do
         begin
           if Copy(AutoHistoryDATFile[Loop], 1, TagStrSize) = TagString then
              begin
                Result:= GetGameHistory(MemGameInfo.eName, AutoHistoryDATFile[Loop], TagStrSize);
                if Result then
                   begin
                     Loop2:= Loop+1;
                     GameDocsGoToHistory.Tag:= AddTitleTextLine('---------- History Data ----------'+#13#10);
                     while Trim(AutoHistoryDATFile[Loop2]) <> TagEndInfo do
                     begin
                       case AddLine of
                         False:
                           begin
                             if Trim(AutoHistoryDATFile[Loop2]) = '$bio' then
                                AddLine:= True;
                           end;
                         True:
                           begin
                             webIndex:= PosEx('<a href=', AutoHistoryDATFile[Loop2]);
                             if webIndex <> 0 then
                                AddHistoryURL(AutoHistoryDATFile[Loop2], webIndex)
                             else
                                AddTextLine(AutoHistoryDATFile[Loop2]);
                           end;
                       end;
                       Inc(Loop2);
                     end;
                     if AutoHistoryDATFile[Loop2] = TagEndInfo then
                        FoundData:= True;
                   end;
              end;
           if FoundData then
              Break; // get out of the "history.dat" loop or the function will will go all the down to the end of the file
         end;
       end;
    GameDocsGoToHistory.Visible:= GameDocsGoToHistory.Tag <> -1;
  end;

  function GameDriverData: Boolean;
  begin
    Result:= MemGameInfo.eSoftwareName = '';
    if Result then
    begin
      Result:= Assigned(AutoMAMEInfoDATFile);
      if Result then
         begin
           NoFilesMsg:= False;
           AddLine:= False;
           LineIndex:= AutoMAMEInfoDATFile.IndexOf('$info='+MemGameInfo.eDriverName);
           Result:= LineIndex <> -1;
           if Result then
              begin
                Inc(LineIndex);
                GameDocsGoToDriverInfo.Tag:= AddTitleTextLine('---------- Driver Data ----------'+#13#10);
                DATVersion:= AutoMAMEInfoDATFile[0];
                Delete(DATVersion, 1, 2);
                AddTextLine(DATVersion+#13#10);
                while Trim(AutoMAMEInfoDATFile[LineIndex]) <> '$end' do
                begin
                  case AddLine of
                    False:
                      begin
                        if Trim(AutoMAMEInfoDATFile[LineIndex]) = '$drv' then
                           AddLine:= True;
                      end;
                    True: AddTextLine(AutoMAMEInfoDATFile[LineIndex]);
                  end;
                  Inc(LineIndex);
                end;
              end;
         end;
    end;
    GameDocsGoToDriverInfo.Visible:= GameDocsGoToDriverInfo.Tag <> -1;
  end;

  function StoryData: Boolean;
  begin
    Result:= MemGameInfo.eSoftwareName = '';
    if Result then
    begin
    Result:= Assigned(AutoStoryDATFile);
      if Result then
         begin
           NoFilesMsg:= False;
           AddLine:= False;
           LineIndex:= AutoStoryDATFile.IndexOf('$info='+MemGameInfo.eName);
           Result:= LineIndex <> -1;
           if Result then
              begin
                Inc(LineIndex);
                GameDocsGoToStory.Tag:= AddTitleTextLine('---------- Story Data ----------'+#13#10);
                DATVersion:= AutoStoryDATFile[0];
                Delete(DATVersion, 1, 2);
                AddTextLine(DATVersion+#13#10);
                while Trim(AutoStoryDATFile[LineIndex]) <> '$end' do
                begin
                  case AddLine of
                    False:
                      begin
                        if (Trim(AutoStoryDATFile[LineIndex]) = '$bio') or
                           (Trim(AutoStoryDATFile[LineIndex]) = '$story') then
                           AddLine:= True;
                      end;
                    True: AddTextLine(AutoStoryDATFile[LineIndex]);
                  end;
                  Inc(LineIndex);
                end;
              end;
         end;
    end;
    GameDocsGoToStory.Visible:= GameDocsGoToStory.Tag <> -1;
  end;

  function MarpData: Boolean;
  var
    IsHTM: Boolean;
    iLoopH, iPos2H: Integer;
    ScoreStr: String;
  begin
    Result:= MemGameInfo.eSoftwareName = '';
    if Result then
    begin
      Result:= Assigned(AutoMarpDATFile);
      if Result then
         begin
           IsHTM:= Pos('<HTML>', AutoMarpDATFile[0]) <> 0;
           NoFilesMsg:= False;
           AddLine:= False;
           if IsHTM then
           begin
             // scores3.htm
             LineIndex:= -1;
             iPos2H:= 0;
             for iLoopH:= 2 to AutoMarpDATFile.Count-1 do
             begin
               if iPos2H = 0 then
                  begin
                    iPos2H:= Pos(': - score -', AutoMarpDATFile[iLoopH]);
                    if iPos2H <> 0 then
                       iPos2H:= iPos2H+13; // where score column finishes
                  end;
               if Pos(MemGameInfo.eName+' ', TrimLeft(AutoMarpDATFile[iLoopH])) <> 0 then
               begin
                 LineIndex:= iLoopH;
                 Break;
               end;
             end;
             Result:= LineIndex <> -1;
             if Result then
                begin
                  GameDocsGoToMarp.Tag:= AddTitleTextLine('---------- MAME Action Replay Page ----------'+#13#10);
                  DATVersion:= TrimLeft(AutoMarpDATFile[1]);
                  AddTextLine(DATVersion+#13#10+'[ http://replay.marpirc.net/r/'+MemGameInfo.eName+' ]'+#13#10);
                  iLoopH:= Pos(':', AutoMarpDATFile[LineIndex])+1; // 1st char
                  //ScoreStr:= AutoMarpDATFile[LineIndex];
                  //beep;
                  ScoreStr:= Copy(AutoMarpDATFile[LineIndex], iLoopH, Length(AutoMarpDATFile[LineIndex]));
                  Delete(ScoreStr, PosEx(':', ScoreStr, iPos2H), Length(AutoMarpDATFile[LineIndex]));
                  AddTextLine(' 1.    '+TrimRight(ScoreStr));

                  ScoreStr:= Copy(AutoMarpDATFile[LineIndex+1], iLoopH, Length(AutoMarpDATFile[LineIndex+1]));
                  Delete(ScoreStr, PosEx(':', ScoreStr, iPos2H), Length(AutoMarpDATFile[LineIndex+1]));
                  AddTextLine(' 2.    '+TrimRight(ScoreStr));

                  ScoreStr:= Copy(AutoMarpDATFile[LineIndex+2], iLoopH, Length(AutoMarpDATFile[LineIndex+2]));
                  Delete(ScoreStr, PosEx(':', ScoreStr, iPos2H), Length(AutoMarpDATFile[LineIndex+2]));
                  AddTextLine(' 3.    '+TrimRight(ScoreStr));
                end;
           end
           else
           begin
             // marp.dat
             LineIndex:= AutoMarpDATFile.IndexOf('$info='+MemGameInfo.eName);
             Result:= LineIndex <> -1;
             if Result then
                begin
                  Inc(LineIndex);
                  GameDocsGoToMarp.Tag:= AddTitleTextLine('---------- MAME Action Replay Page ----------'+#13#10);
                  DATVersion:= AutoMarpDATFile[0];
                  Delete(DATVersion, 1, 2);
                  AddTextLine(DATVersion+#13#10);
                  while Trim(AutoMarpDATFile[LineIndex]) <> '$end' do
                  begin
                    case AddLine of
                      False:
                        begin
                          if (Trim(AutoMarpDATFile[LineIndex]) = '$marp') then
                             AddLine:= True;
                        end;
                      True: AddTextLine(AutoMarpDATFile[LineIndex]);
                    end;
                    Inc(LineIndex);
                  end;
                end;
           end;
         end;
    end;
    GameDocsGoToMarp.Visible:= GameDocsGoToMarp.Tag <> -1;
  end;

  function GameInitData: Boolean;
  begin
    Result:= MemGameInfo.eSoftwareName = '';
    if Result then
    begin
      Result:= Assigned(AutoGameInitDATFile);
      AddLine:= False;
      if Result then
         begin
           NoFilesMsg:= False;
           LineIndex:= AutoGameInitDATFile.IndexOf('$info='+MemGameInfo.eName);
           Result:= LineIndex <> -1;

           if not Result then
              begin
                if GameIsClone(MemGameInfo.eClone) then
                   begin
                     LineIndex:= AutoGameInitDATFile.IndexOf('$info='+MemGameInfo.eClone);
                     Result:= LineIndex <> -1;
                   end;
              end;
           if Result then
              begin
                Inc(LineIndex);
                while Trim(AutoGameInitDATFile[LineIndex]) <> '$end' do
                begin
                  case AddLine of
                    False:
                      begin
                        if Trim(AutoGameInitDATFile[LineIndex]) = '$mame' then
                           begin
                             AddLine:= True;
                             GameDocsGoToGameInit.Tag:= AddTitleTextLine('---------- Game Initialization ----------'+#13#10);
                           end;
                      end;
                    True: AddTextLine(AutoGameInitDATFile[LineIndex]);
                  end;
                  Inc(LineIndex);
                end;
              end;
         end;
    end;
    GameDocsGoToGameInit.Visible:= GameDocsGoToGameInit.Tag <> -1;
  end;

  procedure LoadText(Index: Integer);
  begin
    case Index of
      1: InformationData;
      2: HistoryData;
      3: GameDriverData;
      4: StoryData;
      5: MarpData;
      6: GameInitData;
    end;
  end;

begin
  GameDocsGoToInformation.Tag:= -1;
  GameDocsGoToHistory.Tag:= -1;
  GameDocsGoToDriverInfo.Tag:= -1;
  GameDocsGoToStory.Tag:= -1;
  GameDocsGoToMarp.Tag:= -1;
  GameDocsGoToGameInit.Tag:= -1;
  if IsStartup then
     Exit;
  if not ValidateSelectedGame(False) then
     Exit;

  if not IsMAMEBasedSys(MemGameInfo.eSystemID) then
     begin
       ClearGameInfoRichEdit;
       Exit;
     end;
  ProcessingGameDocuments:= True;

  // detect files with full path
  MAMEInfoTextHolder.Lines.BeginUpdate;
  MAMEInfoTextHolder.Lines.Clear;
  NoFilesMsg:= True;
  docItem:= FormPreferences.GameDocs.Groups.FirstItem;
  repeat
    if docItem.Checked then
       LoadText(docItem.Tag);
    docItem:= FormPreferences.GameDocs.Groups.NextItem(docItem);
  until docItem = nil;
  if NoFilesMsg then
     AddTextLine('    No .dat files were found!'+#13#10+'Place files in "mamedir\dats\" folder or change the "historypath" entry in "mamedir\ui.ini" file.');
  MAMEInfoTextHolder.Lines.EndUpdate;
  SendMessage(MAMEInfoTextHolder.Handle, WM_VSCROLL, SB_TOP, 0); // move scrollbar to top
  ProcessingGameDocuments:= False;
end;

