function TFormMain.VerifyArcadeGamesSys(sysID: ShortInt; const SoftwareName: String = ''): Boolean;
begin
  Result:= ValidateFile(GetGamesFolderEL(Ord(SoftwareName <> ''))+GetSystemFileName(sysID, 0, SoftwareName)); // systemname.el
  if Result then
     begin
       if IsROMsListBasedSys(sysID) then
          Result:= ValidateFile(GetGamesFolderEL(Ord(SoftwareName <> ''))+GetSystemFileName(sysID, 1, SoftwareName)); // systemname.elrom
       if Result then
          Result:= ValidateFile(GetGamesFolderEL(Ord(SoftwareName <> ''))+GetSystemFileName(sysID, 2, SoftwareName)); // systemname.elstatus
     end;
end;

function TFormMain.VerifyGamesMAMESoftlist(sysID: ShortInt): Boolean;
var
  Search: TSearchRecW;
  FolderStr: WideString;
begin
  FolderStr:= GetGamesFolderEL(1, sysID);
  Result:= FindFirstW(FolderStr+'*.el', faAnyFile, Search) = 0; // first_file.el
  FindCloseW(Search);
  if Result then
     begin
       Result:= FindFirstW(FolderStr+'*.elrom', faAnyFile, Search) = 0; // first_file.elrom
       FindCloseW(Search);
     end;
  if Result then
     begin
       Result:= FindFirstW(FolderStr+'*.elstatus', faAnyFile, Search) = 0; // first_file.elstatus
       FindCloseW(Search);
     end;
end;

function TFormMain.DecodeHTML(const s: String): String;
const
  ChrMapStr = '&quot;&lt;&gt;&apos;&amp;&nbsp;';
type
  TCharSet = set of Char;
var
  j: Integer;
  pp,pe: PChar;
  tmp: String;

  function TrimSpaces(const str: String; ChrSpace: TCharSet = [#9, #10, #13, #32]): String;
  var
    i, l: Integer;
  begin
    l:= Length(str);
    i:= 1;
    while (i <= l) and (str[i] in ChrSpace) do Inc(i);
    if i > l then
       Result:= ''
    else
      begin
        while (str[l] in ChrSpace) do Dec(l);
        Result:= Copy(str, i, l-i+1);
      end;
  end;
  
begin
  Result:= TrimSpaces(s);
  if Result = '' then Exit;
  pp:= PChar(Result);
  repeat
    pp:= StrScan(pp, '&');
    if pp = nil then Exit;
    Inc(pp);
    j:= pp-PChar(Result);
    pe:= pp;
    while ((pe^ <> #0) and not (pe^ in [' ', ';'])) do Inc(pe);
    if (pp^='#') then
       begin
         if UpCase((pp+1)^) = 'X' then
            (pp+1)^:= '$';
         SetString(tmp, pp+1, pe-pp-1);
         Result[j]:= chr(StrToIntDef(tmp, 32));
         Delete(Result, j+1, pe-pp+1);
       end
    else
       begin
         SetString(tmp, pp-1, pe-pp+1);
         case PosEx(tmp, ChrMapStr) of
            1: Result[j]:= '"';
            7: Result[j]:= '<';
           11: Result[j]:= '>';
           15: Result[j]:= '''';
           21: Result[j]:= '&';
           26: Result[j]:= ' ';
         else
           Continue;
         end;
         Delete(Result, j+1, pe-pp+1);
       end;
  until False;
end;

function TFormMain.FixDriverSourceName(const DriverStr: String): String;
var
  Index: Integer;
begin
  // for MAME and HBMAME... get driver name only and remove any sub-folders!
  Result:= DriverStr;
  if DriverStr <> '' then
     begin
       Index:= LastDelimiter('/', DriverStr);
       Result:= Copy(DriverStr, Index+1, Length(DriverStr));
       //ShowMessage(DriverStr+#13#10+Result); // for debugging only 
     end;
end;

