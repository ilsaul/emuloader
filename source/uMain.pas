       Result:= ButtonGameFilterHaveMiss.Tag <> 3;
  end;

  function AssignFontParams(FontHolder: TFont): Boolean;
  begin
    Result:= Assigned(FontHolder);
    if Result then
       CanvasHolder.Font:= FontHolder
    else
       CanvasHolder.Font:= ELV_Source.Font;
  end;

begin
  if CheckGameSet then
     begin
       if gDriverStatus = 2 then
          AssignFontParams(Font_MissingROMsPreliminary)
       else
          AssignFontParams(Font_MissingROMs);
     end
  else
  if gDriverStatus = 2 then
     AssignFontParams(Font_Preliminary)
  else
     begin
       if IsConsoleComputerSystem then
          AssignFontParams(Font_ConsoleComputer[CustomSystemID])
       else
          begin
            case GameIsClone(gCloneOf) of
              True : AssignFontParams(Font_Clone);
              False: AssignFontParams(Font_Parent);
            end;
          end;
     end;
end;

procedure TFormMain.GetCanvasFontCustom(sysID: ShortInt; gGameSetStatus: ShortInt; gDriverStatus: ShortInt; const gCloneOf: String;
                                        CanvasHolder: TCanvas; CheckHaveMissFilter: Boolean = False);
var
  tmpFont: TFont;

  function CheckGameSet: Boolean;
  begin
    Result:= gGameSetStatus = 1;
    if (Result and CheckHaveMissFilter) then
       Result:= ButtonGameFilterHaveMiss.Tag <> 3;
  end;

begin
  // this function always gets default arcade game fonts, even for console/computer systems (EmuCon)
  tmpFont:= TFont.Create;
  if CheckGameSet then
     SetDefaultFont(tmpFont, 2)
  else
  case gDriverStatus of
    2: SetDefaultFont(tmpFont, 2)
  else
    SetDefaultFont(tmpFont, Ord(GameIsClone(gCloneOf)));
  end;
  CanvasHolder.Font:= tmpFont;
  FreeAndNil(tmpFont);
  //tmpFont.Free;
end;

