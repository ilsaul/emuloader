procedure TFormMain.ELV_SetBackgroundColor(ELV_Holder: TEasyListView; ShowBkImage: Boolean = False);
begin
  if ELV_Holder.Color <> GamesListView.Color then
     ELV_Holder.Color:= GamesListView.Color;
  if not ShowBkImage then
     Exit;
  ELV_Holder.BackGround.Enabled:= GamesListView.BackGround.Enabled;
  if ELV_Holder.BackGround.Enabled then
     begin
       if GamesListView.BackGround.Image <> nil then
          ELV_Holder.BackGround.Image.Assign(GamesListView.BackGround.Image);
     end;
end;

procedure TFormMain.ELV_RemoveDefaultGroup(ELV_Holder: TEasyListView);
begin
  // this function must be called BEFORE sorting the list and enabling ItemReindex
  ELV_Holder.Groups.DeleteGroup(ELV_Holder.Groups.FirstGroup);
end;

procedure TFormMain.ELV_RemoveEmptyGroups(ELV_Holder: TEasyListView);
var
  Group: TEasyGroup;
begin
  ELV_Holder.BeginUpdate;
  Group:= ELV_Holder.Groups.FirstGroup;
  repeat
    if Group.ItemCount = 0 then
       ELV_Holder.Groups.DeleteGroup(Group);
    Group:= ELV_Holder.Groups.NextGroup(Group);
  until Group = nil;
  ELV_Holder.EndUpdate;
end;

