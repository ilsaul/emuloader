procedure TFormMain.SetImageScaleMode;

  procedure UpdateScale(ImageHolder: TImage32);
  begin
    case PopupImageStretch.Checked of
      True:
        begin
          case PopupImageStretchLarger.Checked of
            True:
              begin
                if (ImageHolder.Bitmap.Width > ImageHolder.Width) or (ImageHolder.Bitmap.Height > ImageHolder.Height) then
                   begin
                     if ImageHolder.ScaleMode <> smResize then
                        ImageHolder.ScaleMode:= smResize
                   end
                else
                   begin
                     if ImageHolder.ScaleMode <> smNormal then
                        ImageHolder.ScaleMode:= smNormal;
                   end;
              end;
            False:
              begin
                if ImageHolder.ScaleMode <> smResize then
                   ImageHolder.ScaleMode:= smResize;
              end;
          end;
        end;
      False:
        begin
          if ImageHolder.ScaleMode <> smNormal then
             ImageHolder.ScaleMode:= smNormal;
        end;
    end;
    if (PopupImageStretch.Tag = 0) and (not IsStartup) then
       FocusGamesList;
  end;

begin
  UpdateScale(Images);
  if Assigned(ImageScr[2]) then
     UpdateScale(ImageScr[2]);
  if Assigned(ImageScr[3]) then
     UpdateScale(ImageScr[3]);
end;

function TFormMain.GetImageName(const GameName: String; ImageIndex: ShortInt; FormatIndex: ShortInt; SoftwareName: String = ''): String;
var
  SoftwareFolder: String;
begin
  SoftwareFolder:= '';
  if SoftwareName <> '' then
     SoftwareFolder:= SoftwareName+'\';
  case FormatIndex of
    0: // EL Format [elevator0005.png]
      begin
        if ImageIndex = 1 then
           Result:= SoftwareFolder+GameName
        else
           Result:= SoftwareFolder+GameName+Format('%.4u', [ImageIndex-2]);
      end;
    1: Result:= SoftwareFolder+GameName+'\'+Format('%.4u', [ImageIndex-1]); // New MAME Format [elevator\0005.png]
  end;
end;

procedure TFormMain.CycleImageCategory(MoveForward: Boolean);
var
  CategoryEnabled: Boolean;
  ImgIndex: ShortInt;
begin
  if IsImageLayoutView then
     Exit;
  ImgIndex:= ButtonImageCategory.Tag;
  repeat
    case MoveForward of
      True: // next type
        begin
          Inc(ImgIndex);
          if ImgIndex = High(ImageCategoryArray) then
             ImgIndex:= 0;
        end;
      False: // previous type
        begin
          Dec(ImgIndex);
          if ImgIndex < Low(ImageCategoryArray) then
             ImgIndex:= High(ImageCategoryArray)-1;
        end;
    end;
    CategoryEnabled:= PopupMenuImageCategories.Items[ImgIndex].Visible;
    if CategoryEnabled then
       PopupMenuImageCategories.Items[ImgIndex].Click;
  until CategoryEnabled;
end;

function TFormMain.VerifyZipType(ZipString: String; GetFolder: Boolean; FullZipPath: Boolean = False): String;
begin
  case SameText(ExtractFileExt(ZipString), '.zip') of
    True:
      begin
        case GetFolder of
          True: Result:= ExtractFilePath(ZipString);
          False:
            begin
              case FullZipPath of
                True : Result:= ZipString;
                False: Result:= ExtractFileName(ZipString);
              end;
            end;
        end;
      end;
    False:
      begin
        case GetFolder of
          True : Result:= ZipString;
          False: Result:= 'dummy.zip';
        end;
      end;
  end;
end;

