  //  //else
  //  //if ProcessExists('EVGAPrecision.exe') then
  //  //   AddTextMsg('    You have "eVGA Precision X" running. Please close it and try running the game again.');
  //end;

begin
  // MAME Extra setting = 120  --> AlterMAME ... NOT valid anymore!!!
  // AlterMAME extra setting value is now "1"!!!
  if MAME_ExtraSetting <> 1 then
     EmulatorTitle:= GetEmulatorDescription(MemGameInfo.eSystemID)
  else
     EmulatorTitle:= 'AlterMAME';
  SetCmdLineTitle;
  ErrorMsgTitle:= 'Error: '+msgboxTitle;
  ExitCode:= 0; // all is well
  ExitCodeAlterMAME:= 0; // all is well
  Result:= 0; // all is well
  TryAgainAlterMAME:= False;
  IsDemulEmptySystem:= False;
  IsBatchFile:= False;
  IsBatchFileAlterMAME:= False;

  IsMultiSlot:= False;
  MultiSlotMachineName:= '';
  MachineNameStr:= '';
  SoftwareNameFolder:= '';

  ValidateAlterMAME;
  if MAME_ExtraSetting = 1 then
     begin
       if not IsAlterMAME then
          begin
            CallMessageBox;
            if AlterMAMEFile <> '' then
               NewOption:= 'not found.'
            else
               NewOption:= 'blank';

            GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                       '    Cannot execute because the emulator filename is '+NewOption+'. '+
                       'Please go to Emulator Setup screen and make sure the selected AlterMAME exists.', 2, False, 1);
            ResetSettings;
            Exit;
          end;
     end
  else
  if (not ValidateEmulatorFile(MemGameInfo.eSystemID)) then
     begin
       if EmulatorFile[MemGameInfo.eSystemID] <> '' then
          NewOption:= 'not found'
       else
          NewOption:= 'blank';
       GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                       '    Cannot execute because the emulator filename is '+NewOption+'. '+
                       'Please go to Emulator Setup screen and make sure the selected emulator exists.', 2, False, 1);
       ResetSettings;
       Exit;
     end;

  //msgboxTitle:= '';

  if not VerifyGamesSys(MemGameInfo.eSystemID, MemGameInfo.eSoftwareName) then
     begin
       ResetSettings;
       Exit;
     end;

  //if IsROMsListBasedSys(MemGameInfo.eSystemID) then
  //   begin
  //     if not Check_ROMsData_File(MemGameInfo.eSystemID) then
  //        begin
  //          ResetSettings;
  //          Exit;
  //        end;
  //   end;
  GetScreenResolutions;

  if IsAlterMAME then
     IsBatchFile:= IsExeBatchFile(AlterMAMEFile)
  else
     begin
       IsBatchFile:= IsExeBatchFile(EmulatorFile[MemGameInfo.eSystemID]);
       if TryAgainAlterMAME then
          IsBatchFileAlterMAME:= IsExeBatchFile(AlterMAMEFile);
     end;

  case IsAlterMAME of
    True : CommandLine:= SystemStr+AlterMAMEFile+SystemStr+' ';
    False: CommandLine:= SystemStr+EmulatorFile[MemGameInfo.eSystemID]+SystemStr+' ';
  end;

  if (MemGameInfo.eSystemID = idMAME) and (MemGameInfo.eSoftwareName <> '') then
  begin
    // need to create a .ini file listing all software lists and the supported machines
    // [msx1_cart]
    // ax350
    // expert11
    // ...
    if PanelMachinesList.Visible then
       begin
         if CheckSelected(MachinesListSidePanel) then
            MachineNameStr:= SelectedMachineListName;
       end;
    if MachineNameStr = '' then
       MachineNameStr:= GetLastUsedMachineSoftwareList(MemGameInfo.eSoftwareName);
    if MachineNameStr <> '' then
       CommandLine:= CommandLine+MachineNameStr+' ';
    if MemGameInfo.eSoftwareExecParameter <> '' then
       CommandLine:= CommandLine+'-'+MemGameInfo.eSoftwareExecParameter+' '+MemGameInfo.eName
    else
       CommandLine:= CommandLine+MemGameInfo.eName;

    SoftwareNameFolder:= MemGameInfo.eSoftwareName+'\';
  end
  else
  begin
    if (MemGameInfo.eSystemID = idDICE) and (MemGameInfo.eName = 'attack2') then
       CommandLine:= CommandLine+'attack' // for "Attack (set 2)"
    else
    if not (MemGameInfo.eSystemID in [idSupermodel, idDemul, idZiNc]) then
       begin
         MultiSlotMachineName:= ChangeFileExt(MemGameInfo.eDriverName, '');
         if IsNeoGeoDriver(MemGameInfo.eSystemID, MultiSlotMachineName, MemGameInfo.eBiosName) then
            MultiSlotMachineName:= 'neogeo';
         IsMultiSlot:= ValidateMultiSlot(MemGameInfo.eSystemID, MultiSlotMachineName, CommandLine, not MenuViewEmulatorFullCommandLine.Checked);
         if not IsMultiSlot then
            begin
              MultiSlotMachineName:= '';
              if FormMultiSlotGames <> nil then
              if FormMultiSlotGames.ModalResult = mrNo then
                 begin
                   FreeAndNil(FormMultiSlotGames);
                   ResetSettings;
                   Exit;
                 end;
              CommandLine:= CommandLine+MemGameInfo.eName; // regular command line --> "emulator.exe gamename"
              // Supermodel, Demul, ZiNc need special parameters...
            end;
       end;
  end;

  ItemToUpdate:= SelectedEasyItem;
  if IsBatchFile then
     CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr; // cmd.exe /c "emu-call.bat"

  case IsBatchFile of
    True:
      begin
        // cmd.exe /c "emu-call.bat"
        //CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;
      end;
    False:
      begin
        //if (not (MemGameInfo.eSystemID in [idSupermodel, idDemul, idZiNc])) then
        //   CommandLine:= CommandLine+MemGameInfo.eName; // regular command line --> "emulator.exe gamename"
        //   // Supermodel, Demul, ZiNc need special parameters...

        case IsMAMEBasedSys(MemGameInfo.eSystemID) of
          True:
            begin
              if (MAME_ExtraSetting <> -1) and (not IsAlterMAME) then
                 begin
                   // -1: none... invalid!
                   // 20: playback input
                   // 21: record input
                   // 22: load a save state (not used anymore!!!)
                   // 23: record wave
                   // 24: record mng
                   // 25: record avi
                   // 26: * left panel file select (not used anymore!!!)
                   // 27: use an effect overlay
                   // 28: Select Effect Overlay (MAME Settings)
                   // 29: Select Font Files, emulator (BDF)
                   // 30: Select Font Files, game, driver (BDF)
                   // 31: Select Shadow Mask Texture (MAME Settings)
                   // all these options are now MAME exclusive features
                   case MAME_ExtraSetting of
                     20, 21:
                       begin
                         if InputDir[Ord(MemGameInfo.eSystemID = idMAME)] = '' then
                            begin
                              GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Input folder is blank.',
                                              '    In order to playback / record input files, you need to select a folder '+
                                              'in '+GetSystemShortTitle(MemGameInfo.eSystemID)+' default settings screen.', 2, False, 1);
                              ResetSettings;
                              Exit;
                            end
                         else
                            begin
                              if MAME_ExtraSetting = 20 then
                                 begin
                                   if not DirectoryExists(InputDir[Ord(MemGameInfo.eSystemID = idMAME)]) then
                                      begin
                                        CallMessageBox;
                                        ShowGameNameEntryMsgBox;
                                        AddMsgText('    Folder ');
                                        AddMsgText(InputDir[Ord(MemGameInfo.eSystemID = idMAME)], $00a65300, [fsBold]);
                                        AddMsgText(' was not found. There are no input files to load. Select a valid input folder in '+
                                                   GetSystemShortTitle(MemGameInfo.eSystemID)+' default settings screen or record an input for the selected '+
                                                   'game first.'+#13#10+'Aborting...');
                                        GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Input folder doesn''t exist.', '', 2, False, 1);
                                        ResetSettings;
                                        Exit;
                                      end;
                                 end
                              else
                                 begin
                                   if not ForceDirectories(InputDir[Ord(MemGameInfo.eSystemID = idMAME)]) then
                                      begin
                                        CallMessageBox;
                                        ShowGameNameEntryMsgBox;
                                        AddMsgText('    Folder ');
                                        AddMsgText(InputDir[Ord(MemGameInfo.eSystemID = idMAME)], $00a65300, [fsBold]);
                                        AddMsgText(' was not found and could not be created. Create the input folder manually or '+
                                                   'select another folder in '+GetSystemShortTitle(MemGameInfo.eSystemID)+
                                                   ' default settings screen.'+#13#10+'Aborting...');
                                        GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Input folder doesn''t exist.', '', 2, False, 1);
                                        ResetSettings;
                                        Exit;
                                      end;
                                 end;
                            end;
                       end;
                     22:
                       begin
                         {if SaveStateDir = '' then
                            begin
                              GenerateMessage(ErrorMsgTitle, Format('Save state folder is blank [%s].', [GetEmulatorDescription(MemGameInfo.eSystemID)]),
                                              Format('In order to load save state files, you need to select a folder '+
                                              'on %s default settings screen.', [GetEmulatorDescription(MemGameInfo.eSystemID)]), 2, False, 1);
                              ResetSettings;
                              Exit;
                            end;}
                       end;
                     23, 24, 25:
                       begin
                         NewOption:= GetFolderFull(1, MemGameInfo.eSystemID);
                         if NewOption = '' then
                            begin
                              GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Multimedia folder is blank.',
                                              '    In order to record wav/mng/avi files you must select a snapshot folder in Emulator Default '+
                                              'Settings screen.', 2, False, 1);
                              ResetSettings;
                              Exit;
                            end
                         else
                            begin
                              if not ForceDirectories(NewOption+'multimedia_files\'+SoftwareNameFolder) then
                                 begin
                                   CallMessageBox;
                                   ShowGameNameEntryMsgBox;
                                   AddMsgText('    Folder ');
                                   AddMsgText(NewOption+'multimedia_files\'+SoftwareNameFolder, $00a65300, [fsBold]);
                                   AddMsgText('was not found and could not be created. Try again or create the folder manually. '+
                                              'This folder is exclusive to Emu Loader, not part of '+GetSystemShortTitle(MemGameInfo.eSystemID)+
                                              '.'+#13#10+'Aborting...');
                                   GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Multimedia folder doesn''t exist.', '', 2, False, 1);
                                   ResetSettings;
                                   Exit;
                                 end;
                              //'multimedia_files\'
                            end;
                       end;
                     27:
                       begin
                         // use an effect overlay
                         // nothing for now...
                       end;
                   end;
                   case SelectFileName(MAME_ExtraSetting, NewOption) of
                     True:
                       begin
                         case MAME_ExtraSetting of
                           20:
                             begin
                               if GetMAMEBuild < 59 then
                                  NewOption:= ChangeFileExt(NewOption, ''); // previous to v0.59 MAME adds a .inp extension automatically!!!
                               CommandLine:= CommandLine+' -playback '+NewOption;
                             end;
                           21:
                             begin
                               if GetMAMEBuild < 59 then
                                  NewOption:= ChangeFileExt(NewOption, ''); // previous to v0.59 MAME adds a .inp extension automatically!!!
                               CommandLine:= CommandLine+' -record '+NewOption;
                             end;
                           22: CommandLine:= CommandLine+' -noautosave -state '+NewOption;
                           23: CommandLine:= CommandLine+' -wavwrite "'+NewOption+'"';
                           24: CommandLine:= CommandLine+' -mngwrite "'+NewOption+'"';
                           25: CommandLine:= CommandLine+' -aviwrite "'+NewOption+'"';
                           27: CommandLine:= CommandLine+' -effect '+NewOption;
                         end;
                       end;
                     False:
                       begin
                         ResetSettings;
                         Exit;
                       end;
                   end;
                 end;
            end;
          False:
            begin
              case MemGameInfo.eSystemID of
                idSupermodel:
                  begin
                    // Supermodel, need to add options before game, and it's .zip file with full path!
                    // need to create a function to merge these two here....!!!!!! Jan 26, 2014 --- huh ? ---
                    NewOption:= ReadSupermodelIni(MemGameInfo.eName+'.ini');
                    if NewOption = 'invalid_resolution' then
                       Exit
                    else
                    if NewOption = '' then
                       begin
                         NewOption:= ReadSupermodelIni(GetEmuIniFileName(MemGameInfo.eSystemID));
                         if NewOption = 'invalid_resolution' then
                            Exit;
                       end
                    else
                       SetCmdLineTitle(True);
                    NewOption:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID);
                    if NewOption = '' then
                       NewOption:= 'file not found';
                    CommandLine:= CommandLine+' "'+NewOption+'"';
                    //CommandLine:=Format('%s "%s"', [CommandLine, NewOption]);
                  end;
                idDaphne:
                  begin
                    CommandLine:= CommandLine+ReadDaphneIni;
                  end;
                idDemul: // Demul, need special parameters before the game name
                  begin
                    if MemGameInfo.eDriverName <> '' then
                       CommandLine:= CommandLine+'-run='+GetDemulMachineName(MemGameInfo.eDriverName, IsDemulOldVersion)+
                                     ' -rom='+MemGameInfo.eName
                    else
                       IsDemulEmptySystem:= True;
                    // do nothing else as Demul doesn't support custom game settings...


                    //if MemGameInfo.eDriverName <> '' then
                    //   CommandLine:= CommandLine+'-run='+GetDemulMachineName(MemGameInfo.eDriverName)+
                    //              ' -rom='+MemGameInfo.eName
                    //else
                    //   IsDemulEmptySystem:= True;
                    // do nothing else as Demul doesn't support custom game settings...
                  end;
                idZiNc:
                  begin
                    // ZiNc, needs special parameters before the game name
                    if MemGameInfo.eScreenType <> -1 then
                       CommandLine:= CommandLine+IntToStr(MemGameInfo.eScreenType) // ZiNc has game index in ScreenType
                    else
                       begin
                         CallMessageBox;
                         ShowGameNameEntryMsgBox;
                         case IsROM_Bios(MemGameInfo.eROMIdentification) of
                           True : GenerateMessage(msgBoxTitle, MemGameInfo.eTitle,
                                         'This is a bios set and ZiNc does not run bios sets, only games. Aborting...', 2);
                           False: GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle,
                                         'Invalid ZiNc game index (-1). Please create games list again. Aborting...', 2, False, 1);
                         end;
                         ResetSettings;
                         Exit;
                       end;
                    // first driver, second game, then default emulator options
                    SetCmdLineTitle(True);
                    NewOption:= ' --use-config-file='+LongToShortPath(GetFolderEmulatorIni(MemGameInfo.eSystemID));
                    NewOption2:= ChangeFileExt(MemGameInfo.eDriverName, '.cfg');
                    case FileExists(GetFolderEmulatorIni(MemGameInfo.eSystemID)+NewOption2) of
                      True : CommandLine:= CommandLine+NewOption+NewOption2;
                      False:
                        begin
                          NewOption2:= MemGameInfo.eName+'.cfg';
                          case FileExists(GetFolderEmulatorIni(MemGameInfo.eSystemID)+NewOption2) of
                            True: CommandLine:= CommandLine+NewOption+NewOption2;
                            False:
                              begin
                                // use default emulator settings
                                CommandLine:= CommandLine+NewOption+GetEmuIniFileName(MemGameInfo.eSystemID);
                                SetCmdLineTitle;
                              end;
                          end;

                        end;
                    end;
                    // get game.zip or parent.zip folder
                    NewOption:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID);
                    if NewOption <> '' then
                       NewOption:= ExcludeTrailingPathDelimiter(LongToShortPath(ExtractFilePath(NewOption)))
                    else
                    if GameIsClone(MemGameInfo.eClone) then
                       begin
                         NewOption:= SearchZIPFolder(MemGameInfo.eClone, MemGameInfo.eSystemID);
                         if NewOption <> '' then
                            NewOption:= ExcludeTrailingPathDelimiter(LongToShortPath(ExtractFilePath(NewOption)));
                       end;
                    if NewOption <> '' then
                       CommandLine:= CommandLine+' --roms-directory='+NewOption;
                  end;
              end;
            end;
        end;
      end;
  end;

  // need to check the correct MAME binary and also check all other emulators!!!
  if CommandLine <> '' then
    begin
      if (MemGameInfo.eSystemID = idDemul) and (CommandLine = '!error') then
         CommandLine:= '';
      if (MemGameInfo.eSoftwareName <> '') and (MenuImageUseCustomSoftListSnapName.Checked) then
         CommandLine:= CommandLine+' -snapname '+MemGameInfo.eSoftwareName+'/'+MemGameInfo.eName;//+'/%i';

      if MenuViewEmulatorFullCommandLine.Checked or IsDemulEmptySystem then
         begin
           CallMessageBox;
           ShowGameNameEntryMsgBox(IsMultiSlot, MultiSlotMachineName);

           FormMessageBox.ButtonYes.Caption:= 'Execute';
           FormMessageBox.ButtonNo.Caption:= 'Abort';

           //AddMsgText('Games List Version Info'+#13#10, $000053a6, [], taCenter, 9);
           //AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, clGray, [fsItalic, fsBold], taCenter);
           AddMsgText('Games list  ', $000053a6, [fsItalic, fsBold], taCenter);//, 9, 'Trebuchet MS');
           AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, clGray, [fsItalic, fsBold], taCenter);

           //AddMsgText(#13#10);
           case IsAlterMAME of
             True:
               begin
