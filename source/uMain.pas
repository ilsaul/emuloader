function TFormMain.CheckAllMAMEIniFiles: Boolean;
var
  Loop: ShortInt;
  ShowMsg: Boolean;
begin
  // this function seems to be called only at startup... nowhere else!
  Result:= True;
  ShowMsg:= False;
  for Loop:=1 to MaxArcadeSystems do
  begin
    if IsMAMEBasedSys(Loop) then
    begin
      if ValidateArcadeEmulatorFile(Loop) then
      begin
        if not CheckMAMEIniFile(EmulatorFile[Loop], Loop) then
           begin
             if not ShowMsg then
             begin
               CallMessageBox;
               ShowMsg:= True;
             end
             else
               AddMsgText(#13#10+#13#10);

             AddMsgText('    '+GetArcadeEmulatorDescription(Loop, True)+#13#10, clBlack, [fsBold]);
             AddMsgText('File: ');
             AddMsgText(EmulatorFile[Loop]+#13#10, MsgTxtColors.colorWarning);
             AddMsgText('Initialization file is missing and failed to be created.', clBlack, [fsItalic]);

             Result:= False;
           end;
      end;
    end;
  end;

  if ShowMsg then
     GenerateMessage('Error: Startup', 'File access error.', '', 2, False, 1);
end;

function TFormMain.CheckMAMEIniFile(const EmulatorFileName: String; SystemID: Integer): Boolean;
var
  MissingIni: Boolean;
begin
  Result:= ValidateArcadeEmulatorFile(SystemID);
  if not Result then
     Exit;

  MissingIni:= False;

  if not FileExists(GetArcadeEmuIniFileName(SystemID, EmulatorFileName)) then
     MissingIni:= True;

  if not MissingIni then
     begin
       // file "ui.ini" appeared in v0.172 and newer
       if GetMAMENewFileVersion(EmulatorFileName) >= 172 then
       begin
         if not FileExists(ExtractFilePath(EmulatorFileName)+'ui.ini') then
            MissingIni:= True;
       end;
     end;
  if MissingIni then
     CreateMAMEIniFile(EmulatorFileName);
end;

function TFormMain.GetArcadeEmuIniFileName(sysID: ShortInt; const EmulatorFileName: String = ''): String;
var
  tmpSys, EmuPath, EmuIniPath: String;
  Continue: Boolean;
begin
  Result:= '';
  case isMAMEBasedSys(sysID) of
    True:
      begin
        if EmulatorFileName <> '' then
           begin
             EmuIniPath:= 'ini\';
             EmuPath:= ExtractFilePath(EmulatorFileName);
             if sysID <> idHBMAME then
                tmpSys:= 'mame.ini'
             else
                tmpSys:= 'hbmame.ini';
             Continue:= not FileExists(EmuPath+tmpSys);
             if Continue then
                begin
                  tmpSys:= EmuIniPath+tmpSys;
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= 'ume.ini';
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= EmuIniPath+tmpSys;
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= ChangeFileExt(ExtractFileName(EmulatorFileName), '.ini');
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= EmuIniPath+tmpSys;
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                tmpSys:= 'mame.ini';
             Result:= EmuPath+tmpSys;
           end;
      end;
    False:
      begin
        case sysID of
          idSupermodel: // Supermodel: SEGA Model 3
            begin
              if EmulatorFileName <> '' then
                 Result:= ExtractFileName(ChangeFileExt(EmulatorFileName, '.ini'))
              else
              if EmulatorFile[sysID] <> '' then
                 Result:= ExtractFileName(ChangeFileExt(EmulatorFile[sysID], '.ini'));
              // NOTE: the .ini files will be in "el\arcade\supermodel_cfg\" sub-folder!!!!!!
            end;
          idDaphne: Result:= GetFolderArcadeEmulatorIni(idDaphne, True)+'daphne_el.ini';
          idDemul: // Demul
            begin
              if EmulatorFileName <> '' then
                 Result:= ExtractFileName(ChangeFileExt(EmulatorFileName, '.ini'))
              else
              if EmulatorFile[sysID] <> '' then
                 Result:= ChangeFileExt(EmulatorFile[sysID], '.ini');
            end;
          idSegaModel2: // SEGA Model 2 (Elsemi emulator)
            begin
              if EmulatorFileName <> '' then
                 Result:= ExtractFilePath(EmulatorFileName)+'emulator.ini'
              else
              if EmulatorFile[sysID] <> '' then
                 Result:= ExtractFilePath(EmulatorFile[sysID])+'emulator.ini';
            end;
          idZiNc: Result:= 'zinc_el.cfg';
        end;
      end;
  end;
end;

function TFormMain.GetMAMENewFileVersion(const EmulatorFileName: String): Integer;
var
  fVersion: String;
  iPos: Integer;
begin
  // this is used to get the version info from file/properties/"details" tab
  Result:= -1;
  if not FileExists(EmulatorFileName) then
     Exit;

  if IsExeBatchFile(EmulatorFileName) then
     Exit;

  fVersion:= GetFileVersion(EmulatorFileName, True);
  if fVersion <> '' then
     begin
       iPos:= PosEx('.', fVersion);
       if iPos <> 0 then
          Delete(fVersion, 1, iPos);
       Result:= StrToInt(fVersion);
     end;
end;

function TFormMain.GetMAMEBinaryVersion(const EmulatorFileName: String; IsFile: Boolean = True; viFile: String = ''): String;
var
  fVersion, iHelp, tempFile, CommandLine: String;
  iFile: TStringList;
  iPos, iPos2: Integer;
begin
  Result:= '';
  if not FileExists(EmulatorFileName) then
     Exit;

  if IsExeBatchFile(EmulatorFileName) then
     Exit;
  fVersion:= GetFileVersion(EmulatorFileName, True);

  if fVersion <> '' then
     begin
       Result:= fVersion;
       Exit;
     end;
     
  if not VerifyTempDirectory then
     Exit;

  if viFile = '' then
     begin
       if FormStatus.Visible then
          FormStatus.MessageStr('Parsing MAME build number.');
       tempFile:= FrontendPath+'temp\iMAMEVersion.tmp';
       CommandLine:= SystemStr+EmulatorFileName+SystemStr+' -help > '+SystemStr+tempFile+SystemStr;
       SetCurrentDir(EmulatorFileName);
       RunProcess(CommandPromptStr+SystemStr+CommandLine+SystemStr, True, GetWindowStateEmulator);
       //RunProcess(CommandPromptStr+SystemStr+CommandLine+SystemStr, True, 1{GetWindowStateEmulator});//, False);//SW_SHOWMINIMIZED, False); // WinXP / Sev7n / 8ight
       SetCurrentDir(FrontendPath);
     end
  else
     tempFile:= viFile; // file already created in .GetEmulatorVersion() function or is from -listxml output: <mame build="0000"

  if IsFile then
     begin
       if not ValidateFile(tempFile) then
          Exit;
       iFile:= TStringList.Create;
       iFile.LoadFromFile(tempFile);
       iHelp:= iFile[0];
     end
  else
     begin
       iHelp:= viFile; // from -listxml output... <mame build="000000"
     end;
  iPos:= PosEx(' v', iHelp);
  iPos2:= PosEx('.', iHelp, iPos+1);
  Result:= Trim(Copy(iHelp, iPos+2, (iPos2-iPos)+2));

  if IsFile then
     begin
       FreeAndNil(iFile);
       DeleteFile(tempFile);
     end;
  Application.ProcessMessages;
end;

function TFormMain.IsROMsFolderCustom(sysID: Integer): Boolean;
begin
  // ROMs folder is saved in "arcade\emulators.ini"
  Result:= sysID in [idSupermodel, idZiNc]; // Supermodel: SEGA Model 3; ZiNc
end;

function TFormMain.GetFolderArcadeEmulatorIni(sysID: ShortInt; BasePathOnly: Boolean = False): String;
var
  BasePath: String;
begin
  // function used for emulators that do not have support for a game custom config file
  BasePath:= GetArcadeFolder+'emulator_ini\';
  if BasePathOnly then
     begin
       Result:= BasePath;
       Exit;
     end;
  case sysID of
    idSupermodel: Result:= BasePath+'supermodel_ini\';
    //idDemul: Result:= BasePath+'demul_ini\'; // Demul... maybe for the future ???
    //idSegaModel2: Result:= BasePath+'segamodel2_ini\'; // not sure if this emulator requires game custom config
    idZiNc: Result:= BasePath+'zinc_cfg\';
  end;
end;

function TFormMain.AddMenuItem(MenuHolder: TMenuItem; Description, HintName: String; Duplicate: Boolean;
                               IsAutoCheck: Boolean = True; IsRadioItem: Boolean = True; ImageIndex: Integer = -1): TMenuItem;
var
  NewMenuItem: TMenuItem;
  Loop: Integer;
begin
  Result:= nil;
  if not Duplicate then
     begin
       if MenuHolder.Count > 0 then
          begin
            for Loop:=0 to MenuHolder.Count-1 do
            begin
              if SameText(MenuHolder.Items[Loop].Caption, Description) then
                 Exit;
            end;
          end;
     end;

  NewMenuItem:= TMenuItem.Create(MenuHolder);
  NewMenuItem.Caption:= Description;
  if IsAutoCheck then
     NewMenuItem.AutoCheck:= True;
  if IsRadioItem then
     NewMenuItem.RadioItem:= True;
     
  NewMenuItem.Hint:= HintName;
  if ImageIndex <> -1 then
     NewMenuItem.ImageIndex:= ImageIndex;
  MenuHolder.Add(NewMenuItem);
  if SameText(HintName, 'disabled') then
     NewMenuItem.Checked:= True;
  Result:= NewMenuItem;
end;

procedure TFormMain.CreateMAMEIniFile(const EmulatorFileName: String);
begin
  SetCurrentDir(ExtractFilePath(EmulatorFileName));
  RunProcess(SystemStr+EmulatorFileName+SystemStr+' -createconfig', True, GetWindowStateEmulator);
  SetCurrentDir(FrontendPath);
end;

procedure TFormMain.CreateSupermodelGamesDatFile;
var
  FileToRead: String;
  MainLoop, Index, LineIndex, TotalLines: Integer;
  StrLine, tmpStr: String;
  sFile, NewXMLFile: THashedStringList;
  IsNewGame: Boolean;
  iPos, iPos2: Integer;

  smTitle,
  smAltTitle,
  smName,
  smCloneOf,
  smYear,
  smManufacturer,
  smHardwareStepping,
  smControls: String;

  smROM_Name,
  smROM_Size,
  smROM_CRC32: String;
  //smROM_Size: Integer;

  function RemoveQuotes(const DataString: String; RemoveCommaAtTheEnd: Boolean = True): String;
  begin
    Result:= DataString;
    if DataString = '' then
       Exit;

    Delete(Result, 1, 1);
    case RemoveCommaAtTheEnd of
      True : Delete(Result, Length(Result)-1, 2);
      False: Delete(Result, Length(Result), 1);
    end;
  end;

begin
  // this function is no longer necessary as newer emulator builds have the Config\Games.xml file with a full games list (February 26, 2018)
  FileToRead:= DialogOpenFile(20, 'Select a "Games.cpp" file to parse Supermodel games list and generate the XML dat file',
                             nil, False);
  if FileToRead = '' then
     Exit;

  sFile:= THashedStringList.Create;
  sFile.LoadFromFile(FileToRead);

  for MainLoop:=0 to sFile.Count-1 do
  begin
    StrLine:= TrimLeft(sFile[MainLoop]);
    if StrLine <> '' then
    begin
      Index:= PosEx('const struct GameInfo g_Model3GameList[]', StrLine);
      if Index <> 0 then
         begin
           Index:= MainLoop+2;
           Break;
         end;
    end;
  end;
  if Index = 0 then
     begin
       GenerateMessage('Error', 'Game structure not found.', '    Could not locate the game structure to begin games parsing. Aborting...');
       FreeAndNil(sFile);
       Exit;
     end;

  iPos:=  DateTimeToFileDate(Now());
  DateTimeToString(tmpStr, 'mmmm dd, yyyy', FileDateToDateTime(iPos));
  NewXMLFile:= THashedStringList.Create;
  NewXMLFile.BeginUpdate;
  NewXMLFile.Add('<?xml version="1.0"?>');
  NewXMLFile.Add('<!DOCTYPE datafile PUBLIC "-//Logiqx//DTD ROM Management Datafile//EN" "http://www.logiqx.com/Dats/datafile.dtd">');
  NewXMLFile.Add('<datafile>');
  NewXMLFile.Add('    <header>');
  NewXMLFile.Add('        <name>Supermodel</name>');
  NewXMLFile.Add('        <description>Supermodel 0.3a</description>');
  NewXMLFile.Add('        <category>A Sega Model 3 arcade emulator</category>');
  NewXMLFile.Add('        <version>0.3a</version>');
  NewXMLFile.Add('        <date>'+tmpStr+'</date>'); //'April 05, 2016</date>');
  NewXMLFile.Add('        <author>Ciro Alfredo Consentino</author>');
  NewXMLFile.Add('        <comment>Apr 05, 2016 - file created based on Games.cpp revision 335</comment>');
  NewXMLFile.Add('        <comment>Apr 16, 2016 - file created based on Games.cpp revision 351</comment>');
  NewXMLFile.Add('    </header>');

  TotalLines:= sFile.Count;
  LineIndex:= Index;
  //ShowMessage(sFile[Index-1]+#13#10+sFile[Index]);

  // struct GameInfo (from Src\Games.cpp)

  // Game information "Game Title"
  //const char  id[10];         // 9-character game identifier (also serves as zip archive file name)
  //const char  *parent;        // parent game identifier
  //const char  *title;         // complete game title
  //const char  *mfgName;       // name of manufacturer
  //unsigned    year;           // year released (in decimal)
  //int         step;           // Model 3 hardware stepping: 0x10 = 1.0, 0x15 = 1.5, 0x20 = 2.0, 0x21 = 2.1
  //unsigned    cromSize;       // size of fixed CROM (up to 8 MB)
  //bool        mirrorLow64MB;  // mirror low 64 MB of banked CROM space to upper 64 MB
  //unsigned    vromSize;       // size of video ROMs (32 or 64 MB; if 32 MB, will have to be mirrored)
  //unsigned    sampleSize;     // size of sample ROMS (8 or 16 MB; if 8 MB, will have to be mirrored)
  //unsigned    inputFlags;     // game input types
  //int         mpegBoard;      // MPEG music board type: 0 = none, 1 = DSB1 (Z80), 2 = DSB2 (68K).
  //bool        driveBoard;     // drive board (supported if true)
  //uint32_t    encryptionKey;  // security board encryption device key (or 0 if not applicable)

  // ROM files
  //struct ROMInfo ROM[48];

  IsNewGame:= False;
  repeat
    StrLine:= TrimLeft(sFile[LineIndex]);
    if StrLine <> '' then
    begin
      if (StrLine[1] = '/') and (not IsNewGame) then
         begin
           if PosEx('// Terminate list', StrLine) = 0 then
           begin
             // star getting data
             IsNewGame:= True;
             smAltTitle:= StrLine;
             Delete(smAltTitle, 1, 2);
             smAltTitle:= Trim(smAltTitle);
             smName:= TrimLeft(sFile[LineIndex+2]);
             smCloneOf:= TrimLeft(sFile[LineIndex+3]);
             smTitle:= TrimLeft(sFile[LineIndex+4]);
             smManufacturer:= TrimLeft(sFile[LineIndex+5]);
             smYear:= TrimLeft(sFile[LineIndex+6]);
             smHardwareStepping:= TrimLeft(sFile[LineIndex+7]);
             smControls:= TrimLeft(sFile[LineIndex+12]);
             smControls:= StringReplace(smControls, '|', ',', [rfReplaceAll]);

             Delete(smName, Length(smName), 1); // only remove comma at the end since quotes are added to the XML file
             //smName:= RemoveQuotes(smName);
             if SameText('NULL,', smCloneOf) then
                smCloneOf:= ''
             else
                Delete(smCloneOf, Length(smCloneOf), 1); // only remove comma at the end since quotes are added to the XML file
                //smCloneOf:= RemoveQuotes(smCloneOf);

             smTitle:= RemoveQuotes(smTitle);
             smManufacturer:= RemoveQuotes(smManufacturer);
             Delete(smYear, Length(smYear), 1);
             Delete(smHardwareStepping, Length(smHardwareStepping), 1);
             Delete(smControls, Length(smControls), 1);

             if smHardwareStepping = '0x10' then
                smHardwareStepping:= '1.0'
             else
             if smHardwareStepping = '0x15' then
                smHardwareStepping:= '1.5'
             else
             if smHardwareStepping = '0x20' then
                smHardwareStepping:= '2.0'
             else
             if smHardwareStepping = '0x21' then
                smHardwareStepping:= '2.1';

             if SameText(smAltTitle, smTitle) then
                smAltTitle:= '';

             if smCloneOf = '' then
                NewXMLFile.Add('    <game name='+smName+'>')
             else
                NewXMLFile.Add('    <game name='+smName+' cloneof='+smCloneOf+' romof='+smCloneOf+'>');

             NewXMLFile.Add('        <description>'+smTitle+'</description>');
             if smAltTitle <> '' then
                NewXMLFile.Add('        <alt_title>'+smAltTitle+'</alt_title>');
             NewXMLFile.Add('        <year>'+smYear+'</year>');
             NewXMLFile.Add('        <manufacturer>'+smManufacturer+'</manufacturer>');
             if smHardwareStepping <> '' then
                NewXMLFile.Add('        <hardware_stepping>'+smHardwareStepping+'</hardware_stepping>');
             if smControls <> '' then
                NewXMLFile.Add('        <controls>'+smControls+'</controls>');

             LineIndex:= LineIndex+18;
             repeat
               StrLine:= TrimLeft(sFile[LineIndex]);
               if StrLine <> '' then
               begin
                 if StrLine[1] = '{' then
                    begin
                      // { "CROM", false,  "epr-20646.20", 0xD740AE06, 0x80000,  2,  0x0600000,  8,  true },
                      // get ROM info and add to XML file
                      if PosEx('NULL', StrLine) = 0 then
                      begin
                        iPos:= PosEx(',', StrLine);
                        iPos:= PosEx(',', StrLine, iPos+1);
                        iPos2:= PosEx(',', StrLine, iPos+1);
                        smROM_Name:= Trim(Copy(StrLine, iPos+1, (iPos2-iPos)-1));
                        smROM_Name:= RemoveQuotes(smROM_Name, False);

                        iPos:= PosEx(',', StrLine, iPos2+1);
                        smROM_CRC32:= LowerCase(Trim(Copy(StrLine, iPos2+1, (iPos-iPos2)-1)));
                        Delete(smROM_CRC32, 1, 2);

                        iPos2:= PosEx(',', StrLine, iPos+1);
                        smROM_Size:= Trim(Copy(StrLine, iPos+1, (iPos2-iPos)-1));
                        Delete(smROM_Size, 1, 2);
                        smROM_Size:= '$'+smROM_Size;
                        smROM_Size:= IntToStr(StrToInt(smROM_Size));
                        //'$' replace 0x by $
                        //NewXMLFile.Add('        <rom name="epr-20313.21" size="524288" crc="863a7857" sha1="72384dc6d7613806ab6bb84d935a3b0497e9e9d2"/>
                        NewXMLFile.Add('        <rom name="'+smROM_Name+'" size="'+smROM_Size+'" crc="'+smROM_CRC32+'"/>');
                      end;
                      //smROM_Name
                      //smROM_Size
                      //smROM_CRC32
                    end;
                 //Inc(LineIndex);
               end
             else
               StrLine:= '.';
             Inc(LineIndex);

             until StrLine[1] = '}';
             NewXMLFile.Add('    </game>');
             IsNewGame:= False;
             //ShowMessage(NewXMLFile.Text);
             //LineIndex+18 -> start ROMs list until } char is reached, then finishes game entries parsing
           end;
         end;
    end;
    Inc(LineIndex);
  until (LineIndex = TotalLines);// or StopParse;
  NewXMLFile.Add('</datafile>');
  NewXMLFile.EndUpdate;
  NewXMLFile.SaveToFile(GetFolderFull(42)+'SupermodelSEGAModel3_xml_NewFileFromSource.dat');
  FreeAndNil(NewXMLFile);
  FreeAndNil(sFile);
  ShowMessage('Parse completed!');
end;

function TFormMain.ParseSupermodelGamesXMLFile: Boolean;
var
  ListXML, ROMsList, tmpParentROMs, tmpCloneROMs: THashedStringList;
  FileLine, ROMsDetailsLine, TempString, ROMDataLine: String;
  MainLoop: Integer;
  IsGameEntry: Boolean;
  tmpEmuVersion, iVersion: String;
  tempFile, RegionTagStr, romName, romSize, romCRC32, romOffset: String;
  ParentROMsList: TMemIniFile;
  GameStatusList: TStringList;

  TitleErrorMsg, EmuTitle: String;
  ROMsHeaderAdded: Boolean;

  // new format (September 07, 2016)
  // file_ID MediaType IsCRC32Collision <name> rom_name /> <crc> crc32 /> <sha1> sha-1 or md5 />
  // 0201<name>203_203.bin/><crc>a738ea1c/><sha1>6f55f1ae0606816a4eca6645ed36eb7f9c7ad9cf/>
  // 0201<name>fpr23718.ic36/><crc>a738ea1c/><sha1>b7b5a55a6a4cf0aa2df1b3dff62ff67f864c55e8/>
  //
  // fileID always at index 1 and 2; MediaType at index 3; IsCRCCollision at position 4
  // if there is no CRC / SHA-1 / MD5... these tags will not appear in the ROM info

  // 00   Game ROM
  // 01   Device ROM
  // 02   BIOS ROM

  function SetIntegerValue(const strValue: String): Integer;
  begin
    Result:= -1;
    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, strValue);
    if TempString <> '' then
       Result:= StrToInt(TempString);
  end;

  function GetControlTags(const LineStr: String): Boolean;
  var
    ctrlString: String;
  begin
    {
    INPUT_UI              = 0,          // special code reserved for Supermodel UI inputs
    INPUT_COMMON          = 0x00000001, // common controls (coins, service, test)
    INPUT_VEHICLE         = 0x00000002, // vehicle controls
    INPUT_JOYSTICK1       = 0x00000004, // joystick 1
    INPUT_JOYSTICK2       = 0x00000008, // joystick 2
    INPUT_FIGHTING        = 0x00000010, // fighting game controls
    INPUT_VR4             = 0x00000020, // four VR view buttons
    INPUT_VIEWCHANGE      = 0x00000040, // single view change button
    INPUT_SHIFT4          = 0x00000080, // 4-speed shifter
    INPUT_SHIFTUPDOWN     = 0x00000100, // up/down shifter
    INPUT_HANDBRAKE       = 0x00000200, // handbrake
    INPUT_HARLEY          = 0x00000400, // Harley Davidson controls
    INPUT_GUN1            = 0x00000800, // light gun 1
    INPUT_GUN2            = 0x00001000, // light gun 2
    INPUT_ANALOG_JOYSTICK = 0x00002000, // analog joystick
    INPUT_TWIN_JOYSTICKS  = 0x00004000, // twin joysticks
    INPUT_SOCCER          = 0x00008000, // soccer controls
    INPUT_SPIKEOUT        = 0x00010000, // Spikeout buttons
    INPUT_ANALOG_GUN1     = 0x00020000, // analog gun 1
    INPUT_ANALOG_GUN2     = 0x00040000, // analog gun 2
    INPUT_SKI             = 0x00080000, // ski controls
    INPUT_MAGTRUCK        = 0x00100000, // magical truck controls
    INPUT_FISHING         = 0x00200000, // fishing controls
    INPUT_ALL             = 0x003FFFFF
    }

    // February 26, 2018 - better control list and description can be read from "source\Inputs\Input.cpp"
    //                   - new file "arcade\filters\supermodelsegamodel3_control_type.ini" with all controls names=descriptions
    ctrlString:= XML_GetEntryValue(LineStr, 'type');
    Result:= ctrlString <> '';
    if not Result then
       Exit;
    if TempGameVars.eControls <> '' then
       TempGameVars.eControls:= TempGameVars.eControls+','+ctrlString
    else
       TempGameVars.eControls:= ctrlString;
  end;

  function ParseROMDiskEntry(FileID: ShortInt; IsClone: Boolean): Boolean; // FileID (type of ROM being scanned) -> 1: Device; 2: BIOS; 0: Game
  var
    FixedID, newFileID, IsBadDump: ShortInt; //IndexCHD
    ROMInfoFull: String;
  begin
    ROMInfoFull:= '';
    newFileID:= FileID;
    romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM
    romName:= DecodeHTML(romName);

    romCRC32:= LowerCase(XML_GetEntryValue(FileLine, 'crc32'));
    Delete(romCRC32, 1, 2); // to remove the 0x from the CRC32 string...
    //romSHA1:= XML_GetEntryValue(FileLine, 'sha1');
    romOffset:= XML_GetEntryValue(FileLine, 'offset');

    romSize:= XML_GetEntryValue(FileLine, 'size'); // this tag is not present in the new "Config\Games.xml" file...
    if romSize <> '' then
       TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(romSize);
    TempString:= '';

    IsBadDump:= Ord(PosEx('BAD_DUMP', UpperCase(FileLine)) <> 0);
    ROMInfoFull:= MountROMInfo(newFileID, 0, False, romName, romCRC32, romSize, '', IsBadDump, False, RegionTagStr, romOffset);

    if FileID = 0 then
       FixedID:= newFileID;

    if not ROMsHeaderAdded then
       begin
         if ROMsList.Count > 0 then
            ROMsList.Add('');
         ROMsList.Add('['+TempGameVars.eName+']');
         ROMsHeaderAdded:= True;
       end;

    //ROMInfoFull --> 020000<name>sp-u2.sp1/><crc>e72943de/><sha1>5c6bba07d2ec8ac95776aa3511109f5e1e2e92eb/>
    case IsClone of
      True : tmpCloneROMs.Add(ROMInfoFull);
      False: ROMsList.Add(ROMInfoFull);
    end;
       // [konam80a]
       // 1510<name>826aaa01.chd/><sha1>be5f8b31fd18ba631fe98c2132c56abf20193419/><parentname>826eaa01.chd/>
                                                                    // TempString here is the SHA-1 / MD5 checksum
  end;

  function ReplaceCloneROMs: Boolean;
  var
    LoopROMParent, LoopROMClone: Integer;
    SearchStrParent, SearchStrClone, TagValidateStr: String;
    rPos: Integer;
  begin
    tmpParentROMs.BeginUpdate;
    for LoopROMParent:= 0 to tmpParentROMs.Count-1 do
    begin
      SearchStrParent:= tmpParentROMs[LoopROMParent];
      SearchStrParent[6]:= '1'; // this ROM is from the parent set and it must be tagged as such
      tmpParentROMs[LoopROMParent]:= SearchStrParent;

      rPos:= PosEx('<region>', SearchStrParent);
      TagValidateStr:= Copy(SearchStrParent, rPos, Length(SearchStrParent));
      for LoopROMClone:=0 to tmpCloneROMs.Count-1 do
      begin
        SearchStrClone:= tmpCloneROMs[LoopROMClone];
        if PosEx(TagValidateStr, SearchStrClone) <> 0 then
           begin
             tmpParentROMs[LoopROMParent]:= SearchStrClone;
             Break;
           end;
      end;
    end;
    tmpParentROMs.EndUpdate;
    ROMsList.AddStrings(tmpParentROMs);
  end;

  function RemoveQuotes(const DataString: String; RemoveCommaAtTheEnd: Boolean = True): String;
  begin
    Result:= DataString;
    if DataString = '' then
       Exit;

    Delete(Result, 1, 1);
    case RemoveCommaAtTheEnd of
      True : Delete(Result, Length(Result)-1, 2);
      False: Delete(Result, Length(Result), 1);
    end;
  end;

  function IsParentGame(const iStr: String): Boolean;
  begin
    Result:= PosEx('parent="', iStr) = 0;
  end;

  function ReplaceChar(const iText: String; CharToReplace, NewChar: Char): String;
  var
    iPos: Integer;
  begin
    Result:= iText;
    iPos:= PosEx(CharToReplace, iText);
    while iPos > 0 do
    begin
      Result[iPos]:= NewChar;
      iPos:= PosEx(CharToReplace, iText);
    end;
  end;

  function AddExtraGameInfo: Boolean;
  begin
    Result:= True;
    if TempGameVars.eScreenOrientation = -1 then
       TempGameVars.eScreenOrientation:= 0; // horizontal games
    if TempGameVars.eScreenResolution = '' then
       TempGameVars.eScreenResolution:= '496x384';
    if TempGameVars.eScreenRefreshRate = '' then
       TempGameVars.eScreenRefreshRate:= '60.000000';
    if TempGameVars.eDriverName = '' then
       TempGameVars.eDriverName:= 'model3.cpp';
    TempGameVars.eDriverStatus:= 0;
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ROMsList);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    FreeAndNil(ParentROMsList);
    FreeAndNil(tmpParentROMs);
    FreeAndNil(tmpCloneROMs);
    Result:= False;
  end;

begin
  EmuTitle:= GetArcadeEmulatorDescription(idSupermodel, True);
  TitleErrorMsg:= 'Error: Create Games List ['+EmuTitle+']';

  FormStatus.SetProgressPos(0);
  tempFile:= ExtractFilePath(EmulatorFile[idSupermodel]);
  tempFile:= tempFile+'Config\Games.xml';

  Result:= FileExists(tempFile);
  if not Result then
     Exit;

  FormStatus.TitleStr('Create Games List: '+GetArcadeEmulatorDescription(idSupermodel));
  FormStatus.MessageStr('', False);
  if not FormStatus.Visible then
     FormStatus.Show;
  FormStatus.StartThreadClock;
  SetCurrentDir(FrontendPath);
  FileLine:= '';

  if FormMain.Visible then
     FormMain.Refresh;

  CheckAndCreateFolder(GetGamesFolderEL);

  tmpEmuVersion:= '';
  iVersion:= '';
  GetArcadeEmulatorVersion(idSupermodel, EmulatorFile[idSupermodel], tmpEmuVersion, iVersion);

  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(tempFile);

  // this one reads the new Games.xml file to create the games list (started from svn 597 or something... May 2017)
  //std::string name;
  //std::string parent;
  //std::string title;
  //std::string version;
  //std::string manufacturer;
  //unsigned year = 0;
  //std::string stepping;
  //std::string mpeg_board;
  //uint32_t encryption_key = 0;

  // game "eca" has a patch region file... but no filename. support this ???

  if ListXML.Count > 0 then
  begin
    DeleteFile(GetGamesFolderEL+GetSystemFileName(idSupermodel));
    for MainLoop:=1 to 3 do
        DeleteFile(GetGamesFolderEL+GetSystemFileName(idSupermodel, MainLoop));

    FormStatus.MessageStr('Parsing "'+tempFile+'" (1st pass).'+#13#10+
                            'Creating parent sets list.');

    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(idSupermodel));
    ROMsList:= THashedStringList.Create;
    ROMsList.BeginUpdate;

    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;

    // parse parent games info and their ROMs info...
    IsGameEntry:= False;
    ListGames.WriteString('info_file', 'description', '');
    ListGames.WriteString('info_file', 'version', '');

    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<game ') then
         begin
           if IsParentGame(FileLine) then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= idSupermodel;
                ROMsDetailsLine:= '';
                TempString:= '';
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                TempGameVars.eGameSetStatus:= 2; // missing
                ROMsHeaderAdded:= False;
                RegionTagStr:= ''; // required so ROMs of clone sets can be replaced in the parent set

                IsGameEntry:= True;
              end
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, '<title>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 8, PosEx('</title>', FileLine)-8));
                TempGameVars.eTitle:= FixDescriptionFormat(idSupermodel, TempGameVars.eTitle, False);
              end
           else
           if XML_CheckData(FileLine, '<version>') then
              begin
                TempString:= DecodeHTML(Copy(FileLine, 10, PosEx('</version>', FileLine)-10));
                if TempString <> '' then
                   TempGameVars.eTitle:= TempGameVars.eTitle+' ('+TempString+')';
              end
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15))
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<input ') then
              GetControlTags(FileLine)
           else
           if XML_CheckData(FileLine, '<region ') then
              RegionTagStr:= XML_GetEntryValue(FileLine, 'name')
           else
           if XML_CheckData(FileLine, '<file ') then
              ParseROMDiskEntry(0, False)
           else

           if XML_CheckData(FileLine, '</game>') then
              begin
                // must verify if is clone or parent ??? not necessary here but I'll leave it for now...
                if TempGameVars.eClone = '' then
                   TempGameVars.eROMIdentification:= 10 // it's a parent game... Supermodel: SEGA Model 3
                else
                   TempGameVars.eROMIdentification:= 11; // it's a clone game... Supermodel: SEGA Model 3

                AddExtraGameInfo;

                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);

                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    GameStatusList.EndUpdate;

    ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(idSupermodel, 1));

    ParentROMsList:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(idSupermodel, 1));

    Application.ProcessMessages;
    FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass).'+#13#10+
                          'Creating clones sets list.');


    tmpParentROMs:= THashedStringList.Create;
    tmpCloneROMs:= THashedStringList.Create;
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<game ') then
         begin
           if not IsParentGame(FileLine) then
              begin
                ClearMemGameInfo(TempGameVars);
                tmpParentROMs.Clear;
                tmpCloneROMs.Clear;
                TempGameVars.eSystemID:= idSupermodel;
                ROMsDetailsLine:= '';
                TempString:= '';
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'parent');
                TempGameVars.eGameSetStatus:= 2; // missing
                ROMsHeaderAdded:= False;
                RegionTagStr:= ''; // required so ROMs of clone sets can be replaced in the parent set
                ParentROMsList.ReadSectionValues(TempGameVars.eClone, tmpParentROMs);

                tmpCloneROMs.BeginUpdate;

                IsGameEntry:= True;
              end
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, '<title>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 8, PosEx('</title>', FileLine)-8));
                TempGameVars.eTitle:= FixDescriptionFormat(idSupermodel, TempGameVars.eTitle, False);
              end
           else
           if XML_CheckData(FileLine, '<version>') then
              begin
                TempString:= DecodeHTML(Copy(FileLine, 10, PosEx('</version>', FileLine)-10));
                if TempString <> '' then
                   TempGameVars.eTitle:= TempGameVars.eTitle+' ('+TempString+')';
              end
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15))
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<input ') then
              GetControlTags(FileLine)
           else
           if XML_CheckData(FileLine, '<region ') then
              RegionTagStr:= XML_GetEntryValue(FileLine, 'name')
           else
           if XML_CheckData(FileLine, '<file ') then
              ParseROMDiskEntry(0, True)
           else

           if XML_CheckData(FileLine, '</game>') then
              begin
                if TempGameVars.eClone = '' then
                   TempGameVars.eROMIdentification:= 10 // it's a parent game... Supermodel: SEGA Model 3
                else
                   TempGameVars.eROMIdentification:= 11; // it's a clone game... Supermodel: SEGA Model 3

                tmpCloneROMs.EndUpdate;
                AddExtraGameInfo;

                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);

                ReplaceCloneROMs; // replace all ROMs from the clone set into the copied parent set

                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    GameStatusList.EndUpdate;

    // this is the end of ListXML parsing...
  end;

  FormStatus.MessageStr('Saving files and freeing memory.');

  Application.ProcessMessages;

  EmulatorDateTime[idSupermodel]:= FileAgeW(EmulatorFile[idSupermodel]);
  if tmpEmuVersion = '' then
     begin
       FormStatus.MessageStr('Extracting emulator version.');
       GetArcadeEmulatorVersion(idSupermodel, EmulatorFile[idSupermodel], EmulatorVersion[idSupermodel], iVersion);
       Application.ProcessMessages;
     end
  else
     EmulatorVersion[idSupermodel]:= tmpEmuVersion;
  ListGames.WriteString('info_file', 'description', GetArcadeEmulatorDescription(idSupermodel)+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[idSupermodel]);
  ListGames.UpdateFile;

  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(idSupermodel, 2));

  if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
     ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(idSupermodel, 1))
  else
     begin
       CallMessageBox;
       AddMsgText('ROMs list file ');
       AddMsgText(GetGamesFolderEL+GetSystemFileName(idSupermodel, 1), MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
       GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
     end;
  FreeMemVariables;
end;

