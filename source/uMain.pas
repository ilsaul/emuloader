procedure TFormMain.SetToolBarIcon(IconFileName: String; const IconFolder: String; IconList: TImageList; IconIndex: Integer; DisplayErrorMsg: Boolean = True);
var
  Icon32: TExIcon;
  tmpIcon: TIcon;
  icoLoop: ShortInt;
  ColorDepth: TPixelFormat;
  IconLoaded: Boolean;
  FileExt: String;
begin
  FileExt:= '.ico';
  if PosEx('.ico', LowerCase(IconFileName)) <> 0 then
     FileExt:= '';

  if not FileExists(IconFolder+IconFileName+FileExt) then
     IconFileName:= 'arcade_filters\no_icon';

  if not FileExists(IconFolder+IconFileName+FileExt) then
     Exit;
  Icon32:= TExIcon.Create;
  Icon32.LoadFromFile(IconFolder+IconFileName+FileExt);
  IconLoaded:= False;
  ColorDepth:= pf32bit;

  for icoLoop:=0 to Icon32.ImageCount-1 do
  begin
    if (Icon32.Images[icoLoop].Width = IconList.Width) and
       (Icon32.Images[icoLoop].Height = IconList.Height) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) then
       begin
         Icon32.CurrentImage:= icoLoop;
         tmpIcon:= TIcon.Create;
         tmpIcon.Handle:= Icon32.Handle;
         IconList.ReplaceIcon(IconIndex, tmpIcon);
         FreeAndNil(tmpIcon);
         Icon32.Releasehandle;
         IconLoaded:= True;
         Break;
       end;
  end;
  FreeAndNil(Icon32);
  if not IconLoaded then
     GenerateMessage('Error', 'Replace tool bar icon failed.',
                     'Tool bar icon ('+IntToStr(IconList.Width)+'x'+
                     IntToStr(IconList.Height)+') was not loaded.'+#13#10+
                     IconList.Name+#13#10+IconFolder+IconFileName+FileExt, 2, False, 1);
end;

function TFormMain.AddDefaultIcons(const IconFileName, IconsFolder: String; IconList: TImageList; ShowErrorMsg: Boolean = True): Boolean;
var
  Icon32: TExIcon;
  tmpIcon: TIcon;
  icoLoop: ShortInt;
  ColorDepth: TPixelFormat;
  IconAdded: Boolean;
begin
  Result:= False;
  if (not FileExists(IconsFolder+IconFileName)) and ShowErrorMsg then
     begin
       GenerateMessage('Error', 'File not found.',
                       Format(MissingIconFileMsg, [IconsFolder+IconFileName]), 2, False, 1);
       Exit;
     end;
  Icon32:= TExIcon.Create;
  Icon32.LoadFromFile(IconsFolder+IconFileName);
  ColorDepth:= pf32bit;
  IconAdded:= False;
  for icoLoop:=0 to Icon32.ImageCount-1 do
  begin
    if (Icon32.Images[icoLoop].Width = IconList.Width) and
       (Icon32.Images[icoLoop].Height = IconList.Height) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) then
       begin
         Icon32.CurrentImage:= icoLoop;         
         tmpIcon:= TIcon.Create;
         tmpIcon.Handle:= Icon32.Handle;
         IconList.AddIcon(tmpIcon);
         tmpIcon.ReleaseHandle;
         FreeAndNil(tmpIcon);
         Result:= True;
         IconAdded:= True;
         Break;
       end;
  end;
  FreeAndNil(Icon32);
  if (not IconAdded) and ShowErrorMsg then
     GenerateMessage('Error', 'Failed to load file.', 'Icon ('+IntToStr(IconList.Width)+'x'+
                                       IntToStr(IconList.Height)+') was not added.'+#13#10+
                     IconList.Name+#13#10+IconsFolder+IconFileName, 2, False, 1);
end;

procedure TFormMain.AddMainScrIcons(const IconFileName, IconsFolder: String; IconListLarge, IconListSmall: TImageList; Reload: Boolean);
var
  Icon32: TExIcon;
  icoLoop: ShortInt;
  ColorDepth: TPixelFormat;
  LargeIconAdded, SmallIconAdded: Boolean;
  ErrorMsg: String;

  procedure AddIcon(DestImgList: TImageList);
  var
    tmpIcon: TIcon;
  begin
    Icon32.CurrentImage:= icoLoop;
    tmpIcon:= TIcon.Create;
    tmpIcon.Handle:= Icon32.Handle;
    DestImgList.AddIcon(tmpIcon);
    tmpIcon.ReleaseHandle;
    FreeAndNil(tmpIcon);
  end;

begin
  if not FileExists(IconsFolder+IconFileName) then
     begin
       GenerateMessage('Error', 'Could not access a file.',
                       Format(MissingIconFileMsg, [IconsFolder+IconFileName]), 2);
       Exit;
     end;
  Icon32:= TExIcon.Create;
  Icon32.LoadFromFile(IconsFolder+IconFileName);
  ColorDepth:= pf32bit;
  LargeIconAdded:= False;
  SmallIconAdded:= Reload;
  for icoLoop:=0 to Icon32.ImageCount-1 do
  begin
    if (Icon32.Images[icoLoop].Width = IconListLarge.Width) and
       (Icon32.Images[icoLoop].Height = IconListLarge.Height) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) then
       begin
         AddIcon(IconListLarge);
         LargeIconAdded:= True;
       end
    else
    if (Icon32.Images[icoLoop].Width = IconListSmall.Width) and
       (Icon32.Images[icoLoop].Height = IconListSmall.Height) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) and
       (not Reload) then
       begin
         AddIcon(IconListSmall);
         SmallIconAdded:= True;
       end;
    if LargeIconAdded and SmallIconAdded then
       Break;
  end;
  FreeAndNil(Icon32);
  ErrorMsg:= '';
  if not LargeIconAdded then
     ErrorMsg:= 'Large icon ('+IntToStr(IconListLarge.Width)+'x'+
                               IntToStr(IconListLarge.Height)+' was not added.'+#13#10+
                IconListLarge.Name+#13#10+IconsFolder+IconFileName;
                
  if not SmallIconAdded then
     begin
       if ErrorMsg <> '' then
          ErrorMsg:= ErrorMsg+#13#10+#13#10;
       ErrorMsg:= 'Small icons (24x24) was not added.'+#13#10+IconListSmall.Name+#13#10+IconsFolder+IconFileName;
     end;
  if ErrorMsg <> '' then
     GenerateMessage('Error', 'Failed to a load file.', ErrorMsg, 2, False, 1);
end;

procedure TFormMain.AddGameIcons(const IconFileName, IconsFolder: String);
var
  Icon32: TExIcon;
  icoLoop: ShortInt;
  ColorDepth: TPixelFormat;
  ExtraLargeIconAdded, LargeIconAdded, StandardIconAdded, SmallIconAdded: Boolean;
  ErrorMsg: String;

  procedure AddIcon(DestImgList: TImageList);
  var
    tmpIcon: TIcon;
  begin
    Icon32.CurrentImage:= icoLoop;
    tmpIcon:= TIcon.Create;
    tmpIcon.Width:= DestImgList.Width;
    tmpIcon.Height:= DestImgList.Height;
    tmpIcon.Handle:= Icon32.Handle;
    DestImgList.AddIcon(tmpIcon);
    tmpIcon.ReleaseHandle;
    FreeAndNil(tmpIcon);
  end;

begin
  if not FileExists(IconsFolder+IconFileName) then
     begin
       GenerateMessage('Error', 'Could not access a file.',
                       Format(MissingIconFileMsg, [IconsFolder+IconFileName]), 2, False, 1);
       Exit;
     end;
  Icon32:= TExIcon.Create;
  Icon32.LoadFromFile(IconsFolder+IconFileName);
  ColorDepth:= pf32bit;
  ExtraLargeIconAdded:= False;
  LargeIconAdded:= False;
  StandardIconAdded:= False;
  SmallIconAdded:= False;
  ErrorMsg:= '';
  for icoLoop:=0 to Icon32.ImageCount-1 do
  begin
    if (Icon32.Images[icoLoop].Width = 48) and
       (Icon32.Images[icoLoop].Height = 48) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) then
       begin
         AddIcon(IL_StandardIconsExtraLarge);
         ExtraLargeIconAdded:= True;
       end
    else
    if (Icon32.Images[icoLoop].Width = 32) and
       (Icon32.Images[icoLoop].Height = 32) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) then
       begin
         AddIcon(IL_StandardIconsLarge);
         LargeIconAdded:= True;
       end
    else
    if (Icon32.Images[icoLoop].Width = 24) and
       (Icon32.Images[icoLoop].Height = 24) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) then
       begin
         AddIcon(IL_StandardIconsStandard);
         StandardIconAdded:= True;
       end
    else
    if (Icon32.Images[icoLoop].Width = 16) and
       (Icon32.Images[icoLoop].Height = 16) and
       (Icon32.Images[icoLoop].PixelFormat = ColorDepth) then
       begin
         AddIcon(IL_StandardIconsSmall);
         SmallIconAdded:= True;
       end;
    if ExtraLargeIconAdded and LargeIconAdded and
       StandardIconAdded and SmallIconAdded then
       begin
         Break;
       end;
  end;
  FreeAndNil(Icon32);
  if not ExtraLargeIconAdded then
     ErrorMsg:= 'Extra Large icon (48x48) not added.';
     
  if not LargeIconAdded then
     begin
       if ErrorMsg <> '' then
          ErrorMsg:= ErrorMsg+#13#10;
       ErrorMsg:= 'Large icon (32x32) not added.';
     end;

  if not StandardIconAdded then
     begin
       if ErrorMsg <> '' then
          ErrorMsg:= ErrorMsg+#13#10;
       ErrorMsg:= 'Standard icon (24x24) not added.';
     end;

  if not SmallIconAdded then
     begin
       if ErrorMsg <> '' then
          ErrorMsg:= ErrorMsg+#13#10;
       ErrorMsg:= 'Small icons (16x16) not added.';
     end;

  if ErrorMsg <> '' then
     begin
       ErrorMsg:= ErrorMsg+#13#10+'Source file: '+IconsFolder+IconFileName;
       GenerateMessage('Error', 'Failed to load icons.', ErrorMsg, 2, False, 1);
     end;
end;

