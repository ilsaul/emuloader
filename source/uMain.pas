function TFormMain.AddToSpecialList(IsMiscPlusFilter: Boolean = False): Boolean;
var
  gTotal, titleIndex: Integer;
  MsgTitle, FavTitleStr: String;
  listHolder: THashedStringList;
  gItem: TEasyItem;

  // this was used when EL had the hidden games feature... this feature might be brought back... "MIGHT"
  //function UpdateStringList(StringListHolder: THashedStringList): Boolean;
  //begin
  //  StringListHolder.BeginUpdate;
  //  StringListHolder.Clear;
  //  StringListHolder.Assign(listHolder);
  //  StringListHolder.EndUpdate;
  //  Result:= True;
  //end;

begin
  Result:= False;
  if not CheckSelected(GamesListView) then
     Exit;

  MsgTitle:= 'Add Games To Favorites';
  FavList:= THashedStringList.Create;
  if FileExists(GetFavoritesFile) then
     FavList.LoadFromFile(GetFavoritesFile);

  if IsFavoriteDefault(FavoriteProfile[1]) then
     FavTitleStr:= ''
  else
     begin
       titleIndex:= FavList.IndexOfName('favorite_title');
       FavTitleStr:= FavList.Values['favorite_title'];
       if FavTitleStr = '' then
          FavTitleStr:= ChangeFileExt(FavoriteProfile[1], '');
       if titleIndex <> -1 then
          FavList.Delete(titleIndex); // title will be re-added later
     end;

  gTotal:= FavList.Count;
  listHolder:= THashedStringList.Create;
  listHolder.BeginUpdate;
  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // remove any pending requests before reloading them
  GamesListView.BeginUpdate;
  gItem:= GamesListView.Selection.First;
  repeat
    TEasyGameInfo(gItem).eIsFavorite:= True;
    if IsThumbnailView then
       begin
         TEasyGameInfo(gItem).eThumbnail.Free;
         TEasyGameInfo(gItem).eThumbnail:= nil;
         FreeAndNil(TEasyGameInfo(gItem).fThumbnail);
         TEasyGameInfo(gItem).eThumbnailLoaded:= False;
         TEasyGameInfo(gItem).eThumbnailIsZipped:= False;
         gItem.Initialized:= False; // cause the Initialized event to be called again when the control needs the info
       end;
    FillTempGameInfo(gItem);
    if TempGameVars.eSoftwareName = '' then
       listHolder.Add(TempGameVars.eName+'='+GetSystemIniSection(TempGameVars.eSystemID, True))
    else
       listHolder.Add(TempGameVars.eName+'_'+TempGameVars.eSoftwareName+'='+GetSystemIniSection(TempGameVars.eSystemID, True));
    gItem:= FormMain.GamesListView.Selection.Next(gItem);
  until gItem = nil;
  GamesListView.EndUpdate(False);

  listHolder.Sort;
  listHolder.Sorted:= True;
  if FavList.Count > 0 then
     listHolder.AddStrings(FavList);
  listHolder.Sorted:= False;
  listHolder.EndUpdate;

  if IsThumbnailView then
     ResetThumbnails(True);
  Result:= listHolder.Count <> gTotal;
  if Result then
     begin
       //UpdateStringList(FavList); // if hidden games feature is back, replace FavList with HiddenList
       FavList.BeginUpdate;
       FavList.Clear;
       FavList.Assign(listHolder);
       FavList.EndUpdate;

       if FavTitleStr <> '' then
          FavList.Insert(0, 'favorite_title='+FavTitleStr);
       FavList.SaveToFile(GetFavoritesFile);
     end;
  FreeAndNil(listHolder);
  FreeAndNil(FavList);
  
  if not Result then
     begin
       if FavTitleStr = '' then
          FavTitleStr:= 'Default';
       GenerateMessage('Info', MsgTitle, 'No games were added, already in the list.'+#13#10+#13#10+
                       FavTitleStr+#13#10+'File: '+FavoriteProfile[1], 2);
     end;
end;

function TFormMain.DeleteFromSpecialList(IsMiscPlusFilter: Boolean = False): Boolean;
var
  Loop, titleIndex: Integer;
  MsgTitle, FavTitleStr: String;
  listHolder, selGamesList: THashedStringList;
  gItem: TEasyItem;

  //function UpdateStringList(StringListHolder: THashedStringList): Boolean;
  //begin
  //  StringListHolder.BeginUpdate;
  //  StringListHolder.Clear;
  //  StringListHolder.Assign(listHolder);
  //  StringListHolder.EndUpdate;
  //  Result:= True;
  //end;
  
  //function CheckFile(sFile: String): Boolean;
  //begin
  //  Result:= FileExists(sFile);
  //  if not Result then
  //     GenerateMessage('ERROR', MsgTitle, Format('    File "%s" not found. '+
  //                     'Game(s) cannot be removed from the favorites list. Please restart the frontend to fix this.',
  //                     [sFile]), 2, False, 1);
  //end;

begin
  Result:= False;
  if not CheckSelected(GamesListView) then
     Exit;

  MsgTitle:= 'Remove Games From Favorites';
  if not FileExists(GetFavoritesFile) then
     begin
       GenerateMessage('Error', MsgTitle, '    File not found. '+
                       'Games cannot be removed from the favorites list.'+#13#10+#13#10+
                       FavoriteProfile[0]+#13#10+'File: '+FavoriteProfile[1], 2, False, 1);
       Exit;
     end;

  //if not CheckFile(GetFavoritesFile) then
  //   Exit;

  FavList:= THashedStringList.Create;
  FavList.LoadFromFile(GetFavoritesFile);

  if IsFavoriteDefault(FavoriteProfile[1]) then
     FavTitleStr:= ''
  else
     begin
       titleIndex:= FavList.IndexOfName('favorite_title');
       FavTitleStr:= FavList.Values['favorite_title'];
       if FavTitleStr = '' then
          FavTitleStr:= ChangeFileExt(FavoriteProfile[1], '');
       if titleIndex <> -1 then
          FavList.Delete(titleIndex); // title will be re-added later
     end;

  listHolder:= THashedStringList.Create;
  listHolder.AddStrings(FavList);

  selGamesList:= THashedStringList.Create;
  selGamesList.BeginUpdate;

  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // remove any pending requests before reloading them
  GamesListView.BeginUpdate;
  gItem:= GamesListView.Selection.First;
  repeat
    FillTempGameInfo(gItem);
    if TempGameVars.eSoftwareName = '' then
       selGamesList.Add(TempGameVars.eName+'='+GetSystemIniSection(TempGameVars.eSystemID, True))
    else
       selGamesList.Add(TempGameVars.eName+'_'+TempGameVars.eSoftwareName+'='+GetSystemIniSection(TempGameVars.eSystemID, True));
    TEasyGameInfo(gItem).eIsFavorite:= False;
    if IsThumbnailView then
       begin
         TEasyGameInfo(gItem).eThumbnail.Free;
         TEasyGameInfo(gItem).eThumbnail:= nil;
         FreeAndNil(TEasyGameInfo(gItem).fThumbnail);
         TEasyGameInfo(gItem).eThumbnailLoaded:= False;
         TEasyGameInfo(gItem).eThumbnailIsZipped:= False;
         gItem.Initialized:= False; // cause the Initialized event to be called again when the control needs the info
       end;

    gItem:= FormMain.GamesListView.Selection.Next(gItem);
  until gItem = nil;
  GamesListView.EndUpdate(False);
  selGamesList.Sort;
  selGamesList.Sorted:= True;
  selGamesList.EndUpdate;
  listHolder.BeginUpdate;
  for Loop:= listHolder.Count-1 downto 0 do
  begin
    if selGamesList.IndexOf(listHolder[Loop]) <> -1 then
       begin
         listHolder.Delete(Loop);
         Result:= True;
       end;
    Application.ProcessMessages;
  end;
  listHolder.EndUpdate;
  listHolder.Sorted:= False;
  FreeAndNil(selGamesList);

  case Result of
    True:
      begin
        //UpdateStringList(FavList);
        FavList.BeginUpdate;
        FavList.Clear;
        FavList.Assign(listHolder);
        FavList.EndUpdate;

        if FavTitleStr <> '' then
           FavList.Insert(0, 'favorite_title='+FavTitleStr);
        FavList.SaveToFile(GetFavoritesFile);
        FreeAndNil(listHolder);
        FreeAndNil(FavList);
        if SelectedFilterName = 'favorites' then
           SetGameType(False); // only ApplyFilters is needed here!!!
        //ReselectItem(True);
        //SelectNearGame(SelectedEasyItem);
        FillMemGameInfo(MemGameInfo); // fix selected game info in memory
        //SelectedEasyItem:= GamesListView.Groups.PrevVisibleItem(GamesListView.Selection.First);

      end;
    False:
      begin
        FreeAndNil(listHolder);
        FreeAndNil(FavList);
        if FavTitleStr = '' then
           FavTitleStr:= 'Default';
        GenerateMessage('Info', MsgTitle, 'No games were removed from the favorites list.'+#13#10+#13#10+
                        FavTitleStr+#13#10+'File: '+FavoriteProfile[1], 2);
      end;
  end;
end;

procedure TFormMain.LoadFolders_MAME(SystemID: Byte; IsAlterMAME: Boolean = False);
var
  MAMEIniFile: THashedStringList;
  Folder, Folder2, TextLine, IniFile, EntryString, iniDirString: String;
  Loop, iPos, iVersion: Integer;
begin
  case IsAlterMAME of
    True:
      begin
        if not ValidateAlterMAMEEmulatorFile then
           Exit;
      end;
    False:
      begin
        if not ValidateEmulatorFile(SystemID) then
           Exit;
      end;
  end;
  // no need as folders strings are loaded very fast into RAM....
  //if FormStatus.Visible then
  //   begin
  //     if IsAlterMAME then
  //        FormStatus.MessageStr('Loading .ini folder: '+GetEmulatorDescription(SystemID, True, AlterMAMEFile))
  //     else
  //        FormStatus.MessageStr('Loading folders: '+GetEmulatorDescription(SystemID, True));
  //   end;

  if IsAlterMAME then
     iniFile:= GetEmuIniFileName(SystemID, AlterMAMEFile)
  else
     iniFile:= GetEmuIniFileName(SystemID, EmulatorFile[SystemID]);
  if not FileExists(iniFile) then
     Exit;

  MAMEIniFile:= THashedStringList.Create;
  MAMEIniFile.LoadFromFile(iniFile);
  for Loop:=0 to MAMEIniFile.Count -1 do
  begin
    TextLine:= MAMEIniFile[Loop];
    if TextLine <> '' then
       begin
         EntryString:= XML_GetEntryName(TextLine);
         if EntryString <> '' then
            EntryString:= EntryString+' ';
         if not IsAlterMAME then
         begin
           if (EntryString = 'rompath ') or
              (EntryString = 'rp ') then
              begin
                Folder:= ExtractMAMEIniValue(TextLine);
                if Folder = '' then
                   Folder:= 'roms';
              end
           else
           //if (EntryString = 'hashpath ') or
           //   (EntryString = 'hash_directory ') or
           //   (EntryString = 'hash ') then // not used!!!!!!! 2014
           //   begin
           //     HashDir[Ord(SystemID = idMAME)]:= ExtractMAMEIniValue(TextLine);
           //     if HashDir[Ord(SystemID = idMAME)] = '' then
           //        HashDir[Ord(SystemID = idMAME)]:= 'hash';
           //   end
           //else
           if (EntryString = 'samplepath ') or
              (EntryString = 'sp ') then
              begin
                Folder2:= ExtractMAMEIniValue(TextLine);
                if Folder2 = '' then
                   Folder2:= 'samples';
                ExtractFolders2MAME(SystemID, Folder2, SamplesDir[Ord(SystemID = idMAME)]);
              end
           else
           if (EntryString = 'artpath ') or
              (EntryString = 'artwork_directory ') then
              begin
                Folder2:= ExtractMAMEIniValue(TextLine);
                if Folder2 = '' then
                   Folder2:= 'artwork';
                ExtractFolders2MAME(SystemID, Folder2, ArtworksDir[Ord(SystemID = idMAME)]);
              end
           else
           if EntryString = 'input_directory ' then
              begin
                InputDir[Ord(SystemID = idMAME)]:= ExtractMAMEIniValue(TextLine);
                if InputDir[Ord(SystemID = idMAME)] = '' then
                   InputDir[Ord(SystemID = idMAME)]:= 'inp';
              end
           else
           if EntryString = 'snapshot_directory ' then
              begin
                if imgFolder[SystemID, 1] = '' then
                   imgFolder[SystemID, 1]:= ExtractMAMEIniValue(TextLine);
              end;
         end;

         if EntryString = 'inipath ' then
            begin
              iniDirString:= ExtractMAMEIniValue(TextLine);
              if (iniDirString = '') or (iniDirString = '.') or (iniDirString = '.;ini') then
                 iniDirString:= 'ini'
              else
                 begin
                   iPos:= Pos(';', iniDirString);
                   if iPos <> 0 then
                      begin
                        iniDirString:= Copy(iniDirString, 1, iPos-1);
                        if iniDirString = '.' then
                           iniDirString:= 'ini';
                      end;
                 end;
              //IniFilesDir[SystemID]:= ExtractMAMEIniValue(TextLine);
              //if (Pos(';', IniFilesDir[SystemID]) <> 0) or (IniFilesDir[SystemID] = '') then
              //   IniFilesDir[SystemID]:= 'ini';
            end
         else
         if EntryString = '# inipath ' then
            iniDirString:= 'ini';
       end;
  end;
  FreeAndNil(MAMEIniFile);
  if not IsAlterMAME then
     begin
       ExtractROMsFolders(Folder, SystemID);
       InputDir[Ord(SystemID = idMAME)]:= FullEmuFolderFix(InputDir[Ord(SystemID = idMAME)], SystemID, False);
       //HashDir[Ord(SystemID = idMAME)]:= FullEmuFolderFix(HashDir[Ord(SystemID = idMAME)], SystemID, False);
     end;

  if iniDirString <> '' then
     iniDirString:= FullEmuFolderFix(iniDirString, SystemID, False, IsAlterMAME)
  else
     begin
       if SystemID = idMAME then
          begin
            iVersion:= GetMAMEBuild(IsAlterMAME);
            if iVersion < 61 then
               begin
                 if IsAlterMAME then
                    iniDirString:= ExtractFilePath(AlterMAMEFile)
                 else
                    iniDirString:= ExtractFilePath(EmulatorFile[idMAME]);
               end;
          end;
     end;
  if IsAlterMAME then
     AlterMAMEIniFilesDir:= iniDirString
  else
     IniFilesDir[SystemID]:= iniDirString;
  //IniFilesDir[SystemID]:= FullEmuFolderFix(IniFilesDir[SystemID], SystemID, False);
end;

procedure TFormMain.LoadFoldersArcade2(sysID: Integer);
var
  emuCFG: TMemIniFile;
  Folder, tmpString: String;
  sFoldersList: TStringList;
  Loop, fCount: Integer;
begin
  if not ValidateEmulatorFile(sysID) then
     Exit;
  // no need as folders strings are loaded very fast into RAM....
  //if FormStatus.Visible then
  //   FormStatus.MessageStr('Loading folders: '+GetEmulatorDescription(sysID, True));

  case sysID of
    idSupermodel, idZiNc:
      begin
        tmpString:= GetIniFilesFolder+'folders_emulators.ini';
        if not FileExists(tmpString) then
           begin
             tmpString:= FrontendPath+'EmuLoader.ini';
             if not FileExists(tmpString) then
                Exit;
           end;

        emuCFG:= TMemIniFile.Create(tmpString);
        Folder:= emuCFG.ReadString(GetSystemIniSection(sysID), 'roms_path', '');
        if Folder = '' then
           Folder:= 'roms';
        FreeAndNil(emuCFG);
      end;
    idDaphne, idDICE:
      begin
        Folder:= ExtractFilePath(EmulatorFile[sysID])+'roms';
      end;
    idDemul:
      begin
        tmpString:= GetEmuIniFileName(sysID);
        if (tmpString <> '') and (FileExists(tmpString)) then
           begin
             Folder:= '';
             emuCFG:= TMemIniFile.Create(tmpString);
             fCount:= emuCFG.ReadInteger('files', 'romsPathsCount', 1);
             Folder:= emuCFG.ReadString('files', 'roms0', 'roms');
             if fCount > 1 then
                begin
                  tmpString:= '';
                  for Loop:=1 to fCount-1 do
                  begin
                    tmpString:= emuCFG.ReadString('files', 'roms'+(IntToStr(Loop)), 'roms');
                    if Folder <> '' then
                       Folder:= Folder+';';
                    Folder:= Folder+FullEmuFolderFix(tmpString, sysID, False);
                  end;
                end;
             FreeAndNil(emuCFG);
           end;
        if Folder = '' then
           Folder:= ExtractFilePath(EmulatorFile[idDemul])+'roms';
      end;
    idSegaModel2:
      begin
        tmpString:= GetEmuIniFileName(sysID);
        if (tmpString <> '') and (FileExists(tmpString)) then
           begin
             emuCFG:= TMemIniFile.Create(tmpString);
             sFoldersList:= TStringList.Create;
             emuCFG.ReadSectionValues('RomDirs', sFoldersList);
             Folder:= '';
             tmpString:= '';
             if sFoldersList.Count > 0 then
                begin
                  for Loop:=0 to sFoldersList.Count-1 do
                  begin
                    tmpString:= sFoldersList.Names[Loop];
                    if Folder <> '' then
                       Folder:= Folder+';';
                    Folder:= Folder+FullEmuFolderFix(sFoldersList.ValueFromIndex[Loop], sysID, False);
                  end;
                end;
             FreeAndNil(sFoldersList);
             FreeAndNil(emuCFG);
           end;
        if Folder <> '' then
           Folder:= Folder+';';
        Folder:= Folder+FullEmuFolderFix('ROMs', sysID, False);
      end;
  end;
   ExtractROMsFolders(Folder, sysID);
end;

procedure TFormMain.LoadFoldersAllSystems;
var
  Loop: ShortInt;
begin
  for Loop:=1 to MaxArcadeSystems do
      LoadROMFolders(Loop);
  LoadROMFolders(idMAME, True);
end;

procedure TFormMain.LoadROMFolders(sysID: ShortInt; IsAlterMAME: Boolean = False);
begin
  case IsMAMEBasedSys(sysID) of
    True : LoadFolders_MAME(sysID, IsAlterMAME);
    False: LoadFoldersArcade2(sysID);
  end;
end;

procedure TFormMain.ExtractROMsFolders(const ROMsList: String; SystemID: Integer; ListHolder: TEasyListView = nil);
var
  PathName: String;

  function AddToList: Boolean;
  begin
    Result:= Assigned(ListHolder);
    case Result of
      True:
        begin
          with ListHolder.Items.Add do
          begin
            ImageIndex:= 4;
            Caption:= ExcludeTrailingPathDelimiter(PathName);
          end;
        end;
      False: emuROMsFolders[SystemID].Add(ExcludeTrailingPathDelimiter(PathName));
    end;
  end;

  procedure AddMultipleFolders;
  var
    Loop: Integer;
  begin
    // multiple folders
    for Loop:=1 to Length(ROMsList) do
    begin
      if (ROMsList[Loop] = ';') then
         begin
           AddToList;
           PathName:= '';
         end
      else
         begin
           if ROMsList[Loop] <> '"' then
              PathName:= PathName+ROMsList[Loop];
           if Loop = Length(ROMsList) then
              AddToList;
         end;
    end;
  end;

begin
  case Assigned(emuROMsFolders[SystemID]) of
    True : emuROMsFolders[SystemID].Clear;
    False: emuROMsFolders[SystemID]:= THashedStringList.Create;
  end;
  case Assigned(ListHolder) of
    True:
      begin
        AddMultipleFolders;
      end;
    False:
      begin
        if ROMsList = '' then
           Exit;
        PathName:= '';
        if SystemID in [idDaphne, idDICE] then // single folder only
           emuROMsFolders[SystemID].Add(ExcludeTrailingPathDelimiter(ROMsList))
        else
           AddMultipleFolders;
      end;
  end;
end;

procedure TFormMain.LoadFolders_ConfigFiles(sysID: Integer; out dirCFG: String; out dirNVRAM: String);
var
  MAMEIniFile: THashedStringList;
  TextLine, IniFile, EntryString: String;
  Loop: Integer;
  emuCFG: TMemIniFile;
begin
  dirCFG:= '';
  dirNVRAM:= '';
  if not ValidateEmulatorFile(sysID) then
     Exit;
  case IsMAMEBasedSys(sysID) of
    True:
      begin
        iniFile:= GetEmuIniFileName(sysID, EmulatorFile[sysID]);
        if not FileExists(iniFile) then
           Exit;
        MAMEIniFile:= THashedStringList.Create;
        MAMEIniFile.LoadFromFile(iniFile);
        for Loop:=0 to MAMEIniFile.Count -1 do
        begin
          TextLine:= MAMEIniFile[Loop];
          if TextLine <> '' then
             begin
               EntryString:= XML_GetEntryName(TextLine);
               if EntryString <> '' then
                  EntryString:= EntryString+' ';

               if EntryString = 'cfg_directory ' then
                  dirCFG:= ExtractMAMEIniValue(TextLine)
               else
               if EntryString = 'nvram_directory ' then
                  dirNVRAM:= ExtractMAMEIniValue(TextLine);
             end;
        end;
        FreeAndNil(MAMEIniFile);
        dirCFG:= FullEmuFolderFix(dirCFG, sysID, False);
        dirNVRAM:= FullEmuFolderFix(dirNVRAM, sysID, False);
      end;
    False:
      begin
        case sysID of
          idZiNc: dirCFG:= FullEmuFolderFix('cfg', sysID, False);
          idDemul:
            begin
              iniFile:= GetEmuIniFileName(sysID, EmulatorFile[sysID]);
              if not FileExists(iniFile) then
                 Exit;
              emuCFG:= TMemIniFile.Create(iniFile);
              dirNVRAM:= emuCFG.ReadString('files','nvram', '');
              FreeAndNil(emuCFG);
              dirNVRAM:= FullEmuFolderFix(dirNVRAM, sysID, False);
            end;
          idSegaModel2:
            begin
              dirNVRAM:= FullEmuFolderFix('nvdata', sysID, False);
              dirCFG:= FullEmuFolderFix('cfg', sysID, False);
            end;
          idSupermodel:
            begin
              dirCFG:= FullEmuFolderFix('config', sysID, False);
              dirNVRAM:= FullEmuFolderFix('nvram', sysID, False);
            end;
        end;
      end;
  end;
end;

