function TFormMain.ELV_GetSystemTitle(ELV_Holder: TEasyListView; SelectedItem: TEasyItem; EmulatorTitle: TShadowLabel = nil; SystemType: TShadowLabel = nil): String;
begin
  Result:= '';
  if SelectedItem.StateImageIndex = -1 then
     begin
       if SystemType <> nil then
          SystemType.Caption:= 'ARCADE';
       Result:= GetArcadeEmulatorDescription(ELV_Holder.Tag);
       if EmulatorTitle <> nil then
          EmulatorTitle.Caption:= UpperCase(Result);
     end
  else
     begin
       if SystemType <> nil then
          SystemType.Caption:= UpperCase(GetSystemTypeTitle(ELV_Holder.Tag, False));
       Result:= SystemsListCustom[SelectedItem.StateImageIndex, 0];
       if EmulatorTitle <> nil then
          EmulatorTitle.Caption:= UpperCase(Result);
     end;
end;

function TFormMain.ELV_FindItemBySystemID(ELV_Destination: TEasyListView; sysID: Integer; IsCustomGame: Boolean; SearchDisabledItems: Boolean): TEasyItem;
var
  Item: TEasyItem;
  iFound: Boolean;
begin
  Result:= nil;
  iFound:= False;
  // Item.StateImageIndex = -1; // -1 -> Arcade; 1..MaxConsoleComputerSystems -> Console/Computer (EmuCon)
  // Item.ImageIndex = arcade system IDs
  if SearchDisabledItems then
     Item:= ELV_Destination.Groups.FirstItem
  else
     Item:= ELV_Destination.Groups.FirstVisibleItem;

  if Item = nil then
     Exit; // list empty or all items are invisible ?
  repeat
    if Item <> nil then
    begin
      if IsCustomGame then
         begin
           if Item.StateImageIndex = sysID then
              begin
                iFound:= True;
                Result:= Item;
              end;
         end
      else
         begin
           if Item.ImageIndex = sysID then
              begin
                iFound:= True;
                Result:= Item;
              end;
         end;
      end;
    if SearchDisabledItems then
       Item:= ELV_Destination.Groups.NextItem(Item)
    else
       Item:= ELV_Destination.Groups.NextVisibleItem(Item);
  until iFound or (Item = nil);
  if Result = nil then
     Result:= ELV_Destination.Groups.FirstItem;
end;

function TFormMain.ELV_FindSelectedSystemMulti(ELV_Destination: TEasyListView; Item_Source: TEasyItem; SearchDisabledItems: Boolean = True): Boolean;
var
  eID: Integer;
begin
  eID:= -1;
  if CheckSelected(GamesListView) then
     begin
       if TEasyGameInfo(Item_Source).eIsCustomGame then
          eID:= ELV_FindItemBySystemID(ELV_Destination, TEasyGameInfo(Item_Source).eCustomSystemID, True, SearchDisabledItems).Index
       else
          eID:= ELV_FindItemBySystemID(ELV_Destination, TEasyGameInfo(Item_Source).eSystemID, False, SearchDisabledItems).Index;
     end;

  Result:= eID <> -1;
  if Result then
     ELV_SelectItem(ELV_Destination, eID);
end;

function TFormMAin.ELV_SelecionBar_GetColorState(GameStatus: ShortInt; HaveSet: TColorBoxEx; MissingROMsSet: TColorBoxEx; GetDefaultColor: Boolean = False): TColor;
begin
  if GameStatus = 1 then
     begin
       if GetDefaultColor then
          Result:= MissingROMsSet.DefaultColorColor
       else
          Result:= MissingROMsSet.Selected;
     end
  else
     begin
       if GetDefaultColor then
          Result:= HaveSet.DefaultColorColor
       else
          Result:= HaveSet.Selected
     end;
end;

function TFormMain.ELV_AllowSelectionBarUserColors(EasyListView_To_Check: TEasyListView): Boolean;
begin
  Result:= (EasyListView_To_Check = GamesListView) or (EasyListView_To_Check = MachinesListSidePanel) or
            // customize games list fonts                 // customize thumbnails
           (EasyListView_To_Check.Name = 'GamesFont') or (EasyListView_To_Check.Name = 'ELV_ThumbnailPreview') or
           (EasyListView_To_Check.Name = 'NightModeGamesListView') or
           (EasyListView_To_Check.Name = 'GamesList') or // Delete Multiple Games Files
           (EasyListview_To_Check.Name = 'FilesListView') or // Scan MAME Audio Samples
           // arcade images manager
           (EasyListView_To_Check.Name = 'MissingImagesList') or (EasyListView_To_Check.Name = 'NotUsedImagesList') or
           // arcade delete clone images
           (EasyListView_To_Check.Name = 'DeleteClonesList') or
           (EasyListView_To_Check.Name = 'MissingIconsList'); // MAMu_ Icons Manager
end;

procedure TFormMain.ELV_SetSelectRibbon(State: ShortInt; EasyListViewHolder: TEasyListView; ForceUpdate: Boolean = False; ForceNightColors: Boolean = False);
begin
  // state:
  //   0 -> game OK
  //   1 -> missing ROMs/CHDs
  //   2 -> missing (no ROMs found)
  if State = 2 then
     State:= 0; // set to zero since the selection ribbon for missing games is the same as "game OK"
  if (State = EasyListViewHolder.HelpContext) and (not ForceUpdate) then
     Exit;

  EasyListViewHolder.HelpContext:= State;
  if ELV_AllowSelectionBarUserColors(EasyListViewHolder) then
  begin
    if (not IsNightMode) and (not Assigned(FormPreferences)) then
       Exit;
    if IsNightMode or ForceNightColors then
    begin
      EasyListViewHolder.Selection.Color:= ELV_SelecionBar_GetColorState(State, FormNightMode.NightModeGamesSelectionTopColor, FormNightMode.NightModeGamesSelectionMissROMsTopColor); // single color selection
      EasyListViewHolder.Selection.GradientColorTop:= ELV_SelecionBar_GetColorState(State, FormNightMode.NightModeGamesSelectionTopColor, FormNightMode.NightModeGamesSelectionMissROMsTopColor); // gradient top
      EasyListViewHolder.Selection.GradientColorBottom:= ELV_SelecionBar_GetColorState(State, FormNightMode.NightModeGamesSelectionBottomColor, FormNightMode.NightModeGamesSelectionMissROMsBottomColor); // gradient bottom
      EasyListViewHolder.Selection.BorderColor:= ELV_SelecionBar_GetColorState(State, FormNightMode.NightModeGamesSelectionFrameColor, FormNightMode.NightModeGamesSelectionMissROMsFrameColor); // frame color

      //EasyListViewHolder.Selection.TextColor:= clBlack; // this doesn't work, call ELV_ItemPaintText_General() function instead

      EasyListViewHolder.Selection.InactiveColor:= FormNightMode.NightModeGamesSelectionInactiveTopColor.Selected;
      EasyListViewHolder.Selection.InactiveGradientColorTop:= FormNightMode.NightModeGamesSelectionInactiveTopColor.Selected;
      EasyListViewHolder.Selection.InactiveGradientColorBottom:= FormNightMode.NightModeGamesSelectionInactiveBottomColor.Selected;
      EasyListViewHolder.Selection.InactiveBorderColor:=  FormNightMode.NightModeGamesSelectionInactiveFrameColor.Selected;
      EasyListViewHolder.Selection.InactiveTextColor:= FormNightMode.NightModeGamesSelectionInactiveFontColor.Selected;
                                                       // this doesn't work, call ELV_ItemPaintText_General() function instead
    end
    else
    begin
      EasyListViewHolder.Selection.Color:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionTopColor, FormPreferences.GamesSelectionMissROMsTopColor); // single color selection
      EasyListViewHolder.Selection.GradientColorTop:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionTopColor, FormPreferences.GamesSelectionMissROMsTopColor); // gradient top
      EasyListViewHolder.Selection.GradientColorBottom:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionBottomColor, FormPreferences.GamesSelectionMissROMsBottomColor); // gradient bottom
      EasyListViewHolder.Selection.BorderColor:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionFrameColor, FormPreferences.GamesSelectionMissROMsFrameColor); // frame color

      //EasyListViewHolder.Selection.TextColor:= clBlack; // this doesn't work, call ELV_ItemPaintText_General() function instead

      EasyListViewHolder.Selection.InactiveColor:= FormPreferences.GamesSelectionInactiveTopColor.Selected;
      EasyListViewHolder.Selection.InactiveGradientColorTop:= FormPreferences.GamesSelectionInactiveTopColor.Selected;
      EasyListViewHolder.Selection.InactiveGradientColorBottom:= FormPreferences.GamesSelectionInactiveBottomColor.Selected;
      EasyListViewHolder.Selection.InactiveBorderColor:=  FormPreferences.GamesSelectionInactiveFrameColor.Selected;
      EasyListViewHolder.Selection.InactiveTextColor:= FormPreferences.GamesSelectionInactiveFontColor.Selected;
                                                       // this doesn't work, call ELV_ItemPaintText_General() function instead
    end;
  end
  else
  begin
    // all other screens will use frontend's fixed colors from uCommon.pas
    EasyListViewHolder.Selection.Color:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionTopColor, FormPreferences.GamesSelectionMissROMsTopColor, True); // single color selection
    EasyListViewHolder.Selection.GradientColorTop:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionTopColor, FormPreferences.GamesSelectionMissROMsTopColor, True); // gradient top
    EasyListViewHolder.Selection.GradientColorBottom:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionBottomColor, FormPreferences.GamesSelectionMissROMsBottomColor, True); // gradient bottom
    EasyListViewHolder.Selection.BorderColor:= ELV_SelecionBar_GetColorState(State, FormPreferences.GamesSelectionFrameColor, FormPreferences.GamesSelectionMissROMsFrameColor, True); // frame color
    //EasyListViewHolder.Selection.TextColor:= clBlack; // this doesn't work, call ELV_ItemPaintText_General() function instead}


    {EasyListViewHolder.Selection.Color:= ListSelectionColors[0, State]; // single color selection
    EasyListViewHolder.Selection.GradientColorTop:= ListSelectionColors[1, State]; // gradient top
    EasyListViewHolder.Selection.GradientColorBottom:= ListSelectionColors[2, State]; // gradient bottom
    EasyListViewHolder.Selection.BorderColor:= ListSelectionColors[3, State];
    //EasyListViewHolder.Selection.TextColor:= clBlack; // this doesn't work, call ELV_ItemPaintText_General() function instead}

    EasyListViewHolder.Selection.InactiveColor:= FormPreferences.GamesSelectionInactiveTopColor.DefaultColorColor; //  ListSelectionColorInactive[0, State];
    EasyListViewHolder.Selection.InactiveGradientColorTop:= FormPreferences.GamesSelectionInactiveTopColor.DefaultColorColor;
    EasyListViewHolder.Selection.InactiveGradientColorBottom:= FormPreferences.GamesSelectionInactiveBottomColor.DefaultColorColor;
    EasyListViewHolder.Selection.InactiveBorderColor:= FormPreferences.GamesSelectionInactiveFrameColor.DefaultColorColor; // ListSelectionColorInactive[2, State];
    EasyListViewHolder.Selection.InactiveTextColor:= FormPreferences.GamesSelectionInactiveFontColor.DefaultColorColor; // ListSelectionColorInactive[3, State]; // this doesn't work, call ELV_ItemPaintText_General() function instead
  end;

  EasyListViewHolder.Selection.BlendColorSelRect:= EasyListViewHolder.Selection.BorderColor;
  EasyListViewHolder.Selection.BorderColorSelRect:= EasyListViewHolder.Selection.BorderColor;
end;

procedure TFormMain.ELV_ResetNormalColors(ELV_Holder: TEasyListView; UpdateSelection: Boolean = True);
begin
  ELV_SetSelectRibbon(0, ELV_Holder, True);
  if UpdateSelection and (ELV_Holder <> GamesListView) then
     begin
       if ELV_AllowSelectionBarUserColors(ELV_Holder) then
          begin
            ELV_Holder.Selection.Gradient:= GamesListView.Selection.Gradient;
            ELV_Holder.Selection.AlphaBlend:= GamesListView.Selection.AlphaBlend;
            ELV_Holder.Selection.RoundRect:= GamesListView.Selection.RoundRect;
          end;
     end;
end;

procedure TFormMain.ELV_SetRibbonNightColors(State: ShortInt; EasyListView_Source: TEasyListView; ForceUpdate: Boolean = False);
const                             //     0,75,150   185,50,0
  //ColorTop   : array[0..1] of TColor = ($00964b00, $000032b9);
  //                                //    5,100,195   200,50,5
  //ColorBottom: array[0..1] of TColor = ($00c36405, $000532c8);
  //                                //   68,139,210  215,100,70
  //ColorBorder: array[0..1] of TColor = ($00d28b44, $004664d7);

                                    //   8,8,78      78,8,8
  //ColorTop   : array[0..1] of TColor = ($004e0808, $0008084e);
  //                                //     8,8,12      12,8,8
  //ColorBottom: array[0..1] of TColor = ($000c0808, $0008080c);
  //ColorBorder: array[0..1] of TColor = (clNavy, clMaroon);
  
                                     //  8,8,120     120,8,8
  ColorTop   : array[0..1] of TColor = ($00780808, $00080878);
                                     //   8,8,78      78,8,8
  ColorBottom: array[0..1] of TColor = ($004e0808, $0008084e);
  ColorBorder: array[0..1] of TColor = (clNavy, clMaroon);
  
begin
  // state:
  //   0 -> game OK
  //   1 -> missing ROMs/CHDs
  //   2 -> missing (no ROMs found)
  if State = 2 then
     State:= 0; // set to zero since the selection ribbon for missing games is the same as "game OK"
  if (State = EasyListView_Source.HelpContext) and (not ForceUpdate) then
     Exit;

  EasyListView_Source.HelpContext:= State;

  EasyListView_Source.Selection.Color:= ColorTop[State]; // single color selection
  EasyListView_Source.Selection.GradientColorTop:= ColorTop[State]; // gradient top
  EasyListView_Source.Selection.GradientColorBottom:= ColorBottom[State]; // gradient bottom
  EasyListView_Source.Selection.BorderColor:= ColorBorder[State]; // frame color
  EasyListView_Source.Selection.TextColor:= clCream; // this doesn't work, call ELV_ItemPaintText_General() function instead}

  EasyListView_Source.Selection.InactiveColor:= $00444444; // RGB(68, 68, 68)
  EasyListView_Source.Selection.InactiveGradientColorTop:= $00444444; // RGB(68, 68, 68)
  EasyListView_Source.Selection.InactiveGradientColorBottom:= $004b4b4b; // RGB(75, 75, 75)
  EasyListView_Source.Selection.InactiveBorderColor:= $00505050; // RGB(80, 80, 80) $005a5a5a; // RGB(90, 90, 90)
  EasyListView_Source.Selection.InactiveTextColor:= clSilver;

  //EasyListView_Source.Selection.InactiveColor:= FormPreferences.GamesSelectionInactiveTopColor.DefaultColorColor; //  ListSelectionColorInactive[0, State];
  //EasyListView_Source.Selection.InactiveGradientColorTop:= FormPreferences.GamesSelectionInactiveTopColor.DefaultColorColor;
  //EasyListView_Source.Selection.InactiveGradientColorBottom:= FormPreferences.GamesSelectionInactiveBottomColor.DefaultColorColor;
  //EasyListView_Source.Selection.InactiveBorderColor:= FormPreferences.GamesSelectionInactiveFrameColor.DefaultColorColor; // ListSelectionColorInactive[2, State];
  //EasyListView_Source.Selection.InactiveTextColor:= FormPreferences.GamesSelectionInactiveFontColor.DefaultColorColor; // ListSelectionColorInactive[3, State]; // this doesn't work, call ELV_ItemPaintText_General() function instead

  EasyListView_Source.Selection.BlendColorSelRect:= EasyListView_Source.Selection.BorderColor;
  EasyListView_Source.Selection.BorderColorSelRect:= EasyListView_Source.Selection.BorderColor;
  EasyListView_Source.Selection.Gradient:= True;
  EasyListView_Source.Selection.AlphaBlend:= False;
  EasyListView_Source.Selection.RoundRect:= False;
end;

procedure TFormMain.ELV_SetNightModeColors(ELV_Source: TEasyListView; UpdateSelection: Boolean = True);
begin
  // set orange selection bar for the night mode
  ELV_Source.Selection.Color:= clrOrangeBarTop; // single color selection
  ELV_Source.Selection.GradientColorTop:= clrOrangeBarTop; // gradient top
  ELV_Source.Selection.GradientColorBottom:= clrOrangeBarBottom; // gradient bottom
  ELV_Source.Selection.BorderColor:= clrOrangeBarBorder; // frame color

  ELV_Source.Selection.InactiveColor:= $00444444; // RGB(68, 68, 68)
  ELV_Source.Selection.InactiveGradientColorTop:= $00444444; // RGB(68, 68, 68)
  ELV_Source.Selection.InactiveGradientColorBottom:= $004b4b4b; // RGB(75, 75, 75)
  ELV_Source.Selection.InactiveBorderColor:= $00505050; // RGB(80, 80, 80) $005a5a5a; // RGB(90, 90, 90)
  ELV_Source.Selection.InactiveTextColor:= clSilver;

