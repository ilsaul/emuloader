begin
  case FormPreferences.DisableNaturalSorting.Checked of
    True : Result:= AnsiCompareText(Item1, Item2);
    False: Result:= NaturalCompareText(Item1, Item2);
  end;
end;

function TFormMain.ELV_GetSortDirection(const ELV_Column: TEasyColumn; const Item1, Item2: TEasyItem; var DestItem1: TEasyItem; var DestItem2: TEasyItem): Boolean;
begin
  Result:= True;
  case ELV_Column.SortDirection of
    esdAscending:
      begin
        DestItem1:= Item1;
        DestItem2:= Item2;
      end;
    esdDescending:
      begin
        DestItem1:= Item2;
        DestItem2:= Item1;
      end;
  end;
end;

function TFormMain.GamesListViewItemCompare(Sender: TCustomEasyListview;
  Column: TEasyColumn; Group: TEasyGroup; Item1, Item2: TEasyItem;
  var DoDefault: Boolean): Integer;
var
  ResultMain, ResultClone: Integer;
  gItem1, gItem2: TEasyItem;
  sort1, sort2: Integer;

  function GetSortDirectionMulti: Boolean;
  begin
    Result:= True;
    case LastColumnSortDirection of
      esdAscending:
        begin
          gItem1:= Item2; // last clicked column
          gItem2:= Item1;
        end;
      esdDescending:
        begin
          gItem1:= Item1; // last clicked column
          gItem2:= Item2;
        end;
    end;
  end;

  function SortItemDetailsView(ColumnIndexToSort: Integer): Integer;
  begin
    case ColumnIndexToSort of
      00: Result:= iCompare(TEasyGameInfo(gItem1).eTitle, TEasyGameInfo(gItem2).eTitle);
      01: Result:= iCompare(TEasyGameInfo(gItem1).eYear, TEasyGameInfo(gItem2).eYear);
      02: Result:= iCompare(TEasyGameInfo(gItem1).eManufacturer, TEasyGameInfo(gItem2).eManufacturer);
      03: Result:= AnsiCompareText(aOrientation[TEasyGameInfo(gItem1).eScreenOrientation], aOrientation[TEasyGameInfo(gItem2).eScreenOrientation]);
      04: Result:= iCompare(TEasyGameInfo(gItem1).eScreenResolution, TEasyGameInfo(gItem2).eScreenResolution);
      05: Result:= iCompare(TEasyGameInfo(gItem1).eScreenRefreshRate, TEasyGameInfo(gItem2).eScreenRefreshRate);
      06: Result:= iCompare(TEasyGameInfo(gItem1).eCategory, TEasyGameInfo(gItem2).eCategory);
      07: Result:= AnsiCompareText(TEasyGameInfo(gItem1).eVersionAdded, TEasyGameInfo(gItem2).eVersionAdded);
      08: Result:= iCompare(TEasyGameInfo(gItem1).eName, TEasyGameInfo(gItem2).eName);
      09: Result:= iCompare(TEasyGameInfo(gItem1).eClone, TEasyGameInfo(gItem2).eClone);
      10: Result:= iCompare(TEasyGameInfo(gItem1).eDriverName, TEasyGameInfo(gItem2).eDriverName);
      11: Result:= iCompare(GetNumberPlayersInfo(TEasyGameInfo(gItem1).eNumberPlayers, TEasyGameInfo(gItem1).eNumberPlayersIni),
                            GetNumberPlayersInfo(TEasyGameInfo(gItem2).eNumberPlayers, TEasyGameInfo(gItem2).eNumberPlayersIni));
      12: Result:= AnsiCompareText(aStatus[TEasyGameInfo(gItem1).eDriverStatus], aStatus[TEasyGameInfo(gItem2).eDriverStatus]);
      13: Result:= AnsiCompareText(aStatus[TEasyGameInfo(gItem1).eEmulationStatus], aStatus[TEasyGameInfo(gItem2).eEmulationStatus]);
      14: Result:= AnsiCompareText(aStatus[TEasyGameInfo(gItem1).eColorStatus], aStatus[TEasyGameInfo(gItem2).eColorStatus]);
      15: Result:= AnsiCompareText(aStatus[TEasyGameInfo(gItem1).eSoundStatus], aStatus[TEasyGameInfo(gItem2).eSoundStatus]);
      16: Result:= AnsiCompareText(aStatus[TEasyGameInfo(gItem1).eGraphicStatus], aStatus[TEasyGameInfo(gItem2).eGraphicStatus]);
      17: Result:= CompareIntValue(TEasyGameInfo(gItem1).ePlayed, TEasyGameInfo(gItem2).ePlayed);
      18: Result:= AnsiCompareText(TEasyGameInfo(gItem1).eLanguage, TEasyGameInfo(gItem2).eLanguage);
      19: Result:= CompareIntValue(TEasyGameInfo(gItem1).eGameSize, TEasyGameInfo(gItem2).eGameSize);
      20: Result:= CompareIntValue(TEasyGameInfo(gItem1).ePlayedDate, TEasyGameInfo(gItem2).ePlayedDate);
      21: Result:= CompareIntValue(TEasyGameInfo(gItem1).eTotalPlaytime, TEasyGameInfo(gItem2).eTotalPlaytime);
      22: Result:= AnsiCompareText(TEasyGameInfo(gItem1).eSoftwareName, TEasyGameInfo(gItem2).eSoftwareName);
      23: Result:= CompareIntValue(Ord(TEasyGameInfo(gItem1).eIsSpecial), Ord(TEasyGameInfo(gItem2).eIsSpecial));
    end;
  end;

begin
  if IsDetailsView then
     begin
       DoDefault:= False;
       if not IsMultiColumnSort then
          begin
            ELV_GetSortDirection(Column, Item1, Item2, gItem1, gItem2);
            Result:= SortItemDetailsView(Column.Index);
          end
       else
          begin
            GetSortDirectionMulti;
            sort1:= SortItemDetailsView(Column.Index);
            ELV_GetSortDirection(Column, Item1, Item2, gItem1, gItem2);
            sort2:= SortItemDetailsView(LastColumnSorted);
            if sort1 > sort2 then
               Result:= 0
            else
            if sort1 < sort2 then
               Result:= 1
            else
               Result:= -1;
          end;
     end
  else
  if IsGroupedView then
     begin
       if Group.ItemCount > 1 then
          begin
            DoDefault:= False;
            ResultMain:= iCompare(TEasyGameInfo(Item1).eTitle, TEasyGameInfo(Item2).eTitle);
            ResultClone:= iCompare(TEasyGameInfo(Item1).eClone, TEasyGameInfo(Item2).eClone);
            if (GameIsClone(TEasyGameInfo(Item1).eClone) and GameIsClone(TEasyGameInfo(Item2).eClone)) then
               Result:= ResultMain
            else
            if GameIsClone(TEasyGameInfo(Item2).eClone) then
               Result:= ResultClone;
          end;
     end;
end;

