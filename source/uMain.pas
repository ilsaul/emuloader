    TEasyGameInfo(addItem).eGameSize:= TempGameVars.eGameSize;
    TEasyGameInfo(addItem).eGameSizeText:= TempGameVars.eGameSizeText;

    TEasyGameInfo(addItem).eSoftwareName:= TempGameVars.eSoftwareName;
    TEasyGameInfo(addItem).eSoftwareExecParameter:= TempGameVars.eSoftwareExecParameter;
    TEasyGameInfo(addItem).eSoftwareCompatible:= TempGameVars.eSoftwareCompatible;
    TEasyGameInfo(addItem).eSoftwareUsageTip:= TempGameVars.eSoftwareUsageTip;

    TEasyGameInfo(addItem).eGameSetStatus:= TempGameVars.eGameSetStatus;
    TEasyGameInfo(addItem).eScanMode:= TempGameVars.eScanMode;
    TEasyGameInfo(addItem).eIsMerged:= TempGameVars.eIsMerged;
    TEasyGameInfo(addItem).eCRC32Duplicates:= TempGameVars.eCRC32Duplicates;

    TEasyGameInfo(addItem).eIsSpecial:= TempGameVars.eIsSpecial;

    //TEasyGameInfo(addItem).eROMInfo:= TStringList.Create; // cannot create this here. do not remove this line, it's here to remind me about this comment

    if not TempGameVars.eIsCustomGame then
    begin
      if TempGameVars.eSoftwareName = '' then
      begin
        // only for MAME -listxml output; MAME software lists don't use device sets
        if AddDevicesList then
           begin
             TEasyGameInfo(addItem).eDeviceSets:= TStringList.Create;
             TEasyGameInfo(addItem).eDeviceSets.AddStrings(DeviceSetsTemp);
           end;
      end;

      if Assigned(tempSoftList) then
         begin
           if TempSoftList.Count > 0 then
              begin
                TempGameVars.eSystemType:= 1;
                TEasyGameInfo(addItem).eSystemType:= TempGameVars.eSystemType; // force system type as non-arcade if there are softwarename entries
                SetLength(TEasyGameInfo(addItem).fSoftwareList, tempSoftList.Count);

                TEasyGameInfo(addItem).eSoftwareList:= TEasyGameInfo(addItem).fSoftwareList;
                for LoopSoft:=0 to TempSoftList.Count-1 do
                    TEasyGameInfo(addItem).eSoftwareList[LoopSoft]:= tempSoftList[LoopSoft];

                // for debugging only, do not remove (February 16, 2018)
                //ShowMessageW(tempSoftList.Text);
                //ShowMessage('gamename: '+TempGameVars.eName+#13#10+#13#10+sList+#13#10+#13#10+
                //            'SizeOf: '+IntToStr(SizeOf(TEasyGameInfo(addItem).eSoftwareList))+#13#10+
                //            'Length: '+IntToStr(Length(TEasyGameInfo(addItem).eSoftwareList)));
              end;
         end;
      LoadROMsDatabase(addItem, TempGameVars.eSystemID, LoadedROMsSysID, TempGameVars.eName, TempGameVars.eSoftwareName, LoadedROMsSoftwareList, ROMsTemp);
      if IsMAMEBasedSys(TempGameVars.eSystemID) then
         begin
           if FormMain.GameIsClone(TempGameVars.eClone) then
              TEasyGameInfo(addItem).eParentGameROMsNoDump:= IsParentSetROMsNoDump
           else
              IsParentSetROMsNoDump:= TEasyGameInfo(addItem).eGameROMsNoDump;
         end;
    end;

    addItem.Details[1]:= 50; // 50 is a bogus column index so texts in tile view mode can be shown
  end;

begin
  if ValidateFile(GetFavoritesFile) then
     begin
       FavList:= THashedStringList.Create;
       FavList.LoadFromFile(GetFavoritesFile);
       if FavList.Count = 0 then
          FreeAndNil(FavList);
     end;

  if ValidateFile(GetSpecialFile) then
     begin
       SpecialList:= THashedStringList.Create;
       SpecialList.LoadFromFile(GetSpecialFile);
       if SpecialList.Count = 0 then
          FreeAndNil(SpecialList);
     end;

  for Loop:= Low(MAMESoftListCustomSystems) to High(MAMESoftListCustomSystems) do
      MAMESoftListCustomSystems[Loop]:= THashedStringList.Create;
  tStr:= GetSystemsSoftwareListFile(idMAME);
  if FileExists(tStr) then
     begin
       CategoriesList:= TMemIniFile.Create(tStr);
       for Loop:= Low(MAMESoftListCustomSystems) to High(MAMESoftListCustomSystems) do
           CategoriesList.ReadSectionValues(SystemsListCustom[Loop, 0], MAMESoftListCustomSystems[Loop]);
       FreeAndNil(CategoriesList);
     end;
  tStr:= '';

  if FileExists(GetFolderFull(43)+'catver.ini') then
     CategoriesList:= TMemIniFile.Create(GetFolderFull(43)+'catver.ini'); // MAME only

  if FileExists(GetFolderFull(43)+'nplayers.ini') then
     begin
       iniNumPlayers:= THashedStringList.Create;
       iniNumPlayers.LoadFromFile(GetFolderFull(43)+'nplayers.ini');
     end;

  if FileExists(GetMainCPUFile(idMAME)) then
     begin
       GameCPU_MAME:= THashedStringList.Create;
       GameCPU_MAME.LoadFromFile(GetMainCPUFile(idMAME));
     end;
  if FileExists(GetMainCPUFile(idHBMAME)) then
     begin
       GameCPU_HBMAME:= THashedStringList.Create;
       GameCPU_HBMAME.LoadFromFile(GetMainCPUFile(idHBMAME));
     end;

  LoadLanguagesList(LanguagesList); // load languages from languages.ini into a HashedStringList "gamename=language"
  LoadControlTypeList; // reload control type list into memory, just in case

  if FileExists(GetGamesFolderEL+GetSystemFileName(idMAME, 5)) then
     begin
       SoftwareListMESS:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(idMAME, 5));
       tempSoftList:= THashedStringList.Create;
     end;

  // MAME: category.ini; version.ini; mature.ini (required since "category.ini" doesn't have adult / mature categories
  LoadCategoryMESS(CategoryAntoPISA, VersionAntoPISA, False); // load category from category.ini into a HashedStringList "gamename=category" (AntoPISA, full sets arcade/non-arcade MAME 0.171 forward)
                                                              // load version from version.ini into a HashedStringList "gamename=version" (AntoPISA, full sets arcade/non-arcade MAME 0.171 forward)

  // HBMAME: category_hb.ini; version_hb.ini
  LoadCategoryMESS(CategoryHBMAME, VersionInfoHBMAME, True); // load category from category_hb.ini into a HashedStringList "gamename=category" (AntoPISA, full sets HBMAME)
                                                             // load version from version_hb.ini into a HashedStringList "gamename=version" (AntoPISA, full sets HBMAME)

  if FileExists(GetFolderFull(43)+'mess.ini') then
     begin
      // AntoPISA file listing non-arcade machines, require to filter out non-arcade machines
      // Require MAME 0.171 or newer to work; older MAME builds are no longer supported
      NonArcadeMESSIni:= THashedStringList.Create;
      NonArcadeMESSIni.LoadFromFile(GetFolderFull(43)+'mess.ini');
     end;

  //if Assigned(CategoryAntoPISA) then ShowMessage(CategoryAntoPISA.Text); // for debugging
  //if Assigned(VersionAntoPISA) then ShowMessage(VersionAntoPISA.Text);   // for debugging

  reqCount:= 0;
  requirementList:= TStringList.Create;
  requirementList.BeginUpdate;

  // Initialize virtual data
  SoftwareListMsgActive:= False;
  CustomGamesMsgActive:= False;

  PlayedArcadeSysID:= -1; // for played games arcade
  PlayedCustomSysID:= -1; // for played games EmuCon
  CustomGameExtraInfoSysID:= -1; // for extra info games EmuCon

  LoadedROMsSysID:= -1;
  LoadedROMsSoftwareList:= '';
  DeviceSysID:= -1;
  ROMsTemp:= TStringList.Create;
  DeviceSetsTemp:= TStringList.Create;
  GamesListView.BeginUpdate;
  GamesListView.Items.ReIndexDisable:= True;

  for Loop:=0 to CompleteGamesList.Count-1 do
  begin
    ClearMemGameInfo(TempGameVars);
    TempGameVars.eIsCustomGame:= PosEx('<file>', CompleteGamesList[Loop]) <> 0;
    if not TempGameVars.eIsCustomGame then
    begin
      case GetROMFields(CompleteGamesList, Loop) of
        True:
          begin
            if TempGameVars.eSystemID = idDaphne then
               TempGameVars.eArcadeCHDMediaType:= 15; // 15 -> Game CD
            tStr:= SoftListGetEntryValue(CompleteGamesList[Loop], 'requirement');
            if tStr <> '' then
               begin
                 requirementList.Add(TempGameVars.eSoftwareName+'\'+TempGameVars.eName+'='+tStr);
                 Inc(reqCount);
               end;
            if TempGameVars.eSoftwareName <> '' then
               begin
                 if not SoftwareListMsgActive then
                    begin
                      SoftwareListMsgActive:= True;
                      FormStatus.MessageStr('Adding software games to games list.');
                    end;
               end;

            if TempGameVars.eSoftwareUsageTip <> '' then
               TempGameVars.eSoftwareUsageTip:= DecodeUnicodeStr(TempGameVars.eSoftwareUsageTip);

            if TempGameVars.eSoftwareName <> '' then
               begin
                 TempGameVars.eTitle:= FixUnicodeGameTitle(TempGameVars.eTitle); // mostly for MSX games (AlphaRoid, Alpha Squadron)
                 TempGameVars.eManufacturer:= DecodeUnicodeStr(TempGameVars.eManufacturer);

                 GetSoftListCustomSystemID(TempGameVars.eSoftwareName);
                 TempGameVars.eCustomMediaType:= GetCustomMediaTypeID(TempGameVars.eSoftwareExecParameter, TempGameVars.eSoftwareName);
               end;
            TempGameVars.eTitle:= DecodeUnicodeStr(TempGameVars.eTitle);

            TempGameVars.eImageIndex:= TempGameVars.eROMIdentification;
            SetDescriptionFormat(True);

            if TempGameVars.eSoftwareName = '' then
            begin
              // not for software list games, only MAME -listxml and other arcade emulators
              // arcade emulators and MAME arcade games from -listxml do NOT have software list entries
              if IsMAMEBasedSys(TempGameVars.eSystemID) then
                 begin
                   if not FormMain.GameIsClone(TempGameVars.eClone) then
                      IsParentSetROMsNoDump:= False;

                   if TempGameVars.eSystemID = idHBMAME then
                      begin
                        if Assigned(CategoryHBMAME) then
                           TempGameVars.eCategory:= CategoryHBMAME.Values[TempGameVars.eName];

                        if Assigned(VersionInfoHBMAME) then
                           TempGameVars.eVersionAdded:= VersionInfoHBMAME.Values[TempGameVars.eName];
                      end;

                   if TempGameVars.eCategory = '' then
                      begin
                        if Assigned(CategoryAntoPISA) then
                           TempGameVars.eCategory:= CategoryAntoPISA.Values[TempGameVars.eName];
                      end;
                   if TempGameVars.eVersionAdded = '' then
                      begin
                        if Assigned(VersionAntoPISA) then
                           TempGameVars.eVersionAdded:= VersionAntoPISA.Values[TempGameVars.eName];
                      end;
                   if Assigned(NonArcadeMESSIni) then
                      begin
                        if NonArcadeMESSIni.IndexOf(TempGameVars.eName) <> -1 then
                           TempGameVars.eSystemType:= 1; // set to MAME machine if AntoPISA 'mess.ini' is loaded and its game name is found
                           // eSystemType is for games filtering only, selecting games don't T need to use SystemType
                      end;
                 end;

              if Assigned(CategoriesList) then
                 begin
                   if TempGameVars.eCategory = '' then
                      begin
                        if not (TempGameVars.eSystemID in [idDaphne, idDice]) then
                           TempGameVars.eCategory:= CategoriesList.ReadString('Category', TempGameVars.eName, '');
                      end;
                   if IsMAMEBasedSys(TempGameVars.eSystemID) and (TempGameVars.eVersionAdded = '') then
                      TempGameVars.eVersionAdded:= CategoriesList.ReadString('VerAdded', TempGameVars.eName, '');
                 end;

              if TempGameVars.eCategory <> '' then
                 TempGameVars.eCategory:= DecodeUnicodeStr(TempGameVars.eCategory);

              if not (TempGameVars.eSystemID in [idDaphne, idDICE]) then
              begin
                if Assigned(iniNumPlayers) then
                   TempGameVars.eNumberPlayersIni:= iniNumPlayers.Values[TempGameVars.eName];

                if Assigned(LanguagesList) then
                   TempGameVars.eLanguage:= LanguagesList.Values[TempGameVars.eName];
                if TempGameVars.eLanguage <> '' then
                   TempGameVars.eLanguage:= DecodeUnicodeStr(TempGameVars.eLanguage);
              end;

              if TempGameVars.eVersionAdded <> '' then
                 TempGameVars.eVersionAdded:= FixVersionInfoColumn(TempGameVars.eVersionAdded, FormPreferences.AddLeadingZeroVersionInfoMAME.Checked);
                 //begin
                 //  if TempGameVars.eVersionAdded[1] = '.' then
                 //     TempGameVars.eVersionAdded:= '0'+TempGameVars.eVersionAdded;
                 //end;

              case TempGameVars.eSystemID of
                idMAME:
                  begin
                    if Assigned(GameCPU_MAME) then
                       TempGameVars.eChipCPU:= GameCPU_MAME.Values[TempGameVars.eName];
                  end;
                idHBMAME:
                  begin
                    if Assigned(GameCPU_HBMAME) then
                       TempGameVars.eChipCPU:= GameCPU_HBMAME.Values[TempGameVars.eName];
                  end;
              end;

              LoadCRC32CollisionFile(TempGameVars.eSystemID);
              if Assigned(CRC32CollisionGames) then
                 begin
                   if CRC32Count < CRC32CollisionGames.Count then
                      begin
                        TempGameVars.eCRC32Duplicates:= CRC32CollisionGames.IndexOf(TempGameVars.eName) <> -1;
                        if TempGameVars.eCRC32Duplicates then
                           Inc(CRC32Count); // this var is to stop CRC32 collision continuous check after all sets were processed (for speed!)
                      end;
                 end;
            end;
            
            if Assigned(FavList) then
               begin
                 // games from software lists format is: gamename_softlistname=system_name (MAME/HBMAME)
                 TempGameVars.eIsFavorite:= FavList.IndexOf(GetPlayedGamesNameEntry(TempGameVars.eName, TempGameVars.eSoftwareName)+'='+GetArcadeSystemIniSection(TempGameVars.eSystemID, True)) <> -1;
               end;

            if Assigned(SpecialList) then
               begin
                 // same format as favorites file
                 TempGameVars.eIsSpecial:= SpecialList.IndexOf(GetPlayedGamesNameEntry(TempGameVars.eName, TempGameVars.eSoftwareName)+'='+GetArcadeSystemIniSection(TempGameVars.eSystemID, True)) <> -1;
               end;

            LoadPlayedFileArcade(TempGameVars.eSystemID);
            if Assigned(PlayedListArcadeGames) then
               begin
                 tStr:= PlayedListArcadeGames.Values[GetPlayedGamesNameEntry(TempGameVars.eName, TempGameVars.eSoftwareName)];
                 GetPlayedGameInfoIni(tStr, TempGameVars.ePlayed, TempGameVars.ePlayedDate, TempGameVars.eTotalPlaytime);
               end;
            if TempGameVars.ePlayedDate <> 0 then
               TempGameVars.ePlayedDateText:= GetDateTimeStr(TempGameVars.ePlayedDate, True, FormPreferences.LastPlayedHideSeconds.Checked);
            if TempGameVars.eTotalPlaytime <> 0 then
               TempGameVars.eTotalPlaytimeText:= GetPlayTime(TempGameVars.eTotalPlaytime, True, FormPreferences.TotalPlayTimeHideSeconds.Checked);

            if TempGameVars.eGameSize <> 0 then
               TempGameVars.eGameSizeText:= GetSizeType(TempGameVars.eGameSize, False)
            else
               TempGameVars.eGameSizeText:= '';

            if TempGameVars.eSoftwareName = '' then
            begin
              // get softwarelist files for each MAME machine
              if Assigned(SoftwareListMESS) then
                 begin
                   tempSoftList.Clear; // might not be needed as it's cleaned in .ReadSectionValues;
                   SoftwareListMESS.ReadSectionValues(TempGameVars.eName, tempSoftList);
                 end;
            end;

            AddGameListView;
          end;
        False:
          begin
            if IsGroupedView then
               begin
                 // ListView grouped mode only
                 TempGameVars.eTitle:= 'Game Info Parse Error!';
                 AddGameListView;
               end;
            GenerateMessage('Error', 'Load games list.', '    Failed to parse game info.'+#13#10+#13#10+CompleteGamesList[Loop], 1, False, 1);
          end;
      end;
    end
    else
    begin
      // games from EmuCon
      if not CustomGamesMsgActive then
         begin
           CustomGamesMsgActive:= True;
           FormStatus.MessageStr('Adding EmuCon games to games list.');
         end;
      GetCustomGameFields(CompleteGamesList[Loop]);
      TempGameVars.eGameSetStatus:= 0; // set to Good status (available game)
      TempGameVars.eHaveGameROMs:= 0;
      TempGameVars.eROMsAllNoDump:= False;

      LoadPlayedFileCustom(TempGameVars.eCustomSystemID);
      if Assigned(PlayedListCustomGames) then
         begin
           iPos:= GetPlayedGamePosIndex(PlayedListCustomGames, TempGameVars.eName, TempGameVars.eCustomMediaType, TempGameVars.eIsUnicode);
           //iStr:= iStr+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eCustomMediaType)+IntToStr(Ord(TEasyGameInfo(ELV_ItemToUpdate).eIsUnicode))+' ';

           if iPos <> -1 then
              begin
                tStr:= PlayedListCustomGames[iPos];
                GetPlayedGameInfoIniCustom(tStr, TempGameVars.ePlayed, TempGameVars.ePlayedDate, TempGameVars.eTotalPlaytime);
              end;
         end;

      if Assigned(FavList) then
         begin
           tStr:= Format('%.3u %u', [TempGameVars.eCustomSystemID, TempGameVars.eCustomMediaType])+' <file>'+TempGameVars.eName;
           TempGameVars.eIsFavorite:= FavList.IndexOf(tStr) <> -1;
         end;

      if Assigned(SpecialList) then
         begin
           // same format as favorites file
           tStr:= Format('%.3u %u', [TempGameVars.eCustomSystemID, TempGameVars.eCustomMediaType])+' <file>'+TempGameVars.eName;
           TempGameVars.eIsSpecial:= SpecialList.IndexOf(tStr) <> -1;
         end;

      if TempGameVars.ePlayedDate <> 0 then
         TempGameVars.ePlayedDateText:= GetDateTimeStr(TempGameVars.ePlayedDate, True, FormPreferences.LastPlayedHideSeconds.Checked);
      if TempGameVars.eTotalPlaytime <> 0 then
         TempGameVars.eTotalPlaytimeText:= GetPlayTime(TempGameVars.eTotalPlaytime, True, FormPreferences.TotalPlayTimeHideSeconds.Checked);

      if TempGameVars.eGameSize <> 0 then
         TempGameVars.eGameSizeText:= GetSizeType(TempGameVars.eGameSize, (TempGameVars.eCustomMediaType = 1))
      else
         TempGameVars.eGameSizeText:= '';

      LoadCustomGameExtraInfoFile(TempGameVars.eCustomSystemID);
      if Assigned(CustomGamesExtraInfo) then
         begin
           iPos:= GetCustomGamePosExtraInfoIndex(CustomGamesExtraInfo, TempGameVars.eName, TempGameVars.eCustomMediaType, TempGameVars.eIsUnicode);
           if iPos <> -1 then
              begin
                tStr:= CustomGamesExtraInfo[iPos];
                GetCustomGameExtraFields(tStr, True);
              end;
         end;

      if TempGameVars.eIsUnicode then
         begin
           TempGameVars.eName:= DecodeUnicodeStr(TempGameVars.eName);
           TempGameVars.eTitle:= DecodeUnicodeStr(TempGameVars.eTitle);
         end;

      tStr:= SystemsListCustom[TempGameVars.eCustomSystemID, 0];
      case TempGameVars.eCustomSystemID of
        14: tStr:= 'Atari 5200';
        48: tStr:= 'Atari 800';
      end;

      TempGameVars.eCategory:= tStr+' '+MediaTypeCustom[TempGameVars.eCustomMediaType, 0];

      AddGameListView;
    end;
    Application.ProcessMessages;
  end;

  requirementList.EndUpdate;
  //if reqCount > 0 then // for debugging only, do not enable (March 28, 2018)
  //   begin
  //     requirementList.SaveToFile(FrontendPath+'softlist-requirement-list.txt');
  //     ShowMessage('requirement count: '+IntToStr(reqCount));
  //   end;
  FreeAndNil(requirementList);
  FreeAndNil(CategoriesList);
  FreeAndNil(iniNumPlayers);
  FreeAndNil(GameCPU_MAME);
  FreeAndNil(GameCPU_HBMAME);

  FreeAndNil(LanguagesList);
  FreeandNil(CategoryAntoPISA);
  FreeAndNil(VersionAntoPISA);
  FreeAndNil(NonArcadeMESSIni);

  FreeAndNil(CategoryHBMAME);
  FreeAndNil(VersionInfoHBMAME);

  FreeAndNil(FavList);
  FreeAndNil(SpecialList);
  FreeandNil(tempSoftList);
  FreeAndNil(SoftwareListMESS);
  FreeAndNil(ROMsTemp);
  FreeAndNil(DeviceSets);
  FreeAndNil(DeviceSetsTemp);
  FreeAndNil(ListROMs);

  FreeAndNil(PlayedListArcadeGames); // for arcade games
  FreeAndNil(CRC32CollisionGames);   // for arcade games, excludes MAME software lists as well

  FreeAndNil(PlayedListCustomGames); // for EmuCon games
  FreeAndNil(CustomGamesExtraInfo);  // for EmuCon games

  for Loop:= Low(MAMESoftListCustomSystems) to High(MAMESoftListCustomSystems) do
      FreeAndNil(MAMESoftListCustomSystems[Loop]);

  if IsGroupedView then
     ELV_RemoveDefaultGroup(GamesListView);
  FixSortTitle(GamesListView.Header.Columns.Columns[LastColumnSorted]);
  GamesListView.Sort.SortAll;
  GamesListView.Items.ReIndexDisable:= False;

  GamesListView.EndUpdate(False);
  //if FirstGroupIndex <> -1 then // for debugging, trying to get a TEasyGroup location using .index instead of the actual TEasyGroup variable...
                                  // seems to be working (load grouped view mode without adding parents + clones (can add a clone games first and then the parent game)
  //   ShowMessage('Title: '+TGroupInfo(GamesListView.Groups[FirstGroupIndex]).eTitle+#13#10+
  //               'Name: '+TGroupInfo(GamesListView.Groups[FirstGroupIndex]).eName+#13#10+
  //               'Manufacturer: '+TGroupInfo(GamesListView.Groups[FirstGroupIndex]).eManufacturer);
end;

procedure TFormMain.ReloadCustomSystemsMAMESoftLists;
var
  SoftListCustomSystems: array[1..MaxConsoleComputerSystems] of THashedStringList;
  iCatFile: TMemIniFile;
  Group: TEasyGroup;
  Item: TEasyItem;
  Loop: Integer;
  tStr: String;

  function GetSoftListCustomSystemID(const SoftwareName: String): Integer;
  var
    iSoftLoop: Integer;
  begin
    Result:= -1;
    for iSoftLoop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
    begin
      Result:= SoftListCustomSystems[iSoftLoop].IndexOf(SoftwareName);
      if Result <> -1 then
         begin
           TEasyGameInfo(Item).eCustomSystemID:= iSoftLoop;
           Break;
         end;
    end;
  end;

  function SearchCustomData: Boolean;
  begin
    Result:= (TEasyGameInfo(Item).eSystemID = idMAME) and (TEasyGameInfo(Item).eSoftwareName <> '');
    if not Result then
       Exit;
    TEasyGameInfo(Item).eCustomSystemID:= -1; // reset to "none"
    GetSoftListCustomSystemID(TEasyGameInfo(Item).eSoftwareName);
    TEasyGameInfo(Item).eCustomMediaType:= GetCustomMediaTypeID(TEasyGameInfo(Item).eSoftwareExecParameter, TEasyGameInfo(Item).eSoftwareName);
  end;
  
begin
  if not CheckTotal(GamesListView) then
     Exit;

  for Loop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
      SoftListCustomSystems[Loop]:= THashedStringList.Create;
  tStr:= GetSystemsSoftwareListFile(idMAME);
  if FileExists(tStr) then
     begin
       iCatFile:= TMemIniFile.Create(tStr);
       for Loop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
           iCatFile.ReadSectionValues(SystemsListCustom[Loop, 0], SoftListCustomSystems[Loop]);
       FreeAndNil(iCatFile);
     end;

  GamesListView.BeginUpdate;
  GamesListView.Items.ReIndexDisable:= True;

  if IsGroupedView then
    begin
      Group:= GamesListView.Groups.FirstGroup;
      repeat
        if (TGroupInfo(Group).eSystemID = idMAME) and (TGroupInfo(Group).eSoftwareName = '') then
        begin
          Item:= GamesListView.Groups.FirstInGroup(Group);
          repeat
            SearchCustomData;
            Item:= GamesListView.Groups.NextInGroup(Group, Item);
          until Item = nil;
        end;
        Group:= GamesListView.Groups.NextGroup(Group);
      until Group = nil;
    end
    else
    begin
      Item:= GamesListView.Groups.FirstItem;
      repeat
        SearchCustomData;
        Item:= GamesListView.Groups.NextItem(Item);
      until Item = nil;
    end;

  GamesListView.Items.ReIndexDisable:= False;
  GamesListView.EndUpdate(False);

  for Loop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
      FreeAndNil(SoftListCustomSystems[Loop]);
end;

procedure TFormMain.LoadListCPU(BoxHolder: TComboBox2Ex);
var
  GameCPU_MAME, ListCPU, SortedList: THashedStringList;
  Loop: Integer;
  tmpString, StrCPU: String;
begin
  if (not FileExists(GetMainCPUFile(idMAME))) and (not FileExists(GetMainCPUFile(idHBMAME))) then
     Exit;

  ListCPU:= THashedStringList.Create;
  ListCPU.BeginUpdate;

  GameCPU_MAME:= THashedStringList.Create;
  if FileExists(GetMainCPUFile(idMAME)) then
     begin
       GameCPU_MAME.LoadFromFile(GetMainCPUFile(idMAME));
       ListCPU.AddStrings(GameCPU_MAME);
       GameCPU_MAME.Clear;
     end;
  if FileExists(GetMainCPUFile(idHBMAME)) then
     begin
       GameCPU_MAME.LoadFromFile(GetMainCPUFile(idHBMAME));
       ListCPU.AddStrings(GameCPU_MAME);
       GameCPU_MAME.Clear;
     end;
  ListCPU.EndUpdate;

  FreeAndNil(GameCPU_MAME);

  if ListCPU.Count = 0 then
     begin
       FreeAndNil(ListCPU);
       Exit;
     end;
  SortedList:= THashedStringList.Create;
  SortedList.BeginUpdate;
  for Loop:=0 to ListCPU.Count-1 do
  begin
    tmpString:= ListCPU[Loop];
    if tmpString <> '' then
       begin
         StrCPU:= ListCPU.ValueFromIndex[Loop];
         if SortedList.IndexOf(StrCPU) = -1 then
            SortedList.Add(StrCPU);
       end;

  end;
  SortedList.Sort;
  SortedList.EndUpdate;
  FreeAndNil(ListCPU);
  if SortedList.Count > 0 then
     begin
       BoxHolder.Items.BeginUpdate;
       BoxHolder.Clear;
       BoxHolder.Items.Add('[None]');
       BoxHolder.Items.AddStrings(SortedList);
       BoxHolder.Items.EndUpdate;
       BoxHolder.ItemIndex:= 0;

     end;
  FreeAndNil(SortedList);
end;

{procedure ComboBox_AutoWidth(const theComboBox: TCombobox);
const
  HORIZONTAL_PADDING = 4;
var
  itemsFullWidth: integer;
  idx: integer;
  itemWidth: integer;
begin
  itemsFullWidth := 0;

  // get the max needed with of the items in dropdown state
  for idx := 0 to -1 + theComboBox.Items.Count do
  begin
    itemWidth := theComboBox.Canvas.TextWidth(theComboBox.Items[idx]);
    Inc(itemWidth, 2 * HORIZONTAL_PADDING);
    if (itemWidth > itemsFullWidth) then itemsFullWidth := itemWidth;
  end;

  // set the width of drop down if needed
  if (itemsFullWidth > theComboBox.Width) then
  begin
    //check if there would be a scroll bar
    if theComboBox.DropDownCount < theComboBox.Items.Count then
      itemsFullWidth := itemsFullWidth + GetSystemMetrics(SM_CXVSCROLL);

    SendMessage(theComboBox.Handle, CB_SETDROPPEDWIDTH, itemsFullWidth, 0);
  end;
end;}

function TFormMain.CheckGameControlType(sysID: ShortInt; const ControlsStrHolder, ControlName, SoftwareName: String; ButtonsCount: Byte): Boolean;
begin
  // this is used in uMain.ApplyFilters; function only.
  // FormFiltersExtra Controls filter is not automatically executed in extra filters or machines side list filter.
  // this is necessary so the search bar "controls" filter is not executed along with the controls filter in FormFiltersExtra

  // this function is only called inside uMain.ApplyFilters; function (other filter calls might use this function)...
  Result:= False;
  case SameText('none', ControlName) of
    True:
      begin
        // user selected "(none or empty)" control, only valid if eControls var is empty
        if (ControlsStrHolder = '') and (SoftwareName = '') and (ButtonsCount = 0) then
           Result:= True;
      end;
    False:
      begin
        if PosEx(ControlName, ControlsStrHolder) <> 0 then
           Result:= True;
      end;
  end;
end;

procedure TFormMain.UpdateStatusBarGame;
var
  UpdateIconDriverStatus: Boolean;

  function UpdateDrvStatusIconTag(NewStatusIndex: Integer): Boolean;
  var
    UpdateStatusID: Integer;
  begin
    // -1 -> none; 0 -> Good; 1 -> Imperfect; 2 -> Preliminary
    //AddDefaultIcons('scanresult_ok.ico', tempFolder, IL_LeftPanel);        // 0
    //AddDefaultIcons('scanresult_notfound.ico', tempFolder, IL_LeftPanel);  // 1
    //AddDefaultIcons('scanresult_badcrc.ico', tempFolder, IL_LeftPanel);    // 2
    //AddDefaultIcons('scanresult_missroms.ico', tempFolder, IL_LeftPanel);  // 3

    case NewStatusIndex of
     -1: UpdateStatusID:= -1;
      0: UpdateStatusID:= 0;
      1: UpdateStatusID:= 3;
      2: UpdateStatusID:= 2;
    end;
    Result:= (IconDriverStatus.Tag <> UpdateStatusID);
    if Result then
       IconDriverStatus.Tag:= UpdateStatusID;
  end;

begin
  if not StatusBarPanel.Visible then
     Exit;
  if not CheckSelected(GamesListView) then
     begin
       StatusBar_GamesGameName.Caption:= '';
       IconGameStatus.Picture.Icon:= nil;
       IconDriverStatus.Picture.Icon:= nil;
       IconGameMediaType.Picture.Icon:= nil;
       Exit;
     end;
  // IconGameStatus -> 0 -> have; 1 -> have with missing ROMs/CHDs; 2 -> miss
  if IconGameStatus.Picture.Icon.Empty then
     IconGameStatus.Tag:= -1;

  if IconDriverStatus.Picture.Icon.Empty then
     IconDriverStatus.Tag:= -1;

  if IconGameMediaType.Picture.Icon.Empty then
     IconGameMediaType.Tag:= 0;

  UpdateIconDriverStatus:= UpdateDrvStatusIconTag(MemGameInfo.eDriverStatus);

  if UpdateIconDriverStatus then
     IL_LeftPanel.GetIcon(IconDriverStatus.Tag, IconDriverStatus.Picture.Icon);

  case MemGameInfo.eIsCustomGame of
    True : IL_StandardIconsSmall.GetIcon(MaxGameID+MemGameInfo.eCustomSystemID, IconGameStatus.Picture.Icon);
    False: IL_StandardIconsSmall.GetIcon(GetMAMEImageIndex(MemGameInfo.eROMIdentification, MemGameInfo.eSoftwareName), IconGameStatus.Picture.Icon);
  end;

  GetMediaTypeIconMsgBox(MemGameInfo.eCustomMediaType, MemGameInfo.eIsCustomGame, MemGameInfo.eMediaType, MemGameInfo.eArcadeCHDMediaType, IconGameMediaType,
                         MemGameInfo.eSoftwareExecParameter, MemGameInfo.eSoftwareName);

  // original code for the driver status icon (March 01, 2018)
  //if UpdateIconStatus then
  //   IL_LeftPanel.GetIcon(IconGameStatus.Tag, IconGameStatus.Picture.Icon);

  StatusBar_GamesGameName.Canvas.Lock;
  case GameIsClone(MemGameInfo.eClone) of
    True : StatusBar_GamesGameName.Caption:= MemGameInfo.eName+' [clone of '+MemGameInfo.eClone+']';
    False: StatusBar_GamesGameName.Caption:= MemGameInfo.eName;
  end;
  if ValidateBiosName(MemGameInfo.eBiosName, MemGameInfo.eName) then
     StatusBar_GamesGameName.Caption:= StatusBar_GamesGameName.Caption+' [bios '+MemGameInfo.eBiosName+']';

  if MemGameInfo.eSoftwareName <> '' then             //  change this to [software n64: Nintendo 64]
     StatusBar_GamesGameName.Caption:= StatusBar_GamesGameName.Caption+' [software '+MemGameInfo.eSoftwareName+']';

  if MemGameInfo.eIsMerged then
     StatusBar_GamesGameName.Caption:= StatusBar_GamesGameName.Caption+' [merged]';

  StatusBar_GamesGameName.Canvas.UnLock;
end;

