procedure TFormMain.ReadVideoPreviewIni(LoadMediaPlayerSettings, LoadMediaPlayerParameters, LoadDummyParameters: Boolean);
var
  INIFile: TMemIniFile;
  Loop: Byte;
  videoFile, iParameters: String;
  //SectionFound: Boolean;
begin
  try
    INIFile:= TMemIniFile.Create(GetIniFilesFolder+'videopreview.ini');
    if LoadMediaPlayerSettings then
       begin
         for Loop:= 1 to MaxArcadeSystems do
             VideoPreviewDir[Loop]:= INIFile.ReadString('Folders', GetSystemIniSection(Loop, True), '');
         FormPreferences.VideoPreviewMediaPlayerExecutable.Text:= INIFile.ReadString('MediaPlayer', 'File', '');
         FormPreferences.VideoPreviewEnabled.Checked:= Boolean(INIFile.ReadInteger('MediaPlayer', 'Enabled', 1));
         FormPreferences.VideoPreviewAutoPlay.Checked:= Boolean(INIFile.ReadInteger('MediaPlayer', 'AutoPlay', 0));
         FormPreferences.VideoPreviewParentGameVideo.Checked:= Boolean(INIFile.ReadInteger('MediaPlayer', 'ParentGameVideo', 0));
         FormPreferences.VideoPreviewPlayDummyVideo.Checked:= Boolean(INIFile.ReadInteger('MediaPlayer', 'PlayDummyVideo', 0));
       end;

    if LoadMediaPlayerParameters then
    begin
      VideoFile:= FormPreferences.VideoPreviewMediaPlayerExecutable.Text;
      if VideoFile <> '' then
         VideoFile:= ExtractFileName(VideoFile);
      if VideoFile <> '' then
         begin
           iParameters:= INIFile.ReadString('Parameters', VideoFile, '');
           if iParameters = '' then
              iParameters:= '%1'
           else
              begin
                if PosEx('%1', iParameters) = 0 then
                   iParameters:= '%1 '+iParameters;
              end;
           iParameters:= StringReplace(iParameters, '"%1"', '%1', [rfIgnoreCase]);
           FormPreferences.VideoPreviewMediaPlayerParameters.Text:= iParameters;
         end;
    end;

    if LoadDummyParameters then
    begin
      FormPreferences.VideoPreviewDummyVideoParameters.Text:= INIFile.ReadString('MediaPlayer', 'DummyVideoParameters', '');
         if FormPreferences.VideoPreviewDummyVideoParameters.Text <> '' then
         begin
           if PosEx('"%1"', FormPreferences.VideoPreviewDummyVideoParameters.Text) <> 0 then
              FormPreferences.VideoPreviewDummyVideoParameters.Text:= StringReplace(FormPreferences.VideoPreviewDummyVideoParameters.Text,
                                                                      '"%1"', '%1', [rfIgnoreCase]);
         end;
    end;
  finally
    FreeAndNil(INIFile);
  end;
  SetVideoPreviewState;
end;

procedure TFormMain.UpdateVideoPreviewIni;
var
  INIFile: TMemIniFile;
  Loop: Byte;
  VideoFile, iParameters: String;
begin
  if CheckReadOnly(GetIniFilesFolder+'videopreview.ini') then
     Exit;
  try
    INIFile:= TMemIniFile.Create(GetIniFilesFolder+'videopreview.ini');

    for Loop:= 1 to MaxArcadeSystems do
        INIFile.WriteString('Folders', GetSystemIniSection(Loop, True), VideoPreviewDir[Loop]);

    VideoFile:= FormPreferences.VideoPreviewMediaPlayerExecutable.Text;
    INIFile.WriteString('MediaPlayer', 'File', VideoFile);
    INIFile.WriteInteger('MediaPlayer', 'Enabled', Ord(FormPreferences.VideoPreviewEnabled.Checked));
    INIFile.WriteInteger('MediaPlayer', 'AutoPlay', Ord(FormPreferences.VideoPreviewAutoPlay.Checked));
    INIFile.WriteInteger('MediaPlayer', 'ParentGameVideo', Ord(FormPreferences.VideoPreviewParentGameVideo.Checked));
    INIFile.WriteInteger('MediaPlayer', 'PlayDummyVideo', Ord(FormPreferences.VideoPreviewPlayDummyVideo.Checked));
    INIFile.WriteString('MediaPlayer', 'DummyVideoParameters', FormPreferences.VideoPreviewDummyVideoParameters.Text);

    if VideoFile <> '' then
       VideoFile:= ExtractFileName(VideoFile);

    if VideoFile <> '' then
       begin
         iParameters:= FormPreferences.VideoPreviewMediaPlayerParameters.Text;
         if iParameters = '' then
            iParameters:= '%1'
         else
            begin
              if PosEx('%1', iParameters) = 0 then
                 iParameters:= '%1 '+iParameters;
            end;
         iParameters:= StringReplace(iParameters, '"%1"', '%1', [rfIgnoreCase]);
         FormPreferences.VideoPreviewMediaPlayerParameters.Text:= iParameters;
       end;
    INIFile.WriteString('Parameters', VideoFile, FormPreferences.VideoPreviewMediaPlayerParameters.Text);
    INIFile.UpdateFile;
  finally
    FreeAndNil(INIFile);
  end;
  if not FormPreferences.VideoPreviewEnabled.Checked then
     ButtonPlayVideoPreview.HelpKeyword:= '';
end;

function TFormMain.ReadIniFile(ExitApplication: Boolean = False): Boolean;
const
  ReadIniFileMsg: String = 'Reading initialization file.';
var
  INIFile: TMemIniFile;
  Loop: ShortInt;
  Index: Integer;
  tmpString: String;
  ShowErrorMsg: Boolean;

  function SetImageFolder(SystemID: Integer): Boolean;
  var
    Section: String;
    LoopImg: ShortInt;
    //IsSnapMAME: Boolean;
  begin
    Result:= True;
    Section:= GetSystemIniSection(SystemID);
    for LoopImg:= Low(ImageCategoryArray) to High(ImageCategoryArray)-1 do
    begin
      //IsSnapMAME:= (SystemID in [idMAME, idHBMAME]) and (LoopImg = 1);
      //if not IsSnapMAME then
      if not ((SystemID in [idMAME, idHBMAME]) and (LoopImg = 1)) then
         imgFolder[SystemID, LoopImg]:= INIFile.ReadString(Section, ImageCategoryArray[LoopImg, 1]+'_folder', ImageCategoryArray[LoopImg, 3]);//'');
    end;
  end;

  function SetMiscFilterCheckBox(CheckBoxHolder: TAdvOfficeCheckBox): Boolean;
  begin
    Result:= True;
    if CheckBoxHolder.Checked <> (Boolean(CheckBoxHolder.Tag)) then
       CheckBoxHolder.Checked:= Boolean(CheckBoxHolder.Tag);
    //if FormFiltersExtra.HideBiosSets.Checked <> Boolean(FormFiltersExtra.HideBiosSets.Tag) then
    //   FormFiltersExtra.HideBiosSets.Checked:= Boolean(FormFiltersExtra.HideBiosSets.Tag);

  end;

  procedure SetEmulatorVariables(SystemID: Integer);
  var
    SectionString: String;
  begin
    SectionString:= GetSystemIniSection(SystemID);
    EmulatorFile[SystemID]:= INIFile.ReadString(SectionString, 'emu_FileName', '');
    EmulatorVersion[SystemID]:= INIFile.ReadString(SectionString, 'emu_VersionInfo', '');
    EmulatorDateTime[SystemID]:= INIFile.ReadInteger(SectionString, 'emu_DateTime', -1);

    if (EmulatorDateTime[SystemID] = -1) and FileExists(EmulatorFile[SystemID]) then
       EmulatorDateTime[SystemID]:= FileAge(EmulatorFile[SystemID]);

    if SystemID = idMAME then
       buildMAME:= INIFile.ReadString(SectionString, 'emu_Build', '');
  end;

begin
  Result:= True;
  ShowErrorMsg:= False;
  if FormStatus.Visible then
     FormStatus.MessageStr(ReadIniFileMsg);
  try
    INIFile:= TMemIniFile.Create(FrontendPath+'EmuLoader.ini');
    MenuBoundToGamesPanel.Checked:= Boolean(INIFile.ReadInteger('ToolBar', 'BoundToGamesPanel', 0));
    MenuBoundToGamesPanel.OnClick(Self);

    // read Games Font Type and Color
    SetSelectedColorBox(FormPreferences.GamesBackgroundColor, INIFile.ReadInteger('Appearance', 'GamesListBackgroundColor', FormPreferences.GamesBackgroundColor.DefaultColorColor));
    Font_Parent.Color:= INIFile.ReadInteger('Appearance', 'ParentGameFontColor', 0);
    Font_Parent.Name:= INIFile.ReadString('Appearance', 'ParentGameFontName', 'Segoe UI');
    Font_Parent.Size:= INIFile.ReadInteger('Appearance', 'ParentGameFontSize', 9);
    Font_Parent.Style:= TFontStyles(Byte(INIFile.ReadInteger('Appearance', 'ParentGameFontStyle', 0)));

    Font_Clone.Color:= INIFile.ReadInteger('Appearance', 'CloneGameFontColor', 0);
    Font_Clone.Name:= INIFile.ReadString('Appearance', 'CloneGameFontName', 'Segoe UI');
    Font_Clone.Size:= INIFile.ReadInteger('Appearance', 'CloneGameFontSize', 9);
    Font_Clone.Style:= TFontStyles(Byte(INIFile.ReadInteger('Appearance', 'CloneGameFontStyle', 0)));

    Font_Preliminary.Color:= INIFile.ReadInteger('Appearance', 'PreliminaryGameFontColor', TColor(clGray));
    Font_Preliminary.Name:= INIFile.ReadString('Appearance', 'PreliminaryGameFontName', 'Segoe UI');
    Font_Preliminary.Size:= INIFile.ReadInteger('Appearance', 'PreliminaryGameFontSize', 9);
    Font_Preliminary.Style:= TFontStyles(Byte(INIFile.ReadInteger('Appearance', 'PreliminaryGameFontStyle', 8)));

    Font_MissingROMs.Color:= INIFile.ReadInteger('Appearance', 'MissingROMsGameFontColor', TColor(clRed));
    Font_MissingROMs.Name:= INIFile.ReadString('Appearance', 'MissingROMsGameFontName', 'Segoe UI');
    Font_MissingROMs.Size:= INIFile.ReadInteger('Appearance', 'MissingROMsGameFontSize', 9);
    Font_MissingROMs.Style:= TFontStyles(Byte(INIFile.ReadInteger('Appearance', 'MissingROMsGameFontStyle', 0)));

    Font_MissingROMsPreliminary.Color:= INIFile.ReadInteger('Appearance', 'MissingROMsPreliminaryGameFontColor', TColor(clRed));
    Font_MissingROMsPreliminary.Name:= INIFile.ReadString('Appearance', 'MissingROMsPreliminaryGameFontName', 'Segoe UI');
    Font_MissingROMsPreliminary.Size:= INIFile.ReadInteger('Appearance', 'MissingROMsPreliminaryGameFontSize', 9);
    Font_MissingROMsPreliminary.Style:= TFontStyles(Byte(INIFile.ReadInteger('Appearance', 'MissingROMsPreliminaryGameFontStyle', 8)));

    FormPreferences.GamesTileBackground.Checked:= Boolean(INIFile.ReadInteger('Appearance', 'TileBackground', 1));
    FormPreferences.GamesBackgroundImage.Text:= INIFile.ReadString('Appearance', 'BackgroundImage', 'el_bk.png');
    FormPreferences.GamesBackgroundImageEnable.Checked:= Boolean(INIFile.ReadInteger('Appearance', 'BackgroundImageEnabled', 0));

