procedure TFormMain.ReadExtraIni;
var
  INIFile: TMemIniFile;
  Loop: Byte;
  tmpString: String;
begin
  try
    INIFile:= TMemIniFile.Create(FrontendPath+'el_extras.ini');
    with FormPreferences do
    begin
      MAMEInfoTextHolder.Font.Color:= INIFile.ReadInteger('GameDocuments', 'FontColor', 0);
      MAMEInfoTextHolder.Font.Name:= INIFile.ReadString('GameDocuments', 'FontName', 'Lucida Console');
      MAMEInfoTextHolder.Font.Size:= INIFile.ReadInteger('GameDocuments', 'FontSize', 8);
      MAMEInfoTextHolder.Font.Style:= TFontStyles(Byte(INIFile.ReadInteger('GameDocuments', 'FontType', 0)));
      SetSelectedColorBox(GameDocumentsBackgroundColor, INIFile.ReadInteger('GameDocuments', 'BackgroundColor', GameDocumentsBackgroundColor.DefaultColorColor));
    end;
    GameDocumentsLayout1_Top.Tag:= INIFile.ReadInteger('GameDocuments', 'LayoutTop_Height', 151);
    GameDocumentsLayout2_Bottom.Tag:= INIFile.ReadInteger('GameDocuments', 'LayoutBottom_Height', 151);
    GameDocumentsLayout3_Left.Tag:= INIFile.ReadInteger('GameDocuments', 'LayoutLeft_Width', 151);
    GameDocumentsLayout4_Right.Tag:= INIFile.ReadInteger('GameDocuments', 'LayoutRight_Width', 151);
    PanelGameDocuments.Tag:= INIFile.ReadInteger('GameDocuments', 'LayoutIndex', 0);

    PopupAutomaticGameInformation.Tag:= INIFile.ReadInteger('GameDocuments', 'AutoGameDocs', 0);
    // value 11 -> index + enabled/disabled
    ClearListView(FormPreferences.GameDocs);
    FormPreferences.GameDocs.BeginUpdate;
    for Loop:= 1 to 6 do
    begin
      tmpString:= INIFile.ReadString('GameDocuments', 'DocIndex'+IntToStr(Loop), IntToStr(Loop)+'1');
      if Length(tmpString) <> 2 then
         tmpString:= IntToStr(Loop)+'1';
      ELV_AddGameDocs(StrToInt(tmpString[1]), Boolean(StrToInt(tmpString[2])));
    end;
    FormPreferences.GameDocs.EndUpdate;
    case PanelGameDocuments.Tag of
      0: PanelGameDocuments.Height:= GameDocumentsLayout1_Top.Tag;
      1: GameDocumentsLayout2_Bottom.Click;
      2: GameDocumentsLayout3_Left.Click;
      3: GameDocumentsLayout4_Right.Click;
    end;
  finally
    FreeAndNil(INIFile);
  end;
end;

procedure TFormMain.UpdateExtraIni;
var
  INIFile: TMemIniFile;
  docItem: TEasyItem;
begin
  if CheckReadOnly(FrontendPath+'el_extras.ini') then
     Exit;
  try
    INIFile:= TMemIniFile.Create(FrontendPath+'el_extras.ini');

    with FormPreferences do
    begin
      INIFile.WriteInteger('GameDocuments', 'BackgroundColor', GameDocumentsBackgroundColor.Selected);
      INIFile.WriteInteger('GameDocuments', 'FontColor', MAMEInfoTextHolder.Font.Color);
      INIFile.WriteString('GameDocuments', 'FontName', MAMEInfoTextHolder.Font.Name);
      INIFile.WriteInteger('GameDocuments', 'FontSize', MAMEInfoTextHolder.Font.Size);
      INIFile.WriteInteger('GameDocuments', 'FontType', Byte(MAMEInfoTextHolder.Font.Style));
    end;

    INIFile.WriteInteger('GameDocuments', 'LayoutTop_Height', GameDocumentsLayout1_Top.Tag);
    INIFile.WriteInteger('GameDocuments', 'LayoutBottom_Height', GameDocumentsLayout2_Bottom.Tag);
    INIFile.WriteInteger('GameDocuments', 'LayoutLeft_Width', GameDocumentsLayout3_Left.Tag);
    INIFile.WriteInteger('GameDocuments', 'LayoutRight_Width', GameDocumentsLayout4_Right.Tag);

    INIFile.WriteInteger('GameDocuments', 'LayoutIndex', PanelGameDocuments.Tag);
    INIFile.WriteInteger('GameDocuments', 'AutoGameDocs', Ord(PopupAutomaticGameInformation.Checked));

    if not CheckTotal(FormPreferences.GameDocs) then
       FormPreferences.ButtonResetAutoGameInfoOrder.Click;
    with FormPreferences do
    begin
      docItem:= FormPreferences.GameDocs.Groups.FirstItem;
      repeat
        INIFile.WriteString('GameDocuments', 'DocIndex'+IntToStr(docItem.Index+1),
                            IntToStr(docItem.Tag)+IntToStr(Ord(docItem.Checked)));
        docItem:= FormPreferences.GameDocs.Groups.NextItem(docItem);
      until docItem = nil;
    end;

    INIFile.UpdateFile;
  finally
    FreeAndNil(INIFile);
  end;
end;

