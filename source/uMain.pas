  tmpIcon:= TIcon.Create;
  tmpIcon.Handle:= fIcon.Handle;
  DestImageHolder.Picture.Icon:= nil; // clear it first!
  DestImageHolder.Picture.Icon:= tmpIcon;
  FreeAndNil(tmpIcon);
