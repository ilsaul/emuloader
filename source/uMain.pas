  function GetSoftListCustomSystemID(const SoftwareName: String): Integer;
  var
    iSoftLoop: Integer;
  begin
    Result:= -1;
    for iSoftLoop:= Low(MAMESoftListCustomSystems) to High(MAMESoftListCustomSystems) do
    begin
      Result:= MAMESoftListCustomSystems[iSoftLoop].IndexOf(SoftwareName);
      if Result <> -1 then
         begin
           TempGameVars.eCustomSystemID:= iSoftLoop;
           Break;
         end;
    end;
  end;

  function LoadCRC32CollisionFile(ArcadeSystemID: Integer): Boolean;
  begin
    if ArcadeSystemID = CRC32CollisionSysID then
       Exit;

    CRC32Count:= 0;
    CRC32CollisionSysID:= ArcadeSystemID;
    FreeAndNil(CRC32CollisionGames);
    Result:= ValidateFile(GetCRC32CollisionFile(ArcadeSystemID));
    if Result then
      begin
        CRC32CollisionGames:= THashedStringList.Create;
        CRC32CollisionGames.LoadFromFile(GetCRC32CollisionFile(ArcadeSystemID));
      end;
  end;

  function LoadPlayedFileArcade(ArcadeSystemID: Integer): Boolean;
