// fixes for Windows Seven minimize/maximize and to remove Delphi 7 hidden form
procedure TFormMain.CreateParams(var Params: TCreateParams);
begin
  inherited CreateParams(Params);
  Params.ExStyle := Params.ExStyle and not WS_EX_TOOLWINDOW or
    WS_EX_APPWINDOW;
end;

procedure TFormMain.WMActivate(var Message: TWMActivate);
begin
  if (Message.Active = WA_ACTIVE) and not IsWindowEnabled(Handle) then
  begin
    SetActiveWindow(Application.Handle);
    Message.Result := 0;
  end else
    inherited;
end;

procedure TFormMain.WMSysCommand(var Message: TWmSysCommand);
begin
  case MenuViewFullScreen.Checked of
    True:
      begin
        case (Message.CmdType and $FFF0) of
          SC_MAXIMIZE, SC_MINIMIZE: Message.Result := 0;
        end;
      end;
    False:
      begin
        case (Message.CmdType and $FFF0) of
          SC_MINIMIZE:
          begin
            ShowWindow(Handle, SW_MINIMIZE);
            Message.Result := 0;
          end;
          SC_RESTORE:
          begin
            ShowWindow(Handle, SW_RESTORE);
            Message.Result := 0;
          end;
        else
          inherited;
        end;
      end;
  end;
end;

