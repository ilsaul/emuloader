procedure TFormMain.LoadInternetGameInfo(const GameName, SoftwareName: WideString; IsCustomGame: Boolean);
var
  BrowserFlags: OleVariant; // a value that determines under more whether a page should be added to the history list,
                            // be read from the cache memory or be written to the cache;
  MyTargetFrameName: OleVariant; // a string that determines in which frame the URL should be displayed;
  MyPostaData: OleVariant; // a value that specifies the HTTP POST data to send to the server;
  MyHeaders: OleVariant; // a value that specifies the HTTP headers to send to the server.
begin
  if WebBrowser.Busy then
     WebBrowser.Stop;
  BrowserFlags := $02;

  if IsCustomGame then
     WebBrowser.Navigate('about:blank')
  else
     begin
       //MyTargetFrameName := null;
       //MyPostaData := null;
       //MyHeaders := null;
       if SoftwareName = '' then
          WebBrowser.Navigate(Format(FormPreferences.InternetGameInfoLink.Text, [GameName]),
                              BrowserFlags, MyTargetFrameName, MyPostaData, MyHeaders)
       else
          WebBrowser.Navigate(Format(FormPreferences.InternetMAMESoftwareListGameInfoLink.Text, [GameName, SoftwareName]),
                              BrowserFlags, MyTargetFrameName, MyPostaData, MyHeaders);
     end;
end;

procedure TFormMain.ToggleImagesPanel(IsRunningGame: Boolean = False);
begin
  if not IsRunningGame then
     UpdateScreenshotsPanel; // as of EL v8.4.5 this will only execute when toggle images on/off and toggle game docs on/off
  if not ValidateSelectedGame then
     Exit;

  case MenuShowImages.Checked of
    True:
      begin
        if IsGameDocsSinglePanelDisplay then
           begin
             ResetNoImageLoaded;
             // ResetImageTagTo1; // DO NOT ENABLE! if reset image tags to 1, calling delete/rename image will not delete the correct image index per panel (wrong) (January 25, 2018)
             DisplayImage;
           end
        else
           begin
             if ButtonImagePanelToggle.Down then
             begin
               ResetNoImageLoaded;
               // ResetImageTagTo1; // DO NOT ENABLE! commented code left here to remind me that it should NOT execute
               DisplayImage;
             end;
           end;
      end;
    False:
      begin
        ResetImageTagTo1;
        ClearScreenshots;
      end;
  end;
  if not IsStartup then
     ELV_MakeVisible(nil, nil, False);
end;

procedure TFormMain.DestroyImageLayoutControls;
var
  iLoop: Integer;

  function DestroyImageHintPanel(Index: ShortInt): Boolean;
  begin
    if Assigned(ImageHintPanel2[Index]) then
       begin
         FreeAndNil(ImageHintIcon2[Index]);
         FreeAndNil(ImageHintText2[Index]);
         FreeAndNil(ImageHintDetailsText2[Index]);
         FreeAndNil(ImageHintPanel2[Index]);
       end;
    Result:= not Assigned(ImageHintPanel2[Index]);
  end;

  function DestroySplitter(Index: ShortInt): Boolean;
  begin
    if Assigned(SplitterImg[Index]) then
       FreeAndNil(SplitterImg[Index]);
    Result:= not Assigned(SplitterImg[Index]);
  end;

  function DestroyImagePnl: Boolean;
  begin
    if Assigned(ImagePnl) then
       FreeAndNil(ImagePnl);
    Result:= not Assigned(ImagePnl);
  end;

  function DestroyImagePnlQuadVert: Boolean;
  begin
    if Assigned(ImagePnlQuadVert) then
       FreeAndNil(ImagePnlQuadVert);
    Result:= not Assigned(ImagePnlQuadVert);
  end;

  function DestroyImageScr(Index: ShortInt): Boolean;
  begin
    DestroyImageHintPanel(Index);
    
    if Assigned(ImageScr[Index]) then
       begin
         ImageScr[Index].Bitmap:= nil;
         FreeAndNil(ImageScr[Index]);
       end;
    Result:= not Assigned(ImageScr[Index]);
  end;

begin
  // this is called in uMain.SetImageLayout function and in FormMain.OnCloseQuery() event
  if IsStartup then
     Exit;
  for iLoop:= Low(SplitterImg) to High(SplitterImg) do
      DestroySplitter(iLoop);

  for iLoop:= Low(ImageScr) to High(ImageScr) do
      DestroyImageScr(iLoop);

  DestroyImagePnl;
  DestroyImagePnlQuadVert;
end;


procedure TFormMain.SetResampler(ImageHolder: TImage32; SamplerIndex: ShortInt = -1);
var
  R: TCustomResampler;
begin
  ImageHolder.Bitmap.BeginUpdate;

  if SamplerIndex = -1 then
     begin
       case MenuImageResampler.Tag of
         0: R:= TCustomResamplerClass(TNearestResampler).Create(ImageHolder.Bitmap); // off
         1: R:= TCustomResamplerClass(TLinearResampler).Create(ImageHolder.Bitmap);  // Linear
         2: // Cosine (sharp, retains more details of original iimage)
           begin
             R:= TCustomResamplerClass(TKernelResampler).Create(ImageHolder.Bitmap);
             TKernelResampler(ImageHolder.Bitmap.Resampler).Kernel:= TCustomKernelClass(TCosineKernel).Create;
           end;
         3: // Hermite (over-sharpening, color bleed)
           begin
             R:= TCustomResamplerClass(TKernelResampler).Create(ImageHolder.Bitmap);
             TKernelResampler(ImageHolder.Bitmap.Resampler).Kernel:= TCustomKernelClass(THermiteKernel).Create;
           end;

       end;
     end
  else
     begin
       // resampler for uStatus screen
       R:= TCustomResamplerClass(TKernelResampler).Create(ImageHolder.Bitmap);
       TKernelResampler(ImageHolder.Bitmap.Resampler).Kernel:= TCustomKernelClass(TCosineKernel).Create;
     end;
  ImageHolder.Repaint;
  ImageHolder.Bitmap.EndUpdate;
end;

