       SetComboBox2ExColors(TComboBox2Ex(FormArcadeFiltersExtra.Components[Loop]), True);
  end;

  FormArcadeFiltersDriverStatus:= TFormArcadeFiltersDriverStatus.Create(nil);
  SetComboBox2ExColors(FormArcadeFiltersDriverStatus.DriverStatusCategory, True);

  FormStatus.MessageStr('Initializing variables in RAM.');

  SelectedFilterName:= 'allgames';   // set default filter to "All Games" (MAME and arcade only)

  InitializeEmulatorVariables;       // for MAME and arcade emulators
  InitializeCustomEmulatorVariables; // for console/computer/handheld emulators (ported from EmuCon)

  Font_Parent:= TFont.Create;
  Font_Clone:= TFont.Create;
  Font_Preliminary:= TFont.Create;
  Font_MissingROMs:= TFont.Create;
  Font_MissingROMsPreliminary:= TFont.Create;
  SetDefaultFont(Font_Parent, 0, IsNightMode);
  SetDefaultFont(Font_Clone, 1, IsNightMode);
  SetDefaultFont(Font_Preliminary, 2, IsNightMode);
  SetDefaultFont(Font_MissingROMs, 3, IsNightMode);
  SetDefaultFont(Font_MissingROMsPreliminary, 4, IsNightMode);

  Font_TilesViewDetailsText:= TFont.Create;
  Font_TilesViewDetailsText.Name:= 'Trebuchet MS';
  Font_TilesViewDetailsText.Size:= 9;
  Font_TilesViewDetailsText.Style:= [];
  if IsNightMode then
     Font_TilesViewDetailsText.Color:= clCream
  else
     Font_TilesViewDetailsText.Color:= clBlack;

  CheckDefaultFavProfile;
  FavoriteProfile[0]:= 'Default';
  FavoriteProfile[1]:= 'favorites.txt';
  PopupEnableFavorites.Hint:= FavoriteProfile[0];

  MAMEInfoTextHolder.Color:= clNone;

  LoadControlTypeList; // populate controls list in the search bar tool button (Supermodel 3 emulator controls file not included)

  PlayDummyVideoPreview:= False;

  // fix flicker when resizing the tool bars (2018)
  ToolBarButtons.DoubleBuffered:= True;
  ToolBarFilterTitle_ToolBar.DoubleBuffered:= True;
  ImagesToolBarButtons.DoubleBuffered:= True;
  
  FormStatus.MessageStr('Initializing night mode screen.');
end;

function TFormMain.VerifyTempDirectory: Boolean;
begin
  Result:= CheckAndCreateFolder(FrontendPath+'temp');
  if not Result then
     begin
       CallMessageBox;
       AddMsgText('Folder ');
       AddMsgText(FrontendPath+'temp', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' could not be created.'+#13#10+'Please create the temp '+
                  'folder manually and then click OK button to continue.');
       GenerateMessage('Error', 'Failed to create a folder.', '', 2, False, 1);
     end;
end;

procedure TFormMain.RunCreateGamesSysArcade(const SystemID: Integer);
begin
  if IsClrMAMEProBasedSys(SystemID) then
     begin
       if SystemID = idSupermodel then
          begin
            if not ParseSupermodelGamesXMLFile then // create games list based on new "supermodel3_dir\Config\Games.xml" file (SVN 592 and newer!)
               CreateGamesClrMAMEProXML(SystemID); // this is for SVN 591 and older
          end
       else
          CreateGamesClrMAMEProXML(SystemID);
     end
  else
  if SystemID = idDaphne then
     CreateGamesListDaphne;
end;

procedure TFormMain.CheckDefaultFavProfile;
var
  favFile: TStringList;
begin
  if not FileExists(GetFavoritesFolder+'favorites.txt') then
     begin
       favFile:= TStringList.Create;
       favFile.SaveToFile(GetFavoritesFolder+'favorites.txt');
       FreeAndNil(favFile);
     end;
end;

function TFormMain.GetFavoritesTitle: String;
var
  favFileName: String;
  fFile: THashedStringList;
begin
  if IsFavoriteDefault(FavoriteProfile[1]) then
     begin
       Result:= 'Default';
       Exit;
     end;
  favFileName:= GetFavoritesFile;

  if not FileExists(favFileName) then
     begin
       Result:= ChangeFileExt(FavoriteProfile[1], '');
       Exit;
     end;
  fFile:= THashedStringList.Create;
  fFile.LoadFromFile(favFileName);
  Result:= fFile.Values['favorite_title'];
  if Result = '' then
     Result:= ChangeFileExt(FavoriteProfile[1], '');
  FreeAndNil(fFile);
end;

procedure TFormMain.FormShow(Sender: TObject);
var
  GamesListFound, UpdateArcadeVersionInfo: packed array[1..MaxArcadeSystems] of Boolean;
  UpdateAlterMAME1VersionInfo, UpdateAlterMAME2VersionInfo: Boolean;
  Loop, NewDateTime: Integer;
  ErrorStr, ErrorMsgTitle: String;
  tmpString: String;
  Continue, ScanModeSelected, IsFirstTimeRun: Boolean;
  iVersion: String;
  CreateListArcade, CreateListConsoleComputer: Boolean;
  MAMESoftwareListsToProcess, HBMAMESoftwareListsToProcess: THashedStringList;
  iFileNightMode,  iFileLightMode : String;
  iExistNightMode, iExistLightMode: Boolean;

  function ShowScanModeSelectDialog: Boolean;
  begin
    Result:= not ScanModeSelected;
    if Result then
       begin
         PopupSelectScanGamesMode.Click;
         ScanModeSelected:= True;
       end;
  end;

  function SetMAMEBuild(sysID: Byte; AlterMAMEIndex: Integer = -1): Boolean;
  begin
    Result:= IsMAMEBasedSys(sysID);
    if not Result then
       Exit;
    if AlterMAMEIndex = -1 then
       begin
         case sysID of
           idMAME: buildMAME:= iVersion;
           idHBMAME: buildHBMAME:= iVersion;
         end;
       end
    else
       buildAlterMAME[AlterMAMEIndex]:= iVersion;
  end;

  function UpdateEmulatorVersionInfo(sysID: Byte; AlterMAMEIndex: Integer = -1): Boolean;
  begin
    if AlterMAMEIndex = -1 then
       Result:= (EmulatorFile[sysID] <> '') and FileExistsW(EmulatorFile[sysID])
    else
       Result:= (AlterMAMEFile[AlterMAMEIndex] <> '') and FileExistsW(AlterMAMEFile[AlterMAMEIndex]);

    if not Result then
       Exit;

    if AlterMAMEIndex = -1 then
       NewDateTime:= FileAgeW(EmulatorFile[sysID])
    else
       NewDateTime:= FileAgeW(AlterMAMEFile[AlterMAMEIndex]);

    Application.ProcessMessages;
    Result:= NewDateTime <> -1;
    if not Result then
       Exit;

    if AlterMAMEIndex = -1 then
       begin
         Result:= EmulatorDateTime[sysID] <> NewDateTime;
         if Result then
         begin
           UpdateArcadeVersionInfo[sysID]:= True;
           EmulatorDateTime[sysID]:= NewDateTime;
           GetArcadeEmulatorVersion(sysID, EmulatorFile[sysID], EmulatorVersion[sysID], iVersion);
           SetMAMEBuild(sysID);
         end;
       end
    else
       begin
         Result:= AlterMAMEDateTime[AlterMAMEIndex] <> NewDateTime;
         if Result then
         begin
           case AlterMAMEIndex of
             1: UpdateAlterMAME1VersionInfo:= True;
             2: UpdateAlterMAME2VersionInfo:= True;
           end;

           AlterMAMEDateTime[AlterMAMEIndex]:= NewDateTime;
           GetArcadeEmulatorVersion(sysID, AlterMAMEFile[AlterMAMEIndex], AlterMAMEVersion[AlterMAMEIndex], iVersion);
           SetMAMEBuild(sysID, AlterMAMEIndex);
         end;
       end;
  end;

  function SaveEmuVersionIniFile: Boolean;
  var
    vIniFile: TMemIniFile;
    vLoop: Integer;
  begin
    Result:= True;
    if CheckReadOnly(GetArcadeEmulatorsFile) then
       Exit;
    vIniFile:= TMemIniFile.Create(GetArcadeEmulatorsFile);
    
    for vLoop:=Low(UpdateArcadeVersionInfo) to High(UpdateArcadeVersionInfo) do
    begin
      if UpdateArcadeVersionInfo[vLoop] then
      begin
        tmpString:= GetArcadeSystemIniSection(vLoop);
        vIniFile.WriteString(tmpString,  'emu_VersionInfo', EmulatorVersion[vLoop]);
        vIniFile.WriteInteger(tmpString, 'emu_DateTime',    EmulatorDateTime[vLoop]);
        case vLoop of
          idMAME:   vIniFile.WriteString(tmpString, 'emu_Build', buildMAME);
          idHBMAME: vIniFile.WriteString(tmpString, 'emu_Build', buildHBMAME);
        end;

      end;
    end;
    if UpdateAlterMAME1VersionInfo then
    begin
      tmpString:= GetArcadeSystemIniSection(idMAME);
      vIniFile.WriteString(tmpString,  'emu_AlterMAMEVersion',  AlterMAMEVersion[1]);
      vIniFile.WriteInteger(tmpString, 'emu_AlterMAMEDateTime', AlterMAMEDateTime[1]);
      vIniFile.WriteString(tmpString,  'emu_AlterMAMEBuild',    buildAlterMAME[1]);
    end;

    if UpdateAlterMAME2VersionInfo then
    begin
      tmpString:= GetArcadeSystemIniSection(idMAME);
      vIniFile.WriteString(tmpString, 'emu_AlterMAME2Version', AlterMAMEVersion[2]);
      vIniFile.WriteInteger(tmpString, 'emu_AlterMAME2DateTime', AlterMAMEDateTime[2]);
      vIniFile.WriteString(tmpString, 'emu_AlterMAME2Build', buildAlterMAME[2]);
    end;

    vIniFile.UpdateFile;
    FreeAndNil(vIniFile);
  end;


  function CallCreateGamesList(SystemID: ShortInt): Boolean;
  begin
    // for fresh install, create games list call (MAME/HBMAME)
    Result:= True;
    case ValidateArcadeEmulatorFile(SystemID) of
      True : SetCurrentDir(ExtractFilePath(EmulatorFile[SystemID]));
      False: Exit;
    end;

    ShowScanModeSelectDialog;
    if SystemID = idMAME then
       begin
         MAMESoftwareListsToProcess:= THashedStringList.Create;
         CreateGamesListMAME(SystemID, MAMESoftwareListsToProcess);
       end
    else
    if SystemID = idHBMAME then
       begin
         HBMAMESoftwareListsToProcess:= THashedStringList.Create;
         CreateGamesListMAME(SystemID, HBMAMESoftwareListsToProcess);
       end;
    //CreateGamesListMAME(SystemID);
    GamesListFound[SystemID]:= False;

    SetCurrentDir(FrontendPath);
  end;

  function CallCreateGames2(sysID: ShortInt): Boolean;
  begin
    // fresh install, create arcade games list call (non MAME emulators)
    Result:= True;
    GamesListFound[sysID]:= not ValidateArcadeEmulatorFile(sysID);
    if not GamesListFound[sysID] then
       RunCreateGamesSysArcade(sysID);
  end;

  function CreateGamesFirstRunArcade(SystemID: ShortInt): Boolean;
  begin
    Result:= True;
    case IsMAMEBasedSys(SystemID) of
      True : CallCreateGamesList(SystemID); // (MAME/HBMAME)
      False: CallCreateGames2(SystemID);    // other arcade systems
    end;
  end;

  function CreateGamesFirstRunConsoleComputer: Boolean;
  var
    cLoop: Integer;
    IgnoreFileExtension: THashedStringList;
  begin
    Result:= True;
    IgnoreFileExtension:= THashedStringList.Create;
    PopulateIgnoreFileExt_ConsoleComputer(IgnoreFileExtension);
    for cLoop:=1 to MaxConsoleComputerSystems do
    begin
      CreateCustomGamesList(cLoop, True, IgnoreFileExtension, False);
      if MenuCreateCustomGamesList.HelpContext = 1 then
         Break;
    end;
    FreeAndNil(IgnoreFileExtension);
  end;

  function ForceApplicationTerminate: Boolean;
  begin
    Result:= True;
    TerminateEmuLoader:= True;
    Application.Terminate;
    PostMessage(Handle, wm_Close, 0, 0);
  end;

  function ReadSettingsCleanInstall: Boolean;
  var
    extraIni: TMemIniFile;
  begin
    if not FileExists(GetFrontendExtraIniFile) then
       Exit;
    extraIni:= TMemIniFile.Create(GetFrontendExtraIniFile);

    FormCleanInstallGuide.Option_SelectArcadeEmulators.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'SelectArcadeEmulators', 1));
    FormCleanInstallGuide.Option_CreateArcadeGamesList.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'CreateArcadeGamesList', 1));
    FormCleanInstallGuide.Option_SelectConsoleComputerEmulators.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'SelectConsoleComputerEmulators', 1));
    FormCleanInstallGuide.Option_SelectConsoleComputerGamesFolders.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'SelectConsoleComputerGamesFolders', 1));
    FormCleanInstallGuide.Option_CreateConsoleComputerGamesList.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'CreateConsoleComputerGamesList', 1));

    FreeAndNil(extraIni);
  end;

  function WriteSettingsCleanInstall: Boolean;
  var
    extraIni: TMemIniFile;
  begin
    if (not FormCleanInstallGuide.Option_SelectArcadeEmulators.Checked) and
       (not FormCleanInstallGuide.Option_CreateArcadeGamesList.Checked) and
       (not FormCleanInstallGuide.Option_SelectConsoleComputerEmulators.Checked) and
       (not FormCleanInstallGuide.Option_SelectConsoleComputerGamesFolders.Checked) and
       (not FormCleanInstallGuide.Option_CreateConsoleComputerGamesList.Checked) then
       Exit; // if none of the options are selected, do not update the .ini file

    if CheckReadOnly(GetFrontendExtraIniFile) then
       Exit;
    try
      extraIni:= TMemIniFile.Create(GetFrontendExtraIniFile);

      extraIni.WriteInteger('CleanInstall', 'SelectArcadeEmulators', Ord(FormCleanInstallGuide.Option_SelectArcadeEmulators.Checked));
      extraIni.WriteInteger('CleanInstall', 'CreateArcadeGamesList', Ord(FormCleanInstallGuide.Option_CreateArcadeGamesList.Checked));
      extraIni.WriteInteger('CleanInstall', 'SelectConsoleComputerEmulators', Ord(FormCleanInstallGuide.Option_SelectConsoleComputerEmulators.Checked));
      extraIni.WriteInteger('CleanInstall', 'SelectConsoleComputerGamesFolders', Ord(FormCleanInstallGuide.Option_SelectConsoleComputerGamesFolders.Checked));
      extraIni.WriteInteger('CleanInstall', 'CreateConsoleComputerGamesList', Ord(FormCleanInstallGuide.Option_CreateConsoleComputerGamesList.Checked));

      extraIni.UpdateFile;
    finally
      FreeAndNil(extraIni);
    end;
  end;

  function ReadConsCompSelectEmulatorIni: Boolean;
  var
    miscIni: TMemIniFile;
  begin
    if FileExists(GetMiscSettingsFile) then
       begin
         miscIni:= TMemIniFile.Create(GetMiscSettingsFile);
         ButtonCustomSelectDefaultEmulators.Tag:= miscIni.ReadInteger('Miscellaneous', 'SelectDefaultEmulator_SmallIcons', 0);
         FreeAndNil(miscIni);
       end;
  end;

begin
  if TerminateEmuLoader then
     begin
       ForceApplicationTerminate;
       Exit;
     end;

  if not IsStartup then
     Exit;
  ELV_ResetNormalColors(GamesListView);
  ELV_ResetNormalColors(MachinesListSidePanel);

  InitNightModeScreen;
  InitPreferencesScreen;
  
  // must set custom colors here, after FormNightMode is created
  SetButtonExColors(FormStatus.ColorsBoxButtonDefault, True, True);
  SetButtonExColors(FormStatus.VersionInfoPositionButtonDefault, True, True);
  SetButtonExColors(FormStatus.ProgressBarSchemeButtonDefault, True, True);
  SetButtonExColors(FormStatus.ProgressBarCopyCurrentColorsToCustomButton, True, True);
  SetButtonExColors(FormStatus.StatusButtonClose, True, True);

  FormStatus.MessageStr('Loading main screen icons.');
  LoadMainScreenIcons(False, False);
  if MenuToolBarIconSize.Tag <> 1 then
     MenuToolBarIconSize.Items[MenuToolBarIconSize.Tag].Click; // change games list filters tool bar size

  FormStatus.MessageStr('Loading miscellaneous icons.');
  LoadLeftPanelIcons;

  LoadCustomEmulatorsIconsPopupMenu; // for "Play (Custom Emulators)" sub-menu (PopupMenuGamesList)

  ScanModeSelected:= False;
  ErrorMsgTitle:= 'Error: Startup';
  IsFirstTimeRun:= False;
  CreateListArcade:= False;
  CreateListConsoleComputer:= False;
  for Loop:=1 to MaxArcadeSystems do
  begin
    GamesListFound[Loop]:= True;
    UpdateArcadeVersionInfo[Loop]:= False;
  end;
  UpdateAlterMAME1VersionInfo:= False;
  UpdateAlterMAME2VersionInfo:= False;

  ResetNoImageLoaded;
  if not FileExists(GetFrontendExtraIniFile) then
     UpdateExtraIni;

  ReadExtraIni; // read game docs settings and other settings (file cannot be rewritten when terminating the frontend like it does for "EmuLoader.ini")

  SetEasyListViewHeaderColors(GamesListView, False);
  SetEasyListViewHeaderColors(MachinesListSidePanel, False);
  SetComboBox2ExColors(FilterCPUList, True, FilterCPU);

  SetPopupMenuNightColorsFormMain(True); // set popup menus frame colors for the night mode ("FormMain" only)

  ReadConsCompSelectEmulatorIni; // set small icons or 128x128 icons in "Select Default Emulators To Play (Console/Computer)" tool bar button

  // make sure "\ini_files\videopreview.ini" file exists; if not, make a duplicate of "\ini_files\videopreview[default].ini"
  if not FileExists(GetVideoPreviewIniFile) then
     begin
       if FileExists(GetVideoPreviewIniFile(True)) then
          begin
            CopyFile(PChar(GetVideoPreviewIniFile(True)), PChar(GetVideoPreviewIniFile), False);
            Sleep(50);
          end;
     end;
  ReadVideoPreviewIni(True, True, True);

  FormPreferences.MAMEGameManualsPDFFolder.Text:= 'manuals';
  ReadDaemonToolsSettings(True); // for console/computer/handheld emulators (ported from EmuCon)

  Continue:= False; // set to "clean install" (August 24, 2017)

  for Loop:=1 to MaxArcadeSystems do
  begin
    if VerifyArcadeGamesSys(Loop) then
       begin
         Continue:= True;
         Break; // one system is found, it's not a clean install (August 24, 2017)
       end;
  end;

  if not Continue then
     begin
       if VerifyGamesMAMESoftlist(idMAME) then
          Continue:= True;
     end;

  if not Continue then
     begin
       if VerifyGamesMAMESoftlist(idHBMAME) then
          Continue:= True;
     end;

  if not Continue then
     begin
        for Loop:=1 to MaxConsoleComputerSystems do
        begin
          if FileExists(GetCustomGamesFile(Loop)) then
             begin
               Continue:= True;
               Break;
             end;
     end;
  end;

  if not Continue then
     IsFirstTimeRun:= True;

  // IsFirstTimeRun:= True; // for debugging only, do not enable
  case IsFirstTimeRun of
    True:
      begin
        if not Assigned(FormCleanInstallGuide) then
           FormCleanInstallGuide:= TFormCleanInstallGuide.Create(nil);

        ReadSettingsCleanInstall;
        if not ValidateFile(GetArcadeEmulatorsFile) then
           begin
             FormCleanInstallGuide.LabelOption_SelectArcadeEmulators_FileStatus.Caption:= FormCleanInstallGuide.LabelOption_SelectArcadeEmulators_FileStatus.Hint+' not found)';
             FormCleanInstallGuide.LabelOption_SelectArcadeEmulators_FileStatus.Font.Color:= clrLightRed;
             FormCleanInstallGuide.LabelOption_SelectArcadeEmulators_FileStatus.ShadowColor:= clBlack;
           end;
        if not ValidateFile(GetSysImageFolders) then
           begin
             FormCleanInstallGuide.LabelOption_SelectConsoleComputerGamesFolders_FileStatus.Caption:= FormCleanInstallGuide.LabelOption_SelectConsoleComputerGamesFolders_FileStatus.Hint+' not found)';
             FormCleanInstallGuide.LabelOption_SelectConsoleComputerGamesFolders_FileStatus.Font.Color:= clrLightRed;
             FormCleanInstallGuide.LabelOption_SelectConsoleComputerGamesFolders_FileStatus.ShadowColor:= clBlack;
           end;
        FormStatus.Close; // close FormStatus to prevent clean guide dialog to be hidden behind it (December 31, 2017)
        if FormCleanInstallGuide.ShowModal = mrCancel then
           begin
             TerminateEmuLoader:= True;
             FreeAndNil(FormCleanInstallGuide);
             FormStatus.Close;
             ForceApplicationTerminate;
             Exit;
           end;

        tmpString:= '';
        if MenuEnableNightMode.Checked <> IsNightMode then
           begin
             MenuEnableNightMode.Checked:= IsNightMode;
             PopulateMsgColors;
           end;

        if MenuUseAlternateFrontendIcons.Checked <> FormCleanInstallGuide.UseAlternateFrontendIcons.Checked then
           begin
             MenuUseAlternateFrontendIcons.Tag:= 1;
             MenuUseAlternateFrontendIcons.Checked:= FormCleanInstallGuide.UseAlternateFrontendIcons.Checked;
             MenuUseAlternateFrontendIcons.OnClick(Self);
             MenuUseAlternateFrontendIcons.Tag:= 0;
           end;

        if FormCleanInstallGuide.Option_SelectArcadeEmulators.Checked then
           MenuArcadeEmulatorSetup.Click;

        if FormCleanInstallGuide.Option_CreateArcadeGamesList.Checked then
           begin
             if ValidateFile(GetArcadeEmulatorsFile) then // only create MAME/arcade games list if file "eldir\arcade\emulators.ini" exists; arcade emulators require it
                CreateListArcade:= True;
           end;

        if FormCleanInstallGuide.Option_SelectConsoleComputerEmulators.Checked then
           MenuCustomEmulatorsSetup.Click;

        if FormCleanInstallGuide.Option_SelectConsoleComputerGamesFolders.Checked then
           MenuCustomSystemsFoldersSettings.Click;

        if FormCleanInstallGuide.Option_CreateConsoleComputerGamesList.Checked then
           begin
             if ValidateFile(GetSysGameFolders) then // only create console/computer games list if file "eldir\console_computer\sysgamefolders.ini" exists; console/computer games require it
                CreateListConsoleComputer:= True;
           end;
        WriteSettingsCleanInstall; // update "el_extra.ini" with clean install dialog settings
        FreeAndNil(FormCleanInstallGuide);

        FormStatus.TitleStr('Initializing');
        FormStatus.StartThreadClock;
        FormStatus.Show;

        FormStatus.MessageStr('Loading EmuCon settings to RAM: games folders, image categories folders, emulators selections.');
        ReadCustomGamesFolders;
        ReadCustomEmulatorsInfo;
        ReadCustomSysImageFolders;

        if CreateListArcade then
           begin
             FormStatus.MessageStr('Loading arcade folders to RAM.');
             LoadFoldersAllArcadeSystems; // reload arcade emulator files and ROMs folders in case user clicked "Cancel" button in "MenuEmulatorSetup.Click"
              for Loop:=1 to MaxArcadeSystems do
                  CreateGamesFirstRunArcade(Loop);

              FreeAndNil(MAMESoftwareListsToProcess);
              FreeAndNil(HBMAMESoftwareListsToProcess);
           end;

        if CreateListConsoleComputer then
           CreateGamesFirstRunConsoleComputer;
      end;
    False:
      begin
        FormStatus.MessageStr('Loading EmuCon settings to RAM: games folders, image categories folders, emulators selections.');
        ReadCustomGamesFolders;
        ReadCustomEmulatorsInfo;
        ReadCustomSysImageFolders;

        ReadIniFile;

        Continue:= ReadArcadeEmulatorExecutable; // load emulator settings but if not found, do not ask user again
        if Continue then
           ErrorStr:= '';

        CheckAllMAMEIniFiles; // file emulators were selected and .exe files exist, check for mame.ini files and try to create them

        // load ROMs folders and update emulator .exe info in case user updated .exe files before starting Emu Loader
        FormStatus.MessageStr('Loading arcade folders to RAM.');
        LoadFoldersAllArcadeSystems;
        Continue:= False;

        FormStatus.MessageStr('Validating and updating arcade emulators version info.');
        for Loop:=1 to MaxArcadeSystems do
        begin
          if UpdateEmulatorVersionInfo(Loop) then
             Continue:= True; // update emulator Date/Time Windows stamp
        end;
        if UpdateEmulatorVersionInfo(idMAME, 1) then
           Continue:= True;

        if UpdateEmulatorVersionInfo(idMAME, 2) then
           Continue:= True;

        if Continue then
           SaveEmuVersionIniFile;
      end;
  end;

  FormStatus.TitleStr('Finalizing Setup');

  if not ValidateFile(FrontendPath+'EmuLoader.ini') then
     begin
       Application.ProcessMessages;
       UpdateIniFile;
       ReadIniFile;
       FormStatus.SetFocus;
     end;

  FilterSearchBarAdjustPanelControls;
  if IsNightMode then
     begin
       WebToolBarButtonsUpdateFontColor;
       SetColorsGamesListStatusBar;
       SetColorsSearchGamesPanel;

       SetToolBarFiltersFormColors;
     end;

  FormStatus.MessageStr('Loading games list icons to RAM.');
  ReadDefaultIconsFile;

  ReadMAMEFolderManualPDF;

  ReadArcadeImageCategories(True, True, imgFolder, True);

  ToggleMachinesListSidePanel;

  SetGameType(True); // load games list before CallScanGames() function

  if IsFirstTimeRun then
     begin
       if CreateListArcade then
       begin
         for Loop:=1 to MaxArcadeSystems do
         begin
           if not GamesListFound[Loop] then
           begin
             CallScanGames(0, False, Loop); // scan all games, ALL games are tagged "missing" (status = 2)
             if IsMAMEBasedSys(Loop) then   // include both MAME and HBMAME
                ScanSoftListGames(0, False, Loop); // it's a clean install, all softlists are processed (March 29, 2018)
           end;
         end;
       end;
     end;
  SortAuditGames:= False;

  if PopupEnableMAMu_Icons.Tag = 1 then
     PopupEnableMAMu_Icons.Click;

  if PopupAutomaticGameInformation.Tag = 1 then
     begin
       FormStatus.MessageStr('Initializing external MAME game documents files.');
       PopupAutomaticGameInformation.Tag:= 0;
       PopupAutomaticGameInformation.Click;
     end;

  FormStatus.MessageStr('Initializing images variables.');
  LoadListCPU(FilterCPUList);

  iFileNightMode:= GetCustomFontIniFile(True);
  iFileLightMode:= GetCustomFontIniFile(False);
  iExistNightMode:= ValidateFile(iFileNightMode);
  iExistLightMode:= ValidateFile(iFileLightMode);

  // check if "sysgamecustomfont_nightmode.ini" exists, if not copy "sysgamecustomfont.ini" (August 2019)
  if not iExistNightMode then
     begin
       if iExistLightMode then
          begin
            CopyFile(PChar(iFileLightMode), PChar(iFileNightMode), False);
            Sleep(40);
          end
       else
          WriteCustomGameFontFile(True);
     end;

  //if not iExistLightMode then
  //   begin
  //     if iExistNightMode then
  //        begin
  //          CopyFile(PChar(iFileNightMode), PChar(iFileLightMode), False);
  //          Sleep(40);
  //        end
  //     else
  //        WriteCustomGameFontFile(False);
  //   end;

  ReadCustomGameFontFile(IsNightMode); // read default font for GamesListView (all systems) and custom font for each system
end;

procedure TFormMain.InitImgZipThumbnail(FreeList: Boolean = False);
var
  sysID: Integer;
  Continue: Boolean;
begin
  case FreeList of
    True:
      begin
        Continue:= True; // true = free THashedStringList lists
        if MenuShowImages.Checked then
           begin
             Continue:= ImageDetails[1].ImageCategoryIndex_AllSystems <> 1; // check others is category different than in-game snapshots
             if Continue then
                begin
                  if Assigned(ImageScr[2]) then
                     Continue:= ImageDetails[2].ImageCategoryIndex_AllSystems <> 1;
                  if Continue then
                     begin
                       if Assigned(ImageScr[3]) then
                          Continue:= ImageDetails[3].ImageCategoryIndex_AllSystems <> 1;
                     end;
                  if Continue then
                     begin
                       if Assigned(ImageScr[4]) then
                          Continue:= ImageDetails[4].ImageCategoryIndex_AllSystems <> 1;
                     end;
                end;
           end;
        if Continue then
        begin
          // none of the 4 images are in-game snapshots or "Show Images" is disabled (main menu "Images"), free zipped lists
          for sysID:= 1 to MaxArcadeSystems do
              FreeAndNil(imgZipFileList[sysID, 1]); // free in-game snapshots only (snap.zip) for all arcde systems

          if Length(imgZipFileSoftList) > 0 then
             begin
               for sysID:= Low(imgZipFileSoftList) to High(imgZipFileSoftList) do
                   FreeAndNil(imgZipFileSoftList[sysID, 1]); // free in-game snapshots only (softname.zip) for all softare lists
             end;

          FreeAndNil(imgZipFileSoftList_SL[1]); // free in-game snapshots only (snap_sl.zip) for MAME

          for sysID:= 1 to MaxConsoleComputerSystems do
              FreeandNil(imgZipFileListConsComp[sysID, 1]); // free in-game snapshots only (snap.zip) for all console/computer systems (EmuCon)
        end;
      end;
    False:
      begin
        // even if one of the 4 images is being used, the list will be re-initialized and reloaded (contents of snap.zip; softwarename.zip; snap_sl.zip will be updated)
        ShowInitZipImageMsgBox;

        for sysID:= 1 to MaxArcadeSystems do
        begin
          if Assigned(imgZipFileList[sysID, 1]) then
             imgZipFileList[sysID, 1].Clear;
            ImgZipParseFilesList(sysID, 1); // init THashedStringList lists for in-game snapshots (snap.zip) for all arcade systems
        end;

        LoadImgSoftwareListNames;
        if Assigned(imgSoftwareNameZipList) then
           begin
             for sysID:= Low(imgZipFileSoftList) to High(imgZipFileSoftList) do
             begin
               if Assigned(imgZipFileSoftList[sysID, 1]) then
                  imgZipFileSoftList[sysID, 1].Clear;
               ImgZipParseFilesSoftwareList(idMAME, 1, sysID, imgSoftwareNameZipList[sysID]);
             end;
           end;

        if Assigned(imgZipFileSoftList_SL[1]) then
           begin
             imgZipFileSoftList_SL[1].Clear;
             ImgZipParseFilesSoftwareList_SL(idMAME, 1);
           end;

        for sysID:= 1 to MaxConsoleComputerSystems do
        begin
          if Assigned(imgZipFileListConsComp[sysID, 1]) then
             imgZipFileListConsComp[sysID, 1].Clear;
            ImgZipParseFilesListConsComp(sysID, 1); // init THashedStringList lists for in-game snapshots (snap.zip) for all console/computer systems (EmuCon)
        end;

        HideInitZipImageMsgBox;
      end;
  end;
end;

