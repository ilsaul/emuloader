function TFormMain.GetImageType(iMemStream: TWideMemoryStream; ScreenIndex: Integer = 0): TImageType;
const
  JPG_HEADER: array[0..2] of byte  = ($FF, $D8, $FF);
  GIF_HEADER: array[0..2] of byte  = ($47, $49, $46);
  BMP_HEADER: array[0..1] of byte  = ($42, $4D);
  PNG_HEADER: array[0..3] of byte  = ($89, $50, $4E, $47);
  TIF_HEADER: array[0..2] of byte  = ($49, $49, $2A);
  TIF_HEADER2: array[0..2] of byte = (77, 77, 00); // special case ? I don't know what this is for or if it's even used (February 17, 2018)
var
  MemStr: array[0..MaxImagePanels] of TWideMemoryStream;
begin
  Result:= ifUnknown;
  if iMemStream = nil then
     Exit;
  MemStr[ScreenIndex]:= TWideMemoryStream.Create;
  try
    iMemStream.Position:= 0;
    MemStr[ScreenIndex].CopyFrom(iMemStream, 5);
    if MemStr[ScreenIndex].Size > 4 then
      begin
      // uncomment these lines to detect unsupported image types, except "ShowMessage" commands
      // MemStr.Position:=0;
      // MemStr.Read(buf,1);
      // ShowMessage(inttostr(ord(buf)));
      // MemStr.Read(buf,1);
      // ShowMessage(inttostr(ord(buf)));
      // MemStr.Read(buf,1);
      // ShowMessage(inttostr(ord(buf)));

      if CompareMem(MemStr[ScreenIndex].Memory, @JPG_HEADER, SizeOf(JPG_HEADER)) then
         Result:= ifJPG
      else
      if CompareMem(MemStr[ScreenIndex].Memory, @GIF_HEADER, SizeOf(GIF_HEADER)) then
         Result:= ifGIF
      else
      if CompareMem(MemStr[ScreenIndex].Memory, @PNG_HEADER, SizeOf(PNG_HEADER)) then
         Result:= ifPNG
      else
      if CompareMem(MemStr[ScreenIndex].Memory, @BMP_HEADER, SizeOf(BMP_HEADER)) then
         Result:= ifBMP
      else
      if CompareMem(MemStr[ScreenIndex].Memory, @TIF_HEADER, SizeOf(TIF_HEADER)) then
         Result:= ifTIF
      else
      if CompareMem(MemStr[ScreenIndex].Memory, @TIF_HEADER2, SizeOf(TIF_HEADER2)) then
         Result:= ifTIF;
    end;
  finally
    MemStr[ScreenIndex].Free;
  end;
  iMemStream.Position:= 0;
end;

function TFormMain.LoadPreviewImage(const iFile: WideString; ImageHolder: TImage32): TImageType;
var
  iMemStream: TWideMemoryStream;
  pngImg: TPNGGraphic;
  jpgImg: TJPEGImage;
  gifImg: TGIFGraphic;
  bmpImg: TBitmap;
begin
  Result:= ifUnknown;
  if not FileExistsW(iFile) then
     Exit;

  iMemStream:= TWideMemoryStream.Create;
  iMemStream.LoadFromFile(iFile);
  Result:= GetImageType(iMemStream);
  ImageHolder.Canvas.Lock;

  try
    case Result of
      ifPNG:
        begin
          pngImg:= TPNGGraphic.Create;
          pngImg.LoadFromStream(iMemStream);
          ImageHolder.Bitmap.Assign(pngImg);
          FreeAndNil(pngImg);
        end;
      ifJPG:
        begin
          jpgImg:= TJPEGImage.Create;
          jpgImg.LoadFromStream(iMemStream);
          ImageHolder.Bitmap.Assign(jpgImg);
          FreeandNil(jpgImg);
        end;
      ifGIF:
        begin
          gifImg:= TGIFGraphic.Create;
          gifImg.LoadFromStream(iMemStream);
          ImageHolder.Bitmap.Assign(gifImg);
          FreeAndNil(gifImg);
        end;
      ifBMP:
        begin
          bmpImg:= TBitmap.Create;
          bmpImg.LoadFromStream(iMemStream);
          ImageHolder.Bitmap.Assign(bmpImg);
          FreeAndNil(bmpImg);
        end;
    end;
  except
    ImageHolder.Bitmap:= nil; // ensures that there's no image loaded
  end;
  ImageHolder.Canvas.UnLock;

  FreeAndNil(iMemStream);
end;

