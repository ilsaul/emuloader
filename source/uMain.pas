  repeat
    case Item.ImageIndex of
      0: Item.Caption:= 'Title';
      1: Item.Caption:= 'Snap';
      5: Item.Caption:= 'CPanel';
      6: Item.Caption:= 'Cover';
      8: Item.Caption:= 'Game Artwork';
      15: Item.Caption:= 'How To';
    else
         Item.Caption:= ImageCategoryArray[Item.ImageIndex, 1];
    end;
    Item:= DestListView.Groups.NextItem(Item);
  until Item = nil;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

procedure TFormMain.ELV_PopulateSystems(const DestListView: TEasyListView; ShowDisabled: Boolean = True; ShortTitle: Boolean = False; MinIndex: ShortInt = 0; MaxIndex: ShortInt = MaxArcadeSystems);
var
  Loop: ShortInt;
  ShowItem: Boolean;
begin
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;
  for Loop:=MinIndex to MaxIndex do
  begin
    ShowItem:= ShowDisabled;
    if not ShowDisabled then
       ShowItem:= FormMain.ValidateArcadeEmulatorFile(Loop) and IsSystemAvailable(Loop);
    with DestListView.Items.Add do
    begin
      case ShortTitle of
        True : Caption:= GetArcadeSystemShortTitle(Loop);
        False: Caption:= GetArcadeEmulatorDescription(Loop);
      end;
      ImageIndex:= Loop;
      if not ShowItem then
         State:= State+[esosGhosted];
    end;
  end;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

