procedure TFormMain.ButtonGamesMRUClick(Sender: TObject);
var
  Loop: Byte;
  FoundGames: Boolean;
begin
  if (Screen.Width < 1024) or (Screen.Height < 720) then
     begin
       GenerateMessage('Info', 'Access denied.', '   Your screen resolution is to small to display the MRU window.'+#13#10+
                       'Minimum resolution required is 1024x768 or 1280x720.', 2, False, 1);
       Exit;
     end;
  Screen.Cursor:= crHourGlass;
  FoundGames:= False;
  for Loop:= 1 to MaxArcadeSystems do
  begin
    if ValidateFile(GetGamesPlayedIniFile(Loop)) then
       begin
         FoundGames:= True;
         Break;
       end;
  end;
  if not FoundGames then
  begin
    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      if ValidateFile(GetCustomGamePlayedFile(Loop)) then
         begin
           FoundGames:= True;
           Break;
         end;
    end;
  end;
  Screen.Cursor:= crDefault;
  if not FoundGames then
     begin
       GenerateMessage('Info', ButtonGamesMRU.Caption, '    There are no games to show on any available system. Aborting...');
       Exit;
     end;

  ShowFilterMsgBox('Last Played Games (MRU)', 'Parsing games titles from main games list. Wait a moment...', True);

  if not Assigned(FormLastPlayedGamesMega) then
     FormLastPlayedGamesMega:= TFormLastPlayedGamesMega.Create(nil);

  if IsNightMode then
     begin
       SetPopupMenuNightColors(FormLastPlayedGamesMega.PopupLastPlayed);
     end;

  FormLastPlayedGamesMega.ShowModal;
  FreeAndNil(FormLastPlayedGamesMega);
  FocusGamesList;
end;

