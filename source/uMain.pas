function TFormMain.CenterImageSplitter(SplitterHolder: TSplitterEx; CenterAll: Boolean = False): Boolean;
var
  BorderSize: Integer;
  ImageToAdjust: TImage32;
  BothSplittersVisible: Boolean;

  function CheckImageAlignment(ImageHolder: TImage32): Boolean;
  begin
    Result:= False;
    if not Assigned(ImageHolder) then
       Exit;
    if ImageHolder.Align = SplitterHolder.Align then
       begin
         Result:= True;
         ImageToAdjust:= ImageHolder;
       end;
  end;

  function GetImageAlignAllClient: TImage32;
  begin
    // function for tripple layout [1] and [2]
    // only to resize when both splitters are visible!!!
    if Images.Align = alClient then
       Result:= Images
    else
    if ImageScr[2].Align = alClient then
       Result:= ImageScr[2]
    else
       Result:= ImageScr[3];
  end;

begin
  Result:= False;
  if not Assigned(SplitterHolder) then
     Exit;

  BorderSize:= 0;
  if PanelImage.BorderWidth > 0 then
     BorderSize:= 14;
  if ButtonScreenshotLayouts.Tag in [3, 4] then
     begin
       BothSplittersVisible:= Assigned(SplitterImg[1]) and Assigned(SplitterImg[2]);
       // tripple layout [1] and [2]
       if BothSplittersVisible then
          BorderSize:= BorderSize+7; // needs to be divided by 3 and count the extra splitter pixels
     end;

  if CheckImageAlignment(Images) then
     Result:= True
  else
  if CheckImageAlignment(ImageScr[2]) then
     Result:= True
  else
  if CheckImageAlignment(ImageScr[3]) then
     Result:= True;

  if not Result then
     Exit;

  case SplitterHolder.Align of
    alLeft, alRight: // vertical splitter
      begin
        if ButtonScreenshotLayouts.Tag in [3, 4] then // Tripple Layout [1, 2]
           begin
             if BothSplittersVisible then
                begin
                  if CenterAll then
                     ImageToAdjust.Width:= (PanelImage.Width-7-BorderSize) div 3
                  else
                     ImageToAdjust.Width:= (GetImageAlignAllClient.Width+ImageToAdjust.Width) div 2;
                end
             else
                ImageToAdjust.Width:= (PanelImage.Width-7-BorderSize) div 2;
           end
        else
           ImageToAdjust.Width:= (PanelImage.Width-7-BorderSize) div 2;
      end;
    alTop, alBottom: // horizontal splitter
      begin
        if ButtonScreenshotLayouts.Tag in [3, 4] then // Tripple Layout [1, 2]
           begin
             if BothSplittersVisible then
                begin
                  if CenterAll then
                     ImageToAdjust.Height:= (PanelImage.Height-7-BorderSize) div 3
                  else
                     ImageToAdjust.Height:= (GetImageAlignAllClient.Height+ImageToAdjust.Height) div 2;
                end
             else
                ImageToAdjust.Height:= (PanelImage.Height-7-BorderSize) div 2;
           end
        else
           ImageToAdjust.Height:= (PanelImage.Height-7-BorderSize) div 2;
      end;
  end;
end;

procedure TFormMain.ReadScreenshotLayout(LayoutIndex: Byte; out strVar: array of Integer; out boolVar: array of Boolean);
var
  layoutIni: TMemIniFile;
  tmpInt: Integer;
  SectionStr: String;
begin
  layoutIni:= TMemIniFile.Create(GetIniFilesFolder+'screenshot_layouts.ini');
  SectionStr:= GetScrLayoutSection(LayoutIndex);
  case LayoutIndex of
    1: // dual, layout 1
      begin
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'height1', Trunc(PanelImage.Height/2));
        strVar[0]:= tmpInt;
      end;
    2: // dual, layout 2
      begin
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'width1', Trunc(PanelImage.Width/2));
        strVar[0]:= tmpInt;
      end;
    3: // triple, layout 1
      begin
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'height1', Trunc(PanelImage.Height/3));
        strVar[0]:= tmpInt;
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'height3', Trunc(PanelImage.Height/3));
        strVar[1]:= tmpInt;
      end;
    4: // triple, layout 2
      begin
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'width1', Trunc(PanelImage.Width/3));
        strVar[0]:= tmpInt;
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'width3', Trunc(PanelImage.Width/3));
        strVar[1]:= tmpInt;
      end;
    5, 6: // triple, layout 3 >---< triple, layout 4
      begin
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'width1', Trunc(PanelImage.Width/2));
        strVar[0]:= tmpInt;
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'height3', Trunc(PanelImage.Height/2));
        strVar[1]:= tmpInt;
      end;
    7, 8: // triple, layout 5 >---< triple, layout 6
      begin
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'height1', Trunc(PanelImage.Height/2));
        strVar[0]:= tmpInt;
        tmpInt:= layoutIni.ReadInteger(SectionStr, 'width3', Trunc(PanelImage.Width/2));
        strVar[1]:= tmpInt;
      end;
  end;

  ImageDetails[1].ImageCategoryIndex:= layoutIni.ReadInteger(SectionStr, 'image1_category', GetScrLayoutDefaultType(LayoutIndex, 1));
  if LayoutIndex > 0 then
     begin
       ImageDetails[2].ImageCategoryIndex:= layoutIni.ReadInteger(SectionStr, 'image2_category', GetScrLayoutDefaultType(LayoutIndex, 2));
       boolVar[0]:= Boolean(layoutIni.ReadInteger(SectionStr, 'image2_enabled', 1));
     end;
  if LayoutIndex > 2 then
     begin
       ImageDetails[3].ImageCategoryIndex:= layoutIni.ReadInteger(SectionStr, 'image3_category', GetScrLayoutDefaultType(LayoutIndex, 3));
       boolVar[1]:= Boolean(layoutIni.ReadInteger(SectionStr, 'image3_enabled', 1));
     end;
  FreeAndNil(layoutIni);
end;

procedure TFormMain.UpdateScreenshotLayout(LayoutIndex: Byte);
var
  layoutIni: TMemIniFile;
  SectionStr: String;
begin
  if LayoutIndex = 0 then
     Exit;
  layoutIni:= TMemIniFile.Create(GetIniFilesFolder+'screenshot_layouts.ini');
  SectionStr:= GetScrLayoutSection(LayoutIndex);
  case LayoutIndex of
    1: // dual, layout 1
      begin
        layoutIni.WriteInteger(SectionStr, 'height1', Images.Height);
      end;
    2: // dual, layout 2
      begin
        layoutIni.WriteInteger(SectionStr, 'width1', Images.Width);
      end;
    3: // triple, layout 1
      begin
        layoutIni.WriteInteger(SectionStr, 'height1', Images.Height);
        if Assigned(ImageScr[3]) then
           layoutIni.WriteInteger(SectionStr, 'height3', ImageScr[3].Height);
      end;
    4: // triple, layout 2
      begin
        layoutIni.WriteInteger(SectionStr, 'width1', Images.Width);
        if Assigned(ImageScr[3]) then
           layoutIni.WriteInteger(SectionStr, 'width3', ImageScr[3].Width);
      end;
    5, 6: // triple, layout 3 >---< triple, layout 4
      begin
        if Assigned(ImageScr[2]) then
           layoutIni.WriteInteger(SectionStr, 'width1', Images.Width);
        if Assigned(ImageScr[3]) then
        layoutIni.WriteInteger(SectionStr, 'height3', ImageScr[3].Height);
      end;
    7, 8: // triple, layout 5 >---< triple, layout 6
      begin
        if Assigned(ImageScr[2]) then
           layoutIni.WriteInteger(SectionStr, 'height1', Images.Height);
        if Assigned(ImageScr[3]) then
           layoutIni.WriteInteger(SectionStr, 'width3', ImageScr[3].Width);
      end;
  end;
  layoutIni.UpdateFile;
  FreeAndNil(layoutIni);
end;

procedure TFormMain.ImageSplitterMovedUpd(Sender: TObject);
begin
  UpdateImageDimensionsInfo;
end;

procedure TFormMain.SetImageLayout;
var
  ImgSize: array[0..1] of Integer;
  ImageEnabled: array[0..1] of Boolean;
  Continue: Boolean;

  function DestroySplitter(Index: ShortInt): Boolean;
  begin
    if Assigned(SplitterImg[Index]) then
       FreeAndNil(SplitterImg[Index]);
    Result:= not Assigned(SplitterImg[Index]);
  end;

  function DestroyImageScr(Index: ShortInt): Boolean;
  begin
    if Assigned(ImageScr[Index]) then
       begin
         ImageScr[Index].Bitmap:= nil;
         FreeAndNil(ImageScr[Index]);
       end;
    Result:= not Assigned(ImageScr[Index]);
  end;

  function DestroyImagePnl: Boolean;
  begin
    if Assigned(ImagePnl) then
       FreeAndNil(ImagePnl);
    Result:= not Assigned(ImagePnl);
  end;

  function CreateSplitter(Index: ShortInt; imgAlignment: TAlign; imgParentComponent, AlignComponent: TWinControl): Boolean;
  begin
    if SplitterImg[Index] = nil then
       begin
         SplitterImg[Index]:= TSplitterEx.Create(nil);//Self);
         SplitterImg[Index].Parent:= imgParentComponent;
         SplitterImg[Index].Style:= TTMSStyle(tsSolidColor);
         case FormPreferences.ImageEnableGripIcon.Checked of
           True : SplitterImg[Index].GripStyle:= sgDots;
           False: SplitterImg[Index].GripStyle:= sgNone;
         end;
         SplitterImg[Index].PopupMenu:= PopupSplitters;
         SplitterImg[Index].OnMoved:= ImageSplitterMovedUpd;
       end
    else
       begin
         if SplitterImg[Index].Parent <> imgParentComponent then
            SplitterImg[Index].Parent:= imgParentComponent;
       end;

    SplitterImg[Index].Width:= 7;
    SplitterImg[Index].Height:= 7;
    case imgAlignment of
      alLeft: SplitterImg[Index].Left:= AlignComponent.Width+7;
      alTop: SplitterImg[Index].Top:= AlignComponent.Height+7;
      alRight: SplitterImg[Index].Left:= AlignComponent.Left-7;
      alBottom: SplitterImg[Index].Top:= AlignComponent.Top-7;
    end;
    if SplitterImg[Index].Align <> imgAlignment then
       SplitterImg[Index].Align:= imgAlignment;

    Result:= Assigned(SplitterImg[Index]);
  end;

  function CreatePanel(imgAlignment: TAlign): Boolean;
  begin
    if ImagePnl = nil then
       begin
         ImagePnl:= TPanel.Create(Self);
         ImagePnl.Parent:= PanelImage;
         ImagePnl.BevelOuter:= bvNone;
         ImagePnl.Caption:= '';
         ImagePnl.Align:= imgAlignment;
       end
    else
       begin
         if ImagePnl.Align <> imgAlignment then
            ImagePnl.Align:= imgAlignment;
       end;
    Result:= Assigned(ImagePnl);
  end;

  function CreateImage(Index: ShortInt; imgAlignment: TAlign; imgParentComponent: TWinControl): Boolean;
  begin
    if ImageScr[Index] = nil then
       begin
         ImageScr[Index]:= TImage32.Create(Self);
         ImageScr[Index].Parent:= imgParentComponent;
         if ImageDetails[Index].ImageCategoryIndex > -1 then
            begin
              ImageScr[Index].Color:= PopupMenuImageCategories.Items[ImageDetails[Index].ImageCategoryIndex].Tag;
              ImageScr[Index].Hint:= PopupMenuImageCategories.Items[ImageDetails[Index].ImageCategoryIndex].Caption;
            end;
         ImageScr[Index].ShowHint:= True;
         ImageScr[Index].BitmapAlign:= baCenter;
         ImageScr[Index].ScaleMode:= Images.ScaleMode;
         ImageScr[Index].Bitmap.DrawMode:= dmBlend;
         ImageScr[Index].Align:= imgAlignment;
         SetResampler(ImageScr[Index]);
         ImageScr[Index].PopupMenu:= PopupMenuImages;
       end
    else
       begin
         if ImageScr[Index].Parent <> imgParentComponent then
            ImageScr[Index].Parent:= imgParentComponent;
         if ImageScr[Index].Align <> imgAlignment then
            ImageScr[Index].Align:= imgAlignment;
       end;
    Result:= Assigned(ImageScr[Index]);
  end;

  function AlignMainImage(imgAlignment: TAlign; imgParentComponent: TWinControl): Boolean;
  begin
    if Images.Parent <> imgParentComponent then
       Images.Parent:= imgParentComponent;
    if Images.Align <> imgAlignment then
       Images.Align:= imgAlignment;
    Images.Color:= PopupMenuImageCategories.Items[ImageDetails[1].ImageCategoryIndex].Tag;
    //PanelImage.Color:= Images.Color;
    //PanelScreenshotsArea.Color1:= PanelImage.Color;
    if ButtonScreenshotLayouts.Tag = 0 then
       Images.Hint:= ''
    else
       Images.Hint:= PopupMenuImageCategories.Items[ImageDetails[1].ImageCategoryIndex].Caption;
    Result:= True;
  end;

  function DestroyAll: Boolean;
  begin
    Result:= True;
    DestroySplitter(1);
    DestroySplitter(2);
    DestroyImageScr(2);
    DestroyImageScr(3);
    DestroyImagePnl;
  end;

begin
  //if IsStartup then
  //   Exit;
  Continue:= True;
  if not IsImageLayoutView then
     begin
       PanelScreenshotsArea.Canvas.Lock;
       AlignMainImage(alClient, PanelImage);
       DestroyAll;
       ImageDetails[1].ImageCategoryIndex:= ButtonImageCategory.Tag;
       Images.Hint:= '';
       PanelScreenshotsArea.Canvas.Unlock;
       if MenuShowImages.Checked then
          MenuShowImages.OnClick(Self);
       Exit;
     end;

  PanelScreenshotsArea.Canvas.Lock;
  if FormStatus.Visible then
     FormStatus.MessageStr('Initializing layout image panels.');

  ReadScreenshotLayout(ButtonScreenshotLayouts.Tag, ImgSize, ImageEnabled);
  case ButtonScreenshotLayouts.Tag of
    1, 2:
      begin
        Continue:= ImageEnabled[0];
        if not Continue then
           AlignMainImage(alClient, PanelImage);
      end;
    3..8:
      begin
        Continue:= ImageEnabled[0] or ImageEnabled[1];
        if not Continue then
           AlignMainImage(alClient, PanelImage);
      end;
  end;

  case Continue of
    True:
      begin
        case ButtonScreenshotLayouts.Tag of
          0: // single
            begin
              AlignMainImage(alClient, PanelImage);
              DestroyAll;
            end;
          1: // dual, layout 1
            begin
              AlignMainImage(alNone, PanelImage);
              DestroyAll;
              case ImageEnabled[0] of
                True:
                  begin
                    AlignMainImage(alTop, PanelImage);
                    Images.Height:= ImgSize[0];
                    CreateSplitter(1, alTop, PanelImage, Images);
                    CreateImage(2, alClient, PanelImage);
                  end;
                False:
                  begin
                    AlignMainImage(alClient, PanelImage);
                  end;
              end;
            end;
          2: // dual, layout 2
            begin
              AlignMainImage(alNone, PanelImage);
              DestroyAll;
              case ImageEnabled[0] of
                True:
                  begin
                    AlignMainImage(alLeft, PanelImage);
                    Images.Width:= ImgSize[0];
                    CreateSplitter(1, alLeft, PanelImage, Images);
                    CreateImage(2, alClient, PanelImage);
                  end;
                False:
                  begin
                    AlignMainImage(alClient, PanelImage);
                  end;
              end;
            end;
          3:
            begin
              // triple, layout 1
              AlignMainImage(alTop, PanelImage); // image_1 is always top aligned!!!
              DestroyAll;
              Images.Height:= ImgSize[0];
              CreateSplitter(1, alTop, PanelImage, Images);
              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   CreateImage(3, alBottom, PanelImage);
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(2, alBottom, PanelImage, ImageScr[3]);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[0] then
                 CreateImage(2, alClient, PanelImage)
              else
              if ImageEnabled[1] then
                 CreateImage(3, alClient, PanelImage);
            end;
          4:
            begin
              // triple, layout 2
              AlignMainImage(alLeft, PanelImage); // image_1 is always left aligned!!!
              DestroyAll;
              Images.Width:= ImgSize[0];
              CreateSplitter(1, alLeft, PanelImage, Images);
              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   CreateImage(3, alRight, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alRight, PanelImage, ImageScr[3]);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[0] then
                 CreateImage(2, alClient, PanelImage)
              else
              if ImageEnabled[1] then
                 CreateImage(3, alClient, PanelImage);
            end;
          5:
            begin
              // triple, layout 3
              AlignMainImage(alNone, PanelImage);
              DestroyAll;

              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(3, alTop, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(2, alTop, PanelImage, ImageScr[3]); // only difference!!!!!!
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alTop, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(1, alTop, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
          6:
            begin
              // triple, layout 4
              AlignMainImage(alNone, PanelImage);
              DestroyAll;
              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(3, alBottom, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(2, alBottom, PanelImage, ImageScr[3]); // only difference!!!!!!
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alBottom, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(1, alBottom, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
          7:
            begin
              // triple, layout 5
              AlignMainImage(alNone, PanelImage);
              DestroyAll;

              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   CreateImage(3, alLeft, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alLeft, PanelImage, ImageScr[3]);
                   CreatePanel(alClient);
                   AlignMainImage(alTop, ImagePnl);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, ImagePnl, Images);
                   CreateImage(2, alClient, ImagePnl);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alTop, PanelImage);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alLeft, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alLeft, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
          8:
            begin
              // triple, layout 6
              AlignMainImage(alNone, PanelImage);
              DestroyAll;

              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   // need to change this... ??? not sure if still needed (Feb 03, 2014)
                   // 1. make ImageScr[3].Align = alRight and set its width
                   // 2. make Splitter(2) Aligh = alRight for ImageScr[3]
                   // 3. make ImagePnl.Align = alClient
                   CreateImage(3, alRight, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alRight, PanelImage, ImageScr[3]);
                   CreatePanel(alClient); // "ImagePnl"
                   AlignMainImage(alTop, ImagePnl);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, ImagePnl, Images);
                   CreateImage(2, alClient, ImagePnl);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alTop, PanelImage);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alRight, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alRight, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
        end;
      end;
    False:
      begin
        DestroyAll;
      end;
  end;
  ButtonScreenshotLayouts.Hint:= 'Layout -> '+PopupScreenshotLayouts.Items[ButtonScreenshotLayouts.Tag].Caption+' <-';
  UpdateImageLayoutSplittersStyle;
  PanelScreenshotsArea.Canvas.Unlock;
  if MenuShowImages.Checked then
     begin
       if not IsStartUp then
          InitImgZipLists;
       ToggleImagesPanel;
     end;
end;

procedure TFormMain.SetGripIcon(var SplitterHolder: TSplitterEx; ShowGrip: Boolean);
begin
  if not Assigned(SplitterHolder) then
     Exit;
  case ShowGrip of
    True : SplitterHolder.GripStyle:= sgDots;
    False: SplitterHolder.GripStyle:= sgNone;
  end;
end;

procedure TFormMain.UpdateSplitterStyle(SplitterHolder: TSplitterEx; NewSplitterStyle: TTMSStyle; SingleColor, SingleColorHot: TColor);
begin
  if not Assigned(SplitterHolder) then
     Exit;

  if SplitterHolder.Style <> NewSplitterStyle then
     SplitterHolder.Style:= NewSplitterStyle;
  if NewSplitterStyle = tsSolidColor then
     begin
       if SplitterHolder.Appearance.SingleColor <> SingleColor then
          SplitterHolder.Appearance.SingleColor:= SingleColor;
       if SplitterHolder.Appearance.SingleColorHot <> SingleColorHot then
          SplitterHolder.Appearance.SingleColorHot:= SingleColorHot;
     end;
end;

procedure TFormMain.UpdateImageLayoutSplittersStyle;
begin
  if IsImageLayoutView then
     begin
       UpdateSplitterStyle(SplitterImg[1], TTMSStyle(tsSolidColor),
                           FormPreferences.ImageLayoutSplitterSingleColor.Selected,
                           FormPreferences.ImageLayoutSplitterSingleColorHot.Selected);
       UpdateSplitterStyle(SplitterImg[2], TTMSStyle(tsSolidColor),
                           FormPreferences.ImageLayoutSplitterSingleColor.Selected,
                           FormPreferences.ImageLayoutSplitterSingleColorHot.Selected);
       SetGripIcon(SplitterImg[1], PopupImageShowSplitterGrip.Checked);
       SetGripIcon(SplitterImg[2], PopupImageShowSplitterGrip.Checked);
     end;
end;

procedure TFormMain.PopupScrLayoutSingleClick(Sender: TObject);
begin
  if IsImageLayoutView then
     begin
       if TMenuItem(Sender).Tag = ButtonScreenshotLayouts.Tag then
          TMenuItem(Sender).Checked:= True;
       if (not IsStartup) and (MenuImageCategoryLayoutSettings.Tag = 1) then
          UpdateScreenshotLayout(ButtonScreenshotLayouts.Tag);
       MenuImageCategoryLayoutSettings.Tag:= 1; // need to set Tag=1 to allow
       // saving layout settings next time layout changes
       ButtonScreenshotLayouts.Tag:= TMenuItem(Sender).Tag;
       SetIcon(IL_ScreenshotLayouts_Small, nil, IL_ImagesToolBarButtons, ButtonScreenshotLayouts.Tag, 5);
     end;
  ClearScreenshots;
  if not IsStartUp then
     begin
       FreeImageZipVars;
       InitImgZipLists(True); // clear zip images arrays
     end;
  SetImageLayout;

  if not Assigned(FormLayoutDimensions) then
     Exit;
  LoadImageLayoutPreview(ButtonScreenshotLayouts.Tag);
  UpdateImageDimensionsInfo;
end;

procedure TFormMain.UpdateImageDimensionsInfo;
var
  SizeString: String;
  BorderSize: Integer;

  function GetImgSize(ImageHolder: TImage32; ImageIndex: Integer): Boolean;
  begin
    Result:= Assigned(ImageHolder);
    if not Result then
       begin
         case ImageIndex of
           1: FormLayoutDimensions.LabelImage1Dimensions.Caption:= 'Hidden';
           2: FormLayoutDimensions.LabelImage2Dimensions.Caption:= 'Hidden';
           3: FormLayoutDimensions.LabelImage3Dimensions.Caption:= 'Hidden';
         end;
         Exit;
       end;

    SizeString:= Format('%ux%u pixels', [ImageHolder.Width, ImageHolder.Height]);
    case ImageIndex of
      1: FormLayoutDimensions.LabelImage1Dimensions.Caption:= SizeString;
      2: FormLayoutDimensions.LabelImage2Dimensions.Caption:= SizeString;
      3: FormLayoutDimensions.LabelImage3Dimensions.Caption:= SizeString;
    end;
  end;

begin
  if not Assigned(FormLayoutDimensions) then
     Exit;

  if FormLayoutDimensions.LabelLayoutTitle.Tag <>  ButtonScreenshotLayouts.Tag then
     begin
       FormLayoutDimensions.LabelLayoutTitle.Tag:= ButtonScreenshotLayouts.Tag;
       FormLayoutDimensions.LabelImage2.Visible:= ButtonScreenshotLayouts.Tag > 0;
       FormLayoutDimensions.LabelImage2Dimensions.Visible:= FormLayoutDimensions.LabelImage2.Visible;
       FormLayoutDimensions.LabelImage3.Visible:= ButtonScreenshotLayouts.Tag > 2;
       FormLayoutDimensions.LabelImage3Dimensions.Visible:= FormLayoutDimensions.LabelImage3.Visible;
     end;
     
  if PanelImage.BorderWidth = 0 then
     BorderSize:= 0
  else
     BorderSize:= 14;
  FormLayoutDimensions.LabelImagesPanelDimensions.Caption:= Format('%ux%u pixels', [PanelImage.Width-BorderSize, PanelImage.Height-BorderSize]);
  GetImgSize(Images, 1);
  GetImgSize(ImageScr[2], 2);
  GetImgSize(ImageScr[3], 3);
end;

procedure TFormMain.PopupImageCenterAllSplittersClick(Sender: TObject);
begin
  CenterImageSplitter(SplitterImg[1], True);
  CenterImageSplitter(SplitterImg[2], True);
  UpdateImageDimensionsInfo;
end;

procedure TFormMain.GamesListViewItemFreeing(Sender: TCustomEasyListview;
  Item: TEasyItem);
begin
  TEasyGameInfo(Item).eThumbnail.Free;
  TEasyGameInfo(Item).eThumbnail:= nil;
  FreeAndNil(TEasyGameInfo(Item).fThumbnail);
  
  
  //TEasyGameInfo(Item).eIcon.Free; // for future improvement ? can't make EL show icons correctly without using a TImageList component :_(( 
  //TEasyGameInfo(Item).eIcon:= nil; // for future improvement ?

  if TEasyGameInfo(Item).eROMInfo <> nil then
     begin
       TEasyGameInfo(Item).eROMInfo.Clear;
       TEasyGameInfo(Item).eROMInfo.Free;
       TEasyGameInfo(Item).eROMInfo:= nil;
     end;

  if TEasyGameInfo(Item).eDeviceSets <> nil then
     begin
       TEasyGameInfo(Item).eDeviceSets.Clear;
       TEasyGameInfo(Item).eDeviceSets.Free;
       TEasyGameInfo(Item).eDeviceSets:= nil;
     end;

  if Length(TEasyGameInfo(Item).eSoftwareList) > 0 then
     begin
       SetLength(TEasyGameInfo(Item).fSoftwareList, 0);
       TEasyGameInfo(Item).eSoftwareList:= TEasyGameInfo(Item).fSoftwareList;
     end;

  if Item = SelectedEasyItem then
     SelectedEasyItem:= nil;
end;

procedure TFormMain.GamesListViewItemSelectionChanged(
  Sender: TCustomEasyListview; Item: TEasyItem);
begin
  if (Sender.Visible) and (GamesListView.Selection.Count = 1) and
     (Item.Selected) then
     begin
       if SelectedEasyItem <> Item then
          SelectedEasyItem:= Item;
       if GetGameDataListView(SelectedEasyItem) then
          begin
            //if not IsStartup then
               SetSelectedGame;
          end;
     end;
end;

procedure TFormMain.GamesListViewIncrementalSearch(
  Item: TEasyCollectionItem; const SearchBuffer: WideString;
  var Handled: Boolean; var CompareResult: Integer);
var
  EntryText: String;
begin
