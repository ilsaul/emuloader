procedure TFormMain.VerifyKeyActions(var CharCode: Word; var Shift: TShiftState);
var
  Item: TEasyItem;

  function SelectParentSet: Boolean;
  var
    lvItem: TEasyItem;
    sysID: Integer;
  begin
    if not ValidateSelectedGame then
       Exit;
    if not GameIsClone(MemGameInfo.eClone) then
       Exit;

    case MemGameInfo.eIsCustomGame of
      True : sysID:= MemGameInfo.eCustomSystemID;
      False: sysID:= MemGameInfo.eSystemID;
    end;

    FindGameName(MemGameInfo.eClone, sysID, MemGameInfo.eIsCustomGame, MemGameInfo.eSoftwareName, lvItem, False);

    if lvItem <> nil then
       SelectEasyItem(lvItem);
  end;

  function ToggleGamesViewMode: Boolean;
  begin
    Result:= True;
    if (ButtonViewMode.Tag+1) > PopupMenuViewMode.Items.Count-1 then
       PopupMenuViewMode.Items[0].Click
    else
       PopupMenuViewMode.Items[ButtonViewMode.Tag+1].Click;
  end;

  {function CheckNumPadKeys: Boolean;
  begin
    // for X-Arcade and HotRod SE only...
    Result:= CharCode in [VK_NUMPAD8, VK_NUMPAD2, VK_NUMPAD4, VK_NUMPAD6];
    if not Result then
       Exit;
    case CharCode of
      VK_NUMPAD8: // Numpad Up key
        begin
          if Shift = [ssShift] then
             KeyBd_Event(VK_PRIOR, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Page Up" key pressing
          else
          if Shift = [ssCtrl] then
             KeyBd_Event(VK_HOME, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Home Key" key pressing
          else
             KeyBd_Event(VK_UP, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Up (8)" key pressing
        end;
      VK_NUMPAD2: // Numpad Down key
        begin
          if Shift = [ssShift] then
             KeyBd_Event(VK_NEXT, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Page Down" key pressing
          else
          if Shift = [ssCtrl] then
             KeyBd_Event(VK_END, 0, 0, KEYEVENTF_KEYUP) // Simutate a "End Key" key pressing
          else
             KeyBd_Event(VK_DOWN, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Down (2)" key pressing
        end;
      VK_NUMPAD4: KeyBd_Event(VK_LEFT, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Left (4)" key pressing
      VK_NUMPAD6: KeyBd_Event(VK_RIGHT, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Right (6)" key pressing
    end;
  end;}

  function CheckGeneralArcadeKeys: Boolean;
  begin
    Result:= True;
    if CharCode = Ord('1') then // Player 1 Start button starts game with default options
       begin
         case MemGameInfo.eIsCustomGame of
           True : ExecuteGameCustom;
           False: PopupPlayGameStandard.Click
         end;
       end
    else
    if CharCode = Ord('R') then
       begin
         if MenuArcadeBrowseGames.Tag <> 3 then
            begin
              case IsImageLayoutView of
                False: CycleImageCategory(False); // classic
                True : CycleImageLayout(False); // layouts
              end;
            end
         else
            begin
              case IsImageLayoutView of
                False: CycleImageCategory(MenuArcadeControlSlikStik_SwapStick.Checked); // classic
                True : CycleImageLayout(MenuArcadeControlSlikStik_SwapStick.Checked); // layouts
              end;
            end;
       end
    else
    if CharCode = Ord('F') then
       begin
         if MenuArcadeBrowseGames.Tag <> 3 then
            begin
              case IsImageLayoutView of
                False: CycleImageCategory(True); // classic
                True : CycleImageLayout(True); // layouts
              end;
            end
         else
            begin
              case IsImageLayoutView of
                False: CycleImageCategory(not MenuArcadeControlSlikStik_SwapStick.Checked); // classic
                True : CycleImageLayout(not MenuArcadeControlSlikStik_SwapStick.Checked); // layouts
              end;
            end;
       end
    else
    if CharCode = Ord('D') then
       ButtonPreviousImage.Click
    else
    if CharCode = Ord('G') then
       ButtonNextImage.Click
    else
    if CharCode = Ord('Z') then
       MenuViewFullScreen.Click
    else
    if CharCode = Ord('W') then
       PopupEnableMAMu_Icons.Click // Simulate use MAMu_ icons pressing
    else
    if CharCode = Ord('A') then
       PopupAutomaticGameInformation.Click // Simulate auto game info pressing (hotkey F3)
    else
    if CharCode = VK_SPACE then
       begin
         //ButtonLeftPanelFilters.Down:= not ButtonLeftPanelFilters.Down;
         //ButtonLeftPanelFilters.Click; // Toggle Left Panel ON/OFF
       end
    else
    if CharCode = Ord('X') then
       ButtonImageViewMode.Click // Toggle between images categories and images layouts
    else
    if CharCode = Ord('W') then
       PopupEnableMAMu_Icons.Click // Toggle MAMu_ icons (enabled/disabled)
    else
    if (CharCode = VK_UP) and (Shift = [ssShift]) then
       KeyBd_Event(VK_PRIOR, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Page Up" key pressing
    else
    if (CharCode = VK_DOWN) and (Shift = [ssShift]) then
       KeyBd_Event(VK_NEXT, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Page Down" key pressing
    else
    if (CharCode = VK_UP) and (Shift = [ssCtrl]) and (MenuArcadeBrowseGames.Tag <> 3) then
       KeyBd_Event(VK_HOME, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Home Key" key pressing
    else
    if (CharCode = VK_DOWN) and (Shift = [ssCtrl]) and (MenuArcadeBrowseGames.Tag <> 3) then
       KeyBd_Event(VK_END, 0, 0, KEYEVENTF_KEYUP) // Simutate a "End Key" key pressing
    else
       Result:= False;
  end;

begin
  // 0: Keyboard+Mouse
  // 1: Devastator II
  // 2: HotRod SE
  // 3: SlikStik
  // 4: X-Arcade
  case MenuArcadeBrowseGames.Tag of
    0: // disabled
      begin
        if CharCode = VK_F6 then
           MenuShowImages.Click
        else
        if CharCode = VK_F11 then
           ButtonPreviousImage.Click
        else
        if CharCode = VK_F12 then
           ButtonNextImage.Click
        else
        if (CharCode = VK_F9) and (Shift = [ssCtrl]) then
           begin          
             case IsImageLayoutView of
               False: CycleImageCategory(False); // classic
               True : CycleImageLayout(False); // layouts
             end;
           end
        else
        if CharCode = VK_F9 then
           begin
             case IsImageLayoutView of
               False: CycleImageCategory(True); // classic
               True : CycleImageLayout(True);// layouts
             end;
           end
        else
        if (CharCode = Ord('R')) and (Shift = [ssCtrl]) then
           SelectRandomGame(GamesListView, SelectedEasyItem)
        else
        if (CharCode = Ord('T')) and (Shift = [ssCtrl]) then
           ToolBarPanel.Visible:= not ToolBarPanel.Visible
        else
        if (CharCode = Ord('I')) and (Shift = [ssCtrl]) then
           MenuImagesEnableToolBar.Click
        else
        if (CharCode = Ord('M')) and (Shift = [ssCtrl]) then
           PopupEnableMAMu_Icons.Click
        else
        if (CharCode = VK_F3) and (Shift = [ssCtrl]) then
           ToggleFavoriteLastFilter
        else
        if (CharCode = VK_SPACE) and (Shift = [ssCtrl]) then
           begin
             Item:= GamesListView.Selection.FocusedItem;
             if Item <> nil then
                Item.Selected:= not Item.Selected;
           end;
      end;
    2, 4: // HotRod SE and X-Arcade
      begin
        {if CheckNumPadKeys then
           begin
             // do nothing as NumPad key press was detected
           end
        else}
        if (CharCode in [VK_NUMPAD8, VK_NUMPAD2, VK_NUMPAD4, VK_NUMPAD6]) then
           begin
             case CharCode of
               VK_NUMPAD8: // Numpad Up key
                 begin
                   if Shift = [ssShift] then
                      KeyBd_Event(VK_PRIOR, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Page Up" key pressing
                   else
                   if Shift = [ssCtrl] then
                      KeyBd_Event(VK_HOME, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Home Key" key pressing
                   else
                      KeyBd_Event(VK_UP, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Up (8)" key pressing
                 end;
               VK_NUMPAD2: // Numpad Down key
                 begin
                   if Shift = [ssShift] then
                      KeyBd_Event(VK_NEXT, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Page Down" key pressing
                   else
                   if Shift = [ssCtrl] then
                      KeyBd_Event(VK_END, 0, 0, KEYEVENTF_KEYUP) // Simutate a "End Key" key pressing
                   else
                      KeyBd_Event(VK_DOWN, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Down (2)" key pressing
                 end;
               VK_NUMPAD4: KeyBd_Event(VK_LEFT, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Left (4)" key pressing
               VK_NUMPAD6: KeyBd_Event(VK_RIGHT, 0, 0, KEYEVENTF_KEYUP); // Simutate a "Numpad Right (6)" key pressing
             end;
           end
        else
        //if (CharCode = Ord('5')) and (MenuArcadeBrowseGames.Tag = 4) then
        if ((CharCode = Ord('5')) and (MenuArcadeBrowseGames.Tag = 4)) or // for X-Arcade
           ((CharCode = Ord('2')) and (MenuArcadeBrowseGames.Tag = 2)) // for HotRod SE
         then
           begin
             SelectParentSet;
             //if PopupSelectSet.Count > 0 then
             //begin
             //  if PopupSelectSet.Items[0].ImageIndex = 1000 then // select parent game menu item has ImageIndex:= 1000;
             //     PopupSelectSet.Items[0].Click;
             //end;
           end
        else
        if CharCode = Ord('3') then
           ToggleGamesViewMode // cycle between games view modes
        else
        if CharCode = Ord('4') then
           PopupEnableFavorites.Click // Togle favorites / normal filter
        else
        if CharCode = Ord('C') then
           PopupSelectaRandomGame.Click // Simulate a "Random Game" click
           //SelectRandomGame(GamesListView, SelectedEasyItem) // Simulate a "Random Game" click
        else
        if CharCode = Ord('E') then
           MenuShowImages.Click // Toggle images ON/OFF
        else
        if CharCode = Ord('{') then
           ButtonGameFilterMain.Click // Select games filter
        else
        if CharCode = VK_SPACE then
           ButtonPlayVideoPreview.Click // play video preview
        else
           CheckGeneralArcadeKeys
      end;
    3: // SlikStik
      begin
        // player 1 stick uses regular arrow keys
        if CharCode = Ord('6') then
           ToggleGamesViewMode // cycle between games view modes
        else
        if CharCode = Ord('5') then
           PopupEnableFavorites.Click //ButtonGameFilterFavorites.Click // Togle favorites / normal filter
        else
        if CharCode = Ord('7') then
           KeyBd_Event(VK_HOME, 0, 0, KEYEVENTF_KEYUP) // Simutate a "Home Key" key pressing
        else
        if CharCode = Ord('0') then
           KeyBd_Event(VK_END, 0, 0, KEYEVENTF_KEYUP) // Simutate a "End Key" key pressing
        else
        if CharCode = Ord('H') then
           PopupSelectaRandomGame.Click // Simulate a "Random Game" click
           //SelectRandomGame(GamesListView, SelectedEasyItem) // Simulate a "Random Game" click
        else
        if CharCode = Ord('2') then
           begin
             SelectParentSet;
             //if PopupSelectSet.Count > 0 then
             //begin
             //  if PopupSelectSet.Items[0].ImageIndex = 1000 then // select parent game menu item has ImageIndex:= 1000;
             //     PopupSelectSet.Items[0].Click;
             //end;
           end
        else
        if CharCode = Ord('I') then
           MenuShowImages.Click // Toggle images ON/OFF
        else
        if CharCode = Ord('K') then
           ButtonGameFilterMain.Click // Select games filter
        else
        if CharCode = Ord('9') then
           ButtonPlayVideoPreview.Click // play video preview
        else
           CheckGeneralArcadeKeys;
      end;
    1: // Devastator II
      begin
        // player 1 stick uses regular arrow keys
        if CharCode = Ord('V') then
           ToggleGamesViewMode // cycle between games view modes
        else
        if CharCode = Ord('L') then
           PopupEnableFavorites.Click // Togle favorites / normal filter
        else
        if CharCode = Ord('K') then
           PopupSelectaRandomGame.Click // Simulate a "Random Game" click
           //SelectRandomGame(GamesListView, SelectedEasyItem) // Simulate a "Random Game" click
        else
        if CharCode = Ord('I') then
           MenuShowImages.Click // Toggle images ON/OFF
        else
        if CharCode = Ord('5') then
           ButtonGameFilterMain.Click // Select games filter
        else
        if CharCode = Ord('2') then
           begin
             SelectParentSet;
             //if PopupSelectSet.Count > 0 then
             //begin
             //  if PopupSelectSet.Items[0].ImageIndex = 1000 then // select parent game menu item has ImageIndex:= 1000;
             //     PopupSelectSet.Items[0].Click;
             //end;
           end
        else
        if CharCode = VK_SPACE then
           ButtonPlayVideoPreview.Click // play video preview
        else
           CheckGeneralArcadeKeys;
      end;
  end;
end;

