procedure TFormMain.MenuCustomEmuParametersPopup(Sender: TObject);
var
  paramIniFile: TMemIniFile;
  EmulatorString, EmuParameters: String;
begin
  if not CheckSelected(GamesListView) then
     begin
       PostMessage(Handle, WM_LBUTTONDOWN, MK_LBUTTON, 0);
       PostMessage(Handle, WM_LBUTTONUP, MK_LBUTTON, 0);
       Exit;
     end;
  if MemGameInfo.eCustomSystemID = -1 then
     begin
       // if it's not a console/computer game or if the custom system ID is not set, do not show the popup menu
       PostMessage(Handle, WM_LBUTTONDOWN, MK_LBUTTON, 0);
       PostMessage(Handle, WM_LBUTTONUP, MK_LBUTTON, 0);
       Exit;
     end;
     
  EmulatorString:=  EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]];
  if EmulatorString = '' then
     begin
       PopupUseCustomEmuParameter1.Hint:= '(empty)';
       PopupUseCustomEmuParameter2.Hint:= '(empty)';
       Exit;
     end
  else
     begin
       // nothing to do here ? (February 13, 2018)
       //if not SameText(ExtractFileExt(EmulatorString), '.exe') then
       //   Exit;
     end;
  if not ValidateFile(GetEmuParametersFile) then
     begin
       CallMessageBox;
       AddMsgText('    File ');
       AddMsgText(GetEmuParametersFile, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText('was not found! Emulator parameters must be '+
                  'placed in this file. Cannot show parameters...');
       GenerateMessage('Show Emulator Parameters', MemGameInfo.eTitle, '', 2, False, 1);
       Exit;
     end;
  paramIniFile:= TMemIniFile.Create(GetEmuParametersFile);
  EmulatorString:= ExtractFileName(ChangeFileExt(EmulatorString, ''));
  EmuParameters:= paramIniFile.ReadString(SystemsListCustom[MemGameInfo.eCustomSystemID, 0],
                                       EmulatorString+
                                       GetMediaTypeName(MenuCustomEmuParameters.HelpContext, 1, True), '');

  if EmuParameters <> '' then
     PopupUseCustomEmuParameter1.Hint:= EmuParameters
  else
     PopupUseCustomEmuParameter1.Hint:= '(empty)';

  // get parameter 2
  EmuParameters:= paramIniFile.ReadString(SystemsListCustom[MemGameInfo.eCustomSystemID, 0],
                                       EmulatorString+
                                       GetMediaTypeName(MenuCustomEmuParameters.HelpContext, 2, True), '');

  if EmuParameters <> '' then
     PopupUseCustomEmuParameter2.Hint:= EmuParameters
  else
     PopupUseCustomEmuParameter2.Hint:= '(empty)';

  FreeAndNil(paramIniFile);
end;

