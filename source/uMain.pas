procedure TFormMain.SetGameType(LoadFiles: Boolean);
//var
  //sClock: Integer;
begin
  //sClock:= GetTickCount;
  if not CreatingGamesList then
     begin
       if not IsStartup then
       begin
         if not FormStatus.Visible then
         begin
           if LoadFiles then
              begin
                FormStatus.Show;
                FormStatus.StartThreadClock;
              end
           else
              begin
                ShowFilterMsgBox('Games Filters', 'Applying filters, please wait...');
              end;
         end;
       end;
     end;

  if LoadFiles then
     LoadGames(True, True, True, True);

  if CreatingGamesList then
     Exit;

  if not PanelMachinesList.Visible then
     ApplyFilters
  else
     ApplyFiltersMachinesList;

  if not LoadFiles then
     HideFilterMsgBox;
  FocusGamesList;
  //ShowMessage(IntToStr(GetTickCount-sClock));
end;

procedure TFormMain.ButtonViewImage(ButtonCode: ShortInt);

  function CheckAutoCycle: Boolean;
  begin
    case IsImageLayoutView of
      False: // classic view
        begin
          Result:= MenuImageCategoryPrevNextAutoSwitch.Checked;
          if Result then
             CycleImageCategory(Boolean(ButtonCode));
        end;
      True: // layout view
        begin
          Result:= MenuImageLayoutPrevNextAutoSwitch.Checked;
          if Result then
             CycleImageLayout(Boolean(ButtonCode));
        end;
      else
        Result:= False;
    end;
  end;

begin
  if not CheckTotal(GamesListView) then
     Exit;
  if not MenuShowImages.Checked then
     Exit;

  case ButtonCode of
    1:
      begin
        Images.Tag:= Images.Tag+1; // next Button
        if Images.Tag > MaxImagePerCategory then
           begin
             Images.Tag:= 1;
             if CheckAutoCycle then
                Exit;
           end;
      end;
    0:
      begin
        Images.Tag:= Images.Tag-1; // previous Button
        if Images.Tag < 1 then
           begin
             Images.Tag:= MaxImagePerCategory;
             if CheckAutoCycle then
                Exit;
           end;
      end;
  end;
  if not DisplayImage then
     begin
       if not ButtonImageEnableThreads.Down then
       begin
         if not CheckAutoCycle then
            begin
              case Images.Tag of
                1:
                  begin
                    if ButtonCode = 1 then
                       Images.Tag:= Images.Tag-1; // next button
                  end;
                MaxImagePerCategory:
                  begin
                    if ButtonCode = 0 then
                       Images.Tag:= 1; // previous button
                  end;
                else
                  begin
                   case ButtonCode of
                     1: Images.Tag:= Images.Tag-1; // next button
                     0: Images.Tag:= Images.Tag+1; // previous button
                   end;
                 end;
              end;
            end;
       end;
     end;
end;

