    11: FilterStr:= 'Text Files (*.txt)|*.txt';
    12: FilterStr:= 'All Files (*.*)|*.*';
    13: FilterStr:= 'MAME Save State Files (*.sta)|*.sta';
    14: FilterStr:= 'Icon Files (*.ico)|*.ico';
    15: FilterStr:= 'Icon Files (zzz*.ico)|zzz*.ico';
    16: FilterStr:= 'LUA Script Files (*.lua)|*.lua';
    17: FilterStr:= '7-Zip Files (*.7z)|*.7z';
    18: FilterStr:= 'MAME Font Files (*.bdf)|*.bdf';
    19: FilterStr:= 'Data Files (*.dat)|*.dat';
    20: FilterStr:= 'C++ Files (*.cpp)|*.cpp';
    21: FilterStr:= 'JavaScript Object Notation (*.json)|*.json';
    22: FilterStr:= MemoryCardFilter;
  end;
  case FilterType of
     0: DefaultExtension:= 'exe';
     1: DefaultExtension:= 'inp';
     2: DefaultExtension:= '';
     3: DefaultExtension:= '';
     4: DefaultExtension:= 'jpg';
     5: DefaultExtension:= 'png';
     6: DefaultExtension:= 'ini';
     7: DefaultExtension:= 'zip';
     8: DefaultExtension:= '';
     9: DefaultExtension:= 'znc';
    10: DefaultExtension:= 'cfg';
    11: DefaultExtension:= 'txt';
    12: DefaultExtension:= '';
    13: DefaultExtension:= 'sta';
    14: DefaultExtension:= 'ico';
    15: DefaultExtension:= 'ico';
    16: DefaultExtension:= 'lua';
    17: DefaultExtension:= '7z';
    18: DefaultExtension:= 'bdf';
    19: DefaultExtension:= 'dat';
    20: DefaultExtension:= 'cpp';
    21: DefaultExtension:= 'json';
    22: DefaultExtension:= '';
  end;
  if DefaultDirectory <> '' then
     DefaultDirectory:= IncludeTrailingPathDelimiter(DefaultDirectory); // last backlash is required to show desired folder correctly
  if OpenSaveFileDialog(self, DefaultExtension, FilterStr, DefaultDirectory, DialogTitle, FileStr, IsOpenDialog, False, True, IsOpenDialog) then
     begin
       if EditHolder <> nil then
          begin
            case MultipleFiles of
              True:
                begin
                  if EditHolder.Text <> '' then
                     EditHolder.Text:= EditHolder.Text+';'+FileStr
                  else
                     EditHolder.Text:= FileStr;
                end;
              False:
                begin
                  EditHolder.Text:= FileStr;
                end;
            end;
          end;
       Result:= FileStr;
     end;
  SetCurrentDir(FrontendPath);
end;

procedure TFormMain.DialogSelectFolder(EditHolder: TEditEx; MultipleFolders: Boolean; AlternateTitle: String = ''; RootFolder: WideString = '');
var
  Value, TitleStr: String;
  SubFolders: Boolean;
begin
  if AlternateTitle = '' then
     TitleStr:= EditHolder.Hint
  else
     TitleStr:= AlternateTitle;
  if not SelectDirectoryShell(TitleStr, False, Value, SubFolders, RootFolder) then
     Exit;
  Value:= ExcludeTrailingPathDelimiter(Value);
  case MultipleFolders of
    True:
      begin
        if EditHolder.Text <> '' then
           EditHolder.Text:= EditHolder.Text+';' + Value
        else
           EditHolder.Text:= Value;
      end;
    False: EditHolder.Text:= Value;
  end;
end;

function TFormMain.DialogSelectFolderStr(DialogText: String; RecursiveFolders: Boolean = False): String;
var
  SubFolders: Boolean;
begin
  Result:= '';
  if SelectDirectoryShell(DialogText, RecursiveFolders, Result, SubFolders) then
     begin
       if Result <> '' then
          Result:= IncludeTrailingPathDelimiter(Result);
     end;
end;

function TFormMain.DialogSelectMultiFolders(ListHolder: TEasyListView; ActiveFolder: Boolean = True): Boolean;
var
  Value: String;
  SubFoldersList: THashedStringList;
  Loop: Integer;
  AddSubFolders: Boolean;

  procedure AddItem(const strCaption: String);
  begin
    with ListHolder.Items.Add do
    begin
      ImageIndex:= 4;
      Caption:= strCaption;
      if ListHolder.Header.Columns.Count > 1 then
         begin
           // for Sega Model 2 emu only
           case ActiveFolder of
             True : Captions[1]:= 'Active';
             False: Captions[1]:= 'Inactive';
           end;
         end;
    end;
  end;
  
begin
  Result:= False;
  ListHolder.SetFocus;
  if ELV_IsEditing(ListHolder) then
     Exit;
  Result:= SelectDirectoryShell(ListHolder.Hint, True, Value, AddSubFolders);
  if not Result then
     Exit;

  Value:= ExcludeTrailingPathDelimiter(Value);
  case AddSubFolders of
    True:
      begin
        SubFoldersList:= THashedStringList.Create;
        GetFoldersList(Value, SubFoldersList, True, True);
        if SubFoldersList.Count > 0 then
           begin
             ListHolder.BeginUpdate;
             for Loop:=0 to SubFoldersList.Count-1 do
                 AddItem(SubFoldersList[Loop]);
             ListHolder.EndUpdate;
           end;
        FreeAndNil(SubFoldersList);
      end;
    False:
      begin
        ListHolder.BeginUpdate;
        AddItem(Value);
        ListHolder.EndUpdate;
      end;
  end;
end;

