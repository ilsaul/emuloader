procedure TFormMain.DialogSelectFolder(EditHolder: TEdit; MultipleFolders: Boolean; AlternateTitle: String = '');
var
  Value, TitleStr: String;
  SubFolders: Boolean;
begin
  if AlternateTitle = '' then
     TitleStr:= EditHolder.Hint
  else
     TitleStr:= AlternateTitle;
  if not SelectDirectoryShell(TitleStr, False, Value, SubFolders) then
     Exit;
  Value:= ExcludeTrailingPathDelimiter(Value);
  case MultipleFolders of
    True:
      begin
        if EditHolder.Text <> '' then
           EditHolder.Text:= EditHolder.Text+';' + Value
        else
           EditHolder.Text:= Value;
      end;
    False: EditHolder.Text:= Value;
  end;
end;

function TFormMain.DialogSelectFolderStr(DialogText: String; RecursiveFolders: Boolean = False): String;
var
  SubFolders: Boolean;
begin
  Result:= '';
  if SelectDirectoryShell(DialogText, RecursiveFolders, Result, SubFolders) then
     begin
       if Result <> '' then
          Result:= IncludeTrailingPathDelimiter(Result);
     end;
end;

function TFormMain.DialogSelectMultiFolders(ListHolder: TEasyListView; ActiveFolder: Boolean = True): Boolean;
var
  Value: String;
  SubFoldersList: THashedStringList;
  Loop: Integer;
  AddSubFolders: Boolean;

  procedure AddItem(const strCaption: String);
  begin
    with ListHolder.Items.Add do
    begin
      ImageIndex:= 4;
      Caption:= strCaption;
      if ListHolder.Header.Columns.Count > 1 then
         begin
           // for Sega Model 2 emu only...
           case ActiveFolder of
             True : Captions[1]:= 'Active';
             False: Captions[1]:= 'Inactive';
           end;
         end;
    end;
  end;
  
begin
  Result:= False;
  ListHolder.SetFocus;
  if ELV_IsEditing(ListHolder) then
     Exit;
  Result:= SelectDirectoryShell(ListHolder.Hint, True, Value, AddSubFolders);
  if not Result then
     Exit;

  Value:= ExcludeTrailingPathDelimiter(Value);
  case AddSubFolders of
    True:
      begin
        SubFoldersList:= THashedStringList.Create;
        GetFoldersList(Value, SubFoldersList, True, True);
        if SubFoldersList.Count > 0 then
           begin
             ListHolder.BeginUpdate;
             for Loop:=0 to SubFoldersList.Count-1 do
                 AddItem(SubFoldersList[Loop]);
             ListHolder.EndUpdate;
           end;
        FreeAndNil(SubFoldersList);
      end;
    False:
      begin
        ListHolder.BeginUpdate;
        AddItem(Value);
        ListHolder.EndUpdate;
      end;
  end;
end;

