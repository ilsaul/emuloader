procedure TFormMain.SoftListGetRequirementInfo(sysID: Integer; GameName, SoftwareName: String; out VarReqSetName: String; out VarReqSoftwareName: String);
var
  RequirementIni: TMemIniFile;
  tmpString: String;
  iPos: Integer;
begin
  VarReqSetName:= '';
  VarReqSoftwareName:= '';
  if not FileExistsW(GetSoftListRequirementFile(sysID)) then
     Exit;

  RequirementIni:= TMemIniFile.Create(GetSoftListRequirementFile(sysID));
  tmpString:= RequirementIni.ReadString(SoftwareName, GameName, '');
  FreeAndNil(RequirementIni);
  if tmpString <> '' then
     begin
       iPos:= PosEx(':', tmpString);
       if iPos <> 0 then
          begin
            VarReqSoftwareName:= Copy(tmpString, 1, iPos-1);
            VarReqSetName:= Copy(tmpString, iPos+1, Length(tmpString));
          end
       else
          VarReqSetName:= tmpString;
     end;
end;

function TFormMain.AddToSpecialList(AddToFavorites: Boolean): Boolean;
var
  titleIndex, selIndex: Integer;
  MsgTitle, FavTitleStr, tStr: String;
  FavList: THashedStringList;
  gItem: TEasyItem;
  IsNewFile, AddGame: Boolean;

  function GetFavTitleStr(FavFileHolder: THashedStringList): Integer;
  begin
    Result:= FavFileHolder.IndexOfName('favorite_title');
    if FavTitleStr = '' then
       FavTitleStr:= FavFileHolder.Values['favorite_title'];
    if FavTitleStr = '' then
       FavTitleStr:= ChangeFileExt(FavoriteProfile[1], '');

    //if Result <> -1 then
    //   FavFileHolder.Delete(titleIndex); // title will be re-added later
  end;

begin
  Result:= False;
  AddGame:= False;
  IsNewFile:= True;
  if not CheckSelected(GamesListView) then
     Exit;

  case AddToFavorites of
    True:
      begin
        MsgTitle:= 'Add Games To Favorites';
        FavTitleStr:= '';
        FavList:= THashedStringList.Create;
        titleIndex:= -1;
        if FileExists(GetFavoritesFile) then
           begin
             FavList.LoadFromFile(GetFavoritesFile);
             IsNewFile:= FavList.Count = 0;
             if not IsFavoriteDefault(FavoriteProfile[1]) then
                begin
                  titleIndex:= GetfavTitleStr(FavList);
                  if titleIndex <> -1 then
                     IsNewFile:= (FavList.Count-1) = 0;
                end;
           end;
      end;
    False:
      begin
        MsgTitle:= 'Add Games To Special List';
        FavTitleStr:= '';
        FavList:= THashedStringList.Create;
        titleIndex:= -1;
        if FileExists(GetSpecialFile) then
           begin
             FavList.LoadFromFile(GetSpecialFile);
             IsNewFile:= FavList.Count = 0;
           end;
      end;
  end;

  selIndex:= 1; // required for the ELV_GetNextSelected() function call! 2017
  FavList.BeginUpdate;

  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // remove any pending requests before reloading them
  GamesListView.BeginUpdate;
  gItem:= GamesListView.Selection.First;
  repeat
    case AddToFavorites of
      True : TEasyGameInfo(gItem).eIsFavorite:= True;
      False: TEasyGameInfo(gItem).eIsSpecial:= True;
    end;

    FillTempGameInfo(gItem);
    tStr:= '';
    if TempGameVars.eIsCustomGame then
       begin
         if TEasyGameInfo(gItem).eIsUnicode then
            tStr:= UTF8Encode(TEasyGameInfo(gItem).eName)
         else
            tStr:= TEasyGameInfo(gItem).eName;

         tStr:= Format('%.3u %u', [TEasyGameInfo(gItem).eCustomSystemID, TEasyGameInfo(gItem).eCustomMediaType])+' <file>'+tStr;
       end
    else
       begin
         tStr:= GetPlayedGamesNameEntry(TempGameVars.eName, TempGameVars.eSoftwareName)+'='+GetArcadeSystemIniSection(TempGameVars.eSystemID, True);
       end;
       
    if IsNewFile then
       begin
         AddGame:= True;
         Result:= True;
         FavList.Add(tStr);
       end
    else
       begin
         if FavList.IndexOf(tStr) = -1 then
            begin
              AddGame:= True;
              Result:= True;
              FavList.Add(tStr);
            end;
       end;

    gItem:= ELV_GetNextSelected(GamesListView, gItem, selIndex);
  until gItem = nil;
  GamesListView.EndUpdate(False);

  FavList.EndUpdate;

  if Result then
     begin
       if AddGame then
          begin
            if AddToFavorites then
               FavList.SaveToFile(GetFavoritesFile)
            else
               FavList.SaveToFile(GetSpecialFile);
          end;
       FillMemGameInfo(MemGameInfo); // fix selected game info in memory
     end;

  FreeAndNil(FavList);

  //if Result and IsThumbnailView then
  //   ResetThumbnails(True);
  
  if not Result then
     begin
       if FavTitleStr = '' then
          FavTitleStr:= 'Default';
          
       CallMessageBox;
       AddMsgText('No games were added, already in the list.'+#13#10+#13#10);
       if AddtoFavorites then
          AddMsgText(FavTitleStr+#13#10, clBlack, [fsBold]);
       AddMsgText('File: ');
       if AddToFavorites then
          AddMsgText(FavoriteProfile[1], MsgTxtColors.colorFileName, [fsBold])
       else
          AddMsgText(GetSpecialFile, MsgTxtColors.colorFileName, [fsBold]);
       GenerateMessage('Info', MsgTitle);
     end;
end;

function TFormMain.DeleteFromSpecialList(RemoveFromFavorites: Boolean): Boolean;
var
  selIndex, titleIndex: Integer;
  MsgTitle, FavTitleStr, tStr: String;
  FavList: THashedStringList;
  RemoveGame, FoundTxtFile: Boolean;
  gItem: TEasyItem;

  function GetFavTitleStr(FavFileHolder: THashedStringList): Boolean;
  begin
    Result:= True;
    if IsFavoriteDefault(FavoriteProfile[1]) then
       FavTitleStr:= ''
    else
    if FavTitleStr = '' then
       FavTitleStr:= FavFileHolder.Values['favorite_title'];
  end;

begin
  Result:= False;
  RemoveGame:= False;
  if not CheckSelected(GamesListView) then
     Exit;

  case RemoveFromFavorites of
    True:
      begin
        MsgTitle:= 'Remove Games From Favorites';
        FoundTxtFile:= FileExists(GetFavoritesFile);
        if not FoundTxtFile then
           begin
             CallMessageBox;
             AddMsgText('    File not found. '+
                        'Games cannot be removed from the favorites list.'+#13#10+#13#10);
             AddMsgText(FavoriteProfile[0]+#13#10, clBlack, [fsBold]);
             AddMsgText('File: ');
             AddMsgText(FavoriteProfile[1], MsgTxtColors.colorFileName, [fsBold]);
             GenerateMessage('Info', MsgTitle);
             Exit;
           end;
      end;
    False:
      begin
        MsgTitle:= 'Remove Games From Special List';
        FoundTxtFile:= FileExists(GetSpecialFile);
        if not FoundTxtFile then
           begin
             CallMessageBox;
             AddMsgText('    File not found. '+
                        'Games cannot be removed from the special list.'+#13#10+#13#10);
             AddMsgText('File: ');
             AddMsgText(GetSpecialFile, MsgTxtColors.colorFileName, [fsBold]);
             GenerateMessage('Info', MsgTitle);
             Exit;
           end;
      end;
  end;

  selIndex:= 1;
  FavList:= THashedStringList.Create;
  if RemoveFromFavorites then
     FavList.LoadFromFile(GetFavoritesFile)
  else
     FavList.LoadFromFile(GetSpecialFile);
  FavList.BeginUpdate;

  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // remove any pending requests before reloading them
  GamesListView.BeginUpdate;
  gItem:= GamesListView.Selection.First;
  repeat
    FillTempGameInfo(gItem);
    if TempGameVars.eIsCustomGame then
       begin
         if TEasyGameInfo(gItem).eIsUnicode then
            tStr:= UTF8Encode(TEasyGameInfo(gItem).eName)
         else
            tStr:= TEasyGameInfo(gItem).eName;
         tStr:= Format('%.3u %u', [TEasyGameInfo(gItem).eCustomSystemID, TEasyGameInfo(gItem).eCustomMediaType])+' <file>'+tStr;
       end
    else
       begin
         tStr:= GetPlayedGamesNameEntry(TempGameVars.eName, TempGameVars.eSoftwareName)+'='+GetArcadeSystemIniSection(TempGameVars.eSystemID, True);
       end;

    titleIndex:= FavList.IndexOf(tStr);
    if titleIndex <> -1 then
       begin
         RemoveGame:= True;
         Result:= True;
         FavList.Delete(titleIndex);
       end;

    if Result then
       begin
         case RemoveFromFavorites of
           True : TEasyGameInfo(gItem).eIsFavorite:= False;
           False: TEasyGameInfo(gItem).eIsSpecial:= False;
         end;
       end;

    gItem:= ELV_GetNextSelected(GamesListView, gItem, selIndex);
  until gItem = nil;
  GamesListView.EndUpdate(False);

  FavList.EndUpdate;
  case Result of
    True:
      begin
        if RemoveGame then
        begin
          if RemoveFromFavorites then
             FavList.SaveToFile(GetFavoritesFile)
          else
             FavList.SaveToFile(GetSpecialFile);
        end;
        FreeAndNil(FavList);

        if RemoveFromFavorites then
           begin
             if SelectedFilterName = 'favorites' then
                SetGameType(False); // only ApplyFilters is needed here!!!
           end
        else
           begin

           end;

        FillMemGameInfo(MemGameInfo); // fix selected game info in memory
      end;
    False:
      begin
        FreeAndNil(FavList);
        if RemoveFromFavorites then
           begin
             tStr:= 'favorites';
             if FavTitleStr = '' then
                FavTitleStr:= 'Default';
           end
        else
           tStr:= 'special';

        CallMessageBox;
        AddMsgText('No games were removed from the '+tStr+' list.'+#13#10+#13#10);

        if RemoveFromFavorites then
           AddMsgText(FavTitleStr+#13#10, clBlack, [fsBold]);
        AddMsgText('File: ');
        if RemoveFromFavorites then
           AddMsgText(FavoriteProfile[1], MsgTxtColors.colorFileName, [fsBold])
        else
           AddMsgText(GetSpecialFile, MsgTxtColors.colorFileName, [fsBold]);
        GenerateMessage('Info', MsgTitle);
      end;
  end;
end;

procedure TFormMain.LoadFolders_MAME(SystemID: Byte; EmuFileNameStr: String = '');
var
  MAMEIniFile: THashedStringList;
  iFolder, TextLine, IniFile, EntryString, iniDirString, ExeFileStr: String;
  Loop, iPos, iVersion, IndexMAME: Integer;
begin
  if EmuFileNameStr <> '' then
     begin
        ExeFileStr:= EmuFileNameStr;
        if not FileExists(ExeFileStr) then
           Exit;
     end
  else
     begin
       if not ValidateArcadeEmulatorFile(SystemID) then
          Exit;
       ExeFileStr:= EmulatorFile[SystemID];
     end;

  iniFile:= GetArcadeEmuIniFileName(SystemID, ExeFileStr);
  if not FileExists(iniFile) then
     Exit;

  IndexMAME:= Ord(SystemID <> idMAME)+1; // 1 -> MAME; 2 -> HBMAME
  MAMEIniFile:= THashedStringList.Create;
  MAMEIniFile.LoadFromFile(iniFile);
  for Loop:=0 to MAMEIniFile.Count -1 do
  begin
    TextLine:= MAMEIniFile[Loop];
    if TextLine <> '' then
       begin
         if PosEx('# inipath', TextLine) <> 0 then
            EntryString:= 'inipath'
         else
            EntryString:= XML_GetEntryName(TextLine);
         if EntryString <> '' then
            EntryString:= EntryString+' ';

         if (EntryString = 'rompath ') or
            (EntryString = 'rp ') then
            begin
              iFolder:= ExtractMAMEIniValue(TextLine);
              if iFolder = '' then
                 iFolder:= 'roms';
            end
         else
         if EntryString = 'snapshot_directory ' then
            begin
              imgFolder[SystemID, 1]:= ExtractMAMEIniValue(TextLine);
              if imgFolder[SystemID, 1] = '' then
                 imgFolder[SystemID, 1]:= ImageCategoryArray[1, 3]; // set to default folder "snap"

              case Assigned(imgFolderMAME[IndexMAME, 1]) of
                True : imgFolderMAME[IndexMAME, 1].Clear;
                False: imgFolderMAME[IndexMAME, 1]:= TStringList.Create;
              end;
              ExtractFolders2MAME(SystemID, imgFolder[SystemID, 1], imgFolderMAME[IndexMAME, 1], False, ExeFileStr); // emulator full path already generated in TStringList
            end;

         if EntryString = 'inipath ' then
            begin
              if PosEx('<NULL>', TextLine) <> 0 then
                 iniDirString:= 'ini'
              else
                 iniDirString:= ExtractMAMEIniValue(TextLine);
              if (iniDirString = '') or (iniDirString = '.') or (iniDirString = '.;ini') then
                 iniDirString:= 'ini'
              else
                 begin
                   iPos:= PosEx(';', iniDirString);
                   if iPos <> 0 then
                      begin
                        iniDirString:= Copy(iniDirString, 1, iPos-1);
                        if iniDirString = '.' then
                           iniDirString:= 'ini';
                      end;
                 end;
              //IniFilesDir[SystemID]:= ExtractMAMEIniValue(TextLine);
              //if (Pos(';', IniFilesDir[SystemID]) <> 0) or (IniFilesDir[SystemID] = '') then
              //   IniFilesDir[SystemID]:= 'ini';
            end
         else
         if EntryString = '# inipath ' then
            iniDirString:= 'ini';
       end;
  end;
  FreeAndNil(MAMEIniFile);

  ExtractROMsFolders(iFolder, SystemID);

  if iniDirString <> '' then
     iniDirString:= FullFolderFix(iniDirString, ExeFileStr)
  else
     begin
       if IsMAMEBasedSys(SystemID) then
          begin
            iVersion:= GetMAMEBuild(SystemID);
            if (iVersion in [0..60]) then // if iVersion < 61 then
               iniDirString:= ExtractFilePath(ExeFileStr);
          end;
     end;
  IniFilesDir[SystemID]:= iniDirString;
end;

// what is this function used for ? October 30, 2016
function TFormMain.LoadFolderSpecial_MAME(sysID: Byte; const ExeFileStr: String; FolderIndex: Byte): String;
var
  MAMEIniFile: THashedStringList;
  Folder, TextLine, IniFile, EntryString: String;
  Loop: Integer;
begin
  case FolderIndex of
    0: Result:= 'artwork'; // artwork directory
    1: Result:= 'inp'; // input directory
    2: Result:= 'samples'; // audio samples directory
    3: Result:= 'sta'; // save state directory
  end;
  if not FileExists(ExeFileStr) then
     Exit;
  iniFile:= GetArcadeEmuIniFileName(sysID, ExeFileStr);
  if not FileExists(iniFile) then
     Exit;

  Folder:= '';
  MAMEIniFile:= THashedStringList.Create;
  MAMEIniFile.LoadFromFile(iniFile);
  for Loop:=0 to MAMEIniFile.Count -1 do
  begin
    TextLine:= MAMEIniFile[Loop];
    if TextLine <> '' then
       begin
         EntryString:= XML_GetEntryName(TextLine);
         if EntryString <> '' then
            EntryString:= EntryString+' ';

         case FolderIndex of
           0: // artwork directory (multiple paths)
           begin
             //if not IsAlterMAME then
             //begin
             if (EntryString = 'artpath ') or
                (EntryString = 'artwork_directory ') then
                begin
                  Folder:= ExtractMAMEIniValue(TextLine);
                  //ExtractFolders2MAME(SystemID, Folder2, ArtworksDir[Ord(SystemID = idMAME)]);
                  Break;
                end;
             //end;
           end;
           1: // input directory (single path)
           begin
             if EntryString = 'input_directory ' then
                begin
                  Folder:= ExtractMAMEIniValue(TextLine);
                  Break;
                end;
           end;
           2: // samples directory (multiple paths)
           begin
             if (EntryString = 'samplepath ') or
                (EntryString = 'sp ') then
                begin
                  Folder:= ExtractMAMEIniValue(TextLine);
                  //ExtractFolders2MAME(SystemID, Folder2, SamplesDir[Ord(SystemID = idMAME)]);
                  Break;
                end;
           end;
           3: // save state directory (single path)
           begin
             if EntryString = 'state_directory ' then
             begin
               Folder:= ExtractMAMEIniValue(TextLine);
               Break;
             end;
           end;
         end;
       end;
  end;
  FreeAndNil(MAMEIniFile);

  if Folder <> '' then
     Result:= Folder;
end;

procedure TFormMain.LoadFoldersArcade2(sysID: Integer; EmuFileNameStr: String = '');
var
  emuCFG: TMemIniFile;
  Folder, tmpString, ExeFileStr: String;
  sFoldersList: TStringList;
  Loop, fCount: Integer;
begin
  if EmuFileNameStr <> '' then
  begin
     ExeFileStr:= EmuFileNameStr;
     if not FileExists(ExeFileStr) then
        Exit;
  end
  else
  begin
    if not ValidateArcadeEmulatorFile(sysID) then
       Exit
    else
       ExeFileStr:= EmulatorFile[sysID];
  end;

  case sysID of
    idSupermodel, idZiNc:
      begin
        tmpString:= GetArcadeEmulatorsFile;
        if not FileExists(tmpString) then
           begin
             Exit;
           end;

        emuCFG:= TMemIniFile.Create(tmpString);
        Folder:= emuCFG.ReadString(GetArcadeSystemIniSection(sysID), 'roms_path', '');
        if Folder = '' then
           Folder:= 'roms';
        FreeAndNil(emuCFG);
      end;
    idDaphne, idDICE:
      begin
        Folder:= ExtractFilePath(ExeFileStr)+'roms';
      end;
    idDemul:
      begin
        tmpString:= GetArcadeEmuIniFileName(sysID);
        if (tmpString <> '') and (FileExists(tmpString)) then
           begin
             Folder:= '';
             emuCFG:= TMemIniFile.Create(tmpString);
             fCount:= emuCFG.ReadInteger('files', 'romsPathsCount', 1);
             Folder:= emuCFG.ReadString('files', 'roms0', 'roms');
             if fCount > 1 then
                begin
                  tmpString:= '';
                  for Loop:=1 to fCount-1 do
                  begin
                    tmpString:= emuCFG.ReadString('files', 'roms'+(IntToStr(Loop)), 'roms');
                    if Folder <> '' then
                       Folder:= Folder+';';
                    Folder:= Folder+FullFolderFix(tmpString, ExeFileStr);
                  end;
                end;
             FreeAndNil(emuCFG);
           end;
        if Folder = '' then
           Folder:= FullFolderFix('roms', ExeFileStr);
      end;
    idSegaModel2:
      begin
        tmpString:= GetArcadeEmuIniFileName(sysID);
        if (tmpString <> '') and (FileExists(tmpString)) then
           begin
             emuCFG:= TMemIniFile.Create(tmpString);
             sFoldersList:= TStringList.Create;
             emuCFG.ReadSectionValues('RomDirs', sFoldersList);
             Folder:= '';
             tmpString:= '';
             if sFoldersList.Count > 0 then
                begin
                  for Loop:=0 to sFoldersList.Count-1 do
                  begin
                    tmpString:= sFoldersList.Names[Loop];
                    if Folder <> '' then
                       Folder:= Folder+';';
                    Folder:= Folder+FullFolderFix(sFoldersList.ValueFromIndex[Loop], ExeFileStr);
                  end;
                end;
             FreeAndNil(sFoldersList);
             FreeAndNil(emuCFG);
           end;
        if Folder <> '' then
           Folder:= Folder+';';
        Folder:= Folder+FullFolderFix('ROMs', ExeFileStr);
      end;
  end;
   ExtractROMsFolders(Folder, sysID);
end;

procedure TFormMain.LoadFoldersAllArcadeSystems;
var
  Loop: ShortInt;
begin
  for Loop:=1 to MaxArcadeSystems do
      LoadROMFolders(Loop);
end;

procedure TFormMain.LoadROMFolders(sysID: ShortInt);
begin
  case IsMAMEBasedSys(sysID) of
    True : LoadFolders_MAME(sysID, '');
    False: LoadFoldersArcade2(sysID);
  end;
end;

procedure TFormMain.ExtractROMsFolders(const ROMsList: String; SystemID: Integer; ListHolder: TEasyListView = nil);
var
  PathName: String;

  function AddToList: Boolean;
  begin
    Result:= Assigned(ListHolder);
    case Result of
      True:
        begin
          with ListHolder.Items.Add do
          begin
            ImageIndex:= 4;
            Caption:= ExcludeTrailingPathDelimiter(PathName);
          end;
        end;
      False: emuROMsFolders[SystemID].Add(ExcludeTrailingPathDelimiter(PathName));
    end;
  end;

  procedure AddMultipleFolders;
  var
    Loop: Integer;
  begin
    // multiple folders
    for Loop:=1 to Length(ROMsList) do
    begin
      if (ROMsList[Loop] = ';') then
         begin
           AddToList;
           PathName:= '';
         end
      else
         begin
           if ROMsList[Loop] <> '"' then
              PathName:= PathName+ROMsList[Loop];
           if Loop = Length(ROMsList) then
              AddToList;
         end;
    end;
  end;

begin
  case Assigned(emuROMsFolders[SystemID]) of
    True : emuROMsFolders[SystemID].Clear;
    False: emuROMsFolders[SystemID]:= THashedStringList.Create;
  end;
  case Assigned(ListHolder) of
    True:
      begin
        AddMultipleFolders;
      end;
    False:
      begin
        if ROMsList = '' then
           Exit;
        PathName:= '';
        if SystemID in [idDaphne, idDICE] then // single folder only
           emuROMsFolders[SystemID].Add(ExcludeTrailingPathDelimiter(ROMsList))
        else
           AddMultipleFolders;
      end;
  end;
end;

procedure TFormMain.LoadFolders_ConfigFiles(sysID: Integer; out dirCFG: String; out dirNVRAM: String);
var
  MAMEIniFile: THashedStringList;
  TextLine, IniFile, EntryString: String;
  Loop: Integer;
  emuCFG: TMemIniFile;
begin
  dirCFG:= '';
  dirNVRAM:= '';
  if not ValidateArcadeEmulatorFile(sysID) then
     Exit;
  case IsMAMEBasedSys(sysID) of
    True:
      begin
        iniFile:= GetArcadeEmuIniFileName(sysID, EmulatorFile[sysID]);
        if not FileExists(iniFile) then
           Exit;
        MAMEIniFile:= THashedStringList.Create;
        MAMEIniFile.LoadFromFile(iniFile);
        for Loop:=0 to MAMEIniFile.Count -1 do
        begin
          TextLine:= MAMEIniFile[Loop];
          if TextLine <> '' then
             begin
               EntryString:= XML_GetEntryName(TextLine);
               if EntryString <> '' then
                  EntryString:= EntryString+' ';

               if EntryString = 'cfg_directory ' then
                  dirCFG:= ExtractMAMEIniValue(TextLine)
               else
               if EntryString = 'nvram_directory ' then
                  dirNVRAM:= ExtractMAMEIniValue(TextLine);
             end;
        end;
        FreeAndNil(MAMEIniFile);
        dirCFG:= FullEmuFolderFix(dirCFG, sysID, False);
        dirNVRAM:= FullEmuFolderFix(dirNVRAM, sysID, False);
      end;
    False:
      begin
        case sysID of
          idZiNc: dirCFG:= FullEmuFolderFix('cfg', sysID, False);
          idDemul:
            begin
              iniFile:= GetArcadeEmuIniFileName(sysID, EmulatorFile[sysID]);
              if not FileExists(iniFile) then
                 Exit;
              emuCFG:= TMemIniFile.Create(iniFile);
              dirNVRAM:= emuCFG.ReadString('files','nvram', '');
              FreeAndNil(emuCFG);
              dirNVRAM:= FullEmuFolderFix(dirNVRAM, sysID, False);
            end;
          idSegaModel2:
            begin
              dirNVRAM:= FullEmuFolderFix('nvdata', sysID, False);
              dirCFG:= FullEmuFolderFix('cfg', sysID, False);
            end;
          idSupermodel:
            begin
              dirCFG:= FullEmuFolderFix('config', sysID, False);
              dirNVRAM:= FullEmuFolderFix('nvram', sysID, False);
            end;
        end;
      end;
  end;
end;

function TFormMain.MountFoldersListMAME(ListHolder: TEasyListView): String;
var
  Loop: Integer;
begin
  Result:= '';
  if not Assigned(ListHolder) then
     Exit;
  if ListHolder.Items.Count = 0 then
     Exit;
  for Loop:=0 to ListHolder.Items.Count-1 do
  begin
    if Result <> '' then
       Result:= Result+';'+ListHolder.Items[Loop].Caption
    else
       Result:= ListHolder.Items[Loop].Caption;
  end;
end;

function TFormMain.MountFoldersListToString(ListSource: TStringList): String;
var
  Loop: Integer;
  ValueToAdd: String;
begin
  Result:= '';
  if not Assigned(ListSource) then
     Exit;

  if ListSource.Count = 0 then
     Exit;

  for Loop:=0 to ListSource.Count-1 do
  begin
    ValueToAdd:= ListSource[Loop];
    if ValueToAdd <> '' then
       begin
         if Result <> '' then
            Result:= Result+';'+ListSource[Loop]
         else
            Result:= ListSource[Loop];
       end;
  end;
end;

procedure TFormMain.ExtractFolders2MAME(sysID: Integer; PathsList: String; var ListHolder: TStringList; IncludeEmuFullPath: Boolean = True; EmuFileName: String = '');
var
  PathName, EmuFileStr: String;
  Loop: Integer;

  procedure AddFolder;
  begin
    if IncludeEmuFullPath then
       begin
          if PathName = '.' then
             PathName:= ExtractFilePath(EmuFileStr);
          PathName:= FullFolderFix(PathName, EmuFilestr);
          ListHolder.Add(PathName);
       end
    else
       begin
         if PathName <> '.' then
            ListHolder.Add(PathName);
       end;
  end;

begin
  if PathsList = '' then
     begin
       if Assigned(ListHolder) then
          FreeAndNil(ListHolder);
       Exit;
     end;

  if EmuFileName = '' then
     EmuFileStr:= EmulatorFile[sysID]
  else
     EmuFileStr:= EmuFileName;
  FreeAndNil(ListHolder);
  ListHolder:= THashedStringList.Create;
  ListHolder.BeginUpdate;
  PathName:= '';
  for Loop:=1 to Length(PathsList) do
  begin
    if (PathsList[Loop] = ';') then
       begin
         AddFolder;
         PathName:= '';
       end
    else
       begin
         if PathsList[Loop] <> '"' then
            PathName:= PathName+PathsList[Loop];
         if Loop = Length(PathsList) then
            AddFolder;
       end;
  end;
  ListHolder.EndUpdate;
end;

procedure TFormMain.ExtractMultiFolders(const FoldersStr: String; SystemID: Integer; ELV_ListHolder: TEasyListView);
var
  PathName: String;
  Loop: Integer;

  function AddToList: Boolean;
  begin
    Result:= True;
    if PosEx('/', PathName) <> 0 then
       PathName:= StringReplace(PathName, '/', '\', [rfIgnoreCase, rfReplaceAll]);
       
    with ELV_ListHolder.Items.Add do
    begin
      ImageIndex:= 4;
      Caption:= ExcludeTrailingPathDelimiter(PathName);
    end;
  end;

begin
  if FoldersStr = '' then
     begin
       ELV_ListHolder.Items.Clear;
       Exit;
     end;
  ELV_ListHolder.BeginUpdate;
  for Loop:=1 to Length(FoldersStr) do
  begin
    if (FoldersStr[Loop] = ';') then
       begin
         AddToList;
         PathName:= '';
       end
    else
       begin
         if FoldersStr[Loop] <> '"' then
            PathName:= PathName+FoldersStr[Loop];
         if Loop = Length(FoldersStr) then
            AddToList;
       end;
  end;
  ELV_ListHolder.EndUpdate(False);
end;

function TFormMain.SearchZIPFolder(const GameName: String; sysID: ShortInt; const SoftwareList: String = ''): String;
var
  Loop: Integer;
  FolderStr, FolderSoftListStr: String;
begin
  Result:= '';
  if not Assigned(emuROMsFolders[sysID]) then
     Exit;
  if emuROMsFolders[sysID].Count = 0 then
     Exit;
  FolderSoftListStr:= '';
  if SoftwareList <> '' then
     FolderSoftListStr:= SoftwareList+'\';
  for Loop:=0 to emuROMsFolders[sysID].Count -1 do
  begin
    FolderStr:= FullFolderFix(emuROMsFolders[sysID].Strings[Loop], EmulatorFile[sysID]);
    //if FileExistsW(FolderStr+FolderSoftListStr+GameName+'.zip') then FileExistsW is from MPCommonUtilities (EasyListView)
    if FileExists(FolderStr+FolderSoftListStr+GameName+'.zip') then
       begin
         Result:= FolderStr+FolderSoftListStr+GameName+'.zip';
         Break;
       end
    else
    if SystemUseSevenZip(sysID) then
       begin
         if UseSevenZip then
            begin
              if FileExists(FolderStr+FolderSoftListStr+GameName+'.7z') then
                 begin
                   Result:= FolderStr+FolderSoftListStr+GameName+'.7z';
                   Break;
                 end
            end;
       end;
  end;
end;

function TFormMain.SearchCHDFolder(const DiskImageFileName, GameName, BiosName, CloneOfName: String; sysID: ShortInt; const SoftwareList: String = ''): String;
var
  Loop: Integer;
  FolderStr, FolderSoftListStr: String;
begin
  Result:= '';
  if not Assigned(emuROMsFolders[sysID]) then
     Exit;
  if emuROMsFolders[sysID].Count = 0 then
     Exit;
  FolderSoftListStr:= '';
  if SoftwareList <> '' then
     FolderSoftListStr:= SoftwareList+'\';
     
  for Loop:=0 to emuROMsFolders[sysID].Count -1 do
  begin
    FolderStr:= FullFolderFix(emuROMsFolders[sysID].Strings[Loop], EmulatorFile[sysID]);
    if FileExistsW(FolderStr+FolderSoftListStr+DiskImageFileName) then // romsdir\softlistname\chdfilename.chd
       begin
         Result:= FolderStr+FolderSoftListStr+DiskImageFileName;
         Break;
       end
    else
    if FileExistsW(FolderStr+FolderSoftListStr+GameName+'\'+DiskImageFileName) then // romsdir\softlistname\gamename\chdfilename.chd
       begin
         Result:= FolderStr+FolderSoftListStr+GameName+'\'+DiskImageFileName;
         Break;
       end
    else
    if GameIsClone(CloneOfName) then
       begin
         if FileExistsW(FolderStr+FolderSoftListStr+CloneOfName+'\'+DiskImageFileName) then // romsdir\softlistname\parent_gamename\chdfilename.chd
            begin
              Result:= FolderStr+FolderSoftListStr+CloneOfName+'\'+DiskImageFileName;
              Break;
            end
       end;

    if Result = '' then
    begin
      if IsMAMEBasedSys(sysID) and (SoftwareList = '') then
         begin
           if FormMain.ValidateBiosName(BiosName, GameName) then
              begin
                if FileExistsW(FolderStr+BiosName+'\'+DiskImageFileName) then // romsdir\biosname\gamename\chdfilename.chd
                   begin
                     Result:= FolderStr+BiosName+'\'+DiskImageFileName;
                     Break;
                   end
              end;
         end;

    end;
  end;
end;

function TFormMain.SearchZiNcCHDFolder(const CHDFileName, GameName, GameFilePath: String): String;
begin
  Result:= '';
  if GameFilePath = '' then
     Exit;
  case FileExists(GameFilePath+CHDFileName) of
    True: Result:= GameFilePath+CHDFileName;
    False:
      begin
        if FileExists(GameFilePath+GameName+'\'+CHDFileName) then
           Result:= GameFilePath+GameName+'\'+CHDFileName;
      end;
  end;
end;

procedure TFormMain.AlterMAME_ValidateMAME;
var
  Loop: Integer;
begin
  for Loop:= Low(AlterMAMEFile) to High(AlterMAMEFile) do
  begin
    if AlterMAMEFile[Loop] <> '' then
       AlterMAME_IsMAME[Loop]:= (PosEx('mame', LowerCase(AlterMAMEFile[Loop])) <> 0) or (PosEx('ume', LowerCase(AlterMAMEFile[Loop])) <> 0)
    else
       AlterMAME_IsMAME[Loop]:= False;
  end;
end;

