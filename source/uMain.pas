         ImageHintText2[Index].Top:= ImageHintText.Top;
         ImageHintText2[Index].Visible:= True;

         ImageHintDetailsText2[Index]:= TShadowLabel.Create(Self);
         ImageHintDetailsText2[Index].Parent:= ImageHintPanel2[Index];
         ImageHintDetailsText2[Index].Transparent:= True;
         ImageHintDetailsText2[Index].ShowAccelChar:= False;
         ImageHintDetailsText2[Index].Font:= ImageHintDetailsText.Font;
         ImageHintDetailsText2[Index].ShadowColor:= ImageHintDetailsText.ShadowColor;
         ImageHintDetailsText2[Index].ShadowEnabled:= ImageHintDetailsText.ShadowEnabled;
         ImageHintDetailsText2[Index].Left:= ImageHintDetailsText.Left;
         ImageHintDetailsText2[Index].Top:= ImageHintDetailsText.Top;
         ImageHintDetailsText2[Index].Visible:= True;

         ImageHintIcon2[Index]:= TImage.Create(Self);
         ImageHintIcon2[Index].Parent:= ImageHintPanel2[Index];
         ImageHintIcon2[Index].Transparent:= True;
         ImageHintIcon2[Index].Left:= ImageHintIcon.Left;
         ImageHintIcon2[Index].Top:= ImageHintIcon.Top;
         ImageHintIcon2[Index].Width:= ImageHintIcon.Width;
         ImageHintIcon2[Index].Height:= ImageHintIcon.Height;
       end
    else
       begin
         if ImageHintPanel2[Index].Parent <> ImageScr[Index] then
            ImageHintPanel2[Index].Parent:= ImageScr[Index];
       end;
    Result:= Assigned(ImageHintPanel2[Index]);
    if Result then
       begin
         ImageHintText2[Index].Tag:= 0;
         UpdateImageHintPanelText(Index);
       end;
  end;

  function CreateSplitter(Index: ShortInt; imgAlignment: TAlign; imgParentComponent, AlignComponent: TWinControl): Boolean;
  begin
    if SplitterImg[Index] = nil then
       begin
         SplitterImg[Index]:= TSplitterEx.Create(nil);
         SplitterImg[Index].Parent:= imgParentComponent;
         SplitterImg[Index].Style:= TTMSStyle(tsSolidColor);
         if IsNightMode then
         begin
           case FormNightMode.NightModeImageSplitterShowGripIcon.Checked of
             True : SplitterImg[Index].GripStyle:= sgDots;
             False: SplitterImg[Index].GripStyle:= sgNone;
           end;
         end
         else
         begin
           case FormPreferences.ImageSplitterShowGripIcon.Checked of
             True : SplitterImg[Index].GripStyle:= sgDots;
             False: SplitterImg[Index].GripStyle:= sgNone;
           end;
         end;
         SplitterImg[Index].PopupMenu:= PopupSplitters;
         SplitterImg[Index].OnMoved:= ImageSplitterMovedUpd;
       end
    else
       begin
         if SplitterImg[Index].Parent <> imgParentComponent then
            SplitterImg[Index].Parent:= imgParentComponent;
       end;

    SplitterImg[Index].Width:= 7;
    SplitterImg[Index].Height:= 7;
    case imgAlignment of
      alLeft: SplitterImg[Index].Left:= AlignComponent.Width+7;
      alTop: SplitterImg[Index].Top:= AlignComponent.Height+7;
      alRight: SplitterImg[Index].Left:= AlignComponent.Left-7;
      alBottom: SplitterImg[Index].Top:= AlignComponent.Top-7;
    end;
    if SplitterImg[Index].Align <> imgAlignment then
       SplitterImg[Index].Align:= imgAlignment;

    SplitterImg[Index].ResizeStyle:= rsUpdate;
    Result:= Assigned(SplitterImg[Index]);
  end;

  function CreatePanel(imgAlignment: TAlign): Boolean;
  begin
    if ImagePnl = nil then
       begin
         ImagePnl:= TPanel.Create(Self);
         ImagePnl.Parent:= PanelImage;
         ImagePnl.BevelOuter:= bvNone;
         ImagePnl.Caption:= '';
         ImagePnl.Align:= imgAlignment;
       end
    else
       begin
         if ImagePnl.Align <> imgAlignment then
            ImagePnl.Align:= imgAlignment;
       end;
    Result:= Assigned(ImagePnl);
  end;

