procedure TFormMain.CheckSevenZip(sysID: Integer);
begin
  if sysID <> -1 then
     begin
       UseSevenZip:= SystemUseSevenZip(sysID);
       if UseSevenZip then
          UseSevenZip:= ValidateSevenZipDLL;
     end
  else
     UseSevenZip:= ValidateSevenZipDLL;
end;

function TFormMain.ValidateSevenZipDLL: Boolean;
var
  fHandle: THandle;
  libFile: String;
begin
  libFile:= FrontendPath+'7z.dll';
  Result:= FileExists(libFile);
  if not Result then
     Exit;
  fHandle:= LoadLibrary(PChar(libFile));
  Result:= FHandle <> 0;
  FreeLibrary(fHandle);
end;

