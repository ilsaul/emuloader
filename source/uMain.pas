      end;
  end;
  ButtonImageCategory.Hint:= 'Category -> '+PopupMenuImageCategories.Items[ButtonImageCategory.Tag].Caption+' <-';
  SetIcon(IL_ImagesCategory_Small, nil, IL_ImagesToolBarButtons, ButtonImageCategory.Tag, 2);
