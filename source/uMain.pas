var
  IniFile: TMemIniFile;
  iFile: String;
begin
  if ProfileNameStr = '' then
     iFile:= GetNightModeIniFile
  else
     begin
       iFile:= ProfileNameStr;
       iFile:= GetNightModeFolder+iFile+'.ini';
