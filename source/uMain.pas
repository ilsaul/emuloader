procedure TFormMain.ImgZipParseFilesListConsComp(sysID, imageCategoryID: Integer);
var
  imgFile: String;
  ArchiveItem: TZFArchiveItem;
  tResult: Boolean;
begin
  if (not IsSystemAvailable(sysID, True)) then
     begin
       if (SnapshotFolderCustom[sysID, imageCategoryID] = '') then // check if search category dir is empty
          begin
            if (imageCategoryID <> 1) and (SnapshotFolderCustom[sysID, 1] = '') then
               begin
                 // all .zip files can also be in "in-game snap" dir!!!! January 2016
                 FreeAndNil(imgZipFileListConsComp[sysID, imageCategoryID]);
                 Exit;
               end;
          end;
     end;

  //if (not IsCustomSystemAvailable(sysID)) or (SnapshotFolder[sysID, 1] = '') then // all .zip files must be in in-game snap dir!!!! January 2016
  //   begin
  //     FreeAndNil(imgZipFileList[sysID, imageCategoryID]);
  //     Exit;
  //   end;
  if ZipForge.Active then
     begin
       CallMessageBox;
       AddMsgText('    Unable to open ');
       AddMsgText(GetImgZipFileName(imageCategoryID), $00a65300, [fsBold]);
       AddMsgText(' file as there is another .zip file already opened.');
       GenerateMessage('Error! ImgZipParseFilesListConsComp()', SystemsListCustom[sysID, 0]);
       Exit;
     end;

  imgFile:= FullFolderFix(SnapshotFolderCustom[sysID, 1])+GetImgZipFileName(imageCategoryID);
  tResult:= FileExists(imgFile) and (not SameText(SnapshotFolderCustom[sysID, 1], ImageCategoryArray[imageCategoryID, 3]));
  if not tResult then
     begin
       imgFile:= FullFolderFix(SnapshotFolderCustom[sysID, imageCategoryID])+GetImgZipFileName(imageCategoryID);
       tResult:= FileExists(imgFile) and (not SameText(SnapshotFolderCustom[sysID, imageCategoryID], ImageCategoryArray[imageCategoryID, 3]));
     end;
  if not tResult then
     begin
       FreeAndNil(imgZipFileListConsComp[sysID, imageCategoryID]);
       Exit;
     end;
  if FormStatus.Visible then
     FormStatus.MessageStr(SystemsListCustom[sysID, 0]+#13#10+
                           'Loading "'+GetImgZipFileName(imageCategoryID)+'" contents in RAM for fast access.');
  case Assigned(imgZipFileListConsComp[sysID, imageCategoryID]) of
    True : imgZipFileListConsComp[sysID, imageCategoryID].Clear;
    False: imgZipFileListConsComp[sysID, imageCategoryID]:= THashedStringList.Create;
  end;
  imgZipFileListConsComp[sysID, imageCategoryID].BeginUpdate;

  with ZipForge do
  begin
    FileName:= imgFile;
    // Open existing archive file
    try
      OpenArchive(fmOpenRead or fmShareDenyNone);
      if FileCount > 0 then
         begin
           imgZipFileListConsComp[sysID, imageCategoryID].Add(imgFile); // first line always contains .zip filename!!! ????????????
           // Search text files stored inside the archive
           if FindFirst('*', ArchiveItem) then // '*.*'
              begin
                repeat
                  if (not ArchiveItem.ExternalFileAttributes and $10 = $10) then // do not add folders into the list ????????? June 09, 2016
                     imgZipFileListConsComp[sysID, imageCategoryID].Add(ArchiveItem.FileName);
                     //imgZipFileList[sysID, imageCategoryID].Add(LowerCase(ArchiveItem.FileName));
                until (not FindNext(ArchiveItem));
              end;
         end;
    except
      CloseArchive;
      FileName:= '';
      FreeAndNil(imgZipFileListConsComp[sysID, imageCategoryID]);
      Exit;
    end;
  end;
  imgZipFileListConsComp[sysID, imageCategoryID].EndUpdate;
  ZipForge.CloseArchive;
  ZipForge.FileName:= '';
end;
// end of functions for console/computer .zip filenames

procedure TFormMain.SelectRandomGame(ELV_Holder: TEasyListview; var CurrentSelection: TEasyItem);
var
  RandomValue: Cardinal;
  Continue, ValidateItem: Boolean;
  EasyItemIndex: TEasyItem;
  StartTimer, EndTimer: Integer;
begin
  if not CheckTotalVisible(ELV_Holder) then
     Exit;
  StartTimer:= GetTickCount;
  Continue:= False;
  Randomize;
  repeat
    RandomValue:= Random(ELV_Holder.Items.Count-1);
    ValidateItem:= RandomValue <> CurrentSelection.Index;
    if ValidateItem then
       begin
         EasyItemIndex:= ELV_Holder.Groups.FirstVisibleItem;
         repeat
           if EasyItemIndex.Index <> RandomValue then
              EasyItemIndex:= ELV_Holder.Groups.NextVisibleItem(EasyItemIndex)
           else
              Continue:= True;
         until (not Assigned(EasyItemIndex)) or Continue;
       end;
    if not Continue then
       begin
         EndTimer:= GetTickCount;
         if (EndTimer-StartTimer >= 3000) then
            begin
              EasyItemIndex:= ELV_Holder.Groups.FirstVisibleItem;
              Continue:= True;
            end;
       end;
  until (Continue);
  SelectEasyItem(EasyItemIndex);
end;

procedure TFormMain.FindGameName(const GameName: WideString; SystemID: Integer; IsCustomGame: Boolean; const SoftwareName: String; var pEasyItem: TEasyItem; ReturnFirstVisible: Boolean = True);
begin
  pEasyItem:= FindEasyItemGameName(GameName, SystemID, IsCustomGame, SoftwareName, ReturnFirstVisible);
end;

function TFormMain.FindEasyItemGameName(const GameName: WideString; SystemID: Integer; IsCustomGame: Boolean; const SoftwareName: String = ''; ReturnFirstVisible: Boolean = True): TEasyItem;
var
  Item: TEasyItem;
  Group: TEasyGroup;
begin
  Result:= nil;
  if (GameName = '') or (not CheckTotalVisible(GamesListView)) then
     Exit;
  if IsGroupedView then
  begin
    Group:= GamesListView.Groups.FirstVisibleGroup;
    repeat
      Item:= GamesListView.Groups.FirstVisibleInGroup(Group);
      repeat
        if TEasyGameInfo(Item).eName = GameName then
         begin
           if IsCustomGame then
              begin
                if (SystemID = -1) or (TEasyGameInfo(Item).eCustomSystemID = SystemID) then // and
                                       //(TEasyGameInfo(Item).eSoftwareName = SoftwareName)) then
                   Result:= Item;
              end
           else
              begin
                if (SystemID = -1) or ((TEasyGameInfo(Item).eSystemID = SystemID) and
                                       (TEasyGameInfo(Item).eSoftwareName = SoftwareName)) then
                   Result:= Item;
              end;
         end;
        if Result = nil then // this code line should be removed since "Result" is not changed when game is found!!!
           Item:= GamesListView.Groups.NextVisibleInGroup(Group, Item);
      until (Item = nil) or (Result <> nil);

      Group:= GamesListView.Groups.NextVisibleGroup(Group);
    until (Group = nil) or (Result <> nil);
  end
  else
  begin
    Item:= GamesListView.Groups.FirstVisibleItem;
    repeat
      if TEasyGameInfo(Item).eName = GameName then
         begin
           if IsCustomGame then
              begin
                if (SystemID = -1) or (TEasyGameInfo(Item).eCustomSystemID = SystemID) then // and
                                       //(TEasyGameInfo(Item).eSoftwareName = SoftwareName)) then
                   Result:= Item;
              end
           else
              begin
                if (SystemID = -1) or ((TEasyGameInfo(Item).eSystemID = SystemID) and
                                       (TEasyGameInfo(Item).eSoftwareName = SoftwareName)) then
                   Result:= Item;
              end;
         end;
      if Result = nil then // this code line should be removed since "Result" is not changed when game is found!!!
         Item:= GamesListView.Groups.NextVisibleItem(Item);
    until (Item = nil) or (Result <> nil);
  end;
  if (Result = nil) and ReturnFirstVisible then
     Result:= GamesListView.Groups.FirstVisibleItem;
end;

procedure TFormMain.SelectEasyItem(EasyItemIndex: TEasyItem); // ELV_Holder: TEasyListView = GamesListView
begin
  if not CheckTotal(GamesListView) then
     Exit;
  if (EasyItemIndex = nil) or (not EasyItemIndex.Visible) then
     EasyItemIndex:= GamesListView.Groups.FirstVisibleItem;

  GamesListView.Selection.ClearAll;

  if EasyItemIndex = nil then
     Exit;
  TEasyGameInfo(EasyItemIndex).Selected:= True;
  GamesListView.Selection.FocusedItem:= EasyItemIndex;
  EasyItemIndex.MakeVisible(emvMiddle);//(emvAuto);
end;

