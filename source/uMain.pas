function TFormMain.ValidateMultiSlot(sysID: ShortInt; const MachineName: String; var CommandLineVar: WideString; iCloseWindow: Boolean = True): Boolean;
var
  selItem: TEasyItem;
  HaveClones: Boolean;
  {iDriverName, iFile, }cmdLine: String;
  iCount, SlotsMax: Byte;
  iItemIndex, iIndex: Integer;
  //cStart: Integer;

  function CheckDriver(const DriverName, SelectedDriverName: String): Boolean;
  begin
    Result:= DriverName = ChangeFileExt(SelectedDriverName, '');
  end;

  function AddGameELV: Boolean;
  var
    //addItem: TEasyItem;
    tStr: String;
  begin
    tStr:= '';
    with FormArcadeMultiSlotGames.GamesList.Items.Add do
    begin
      Tag:= TEasyGameInfo(selItem).eGameSetStatus;
      ImageIndexes[1]:= TEasyGameInfo(selItem).eROMIdentification;
      case TEasyGameInfo(selItem).eIsFavorite of
        True:
          begin
            //HaveFavorites:= True;
            StateImageIndexes[1]:= 3;
          end;
        False: StateImageIndexes[1]:= 500;
      end;
      Captions[1]:= TEasyGameInfo(selItem).eTitle;
      Captions[2]:= TEasyGameInfo(selItem).eName;
      Captions[3]:= TEasyGameInfo(selItem).eClone;
      if TEasyGameInfo(selItem).ePlayed <> 0 then
         tStr:= IntToStr(TEasyGameInfo(selItem).ePlayed)+'x';
      if TEasyGameInfo(selItem).ePlayedDate <> 0 then
         begin
           if tStr <> '' then
              tStr:= tStr+' ';
           tStr:= tStr+GetDateTimeStr(TEasyGameInfo(selItem).ePlayedDate, True, True);
         end;
      Captions[4]:= tStr;
      Captions[5]:= GetNumberPlayersInfo(TEasyGameInfo(selItem).eNumberPlayers, TEasyGameInfo(selItem).eNumberPlayersIni);
      Captions[6]:= TEasyGameInfo(selItem).eYear;
      StateImageIndexes[7]:= TEasyGameInfo(selItem).eDriverStatus;
      if GameIsClone(TEasyGameInfo(selItem).eClone) then
         HaveClones:= True;
    end;
  end;

begin
  //Result:= sysID = idMAME; // HBMAME doesn't support multi-slot loading ???
  Result:= sysID in [idMAME, idHBMAME];
  if not Result then
     Exit;
  Result:= CheckMultipleSelected(GamesListView);
  if not Result then
     Exit;

  Result:= (MachineName = 'neogeo') or (MachineName = 'megatech') or (MachineName = 'playch10') or (MachineName = 'stv');
  if not Result then
     Exit;
  if (MachineName = 'neogeo') or (MachineName = 'stv') then
     begin
       // Neo-Geo MVS and ST-V requires external software lists
       Result:= LoadMultiSlotList(sysID, MachineName, Ord(MachineName = 'stv'));
       if not Result then
          Exit;
     end;

  //cStart:= GetTickCount;
  if not Assigned(FormArcadeMultiSlotGames) then
     FormArcadeMultiSlotGames:= TFormArcadeMultiSlotGames.Create(nil);

  if MachineName = 'neogeo' then
     SlotsMax:= 6
  else
  if MachineName = 'megatech' then
     begin
       SlotsMax:= 8;
       FormArcadeMultiSlotGames.Caption:= 'Sega Mega-Tech System';
     end
  else
  if MachineName = 'playch10' then
     begin
       SlotsMax:= 10;
       FormArcadeMultiSlotGames.Caption:= 'Nintendo PlayChoice-10';
     end
  else
  if MachineName = 'stv' then
     begin
       SlotsMax:= 4;
       FormArcadeMultiSlotGames.Caption:= 'Sega Titan Video Game System (ST-V)';
     end;
  FormArcadeMultiSlotGames.LabelHelpText.Caption:= Format(FormArcadeMultiSlotGames.LabelHelpText.Caption, [SlotsMax, '0.154']);
  //HaveFavorites:= False;
  HaveClones:= False;

  FormArcadeMultiSlotGames.GamesList.BeginUpdate;
  FormArcadeMultiSlotGames.GamesList.Items.ReIndexDisable:= True;

  iCount:= 0;
  //iSelectionCount:= GamesListView.Selection.Count;
  selItem:= GamesListView.Selection.First;
  iItemIndex:= 1;
  repeat
    if (TEasyGameInfo(selItem).eSystemID = sysID) and (TEasyGameInfo(selItem).eSoftwareName = '') then
    begin
      if IsROM_Have(TEasyGameInfo(selItem).eROMIdentification) then
      begin
        if MachineName = 'neogeo' then
        begin
          if TEasyGameInfo(selItem).eName <> 'neogeo' then
          begin
            if FormMain.IsNeoGeoDriver(TEasyGameInfo(selItem).eSystemID, TEasyGameInfo(selItem).eDriverName, TEasyGameInfo(selItem).eBiosName, True) then
               begin
                 case sysID of
                   idMAME:   iIndex:= MultiCartListMAME[0].IndexOf(TEasyGameInfo(selItem).eName);
                   idHBMAME: iIndex:= MultiCartListHBMAME[0].IndexOf(TEasyGameInfo(selItem).eName);
                 end;
                 //if MultiCartList[0].IndexOf(TEasyGameInfo(selItem).eName) <> -1 then
                 if iIndex <> -1 then
                    begin
                      Inc(iCount);
                      AddGameELV;
                    end;
               end;
          end
        end
        else
        if MachineName = 'stv' then
        begin
          if TEasyGameInfo(selItem).eName <> 'stvbios' then
          begin
            if CheckDriver(MachineName, TEasyGameInfo(selItem).eDriverName) then
               begin
                 case sysID of
                   idMAME:   iIndex:= MultiCartListMAME[1].IndexOf(TEasyGameInfo(selItem).eName);
                   idHBMAME: iIndex:= MultiCartListHBMAME[1].IndexOf(TEasyGameInfo(selItem).eName);
                 end;
                 //if MultiCartList[1].IndexOf(TEasyGameInfo(selItem).eName) <> -1 then
                 if iIndex <> -1 then
                    begin
                      Inc(iCount);
                      AddGameELV;
                    end;
               end;
          end
        end
        else
        begin
          if TEasyGameInfo(selItem).eName <> MachineName then
          begin
            if CheckDriver(MachineName, TEasyGameInfo(selItem).eDriverName) then
               begin
                Inc(iCount);
                AddGameELV;
               end;
          end;
        end;
        {if MachineName = 'megatech' then
        begin
          if TEasyGameInfo(selItem).eName <> 'megatech' then
          begin
            if CheckDriver('megatech', TEasyGameInfo(selItem).eDriverName) then
               begin
                 Inc(iCount);
                 AddGameELV;
               end;
          end;
        end;}
      end;
    end;
    selItem:= FormMain.ELV_GetNextSelected(GamesListView, selItem, iItemIndex);
    //if iItemIndex < iSelectionCount then
    //   selItem:= GamesListView.Selection.Next(selItem)
    //else
    //   selItem:= nil;
    //Inc(iItemIndex);
  until (selItem = nil) or (iCount >= SlotsMax);
  FormArcadeMultiSlotGames.GamesList.Items.ReIndexDisable:= False;
  FormArcadeMultiSlotGames.GamesList.EndUpdate(False);

  if MachineName = 'neogeo' then
     begin
       case sysID of
         idMAME  : FreeAndNil(MultiCartListMAME[0]);
         idHBMAME: FreeAndNil(MultiCartListHBMAME[0]);
       end;
     end;
  if MachineName = 'stv' then
     begin
       case sysID of
         idMAME  : FreeAndNil(MultiCartListMAME[1]);
         idHBMAME: FreeAndNil(MultiCartListHBMAME[1]);
       end;
     end;
  Result:= FormArcadeMultiSlotGames.GamesList.Groups.ItemCount > 1;
  if not Result then
     begin
       FreeAndNil(FormArcadeMultiSlotGames);
       Exit;
     end;
  if not HaveClones then
     FormArcadeMultiSlotGames.GamesList.Header.Columns[3].Visible:= False;

  //ShowMessage(IntToStr(GetTickCount-cStart));
  Result:= FormArcadeMultiSlotGames.ShowModal = mrYes;
  if Result then
     begin
       cmdLine:= '';
       iCount:= 1;
       selItem:= FormArcadeMultiSlotGames.GamesList.Groups.FirstItem;
       repeat
         cmdLine:= cmdLine+' -cart'+IntToStr(iCount)+' '+selItem.Captions[2];
         Inc(iCount);
         selItem:= FormArcadeMultiSlotGames.GamesList.Groups.NextItem(selItem);
       until selItem = nil;
       // MachineName is 'neogeo'; 'megatech'; 'playch10'; 'stvbios'...
       if MachineName <> 'stv' then
          CommandLineVar:= CommandLineVar+MachineName+cmdLine
       else
          CommandLineVar:= CommandLineVar+'stvbios'+cmdLine;
     end;
  if iCloseWindow then
     FreeAndNil(FormArcadeMultiSlotGames);
end;

function TFormMain.RunMAMEExtraParameters(sysID: Byte; const iEmulatorFile, SoftlistMachineName: String): String;
begin
  Result:= '';

  if not Assigned(FormArcadeRunGameExtraMAME) then
     FormArcadeRunGameExtraMAME:= TFormArcadeRunGameExtraMAME.Create(nil);

  FormArcadeRunGameExtraMAME.EmulatorFileName:= iEmulatorFile;
  FormArcadeRunGameExtraMAME.MachineNameToRun:= SoftlistMachineName;
  if FormArcadeRunGameExtraMAME.ShowModal = mrYes then
     Result:= FormArcadeRunGameExtraMAME.CommandLine
  else
     Result:= 'abort';
  FreeAndNil(FormArcadeRunGameExtraMAME);

  // -1: none... invalid!
 // 20: playback input
 // 21: record input
 // 22: load a save state (not used anymore!!!)
 // 23: record wave
 // 24: record mng
 // 25: record avi
 // 26: * left panel file select (not used anymore!!!)
 // 27: play and use an effect overlay
 // 28: Select Effect Overlay (MAME Settings)
 // 29: Select Font Files, emulator (BDF)
 // 30: Select Font Files, game, driver (BDF)
 // 31: Select Shadow Mask Texture (MAME Settings)
 // all these options are now MAME exclusive features

{ case MAME_ExtraSetting of
   20, 21:
     begin
       iDir:= LoadFolderSpecial_MAME(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID], 1);
       if iDir = '' then
          begin
            GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Input folder is blank.',
                            '    In order to playback / record input files, you need to select a folder '+
                            'in '+GetSystemShortTitle(MemGameInfo.eSystemID)+' default settings screen.', 2, False, 1);
            ResetSettings;
            Exit;
          end
       else
          begin
            iDir:= FullFolderFix(iDir, EmulatorFile[MemGameInfo.eSystemID]);
            if MAME_ExtraSetting = 20 then
               begin
                 if not DirectoryExists(iDir) then
                    begin
                      CallMessageBox;
                      ShowGameNameEntryMsgBox;
                      AddMsgText('    Folder ');
                      AddMsgText(iDir, $00a65300, [fsBold]);
                      AddMsgText(' was not found. There are no input files to load. Select a valid input folder in '+
                                 GetSystemShortTitle(MemGameInfo.eSystemID)+' default settings screen or record an input for the selected '+
                                 'game first.'+#13#10+'Aborting...');
                      GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Input folder doesn''t exist.', '', 2, False, 1);
                      ResetSettings;
                      Exit;
                    end;
               end
            else
               begin
                 if not ForceDirectories(iDir) then
                    begin
                      CallMessageBox;
                      ShowGameNameEntryMsgBox;
                      AddMsgText('    Folder ');
                      AddMsgText(iDir, $00a65300, [fsBold]);
                      AddMsgText(' was not found and could not be created. Create the input folder manually or '+
                                 'select another folder in '+GetSystemShortTitle(MemGameInfo.eSystemID)+
                                 ' default settings screen.'+#13#10+'Aborting...');
                      GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Input folder doesn''t exist.', '', 2, False, 1);
                      ResetSettings;
                      Exit;
                    end;
               end;
          end;
     end;
   22:
     begin
       iDir:= LoadFolderSpecial_MAME(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID], 3);
       if iDir = '' then
          begin
            GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Save state folder is blank.',
                            '    In order to load save state files , you need to select a folder '+
                            'in '+GetSystemShortTitle(MemGameInfo.eSystemID)+' default settings screen.', 2, False, 1);
            ResetSettings;
            Exit;
          end;
       //if SaveStateDir = '' then
       //   begin
       //     GenerateMessage(ErrorMsgTitle, Format('Save state folder is blank [%s].', [GetEmulatorDescription(MemGameInfo.eSystemID)]),
       //                     Format('In order to load save state files, you need to select a folder '+
       //                     'on %s default settings screen.', [GetEmulatorDescription(MemGameInfo.eSystemID)]), 2, False, 1);
       //     ResetSettings;
       //     Exit;
       //   end;
     end;
   23, 24, 25:
     begin
       NewOption:= GetFolderFull(1, MemGameInfo.eSystemID);
       if NewOption = '' then
          begin
            GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Multimedia folder is blank.',
                            '    In order to record wav/mng/avi files you must select a snapshot folder in Emulator Default '+
                            'Settings screen.', 2, False, 1);
            ResetSettings;
            Exit;
          end
       else
          begin
            if not ForceDirectories(NewOption+'multimedia_files\'+SoftwareNameFolder) then
               begin
                 CallMessageBox;
                 ShowGameNameEntryMsgBox;
                 AddMsgText('    Folder ');
                 AddMsgText(NewOption+'multimedia_files\'+SoftwareNameFolder, $00a65300, [fsBold]);
                 AddMsgText('was not found and could not be created. Try again or create the folder manually. '+
                            'This folder is exclusive to Emu Loader, not part of '+GetSystemShortTitle(MemGameInfo.eSystemID)+
                            '.'+#13#10+'Aborting...');
                 GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Multimedia folder doesn''t exist.', '', 2, False, 1);
                 ResetSettings;
                 Exit;
               end;
            //'multimedia_files\'
          end;
     end;
   27:
     begin
       // use an effect overlay
       // nothing for now...
     end;
 end;
 case SelectFileName(MAME_ExtraSetting, MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID], NewOption) of
   True:
     begin
       case MAME_ExtraSetting of
         20, 21:
           begin
             if (GetMAMEBuild in [0..58]) then // if GetMAMEBuild < 59 then // version "-1" means could not get version info... assume it's latest MAME builds!!! July 25, 2016
                NewOption:= ChangeFileExt(NewOption, ''); // previous to v0.59; MAME adds a .inp extension automatically!!!
             if MAME_ExtraSetting = 20 then
                CommandLine:= CommandLine+' -playback '+NewOption
             else
                CommandLine:= CommandLine+' -record '+NewOption;
           end;
         //20:
         //  begin
         //    if GetMAMEBuild < 59 then
         //       NewOption:= ChangeFileExt(NewOption, ''); // previous to v0.59 MAME adds a .inp extension automatically!!!
         //    CommandLine:= CommandLine+' -playback '+NewOption;
         //  end;
         //21:
         //  begin
         //    if GetMAMEBuild < 59 then
         //       NewOption:= ChangeFileExt(NewOption, ''); // previous to v0.59 MAME adds a .inp extension automatically!!!
         //    CommandLine:= CommandLine+' -record '+NewOption;
         //  end;
         //22: CommandLine:= CommandLine+' -noautosave -state '+NewOption;
         22: CommandLine:= CommandLine+' -state '+NewOption;
         23: CommandLine:= CommandLine+' -wavwrite "'+NewOption+'"';
         24: CommandLine:= CommandLine+' -mngwrite "'+NewOption+'"';
         25: CommandLine:= CommandLine+' -aviwrite "'+NewOption+'"';
         27: CommandLine:= CommandLine+' -effect '+NewOption;
       end;
     end;
   False:
     begin
       ResetSettings;
       Exit;
     end;
 end;
end;}

end;

function TFormMain.GetTitleMachineToUse(sysID: Integer; const iMachineName, GameName, SoftwareName: String; var ItemHolder: TEasyItem): WideString;
var
  Group: TEasyGroup;
  Item: TEasyItem;
  GameFound: Boolean;
begin
  Result:= '';
  GameFound:= False;
  ItemHolder:= nil;
  if IsGroupedView then
    begin
      Group:= GamesListView.Groups.FirstGroup;
      repeat
        if (TGroupInfo(Group).eSystemID = sysID) and (TGroupInfo(Group).eSoftwareName = '') then
        begin
          Item:= GamesListView.Groups.FirstInGroup(Group);
          repeat
            if TEasyGameInfo(Item).eName = iMachineName then
               begin
                 GameFound:= True;
                 ItemHolder:= Item;
                 Result:= TEasyGameInfo(Item).eTitle;

               end;
            Item:= GamesListView.Groups.NextInGroup(Group, Item);
          until (Item = nil) or GameFound;
        end;
        Group:= GamesListView.Groups.NextGroup(Group);
      until (Group = nil) or GameFound;
    end
    else
    begin
      Item:= GamesListView.Groups.FirstItem;
      repeat
        if (uMain.TEasyGameInfo(Item).eSystemID = sysID) and (TEasyGameInfo(Item).eSoftwareName = '') then
           begin
             if TEasyGameInfo(Item).eName = iMachineName then
                begin
                  GameFound:= True;
                  ItemHolder:= Item;
                  Result:= TEasyGameInfo(Item).eTitle;
                end;
           end;
        Item:= GamesListView.Groups.NextItem(Item);
      until (Item = nil) or GameFound;
    end;
end;

// new ExecuteGame() function with .bat; .cmd batch files detection and NO custom .bat file support!
// Jan 30, 2014
function TFormMain.ExecuteGame(MAME_ExtraSetting: ShortInt = -1; MAME_ExtraPamars: Boolean = False): Integer;
var
  msgboxTitle, EmulatorTitle, MachineNameStr, SoftwareNameFolder, MAME_ExtraParamsCommandLine: String; // CommandLine,
  //TimesPlayed: TMemIniFile;
  ErrorMsgTitle, MultiSlotMachineName, StrDOSName, TempStr: String;
  ScreenResolutions: THashedStringList;
  IsBatchFile, IsBatchFileAlterMAME, IsAlterMAME, IsDemulEmptySystem, TryAgainAlterMAME, IsMultiSlot: Boolean;
  ExitCode, ExitCodeAlterMAME: DWORD;
  iPlayTime: Cardinal;
  msItem, MAMEMachineItem: TEasyItem;
  MsgType: ShortInt;
  ItemToUpdate: TEasyItem;
  CommandLine, MachineToUse_Title, NewOption, NewOption2: WideString;

  function ResetSettings: Boolean;
  begin
    Result:= True;
    if MemGameInfo.eIsCustomGame then
       MemGameInfo.eSystemID:= -1;
    FreeAndNil(ScreenResolutions);
    ThousandSeparator:= Char(',');
    DecimalSeparator:= Char('.');
    SetCurrentDir(FrontendPath);
    TempGameVars.eName:= '';
    FocusGamesList;
  end;

  function GetScreenResolutions: Boolean;
  begin
    Result:= True;
    ScreenResolutions:= THashedStringList.Create;
    ListScreenModes(ScreenResolutions, True);
  end;

  function ValidateResolution(const ResStr: String): Boolean;
  begin
    Result:= (ScreenResolutions.IndexOf(ResStr) > -1);
    if not Result then
       GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Invalid resolution.',
                       '  The Resolution '+ResStr+' is not valid for your video card and/or monitor.'+#13#10+
                       'If you try to run the emulator in full screen mode with this resolution, it might damage your monitor '+
                       'and/or your video card. Please change the resolution or run the game in window mode.'+#13#10+
                       'Aborting...', 2, False, 1);
  end;

  function ValidateAlterMAME: Boolean;
  var
    iAltVersion: Integer;
  begin
    iAltVersion:= GetMAMEBuild(idMAME, True);
    Result:= (MemGameInfo.eSystemID = idMAME) and (AlterMAMEFile <> '') and FileExists(AlterMAMEFile);
    IsAlterMAME:= Result and (MAME_ExtraSetting = 1);
    TryAgainAlterMAME:= Result and PopupAutoRunGameAlterMAME.Checked and (not IsAlterMAME);// and ((iAltVersion >= 162) or (iAltVersion = -1)); // always false if IsAlterMAME = true
    if TryAgainAlterMAME then
       begin
         case MemGameInfo.eIsCustomGame of
           True:
             begin
               TryAgainAlterMAME:= ((iAltVersion >= 162) or (iAltVersion = -1));
             end;
           False:
             begin
               if MemGameInfo.eSoftwareName <> '' then
                  TryAgainAlterMAME:= ((iAltVersion >= 162) or (iAltVersion = -1));
             end;
         end;
       end;
  end;

  function SetCmdLineTitle(IsCustom: Boolean = False): Boolean;
  var
    RunStr: String;
  begin
    Result:= True;
    if MemGameInfo.eIsCustomGame then
       begin
         RunStr:= 'Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game';
         //if SystemIsConsole(MemGameInfo.eCustomSystemID) or SystemIsHandheld(MemGameInfo.eCustomSystemID) then
         //   RunStr:= 'Run Console Game'
         //else
         //if SystemIsComputer(MemGameInfo.eCustomSystemID) then
         //   RunStr:= 'Run Computer Game';
       end
    else
    begin
      if (MemGameInfo.eSystemType = 0) or (MemGameInfo.eSoftwareName <> '') then
         RunStr:= 'Run Game'
      else
         RunStr:= 'Run Machine';
    end;
    case IsCustom of
      True : msgboxTitle:= RunStr+', Custom Settings - '+EmulatorTitle;
      False: msgboxTitle:= RunStr+' - '+EmulatorTitle;
    end;
  end;

  function ReadSupermodelParameters(const SMIniFile: String): String;
  var
    SupermodelIni: TMemIniFile;
    StrValue: String;
    IntValue: Integer;
    RunFullScreen, UseFrequency, UseFrequencyCustom: Boolean;
  begin
    Result:= '';
    UseFrequency:= False;
    UseFrequencyCustom:= False;
    SupermodelIni:= TMemIniFile.Create(SMIniFile);
    IntValue:= SupermodelIni.ReadInteger('Emulation', 'Multithreading', 1);
    if not Boolean(IntValue) then
       Result:= Result+'-no-threads ';

    IntValue:= SupermodelIni.ReadInteger('Emulation', 'GPUMultithreading', 1);
    if not Boolean(IntValue) then
       Result:= Result+'-no-gpu-thread ';

    StrValue:= SupermodelIni.ReadString('Emulation', 'PowerPCFrequencyCustom', '');
    IntValue:= SupermodelIni.ReadInteger('Emulation', 'PowerPCFrequency', 2);
    if not (IntValue in [0..8]) then
       IntValue:= 5; // 50 MHz (emulator default frequency!)
    if IntValue <> 5 then
       UseFrequency:= True;

    if StrValue <> '' then
       begin
         IntValue:= StrToInt(StrValue);
         if (IntValue > 1) and (IntValue < 1000) then
            UseFrequencyCustom:= True;
       end;

    if UseFrequencyCustom then
       Result:= '-ppc-frequency='+StrValue+' '
    else
    if UseFrequency then
       Result:= ' -ppc-frequency='+IntToStr(Model3PowerPCFrequency[IntValue])+' ';

    IntValue:= SupermodelIni.ReadInteger('Video', 'New3DEngine', 1);
    case IntValue of // as listed in 3D Engine combobox in Supermodel settings screen
      0: Result:= Result+'-legacy3d ';
      1: Result:= Result+'-new3d ';
    end;
       
    IntValue:= SupermodelIni.ReadInteger('Video', 'Widescreen', 0);
    if Boolean(IntValue) then
       Result:= Result+'-wide-screen ';

    IntValue:= SupermodelIni.ReadInteger('Video', 'MultiTexture', 1);
    if not Boolean(IntValue) then
       Result:= Result+'-no-multi-texture ';

    RunFullScreen:= Boolean(SupermodelIni.ReadInteger('Video', 'FullScreen', 0));

    StrValue:= '';
    StrValue:= SupermodelIni.ReadString('Video', 'Resolution', 'auto');
    if StrValue = '' then
       StrValue:= 'auto';
    case RunFullScreen of
      True:
        begin
          if SameText('auto', StrValue) then
             StrValue:= IntToStr(Screen.Width)+'x'+IntToStr(Screen.Height);
          if not ValidateResolution(StrValue) then
             begin
               // this should never happen!!!!
               Result:= 'invalid_resolution';
               FreeAndNil(SupermodelIni);
               Exit;
             end;
          Result:= Result+'-res='+StringReplace(StrValue, 'x', ',', [rfIgnoreCase])+' -fullscreen ';
        end;
      False:
        begin
          if not SameText('auto', StrValue) then
             Result:= Result+'-res='+StringReplace(StrValue, 'x', ',', [rfIgnoreCase])+' ';
        end;
    end;
    IntValue:= SupermodelIni.ReadInteger('Video', 'DisableThrottle', 0);
    if Boolean(IntValue) then
       Result:= Result+'-no-throttle ';

    IntValue:= SupermodelIni.ReadInteger('Video', 'DisableVSync', 0);
    if Boolean(IntValue) then
       Result:= Result+'-no-vsync ';

    IntValue:= SupermodelIni.ReadInteger('Video', 'ShowFPS', 0);
    if Boolean(IntValue) then
       Result:= Result+'-show-fps ';

    IntValue:= SupermodelIni.ReadInteger('Audio', 'DisableSound', 0);
    if Boolean(IntValue) then
       Result:= Result+'-no-sound ';

    IntValue:= SupermodelIni.ReadInteger('Audio', 'DisableMusic', 0);
    if Boolean(IntValue) then
       Result:= Result+'-no-dsb ';

    IntValue:= SupermodelIni.ReadInteger('Audio', 'FlipStereo', 0);
    if Boolean(IntValue) then
       Result:= Result+'-flip-stereo ';

    IntValue:= SupermodelIni.ReadInteger('Audio', 'SoundVolume', 100);
    if IntValue <> 100 then
       Result:= Result+ '-sound-volume='+IntToStr(IntValue)+' ';

    IntValue:= SupermodelIni.ReadInteger('Audio', 'MusicVolume', 100);
    if IntValue <> 100 then
       Result:= Result+'-music-volume='+IntToStr(IntValue)+' ';

    IntValue:= SupermodelIni.ReadInteger('Audio', 'Balance', 0);
    if IntValue <> 0 then
       Result:= Result+'-balance='+IntToStr(IntValue)+' ';

    StrValue:= SupermodelIni.ReadString('Controls', 'InputSystem', 'dinput');
    if not SameText(StrValue, 'dinput') then
       Result:= Result+ '-input-system='+StrValue+' ';

    IntValue:= SupermodelIni.ReadInteger('Controls', 'Crosshairs', 0); // 0 = none (default)
    if IntValue <> 0 then
       Result:= Result+'-crosshairs='+IntToStr(IntValue)+' ';
       
    IntValue:= SupermodelIni.ReadInteger('Controls', 'EnableForceFeedback', 0);
    if Boolean(IntValue) then
       Result:= Result+ '-force-feedback ';

    StrValue:= SupermodelIni.ReadString('Debug', 'VertexShader', '');
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+'-vert-shader="'+StrValue+'" ';
       //Result:= Result+Format('-vert-shader="%s" ', [StrValue]);

    StrValue:= SupermodelIni.ReadString('Debug', 'FragmentShader', '');
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+' -frag-shader="'+StrValue+'" ';
       //Result:= Result+Format(' -frag-shader="%s" ', [StrValue]);

    FreeAndNil(SupermodelIni);
  end;

  function ReadSupermodelIni(const FileStr: String): String;
  begin
    Result:= '';
    if not FileExists(GetFolderArcadeEmulatorIni(idSupermodel)+FileStr) then
       Exit;
    Result:= ReadSupermodelParameters(GetFolderArcadeEmulatorIni(idSupermodel)+FileStr);
    if Result <> '' then
       CommandLine:= CommandLine+Result
    else
    if Result = 'invalid_resolution' then
       ResetSettings;
  end;

  function ReadDaphneIni: String;
  var
    DaphneIni: TMemIniFile;
    StrValue: String;
    IntValue: Integer;
  begin
    Result:= '';
    StrValue:= GetArcadeEmuIniFileName(idDaphne);
    if not FileExists(StrValue) then
       begin
         Result:= ' vldp';
         Exit;
       end;
    DaphneIni:= TMemIniFile.Create(StrValue);
    StrValue:= DaphneIni.ReadString('General', 'LaserdiscType', 'vldp');
    Result:= ' '+StrValue;

    if StrValue = 'vldp' then
       begin
         // these settings only work when "Virtual Laser Disc Player" is used
         IntValue:= DaphneIni.ReadInteger('Audio', 'VolumeVLDP', -1);
         if IntValue <> -1 then
            Result:= Result+' -volume_vldp '+IntToStr(IntValue);

         IntValue:= DaphneIni.ReadInteger('Video', 'BlankSkips', 0);
         if Boolean(IntValue) then
            Result:= Result+' -blank_skips';

         IntValue:= DaphneIni.ReadInteger('Video', 'BlankSearches', 0);
         if Boolean(IntValue) then
            Result:= Result+' -blank_searches';
       end
    else
    if StrValue <> 'noldp' then
       begin
         // options that only work for real Laserdisc players
         IntValue:= DaphneIni.ReadInteger('General', 'StopLaserdiscOnQuit', 0);
         if Boolean(IntValue) then
            Result:= Result+' -stoponquit';
       end;

    StrValue:= DaphneIni.ReadString('Video', 'ScrResolution', 'auto');
    if StrValue <> 'auto' then
       begin
         Result:= Result+Format(' -x %s -y %s',
                            [Copy(StrValue, 1, PosEx('x', StrValue)-1),
                             Copy(StrValue, PosEx('x', StrValue)+1, Length(StrValue))]);
       end;
    IntValue:= DaphneIni.ReadInteger('Video', 'OpenGL', 0);
    if Boolean(IntValue) then
       Result:= Result+' -opengl';

    IntValue:= DaphneIni.ReadInteger('Video', 'FullScreen', 0);
    if Boolean(IntValue) then
       Result:= Result+' -fullscreen';

    IntValue:= DaphneIni.ReadInteger('Video', 'IgnoreAspectRatio', 0);
    if Boolean(IntValue) then
       Result:= Result+' -ignore_aspect_ratio';

    IntValue:= DaphneIni.ReadInteger('Video', 'FullScale', 0);
    if Boolean(IntValue) then
       Result:= Result+' -fullscale';

    IntValue:= DaphneIni.ReadInteger('Audio', 'PreferSamples', 0);
    if Boolean(IntValue) then
       Result:= Result+' -prefer_samples';

    IntValue:= DaphneIni.ReadInteger('Audio', 'NoSound', 0);
    if Boolean(IntValue) then
       Result:= Result+' -nosound';

    IntValue:= DaphneIni.ReadInteger('Input', 'NoJoysticks', 0);
    if Boolean(IntValue) then
       Result:= Result+' -nojoystick';

    IntValue:= DaphneIni.ReadInteger('General', 'NoCreateLogFile', 1);
    if not Boolean(IntValue) then
       Result:= Result+' -nolog';

    IntValue:= DaphneIni.ReadInteger('General', 'NoWarnings', 0);
    if Boolean(IntValue) then
       Result:= Result+' -noissues';

    IntValue:= DaphneIni.ReadInteger('General', 'SendUsageStatistics', 1);
    if not Boolean(IntValue) then
       Result:= Result+' -noserversend';

    IntValue:= DaphneIni.ReadInteger('General', 'IdleExit', 0);
    if Boolean(IntValue) then
       begin
         IntValue:= DaphneIni.ReadInteger('General', 'IdleExitSeconds', 30);
         Result:= Result+ ' -idleexit '+IntToStr(IntValue);
       end;

    IntValue:= DaphneIni.ReadInteger('General', 'EnableCheat', 0);
    if Boolean(IntValue) then
       Result:= Result+' -cheat';

    IntValue:= DaphneIni.ReadInteger('General', 'SRAMContinuousUpdate', 0);
    if Boolean(IntValue) then
       Result:= Result+' -sram_continuous_update';

    IntValue:= DaphneIni.ReadInteger('General', 'FastBoot', 0);
    if Boolean(IntValue) then
       Result:= Result+' -fastboot';

    FreeAndNil(DaphneIni);
  end;

  function IsDemulOldVersion: Boolean;
  var
    iDemulPos: Integer;
    iDemulVersion: ShortInt;
    iDemulStr: String;
  begin
    iDemulStr:= EmulatorVersion[idDemul];
    if iDemulStr = '' then
       Result:= False
    else
    begin
      iDemulPos:= PosEx(' v', iDemulStr);
      if iDemulPos <> 0 then
         begin
           if iDemulStr[iDemulPos+2] = '0' then
              begin
                iDemulVersion:= StrToInt(iDemulStr[iDemulPos+4]);
                Result:= iDemulVersion < 7;
              end
           else
              Result:= False;
         end
      else
         Result:= False;
    end;
  end;
  
  function GetGamesListVersion(sysID: Integer): String;
  var
    tmpFile: TMemIniFile;
  begin
    Result:= '-';
    if not FileExists(FormMain.GetGamesFolderEL+GetSystemFileName(sysID)) then
       Exit;
    tmpFile:= TMemIniFile.Create(FormMain.GetGamesFolderEL+GetSystemFileName(sysID));
    Result:= tmpFile.ReadString('info_file', 'version', '');
    FreeAndNil(tmpFile);
  end;
  
