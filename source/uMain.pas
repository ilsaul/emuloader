procedure TFormMain.GetCustomGames(SystemID, MediaTypeID: Integer; FoldersHolder, GamesHolder: THashedStringList);
var
  Counter: Integer;
begin
  // Get Files List
  if (not Assigned(FoldersHolder)) or (not Assigned(GamesHolder)) then
     Exit;
  if FoldersHolder.Count > 0 then
     begin
       if FormStatus.Visible then
          FormStatus.MessageStr('Scannig for files: '+MediaTypeCustom[MediaTypeID, 0]);
       for Counter:=0 to FoldersHolder.Count - 1 do
           GetGamesFilesListW(FoldersHolder[Counter], '', GamesHolder, True, MediaTypeID); // scan sub-folders too!!!
     end;
end;

function TFormMain.CallSelectConsCompSystem(FeatureType: ShortInt = -1; SelectSysID: Integer = 0; MultiListVar: TStringList = nil): Integer;
var
  Item: TEasyItem;
begin
  Result:= -1;
  if not Assigned(FormConsCompSystemSelector) then
     FormConsCompSystemSelector:= TFormConsCompSystemSelector.Create(nil);

  if Screen.Width >= 1280 then
     begin
       FormConsCompSystemSelector.IL_Systems.Width:= 68;
       FormConsCompSystemSelector.IL_Systems.Height:= 68;
       FormConsCompSystemSelector.Systems.CellSizes.Icon.Width:= 78;
       FormConsCompSystemSelector.Systems.CellSizes.Icon.Height:= 105;
     end;
  FormConsCompSystemSelector.ActionMode:= FeatureType;
  FormConsCompSystemSelector.selSysID:= SelectSysID;

  LoadNonArcadeSystemIcons(FormConsCompSystemSelector.IL_Systems, False);

  if FormConsCompSystemSelector.ShowModal = mrOk then
     begin
       case FormConsCompSystemSelector.Systems.Selection.MultiSelect of
         True:
           begin
             if FormConsCompSystemSelector.Systems.Selection.Count = 1 then
                Result:= FormConsCompSystemSelector.Systems.Selection.First.ImageIndex
             else
                begin
                  if FormConsCompSystemSelector.Systems.Groups.FirstItem.Selected then
                     Result:= 0 // if All Systems filter is selected, set result to 0
                  else
                     begin
                       Result:= idMultiSys;// 500; // high number for the multiple filters selected
                       if (FeatureType = 1) and (MultiListVar <> nil) then
                          begin
                            // create games list
                            //MultiListVar:= TStringList.Create;
                            MultiListVar.BeginUpdate;
                            Item:= FormConsCompSystemSelector.Systems.Selection.First;
                            repeat
                              MultiListVar.Add(IntToStr(Item.ImageIndex));
                              Item:= FormConsCompSystemSelector.Systems.Selection.Next(Item);
                            until Item = nil;
                            MultiListVar.EndUpdate;
                          end;
                     end;
                end;
           end;
         False: Result:= FormConsCompSystemSelector.Systems.Selection.First.ImageIndex;
       end;
     end;
  FreeAndNil(FormConsCompSystemSelector);
end;

function TFormMain.CreateCustomGamesList(SystemID: Integer; IsMultiList: Boolean; IgnoreFileExtensionVar: THashedStringList; NoFoldersDefinedMessage: Boolean = True): Boolean;
var
  Loop, CounterGame: Integer;
  AddGame{, iUnicode}: Boolean;
  FileExtension, MsgTitle, FileFullPath, SystemFileName: String;
  FilesListCustom, ExistingGames: THashedStringList;
  msgFlags: Integer;

  function ResetVars: Boolean;
  begin
    Result:= True;
    ClearMemGameInfo(TempGameVars);
    FreeAndNil(ExistingGames);
    FreeAndNil(ListCustomGameName);
    FreeAndNil(ListCustomGameSize);
    FreeAndNil(FilesListCustom);
    FreeAndNil(ListGames);
    FreeAndNil(CompleteGamesList);
  end;

  function GetActualGamesList: Boolean;
  var
    InternalLoop: Integer;
  begin
    Result:= ValidateFile(SystemFileName);
    if Result then
       begin
         ExistingGames:= THashedStringList.Create;
         ExistingGames.LoadFromFile(SystemFileName);
         for InternalLoop:=0 to ExistingGames.Count-1 do
         begin
           GetCustomGameFields(ExistingGames[InternalLoop]);
           ExistingGames[InternalLoop]:= LowerCase(TempGameVars.eName);
         end;
       end;
  end;

  function CheckNonGameFiles(const ListFileName: String): Boolean;
  var
    fExt: String;
  begin
    fExt:= LowerCase(ExtractFileExt(ListFileName));
    case SameText(fExt, '.wav') of
      True : Result:= TempGameVars.eCustomMediaType <> 2;
      False: Result:= IgnoreFileExtensionVar.IndexOf(fExt) = -1;
    end;
  end;

  function ValidateSysFolders(MediaTypeIndex: Integer): Boolean;
  begin
    Result:= Assigned(sysCustomFolders[SystemID, MediaTypeIndex]) and
             (sysCustomFolders[SystemID, MediaTypeIndex].Count > 0);
  end;

  function GetContentsCustom(const ZipFileName: WideString; DeleteList: Boolean): Boolean;
  var
    ArchiveItem: TZFArchiveItem;
  begin
    //Result:= True;
    if DeleteList then
       begin
         if Assigned(ListCustomGameName) then
            ListCustomGameName.Clear;
         if Assigned(ListCustomGameSize) then
            ListCustomGameSize.Clear;
       end;

    ListCustomGameName.BeginUpdate;
    ListCustomGameSize.BeginUpdate;
    with ZipForge do
    begin
      FileName:= ZipFileName;

      // Open existing archive file
      try
        OpenArchive(fmOpenRead or fmShareDenyNone);

        Result:= FileCount > 0;
        if Result then
           begin
             // Search text files stored inside the archive
             if (FindFirst('*', ArchiveItem, faAnyFile-faDirectory)) then // '*.*'
                begin
                  repeat
                    if Assigned(ListCustomGameName) then
                       ListCustomGameName.Add(AnsiLowerCase(ArchiveItem.FileName));
                    if Assigned(ListCustomGameSize) then
                       ListCustomGameSize.Add(IntToStr(ArchiveItem.UncompressedSize));
                  until (not FindNext(ArchiveItem));
                end
             else
                Result:= False;
           end;
        CloseArchive;
        ZipForge.FileName:= '';
      except
        Result:= False;
        CloseArchive;
        ZipForge.FileName:= '';
      end;
    end;
    ListCustomGameName.EndUpdate;
    ListCustomGameSize.EndUpdate;
  end;

  function GetSevenZipContentsCustom(const SevenZipFileName: WideString; DeleteList: Boolean): Boolean;
  var
    ArchiveItem: I7zInArchive;
    Loop7z: Integer;
  begin
    if DeleteList then
       begin
         if Assigned(ListCustomGameName) then
            ListCustomGameName.Clear;
         if Assigned(ListCustomGameSize) then
            ListCustomGameSize.Clear;
       end;
    ListCustomGameName.BeginUpdate;
    ListCustomGameSize.BeginUpdate;
    try
      ArchiveItem:= CreateInArchive(CLSID_CFormat7z);
    except
      ListCustomGameName.EndUpdate;
      ListCustomGameSize.EndUpdate;
      Result:= False;
      Exit;
    end;
    //SevenZ.OpenFile('D:\emulators\mame\MameUI64.7z');
    with ArchiveItem do
    begin
      // Open existing archive file
      try
        OpenFile(SevenZipFileName);

        Result:= NumberOfItems > 0;
        if Result then
           begin
             // Search text files stored inside the archive
             for Loop7z:= 0 to NumberOfItems-1 do
             begin
               if not ItemIsFolder[Loop7z] then
                  begin
                    ListCustomGameName.Add(ItemPath[Loop7z]);
                    ListCustomGameSize.Add(IntToStr(ItemSize[Loop7z]));
                  end;
             end;
           end;
        Close;
      except
        Result:= False;
        Close;
      end;
    end;
    ListCustomGameName.EndUpdate;
    ListCustomGameSize.EndUpdate;
  end;

begin
  Result:= False;
  SystemFileName:= GetGamesFolderEL(2)+SystemsListCustom[SystemID, 2];
  MsgTitle:= SystemsListCustom[SystemID, 0]+#13#10+'Create Games List';
  if (MenuCreateCustomGamesList.Tag = 1) and ValidateFile(SystemFileName) and (ButtonMainMenuOptions.Tag = 0) then
     begin
       CallMessageBox;
       FormMessageBox.ButtonYesToAll.Visible:= True;
       FormMessageBox.ButtonAbort.Visible:= True;
       IL_StandardIconsExtraLarge.GetIcon(SystemID, FormMessageBox.MessageIcon.Picture.Icon);
       //AddMsgText('    Failed to create the process.'+#13#10);
       //AddMsgText(AppPath, $00a65300, [fsBold]);
       AddMsgText('    Option ');
       AddMsgText('Create New List', $00a65300, [fsBold]);
       AddMsgText(' is enabled. '+#13#10+
                   'The list for the current system will be overwritten!'+#13#10+#13#10+
                   '    To add more games into an existing list, ');
       AddMsgText('uncheck', clBlack, [fsBold]);
       AddMsgText(' this option in the select systems dialog...'+#13#10+#13#10+
                   '    Choose what to do:'+#13#10+
                   '- Click ');
       AddMsgText('Yes', $00a65300, [fsBold]);
       AddMsgText(' to overwrite the current list (or ');
       AddMsgText('Enter', $00a65300, [fsBold]);
       AddMsgText(' key)'+#13#10+
                  '- Click ');
       AddMsgText('Yes To All', $00a65300, [fsBold]);
       AddMsgText(' to overwrite the list for all selected systems ');
       AddMsgText('(away with this message!)', clBlack, [fsItalic]);
       AddMsgText(#13#10+
                  '- Click ');
       AddMsgText('No', $00a65300, [fsBold]);
       AddMsgText(' to avoid creating the list for the current system (or ');
       AddMsgText('Esc', $00a65300, [fsBold]);
       AddMsgText(' key; title''s bar ');
       AddMsgText('Close', clBlack, [fsBold, fsItalic]);
       AddMsgText(' button)'+#13#10+
                 '- Click ');
       AddMsgText('Abort', $00a65300, [fsBold]);
       AddMsgText(' to cancel this procedure for all systems'+#13#10+#13#10+
                  '    Continue with this operation ?');
       msgFlags:= GenerateMessage('Create Games List', SystemsListCustom[SystemID, 0], '', 3);

       case msgFlags of
         mrNo: Exit;
         mrAbort:
           begin
             MenuCreateCustomGamesList.HelpContext:= 1;
             Exit;
           end;
         mrYesToAll: ButtonMainMenuOptions.Tag:= 1;
       end;
     end;

  FormStatus.TitleStr(MsgTitle);
  FormStatus.Show;

  CheckAndCreateFolder(GetGamesFolderEL(2));

  Application.ProcessMessages;
  FilesListCustom:= THashedStringList.Create;
  for Loop:= Low(MediaTypeCustom) to High(MediaTypeCustom) do
      GetCustomGames(SystemID, Loop, sysCustomFolders[SystemID, Loop], FilesListCustom);

  if FilesListCustom.Count = 0 then
     begin
       FreeAndNil(FilesListCustom);
       if not IsMultiList then
          FormStatus.Close;
       if NoFoldersDefinedMessage then
          GenerateMessage('Create Games List', SystemsListCustom[SystemID, 0],
                          '    No files were found! The games folders have no valid files or are not selected.');
       ResetVars;
       Exit;
     end;
  //ShowMessage(FilesList.Text);

  // only load /delete current games list if there are games to add into the list!!!
  FormStatus.MessageStr('Processing files and creating the games list.');
  case MenuCreateCustomGamesList.Tag of
    1: // Tag = 1 - > Create New List
      begin
        if FileExists(SystemFileName) then
           DeleteFile(SystemFileName);
      end;
    0: GetActualGamesList; // Tag = 0 -> Add New Games To Existing List... lists game filenames only
  end;
  CheckSevenZip(idMAME); // make sure that 7z.dll is found
  CompleteGamesList:= THashedStringList.Create;
  if (MenuCreateCustomGamesList.Tag = 0) and FileExists(SystemFileName) then
     CompleteGamesList.LoadFromFile(SystemFileName);
  CompleteGamesList.BeginUpdate;
  //FormStatus.ProgressBar.Max:= FilesList.Count-1;
  FormStatus.SetProgressPos(0);
  Application.ProcessMessages;
  ListCustomGameName:= THashedStringList.Create;
  ListCustomGameSize:= THashedStringList.Create;
  for Loop:=0 to FilesListCustom.Count-1 do
  begin
   FormStatus.UpdateProgressBar(Loop, FilesListCustom.Count-1);
   ClearMemGameInfo(TempGameVars);
   TempGameVars.eMediaType:= StrToInt(FilesListCustom[Loop][1]); // first char is always the media type
   TempGameVars.eIsUnicode:= Boolean(StrToInt(FilesListCustom[Loop][2])); // second char is always the unicode tag: 0 -> no; 1 -> yes
   TempGameVars.eCustomSystemID:= SystemID;
   TempGameVars.eCustomMediaType:= TempGameVars.eMediaType;

   if TempGameVars.eIsUnicode then
      begin
        FileFullPath:= FilesListCustom.Names[Loop];
        Delete(FileFullPath, 1, 2);
        TempGameVars.eName:= ExtractFileName(FileFullPath);
        // need to double-check the FileFullPath var... make it WideString ??? How this work ????
        FileFullPath:= StringReplace(FileFullPath, TempGameVars.eName, FilesListCustom.ValueFromIndex[Loop], [rfIgnoreCase]);

        //NameDOS:= FilesList.ValueFromIndex[Loop];
        //FileFullPath:= FilesList.Names[Loop];
        //MemGameVariables.eGameFileName:= ExtractFileName(FileFullPath);
        //NameDOS:= StringReplace(FileFullPath, MemGameVariables.eGameFileName, NameDOS);
      end
   else
      begin
        FileFullPath:= FilesListCustom[Loop];
        Delete(FileFullPath, 1, 2);
        TempGameVars.eName:= ExtractFileName(FileFullPath);
      end;
   FileExtension:= ExtractFileExtW(TempGameVars.eName);

     //MemGameVariables.eTitle:= ChangeFileExt(MemGameVariables.eGameFileName, '');
   TempGameVars.eGameSize:= 0;

   if IsZipFile(FileFullPath) then // this is from EmuCon
      begin
        if SameText(FileExtension, '.zip') then
           AddGame:= GetContentsCustom(FileFullPath, True)
        else
           begin
             AddGame:= UseSevenZip;
             if AddGame then
                AddGame:= GetSevenZipContentsCustom(FileFullPath, True); // for .7z
           end;
        if AddGame then
           begin
             //MemGameVariables.eSystemID:= SystemID;
             //MemGameVariables.eGameFileName:= ExtractFileName(FileFullPath);
             //MemGameVariables.eTitle:= ChangeFileExt(MemGameVariables.eGameFileName, '');
             TempGameVars.eGameSize:= 0;
             for CounterGame:=0 to ListCustomGameName.Count-1 do
             begin
               if CheckNonGameFiles(ListCustomGameName[CounterGame]) then
                  TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(ListCustomGameSize[CounterGame]);
             end;
           end;
      end
   else
      begin
        AddGame:= CheckNonGameFiles(FilesListCustom[Loop]);
        if AddGame then
           begin
             //MemGameVariables.eSystemID:= SystemID;
             TempGameVars.eGameSize:= GetFileSizeW(FileFullPath);
             //MemGameVariables.eGameFileName:= ExtractFileName(FileFullPath);
             //else
             //   MemGameVariables.eTitle:= ChangeFileExt(MemGameVariables.eGameFileName, '');
           end;
      end;

   if MenuCreateCustomGamesList.Tag = 0 then
      begin
        if (Assigned(ExistingGames)) and (ExistingGames.Count > 0) and (AddGame) then
           AddGame:= (ExistingGames.IndexOf(TempGameVars.eName) = -1);
      end;

   if AddGame then
      CompleteGamesList.Add(PopulateROMLineCustom);
  end;

  if CompleteGamesList.Count > 0 then
     begin
       CompleteGamesList.SaveToFile(SystemFileName);
       Result:= True; // new games were added to the games list
     end;
  ResetVars;
  SelectedEasyItem:= nil;
  //LoadGames(True);

  //ResetVars;
  {case IsMultiSys of
    True:
      begin
        for Loop:=Low(CreateSys) to High(CreateSys) do
            InitImgZipSystem(Loop);
      end;
    False: InitImgZipSystem(sysID)
  end;}
  if not IsMultiList then
     begin
       ClearMemGameInfo(TempGameVars);
       FormMain.ClearScreenshots;
       //LoadGames(True);
       FormStatus.Close;
     end;
end;

