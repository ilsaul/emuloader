function TFormMain.ELV_FindItemBySystemID(ELV_Destination: TEasyListView; sysID: Integer; IsCustomGame: Boolean; SearchDisabledItems: Boolean): TEasyItem;
var
  Item: TEasyItem;
  iFound: Boolean;
begin
  Result:= nil;
  iFound:= False;
  // Item.StateImageIndex = -1; // -1 -> Arcade; 1..MaxConsoleComputerSystems -> Console/Computer (EmuCon)
  // Item.ImageIndex = arcade system IDs
  if SearchDisabledItems then
     Item:= ELV_Destination.Groups.FirstItem
  else
     Item:= ELV_Destination.Groups.FirstVisibleItem;

  if Item = nil then
     Exit; // list empty or all items are invisible ?
  repeat
    if Item <> nil then
    begin
      if IsCustomGame then
         begin
           if Item.StateImageIndex = sysID then
              begin
                iFound:= True;
                Result:= Item;
              end;
         end
      else
         begin
           if Item.ImageIndex = sysID then
              begin
                iFound:= True;
                Result:= Item;
              end;
         end;
      end;
    if SearchDisabledItems then
       Item:= ELV_Destination.Groups.NextItem(Item)
    else
       Item:= ELV_Destination.Groups.NextVisibleItem(Item);
  until iFound or (Item = nil);
  if Result = nil then
     Result:= ELV_Destination.Groups.FirstItem;
end;

function TFormMain.ELV_FindSelectedSystemMulti(ELV_Destination: TEasyListView; Item_Source: TEasyItem; SearchDisabledItems: Boolean = True): Boolean;
var
  eID: Integer;
begin
  eID:= -1;
  if CheckSelected(GamesListView) then
     begin
       if TEasyGameInfo(Item_Source).eIsCustomGame then
          eID:= ELV_FindItemBySystemID(ELV_Destination, TEasyGameInfo(Item_Source).eCustomSystemID, True, SearchDisabledItems).Index
       else
          eID:= ELV_FindItemBySystemID(ELV_Destination, TEasyGameInfo(Item_Source).eSystemID, False, SearchDisabledItems).Index;
     end;

  Result:= eID <> -1;
  if Result then
     ELV_SelectItem(ELV_Destination, eID);
end;

procedure TFormMain.ELV_SetSelectRibbon(State: ShortInt; EasyListViewHolder: TEasyListView; ForceUpdate: Boolean = False);
begin
  // state:
  //   0 -> game OK
  //   1 -> missing ROMs/CHDs
  //   2 -> missing (no ROMs found)
  if State = 2 then
     State:= 0; // reset since the selection ribbon for missing games is the same as "game OK"
  if (State = EasyListViewHolder.HelpContext) and (not ForceUpdate) then
     Exit;

  EasyListViewHolder.HelpContext:= State;
  EasyListViewHolder.Selection.Color:= ListSelectionColors[0, State]; // single color selection
  EasyListViewHolder.Selection.GradientColorTop:= ListSelectionColors[1, State]; // gradient top
  EasyListViewHolder.Selection.GradientColorBottom:= ListSelectionColors[2, State]; // gradient bottom
  EasyListViewHolder.Selection.BorderColor:= ListSelectionColors[3, State];
  EasyListViewHolder.Selection.BlendColorSelRect:= EasyListViewHolder.Selection.BorderColor;
  EasyListViewHolder.Selection.BorderColorSelRect:= EasyListViewHolder.Selection.BorderColor;
  //EasyListViewHolder.Selection.TextColor:= clBlack; // this doesn't work... call ELV_ItemPaintText_General() function instead

  EasyListViewHolder.Selection.InactiveColor:= ListSelectionColorInactive[0, State];
  EasyListViewHolder.Selection.InactiveBorderColor:= ListSelectionColorInactive[2, State];
  EasyListViewHolder.Selection.InactiveTextColor:= ListSelectionColorInactive[3, State]; // this doesn't work... call ELV_ItemPaintText_General() function instead
end;

procedure TFormMain.ELV_ResetNormalColors(ELV_Holder: TEasyListView; UpdateSelection: Boolean = True);
begin
  FormMain.ELV_SetSelectRibbon(0, ELV_Holder, True);
  if not UpdateSelection then
     Exit;
  if ELV_Holder <> GamesListView then
     begin
       if not (ELV_Holder.Parent is TPanelEx) then
          begin
           ELV_Holder.Selection.AlphaBlend:= GamesListView.Selection.AlphaBlend;
           ELV_Holder.Selection.RoundRect:= GamesListView.Selection.RoundRect;
          end;
     end;
end;

procedure TFormMain.ELV_SetBackgroundColor(ELV_Holder: TEasyListView; ShowBkImage: Boolean = False);
begin
  if ELV_Holder.Color <> GamesListView.Color then
     ELV_Holder.Color:= GamesListView.Color;
  if not ShowBkImage then
     Exit;
  ELV_Holder.BackGround.Enabled:= GamesListView.BackGround.Enabled;
  if ELV_Holder.BackGround.Enabled then
     begin
       if GamesListView.BackGround.Image <> nil then
          ELV_Holder.BackGround.Image.Assign(GamesListView.BackGround.Image);
     end;
end;

