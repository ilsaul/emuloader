function TFormMain.IsNeoGeoDriver(sysID: ShortInt; const GameDriverName, GameBiosName: String; RemoveExtension: Boolean = False): Boolean;
//function TFormMain.IsNeoGeoDriver(const GameDriverName: String; RemoveExtension: Boolean = False): Boolean;
var
  iDriverStr: String;
begin
  if RemoveExtension then
     iDriverStr:= ChangeFileExt(GameDriverName, '')
  else
     iDriverStr:= GameDriverName;
  Result:= (iDriverStr = 'neogeo') or (iDriverStr = 'neodrvr') or (iDriverStr = 'neogeo_noslot');
  if not Result then
     begin
       // for all those HBMAME hacks. Neo-Geo has lots of different source names
       if sysID = idHBMAME then
          Result:= SameText(GameBiosName, 'neogeo');
     end;
end;

function TFormMain.FilterGamesList(const FilterName: String): Boolean;
var
  DeleteGame: Boolean;
  iDriverName: String;

  function ValidateDriver(const DriverNameStr: String): Boolean;
  begin
    Result:= iDriverName <> DriverNameStr;
  end;

  function CheckDriverFilter: Boolean;
  begin
    DeleteGame:= iDriverName <> FilterName;
    Result:= DeleteGame;
  end;

  function CheckBiosFilter(const FilterName: String): Boolean;
  begin
    DeleteGame:= MemGameInfo.eBiosName <> FilterName;
    Result:= DeleteGame;
  end;

begin
  DeleteGame:= False;
  iDriverName:= ChangeFileExt(MemGameInfo.eDriverName, ''); // remove the file extension since MAME is using different ones now, not only ".c" (November 11, 2013)

  if FilterName = 'neogeo' then // Neo Geo
     DeleteGame:= not IsNeoGeoDriver(MemGameInfo.eSystemID, iDriverName, MemGameInfo.eBiosName)
     //DeleteGame:= ValidateDriver('neogeo') and // old driver name
     //             ValidateDriver('neodrvr')  and // new driver name
     //             ValidateDriver('neogeo_noslot') // new driver MAME 0.154 (July 23, 2014)
  else
  if FilterName = 'vector' then
     DeleteGame:= (MemGameInfo.eScreenType <> 1) or
                  (MemGameInfo.eSystemID <> idMAME) // Vector
  else
  if FilterName = 'chd' then
     DeleteGame:= (MemGameInfo.eMediaType = 0) //or (MemGameInfo.eSystemID = idDaphne) // Compressed Hunks of Data (CHD)
  else
  if FilterName = 'pgm' then
     //CheckDriverFilter
     begin
       DeleteGame:= ValidateDriver('pgm') and // Polygame Master System (PGM)
                    ValidateDriver('pgm2');   // Polygame Master System 2 (PGM 2)
     end
  else
  if FilterName = 'arcadia' then
     CheckDriverFilter // Arcadia System
  else
  if FilterName = 'decocass' then
     CheckDriverFilter // DECO Cassette System
  else
  if FilterName = 'simpl156' then
     CheckDriverFilter // Data East Simple 156
  else
  if FilterName = 'vegas' then
     CheckDriverFilter // Atari / Midway Vegas
  else
  if FilterName = 'irem' then
     begin
       //Irem Old School
       DeleteGame:= ValidateDriver('mpatrol') and // Moon Patrol
                    ValidateDriver('m52') and // Irem "M52" system (Moon Patrol, MAME 0.122u8)
                    ValidateDriver('m62') and // Irem "M62" system
                    ValidateDriver('m72') and // Irem "M72" system
                    ValidateDriver('m90') and // Irem M90/M97 system
                    ValidateDriver('m92') and // Irem "M92" system
                    ValidateDriver('m107') and // Irem "M107" system
                    ValidateDriver('vigilant'); // Vigilante hardware
     end
  else
  if FilterName = 'ssv' then
     CheckDriverFilter // Seta, Sammy, Visco System (SSV)
  else
  if FilterName = 'midway' then
     begin
       // Midway (T, V, Wolf, X, Y, Z, Zeus) System
       DeleteGame:= ValidateDriver('midtunit') and // Midway T-unit system
                    ValidateDriver('midvunit') and // Midway V-unit system
                    ValidateDriver('midwunit') and // Midway Wolf-unit system
                    ValidateDriver('midxunit') and // Midway X-unit system
                    ValidateDriver('midyunit') and // Williams/Midway Y/Z-unit system
                    ValidateDriver('midzeus'); // Midway Zeus system
     end
  else
  if FilterName = 'seattle' then
     CheckDriverFilter // Atari/Midway Phoenix/Seattle/Flagstaff hardware
  else
  if FilterName = 'triforce' then
     CheckDriverFilter // Triforce system (GameCube based arcade system)
  else
  if FilterName = 'capcom' then
     begin
       // all capcom sub-filters
       DeleteGame:= ValidateDriver('cps1') and
                    ValidateDriver('cps1mis') and // for HBMAME CPS-1 hacks
                    ValidateDriver('cps2') and
                    ValidateDriver('cps3') and
                    CheckBiosFilter('cpzn1') and
                    CheckBiosFilter('cpzn2') and
                    ValidateDriver('gng') and
                    ValidateDriver('gunsmoke') and
                    ValidateDriver('higemaru') and
                    ValidateDriver('sonson') and
                    ValidateDriver('commando') and
                    ValidateDriver('tigeroad');
     end
  else
  if FilterName = 'cps1' then
     begin
       DeleteGame:= ValidateDriver('cps1') and // Capcom Play System 1 (CPS-1)
                    ValidateDriver('cps1mis'); // for HBMAME CPS-1 hacks
     //CheckDriverFilter; // Capcom Play System 1 (CPS-1)
     end
  else
  if FilterName = 'cps2' then
     CheckDriverFilter // Capcom Play System 2 (CPS-2)
  else
  if FilterName = 'cps3' then
     CheckDriverFilter // Capcom Play System 3 (CPS-3)
  else
  if FilterName = 'cpzn1' then
     CheckBiosFilter('cpzn1') // Capcom ZN-1
  else
  if FilterName = 'cpzn2' then
     CheckBiosFilter('cpzn2') // Capcom ZN-2
  else
  if FilterName = 'capcom_oldschool' then
     begin
       // Capcom (Old School)
       DeleteGame:= ValidateDriver('gng') and // Ghosts'n Goblins hardware
                    ValidateDriver('gunsmoke') and // Gun Smoke hardware
                    ValidateDriver('higemaru') and // Higemary hardware
                    ValidateDriver('sonson') and // Sonson hardware
                    ValidateDriver('commando') and // Commando hardware
                    ValidateDriver('tigeroad'); // Tiger Road hardware (68000 based hardware)
     end
  else
  if FilterName = 'sega' then
     begin
       // all Sega sub-filters
       DeleteGame:= ValidateDriver('system1') and
                    ValidateDriver('system16') and
                    ValidateDriver('segahang') and
                    ValidateDriver('segaorun') and
                    ValidateDriver('segas16a') and
                    ValidateDriver('segas16b') and
                    ValidateDriver('system18') and
                    ValidateDriver('segas18') and
                    ValidateDriver('system24') and
                    ValidateDriver('segas24') and
                    ValidateDriver('system32') and
                    ValidateDriver('segas32') and
                    ValidateDriver('stv') and
                    ValidateDriver('segaxbd') and
                    ValidateDriver('segaybd') and
                    ValidateDriver('segac2') and
                    ValidateDriver('megatech') and
                    ValidateDriver('megaplay') and
                    ValidateDriver('model1') and
                    ValidateDriver('model2') and
                    ValidateDriver('model3') and
                    ValidateDriver('naomi') and
                    CheckBiosFilter('naomigd') and // Naomi GD-ROM
                    CheckBiosFilter('naomi2') and // Naomi 2
                    CheckBiosFilter('naomi2gd') and // Naomi 2 GD-ROM
                    CheckBiosFilter('awbios'); // Atomiswave
     end
  else
  if FilterName = 'system1' then
     CheckDriverFilter // Sega System 1 / System 2
  else
  if FilterName = 'system16' then
     begin
       // Sega System 16
       DeleteGame:= ValidateDriver('system16') and // Sega System 16 hardware
                    ValidateDriver('segahang') and // Sega Hang-On hardware
                    ValidateDriver('segaorun') and // Sega Out Run hardware
                    ValidateDriver('segas16a') and // Sega pre-System 16 & System 16A hardware
                    ValidateDriver('segas16b'); // Sega System 16B hardware
     end
  else
  if FilterName = 'system18' then
     begin
       // Sega System 18
       DeleteGame:= ValidateDriver('system18') and
                    ValidateDriver('segas18');
     end
  else
  if FilterName = 'system24' then
     begin
       // Sega System 24
       DeleteGame:= ValidateDriver('system24') and
                    ValidateDriver('segas24');
     end
  else
  if FilterName = 'system32' then
     begin
       // Sega System 32 / Multi 32 hardware
       DeleteGame:= ValidateDriver('system32') and
                    ValidateDriver('segas32');
     end
  else
  if FilterName = 'stv' then
     CheckDriverFilter // Sega Titan Vidoe (ST-V)
  else
  if FilterName = 'segaxybd' then
     begin
       DeleteGame:= ValidateDriver('segaxbd') and // Sega X-board hardware
                    ValidateDriver('segaybd'); // Sega Y-board hardware
     end
  else
  if FilterName = 'segac2' then
     CheckDriverFilter // Sega System C/C2 Driver
  else
  //if FilterName = 'megatech_megaplay' then
  //   begin
  //     DeleteGame:= ValidateDriver('megatech') and // Sega MegaTech
  //                  ValidateDriver('megaplay'); // Sega MegaPlay
  //   end
  if FilterName = 'megatech' then
     CheckDriverFilter // Sega Mega-Tech System
  else
  if FilterName = 'megaplay' then
     CheckDriverFilter // Sega Mega Play
  else
  if FilterName = 'model1' then
     CheckDriverFilter // Sega Model 1
