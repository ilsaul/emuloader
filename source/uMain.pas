function TFormMain.GetGamesList(HolderStrings: THashedStringList; const sysID: Integer; SystemType: ShortInt = 0; SoftwareList: String = ''): Boolean;
var
  TempFile, TempFileStatus: THashedStringList;
  FileName, FileNameStatus, SoftwareTitle, sGameName, StatusStr: String;
  Loop, iPos: Integer;
  tmpString: String;
begin
  FileName:= GetSystemFileName(sysID, 0, SoftwareList);
  FileNameStatus:= GetSystemFileName(sysID, 2, SoftwareList);
  HolderStrings.BeginUpdate;
  Result:= FileExistsW(GetGamesFolderEL(SystemType, sysID)+FileName) and FileExistsW(GetGamesFolderEL(SystemType, sysID)+FileNameStatus);
  if Result then
     begin
       TempFile:= THashedStringList.Create;
       TempFile.LoadFromFile(GetGamesFolderEL(SystemType, sysID)+FileName);
       TempFileStatus:= THashedStringList.Create;
       TempFileStatus.LoadFromFile(GetGamesFolderEL(SystemType, sysID)+FileNameStatus);
       if TempFile.Count > 0 then
          begin
            TempFile.BeginUpdate;
            if TempFile[0] = '[info_file]' then
               begin
                 if SoftwareList <> '' then
                    SoftwareTitle:= TempFile.ValueFromIndex[1];
                 TempFile.Delete(3);
                 TempFile.Delete(2);
                 TempFile.Delete(1);
                 TempFile.Delete(0);
               end;
            for Loop:=TempFile.Count-1 downto 0 do
            begin
              tmpString:= TempFile[Loop];
              if (tmpString = '') or (tmpString[1] = '[') then
                 TempFile.Delete(Loop)
              else
              begin
                sGameName:= TempFile.Names[Loop];
                StatusStr:= TempFileStatus.Values[sGameName];
                
                iPos:= PosEx('=', tmpString);
                Insert(StatusStr, tmpString, iPos+1);
                TempFile[Loop]:= tmpString;
                if SoftwareList <> '' then
                   TempFile[Loop]:= TempFile[Loop]+'<softfile>'+SoftwareList+'/><softtitle>'+SoftwareTitle+'/>';
              end;
            end;
            TempFile.EndUpdate;
            if TempFile.Count > 0 then
               begin
                 HolderStrings.AddStrings(TempFile);
               end;
          end;
       FreeAndNil(TempFile);
       FreeAndNil(TempFileStatus);
     end;
  HolderStrings.EndUpdate;
end;

function TFormMain.GetGamesListCustom(HolderStrings: THashedStringList; const sysID: Integer; SoftwareList: String = ''): Boolean;
var
  TempFile: THashedStringList;
  FileName: String;
  Loop: Integer;
  tmpString: String;
begin
  FileName:= SystemsListCustom[sysID, 2];

  HolderStrings.BeginUpdate;
  Result:= FileExistsW(GetGamesFolderEL(2)+FileName);
  if Result then
     begin
       TempFile:= THashedStringList.Create;
       TempFile.LoadFromFile(GetGamesFolderEL(2)+FileName);
       if TempFile.Count > 0 then
          begin
            TempFile.BeginUpdate;
            for Loop:=TempFile.Count-1 downto 0 do
            begin
              tmpString:= TempFile[Loop];
              if tmpString = '' then
                 TempFile.Delete(Loop);
            end;
            TempFile.EndUpdate;
            if TempFile.Count > 0 then
               HolderStrings.AddStrings(TempFile);
          end;
       FreeAndNil(TempFile);
     end;
  HolderStrings.EndUpdate;
end;

procedure TFormMain.InitializeEmulatorVariables;
var
  Loop, Loop2: Integer;
begin
  // define values for all arrays or exception error will occur...
  try
    for Loop:= 1 to MaxArcadeSystems do
    begin
      IniFilesDir[Loop]:= '';
      EmulatorFile[Loop]:= '';
      EmulatorVersion[Loop]:= '';
      EmulatorDateTime[Loop]:= -1;

      emuROMsFolders[Loop]:= nil;
      ArcadeVideoPreviewDir[Loop]:= '';
    end;
    buildMAME:= '';
    buildHBMAME:= '';

    for Loop:= Low(AlterMAMEFile) to High(AlterMAMEFile) do
    begin
      AlterMAMEFile[Loop]:= '';
      AlterMAMEVersion[Loop]:= '';

      buildAlterMAME[Loop]:= '';
      AlterMAMEDateTime[Loop]:= -1;
      AlterMAME_IsMAME[Loop]:= False;
    end;

    for Loop:=1 to MaxArcadeSystems do // remove me later when imgFolderArcade TStringList array implementantion is finished
    begin
      for Loop2:=0 to High(imgFolder[1]) do
          imgFolder[Loop, Loop2]:= '';
    end;

    for Loop:=Low(ImageScr) to High(ImageScr) do
        ImageScr[Loop]:= nil;
    ImagePnl:= nil;

    for Loop:=Low(SplitterImg) to High(SplitterImg) do
        SplitterImg[Loop]:= nil;

    for Loop:=Low(ImageLayoutVisible) to High(ImageLayoutVisible) do
        ImageLayoutVisible[Loop]:= True;
        
    for Loop:=Low(ImageDetails) to High(ImageDetails) do
    begin
      ImageDetails[Loop].SystemID:= -1;
      //ImageDetails[Loop].SystemType:= 0; // always reset to arcade
      if Loop <> Low(ImageDetails) then
         begin
           ImageDetails[Loop].ImageCategoryIndex:= -1; // variable index (either "all systems" or "custom index for console/computer")
           ImageDetails[Loop].ImageCategoryIndex_AllSystems:= -1;
           ImageDetails[Loop].ImageCategoryIndex_ConsComp:= -1;
         end
      else
         begin
           // set to in-game snap by default, needed for a clean install (April 30, 2018)
           ImageDetails[Loop].ImageCategoryIndex:= 0;
           ImageDetails[Loop].ImageCategoryIndex_AllSystems:= 0;
           ImageDetails[Loop].ImageCategoryIndex_ConsComp:= 0;
         end;
         
      ImageDetails[Loop].NoImageLoaded:= False;
      ImageDetails[Loop].PrevNoImageLoaded:= False;
      ImageDetails[Loop].IsZipped:= False;
      ImageDetails[Loop].NewImageLoaded:= False;
      ImageDetails[Loop].ImageType:= '';
    end;

    for Loop:=Low(ImageCategoryArray) to High(ImageCategoryArray) do
    begin
      ImageCategorySettings[Loop].BackgroundColor:= clBlack;
      ImageCategorySettings[Loop].Visible:= True;
    end;

    for Loop:=Low(UnZipActive) to High(UnZipActive) do
        UnZipActive[Loop]:= False;
    MAMu_Folder:= '';
    for Loop:=Low(FilterSysArcade) to High(FilterSysArcade) do
        FilterSysArcade[Loop]:= True;

    for Loop:=Low(FilterSysConsComp) to High(FilterSysConsComp) do
        FilterSysConsComp[Loop]:= True;

    for Loop:=Low(FilterSysArcadeQuick) to High(FilterSysArcadeQuick) do
        FilterSysArcadeQuick[Loop]:= False;

    for Loop:=Low(FilterSysConsCompQuick) to High(FilterSysConsCompQuick) do
        FilterSysConsCompQuick[Loop]:= False;

    FilterMachineType.ArcadeSystems_Enabled:= True;
    FilterMachineType.ConsoleSystems_Enabled:= True;
    FilterMachineType.ComputerSystems_Enabled:= True;
    FilterMachineType.HandheldSystems_Enabled:= True;
    FilterMachineType.MAMEMachinesWithSoftwareList_Enabled:= True;
    FilterMachineType.MAMEMachinesWithoutSoftwareList_Enabled:= True;
    FilterMachineType.MAMESoftwareListGames_Enabled:= True;
    FilterMachineType.MAMEMachinesFilterPanel_Enabled:= False;
  except
    GenerateMessage('Startup', 'Failed to initialize emulator variables.',
                    '    One or more memory variables could not be initialized '+
                    '(uMain.InitializeEmulatorVariables).', 2, False, 1);
  end;
end;


procedure TFormMain.DeInitEmulatorVariables;
var
  Loop, Loop2: Integer;
begin
  for Loop:=1 to MaxArcadeSystems do
      FreeAndNil(emuROMsFolders[Loop]); // arcade ROMs folders

  // mulitple image paths; basically, for MAME/HMAME (ui.ini)
  // future improvement, multiple images paths (July 29, 2018)

  for Loop:=Low(imgFolderMAME) to High(imgFolderMAME) do
  begin
    for Loop2:=Low(ImageCategoryArray) to High(ImageCategoryArray) do
        FreeAndNil(imgFolderMAME[Loop, Loop2]);
