function TFormMain.CallSelectFilterSystem: Boolean;
var
  Item: TEasyItem;
  StrResult: String;
  Loop: Integer;
begin
  // FeatureType = 7
  // SelectSysID = does not apply as the FilterSys[] array will be used
  // ButtonGameFilterArcade.Tag
  //     0 -> all systems are selected in the fiter
  //     1..MaxArcadeSystems -> single system is selected
  //     idMultiSys (500) -> multiple systems are selected... check FilterSys[] var
  //Result:= False; // user clicked cancel button (default result) ... not needed here

  if not Assigned(FormSelectSystem) then
     FormSelectSystem:= TFormSelectSystem.Create(nil);
  FormSelectSystem.ActionMode:= 7;//FeatureType;
  FormSelectSystem.selSysID:= 0;//SelectSysID;
  FormSelectSystem.Position:= poDesigned;
  FormSelectSystem.BorderIcons:= [];
  FormSelectSystem.BorderStyle:= bsToolWindow;
  FormSelectSystem.Left:= FormMain.Left+ButtonGameFilterArcade.Left+10;
  FormSelectSystem.Top:= FormMain.Top+28+10+ToolBarButtons.ButtonHeight+1;
  FormSelectSystem.Height:= FormSelectSystem.Height-4;

  Result:= FormSelectSystem.ShowModal = mrOk;
  if not Result then
     begin
       FreeAndNil(FormSelectSystem);
       Exit;
     end;

  Item:= FormSelectSystem.SystemsListView.Selection.First;
  if Item.ImageIndex = 0 then
     begin
       // all systems option is selected, ignore everything else
       for Loop:=Low(FilterSys) to High(FilterSys) do
           FilterSys[Loop]:= True; // set all to true (just in case...)
       ButtonGameFilterArcade.Tag:= 0; // all systems
     end
  else
     begin
       for Loop:=Low(FilterSys) to High(FilterSys) do
           FilterSys[Loop]:= False; // set all to false first
       if FormSelectSystem.SystemsListView.Selection.Count = 1 then
          begin
            FilterSys[Item.ImageIndex]:= True;
            ButtonGameFilterArcade.Tag:= Item.ImageIndex; // single system selected
          end
       else
          begin
            // this is where the fun begins...
            ButtonGameFilterArcade.Tag:= idMultiSys; //500; // multiple systems selected
            repeat
              FilterSys[Item.ImageIndex]:= True;
              Item:= FormSelectSystem.SystemsListView.Selection.Next(Item);
            until Item = nil;
          end;
     end;
  FreeAndNil(FormSelectSystem);
end;
}

function TFormMain.CallSelectFilterSystem: Boolean;
var
  Item: TEasyItem;
  Loop: Integer;
  CurrentFilterID: Integer;
  FilterChanged: Boolean;

  procedure FreeSelScreen; // cannot create a function inside of a main function!!!
  begin
    FreeAndNil(FormSelectFilterSystem);
    FocusGamesList;
  end;

begin
  CurrentFilterID:= ButtonGameFilterArcadeSystems.Tag;
  if not Assigned(FormSelectFilterSystem) then
     FormSelectFilterSystem:= TFormSelectFilterSystem.Create(nil);

  FormSelectFilterSystem.Left:= FormMain.Left+ButtonGameFilterArcadeSystems.Left+10;
  FormSelectFilterSystem.Top:= FormMain.Top+28+10+ToolBarButtons.ButtonHeight+1;

  Result:= FormSelectFilterSystem.ShowModal = mrOk;
  if not Result then
     begin
       FreeSelScreen;
       Exit;
     end;

  Item:= FormSelectFilterSystem.SystemsListView.Selection.First;
  if Item.ImageIndex = 0 then
     begin
       // all systems option is selected, ignore everything else
       Result:= CurrentFilterID <> 0;
       if not Result then
          begin
            // nothing to do as the new selected filter is the same as the current filter
            FreeSelScreen;
            Exit;
          end;
       for Loop:=Low(FilterSys) to High(FilterSys) do
           FilterSys[Loop]:= True; // set all to true (just in case...)
       ButtonGameFilterArcadeSystems.Tag:= 0; // all systems
     end
  else
     begin
       // must check the new selections against current selections.
       // if is the same, no need to apply filters
       if FormSelectFilterSystem.SystemsListView.Selection.Count = 1 then
          begin
            // is single selection
            Result:= Item.ImageIndex <> CurrentFilterID;
            if not Result then
               begin
                 // nothing to do as the new selected filter is the same as the current filter
                 FreeSelScreen;
                 Exit;
               end;
            for Loop:=Low(FilterSys) to High(FilterSys) do
                FilterSys[Loop]:= False; // set all to false first
            FilterSys[Item.ImageIndex]:= True;
            ButtonGameFilterArcadeSystems.Tag:= Item.ImageIndex; // single system selected
          end
       else
          begin
            // validate multiple selections
            FilterChanged:= False;
            Item:= FormSelectFilterSystem.SystemsListView.Groups.FirstItem;
            repeat
              if Item.Selected <> Filtersys[Item.ImageIndex] then
                 FilterChanged:= True;
              FilterSys[Item.ImageIndex]:= Item.Selected;
              Item:= FormSelectFilterSystem.SystemsListView.Groups.NextItem(Item);
            until Item = nil;
            Result:= FilterChanged;
            if Result then
               ButtonGameFilterArcadeSystems.Tag:= idMultiSys //500; // multiple systems selected
            else
               begin
                 // nothing to do as the new selected filters are the same as the current filters
                 FreeSelScreen;
                 Exit;
               end;
          end;
     end;
  SetMainToolBarIcon(ButtonGameFilterArcadeSystems);
  FreeSelScreen;
end;

function TFormMain.CallSelectSystem(FeatureType: ShortInt = -1; SelectSysID: ShortInt = 1): Integer;
var
  Item: TEasyItem;
  StrResult: String;
begin
  Result:= -1; // "cancel" is the default result
  // 0 -> all systems
  // 1..MaxArcadeSystems -> valid EL systems

  if not Assigned(FormSelectSystem) then
     FormSelectSystem:= TFormSelectSystem.Create(nil);
  FormSelectSystem.ActionMode:= FeatureType;
  FormSelectSystem.selSysID:= SelectSysID;

  // PopupScanGames.HelpContext will hold last fixed MAME Scan Sets mode so it can be restored later...
  if FeatureType in [1, 4, 5] then // create games list, scan games feature
     PopupScanGames.HelpContext:= MenuCreateSoftwareListGames.HelpContext;
  if FormSelectSystem.ShowModal = mrOk then
     begin
       if FormSelectSystem.CreateSoftwareListGames.Visible then
          MenuCreateSoftwareListGames.Tag:= Ord(FormSelectSystem.CreateSoftwareListGames.Checked);

       if FormSelectSystem.ScanMAMESetsBox.Visible then
          MenuCreateSoftwareListGames.HelpContext:= FormSelectSystem.ScanMAMESetsBox.Tag;

       if FormSelectSystem.AddMAMEDeviceSetWithNoROMs.Visible then
          MenuAddMAMEDeviceSetsWithNoROMs.Tag:= Ord(FormSelectSystem.AddMAMEDeviceSetWithNoROMs.Checked);

       case FormSelectSystem.SystemsListView.Selection.MultiSelect of
         True:
           begin
             if FeatureType in [1, 4, 5] then
                begin
                  // create games list, scan games feature
                  // .HelpContext will hold last fixed scan mode so it can be restored later...
                  PopupSelectScanGamesMode.HelpContext:= -1;
                  if FormSelectSystem.ScanModeCurrentTaskOnly.Checked then
                     PopupSelectScanGamesMode.HelpContext:= PopupSelectScanGamesMode.Tag
                  else
                     PopupScanGames.HelpContext:= -1; // avoid tag from being changed since "For This Task Only" is selected (for create games list feature)

                  if FormSelectSystem.FullScan.Checked then
                     PopupSelectScanGamesMode.Tag:= 0
                  else
                  if FormSelectSystem.QuickScan.Checked then
                     PopupSelectScanGamesMode.Tag:= 1
                  else
                  if FormSelectSystem.ForceAllAvailable.Checked then
                     PopupSelectScanGamesMode.Tag:= 2;
                end;
             Item:= FormSelectSystem.SystemsListView.Selection.First;
             if Item.ImageIndex > 0 then
                begin
                  if FormSelectSystem.SystemsListView.Selection.Count = 1 then
                     Result:= Item.ImageIndex
                  else
                     begin
                       StrResult:= '';
                       repeat
                         if not Item.Ghosted then // (esosGhosted in Item.State) then // check if system is NOT disabled!!!
                            StrResult:= StrResult+IntToStr(Item.ImageIndex);
                         Item:= FormSelectSystem.SystemsListView.Selection.Next(Item);
                       until Item = nil;
                       Result:= StrToInt(StrResult);
                     end;
                end
             else
                begin
                  // option "all systems" were selected... get all available systems!
                  StrResult:= '';
                  Item:= FormSelectSystem.SystemsListView.Groups.NextItem(Item);
                  repeat
                    if not Item.Ghosted then // (esosGhosted in Item.State) then // check if system is NOT disabled!!!
                       StrResult:= StrResult+IntToStr(Item.ImageIndex);
                    Item:= FormSelectSystem.SystemsListView.Groups.NextItem(Item);
                  until Item = nil;
                  Result:= StrToInt(StrResult);
                  //ShowMessage(StrResult);
                end;
           end;
         False:
           begin
             Result:= FormSelectSystem.SystemsListView.Selection.First.ImageIndex; // single selection
           end;
       end;
     end;
