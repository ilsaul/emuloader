function TFormMain.GetArcadeEmulatorDescription(SystemID: Byte; GetCustomMAMETitle: Boolean = False; MAMEFileCustom: String = ''): String;
var
  sFile: String;
begin
  Result:= '';
  case SystemID of
    0: Result:= GetArcadeSystemIniSection(SystemID); // Result:= 'All Systems';
    idMAME:
      begin
        if GetCustomMAMETitle then
           begin
             if MAMEFileCustom = '' then
                sFile:= EmulatorFile[idMAME]
             else
                sFile:= MAMEFileCustom;
             if sFile <> '' then
                begin
                  sFile:= LowerCase(sFile);
                  if PosEx('ume', sFile) <> 0 then
                     Result:= 'UME: Universal Machine Emulator';
                end;
           end;
        if Result = '' then
           Result:= 'MAME';
      end;
    idSupermodel: Result:= 'Supermodel: A Sega Model 3 Arcade Emulator';
    idDaphne    : Result:= 'Daphne: Arcade Laserdisc Emulator';
    idDemul     : Result:= 'Demul: Sega Emulator';
    idHBMAME    : Result:= 'HBMAME: HomeBrew MAME';
    idDICE      : Result:= 'DICE: Discrete Integrated Circuit Emulator';
    idSegaModel2: Result:= 'SEGA Model 2 Emulator';
    idZiNc      : Result:= 'ZiNc: 3D Arcade Emulator';
  end;
end;

