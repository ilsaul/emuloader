function TFormMain.ELV_GetSystemTitle(ELV_Holder: TEasyListView; SelectedItem: TEasyItem; EmulatorTitle: TShadowLabel = nil; SystemType: TShadowLabel = nil): String;
begin
  Result:= '';
  if SelectedItem.StateImageIndex = -1 then
     begin
       if SystemType <> nil then
          SystemType.Caption:= 'ARCADE';
       Result:= GetArcadeEmulatorDescription(ELV_Holder.Tag);
