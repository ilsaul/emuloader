function TFormMain.GetLargerGameFont(FontVar: TFont; ELV_Source: TEasyListView = nil): Integer;
var
  iFontSize, iFontPixels: Integer;
begin
  Result:= -1;
  iFontSize:= GetFontHeightSize(Font_Parent);
  iFontPixels:= GetFontHeightSize(Font_Clone);
  if iFontPixels > iFontSize then
     iFontSize:= iFontPixels;
  iFontPixels:= GetFontHeightSize(Font_Preliminary);
  if iFontPixels > iFontSize then
     iFontSize:= iFontPixels;
  iFontPixels:= GetFontHeightPixels(Font_MissingROMs);
  if iFontPixels > iFontSize then
     iFontSize:= iFontPixels;
  iFontPixels:= GetFontHeightPixels(Font_MissingROMsPreliminary);
  if iFontPixels > iFontSize then
     iFontSize:= iFontPixels;

  if iFontSize <> -1 then
     Result:= iFontSize;
end;

function TFormMain.GetSmallerGameFont(EasyListView_Dest: TEasyListView = nil): Integer;
var
  iFontSize, iFontPixels: Integer;

  function UpdateELV(iFont: TFont): Boolean;
  begin
    Result:= EasyListView_Dest <> nil;
    if Result then
       EasyListView_Dest.Font:= iFont;
  end;

begin
  Result:= -1;
  UpdateELV(Font_Parent);
  iFontSize:= GetFontHeightSize(Font_Parent);
  iFontPixels:= GetFontHeightSize(Font_Clone);
  if iFontPixels < iFontSize then
     begin
       UpdateELV(Font_Clone);
       iFontSize:= iFontPixels;
     end;
  iFontPixels:= GetFontHeightSize(Font_Preliminary);
  if iFontPixels < iFontSize then
     begin
       UpdateELV(Font_Preliminary);
       iFontSize:= iFontPixels;
     end;
  iFontPixels:= GetFontHeightSize(Font_MissingROMs);
  if iFontPixels < iFontSize then
     begin
       UpdateELV(Font_MissingROMs);
       iFontSize:= iFontPixels;
     end;
  iFontPixels:= GetFontHeightSize(Font_MissingROMsPreliminary);
  if iFontPixels < iFontSize then
     begin
       UpdateELV(Font_MissingROMsPreliminary);
       iFontSize:= iFontPixels;
     end;
     
  if iFontSize <> -1 then
     Result:= iFontSize;
end;

