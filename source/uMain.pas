     Exit;
  if FileExists(ExtractFilePath(ExeFileName)+'ui.ini') then
     Result:= True;
end;

function TFormMain.ScanFoldersIcon(const IconName, SoftwareName: String; sysID: Byte; out FileFullPath: String; ZippedIcon: Boolean): Boolean;
//const
//  IconExtraFolder: String = 'icons\';
var
  FileStr, Folder: String;
begin
  // need to add software list folder here...
  case ZippedIcon of
    True:
      begin
        case sysID of
          idDICE: Folder:= 'dice\';
          idZiNc: Folder:= 'zinc\';
          idMAME:
            begin
              if SoftwareName = '' then
                 Folder:= ''
              else
                 Folder:= SoftwareName+'\';
            end;

        else
          Folder:= '';
        end;
        FileStr:= Folder+IconName+'.ico';
        Result:= MAMu_IconsList.IndexOf(FileStr) <> -1;
        if Result then
           FileFullPath:= FileStr
        else
        if sysID in [idDICE, idZiNc] then
           begin
             // will search on MAME icons (root icons.zip folder)
             FileStr:= IconName+'.ico';
             Result:= MAMu_IconsList.IndexOf(FileStr) <> -1;
             if Result then
                FileFullPath:= FileStr;
           end;
      end;
    False:
      begin
        Result:= CheckMAMu_Folder;
        if not Result then
           Exit;
        FileStr:= GetMAMu_IconFolder(sysID, False, SoftwareName)+IconName+'.ico';
        Result:= FileExists(FileStr);
        if not Result then
           begin
             FileStr:= GetMAMu_IconFolder(sysID, True, SoftwareName)+IconName+'.ico';
             Result:= FileExists(FileStr);
           end;
        if Result then
           FileFullPath:= FileStr;
      end;
  end;
end;

function TFormMain.GetMAMu_IconFileName(sysID: Byte; romID: Integer; const GameName, CloneName, DriverName, BiosName, SoftwareName: String; ZippedIcon: Boolean): String;
var
  FileFullPath: String;

  function LoadGameIcon: String;
  begin
    Result:= '';
    case GameIsClone(CloneName) of
      True:
        begin
          case PopupShowCloneIcons.Checked of
            True:
              begin
                case ScanFoldersIcon(GameName, SoftwareName, sysID, FileFullPath, ZippedIcon) of
                  True: Result:= FileFullPath;
                  False:
                    begin
                      if PopupShowParentIcons.Checked then
                         begin
                           if ScanFoldersIcon(CloneName, SoftwareName, sysID, FileFullPath, ZippedIcon) then
                              Result:= FileFullPath;
                         end;
                    end;
                end;
              end;
            False:
              begin
                if PopupShowParentIcons.Checked then
                   begin
                     if ScanFoldersIcon(CloneName, SoftwareName, sysID, FileFullPath, ZippedIcon) then
                        Result:= FileFullPath;
                   end;
              end;
          end;
        end;
      False:
        begin
          if PopupShowParentIcons.Checked then
             begin
               if ScanFoldersIcon(GameName, SoftwareName, sysID, FileFullPath, ZippedIcon) then
                  Result:= FileFullPath;
             end;
        end;
    end;
  end;

  function LoadBiosIcon: String;
  begin
    Result:= '';
    if BiosName <> '' then
       begin
         if ScanFoldersIcon(BiosName, SoftwareName, sysID, FileFullPath, ZippedIcon) then
            Result:= FileFullPath;
       end;
  end;

  function LoadDriverIcon: String;
  begin
    Result:= '';
    if DriverName <> '' then
       begin
         if ScanFoldersIcon(ChangeFileExt(DriverName, ''), SoftwareName, sysID, FileFullPath, ZippedIcon) then
            Result:= FileFullPath;
       end;
  end;

  function LoadDeviceCustomIcon: String;
  begin
    Result:= '';
    if IsROM_Device(romID) then
       begin
         if ScanFoldersIcon('deviceset', SoftwareName, sysID, FileFullPath, ZippedIcon) then
            Result:= FileFullPath;
       end;
  end;

begin
  Result:= '';
  if SoftwareName <> '' then Exit; // there will be no MAMu_ icons support for software list games!!!!
  if PopupForceGameBiosIcons.Checked then
     Result:= LoadBiosIcon;

  if (Result = '') and PopupForceGameDriverIcons.Checked then
     Result:= LoadDriverIcon;

  if Result = ''  then
     Result:= LoadGameIcon;

  if (Result = '') and PopupEnableDeviceSetCustomIcon.Checked then
     Result:= LoadDeviceCustomIcon;
     
  if (Result = '')  and PopupShowGameBiosIcons.Checked and (not PopupForceGameBiosIcons.Checked) then
     Result:= LoadBiosIcon;

  if (Result = '')  and PopupShowGameDriverIcons.Checked and (not PopupForceGameDriverIcons.Checked) then
     Result:= LoadDriverIcon;
end;

function TFormMain.LoadMAMu_Icon(const IconFile: String; var IconVar: TExIcon; var IconIndex: Integer; ZippedIcon: Boolean; IconSize: Integer = 32): Boolean;
var
  Index32Bit, Index24Bit, Index8Bit: Integer;
  Index32Bit_48x, Index24Bit_48x, Index8Bit_48x: Integer;
  Loop: Integer;

  function LoadZippedIcon: Boolean;
  begin
    with ZipForgeIcons do
    begin
      try
        // Open existing archive file
        if not Active then
           begin
             FileName:= MAMu_Folder+'icons.zip';
             OpenArchive(fmOpenRead or fmShareDenyNone);
           end;
        ExtractToStream(IconFile, MAMu_FileStream);
      except
        Result:= False;
        //CloseArchive; // cannot close icons.zip to avoid slow unzip
        FileName:= '';
        MAMu_FileStream.Clear;
        Exit;
      end;
      //CloseArchive; // cannot close icons.zip to avoid slow unzip
      FileName:= '';
    end;
    MAMu_FileStream.Position:= 0;
    IconVar.LoadFromStream(MAMu_FileStream);
    MAMu_FileStream.Clear;
  end;

begin
  Index32Bit:= -1;
  Index24Bit:= -1;
  Index8Bit:= -1;

  Index32Bit_48x:= -1;
  Index24Bit_48x:= -1;
  Index8Bit_48x:= -1;

  IconVar:= TExIcon.Create;
  case ZippedIcon of
    True: LoadZippedIcon;
    False: IconVar.LoadFromFile(IconFile);
  end;

  for Loop:=0 to IconVar.ImageCount-1 do
  begin
    case IconVar.Images[Loop].PixelFormat of
      pf32bit:
        begin
          if IconVar.Images[Loop].Width = 48 then
             Index32Bit_48x:= Loop
          else
             Index32Bit:= Loop;
        end;
      pf24bit:
        begin
          if IconVar.Images[Loop].Width = 48 then
             Index24Bit_48x:= Loop
          else
             Index24Bit:= Loop;
        end;
    else
        begin
          if IconVar.Images[Loop].Width = 48 then
             Index8Bit_48x:= Loop
          else
             Index8Bit:= Loop;
        end;
    end;
  end;
  IconIndex:= -1;
  if IconSize = 48 then
     begin
       // ImageList.Width = 48 !!!!!!!!
       IconIndex:= Index32Bit_48x;
       if IconIndex = -1 then
          IconIndex:= Index24Bit_48x;
       if IconIndex = -1 then
          IconIndex:= Index8Bit_48x;
     end;

  if IconIndex = -1 then
     IconIndex:= Index32Bit;

  if IconIndex = -1 then
     IconIndex:= Index24Bit;

  if IconIndex = -1 then
     IconIndex:= Index8Bit;

  Result:= IconIndex <> -1;
end;

// for the status screen!
// not used anymore June 25, 2015
{procedure TFormMain.PremultiplyBitmap(Bitmap: TBitmap);
var
  Row, Col: integer;
  p: PRGBQuad;
  PreMult: array[Byte, Byte] of Byte;
begin
  // precalculate all possible values of a*b
  for Row:= 0 to 255 do
    for Col:= Row to 255 do
    begin
      PreMult[Row, Col]:= Row*Col div 255;
      if (Row <> Col) then
        PreMult[Col, Row]:= PreMult[Row, Col]; // a*b = b*a
    end;

  for Row:= 0 to Bitmap.Height-1 do
  begin
    Col:= Bitmap.Width;
    p:= Bitmap.ScanLine[Row];
    while (Col > 0) do
    begin
      p.rgbBlue:= PreMult[p.rgbReserved, p.rgbBlue];
      p.rgbGreen:= PreMult[p.rgbReserved, p.rgbGreen];
      p.rgbRed:= PreMult[p.rgbReserved, p.rgbRed];
      Inc(p);
      Dec(Col);
    end;
  end;
end;}

// latest function (2011), ALL ICONS SHOWING CORRECTLY!!!!!!
function TFormMain.AddMAMu_Icon(sysID: Byte; romID: Integer; const GameName, CloneName, DriverName, BiosName, SoftwareName: String; IconList: TImageList): Integer;
var
  Icon32: TExIcon;
  icoLoop: Integer;
  FileToLoad: String;
  SearchZip: Boolean;

  function AddNormalIcon(IconSize: Integer): Integer;
  var
    nIcon: TIcon;
  begin
    nIcon:= TIcon.Create;
    nIcon.Width:= IconSize;
    nIcon.Height:= IconSize;
    nIcon.Handle:= Icon32.Handle;
    Result:= IconList.AddIcon(nIcon);
    nIcon.ReleaseHandle;
    FreeAndNil(nIcon);
  end;

  function AddIcon(DestImgList: TImageList): Integer;
  var
    icoBMP: TBitmap;
    fIcon: TExIcon;
  begin
    Icon32.CurrentImage:= icoLoop;
    if IconList.Width <> 48 then
       Result:= AddNormalIcon(IconList.Width)
    else
       begin
         fIcon:= TExIcon.Create;
         fIcon.Handle:= Icon32.Handle;
         case fIcon.Width of
           48:
             begin
               Result:= AddNormalIcon(48);
             end;
           32:
             begin
               icoBMP:= TBitmap.Create;
               icoBMP.Width:= 48;
               icoBMP.Height:= 48;
               icoBMP.PixelFormat:= pf32Bit;
               icoBMP.Canvas.Brush.Style:= bsClear;
               icoBMP.Canvas.Brush.Color:= fIcon.TransparentColor;
               icoBMP.Canvas.FillRect(Rect(0, 0, 48, 48));
               icoBMP.Canvas.Draw(8, 8, fIcon);
               if not icoBMP.Empty then
                  Result:= IconList.AddMasked(icoBMP, fIcon.TransparentColor);
               FreeAndNil(icoBMP);
             end;
         end;
         fIcon.Releasehandle;
         FreeAndNil(fIcon);
       end;
  end;

begin
  Result:= -1;
  if SoftwareName <> '' then Exit; // there will be no MAMu_ icons support for software list games!!!!!
  //if (GameName = 'goonies') and (SoftwareName = 'msx1_cart') then
  //   beep; // for debugging... futurue improvement ?????
  FileToLoad:= GetMAMu_IconFileName(sysID, romID, GameName, CloneName, DriverName, BiosName, SoftwareName, False);
  if FileToLoad = '' then
     begin
       SearchZip:= Assigned(MAMu_IconsList);
       if not SearchZip then
          Exit;
       FileToLoad:= GetMAMu_IconFileName(sysID, romID, GameName, CloneName, DriverName, BiosName, SoftwareName, True);
       if FileToLoad = '' then
          Exit;
     end;

  if LoadMAMu_Icon(FileToLoad, Icon32, icoLoop, SearchZip, IconList.Width) then
     Result:= AddIcon(IconList);
  FreeAndNil(Icon32);
end;

