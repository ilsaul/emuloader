procedure TFormMain.ClearScreenshot(const ScreenIndex: ShortInt);
begin
  if ScreenIndex = 1 then
     begin
       try
         Images.Bitmap:= nil
       finally
       end;
     end
  else
  begin
    try
      if Assigned(ImageScr[ScreenIndex]) then
         ImageScr[ScreenIndex].Bitmap:= nil;
    finally
    end;
  end;
  UnzipActive[ScreenIndex]:= False;
