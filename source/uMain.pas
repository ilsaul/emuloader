function TFormMain.GetSoftListFilesToAudit(sysID: ShortInt; var ListHolder: THashedStringList): Boolean;
var
  TempFile: TMemIniFile;
begin
  Result:= ValidateFile(GetMAMEMachineSoftListFile(False, sysID));
  if not Result then
     begin
       FreeAndNil(ListHolder);
       Exit;
     end;
  if not Assigned(ListHolder) then
     ListHolder:= THashedStringList.Create;

  TempFile:= TMemIniFile.Create(GetMAMEMachineSoftListFile(False, sysID));
  TempFile.ReadSections(ListHolder);
  FreeAndNil(TempFile);
  Result:= ListHolder.Count > 0;
  if Result then
     begin
        ListHolder.BeginUpdate;
        ListHolder.Sort;
        ListHolder.EndUpdate;
     end
  else
     FreeAndNil(ListHolder);
end;

procedure TFormMain.SoftListGetExcludedList(sysID: ShortInt; ListHolder: THashedStringList);
begin
  if ValidateFile(GetSoftListExcludeFile(sysID)) then
     ListHolder.LoadFromFile(GetSoftListExcludeFile(sysID));
end;

procedure TFormMain.SoftListRemoveExcludedList(sysID: ShortInt; var ListHolder: THashedStringList);
var
  ExcludedList: THashedStringList;
  Loop: Integer;
  SoftNameStr: String;
begin
  if not ValidateFile(GetSoftListExcludeFile(sysID)) then
     Exit;
  if ListHolder.Count = 0 then
     Exit;
  //ShowMessageW('total items before: '+IntToStr(ListHolder.Count)); // for debugging only, do not enable

  ExcludedList:= THashedStringList.Create;
  ExcludedList.LoadFromFile(GetSoftListExcludeFile(sysID));
  ListHolder.BeginUpdate;
  for Loop:=ListHolder.Count-1 downto 0 do
  begin
    SoftNameStr:= ListHolder[Loop];
    if ExcludedList.IndexOf(SoftNameStr) <> -1 then
       ListHolder.Delete(Loop);
  end;
  ListHolder.EndUpdate;
  FreeAndNil(ExcludedList);
  //ShowMessageW('total items before: '+IntToStr(ListHolder.Count)); // for debugging only, do not enable
end;

procedure TFormMain.SoftListValidateListsXML(sysID: ShortInt; var ListHolder: THashedStringList);
var
  iFiles: THashedStringList;
  Loop: Integer;
  FolderXML, GameFolder, SoftNameStr, GameCRC32, XMLCRC32: String;
  iStr: String;

  function GetGameFileCRC32: Boolean;
  begin
    Result:= FileExists(GameFolder+SoftNameStr+'.el');
    if not Result then
       Exit;
    iFiles:= THashedStringList.Create;
    iFiles.LoadFromFile(GameFolder+SoftNameStr+'.el');
    iStr:= iFiles.Values['xmlfile_crc32'];
    Result:= iStr <> '';
    GameCRC32:= iStr;
    FreeAndNil(iFiles);
  end;

begin
  // - remove MAME software lists from frontend't list if CRC32 is the same or if MAME's XML file is not found
  // - this function is only used when creating MAME/HBMAME software lists, and it must be called AFTER the function
  //   that removes "disabled" softlists

  if ListHolder.Count = 0 then
     Exit;

  if MenuCreateMAMESoftwareListGames.Tag <> 1 then
     Exit;

  ReadMAMEHashFolder(sysID, EmulatorFile[sysID], FolderXML);
  if FolderXML = '' then
     Exit;

  FormStatus.MessageStr('Validating '+GetArcadeSystemIniSection(sysID)+' software lists.');
  GameFolder:= GetGamesFolderEL(1, sysID); // for "\arcade\mame_softwarelist_games\softwarename.el"
  ListHolder.BeginUpdate;
  for Loop:=ListHolder.Count-1 downto 0 do // ListHolder is the var list softlists to be created
  begin
    SoftNameStr:= ListHolder[Loop];
    if FileExists(FolderXML+SoftNameStr+'.xml') then
       begin
         if GetGameFileCRC32 then
         begin
           XMLCRC32:= CalcFileCRC32(FolderXML+SoftNameStr+'.xml');
           if SameText(XMLCRC32, GameCRC32) then
              ListHolder.Delete(Loop); // CRC32 is the same "mamedir\hash\softwarename.xml" and "eldir\arcade\mame_softwarelist_games\softwarename.xml", remove it
         end;
       end
    else
       ListHolder.Delete(Loop); // "mamedir\hash\softwarename.xml" not found, cannot create a games list for it, remove the softlist from frontend's list
    Application.ProcessMessages;
  end;
  ListHolder.EndUpdate;
end;

procedure TFormMain.SoftListDeleteGamesFiles(sysID: Integer; CreateListMode: Integer; SourceList: TStringList = nil);
var
  GamesFolder, SoftNameStr, FileToDelete: WideString;
  Loop, LoopFileType: Integer;
  SoftListReqFile: TMemIniFile;
  FoundReqFile: Boolean;
begin
  // CreateListMode
  // 0 -> disabled, delete all software list files
  // 1 -> create, update mode, delete software list files only from "SourceList" list var
  // 2 -> create, overwrite mode, delete all software list files
  GamesFolder:= GetGamesFolderEL(1, sysID);
  if CreateListMode in [0, 2] then
     begin
       DeleteAllFilesW(GamesFolder);
       DeleteFile(GetSoftListRequirementFile(sysID)); // delete "system_name.elsoftlistreq"
     end
  else
     begin
       if SourceList.Count = 0 then
          Exit; // there is nothing to do here, software list var is empty
       FoundReqFile:= ValidateFile(GetSoftListRequirementFile(sysID));
       if FoundReqFile then
          SoftListReqFile:= TMemIniFile.Create(GetSoftListRequirementFile(sysID)); // delete selective softwarename entries from "system_name.elsoftlistreq"
       for Loop:=0 to SourceList.Count-1 do
       begin
         SoftNameStr:= SourceList[Loop];
         for LoopFileType:=0 to 3 do // .el; .elrom; .elstatus; .elmiss
         begin
           FileToDelete:= GetSystemFileName(sysID, LoopFileType, SoftNameStr);
           DeleteFileW(PWideChar(FileToDelete));
         end;
         if FoundReqFile then
            SoftListReqFile.EraseSection(SoftNameStr);
       end;
       if FoundReqFile then
          begin
            SoftListReqFile.UpdateFile;
            FreeAndNil(SoftListReqFile);
          end;
     end;

  Sleep(5); // a tiny pause
end;

procedure TFormMain.SetLabelSoftwareScanCountVisible(IsVisible: Boolean);
begin
  if IsVisible then
     begin
       if FormStatus.LabelMessage.Left <> 90 then
          FormStatus.LabelMessage.Left:= 90; // 5 pixels space between labels
       if not FormStatus.SplashScreenEnableTextsAlternateLayout.Checked then
          if FormStatus.LabelStatusType.Left <> 90 then
             FormStatus.LabelStatusType.Left:= 90;
     end
  else
     begin
       if FormStatus.LabelMessage.Left <> 4 then
          FormStatus.LabelMessage.Left:= 4;
       if not FormStatus.SplashScreenEnableTextsAlternateLayout.Checked then
          if FormStatus.LabelStatusType.Left <> 76 then
             FormStatus.LabelStatusType.Left:= 76;
     end;
  if FormStatus.LabelSoftwareScanCount.Visible <> IsVisible then
     FormStatus.LabelSoftwareScanCount.Visible:= IsVisible;
end;

procedure TFormMain.MenuCreateMAMESoftwareListGamesClick(Sender: TObject);
var
  Loop, iCount: Integer;
  MachinesList: THashedStringList;
  sysID: Byte;
  iScanMAMESetsMode, iSoftwareMode: Integer;
begin
  if CreatingGamesList then
     Exit;

  if TMenuItem(Sender).Tag <> 50 then
     sysID:= idMAME
  else
     sysID:= idHBMAME;

  if not VerifyArcadeGamesSys(sysID) then
     Exit;
  MachinesList:= THashedStringList.Create;
  if not GetSoftListFilesToAudit(sysID, MachinesList) then
     begin
       FreeAndNil(MachinesList);
       Exit;
     end;

  if CallSelectArcadeSystem(6, sysID) = -1 then // for a future expansion, let user select create/scan options ?
     begin
       FreeAndNil(MachinesList);
       Exit; // -1 = aborted by user
     end;

  MAMu_CloseZipArchives;
  
  // to scan games files this must be set to zero (Scan All MAME Sets)
  iScanMAMESetsMode:= MenuCreateMAMESoftwareListGames.HelpContext;
  MenuCreateMAMESoftwareListGames.HelpContext:= 0;

  // if software list mode is "disable", then it will be set to "enable"
  iSoftwareMode:= MenuCreateMAMESoftwareListGames.Tag;
  if MenuCreateMAMESoftwareListGames.Tag = 0 then
     MenuCreateMAMESoftwareListGames.Tag:= 1; // set to enable (update mode)

  case MenuCreateMAMESoftwareListGames.Tag of
    1: FormStatus.TitleStr('Create '+GetArcadeEmulatorDescription(sysID, True)+' Software Games Lists (Update Mode)');
    2: FormStatus.TitleStr('Create '+GetArcadeEmulatorDescription(sysID, True)+' Software Games Lists (Overwrite Mode)');
  end;

  FormStatus.Show;
  FormStatus.StartThreadClock;

  SoftListRemoveExcludedList(sysID, MachinesList);
  SoftListValidateListsXML(sysID, MachinesList);
  SoftListDeleteGamesFiles(sysID, MenuCreateMAMESoftwareListGames.Tag, MachinesList);

  Sleep(5); // a tiny pause

  CreatingGamesList:= True;
  iCount:= MachinesList.Count;
  if iCount > 1 then
     SetLabelSoftwareScanCountVisible(True);

  if iCount > 0 then // if all softlist files are removed from the list then there's no point creating games list for softwarelist
  begin
    for Loop:= 0 to MachinesList.Count-1 do
    begin
      if FormStatus.LabelSoftwareScanCount.Visible then
         FormStatus.LabelSoftwareScanCount.Caption:= Format(FormStatus.LabelSoftwareScanCount.Hint, [Loop+1, iCount]);
      CreateSoftwareListXML(sysID, MachinesList[Loop], False);
    end;
  end;

  SetLabelSoftwareScanCountVisible(False);
  if iCount > 0 then
     begin
       SetGameType(True); // load the games list first
       Application.ProcessMessages;
       ScanSoftListGames(0, False, sysID, MachinesList); // pass a list of valid softwarename to audit (March 29, 2018)
     end;
  FreeAndNil(MachinesList);

  MenuCreateMAMESoftwareListGames.HelpContext:= iScanMAMESetsMode; // restore "Scan MAME Sets" mode to previous state
  MenuCreateMAMESoftwareListGames.Tag:= iSoftwareMode; // restore "Software List Games" mode to previous state

  // from "Create Arcade Games List" main menu
  // restore fixed scan mode as user selected "for this task only" option
  if PopupSelectScanGamesMode.HelpContext <> -1 then
     PopupSelectScanGamesMode.Tag:= PopupSelectScanGamesMode.HelpContext
  else
     SetScanModePopupHint(PopupSelectScanGamesMode.Tag);
  PopupSelectScanGamesMode.HelpContext:= -1; // set to null so next time sys selection screen loads the default scan mode

  if PopupScanGames.HelpContext <> -1 then
     begin
       // restore "Scan MAME Sets" setting since "For This Task Only" was checked
       MenuCreateMAMESoftwareListGames.HelpContext:= PopupScanGames.HelpContext;
       PopupScanGames.HelpContext:= -1;
     end;
     
  CreatingGamesList:= False;
  if iCount > 0 then
     SetGameType(False); // apply filters even if nothing has changed

  ResetNoImageLoaded;
  ReselectItem(True);
  FormStatus.Close;
  FocusGamesList;
end;

procedure TFormMain.CheckMachineToRun_CustomGame(CustomSystemID, CustomMediaType: Integer; out MachineNameVar: String; ShowSingleMachineMessage: Boolean);
var
  Item: TEasyItem;
  Group: TEasyGroup;
  mName, iCurrentMachineName, LastUsedIniFile: String;
  SystemStr, MediaTypeStr: String;
  AssignedSoftLists, ELV_AddedMachineNames: THashedStringList;
  LastUsedMachine: TMemIniFile;
  iStr, iFileStr: String;

  function AddMachineToList: Boolean;
  var
    Loop: Byte;
  begin
    Result:= TEasyGameInfo(Item).eSystemID = idMAME; //MemGameInfo.eSystemID; // to support MAME and HBMAME ? No, this is to run EmuCon games with MAME (April 01, 2018)
    //if Result then
    //   Result:= IsROM_Have(TEasyGameInfo(Item).eROMIdentification); // uncomment this to only add machines you have
    if Result then
       Result:= Length(TEasyGameInfo(Item).eSoftwareList) > 0;
    if Result then
    begin
      for Loop:= Low(TEasyGameInfo(Item).eSoftwareList) to High(TEasyGameInfo(Item).eSoftwareList) do
      begin
        mName:= TEasyGameInfo(Item).eSoftwareList[Loop];
        if (AssignedSoftLists.IndexOf(mName) <> -1) and (ELV_AddedMachineNames.IndexOf(uMain.TEasyGameInfo(Item).eName) = -1) then
        begin
          ELV_AddedMachineNames.Add(uMain.TEasyGameInfo(Item).eName);
          with FormArcadeSoftwareListMachineToRunGame.MachinesListView.Items.Add do
          begin
            Tag:= uMain.TEasyGameInfo(Item).eGameSetStatus;
            ImageIndex:= GetMAMEImageIndex(TEasyGameInfo(Item).eROMIdentification, TEasyGameInfo(Item).eSoftwareName);
            case TEasyGameInfo(Item).eIsFavorite of
              True:
                begin
                  StateImageIndexes[0]:= 3;
                end;
              False: StateImageIndexes[0]:= 500;
            end;
            StateImageIndexes[6]:= TEasyGameInfo(Item).eDriverStatus;
            
            Caption:= TEasyGameInfo(Item).eTitle;
            Captions[1]:= TEasyGameInfo(Item).eName;
            Captions[2]:= TEasyGameInfo(Item).eManufacturer;
            iStr:= TEasyGameInfo(Item).eScreenRefreshRate;
            if iStr <> '' then
            begin
              iStr:= FloatToStr(Round(StrToFloat(iStr)));
              iStr:= iStr+' Hz';
            end;
            Captions[3]:= iStr;
            Captions[4]:= TEasyGameInfo(Item).eClone;
            Captions[5]:= aSaveState[TEasyGameInfo(Item).eSaveState];
          end;
        end;
      end;
    end;
  end;

  function ELV_PopulateSoftwareMachineToUse: Boolean;
  begin
    Result:= True;
    ELV_AddedMachineNames:= THashedStringList.Create;
    ELV_AddedMachineNames.BeginUpdate;
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.BeginUpdate;
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.Items.ReIndexDisable:= True;

    if IsGroupedView then
    begin
      Group:= GamesListView.Groups.FirstGroup;
      repeat
        if not TGroupInfo(Group).eIsCustomGame then
        begin
          if (TGroupInfo(Group).eSoftwareName = '') and (TGroupInfo(Group).eSystemID = idMAME) then
          begin
            Item:= GamesListView.Groups.FirstInGroup(Group);
            repeat
              AddMachineToList;
              Item:= GamesListView.Groups.NextInGroup(Group, Item);
            until (Item = nil);
          end;
        end;
        Group:= GamesListView.Groups.NextGroup(Group);
      until Group = nil;
    end
    else
    begin
      Item:= GamesListView.Groups.FirstItem;
      repeat
        if not TEasyGameInfo(Item).eIsCustomGame then
        begin
          if TEasyGameInfo(Item).eSoftwareName = '' then
             AddMachineToList;
        end;
        Item:= GamesListView.Groups.NextItem(Item);
      until Item = nil;
    end;

    ELV_AddedMachineNames.EndUpdate;
    FreeandNil(ELV_AddedMachineNames);
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.Items.ReIndexDisable:= False;
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.EndUpdate;
  end;

begin
  ShowFilterMsgBox('Select MAME Machine to Run '+GetSystemTypeTitle(CustomSystemID, False)+' Game', 'Building compatible machines list, please wait...', IsGroupedView);

  iCurrentMachineName:= '';

  SystemStr:= SystemsListCustom[CustomSystemID, 0];
  MediaTypeStr:= MediaTypeCustom[CustomMediaType, 2];
  LastUsedIniFile:= GetMAMEMachineCustomGames(idMAME);
  iCurrentMachineName:= GetLastUsedMachineCustomGame(CustomSystemID, CustomMediaType);

  // need to get all assigned software lists for this system and get the first MAME machine name
  // ... only scan softlists based on the media type (cart/flop/cass/disc/hard)
  iFileStr:= GetSystemsSoftwareListFile(idMAME);
  AssignedSoftLists:= THashedStringList.Create;
  if FileExists(iFileStr) then
  begin
    LastUsedMachine:= TMemIniFile.Create(iFileStr);
    LastUsedMachine.ReadSectionValues(SystemStr, AssignedSoftLists);
    FreeAndNil(LastUsedMachine);
  end;
  if AssignedSoftLists.Count = 0 then
     begin
       FreeAndNil(AssignedSoftLists);
       //ShowMessageW('Error! There are no assigned MAME software lists for this system.'); // for debugging, do not remove (April 01, 2018)
       Exit;
     end;

  // start of new form to select a MAME machine
  if not Assigned(FormArcadeSoftwareListMachineToRunGame) then
     FormArcadeSoftwareListMachineToRunGame:= TFormArcadeSoftwareListMachineToRunGame.Create(nil);

  if IsNightMode then
     begin
       SetPanelBorderColors(FormArcadeSoftwareListMachineToRunGame.FrameMachinesList, clrBorderGroupBoxGrayBk, clrInnerBorderGroupBoxGrayBk);
     end;

  FormArcadeSoftwareListMachineToRunGame.Caption:= 'Select a MAME Machine to Run the '+GetSystemTypeTitle(CustomSystemID, False)+' Game With';
  FormArcadeSoftwareListMachineToRunGame.Tag:= 1;
  FormArcadeSoftwareListMachineToRunGame.CurrentMachineName:= iCurrentMachineName;

  ELV_PopulateSoftwareMachineToUse;

  HideFilterMsgBox;
  if CheckTotal(FormArcadeSoftwareListMachineToRunGame.MachinesListView) then
     begin
       if FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.ItemCount > 1 then
       begin
         if FormArcadeSoftwareListMachineToRunGame.ShowModal = mrYes then
         begin
           if CheckSelected(FormArcadeSoftwareListMachineToRunGame.MachinesListView) then
              iCurrentMachineName:= FormArcadeSoftwareListMachineToRunGame.MachinesListView.Selection.First.Captions[1];

           LastUsedMachine:= TMemIniFile.Create(LastUsedIniFile);
           LastUsedMachine.WriteString(SystemStr, MediaTypeStr, iCurrentMachineName);
           LastUsedMachine.UpdateFile;
           FreeAndNil(LastUsedMachine);
         end;
       end
       else
       begin
         if iCurrentMachineName = '' then
            begin
              iCurrentMachineName:= FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.FirstItem.Captions[1];
              LastUsedMachine:= TMemIniFile.Create(LastUsedIniFile);
              LastUsedMachine.WriteString(SystemStr, MediaTypeStr, iCurrentMachineName);
              LastUsedMachine.UpdateFile;
              FreeAndNil(LastUsedMachine);
            end;

         if ShowSingleMachineMessage then
            GenerateMessage('Info', 'Select MAME Machine to Run '+GetSystemTypeTitle(CustomSystemID, False)+' Game',
                            '    There is only one machine compatible with this system and it''s already selected.'+#13#10+#13#10+
                            'System: '+SystemStr+#13#10+
                            'Machine: '+FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.FirstItem.Caption+
                                      ' ['+FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.FirstItem.Captions[1]+']');
       end;
     end
  else
     GenerateMessage('Info', 'Select Machine to Run '+GetSystemTypeTitle(CustomSystemID, False)+' Game',
                     '    No MAME machine sets were found. Make sure you have a MAME games list.'+#13#10+
                     'System: '+SystemStr);
  ClearListView(FormArcadeSoftwareListMachineToRunGame.MachinesListView);
  FreeAndNil(FormArcadeSoftwareListMachineToRunGame);
  FreeAndNil(AssignedSoftLists);
  // end of new form to select a MAME machine

  MachineNameVar:= iCurrentMachineName; // this will be used in the uMain.ExecuteGame command line... MAME only!
end;

procedure TFormMain.SelectMachineToRun(out MachineNameVar: String; ShowSingleMachineMessage: Boolean);
var
  Item: TEasyItem;
  Group: TEasyGroup;
  slName, mName, iCurrentMachineName: String;
  LastUsedMachine: THashedStringList;
  LastUsedIndex: Integer;
  iStr: String;

  function AddMachineToList: Boolean;
  var
    Loop: Byte;
  begin
    Result:= TEasyGameInfo(Item).eSystemID = MemGameInfo.eSystemID; // to support MAME and HBMAME
    //if Result then
    //   Result:= IsROM_Have(TEasyGameInfo(Item).eROMIdentification); // machines you don't have are also added to the list...
    if Result then
       Result:= Length(TEasyGameInfo(Item).eSoftwareList) > 0;
    if Result then
    begin
      for Loop:= Low(TEasyGameInfo(Item).eSoftwareList) to High(TEasyGameInfo(Item).eSoftwareList) do
      begin
        mName:= TEasyGameInfo(Item).eSoftwareList[Loop];
        if mName = slName then
        begin
          with FormArcadeSoftwareListMachineToRunGame.MachinesListView.Items.Add do
          begin
            Tag:= uMain.TEasyGameInfo(Item).eGameSetStatus;
            ImageIndex:= GetMAMEImageIndex(TEasyGameInfo(Item).eROMIdentification, TEasyGameInfo(Item).eSoftwareName);
            case TEasyGameInfo(Item).eIsFavorite of
              True:
                begin
                  StateImageIndexes[0]:= 3;
                end;
              False: StateImageIndexes[0]:= 500;
            end;
            StateImageIndexes[6]:= TEasyGameInfo(Item).eDriverStatus;
            
            Caption:= TEasyGameInfo(Item).eTitle;
            Captions[1]:= TEasyGameInfo(Item).eName;
            Captions[2]:= TEasyGameInfo(Item).eManufacturer;
            iStr:= TEasyGameInfo(Item).eScreenRefreshRate;
            if iStr <> '' then
            begin
              iStr:= FloatToStr(Round(StrToFloat(iStr)));
              iStr:= iStr+' Hz';
            end;
            Captions[3]:= iStr;
            Captions[4]:= TEasyGameInfo(Item).eClone;
            Captions[5]:= aSaveState[TEasyGameInfo(Item).eSaveState];
          end;
        end;
      end;
    end;
  end;

  function ELV_PopulateSoftwareMachineToUse: Boolean;
  begin
    Result:= True;
    slName:= MemGameInfo.eSoftwareName;
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.BeginUpdate;
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.Items.ReIndexDisable:= True;
    if IsGroupedView then
    begin
      Group:= GamesListView.Groups.FirstGroup;
      repeat
        if (TGroupInfo(Group).eSoftwareName = '') and (TGroupInfo(Group).eSystemID = MemGameInfo.eSystemID) then
        begin
          Item:= GamesListView.Groups.FirstInGroup(Group);
          repeat
            AddMachineToList;
            Item:= GamesListView.Groups.NextInGroup(Group, Item);
          until (Item = nil);
        end;
        Group:= GamesListView.Groups.NextGroup(Group);
      until Group = nil;
    end
    else
    begin
      Item:= GamesListView.Groups.FirstItem;
      repeat
        if TEasyGameInfo(Item).eSoftwareName = '' then
           AddMachineToList;
        Item:= GamesListView.Groups.NextItem(Item);
      until Item = nil;
    end;
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.Items.ReIndexDisable:= False;
    FormArcadeSoftwareListMachineToRunGame.MachinesListView.EndUpdate;
  end;

begin
  ShowFilterMsgBox('Select Machine to Run Software List Game', 'Building compatible machines list, please wait...', IsGroupedView);
  LastUsedMachine:= THashedStringList.Create;
  iCurrentMachineName:= '';
  LastUsedIndex:= -1;

  if FileExists(GetMAMEMachineSoftListFile(True, MemGameInfo.eSystemID)) then
     begin
       LastUsedMachine.LoadFromFile(GetMAMEMachineSoftListFile(True, MemGameInfo.eSystemID));
       LastUsedIndex:= LastUsedMachine.IndexOfName(MemGameInfo.eSoftwareName);
       if LastUsedIndex <> -1 then
          iCurrentMachineName:= LastUsedMachine.Values[MemGameInfo.eSoftwareName];
     end;

  if not Assigned(FormArcadeSoftwareListMachineToRunGame) then
     FormArcadeSoftwareListMachineToRunGame:= TFormArcadeSoftwareListMachineToRunGame.Create(nil);

  if IsNightMode then
     begin
       SetPanelBorderColors(FormArcadeSoftwareListMachineToRunGame.FrameMachinesList, clrBorderGroupBoxGrayBk, clrInnerBorderGroupBoxGrayBk);
     end;
     
  FormArcadeSoftwareListMachineToRunGame.Tag:= 1;
  FormArcadeSoftwareListMachineToRunGame.CurrentMachineName:= iCurrentMachineName;

  ELV_PopulateSoftwareMachineToUse;

  HideFilterMsgBox;
  if CheckTotal(FormArcadeSoftwareListMachineToRunGame.MachinesListView) then
     begin
       if FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.ItemCount > 1 then
       begin
         if FormArcadeSoftwareListMachineToRunGame.ShowModal = mrYes then
         begin
           if CheckSelected(FormArcadeSoftwareListMachineToRunGame.MachinesListView) then
              iCurrentMachineName:= FormArcadeSoftwareListMachineToRunGame.MachinesListView.Selection.First.Captions[1];

           LastUsedMachine.BeginUpdate;
           if LastUsedIndex <> -1 then
              LastUsedMachine[LastUsedIndex]:= MemGameInfo.eSoftwareName+'='+iCurrentMachineName // update the current entry...
           else
              LastUsedMachine.Add(MemGameInfo.eSoftwareName+'='+iCurrentMachineName); // add a new softwarename=selected_machinename
           LastUsedMachine.EndUpdate;
           LastUsedMachine.SaveToFile(GetMAMEMachineSoftListFile(True, MemGameInfo.eSystemID));
         end;
       end
       else
       begin
         if iCurrentMachineName = '' then
            begin
              // no machine is selected or there is only one machine for the selected MAME software list
              iCurrentMachineName:= FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.FirstItem.Captions[1];
              LastUsedMachine.BeginUpdate;
              LastUsedMachine.Add(MemGameInfo.eSoftwareName+'='+iCurrentMachineName); // add a new softwarename=selected_machinename
              LastUsedMachine.EndUpdate;
              LastUsedMachine.SaveToFile(GetMAMEMachineSoftListFile(True, MemGameInfo.eSystemID));
            end;

         if ShowSingleMachineMessage then
            GenerateMessage('Info', 'Select Machine to Run Software List Game',
                            '    There is only one machine compatible with this software list game and it''s already selected.'+#13#10+#13#10+
                            'Software List: '+MemGameInfo.eCategory+' ['+MemGameInfo.eSoftwareName+']'+#13#10+
                            'Machine: '+FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.FirstItem.Caption+
                                      ' ['+FormArcadeSoftwareListMachineToRunGame.MachinesListView.Groups.FirstItem.Captions[1]+']');
       end;
     end
  else
     GenerateMessage('Info', 'Select Machine to Run Software List Game',
                     '    No machine sets were found. Make sure you have a MAME games list.'+#13#10+
                     'Software List: '+MemGameInfo.eCategory+' ['+MemGameInfo.eSoftwareName+']');
  ClearListView(FormArcadeSoftwareListMachineToRunGame.MachinesListView);
  FreeAndNil(FormArcadeSoftwareListMachineToRunGame);
  FreeAndNil(LastUsedMachine);

  MachineNameVar:= iCurrentMachineName; // this will be used in the uMain.ExecuteGame command line... MAME/HBMAME only!
end;

procedure TFormMain.PopupMachineToRunGameClick(Sender: TObject);
var
  iMachineName: String;
begin
  case MemGameInfo.eIsCustomGame of
    True : CheckMachineToRun_CustomGame(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, iMachineName, True);
    False: SelectMachineToRun(iMachineName, True);
  end;
end;

// here goes the function to get media type -cart1 ; -flop1 ; -cass1 for softlist games with "requirement" tag
function TFormMain.GetSoftListGameRequiredParam(sysID: Integer; const GameName: WideString; const SoftwareName: String): String;
var
  ExecParam: String;
  ReqSoftwareName: String;
  ReqSetName: String;
  GotMediaType: Boolean;
  sFileName, TempStr: String;
  SoftGamesList: THashedStringList;
begin
  GotMediaType:= False;
  ExecParam:= '';
  Result:= '';
  SoftListGetRequirementInfo(sysID, GameName, SoftwareName, ReqSetName, ReqSoftwareName);

  if (ReqSetName = '') and (ReqSoftwareName = '') then
     Exit; // there is no extra requirement for this game

  if ReqSoftwareName <> '' then
     begin
       if PosEx('_cart', ReqSoftwareName) <> 0 then
          begin
            GotMediaType:= True;
            ExecParam:= '-cart1 ';
          end
       else
       if PosEx('_flop', ReqSoftwareName) <> 0 then
          begin
            GotMediaType:= True;
            ExecParam:= '-flop1 ';
          end
       else
       if PosEx('_cass', ReqSoftwareName) <> 0 then
          begin
            GotMediaType:= True;
            ExecParam:= '-cass1 ';
          end;

       if not GotMediaType then
       begin
         // must open "\arcade\games\mame_softwarelist_games\softwarename.el" file and get the exec param there
         sFileName:= GetGamesFolderEL(1, sysID)+GetSystemFileName(sysID, 0, ReqSoftwareName);
         if FileExistsW(WideString(sFileName)) then
         begin
           SoftGamesList:= THashedStringList.Create;
           SoftGamesList.LoadFromFile(sFileName);
           TempStr:= SoftGamesList.Values[ReqSetName];
           FreeAndNil(SoftGamesList);
           if TempStr <> '' then
              ExecParam:= SoftListGetEntryValue(TempStr, 'media');
           GotMediaType:= ExecParam <> '';
           if GotMediaType then
              ExecParam:= '-'+ExecParam+' '; // "-cart "
         end;
       end;
     end
  else
     begin
       if SameText('pcecd', SoftwareName) then
          begin
            GotMediaType:= True;
            ExecParam:= '-cart1 '; // manual set the media type for "PC Engine CD" games
          end
       else
          begin

          end;
     end;

  Result:= ExecParam+ReqSetName;
end;

function TFormMain.GetSoftwareListDefaultColumnPos(iColumnIndex: Integer): Integer;
begin
  // set software list columns to default positions first... then custom position can be applied!
  Result:= -1;
  case iColumnIndex of
    00: Result:= 0;  // title
    01: Result:= 1;  // year
    02: Result:= 2;  // manufacturer
    06: Result:= 3;  // category
    17: Result:= 4;  // times played
    20: Result:= 5;  // last played date/time
    21: Result:= 6;  // total playtime
    08: Result:= 7;  // game name
    09: Result:= 8;  // clone of
    12: Result:= 9; // driver status
    13: Result:= 10; // emulation status
    19: Result:= 11; // game size
  end;
end;

function TFormMain.IsValidSoftwareListColumn(iColumnIndex: Integer): Boolean;
begin
  Result:= iColumnIndex in [0, 1, 2, 6, 8, 9, 12, 13, 17, 19, 20, 21];
end;

procedure TFormMain.ReadColumnsProfileMachinesList;
var
  Loop: Byte;
  columnFile: TMemIniFile;
  ColumnsArray: Boolean;
begin
  GamesListView.BeginUpdate;

  for Loop:= 1 to GamesListView.Header.Columns.Count-1 do
      GamesListView.Header.Columns[Loop].Visible:= IsValidSoftwareListColumn(Loop);

  if FileExists(GetColumnProfile) then
  begin
    columnFile:= TMemIniFile.Create(GetColumnProfile);
    ColumnsArray:= SetColumnsMemList(columnFile, True);

    for Loop:=1 to GamesListView.Header.Columns.Count-1 do
    begin
      if IsValidSoftwareListColumn(Loop) then
         GamesListView.Header.Columns[Loop].Visible:= Boolean(columnFile.ReadInteger('Visible_SoftwareList', aColumns[Loop, 0], 1));
    end;
    FreeAndNil(columnFile);

    for Loop:=1 to Length(ColumnsPosList)-1 do
    begin
      if ColumnsPosList[Loop] = 0 then
         Break
      else
      if GamesListView.Header.Columns[ColumnsPosList[Loop]].Position <> Loop then
         GamesListView.Header.Columns[ColumnsPosList[Loop]].Position:= Loop;
    end;

    if ColumnsArray then
       begin
         for Loop:=0 to Length(ColumnsPosList) do
             Finalize(ColumnsPosList);
       end;
  end;

  GamesListView.EndUpdate;
end;

procedure TFormMain.UpdateColumnsProfileMachinesList;
var
  columnFile: TMemIniFile;
  gColumn: TEasyColumn;
begin
  if CheckReadOnly(GetColumnProfile) then
     Exit;

  columnFile:= TMemIniFile.Create(GetColumnProfile);
  //columnFile.EraseSection('Width_SoftwareList');
  columnFile.EraseSection('Position_SoftwareList');
  columnFile.EraseSection('Visible_SoftwareList');

  gColumn:= GamesListView.Header.FirstColumn;
  repeat
    //if gColumn.Visible then
    begin
      if gColumn.Width <> aColumnsWidth[gColumn.Index] then
         columnFile.WriteInteger('Width', aColumns[gColumn.Index, 0], gColumn.Width)
      else
         columnFile.DeleteKey('Width', aColumns[gColumn.Index, 0]);

      if IsValidSoftwareListColumn(gColumn.Index) then
      begin
        if not gColumn.Visible then
           columnFile.WriteInteger('Visible_SoftwareList', aColumns[gColumn.Index, 0], 0);

        if (gColumn.Position <> gColumn.Index) and (gColumn.Index <> aColumnsSoftwareListOrder[gColumn.Position]) then
           columnFile.WriteInteger('Position_SoftwareList', aColumns[gColumn.Index, 0], gColumn.Position);
      end;
    end;
    gColumn:= GamesListView.Header.NextColumn(gColumn);
  until gColumn = nil;

  columnFile.UpdateFile;
  FreeAndNil(columnFile);
end;

procedure TFormMain.ToggleMachinesListSidePanel;
begin
  case FilterMachineType.MAMEMachinesFilterPanel_Enabled of
    True:
      begin
        if not PanelMachinesList.Visible then
           begin
             UpdateColumnProfile;
             GamesListView.Header.Columns[06].Caption:= 'Software List';
             PanelMachinesList.Visible:= True;
             LoadMachinesListToSidePanel;
             if not CheckTotal(MachinesListSidePanel) then
                begin
                  FilterMachineType.MAMEMachinesFilterPanel_Enabled:= False;
                  ToggleMachinesListSidePanel; // call it again to hide machines side panel and disable feature
                  Exit;
                end;
             ReadColumnsProfileMachinesList;
             // modify games list columns...
             // load machines into machines list EasyListView
             // select last selected machine name without applying ?... but DO NOT apply filters since there will be no machine selected to filter
             // perhaps create a new entry in EmuLoader.ini to store last selected game in machines list side panel ?
             // ...perhaps hide all games from games list
           end;
        if not SplitterMachines.Visible then
           SplitterMachines.Visible:= True;
      end;
    False:
      begin
        if SplitterMachines.Visible then
           SplitterMachines.Visible:= False;
        if PanelMachinesList.Visible then
           begin
             UpdateColumnsProfileMachinesList;
             PanelMachinesList.Visible:= False;
             // SelectedMachineListName; // this var contains the last selected machine name in the machines list side panel
             ClearListView(MachinesListSidePanel);
             GamesListView.Header.Columns[06].Caption:= aColumns[6, 1];
           end;
        if not IsStartup then
           begin
             PopupResetColumnsToDefault.Click; // restore columns to default
             ReadColumnProfile; // read default columns profile
           end;
      end;
  end;

  MenuColumns.Visible:= not PanelMachinesList.Visible;
  ButtonArcadeGamesFilters.Enabled:= (not PanelMachinesList.Visible) and (not PopupEnableFavorites.Checked);
  ButtonExtraFilters.Enabled:= not PanelMachinesList.Visible;
end;

