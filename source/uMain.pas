begin
  ButtonVideoPreviewPlay.Visible:= VideoPreviewEnabled;
  PopupVideoPreviewPlay.Visible:= ButtonVideoPreviewPlay.Visible;
  WebButtonVideoPreviewPlay.Visible:= ButtonVideoPreviewPlay.Visible;
  PlayDummyVideoPreview:= False;
end;

procedure TFormMain.UpdateArcadeVideoPreviewSection;
var
  vpFile: TStringList;
  iIndex: Integer;
begin
  if not FileExists(GetVideoPreviewIniFile) then
     Exit;
  vpFile:= TStringList.Create;
  vpFile.LoadFromFile(GetVideoPreviewIniFile);
  iIndex:= vpFile.IndexOf('[Folders]');
  if iIndex <> -1 then
     begin
       vpFile[iIndex]:= '[Arcade Folders]';
       vpFile.SaveToFile(GetVideoPreviewIniFile);
     end;
  FreeAndNil(vpFile);
end;

procedure TFormMain.ReadVideoPreviewIni(LoadMediaPlayerSettings, LoadMediaPlayerParameters, LoadDummyParameters: Boolean);
var
  INIFile: TMemIniFile;
  Loop: Byte;
  videoFile, iParameters: String;
  //SectionFound: Boolean;
begin
  // this function is called only once at startup; "Video Preview Settings" dialog does NOT use this!!! (October 05, 2017)
  if not ValidateFile(GetVideoPreviewIniFile) then
     Exit;

  try
    INIFile:= TMemIniFile.Create(GetVideoPreviewIniFile);
    if LoadMediaPlayerSettings then
       begin
         for Loop:=1 to MaxArcadeSystems do
             ArcadeVideoPreviewDir[Loop]:= INIFile.ReadString('Arcade Folders', GetArcadeSystemIniSection(Loop, True), '');

         for Loop:=1 to MaxConsoleComputerSystems do
             ConsoleComputerVideoPreviewDir[Loop]:= INIFile.ReadString('Console/Computer Folders', ChangeFileExt(SystemsListCustom[Loop, 2], ''), '');

         VideoPreviewMediaPlayerExecutable:= INIFile.ReadString('MediaPlayer', 'File', '');
         VideoPreviewEnabled:= Boolean(INIFile.ReadInteger('MediaPlayer', 'Enabled', 1));
         VideoPreviewAutoPlay:= Boolean(INIFile.ReadInteger('MediaPlayer', 'AutoPlay', 0));
         VideoPreviewParentGameVideo:= Boolean(INIFile.ReadInteger('MediaPlayer', 'ParentGameVideo', 0));
         VideoPreviewPlayDummyVideo:= Boolean(INIFile.ReadInteger('MediaPlayer', 'PlayDummyVideo', 0));
       end;

    if LoadMediaPlayerParameters then
    begin
      VideoFile:= VideoPreviewMediaPlayerExecutable;
      if VideoFile <> '' then
         VideoFile:= ExtractFileName(VideoFile);
      if VideoFile <> '' then
         begin
           iParameters:= INIFile.ReadString('Parameters', VideoFile, '');
           if iParameters = '' then
              iParameters:= '%1'
           else
              begin
                if PosEx('%1', iParameters) = 0 then
                   iParameters:= '%1 '+iParameters;
              end;
           iParameters:= StringReplace(iParameters, '"%1"', '%1', [rfIgnoreCase]);
           VideoPreviewMediaPlayerParameters:= iParameters;
         end;
    end;

    if LoadDummyParameters then
    begin
      VideoPreviewDummyVideoParameters:= INIFile.ReadString('MediaPlayer', 'DummyVideoParameters', '');
         if VideoPreviewDummyVideoParameters <> '' then
         begin
           if PosEx('"%1"', VideoPreviewDummyVideoParameters) <> 0 then
              VideoPreviewDummyVideoParameters:= StringReplace(VideoPreviewDummyVideoParameters,
                                                                      '"%1"', '%1', [rfIgnoreCase]);
         end;
    end;
  finally
    FreeAndNil(INIFile);
  end;
  SetVideoPreviewState;
end;

procedure TFormMain.UpdateVideoPreviewIni;
var
  INIFile: TMemIniFile;
  Loop: Byte;
  VideoFile, iParameters: String;
begin
  if CheckReadOnly(GetVideoPreviewIniFile) then
     Exit;
  try
    INIFile:= TMemIniFile.Create(GetVideoPreviewIniFile);

    for Loop:= 1 to MaxArcadeSystems do
    begin
      iParameters:= GetArcadeSystemIniSection(Loop, True);
      if ArcadeVideoPreviewDir[Loop] <> '' then
         INIFile.WriteString('Arcade Folders', iParameters, ArcadeVideoPreviewDir[Loop])
      else
         INIFile.DeleteKey('Arcade Folders', iParameters);
    end;

    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      iParameters:= ChangeFileExt(SystemsListCustom[Loop, 2], '');
      if ConsoleComputerVideoPreviewDir[Loop] <> '' then
         INIFile.WriteString('Console/Computer Folders', iParameters, ConsoleComputerVideoPreviewDir[Loop])
      else
         INIFile.DeleteKey('Console/Computer Folders', iParameters);
    end;

    VideoFile:= VideoPreviewMediaPlayerExecutable;
    INIFile.WriteString('MediaPlayer', 'File', VideoFile);
    INIFile.WriteInteger('MediaPlayer', 'Enabled', Ord(VideoPreviewEnabled));
    INIFile.WriteInteger('MediaPlayer', 'AutoPlay', Ord(VideoPreviewAutoPlay));
    INIFile.WriteInteger('MediaPlayer', 'ParentGameVideo', Ord(VideoPreviewParentGameVideo));
    INIFile.WriteInteger('MediaPlayer', 'PlayDummyVideo', Ord(VideoPreviewPlayDummyVideo));
    INIFile.WriteString('MediaPlayer', 'DummyVideoParameters', VideoPreviewDummyVideoParameters);

    if VideoFile <> '' then
       VideoFile:= ExtractFileName(VideoFile);

    if VideoFile <> '' then
       begin
         iParameters:= VideoPreviewMediaPlayerParameters;
         if iParameters = '' then
            iParameters:= '%1'
         else
            begin
              if PosEx('%1', iParameters) = 0 then
                 iParameters:= '%1 '+iParameters;
            end;
         iParameters:= StringReplace(iParameters, '"%1"', '%1', [rfIgnoreCase]);
         VideoPreviewMediaPlayerParameters:= iParameters;
       end;
    INIFile.WriteString('Parameters', VideoFile, VideoPreviewMediaPlayerParameters);
    INIFile.UpdateFile;
  finally
    FreeAndNil(INIFile);
  end;
  if not VideoPreviewEnabled then
     VideoPreviewFile:= '';
end;

procedure TFormMain.ValidateEmuImgCat_IniFile;
var
  iNewFile, iOldFile: String;
begin
  iOldFile:= GetIniFilesFolder+'emulators.ini';
  if ValidateFile(iOldFile) then
     begin
       iNewFile:= GetArcadeEmulatorsFile;
       if not ValidateFile(iNewFile) then
          begin
            MoveFileW(iOldFile, iNewFile, True);
            Sleep(50);
          end;
     end;

  iOldFile:= GetIniFilesFolder+'image_categories.ini';
  if ValidateFile(iOldFile) then
     begin
       iNewFile:= GetImageCategoriesFile;
       if not ValidateFile(iNewFile) then
          begin
            MoveFileW(iOldFile, iNewFile, True);
            Sleep(50);
          end;
     end;
end;

function TFormMain.ReadArcadeEmulatorExecutable(ShowFileNotFoundMessage: Boolean = False): Boolean;
var
  INIFile: TMemIniFile;
  Loop: ShortInt;
  ShowErrorMsg: Boolean;
  SectionString: String;
begin
  // this function only executes at startup, when it's not a clean install...
  ShowErrorMsg:= False;

  Result:= FileExists(GetArcadeEmulatorsFile);
  if not Result then
     Exit;

  if FormStatus.Visible then
     FormStatus.MessageStr('Loading emulators info.');
     
  try
    INIFile:= TMemIniFile.Create(GetArcadeEmulatorsFile);
    for Loop:=1 to MaxArcadeSystems do
    begin
      SectionString:= GetArcadeSystemIniSection(Loop);
      EmulatorFile[Loop]:= INIFile.ReadString(SectionString, 'emu_FileName', '');
      EmulatorVersion[Loop]:= INIFile.ReadString(SectionString, 'emu_VersionInfo', '');
      EmulatorDateTime[Loop]:= INIFile.ReadInteger(SectionString, 'emu_DateTime', -1);

      if (EmulatorDateTime[Loop] = -1) and FileExists(EmulatorFile[Loop]) then
         EmulatorDateTime[Loop]:= FileAgeW(EmulatorFile[Loop]);

      case Loop of
        idMAME:   buildMAME:=   INIFile.ReadString(SectionString, 'emu_Build', '');
        idHBMAME: buildHBMAME:= INIFile.ReadString(SectionString, 'emu_Build', '');
      end;
    end;

    // AlterMAME 1
    AlterMAMEFile[1]:= INIFile.ReadString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEFile', '');
    AlterMAMEVersion[1]:= INIFile.ReadString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEVersion', '');
    AlterMAMEDateTime[1]:= INIFile.ReadInteger(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEDateTime', -1);

    if (AlterMAMEDateTime[1] = -1) and FileExists(AlterMAMEFile[1]) then
       AlterMAMEDateTime[1]:= FileAgeW(AlterMAMEFile[1]);

    buildAlterMAME[1]:= INIFile.ReadString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEBuild', '');

    // AlterMAME 2
    AlterMAMEFile[2]:= INIFile.ReadString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAME2File', '');
    AlterMAMEVersion[2]:= INIFile.ReadString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAME2Version', '');
    AlterMAMEDateTime[2]:= INIFile.ReadInteger(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAME2DateTime', -1);

    if (AlterMAMEDateTime[2] = -1) and FileExists(AlterMAMEFile[2]) then
       AlterMAMEDateTime[2]:= FileAgeW(AlterMAMEFile[2]);

    buildAlterMAME[2]:= INIFile.ReadString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAME2Build', '');

    for Loop:=1 to MaxArcadeSystems do
    begin
      if (EmulatorFile[Loop] <> '') and (not FileExists(EmulatorFile[Loop])) then
         begin
           if not ShowErrorMsg then
              begin
                if ShowFileNotFoundMessage then
                   CallMessageBox;
                ShowErrorMsg:= True;
              end
           else
              begin
                if ShowFileNotFoundMessage then
                   AddMsgText(#13#10+#13#10);
              end;

           if ShowFileNotFoundMessage then
           begin
             AddMsgText('    '+GetArcadeEmulatorDescription(Loop, True)+#13#10, clBlack, [fsBold]);
             AddMsgText('File not found: ');
             AddMsgText(EmulatorFile[Loop], MsgTxtColors.colorWarning);

             AddMsgText(#13#10+#13#10+'Would you like to select an emulator executable now ? Not doing so, emulators settings will not be loaded '+
                        'and the frontend will not work properly.');
           end;

           Result:= False;
         end;
    end;
    if ShowErrorMsg then
       begin
         if ShowFileNotFoundMessage then
         begin
           if GenerateMessage('Error: Startup', 'File access error.'+#13#10+'Check your emulators files.', '', 1, False, 2) = mrYes then
              begin
                MenuArcadeEmulatorSetup.Click;
                Result:= True;
                // re-check if all emulator files exist...
                for Loop:=1 to MaxArcadeSystems do
                begin
                  if (EmulatorFile[Loop] <> '') and (not FileExists(EmulatorFile[Loop])) then
                     Result:= False;
                end;
              end;
         end;
       end;
  finally
    FreeAndNil(INIFile);
  end;
  //LoadFoldersAllSystems; // no need to be here as this is called later in FormMain.OnShow()... when it's not a clean install
end;

{
procedure TFormMain.WriteArcadeEmulatorExecutable(UpdateEmulatorInfo, UpdateEmulatorExecutable, UpdateFolderInfo: Boolean);
var
  INIFile: TMemIniFile;
  Loop: Integer;
  SectionString: String;

  function WriteEmulatorROMsFolders(SystemID: Integer): Boolean;
  var
    FolderString: String;
    folderLoop: Integer;
  begin
    Result:= True;
    if Assigned(emuROMsFolders[SystemID]) and (emuROMsFolders[SystemID].Count > 0) then
       begin
         FolderString:= '';
         for folderLoop:=0 to emuROMsFolders[SystemID].Count-1 do
         begin
           if FolderString = '' then
              FolderString:= emuROMsFolders[SystemID].Strings[folderLoop]
           else
              FolderString:= FolderString+';'+emuROMsFolders[SystemID].Strings[folderLoop]
         end;
         INIFile.WriteString(GetArcadeSystemIniSection(SystemID), 'roms_path', FolderString);
       end
    else
       INIFile.DeleteKey(GetArcadeSystemIniSection(SystemID), 'roms_path');
  end;

  procedure WriteEmulatorVariables(SystemID: Integer);
  begin
    if EmulatorFile[SystemID] <> '' then
       begin
         SectionString:= GetArcadeSystemIniSection(SystemID);
         if UpdateEmulatorExecutable then
            INIFile.WriteString(SectionString, 'emu_FileName', EmulatorFile[SystemID]);
         INIFile.WriteString(SectionString, 'emu_VersionInfo', EmulatorVersion[SystemID]);
         INIFile.WriteInteger(SectionString, 'emu_DateTime', EmulatorDateTime[SystemID]);

         case SystemID of
           idMAME: INIFile.WriteString(SectionString, 'emu_Build', buildMAME);
           idHBMAME: INIFile.WriteString(SectionString, 'emu_Build', buildHBMAME);
         end;
       end
    else
       begin
         INIFile.DeleteKey(SectionString, 'emu_FileName');
         INIFile.DeleteKey(SectionString, 'emu_VersionInfo');
         INIFile.DeleteKey(SectionString, 'emu_DateTime');
         case SystemID of
           idMAME: INIFile.DeleteKey(SectionString, 'emu_Build');
           idHBMAME: INIFile.DeleteKey(SectionString, 'emu_Build');
         end;
       end;
  end;

begin
  // this function only executes at startup... it should not save the emulator filename back...
  try
    INIFile:= TMemIniFile.Create(GetArcadeEmulatorsFile);
    // Systems sections options
    if UpdateFolderInfo then
    begin
      for Loop:=1 to MaxArcadeSystems do
      begin
        if IsROMsFolderCustom(Loop) then
           WriteEmulatorROMsFolders(Loop);
      end;
    end;

    if UpdateEmulatorInfo then
    begin
      for Loop:=1 to MaxArcadeSystems do
          WriteEmulatorVariables(Loop);

      if AlterMAMEFile = '' then
         begin
           INIFile.DeleteKey(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEFile');
           INIFile.DeleteKey(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEBuild');
           INIFile.DeleteKey(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEDateTime');
         end
      else
         begin
           if UpdateEmulatorExecutable then
              INIFile.WriteString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEFile', AlterMAMEFile);
           INIFile.WriteString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEBuild', buildAlterMAME);
           INIFile.WriteInteger(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEDateTime', AlterMAMEDateTime);
         end;
      if AlterMAMEVersion = '' then
         INIFile.DeleteKey(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEVersion')
      else
         INIFile.WriteString(GetArcadeSystemIniSection(idMAME), 'emu_AlterMAMEVersion', AlterMAMEVersion);
    end;
  finally
     //for Loop:=1 to MaxArcadeSystems do
     //begin
     //  SectionString:= GetArcadeSystemIniSection(Loop);
     //  if not INIFile.SectionExists(SectionString) then
     //     INIFile.EraseSection(SectionString);
     //end;

     INIFile.UpdateFile;
  end;
  FreeAndNil(INIFile);
end;
}

function TFormMain.GetFirstPathOnly(const PathString: String): String;
var
  iPos: Integer;
begin
  Result:= PathString;
  if PathString <> '' then
     begin
       iPos:= PosEx(';', PathString);
       if iPos <> 0 then
          Result:= Copy(PathString, 1, iPos-1);
     end;
end;

function TFormMain.ReadArcadeImageCategories(LoadImagesSettings, LoadMAMu_Setting: Boolean; var ArcadeImageFolderVarsArray: TImageFoldersArcade; ExtractMAMEFolderToStringList: Boolean): Boolean;
var
  INIFile: TMemIniFile;
  Loop: ShortInt;
  IsMAME_uiIni, IsHBMAME_uiIni: Boolean;
  ShowErrorMsg, ImageCatIniFound: Boolean;
  IndexMAME: Integer;

  function ReadLineMAME_uiIni(sysID, ImageCategory: Integer; const LineStr: String): Boolean;
  var
    ValueToRead: String;
  begin
    //if (data->data != NULL)
    //   fprintf(inifile, "%-25s %s\n", data->names[0], data->data);
    //else
    //   fprintf(inifile, "# %-23s <NULL> (not set)\n", data->names[0]);
    Result:= True;
    ValueToRead:= '';
    if ImageCategory <> 50 then
       begin
         ValueToRead:= ExtractMAMEIniValue(LineStr);
         if ValueToRead = '' then
            ValueToRead:= ImageCategoryArray[ImageCategory, 3] // get default folder value if value in mamedir\ui.ini is empty
         else
         if ImageCategory = 8 then
            begin
              if SameText('"artwork preview;artpreview"', ValueToRead) then
                 ValueToRead:= 'artpreview';
            end;

         //if ParseFirstPathOnly then // this cannot be TRUE for "Image Category Settings" screen
         //   begin
         //     ValueToRead:= GetFirstPathOnly(ValueToRead);
         //     ValueToRead:= RemoveQuotes(ValueToRead);
         //   end;
         ArcadeImageFolderVarsArray[sysID, ImageCategory]:= ValueToRead;
         if ExtractMAMEFolderToStringList then
            begin
              IndexMAME:= Ord(sysID <> idMAME)+1;
              case Assigned(imgFolderMAME[IndexMAME, ImageCategory]) of
                True : imgFolderMAME[IndexMAME, ImageCategory].Clear;
                False: imgFolderMAME[IndexMAME, ImageCategory]:= TStringList.Create;
              end;
              ExtractFolders2MAME(sysID, ValueToRead, imgFolderMAME[IndexMAME, ImageCategory], False); // emulator full path already generated in TStringList
            end;
       end
    else
       begin
         // MAMu_ icons
         ValueToRead:= ExtractMAMEIniValue(LineStr);
         if ValueToRead = '' then
            ValueToRead:= 'icons'
         else
            ValueToRead:= GetFirstPathOnly(ValueToRead);

         ValueToRead:= RemoveQuotes(ValueToRead);
         FormPreferences.MAMu_IconsFolder.Text:= ValueToRead;
       end;
  end;

  function ReadMAMESettingUI(sysID: Integer): Boolean;
  var
    LoopUI: Integer;
    TextLineUI, EntryStringUI, tmpEntryStr, ValueUI, FileIniUI: String;
    UpdateSetting: Boolean;
    FileMAME_ui: TStringList;
  begin
    // will save icons folder and image folders in "mamedir\ui.ini" file... August 01, 2016
    // if file "mamedir\ui.ini" is not found, settings will be saved in "eldir\arcade\image_categories.ini" but the settings names will be replaced by MAME names... for consistency (August 01, 2016)
    // move MAMu_ icons folder save to "eldir\arcade\image_categories.ini" file, into the "[MAME]" section since icons a for MAME anyway (August 01, 2016)
    Result:= False;
    if EmulatorFile[sysID] <> '' then
       begin
         FileIniUI:= ExtractFilePath(EmulatorFile[sysID])+'ui.ini';
         Result:= ValidateFile(FileIniUI);
         if not Result then
            Exit;
       end
    else
       Exit;

    if IsMAMEBasedSys(sysID) then
    case sysID of
      idMAME  : IsMAME_uiIni:= True;
      idHBMAME: IsHBMAME_uiIni:= True;
    end;

    FileMAME_ui:= TStringList.Create;
    FileMAME_ui.LoadFromFile(FileIniUI);
    FileMAME_ui.BeginUpdate;

    // "ui.ini" is for MAME 0.172 and newer!!!
    // options from "mame\source\mame\src\frontend\mame\ui\" folder; files: "moptions.h" and "moptions.cpp"
    for LoopUI:=0 to FileMAME_ui.Count-1 do
    begin
      TextLineUI:= FileMAME_ui[LoopUI];
      UpdateSetting:= False;
      EntryStringUI:= '';
      ValueUI:= '';
      if TextLineUI <> '' then
         begin
           EntryStringUI:= XML_GetEntryName(TextLineUI);
           tmpEntryStr:= EntryStringUI+' ';

           if LoadImagesSettings then
           begin
             if tmpEntryStr = (ImageCategoryArray[0, 4]+' ') then // ui.ini //if tmpEntryStr = 'titles_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 0, TextLineUI);
                end
             else
             // ImageCategoryArray[1, 4] -> this is for in-game snapshots... read/write in mame.ini!
             if tmpEntryStr = (ImageCategoryArray[2, 4]+' ') then // ui.ini //if tmpEntryStr = 'marquees_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 2, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[3, 4]+' ') then // ui.ini //if tmpEntryStr = 'flyers_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 3, TextLineUI);
                end;

             if tmpEntryStr = (ImageCategoryArray[4, 4]+' ') then // ui.ini //if tmpEntryStr = 'cabinets_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 4, TextLineUI);
                  //iPos:= PosEx(';', imgFolder[sysID, 4]); // this is no longer required (July 29, 2018)
                  //if iPos <> 0 then
                  //   imgFolder[sysID, 4]:= Copy(imgFolder[sysID, 4], 1, iPos-1);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[5, 4]+' ') then // ui.ini //if tmpEntryStr = 'cpanels_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 5, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[6, 4]+' ') then // ui.ini //if tmpEntryStr = 'pcbs_directory ' then // ui.ini
                begin
                  // category ID = 6 is the new "software cover"!
                  ReadLineMAME_uiIni(sysID, 6, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[7, 4]+' ') then // ui.ini //if tmpEntryStr = 'pcbs_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 7, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[8, 4]+' ') then // ui.ini //if tmpEntryStr = 'artwork_preview_directory ' then
                begin
                  // default value "artwork preview;artpreview"
                  ReadLineMAME_uiIni(sysID, 8, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[9, 4]+' ') then // ui.ini //if tmpEntryStr = 'ends_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 9, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[10, 4]+' ') then // ui.ini //if tmpEntryStr = 'bosses_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 10, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[11, 4]+' ') then // ui.ini //if tmpEntryStr = 'logos_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 11, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[12, 4]+' ') then // ui.ini //if tmpEntryStr = 'scores_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 12, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[13, 4]+' ') then // ui.ini //if tmpEntryStr = 'versus_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 13, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[14, 4]+' ') then // ui.ini //if tmpEntryStr = 'gameover_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 14, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[15, 4]+' ') then // ui.ini //if tmpEntryStr = 'howto_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 15, TextLineUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[16, 4]+' ') then // ui.ini //if tmpEntryStr = 'select_directory ' then // ui.ini
                begin
                  ReadLineMAME_uiIni(sysID, 16, TextLineUI);
                end
           end;

           if LoadMAMu_Setting and (sysID = idMAME) then
           begin
             if tmpEntryStr = 'icons_directory ' then
                begin
                  // 50 is the ID for MAMu_ icons
                  ReadLineMAME_uiIni(sysID, 50, TextLineUI);
                end;
           end;
         end;
    end;
    FileMAME_ui.EndUpdate;
    FreeAndNil(FileMAME_ui);
  end;

  function SetImageFolder(SystemID: Integer): Boolean;
  var
    Section, ValueToRead: String;
    LoopImg: ShortInt;
  begin
    Result:= True;
    if IsMAMEBasedSys(SystemID) then
      begin
        if ReadMAMESettingUI(SystemID) then
           Result:= False;
      end;

    if not Result then
       Exit; // system ID is MAME/HBMAME and mamedir\ui.ini was found...

    if LoadImagesSettings and ImageCatIniFound then
       begin
         Section:= GetArcadeSystemIniSection(SystemID);
         for LoopImg:= Low(ImageCategoryArray) to High(ImageCategoryArray) do
         begin
           if not (IsMAMEBasedSys(SystemID) and (LoopImg = 1)) then
              begin
                ValueToRead:= INIFile.ReadString(Section, ImageCategoryArray[LoopImg, 4], ImageCategoryArray[LoopImg, 3]);
                if ValueToRead = '' then
                   ValueToRead:= ImageCategoryArray[LoopImg, 3] // get default folder value if value in mamedir\ui.ini is empty
                else
                if LoopImg = 8 then
                   begin
                     if SameText('"artwork preview;artpreview"', ValueToRead) then
                        ValueToRead:= 'artpreview';
                   end;

                //if ParseFirstPathOnly then // this cannot be TRUE for "Image Category Settings" screen
                //   begin
                //     ValueToRead:= GetFirstPathOnly(ValueToRead);
                //     ValueToRead:= RemoveQuotes(ValueToRead);
                //   end;

                ArcadeImageFolderVarsArray[SystemID, LoopImg]:= ValueToRead;
                //imgFolder[SystemID, LoopImg]:= ValueToRead; // INIFile.ReadString(Section, ImageCategoryArray[LoopImg, 4], ImageCategoryArray[LoopImg, 3]);

                if IsMAMEBasedsys(SystemID) then
                begin
                  if ExtractMAMEFolderToStringList then
                     begin
                       IndexMAME:= Ord(SystemID <> idMAME)+1;
                       case Assigned(imgFolderMAME[IndexMAME, LoopImg]) of
                         True : imgFolderMAME[IndexMAME, LoopImg].Clear;
                         False: imgFolderMAME[IndexMAME, LoopImg]:= TStringList.Create;
                       end;
                       ExtractFolders2MAME(SystemID, ValueToRead, imgFolderMAME[IndexMAME, LoopImg], False); // emulator full path already generated in TStringList
                     end;
                end;
              end;
         end;
       end;
  end;

begin
  ShowErrorMsg:= False;
  if FormStatus.Visible then
     FormStatus.MessageStr('Reading image categories settings.');

  IsMAME_uiIni:= False; // MAME "ui.ini" not found
  IsHBMAME_uiIni:= False; // HBMAME "ui.ini" not found

  Result:= True;

  ImageCatIniFound:= FileExists(GetImageCategoriesFile);

  try
    if ImageCatIniFound then
       INIFile:= TMemIniFile.Create(GetImageCategoriesFile);

    for Loop:= 1 to MaxArcadeSystems do
        SetImageFolder(Loop);

    // check if "mamedir\ui.ini" exists; if not, save MAMu_ icons folder setting into "\arcade\image_categories.ini"
      if (not IsMAME_uiIni) and LoadMAMu_Setting and ImageCatIniFound then
         FormPreferences.MAMu_IconsFolder.Text:= INIFile.ReadString(GetArcadeSystemIniSection(idMAME), 'icons_directory', 'icons');

  finally
    if ImageCatIniFound then
       FreeAndNil(INIFile);
  end;
  if LoadMAMu_Setting then
     SetMAMu_Folder(FormPreferences.MAMu_IconsFolder.Text);
end;

procedure TFormMain.WriteArcadeImageCategories(WriteImagesSettings, WriteMAMu_Setting: Boolean; var ArcadeImageFolderVarsArray: TImageFoldersArcade);
var
  INIFile: TMemIniFile;
  Loop: Integer;
  IsMAME_uiIni, IsHBMAME_uiIni, UpdateImgIni: Boolean;

  function WriteLineMAME_uiIni(sysID, ImageCategory: Integer; const Entry: String): String;
  var
    ValueToWrite: String;
  begin
    //if (data->data != NULL)
    //   fprintf(inifile, "%-25s %s\n", data->names[0], data->data);
    //else
    //   fprintf(inifile, "# %-23s <NULL> (not set)\n", data->names[0]);
    if ImageCategory <> 50 then
       begin
         ValueToWrite:= ArcadeImageFolderVarsArray[sysID, ImageCategory]; // imgFolder[sysID, ImageCategory];
         if ValueToWrite = '' then
            ValueToWrite:= ImageCategoryArray[ImageCategory, 3]; // get default folder value if imgFolder[sysID, imgCategory] is empty

         //ValueToWrite:= MountFoldersListToString(imgFolderArcade[sysID, ImageCategory]);
         //if ValueToWrite = '' then
         //   ValueToWrite:= ImageCategoryArray[ImageCategory, 3]; // get default folder value if imgFolder[sysID, imgCategory] is empty
       end
    else
       begin
         // MAMu_ icons
         ValueToWrite:= FormPreferences.MAMu_IconsFolder.Text;
         if ValueToWrite = '' then
            ValueToWrite:= 'icons';
       end;
    Result:= Format('%-25s %s', [Entry, ValueToWrite]);
  end;

  function WriteMAMESettingUI(sysID: Integer): Boolean;
  var
    LoopUI: Integer;
    TextLineUI, EntryStringUI, tmpEntryStr, ValueUI, FileIniUI: String;
    UpdateSetting: Boolean;
    FileMAME_ui: TStringList;
  begin
    // will save icons folder and image folders in "mamedir\ui.ini" file... August 01, 2016
    // if file "mamedir\ui.ini" is not found, settings will be saved in "eldir\arcade\image_categories.ini" but the settings names will be replaced by MAME names... for consistency (August 01, 2016)
    // move MAMu_ icons folder save to "eldir\arcade\image_categories.ini" file, into the "[MAME]" section since icons a for MAME anyway (August 01, 2016)
    Result:= False;
    if EmulatorFile[sysID] <> '' then
       begin
         FileIniUI:= ExtractFilePath(EmulatorFile[sysID])+'ui.ini';
         Result:= ValidateFile(FileIniUI);
         if not Result then
            Exit;
       end
    else
       Exit;

    case sysID of
      idMAME  : IsMAME_uiIni:= True;
      idHBMAME: IsHBMAME_uiIni:= True;
    end;

    FileMAME_ui:= TStringList.Create;
    FileMAME_ui.LoadFromFile(FileIniUI);
    FileMAME_ui.BeginUpdate;

    // "ui.ini" is for MAME 0.172 and newer!!!
    // options from "mame\source\mame\src\frontend\mame\ui\" folder; files: "moptions.h" and "moptions.cpp"
    for LoopUI:=0 to FileMAME_ui.Count-1 do
    begin
      TextLineUI:= FileMAME_ui[LoopUI];
      UpdateSetting:= False;
      EntryStringUI:= '';
      ValueUI:= '';
      if TextLineUI <> '' then
         begin
           EntryStringUI:= XML_GetEntryName(TextLineUI);
           tmpEntryStr:= EntryStringUI+' ';

           if WriteImagesSettings then
           begin
             if tmpEntryStr = (ImageCategoryArray[0, 4]+' ') then // ui.ini //if tmpEntryStr = 'titles_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 0, EntryStringUI);
                end
             else
             // ImageCategoryArray[1, 4] -> this is for in-game snapshots... read/write in mame.ini!
             if tmpEntryStr = (ImageCategoryArray[2, 4]+' ') then // ui.ini //if tmpEntryStr = 'marquees_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 2, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[3, 4]+' ') then // ui.ini //if tmpEntryStr = 'flyers_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 3, EntryStringUI);
                end;

             if tmpEntryStr = (ImageCategoryArray[4, 4]+' ') then // ui.ini //if tmpEntryStr = 'cabinets_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 4, EntryStringUI);
                  //CabinetDir.Text:= ReadSetting('cabinets');
                  //iPos:= PosEx(';', CabinetDir.Text);
                  //if iPos <> 0 then
                  //   CabinetDir.Text:= Copy(CabinetDir.Text, 1, iPos-1);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[5, 4]+' ') then // ui.ini //if tmpEntryStr = 'cpanels_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 5, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[6, 4]+' ') then // ui.ini //if tmpEntryStr = 'covers_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 6, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[7, 4]+' ') then // ui.ini //if tmpEntryStr = 'pcbs_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 7, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[8, 4]+' ') then // ui.ini //if tmpEntryStr = 'artwork_preview_directory ' then
                begin
                  // default value "artwork preview;artpreview"
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 8, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[9, 4]+' ') then // ui.ini //if tmpEntryStr = 'ends_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 9, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[10, 4]+' ') then // ui.ini //if tmpEntryStr = 'bosses_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 10, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[11, 4]+' ') then // ui.ini //if tmpEntryStr = 'logos_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 11, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[12, 4]+' ') then // ui.ini //if tmpEntryStr = 'scores_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 12, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[13, 4]+' ') then // ui.ini //if tmpEntryStr = 'versus_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 13, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[14, 4]+' ') then // ui.ini //if tmpEntryStr = 'gameover_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 14, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[15, 4]+' ') then // ui.ini //if tmpEntryStr = 'howto_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 15, EntryStringUI);
                end
             else
             if tmpEntryStr = (ImageCategoryArray[16, 4]+' ') then // ui.ini //if tmpEntryStr = 'select_directory ' then // ui.ini
                begin
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 16, EntryStringUI);
                end
           end;

           if WriteMAMu_Setting and (sysID = idMAME) then
           begin
             if tmpEntryStr = 'icons_directory ' then
                begin
                  // 50 is the ID for MAMu_ icons
                  FileMAME_ui[LoopUI]:= WriteLineMAME_uiIni(sysID, 50, EntryStringUI);
                end;
           end;
         end;
    end;
    FileMAME_ui.EndUpdate;
    FileMAME_ui.SaveToFile(FileIniUI);
    FreeAndNil(FileMAME_ui);
  end;

  function SaveSnapFolderZipFile(SystemID: Integer): Boolean;
  var
    Section, ValueToWrite: String;
    imgLoop: ShortInt;
  begin
    Result:= True;
    if IsMAMEBasedSys(SystemID) then
      begin
        if WriteMAMESettingUI(SystemID) then
           Result:= False;
      end;

    if (not Result) or (Result and (not WriteImagesSettings)) then
       Exit; // system ID is MAME/HBMAME and mamedir\ui.ini was found... or images should not be updated

    Section:= GetArcadeSystemIniSection(SystemID);

    UpdateImgIni:= True;
    Section:= GetArcadeSystemIniSection(SystemID);
    for imgLoop:=Low(ImageCategoryArray) to High(ImageCategoryArray) do
    begin
      if not (IsMAMEBasedSys(SystemID) and (imgLoop = 1)) then
      begin
        ValueToWrite:= ArcadeImageFolderVarsArray[SystemID, imgLoop]; // imgFolder[SystemID, imgLoop];
        if ValuetoWrite <> '' then //  imgFolder[SystemID, imgLoop] <> '' then
           INIFile.WriteString(Section, ImageCategoryArray[imgLoop, 4], ValueToWrite)
        else
           INIFile.DeleteKey(Section, ImageCategoryArray[imgLoop, 4]);

        //ValueToWrite:= MountFoldersListToString(imgFolderArcade[SystemID, ImgLoop]);
        ////if ValueToWrite = '' then
        ////   ValueToWrite:= ImageCategoryArray[ImageCategory, 3]; // get default folder value if imgFolder[sysID, imgCategory] is empty
        //if ValueToWrite <> '' then
        //   INIFile.WriteString(Section, ImageCategoryArray[imgLoop, 4], ValueToWrite)
        //else
        //   INIFile.DeleteKey(Section, ImageCategoryArray[imgLoop, 4]);
      end;
    end;
  end;

begin
  INIFile:= TMemIniFile.Create(GetImageCategoriesFile);
  UpdateImgIni:= False;

  try
    if WriteImagesSettings or WriteMAMu_Setting then
    begin
      for Loop:=1 to MaxArcadeSystems do
          SaveSnapFolderZipFile(Loop);
    end;

    if WriteMAMu_Setting and (not IsMAME_uiIni) then
       begin
         // check if "mamedir\ui.ini" exists; if not, save MAMu_ icons folder setting into "\arcade\image_categories.ini"
         INIFile.WriteString(GetArcadeSystemIniSection(idMAME), 'icons_directory', FormPreferences.MAMu_IconsFolder.Text);
         UpdateImgIni:= True;
       end;
       
  finally
    if UpdateImgIni then
       INIFile.UpdateFile;
    FreeAndNil(INIFile);
  end;
end;

function TFormMain.IsSameFont(SourceFont, DestinationFont: TFont): Boolean;
begin
  Result:= (DestinationFont.Color = SourceFont.Color) and
           (DestinationFont.Name = SourceFont.Name) and
           (DestinationFont.Size = SourceFont.Size) and
           (DestinationFont.Style = SourceFont.Style);
end;

procedure TFormMain.SetFont(SourceFont: TFont; var DestinationFont: TFont; AutoCreateDestinationFontVar: Boolean = False);
begin
  if not Assigned(DestinationFont) then
     begin
       if AutoCreateDestinationFontVar then
          DestinationFont:= TFont.Create
       else
          Exit; // auto-create is disabled and font var is not initialized; abort!!! useful for console/computer font settings (EmuCon systems)
     end;
  DestinationFont.Color:= SourceFont.Color;
  DestinationFont.Name:= SourceFont.Name;
  DestinationFont.Size:= SourceFont.Size;
  DestinationFont.Style:= SourceFont.Style;
end;

procedure TFormMain.ReadCustomGameFontFile(ReadNightModeFile: Boolean);
var
  FontIniFile: TMemIniFile;
  Loop: Integer;
  tmpFont: TFont;
  iFile: String;
  iColor: TColor;

  function ReadEntry(const EntryTitle: String; DestinationFont: TFont; DefaultFontColor: TColor; const DefaultFontName: String; DefaultFontSize: Integer; DefaultFontStyle: Byte): Boolean;
  begin
    Result:= True;
    DestinationFont.Color:= FontIniFile.ReadInteger(EntryTitle, 'FontColor', DefaultFontColor);
    DestinationFont.Name:= FontIniFile.ReadString(EntryTitle, 'FontName', DefaultFontName);
    DestinationFont.Size:= FontIniFile.ReadInteger(EntryTitle, 'FontSize', DefaultFontSize);
    DestinationFont.Style:= TFontStyles(Byte(FontIniFile.ReadInteger(EntryTitle, 'FontStyle', DefaultFontStyle)));
  end;

begin
  iFile:= GetCustomFontIniFile(ReadNightModeFile);
  if not ValidateFile(iFile) then
     Exit;

  if FormStatus.Visible then
     FormStatus.MessageStr('Loading systems custom fonts file "'+ExtractFileName(iFile)+'".');

  if not IsStartup then
  begin
    // DeInit console/computer TFont variables first!
    for Loop:= 1 to MaxConsoleComputerSystems do
        FreeAndNil(Font_ConsoleComputer[Loop]);
  end;

  try
    FontIniFile:= TMemIniFile.Create(iFile);

    if ReadNightModeFile then
       iColor:= clWhite
    else
       iColor:= clBlack;
    ReadEntry('Parent Game', Font_Parent, iColor, 'Segoe UI', 9, 0);
    ReadEntry('Clone Game', Font_Clone, iColor, 'Segoe UI', 9, 0);

    if ReadNightModeFile then
       iColor:= clSilver
    else
       iColor:= clGray;
    ReadEntry('Preliminary Game', Font_Preliminary, iColor, 'Segoe UI', 9, 8);

    if ReadNightModeFile then
       iColor:= clrLightRed
    else
       iColor:= clRed;
    ReadEntry('Missing ROMs Game', Font_MissingROMs, iColor, 'Segoe UI', 9, 0);
    ReadEntry('Missing ROMs Preliminary Game', Font_MissingROMsPreliminary, iColor, 'Segoe UI', 9, 8);

    GamesListView.Font:= Font_Parent;
    //SetFont(Font_Parent, GamesListView.Font);

    if FontIniFile.SectionExists('All Systems') then
       ReadEntry('All Systems', GamesListView.Font, Font_Parent.Color, Font_Parent.Name, Font_Parent.Size, Byte(Font_Parent.Style));

    tmpFont:= TFont.Create;
    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      ReadEntry(SystemsListCustom[Loop, 0], tmpFont, GamesListView.Font.Color, GamesListView.Font.Name, GamesListView.Font.Size, Byte(GamesListView.Font.Style));
      if not (IsSameFont(GamesListView.Font, tmpFont)) then
         SetFont(tmpFont, Font_ConsoleComputer[Loop], True)
      else
         FreeAndNil(Font_ConsoleComputer[Loop]); // free TFont var from RAM
    end;
    FreeAndNil(tmpFont);
  finally
    FreeAndNil(FontIniFile);
  end;
end;

procedure TFormMain.WriteCustomGameFontFile(ReadNightModeFile: Boolean);
var
  FontIniFile: TMemIniFile;
  Loop: Integer;
  iFile: String;

  function WriteEntry(EntryTitle: String; SourceFont: TFont): Boolean;
  begin
    Result:= True;
    FontIniFile.WriteInteger(EntryTitle, 'FontColor', SourceFont.Color);
    FontIniFile.WriteString(EntryTitle,  'FontName',  SourceFont.Name);
    FontIniFile.WriteInteger(EntryTitle, 'FontSize',  SourceFont.Size);
    FontIniFile.WriteInteger(EntryTitle, 'FontStyle', Byte(SourceFont.Style));
  end;

begin
  iFile:= GetCustomFontIniFile(ReadNightModeFile);
  if CheckReadOnly(iFile) then
     Exit;

  DeleteFile(iFile);
  try
    FontIniFile:= TMemIniFile.Create(iFile);

    WriteEntry('Parent Game', Font_Parent);
    WriteEntry('Clone Game', Font_Clone);
    WriteEntry('Preliminary Game', Font_Preliminary);
    WriteEntry('Missing ROMs Game', Font_MissingROMs);
    WriteEntry('Missing ROMs Preliminary Game', Font_MissingROMsPreliminary);
    WriteEntry('All Systems', GamesListView.Font);

    for Loop:= 1 to MaxConsoleComputerSystems do
    begin
      if Assigned(Font_ConsoleComputer[Loop]) then
         begin
           if not IsSameFont(Font_ConsoleComputer[Loop], GamesListView.Font) then
              WriteEntry(SystemsListCustom[Loop, 0], Font_ConsoleComputer[Loop]) // "GamesListView.Font" is the "All Systems" font
           else
             FreeAndNil(Font_ConsoleComputer[Loop]);
         end;
    end;
  finally
    FontIniFile.UpdateFile;
    FreeAndNil(FontIniFile);
  end;
end;

procedure TFormMain.ReadSingleLayoutCategory(SetCategoryPopupMenu: Boolean);
var
  INIFile: TMemIniFile;
  iCategory: Integer;
begin
  iCategory:= -1;
  if ValidateFile(GetImageLayoutsFile) then
     begin
       // get image category index for single image layout
       INIFile:= TMemIniFile.Create(GetImageLayoutsFile);
       iCategory:= INIFile.ReadInteger(GetScrLayoutSection(0), 'image1_category', GetScrLayoutDefaultType(0, 1));
       FreeAndNil(INIFile);
     end;

  if iCategory = -1 then
     iCategory:= GetScrLayoutDefaultType(0, 1);

  if SetCategoryPopupMenu then
     begin
       if ButtonImageCategory.Tag = iCategory then
          ChangeImageCategory(ButtonImageCategory.Tag)
       else
          CallSelectImageCategory(iCategory, True, False, False, True)
     end
  else
     ButtonImageCategory.Tag:= iCategory;
end;

procedure TFormMain.ReadImageSingleBackground(UpdateColorOnly: Boolean);
var
  ImgIniFile: TMemIniFile;
begin
  if not ValidateFile(GetImageCategorySettingsFile) then
     Exit;
  ImgIniFile:= TMemIniFile.Create(GetImageCategorySettingsFile);

  if IsNightMode then
     MenuImageUseSingleBackgroundColor.Tag:= ImgIniFile.ReadInteger('SingleBackground', 'Color_NightMode', 0) // the selected color is stored in the .Tag property
  else
     MenuImageUseSingleBackgroundColor.Tag:= ImgIniFile.ReadInteger('SingleBackground', 'Color', 0); // the selected color is stored in the .Tag property
  if not UpdateColorOnly then
     begin
       MenuImageUseSingleBackgroundColor.Checked:= Boolean(ImgIniFile.ReadInteger('SingleBackground', 'Enabled', 0));
       PopupImageUseSingleBackgroundColor.Checked:= MenuImageUseSingleBackgroundColor.Checked;
     end;
  ReplaceColorIcon(False, True); // replace the icon by a color box

  FreeAndNil(ImgIniFile);
end;

procedure TFormMain.WriteImageSingleBackground;
var
  ImgIniFile: TMemIniFile;
begin
  ImgIniFile:= TMemIniFile.Create(GetImageCategorySettingsFile);

  ImgIniFile.WriteInteger('SingleBackground', 'Enabled', Ord(MenuImageUseSingleBackgroundColor.Checked));
  if IsNightMode then
     ImgIniFile.WriteInteger('SingleBackground', 'Color_NightMode', MenuImageUseSingleBackgroundColor.Tag) // the selected color is stored in the .Tag property
  else
     ImgIniFile.WriteInteger('SingleBackground', 'Color', MenuImageUseSingleBackgroundColor.Tag); // the selected color is stored in the .Tag property

  ImgIniFile.UpdateFile;
  FreeAndNil(ImgIniFile);
end;

procedure TFormMain.LoadImageCategoryLayoutSettings(ReadCategoryBackgroundColorsOnly: Boolean = False);
var
  ImgIniFile: TMemIniFile;
  Loop: Integer;
  iSection: String;
begin
  // called only from uMain.ReadIniFile
  if ValidateFile(GetImageCategorySettingsFile) then
     begin
       if IsNightMode then
          iSection:= 'NightMode'
       else
          iSection:= 'Category';

       ImgIniFile:= TMemIniFile.Create(GetImageCategorySettingsFile);
       // set image category settings
         for Loop:=Low(ImageCategoryArray) to High(ImageCategoryArray) do
         begin
           ImageCategorySettings[Loop].BackgroundColor:= ImgIniFile.ReadInteger(iSection, ImageCategoryArray[Loop, 1]+'_bkcolor', 0);
           if not ReadCategoryBackgroundColorsOnly then
           begin
             if Loop <> 1 then
                ImageCategorySettings[Loop].Visible:= Boolean(ImgIniFile.ReadInteger('Category', ImageCategoryArray[Loop, 1]+'_enabled', 1));
           end;
         end;
       FreeAndNil(ImgIniFile);
     end;

  if ReadCategoryBackgroundColorsOnly then
     Exit;
  if ValidateFile(GetImageLayoutsFile) then
     begin
       ImgIniFile:= TMemIniFile.Create(GetImageLayoutsFile);
       // set image layout settings
       for Loop:=1 to MaxImageLayouts do // must start with index #1 since single image layout cannot be set invisible
           ImageLayoutVisible[Loop]:= Boolean(ImgIniFile.ReadInteger(GetScrLayoutSection(Loop), 'visible', 1));
       FreeAndNil(ImgIniFile);
     end;
end;

procedure TFormMain.ReadSplashSettings;
