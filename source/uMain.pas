procedure TFormMain.ELV_PopulateImageCategory(const DestListView: TEasyListView; GhostDisabled, HideDisabled: Boolean; CaptionType: Integer = -1);
var
  Loop: ShortInt;
  IsCheckBox: Boolean;
begin
  IsCheckBox:= DestListView.PaintInfoItem.CheckType = ectBox;
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;

  for Loop:=Low(ImageCategoryArray) to High(ImageCategoryArray) do
  begin
    with DestListView.Items.Add do
    begin
      ImageIndex:= Loop;
      Tag:= ImageCategorySettings[ImageIndex].BackgroundColor; // background color
      case CaptionType of
        -1: Caption:= GetImageCategoryTitle(Loop); // category full title
         0: Caption:= ''; // empty title
         1:
           begin
             // short title
             case ImageIndex of
               0: Caption:= 'Title';
               1: Caption:= 'Snap';
               5: Caption:= 'CPanel';
               6: Caption:= 'Cover';
               8: Caption:= 'Game Artwork';
               15: Caption:= 'How To';
             else
                  Caption:= ImageCategoryArray[ImageIndex, 1];
             end;
           end;
      end;
      if not ImageCategorySettings[Loop].Visible then
         begin
           if GhostDisabled then
              State:= State+[esosGhosted];
           if not IsCheckBox then
              begin
                if HideDisabled then
                   Visible:= ImageCategorySettings[Loop].Visible;
              end;
         end;

      if IsCheckBox then
         Checked:= ImageCategorySettings[Loop].Visible;
    end;
  end;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

procedure TFormMain.ELV_ImageCategoriesShortTitle(const DestListView: TEasyListView);
var
  Item: TEasyItem;
begin
  Item:= DestListView.Groups.FirstItem;
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;
  repeat
    case Item.ImageIndex of
      0: Item.Caption:= 'Title';
      1: Item.Caption:= 'Snap';
      5: Item.Caption:= 'CPanel';
      6: Item.Caption:= 'Cover';
      8: Item.Caption:= 'Game Artwork';
      15: Item.Caption:= 'How To';
    else
         Item.Caption:= ImageCategoryArray[Item.ImageIndex, 1];
    end;
    Item:= DestListView.Groups.NextItem(Item);
  until Item = nil;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

procedure TFormMain.ELV_PopulateImageLayouts(const DestListView: TEasyListView; MinLayoutIndex: Integer; LayoutTypeIndex: Integer = -1; CaptionType: Integer = -1);
var
  IsCheckBox, Continue: Boolean;
  Loop: Byte;
begin
  IsCheckBox:= DestListView.PaintInfoItem.CheckType = ectBox;
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;

  for Loop:=MinLayoutIndex to MaxImageLayouts do
  begin
    Continue:= False;
    case LayoutTypeIndex of
      -1: Continue:= True; // add all layouts
       0:
         begin
           if Loop = 0 then
              Continue:= True // single layout cannot be set invisible
           else
              Continue:= ImageLayoutVisible[Loop]; // only visible layouts
         end;
       2: Continue:= Loop in [1, 2]; // add dual layouts only
       3: Continue:= Loop in [3..8]; // add triple layouts only
       4: Continue:= Loop > 8;       // add quad layouts only
    end;

    if Continue and (Loop <> 0) then
       Continue:= ImageLayoutVisible[Loop];
    if Continue then
    begin
      with DestListView.Items.Add do
      begin
        ImageIndex:= Loop;
        case CaptionType of
          -1: Caption:= GetScrLayoutSection(Loop); // layout full title
           0: Caption:= ''; // empty title
           {1: // this is not used anywhere
             begin
               // short title
               case ImageIndex of
                 0: Caption:= 'Title';
                 1: Caption:= 'Snap';
                 5: Caption:= 'CPanel';
                 6: Caption:= 'Cover';
                 8: Caption:= 'Game Artwork';
                 15: Caption:= 'How To';
               else
                    Caption:= ImageCategoryArray[ImageIndex, 1];
               end;
             end;}
        end;

        if IsCheckBox then
           begin
             if Loop = 0 then
                Checked:= True
             else
                Checked:= ImageLayoutVisible[Loop];
           end;
      end;
    end;
  end;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

procedure TFormMain.ELV_PopulateSystems(const DestListView: TEasyListView; ShowDisabled: Boolean = True; ShortTitle: Boolean = False; MinIndex: ShortInt = 0; MaxIndex: ShortInt = MaxArcadeSystems);
var
  Loop: ShortInt;
  ShowItem: Boolean;
begin
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;
  for Loop:=MinIndex to MaxIndex do
  begin
    ShowItem:= ShowDisabled;
    if not ShowDisabled then
       ShowItem:= ValidateArcadeEmulatorFile(Loop) and IsSystemAvailable(Loop);
    with DestListView.Items.Add do
    begin
      case ShortTitle of
        True : Caption:= GetArcadeSystemShortTitle(Loop);
        False: Caption:= GetArcadeEmulatorDescription(Loop);
      end;
      ImageIndex:= Loop;
      if not ShowItem then
         State:= State+[esosGhosted];
    end;
  end;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

procedure TFormMain.ELV_FixTitleClickAreaMulti(const DestListView: TEasyListView; IsTilesView: Boolean = True);
var
  Item: TEasyItem;
begin
  // this only works on TILES view mode!!!
  if not CheckTotal(DestListView) then
     Exit;
  Item:= DestListView.Groups.FirstItem;
  DestListView.BeginUpdate;
  repeat
    if IsTilesView then
       Item.Caption:= Format('%-38s', [Item.Caption])
    else
       Item.Caption:= TrimRight(Item.Caption);
    Item:= DestListView.Groups.NextItem(Item);
  until Item = nil;
  DestListView.EndUpdate(False);
end;

procedure TFormMain.ELV_ArcadeSystemsShortTitle(const DestListView: TEasyListView);
var
  Item: TEasyItem;
begin
  Item:= DestListView.Groups.FirstItem;
  DestListView.BeginUpdate;
  repeat
    Item.Caption:= GetArcadeSystemShortTitle(Item.ImageIndex);
    Item:= DestListView.Groups.NextItem(Item);
  until Item = nil;
  DestListView.EndUpdate;
end;

procedure TFormMain.ELV_PopulateSystemsMulti(const DestListView: TEasyListView; ShowDisabledMode: Integer; ShortTitle: Boolean; HideAllSystems: Boolean; UnavailableSystemsGhostedIcon: Boolean; AddSystemTypeLabel: Boolean = False);
var
  Loop: ShortInt;
  ShowItem: Boolean;
  SysHave: Boolean;
begin
  DestListView.BeginUpdate;
  DestListView.Items.ReIndexDisable:= True;

  // StateImageIndex
  // -1 > MAME/arcade;
  //  1..MaxConsoleComputerSystems -> console/computer "system ID" tag!!!

  // ImageIndex
  // 1..MaxArcadeSystems -> MAME/arcade "system ID" tag and icon indexes
  // MaxArcadeSystems+1+Loop -> console/computer icon indexes

  // ShowDisabledMode:
  // 0 -> show all systems, no matter if they are enabled or disabled
  // 1 -> check if system is available... IsSystemAvailable() function only checks for games list files, not emulator files...
  // 2 -> check if last played games files are available (for the MRU screen)

  for Loop:=1 to MaxConsoleComputerSystems do
  begin
    case ShowDisabledMode of
      0: SysHave:= True; // same as TRUE
      1: SysHave:= IsSystemAvailable(Loop, True); // validate games list only, emulator file is not included
      2: SysHave:= FormMain.ValidateFile(GetCustomGamePlayedFile(Loop));
    end;
    ShowItem:= SysHave;

    with DestListView.Items.Add do
    begin
      Caption:= SystemsListCustom[Loop, 0]; // EmuCon systems titles cannot be shortened yet!!!
      //case ShortTitle of
      //  True : Caption:= GetSystemShortTitle(Loop);
      //  False: Caption:= SystemsListCustom[Loop, 0];
      //end;
      ImageIndex:= MaxArcadeSystems+1+Loop;
      StateImageIndex:= Loop; // console/computer system tag
      if (not SysHave) and (DestListView.PaintInfoItem.CheckType <> ectNone) then
         Tag:= -1; // Tag -1 is for systems without games list... (disabled systems)

      if AddSystemTypeLabel then
         begin
           Captions[1]:= '      '+LowerCase(GetSystemTypeTitle(StateImageIndex, False));
           Details[1]:= 1;
         end;

      if not SysHave then
         begin
           if UnavailableSystemsGhostedIcon then
              State:= State+[esosGhosted]
           else
              Visible:= False;
         end;
    end;
  end;
  DestListView.Items.ReIndexDisable:= False;
  DestListView.Sort.SortAll;

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[56, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[39, 0]).Index); // Commodore 64 and 128

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[31, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[2, 0]).Index); // Game Boy Color and Game Boy Advance

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[48, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[5, 0]).Index); // Atari 400/800/XL and Atari 2600

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[65, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[3, 0]).Index); // Nintendo 8-bit and Nintendo 3DS

  DestListView.Items.Exchange(DestListView.Items.FindByCaption(SystemsListCustom[65, 0]).Index,
                              DestListView.Items.FindByCaption(SystemsListCustom[29, 0]).Index); // Nintendo 3DS and Nintendo DS


  DestListView.Items.ReIndexDisable:= True;

  for Loop:=MaxArcadeSystems downto 1 do
  begin
    case ShowDisabledMode of
      0: SysHave:= True; // same as TRUE
      1: SysHave:= IsSystemAvailable(Loop); // games list only... emulator files are no included
      2: SysHave:= FormMain.ValidateFile(GetGamesPlayedIniFile(Loop));
    end;
    ShowItem:= SysHave;

    with DestListView.Items.Insert(0) do
    begin
      Caption:= GetArcadeSystemShortTitle(Loop);
      //case ShortTitle of // cannot show full system title here as it doesn't fit in icon/thumbnail view mode, maybe in the future (February 28, 2018)
      //  True : Caption:= GetSystemShortTitle(Loop);
      //  False: Caption:= GetEmulatorDescription(Loop);
      //end;
      ImageIndex:= Loop;
      StateImageIndex:= -1; // MAME/arcade tag
      if (not SysHave) and (DestListView.PaintInfoItem.CheckType <> ectNone) then
         Tag:= -1; // Tag -1 is for systems without games list... (disabled systems)

      if AddSystemTypeLabel then
         begin
           Captions[1]:= '      '+LowerCase(GetSystemTypeTitle(ImageIndex, True));
           Details[1]:= 1;
         end;

      if not SysHave then
         begin
           if UnavailableSystemsGhostedIcon then
              State:= State+[esosGhosted]
           else
              Visible:= False;
         end;
    end;
  end;

  if not HideAllSystems then
     begin
       with DestListView.Items.Insert(0) do
       begin
         Caption:= 'All Console / Computer / Handheld Systems';
         ImageIndex:= MaxArcadeSystems+1;
         Bold:= False;
         StateImageIndex:= 0;
         if AddSystemTypeLabel then
            begin
              Captions[1]:= '';
              Details[1]:= 1;
            end;
         //if not ShowItem then
         //   State:= State+[esosGhosted]; // why show ghosted icon here ?
       end;
       with DestListView.Items.Insert(0) do
       begin
         Caption:= 'All Arcade Systems';
         ImageIndex:= 0;
         Bold:= False;
         StateImageIndex:= -1; // MAME/arcade tag
         if AddSystemTypeLabel then
            begin
              Captions[1]:= '';
              Details[1]:= 1;
            end;
         //if not ShowItem then
         //   State:= State+[esosGhosted]; // why show ghosted icon here ?
       end;
     end;

  DestListView.Items.ReIndexDisable:= False;
  DestListView.EndUpdate;
end;

function TFormMain.ELV_GetSystemTagMulti(ELV_Holder: TEasyListView): Integer;
var
  selItem: TEasyItem;
begin
  Result:= -1;
  if CheckSelected(ELV_Holder) then
     begin
       selItem:= ELV_Holder.Selection.First;
       if ELV_IsArcadeSystemMulti(selItem) then
          Result:= selItem.ImageIndex // arcade system
       else
          Result:= selItem.StateImageIndex; // console/computer system (EmuCon)
     end;
end;

