procedure TFormMain.ReloadCustomSystemsMAMESoftLists;
var
  SoftListCustomSystems: array[1..MaxConsoleComputerSystems] of THashedStringList;
  iCatFile: TMemIniFile;
  Group: TEasyGroup;
  Item: TEasyItem;
  Loop: Integer;
  tStr: String;

  function GetSoftListCustomSystemID(const SoftwareName: String): Integer;
  var
    iSoftLoop: Integer;
  begin
    Result:= -1;
    for iSoftLoop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
    begin
      Result:= SoftListCustomSystems[iSoftLoop].IndexOf(SoftwareName);
      if Result <> -1 then
         begin
           TEasyGameInfo(Item).eCustomSystemID:= iSoftLoop;
           Break;
         end;
    end;
  end;

  function SearchCustomData: Boolean;
  begin
    Result:= (TEasyGameInfo(Item).eSystemID = idMAME) and (TEasyGameInfo(Item).eSoftwareName <> '');
    if not Result then
       Exit;
    TEasyGameInfo(Item).eCustomSystemID:= -1; // reset to "none"
    GetSoftListCustomSystemID(TEasyGameInfo(Item).eSoftwareName);
    TEasyGameInfo(Item).eCustomMediaType:= GetCustomMediaTypeID(TEasyGameInfo(Item).eSoftwareExecParameter);
  end;
  
begin
  if not CheckTotal(GamesListView) then
     Exit;

  for Loop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
      SoftListCustomSystems[Loop]:= THashedStringList.Create;
  tStr:= GetSystemsSoftwareListFile(idMAME);//, FormMain.EmulatorFile[idMAME]);
  if FileExists(tStr) then
     begin
       iCatFile:= TMemIniFile.Create(tStr);
       for Loop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
           iCatFile.ReadSectionValues(SystemsListCustom[Loop, 0], SoftListCustomSystems[Loop]);
       FreeAndNil(iCatFile);
     end;

  GamesListView.BeginUpdate;
  GamesListView.Items.ReIndexDisable:= True;

  if IsGroupedView then
    begin
      Group:= GamesListView.Groups.FirstGroup;
      repeat
        if (TGroupInfo(Group).eSystemID = idMAME) and (TGroupInfo(Group).eSoftwareName = '') then
        begin
          Item:= GamesListView.Groups.FirstInGroup(Group);
          repeat
            SearchCustomData;
            Item:= GamesListView.Groups.NextInGroup(Group, Item);
          until Item = nil;
        end;
        Group:= GamesListView.Groups.NextGroup(Group);
      until Group = nil;
    end
    else
    begin
      Item:= GamesListView.Groups.FirstItem;
      repeat
        SearchCustomData;
        Item:= GamesListView.Groups.NextItem(Item);
      until Item = nil;
    end;

  GamesListView.Items.ReIndexDisable:= False;
  GamesListView.EndUpdate(False);

  for Loop:= Low(SoftListCustomSystems) to High(SoftListCustomSystems) do
      FreeAndNil(SoftListCustomSystems[Loop]);
end;

procedure TFormMain.LoadListCPU(BoxHolder: TComboBox);
var
  ListCPU, SortedList: THashedStringList;
  Loop: Integer;
  tmpString, StrCPU: String;
begin
  if not FileExists(GetIniFilesFolder+'cpu.ini') then
     Exit;
  ListCPU:= THashedStringList.Create;
  ListCPU.LoadFromFile(GetIniFilesFolder+'cpu.ini');
  SortedList:= THashedStringList.Create;
  SortedList.BeginUpdate;
  for Loop:=0 to ListCPU.Count-1 do
  begin
    tmpString:= ListCPU[Loop];
    if (tmpString <> '') and (tmpString[1] <> '[') then
       begin
         StrCPU:= ListCPU.ValueFromIndex[Loop];
         if SortedList.IndexOf(StrCPU) = -1 then
            SortedList.Add(StrCPU);
       end;

  end;
  SortedList.Sort;
  SortedList.EndUpdate;
  FreeAndNil(ListCPU);
  if SortedList.Count > 0 then
     begin
       BoxHolder.Items.BeginUpdate;
       BoxHolder.Clear;
       BoxHolder.Items.Add('[None]');
       BoxHolder.Items.AddStrings(SortedList);
       BoxHolder.Items.EndUpdate;
       BoxHolder.ItemIndex:= 0;

     end;
  FreeAndNil(SortedList);
end;

{procedure ComboBox_AutoWidth(const theComboBox: TCombobox);
const
  HORIZONTAL_PADDING = 4;
var
  itemsFullWidth: integer;
  idx: integer;
  itemWidth: integer;
begin
  itemsFullWidth := 0;

  // get the max needed with of the items in dropdown state
  for idx := 0 to -1 + theComboBox.Items.Count do
  begin
    itemWidth := theComboBox.Canvas.TextWidth(theComboBox.Items[idx]);
    Inc(itemWidth, 2 * HORIZONTAL_PADDING);
    if (itemWidth > itemsFullWidth) then itemsFullWidth := itemWidth;
  end;

  // set the width of drop down if needed
  if (itemsFullWidth > theComboBox.Width) then
  begin
    //check if there would be a scroll bar
    if theComboBox.DropDownCount < theComboBox.Items.Count then
      itemsFullWidth := itemsFullWidth + GetSystemMetrics(SM_CXVSCROLL);

    SendMessage(theComboBox.Handle, CB_SETDROPPEDWIDTH, itemsFullWidth, 0);
  end;
end;}

