procedure TFormMain.MenuValidateMAMECHDTypesClick(Sender: TObject);
var
  Loop: Integer;
  FileLine, tempFile: String;
  ListXML, NewControlTypes, ctype, waysList: THashedStringList;
  CheckControl: Boolean;
begin
  if GenerateMessage('INFO', 'Search new control types.',
                     '   MAME''s -listxml output will scan the control type entries.'+
                     ' If there are new control types, '+
                     'they will be listed after this process is finished.'+#13#10+#13#10+
                     'Continue ?', 1) = mrNo then
     Exit;

  if not Assigned(ControlType) then
     Exit;
  CheckControl:= Assigned(ControlType);

  tempFile:= 'D:\emulators\mame\binary\listxml0176.xml';// GetGamesFolderEL+'mame_listxml.xml';
  if not ValidateFile(tempFile) then
     Exit;
  FormStatus.TitleStr('Search New CHD Media And Control Types');
  FormStatus.MessageStr('Loading "'+tempFile+'" file.', False);
  if not FormStatus.Visible then
     FormStatus.Show;
  FormStatus.StartThreadClock;
  SetCurrentDir(FrontendPath);
  FileLine:= '';

  if FormMain.Visible then
     FormMain.Refresh;

  FormStatus.SetFocus;

  if not ValidateFile(tempFile) then
     begin
       FormStatus.Close;
       Exit;
     end;

  FormStatus.MessageStr('Parsing "'+tempFile+'".'+#13#10+
                          'Checking all "<control type" entries.');

  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(tempFile);
  if CheckControl then
     begin
       NewControlTypes:= THashedStringList.Create;
       NewControlTypes.BeginUpdate;
       NewControlTypes.Sorted:= True;
       NewControlTypes.Duplicates:= dupIgnore;
     end;

  ctype:= THashedStringList.Create;
  ctype.BeginUpdate;
  ctype.Sorted:= True;
  ctype.Duplicates:= dupIgnore;

  waysList:= THashedStringList.Create;
  waysList.BeginUpdate;
  waysList.Sorted:= True;
  waysList.Duplicates:= dupIgnore;

  for Loop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[Loop]);
      if XML_CheckData(FileLine, '<control ') then
         begin
           if CheckControl then
              begin
                tempFile:= XML_GetEntryValue(FileLine, 'type');
                ctype.Add(tempFile);
                if tempFile <> '' then
                   begin
                     if ControlType.IndexOfName(tempFile) = -1 then
                        NewControlTypes.Add(tempFile);
                   end;

                tempFile:= XML_GetEntryValue(FileLine, 'ways');
                waysList.Add(tempFile);
                tempFile:= XML_GetEntryValue(FileLine, 'ways2');
                waysList.Add(tempFile);
                tempFile:= XML_GetEntryValue(FileLine, 'ways3');
                waysList.Add(tempFile);
              end;
         end;
    end;

  if CheckControl then
     NewControlTypes.EndUpdate;

  ctype.EndUpdate;
  waysList.EndUpdate;
  FreeAndNil(ListXML);
  DeleteFile(FrontendPath+'temp\'+tempFile);
  FormStatus.Close;

  ctype.SaveToFile('d:\EmuLoader\controltype_new.ini');
  waysList.SaveToFile('d:\EmuLoader\controltype_ways_new.ini');
  FreeAndNil(ctype);
  FreeAndNil(waysList);
  if CheckControl then
     begin
       if NewControlTypes.Count > 0 then
          begin
            GenerateMessage('INFO', 'New control type(s) found.',
                            'Copy the following list and enter descriptions into "arcade\mame_control_type.ini" '+
                            'file.'+#13#10+#13#10+
                             NewControlTypes.Text, 2);
          end;
     end;
  if CheckControl then
     FreeAndNil(NewControlTypes);
  SetCurrentDir(FrontendPath);
end;

