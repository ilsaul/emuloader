procedure TFormMain.ELV_SetSelectRibbon(State: ShortInt; EasyListViewHolder: TEasyListView; ForceUpdate: Boolean = False);
begin
  // state:
  //   0 -> game OK
  //   1 -> missing ROMs/CHDs
  //   2 -> missing (no ROMs found)
  if State = 2 then
     State:= 0; // reset since the selection ribbon for missing games is the same as "game OK"
  if (State = EasyListViewHolder.HelpContext) and (not ForceUpdate) then
     Exit;

  EasyListViewHolder.HelpContext:= State;
  EasyListViewHolder.Selection.Color:= ListSelectionColors[3, State];
  EasyListViewHolder.Selection.GradientColorTop:= ListSelectionColors[1, State];
  EasyListViewHolder.Selection.GradientColorBottom:= ListSelectionColors[2, State];
  EasyListViewHolder.Selection.BorderColor:= ListSelectionColors[3, State];
