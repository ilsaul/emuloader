{
// future improvement, multiple images paths support, using TStringList array instead of a simple String array (July 29, 2018)
function TFormMain.SearchImgZipFileArcade(sysID, ImageCategoryIndex: Integer; IsSoftwareListFile: Boolean; ReturnPathOnly: Boolean = False): String;
var
  iLoop: Integer;
  iFolderStr, iFile: String;
begin
  Result:= '';
  if not Assigned(imgFolderArcade[sysID, ImageCategoryIndex]) then
     Exit;

  if imgFolderArcade[sysID, ImageCategoryIndex].Count > 0 then
     begin
       for iLoop:=0 to imgFolderArcade[sysID, ImageCategoryIndex].Count-1 do
       begin
         iFolderStr:= imgFolderArcade[sysID, ImageCategoryIndex].Strings[iLoop];
         iFolderStr:= FullEmuFolderFix(imgFolderArcade[sysID, ImageCategoryIndex].Strings[iLoop], sysID, False);

         case IsSoftwareListFile of
           True : iFile:= GetImgZipFileName_SL(ImageCategoryIndex);
           False: iFile:= GetImgZipFileName(ImageCategoryIndex);
         end;
         if FileExistsW(iFolderStr+iFile) then
            begin
              case ReturnPathOnly of
                True : Result:= iFolderStr;
                False: Result:= iFolderStr+iFile;
              end;
              Break;
            end;
       end;
     end;
end;
}

procedure TFormMain.LoadScreenshot(ScreenIndex: ShortInt);
var
  ImageToSearch: packed array[1..MaxImagePanels] of WideString;

  Folder, FolderSnapEmuCon, ImageExt, ExtraFolderStrMAME,
  CurrentImageZip, NoImageFile, SoftwareNameString: packed array[1..MaxImagePanels] of String;
  ImageName, ImageParentName: packed array[1..MaxImagePanels] of WideString;
  FoundImage, FoundInSoftListZipFile, FoundInSoftListZipFile_SL, FoundZipCustomGameInSnapDir, ContinueImg: packed array[1..MaxImagePanels] of Boolean;
  ImageTypeDetected: packed array[1..MaxImagePanels] of TImageType;
  CurrentSystemID, CurrentImageCategoryID, CurrentCustomSystemID: packed array[1..MaxImagePanels] of Integer;
  iImageTag: packed array[1..MaxImagePanels] of Integer;
  NewMAMESnapName, NewMAMESnapCloneName: array[1..MaxImagePanels] of String; // for "gamename\0000.png"
  //iDirectoryLoop: array[1..MaxImagePanels] of Integer;
  //iLoopMAME1, iLoopMAME2, iLoopMAME3, iLoopMAME4: Integer;

  function FixBlendMode: Boolean;
  begin
    Result:= True;
    if ScreenIndex = 1 then
       begin
         if Images.Bitmap.DrawMode <> dmBlend then
            Images.Bitmap.DrawMode:= dmBlend;
       end
    else
       begin
         if ImageScr[ScreenIndex].Bitmap.DrawMode <> dmBlend then
            ImageScr[ScreenIndex].Bitmap.DrawMode:= dmBlend;
       end;
  end;

  function LoadImageFromStream(var ImageHolder: TImage32): Boolean;
  var
    pngImg: array[1..MaxImagePanels] of TPNGGraphic;
    jpgImg: array[1..MaxImagePanels] of TJPEGImage;
    gifImg: array[1..MaxImagePanels] of TGIFGraphic;
    bmpImg: array[1..MaxImagePanels] of TBitmap;
  begin
    Result:= True;
    if FileStream[ScreenIndex].Size = 0 then
       Exit;

    ImageTypeDetected[ScreenIndex]:= GetImageType(FileStream[ScreenIndex], ScreenIndex);
    ImageHolder.Canvas.Lock;
    try
      case ImageTypeDetected[ScreenIndex] of
        ifPNG:
          begin
            ImageDetails[ScreenIndex].ImageType:= 'PNG';
            pngImg[ScreenIndex]:= TPNGGraphic.Create;
            pngImg[ScreenIndex].LoadFromStream(FileStream[ScreenIndex]);
            ImageHolder.Bitmap.Assign(pngImg[ScreenIndex]);
            FreeAndNil(pngImg[ScreenIndex]);
          end;
        ifJPG:
          begin
            ImageDetails[ScreenIndex].ImageType:= 'JPG';
            jpgImg[ScreenIndex]:= TJPEGImage.Create;
            jpgImg[ScreenIndex].LoadFromStream(FileStream[ScreenIndex]);
            ImageHolder.Bitmap.Assign(jpgImg[ScreenIndex]);
            FreeandNil(jpgImg[ScreenIndex]);
          end;
        ifGIF:
           begin
             ImageDetails[ScreenIndex].ImageType:= 'GIF';
             gifImg[ScreenIndex]:= TGIFGraphic.Create;
             gifImg[ScreenIndex].LoadFromStream(FileStream[ScreenIndex]);
             ImageHolder.Bitmap.Assign(gifImg[ScreenIndex]);
             FreeAndNil(gifImg[ScreenIndex]);
           end;
         ifBMP:
           begin
             ImageDetails[ScreenIndex].ImageType:= 'BMP';
             bmpImg[ScreenIndex]:= TBitmap.Create;
             bmpImg[ScreenIndex].LoadFromStream(FileStream[ScreenIndex]);
             ImageHolder.Bitmap.Assign(bmpImg[ScreenIndex]);
             FreeAndNil(bmpImg[ScreenIndex]);
           end;
      end;
    except
      ImageDetails[ScreenIndex].ImageType:= '';
      ImageHolder.Bitmap:= nil; // ensures that there's no image loaded
      Result:= False;
    end;
    ImageHolder.Canvas.Unlock;
    FileStream[ScreenIndex].Clear;
  end;

  function LoadZippedImage(var ZipForgeHolder: TZipForge): Boolean;
  var
    zFile: array[1..MaxImagePanels] of String;

    function FindZipFile: Boolean;
    var
      iLoopScr1, iLoopScr2, iLoopScr3, iLoopScr4: Integer;
    begin
      if (not MemGameInfo.eIsCustomGame) and IsMAMEBasedSys(MemGameInfo.eSystemID) then
      begin
        Result:= True;
        case ScreenIndex of
         1:
           begin
             if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
             for iLoopScr1:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
             begin
               Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopScr1];
               Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
               ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+zFile[ScreenIndex]);
               if ContinueImg[ScreenIndex] then
                  Break;
             end;
           end;
         2:
           begin
             if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
             for iLoopScr2:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
             begin
               Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopScr2];
               Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
               ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+zFile[ScreenIndex]);
               if ContinueImg[ScreenIndex] then
                  Break;
             end;
           end;
         3:
           begin
             if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
             for iLoopScr3:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
             begin
               Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopScr3];
               Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
               ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+zFile[ScreenIndex]);
               if ContinueImg[ScreenIndex] then
                  Break;
             end;
           end;
         4:
           begin
             if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
             for iLoopScr4:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
             begin

               begin
               Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopScr4];
               Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
               ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+zFile[ScreenIndex]);
               if ContinueImg[ScreenIndex] then
                  Break;
               end;
             end;
           end;
       end;
      end
      else
      begin
        ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+zFile[ScreenIndex]);
      end;
    end;

  begin
    FixBlendMode;
    //must create a loop to go thru all image folders, for MAME/HBMAME. All other systems will use a single folder
    case FoundInSoftListZipFile[ScreenIndex] of
      True:
        begin
          zFile[ScreenIndex]:= ImageDetails[ScreenIndex].SoftwareName+'.zip'; // search "snap\softlist.zip"
          FindZipFile;
          if not ContinueImg[ScreenIndex] then
             begin
               // search "snap\softwarename\softlist.zip"
               zFile[ScreenIndex]:= ImageDetails[ScreenIndex].SoftwareName+'\'+ImageDetails[ScreenIndex].SoftwareName+'.zip';
               FindZipFile;
             end;
        end;
      False:
        begin
          case FoundInSoftListZipFile_SL[ScreenIndex] of
            True:
              begin
                zFile[ScreenIndex]:= GetImgZipFileName_SL(ImageDetails[ScreenIndex].ImageCategoryIndex); // search "snap\snap_sl.zip"
                FindZipFile;
              end;
            False:
              begin
                // fallback to snap.zip
                zFile[ScreenIndex]:= GetImgZipFileName(ImageDetails[ScreenIndex].ImageCategoryIndex);
                if MemGameInfo.eIsCustomGame then
                   begin
                     if (ImageDetails[ScreenIndex].ImageCategoryIndex <> 1) and (FolderSnapEmuCon[ScreenIndex] <> '') then
                        begin
                          // search titles.zip; covers.zip; flyers.zip... any other .zip file in "in-game snap dir"
                          ContinueImg[ScreenIndex]:= FileExists(FolderSnapEmuCon[ScreenIndex]+zFile[ScreenIndex]);
                          if ContinueImg[ScreenIndex] then
                             FoundZipCustomGameInSnapDir[ScreenIndex]:= True;
                        end
                     else
                        FoundZipCustomGameInSnapDir[ScreenIndex]:= False;

                     if not FoundZipCustomGameInSnapDir[ScreenIndex] then
                        ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+zFile[ScreenIndex]);
                   end;
              end;
          end;
        end;
    end;

    if not ContinueImg[ScreenIndex] then
       Exit;

    if ImageDetails[ScreenIndex].FileName = '' then
       Exit;

    if not Assigned(ZipForgeHolder) then
       ZipForgeHolder:= TZipForge.Create(nil);
    if not Assigned(FileStream[ScreenIndex]) then
       FileStream[ScreenIndex]:= TWideMemoryStream.Create;
    with ZipForgeHolder do
    begin
      case FoundZipCustomGameInSnapDir[ScreenIndex] of
        True : FileName:= FolderSnapEmuCon[ScreenIndex]+zFile[ScreenIndex]; // use "snapdir\titles.zip"; "snapdir\covers.zip" (for EmuCon games only)
        False: FileName:= Folder[ScreenIndex]+zFile[ScreenIndex]; // use "imgcatdir\titles.zip"; "imgcatdir\covers.zip"
      end;

      try
        // Open existing archive file
        OpenArchive(fmOpenRead or fmShareDenyNone);
        ExtractToStream(ImageDetails[ScreenIndex].FileName, FileStream[ScreenIndex]);
      except
        ContinueImg[ScreenIndex]:= False;
        CloseArchive;
        FileName:= '';
        FormMain.FileStream[ScreenIndex].Clear;
        Exit;
      end;
      CloseArchive;
      FileName:= '';
    end;

    if ScreenIndex = 1 then
       LoadImageFromStream(Images)
    else
       LoadImageFromStream(ImageScr[ScreenIndex]);

    ImageDetails[ScreenIndex].IsZipped:= ContinueImg[ScreenIndex];
  end;

  function LoadUnzippedImage: Boolean;
  begin
    Result:= True;
    ContinueImg[ScreenIndex]:= True;
    try
      FixBlendMode;
      if not Assigned(FileStream[ScreenIndex]) then
         FileStream[ScreenIndex]:= TWideMemoryStream.Create;

      FileStream[ScreenIndex].LoadFromFile(ImageDetails[ScreenIndex].FileName);

      if ScreenIndex = 1 then
         LoadImageFromStream(Images)
      else
         LoadImageFromStream(ImageScr[ScreenIndex]);
    except
      Result:= False;
      ContinueImg[ScreenIndex]:= False;
    end;
  end;

  function LoadNotAvailableImg: Boolean;
  begin
    Result:= True;
    NoImageFile[ScreenIndex]:= GetFolderFull(35, MemGameInfo.eSystemID)+'emuloader.png';
    ClearImageInfo(ScreenIndex);
    if FileExists(NoImageFile[ScreenIndex]) then
       begin
         FixBlendMode;
         if not Assigned(FileStream[ScreenIndex]) then
            FileStream[ScreenIndex]:= TWideMemoryStream.Create;

         FileStream[ScreenIndex].LoadFromFile(NoImageFile[ScreenIndex]);
         if ScreenIndex = 1 then
            LoadImageFromStream(Images)
         else
            LoadImageFromStream(ImageScr[ScreenIndex]);

         ImageDetails[ScreenIndex].PrevNoImageLoaded:= True;
       end
    else
       begin
         ImageDetails[ScreenIndex].NoImageLoaded:= False;
         ImageDetails[ScreenIndex].PrevNoImageLoaded:= False;
         ClearScreenshot(ScreenIndex);
         ClearImageInfo(ScreenIndex);
       end;
  end;

  function SearchImageFile(IsNewImageNamingMAME: Boolean; const NameString: WideString; SearchInZip: Boolean = False): Boolean;

    function FindUnzippedImage(FullImageName: WideString): Boolean;
    var
      iLoopMAME1, iLoopMAME2, iLoopMAME3, iLoopMAME4: Integer; // for unzipped images only, MAME/HBMAME only
      iNameSearch: array[1..MaxImagePanels] of WideString;     // for unzipped images only, MAME/HBMAME only
    begin
      Result:= True;
      iNameSearch[ScreenIndex]:= FullImageName;
      if (not MemGameInfo.eIsCustomGame) and (IsMAMEBasedSys(MemGameInfo.eSystemID)) then
         begin
           case ScreenIndex of
             1:
               begin
                 if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
                 for iLoopMAME1:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
                 begin
                   Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopMAME1];
                   Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
                   ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+iNameSearch[ScreenIndex]);
                   if ContinueImg[ScreenIndex] then
                      Break;
                 end;
               end;
             2:
               begin
                 if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
                 for iLoopMAME2:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
                 begin
                   Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopMAME2];
                   Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
                   ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+iNameSearch[ScreenIndex]);
                   if ContinueImg[ScreenIndex] then
                      Break;
                 end;
               end;
             3:
               begin
                 if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
                 for iLoopMAME3:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
                 begin
                   Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopMAME3];
                   Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
                   ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+iNameSearch[ScreenIndex]);
                   if ContinueImg[ScreenIndex] then
                      Break;
                 end;
               end;
             4:
               begin
                 if imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex] <> nil then
                 for iLoopMAME4:=0 to imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Count-1 do
                 begin
                   Folder[ScreenIndex]:= imgFolderMAME[Ord(MemGameInfo.eSystemID <> idMAME)+1, ImageDetails[ScreenIndex].ImageCategoryIndex].Strings[iLoopMAME4];
                   Folder[ScreenIndex]:= FullEmuFolderFix(Folder[ScreenIndex], MemGameInfo.eSystemID, True); // for zipped images
                   ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+iNameSearch[ScreenIndex]);
                   if ContinueImg[ScreenIndex] then
                      Break;
                 end;
               end;
           end;
         end
      else
         begin
           ContinueImg[ScreenIndex]:= FileExists(Folder[ScreenIndex]+iNameSearch[ScreenIndex]);
         end;
    end;

  begin
    ImageExt[ScreenIndex]:= '.png';
    ImageToSearch[ScreenIndex]:= NameString;
    case SearchInZip of
      True:
        begin
          case MemGameInfo.eIsCustomGame of
            True:
              begin
                ContinueImg[ScreenIndex]:= not MemGameInfo.eIsUnicode;
                if not ContinueImg[ScreenIndex] then
                   Exit;
                ContinueImg[ScreenIndex]:= Assigned(imgZipFileListConsComp[MemGameInfo.eCustomSystemID, ImageDetails[ScreenIndex].ImageCategoryIndex]);
                if not ContinueImg[ScreenIndex] then
                   Exit;
                ContinueImg[ScreenIndex]:= imgZipFileListConsComp[MemGameInfo.eCustomSystemID, ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf(ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                if not ContinueImg[ScreenIndex] then
                   begin
                     ImageExt[ScreenIndex]:= '.jpg';
                     ContinueImg[ScreenIndex]:= imgZipFileListConsComp[MemGameInfo.eCustomSystemID, ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf(ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                   end;
                if ContinueImg[ScreenIndex] then
                   begin
                     ImageDetails[ScreenIndex].FileName:= ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex];
                     ImageDetails[ScreenIndex].IsZipped:= True;
                   end;
              end;
            False:
              begin
                ContinueImg[ScreenIndex]:= (SoftwareNameString[ScreenIndex] <> '') and (ImageSoftNameIndex <> -1);
                if ContinueImg[ScreenIndex] then
                   begin
                     ContinueImg[ScreenIndex]:= Assigned(ImgZipFileSoftList[ImageSoftNameIndex, ImageDetails[ScreenIndex].ImageCategoryIndex]);
                     if ContinueImg[ScreenIndex] then
                     begin
                       ContinueImg[ScreenIndex]:= ImgZipFileSoftList[ImageSoftNameIndex, ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf(ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                       if not ContinueImg[ScreenIndex] then
                          begin
                            if (not ImagesPNGOnly(ImageDetails[ScreenIndex].ImageCategoryIndex)) then
                               begin
                                 ImageExt[ScreenIndex]:= '.jpg';
                                 ContinueImg[ScreenIndex]:= ImgZipFileSoftList[ImageSoftNameIndex, ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf({NameString}ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                               end;
                          end;
                       if ContinueImg[ScreenIndex] then
                          begin
                            ImageDetails[ScreenIndex].FileName:= ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex];
                            FoundInSoftListZipFile[ScreenIndex]:= True;
                          end;
                     end;
                   end;

                // not found in "snap\softlistname.zip" or "snap\softlistname\softlistname.zip"
                // if it's a MAME software list game, try to locate in "snap\snap_sl.zip"
                if not ContinueImg[ScreenIndex] then
                   begin
                     if SoftwareNameString[ScreenIndex] <> '' then
                     begin
                       if Assigned(ImgZipFileSoftList_SL[ImageDetails[ScreenIndex].ImageCategoryIndex]) then
                       begin
                         ContinueImg[ScreenIndex]:= ImgZipFileSoftList_SL[ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf(SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                         if not ContinueImg[ScreenIndex] then
                         begin
                           if (not ImagesPNGOnly(ImageDetails[ScreenIndex].ImageCategoryIndex)) then
                              begin
                                ImageExt[ScreenIndex]:= '.jpg';
                                ContinueImg[ScreenIndex]:= ImgZipFileSoftList_SL[ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf(SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                              end;
                         end;
                       end;
                       if ContinueImg[ScreenIndex] then
                          begin
                            ImageDetails[ScreenIndex].FileName:= SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]; // it must be "softlistname\gamename.???"
                            FoundInSoftListZipFile_SL[ScreenIndex]:= True;
                          end;
                     end;
                   end;

                // not found in "snap\softlistname.zip" or "snap\softlistname\softlistname.zip" or "snap\snap_sl.zip", fallback to "snap\snap.zip"
                if not ContinueImg[ScreenIndex] then
                   begin
                     ContinueImg[ScreenIndex]:= Assigned(imgZipFileList[MemGameInfo.eSystemID, ImageDetails[ScreenIndex].ImageCategoryIndex]);
                     if not ContinueImg[ScreenIndex] then
                        Exit;

                     ContinueImg[ScreenIndex]:= imgZipFileList[MemGameInfo.eSystemID, ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf(SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                     if not ContinueImg[ScreenIndex] then
                        begin
                          if (not ImagesPNGOnly(ImageDetails[ScreenIndex].ImageCategoryIndex)) then
                              begin
                                ImageExt[ScreenIndex]:= '.jpg';
                                ContinueImg[ScreenIndex]:= imgZipFileList[MemGameInfo.eSystemID, ImageDetails[ScreenIndex].ImageCategoryIndex].IndexOf(SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]) <> -1;
                              end;
                        end;
                     if ContinueImg[ScreenIndex] then
                        ImageDetails[ScreenIndex].FileName:= SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex];
                   end;

                if ContinueImg[ScreenIndex] then
                   ImageDetails[ScreenIndex].IsZipped:= True;
              end;
          end;
        end;
      False:
        begin
          case MemGameInfo.eIsCustomGame of
            True:
              begin
                ExtraFolderStrMAME[ScreenIndex]:= '';
                ContinueImg[ScreenIndex]:= FileExistsW(Folder[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);
                if not ContinueImg[ScreenIndex] then
                   begin
                     // check image extra folder
                     ContinueImg[ScreenIndex]:= FileExistsW(Folder[ScreenIndex]+
                                         ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 2]+'\'+
                                         ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);
                     if ContinueImg[ScreenIndex] then
                        ExtraFolderStrMAME[ScreenIndex]:= ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 2]+'\';
                   end;

                if not ContinueImg[ScreenIndex] then
                   begin
                     ImageExt[ScreenIndex]:= '.jpg';
                     ContinueImg[ScreenIndex]:= FileExistsW(Folder[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);
                     if not ContinueImg[ScreenIndex] then
                        begin
                          // check image extra folder
                          ContinueImg[ScreenIndex]:= FileExistsW(Folder[ScreenIndex]+
                                              ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 2]+'\'+
                                              ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);
                          if ContinueImg[ScreenIndex] then
                             ExtraFolderStrMAME[ScreenIndex]:= ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 2]+'\';
                        end;

                   end;

                if ContinueImg[ScreenIndex] then
                   begin
                     ImageDetails[ScreenIndex].FileName:= Folder[ScreenIndex]+ExtraFolderStrMAME[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex];
                     ImageDetails[ScreenIndex].IsZipped:= False;
                   end;
              end;
            False:
              begin
                // SearchUnzippedFile(IsNewImageNamingMAME, NameString); // mulitple image paths support, for future improvement, MAYBE! (July 29, 2018)
                FindUnzippedImage(SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);
                ExtraFolderStrMAME[ScreenIndex]:= '';
                if (not ContinueImg[ScreenIndex]) then
                   begin
                     FindUnzippedImage(ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 3]+'\'+
                                       SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);
                     if ContinueImg[ScreenIndex] then
                        ExtraFolderStrMAME[ScreenIndex]:= ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 3]+'\';
                   end;

                if not ContinueImg[ScreenIndex] then
                   begin
                     if (not ImagesPNGOnly(ImageDetails[ScreenIndex].ImageCategoryIndex)) then
                        begin
                          ImageExt[ScreenIndex]:= '.jpg';
                          FindUnzippedImage(SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);
                          if (not ContinueImg[ScreenIndex]) then
                             begin
                               FindUnzippedImage(ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 3]+'\'+
                                                 SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex]);

                               if ContinueImg[ScreenIndex] then
                                  ExtraFolderStrMAME[ScreenIndex]:= ImageCategoryArray[ImageDetails[ScreenIndex].ImageCategoryIndex, 3]+'\';
                             end;
                        end;
                   end;
                if ContinueImg[ScreenIndex] then
                   begin
                     ImageDetails[ScreenIndex].FileName:= Folder[ScreenIndex]+ExtraFolderStrMAME[ScreenIndex]+SoftwareNameString[ScreenIndex]+ImageToSearch[ScreenIndex]+ImageExt[ScreenIndex];
                     ImageDetails[ScreenIndex].IsZipped:= False;
                   end;
              end;
          end;
        end;
    end;
  end;

  function GetImageFileName(SearchInZip: Boolean = False): Boolean;
  begin
    SearchImageFile(False, ImageName[ScreenIndex], SearchInZip);
    if not MemGameInfo.eIsCustomGame then
    begin
      if (not ContinueImg[ScreenIndex]) and (not SearchInZip) and (ImageDetails[ScreenIndex].ImageCategoryIndex in [1]) then
         begin
           if NewMAMESnapName[ScreenIndex] = '' then
              NewMAMESnapName[ScreenIndex]:= GetImageName(MemGameInfo.eName, iImageTag[ScreenIndex], 1);
           SearchImageFile(True, NewMAMESnapName[ScreenIndex], SearchInZip);
          end;

      if (not ContinueImg[ScreenIndex]) and PopupImageDisplayParent.Checked then
         begin
           if GameIsClone(MemGameInfo.eClone) then
              begin
                if ImageParentName[ScreenIndex] = '' then
                   ImageParentName[ScreenIndex]:= GetImageName(MemGameInfo.eClone, iImageTag[ScreenIndex], 0);
                SearchImageFile(False, ImageParentName[ScreenIndex], SearchInZip);

                if (not ContinueImg[ScreenIndex]) and (not SearchInZip) and (ImageDetails[ScreenIndex].ImageCategoryIndex in [1]) then
                   begin
                     if NewMAMESnapCloneName[ScreenIndex] = '' then
                        NewMAMESnapCloneName[ScreenIndex]:= GetImageName(MemGameInfo.eClone, iImageTag[ScreenIndex], 1);
                     SearchImageFile(False, NewMAMESnapCloneName[ScreenIndex], SearchInZip);
                   end;
              end;
         end;
    end;
    FoundImage[ScreenIndex]:= ContinueImg[ScreenIndex];

    if ImageDetails[ScreenIndex].NoImageLoaded then
       ImageDetails[ScreenIndex].NoImageLoaded:= not ContinueImg[ScreenIndex]
    else
       begin
         if iImageTag[ScreenIndex] = 1 then
            ImageDetails[ScreenIndex].NoImageLoaded:= not ContinueImg[ScreenIndex]
         else
         begin
           ImageDetails[ScreenIndex].NoImageLoaded:= False;
         end;
       end;

    if ContinueImg[ScreenIndex] then // image found
       begin
         ImageDetails[ScreenIndex].PrevNoImageLoaded:= False;
       end;
  end;

begin
  // start of LoadScreenshot() code
  UnzipActive[ScreenIndex]:= True;
  FoundImage[ScreenIndex]:= False;
  FoundInSoftListZipFile[ScreenIndex]:= False;
  FoundInSoftListZipFile_SL[ScreenIndex]:= False; // for MAME software lists only
  FoundZipCustomGameInSnapDir[ScreenIndex]:= False; // for EmuCon games only

  ImageDetails[ScreenIndex].SoftwareName:= MemGameInfo.eSoftwareName;

  SoftwareNameString[ScreenIndex]:= ImageSoftwareName;
  ImageDetails[ScreenIndex].NewImageLoaded:= False;

  FolderSnapEmuCon[ScreenIndex]:= '';
  case MemGameInfo.eIsCustomGame of
    True:
      begin
        Folder[ScreenIndex]:= FullFolderFix(SnapshotFolderCustom[MemGameInfo.eCustomSystemID, ImageDetails[ScreenIndex].ImageCategoryIndex]);
        if ImageDetails[ScreenIndex].ImageCategoryIndex <> 1 then
           FolderSnapEmuCon[ScreenIndex]:= FullFolderFix(SnapshotFolderCustom[MemGameInfo.eCustomSystemID, 1]);
      end;
    False:
      begin
        if not IsMAMEBasedSys(MemGameInfo.eSystemID) then
           Folder[ScreenIndex]:= GetFolderFull(ImageDetails[ScreenIndex].ImageCategoryIndex, MemGameInfo.eSystemID)
        else
           Folder[ScreenIndex]:= '';
      end;
  end;

  Sleep(5); // delay to fix application crash, images are loaded in a separate thread, not sure if this helps anything anymore (March 16, 2018)

  ImageParentName[ScreenIndex]:= '';
  if ScreenIndex = 1 then
     iImageTag[ScreenIndex]:= Images.Tag
  else
     iImageTag[ScreenIndex]:= ImageScr[ScreenIndex].Tag;

  case MemGameInfo.eIsCustomGame of
    True : ImageName[ScreenIndex]:= ChangeFileExtW(MemGameInfo.eName, '');
    False: ImageName[ScreenIndex]:= GetImageName(MemGameInfo.eName, iImageTag[ScreenIndex], 0);
  end;

  if MemGameInfo.eIsCustomGame then
     if FormPreferences.FixRetroArchImageFileNames.Checked then
        ImageName[ScreenIndex]:= FixRetroArchImageFileNames(ImageName[ScreenIndex]);

  NewMAMESnapName[ScreenIndex]:= '';      // used by in-game snapshot only "gamename\0000.png"
  NewMAMESnapCloneName[ScreenIndex]:= ''; // used by in-game snapshot only "parent_gamename\0000.png"

  // save current image details (sysID, imgCategory, SoftwareName, Image FileName)
  CurrentSystemID[ScreenIndex]:= ImageDetails[ScreenIndex].SystemID;
  CurrentImageCategoryID[ScreenIndex]:= ImageDetails[ScreenIndex].ImageCategoryIndex;
  CurrentImageZip[ScreenIndex]:= ImageDetails[ScreenIndex].FileName;
  CurrentCustomSystemID[ScreenIndex]:= ImageDetails[ScreenIndex].CustomSystemID;

  GetImageFileName(False); // search unzipped image (snap\gamename.png; snap\snap\gamename.png; snap\gamename\0000.png; snap\snap\gamename\0000.png)
  if not ContinueImg[ScreenIndex] then
     GetImageFileName(True); // search zipped image

  if (not ContinueImg[ScreenIndex]) and (not MemGameInfo.eIsCustomGame) then
     begin
       if ImagesMrDo_Artwork(ImageDetails[ScreenIndex].ImageCategoryIndex) and
          PopupDisplayGameSnapshotifGameArtworkNotFound.Checked then
          begin
            // setting "show game snap if in-game artwork not found" (no zipped images support)
            // will try to load game snap instead (requested by "Mr. Do!")
            case MemGameInfo.eIsCustomGame of
              True : Folder[ScreenIndex]:= FullFolderFix(SnapshotFolderCustom[MemGameInfo.eCustomSystemID, 1]);
              False: Folder[ScreenIndex]:= GetFolderFull(1, MemGameInfo.eSystemID);
            end;
            GetImageFileName(False);
            // do not uncomment this code, it doesn't work because zipped in-game snapshot cache might not be initialized, causing frontend crash
            //ContinueImg[ScreenIndex]:= GetImageFileName(False);
            //if not Result then
            //   GetImageFileName(True);
          end;
     end;

  if ContinueImg[ScreenIndex] then
     begin
       // this means the image file was already found, unzipped or zipped
       ImageDetails[ScreenIndex].SystemID:= MemGameInfo.eSystemID;
       ImageDetails[ScreenIndex].CustomSystemID:= MemGameInfo.eCustomSystemID;
       if (ImageDetails[ScreenIndex].FileName = CurrentImageZip[ScreenIndex]) and
          (ImageDetails[ScreenIndex].SystemID = CurrentSystemID[ScreenIndex]) and
          (ImageDetails[ScreenIndex].CustomSystemID = CurrentCustomSystemID[ScreenIndex]) and
          (ImageDetails[ScreenIndex].ImageCategoryIndex = CurrentImageCategoryID[ScreenIndex]) then
          begin
            ContinueImg[ScreenIndex]:= True; // this will prevent from loading the same zipped image that is already shown
          end
       else
          begin
            case ImageDetails[ScreenIndex].IsZipped of
              True:
                begin
                  if ScreenIndex = 1 then
                     LoadZippedImage(ZipForge)
                  else
                     LoadZippedImage(ZipForgeImg[ScreenIndex]);
                end;
              False: LoadUnzippedImage;
            end;
          end;
     end;
  case ContinueImg[ScreenIndex] of
    True:
      begin
        ImageDetails[ScreenIndex].ImageCurrentTag:= iImageTag[ScreenIndex];
      end;
    False:
      begin
        if iImageTag[ScreenIndex] > 1 then
        begin
          // must restore TImage32.Tag value to what is was (no image found); used by "prev/next" image buttons
          if iImageTag[ScreenIndex] <> ImageDetails[ScreenIndex].ImageCurrentTag then
             begin
               if ScreenIndex = 1 then
                  Images.Tag:= ImageDetails[ScreenIndex].ImageCurrentTag
               else
                  ImageScr[ScreenIndex].Tag:= ImageDetails[ScreenIndex].ImageCurrentTag;
             end;
        end;
      end;
  end;

  ImageDetails[ScreenIndex].NewImageLoaded:= ContinueImg[ScreenIndex];
  if not ContinueImg[ScreenIndex] then
     begin
       // image was not found or failed to load (unzipped or zipped)
       if iImageTag[ScreenIndex] = 1 then
          begin
            if not ImageDetails[ScreenIndex].PrevNoImageLoaded then
               LoadNotAvailableImg;
          end;
     end;


  if ScreenIndex = 1 then
     begin
       if Ord(ImageDetails[ScreenIndex].IsZipped) <> ImageHintIcon.Tag then
          begin
            ImageHintIcon.Tag:= Ord(ImageDetails[ScreenIndex].IsZipped);
            case ImageHintIcon.Tag of
              0: IL_MenuPopup.GetIcon(06, ImageHintIcon.Picture.Icon); // unzipped image
              1: IL_MenuPopup.GetIcon(12, ImageHintIcon.Picture.Icon); // zipped image
            end;
          end;
       ImageHintDetailsText.Caption:= IntToStr(Images.Bitmap.Width)+'x'+IntToStr(Images.Bitmap.Height)+' (PNG)';
     end
  else
     begin
       if Ord(ImageDetails[ScreenIndex].IsZipped) <> ImageHintIcon2[ScreenIndex].Tag then
          begin
            ImageHintIcon2[ScreenIndex].Tag:= Ord(ImageDetails[ScreenIndex].IsZipped);
            case ImageHintIcon2[ScreenIndex].Tag of
              0: IL_MenuPopup.GetIcon(06, ImageHintIcon2[ScreenIndex].Picture.Icon); // unzipped image
              1: IL_MenuPopup.GetIcon(12, ImageHintIcon2[ScreenIndex].Picture.Icon); // zipped image
            end;
          end;
     end;
  UnzipActive[ScreenIndex]:= False;
end;

procedure TFormMain.SetImageCategoryToDisplay(IsConsoleComputerGame: Boolean);
var
  iLoop: Integer;
begin
  if IsSingleImageLayout then
     Exit; // single layout already does this for ImageDetails[1].ImageCategoryIndex at startup or when switching layouts
  for iLoop:=Low(ImageDetails) to High(ImageDetails) do
  begin
    if IsConsoleComputerGame and LayoutUseAltCategory_ConsComp then
       ImageDetails[iLoop].ImageCategoryIndex:= ImageDetails[iLoop].ImageCategoryIndex_ConsComp
    else
       ImageDetails[iLoop].ImageCategoryIndex:= ImageDetails[iLoop].ImageCategoryIndex_AllSystems;
  end;
end;

procedure TFormMain.DisplayImage;
var
  ScreenIndex: Integer;
begin
  if IsStartup or CreatingGamesList then
     Exit;

  ImageSoftNameIndex:= -1; // for zipped softlist image files (msx1_cart.zip; nes.zip; a2600.zip;...)
  ImageSoftwareName:= MemGameInfo.eSoftwareName;
  if ImageSoftwareName <> '' then
     begin
       ImageSoftwareName:= ImageSoftwareName+'\';
       if Assigned(imgSoftwareNameZipList) then
          ImageSoftNameIndex:= imgSoftwareNameZipList.IndexOf(MemGameInfo.eSoftwareName);
     end;

  SetImageCategoryToDisplay(MemGameInfo.eIsCustomGame or (MemGameInfo.eSoftwareName <> '')); // added April 15, 2018
  for ScreenIndex:=1 to MaxImagePanels do
  begin
    if not UnzipActive[ScreenIndex] then
    begin
      if (ScreenIndex = 1) or ((ScreenIndex > 1) and Assigned(ImageScr[ScreenIndex])) then
      begin
        if not FormPreferences.ImageDisableThreadedLoading.Checked then
        begin
          case ScreenIndex of
            1: RunInThread(LoadImage1, nil);
            2: RunInThread(LoadImage2, nil);
            3: RunInThread(LoadImage3, nil);
            4: RunInThread(LoadImage4, nil);
          end;
        end
        else
          LoadScreenshot(ScreenIndex); // load image without thread
      end;
    end;
  end;
end;

procedure TFormMain.CallCreateArcadeGames(sysID: Integer; MultiSys: String = '');
var
  Continue, IsMultiSys, AuditMAMESoftwareList, AuditHBMAMESoftwareList: Boolean;
  Loop, CurrentSystem: Integer;
  CreateSys: array[1..MaxArcadeSystems] of Boolean;
  FailedStr, PassedStr: String;
  ChangedGames: Boolean;
  MAMESoftwareListsToProcess, HBMAMESoftwareListsToProcess: THashedStringList;

  function CreateList(SystemID: Integer): Boolean;
  begin
    Result:= False;
    FormStatus.SetProgressPos(0);
    Application.ProcessMessages;
    case IsMAMEBasedSys(SystemID) of
      True:
        begin
          if SystemID = idMAME then
             begin
               MAMESoftwareListsToProcess:= THashedStringList.Create;
               Result:= CreateGamesListMAME(SystemID, MAMESoftwareListsToProcess);
             end
          else
             begin
               HBMAMESoftwareListsToProcess:= THashedStringList.Create;
               Result:= CreateGamesListMAME(SystemID, HBMAMESoftwareListsToProcess);
             end;
        end;
      False:
        begin
          case IsClrMAMEProBasedSys(SystemID) of
            True:
              begin
                if SystemID = idSupermodel then
                   begin
                     Result:= ParseSupermodelGamesXMLFile; // create games list based on new "supermodel3_dir\Config\Games.xml" file (SVN 592 and newer)
                     if not Result then
                        Result:= CreateGamesClrMAMEProXML(SystemID); // this is for SVN 591 and older
                   end
                else
                   Result:= CreateGamesClrMAMEProXML(SystemID);
              end;
            False:
              begin
                if SystemID = idDaphne then
                   Result:= CreateGamesListDaphne;
              end;
          end;
        end;
    end;
  end;

begin
  // this function is only called at main menu 'Create Games List'
  if sysID = -1 then
     Exit;
  if (sysID = idMultiSys) and (MultiSys = '') then
     Exit;

  Continue:= False;
  AuditMAMESoftwareList:= False;
  AuditHBMAMESoftwareList:= False;
  ChangedGames:= False;
  IsMultiSys:= sysID = idMultiSys;
  case IsMultiSys of
    True: // multi systems
      begin
        for Loop:=Low(CreateSys) to High(CreateSys) do
            CreateSys[Loop]:= False; // initialize all to FALSE

        Continue:= False;
        FailedStr:= '';
        PassedStr:= '';
        for Loop:=1 to Length(MultiSys) do
        begin
          CurrentSystem:= StrToInt(MultiSys[Loop]);
          if ValidateArcadeEmulatorFile(CurrentSystem) then
             begin
               if PassedStr <> '' then
                  PassedStr:= PassedStr+#13#10;
               PassedStr:= PassedStr+GetArcadeSystemShortTitle(CurrentSystem)+': Emulator file valid.';
               Continue:= True;
               CreateSys[CurrentSystem]:= True; // only set to TRUE if emulator is valid
             end
          else
             begin
               if FailedStr <> '' then
                  FailedStr:= FailedStr+#13#10;
               FailedStr:= FailedStr+GetArcadeSystemShortTitle(CurrentSystem)+': Emulator file invalid.';
               CreateSys[Loop]:= False; // set system to false since emulator validation failed
             end;
        end;
        if Continue then
           begin
             if FailedStr <> '' then
                begin
                   GenerateMessage('Error', 'Create games list for multiple systems.',
                                   '    One or more emulator files failed to be valited. The games list will not be '+
                                   'created for the following systems:'+#13#10+#13#10+
                                   FailedStr+#13#10+#13#10, 2);
                end;
           end
        else
           begin
             GenerateMessage('Error', 'Create games list for multiple systems.',
                                  '    Validation failed for all selected systems.'+#13#10+#13#10+
                                  FailedStr+#13#10+#13#10+'Cannot continue, aborting...', 2, False, 1);
             Exit;
           end;
        if Continue then
           begin
             // create games list
             Continue:= False;
             FormStatus.Show;
             FormStatus.StartThreadClock;
             FailedStr:= '';
             for Loop:=Low(CreateSys) to High(CreateSys) do
             begin
               if CreateSys[Loop] then
                  begin
                    // only process selected and valid systems
                    CreateSys[Loop]:= CreateList(Loop);
                    if CreateSys[Loop] then
                       Continue:= True // continue to audit games
                    else
                       begin
                         if FailedStr <> '' then
                            FailedStr:= FailedStr+#13#10;
                         FailedStr:= FailedStr+GetArcadeSystemShortTitle(Loop)+': Failed to create games list.';
                         CreateSys[Loop]:= False; // failed to create games list, no audit games possible
                       end;
                  end;
             end;
           end;
      end;
    False: // single system
      begin
        if not ValidateArcadeEmulatorFile(sysID) then
           Exit;
        FormStatus.Show;
        FormStatus.StartThreadClock;
        Continue:= CreateList(sysID);
      end;
  end;

  if Continue then
     begin
       Application.ProcessMessages;
       // first need to load the games list, then audit games
       if not IsStartup then
          begin
            CreatingGamesList:= True;
            SetGameType(True); // load the games list first
            case IsMultiSys of
              True:
                begin
                  // 0 -> disabled, don't create softlists;
                  // 1 -> update mode: create softlist games and update existing ones
                  // 2 -> overwrite mode: delete all softlists and create new ones
                  if MenuCreateMAMESoftwareListGames.Tag > 0 then
                     begin
                       if CreateSys[idMAME] then
                          AuditMAMESoftwareList:= True; // need to check if user enabled the new "Create Softwarelist Games" checkbox in systems selection or scan mode dialog
                       if CreateSys[idHBMAME] then
                          AuditHBMAMESoftwareList:= True; // need to check if user enabled the new "Create Softwarelist Games" checkbox in systems selection or scan mode dialog
                     end;

                  GamesListView.BeginUpdate;
                  for Loop:=Low(CreateSys) to High(CreateSys) do
                  begin
                    if CreateSys[Loop] then
                    begin
                      if CallScanGames(0, True, Loop, '', True) > 0 then
                         ChangedGames:= True;
                    end;
                  end;
                  GamesListView.EndUpdate(False);
                  if FailedStr <> '' then
                     GenerateMessage('Error', 'Create games list for multiple systems.',
                                     '    Failed to create games list for the following systems:'+
                                     #13#10+#13#10+FailedStr, 2);
                end;
              False:
                begin
                  if CallScanGames(0, True, sysID) > 0 then
                     ChangedGames:= True;

                  if MenuCreateMAMESoftwareListGames.Tag > 0 then
                     begin
                       case sysID of
                         idMAME  : AuditMAMESoftwareList:= True;
                         idHBMAME: AuditHBMAMESoftwareList:= True;
                       end;
                     end;
                end;
            end;
            if AuditMAMESoftwareList then
            begin
              if ScanSoftListGames(0, True, idMAME, MAMESoftwareListsToProcess) > 0 then
                 ChangedGames:= True;
              FreeAndNil(MAMESoftwareListsToProcess);
              // get all software list files
            end;
            if AuditHBMAMESoftwareList then
            begin
              if ScanSoftListGames(0, True, idHBMAME, HBMAMESoftwareListsToProcess) > 0 then
                 ChangedGames:= True;
              FreeAndNil(HBMAMESoftwareListsToProcess);
              // get all software list files
            end;

            SetSortAudit(False);
            CreatingGamesList:= False; // to avoid apply filters on every new system/software list
            SetGameType(False); // apply filters only
          end;
       LoadListCPU(FilterCPUList);
       ResetNoImageLoaded;
       
       Application.ProcessMessages;
     end;
  SetCurrentDir(FrontendPath);

  if not IsStartup then
     begin
       FormStatus.Close;
       FocusGamesList;
     end;
end;

procedure TFormMain.SetSortAudit(Auditing: Boolean);
begin
  if SortAuditGames = Auditing then
     Exit;
  SortAuditGames:= Auditing;
  case Auditing of
    True : GamesListView.BeginUpdate;
    False: GamesListview.EndUpdate(False);
  end;
end;

function TFormMain.SystemUseSevenZip(sysID: Integer): Boolean;
begin
  Result:= sysID in [idMAME, idHBMAME, idDemul];
end;

procedure TFormMain.CheckSevenZip(sysID: Integer);
begin
  if sysID <> -1 then
     begin
       UseSevenZip:= SystemUseSevenZip(sysID);
       if UseSevenZip then
          UseSevenZip:= ValidateSevenZipDLL;
     end
  else
     UseSevenZip:= ValidateSevenZipDLL;
end;

function TFormMain.ValidateSevenZipDLL: Boolean;
var
  fHandle: THandle;
  libFile: String;
begin
  libFile:= FrontendPath+'7z.dll';
  Result:= FileExists(libFile);
  if not Result then
     Exit;
  fHandle:= LoadLibrary(PChar(libFile));
  Result:= FHandle <> 0;
  FreeLibrary(fHandle);
end;

//var
//  iUpdatedGames: THashedStringList;

function TFormMain.GenerateStreamSHA1(MemoryStreamVar: TWideMemoryStream; DestinationList: THashedStringList; const iNameStr: String): Boolean;
var
  FileSHA1: String;
begin
  Result:= MemoryStreamVar.Size > 0;
  if not Result then
     Exit;
  FileSHA1:= '';
  try
    MemoryStreamVar.Position:= 0;
    FileSHA1:= GetSHA1_ValueMemoryStream(MemoryStreamVar);
  except
    Result:= False;
  end;
  MemoryStreamVar.Clear;
  if FileSHA1 <> '' then
     DestinationList.Add(iNameStr+'='+FileSHA1);
end;

function TFormMain.CallScanGames(RefreshMode: ShortInt; CreatingList: Boolean; sysID: ShortInt; SoftwareList: String = ''; IsMultiSys: Boolean = False): Integer;
var
  NumGamesChanged, TotalGamesCount, CurrentIndex, iStatusGamesCount, iStatusCurrentIndex, SelectedIndex: Integer;
  UpdateList: Boolean;
  FileGames, MissingROMsFileName: String;
  MissingROMs: TMemIniFile;
  checkItem: TEasyItem;
  checkGroup: TEasyGroup;

  TempDevsList, TempBiosList: THashedStringList;
  MAMEList: TMemIniFile;

  function ELV_UpdateGameInfo(ItemToUpdate: TEasyItem): Boolean;
  begin
    Result:= True;
    TEasyGameInfo(ItemToUpdate).eROMIdentification:= TempGameVars.eROMIdentification;
    TEasyGameInfo(ItemToUpdate).eGameSetStatus:= TempGameVars.eGameSetStatus;
    TEasyGameInfo(ItemToUpdate).eScanMode:= TempGameVars.eScanMode;
    TEasyGameInfo(ItemToUpdate).eIsMerged:= TempGamevars.eIsMerged;
    if TEasyGameInfo(ItemToUpdate).eImageIndex <= MaxGameID then
       TEasyGameInfo(ItemToUpdate).eImageIndex:= TempGameVars.eROMIdentification;
  end;

  function CheckSystemROM_ID: Boolean;
  begin
    // 1 -> Scan Available Games
    // 2 -> Scan Missing Games
    // 3 -> Scan Single Game
    // 4 -> Scan Incomplete Games
    // 5 -> Scan Multiple Selected Games
    Result:= (RefreshMode = 0) or 
       // MAME
       ((RefreshMode = 4) and (TempGameVars.eROMIdentification in [04..07]) and IsROM_HaveMissROMs(TempGameVars.eGameSetStatus)) or // missing ROMs/CHDs
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [04..07])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [00..03])) or // have
       // Supermodel: SEGA Model 3
       ((RefreshMode = 4) and (TempGameVars.eROMIdentification in [10, 11]) and IsROM_HaveMissROMs(TempGameVars.eGameSetStatus)) or // missing ROMs/CHDs
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [10, 11])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [08..09])) or // have
       // Daphne
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [14, 15])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [12, 13])) or // have
       // Demul
       ((RefreshMode = 4) and (TempGameVars.eROMIdentification in [19..21]) and IsROM_HaveMissROMs(TempGameVars.eGameSetStatus)) or // missing ROMs/CHDs
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [19..21])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [16..18])) or // have
       // HBMAME
       ((RefreshMode = 4) and (TempGameVars.eROMIdentification in [26..29]) and IsROM_HaveMissROMs(TempGameVars.eGameSetStatus)) or // missing ROMs/CHDs
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [26..29])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [22..25])) or // have
       // DICE
       ((RefreshMode = 4) and (TempGameVars.eROMIdentification in [32, 33]) and IsROM_HaveMissROMs(TempGameVars.eGameSetStatus)) or // missing ROMs/CHDs
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [32, 33])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [30, 31])) or // have
       // SEGA Model 2
       ((RefreshMode = 4) and (TempGameVars.eROMIdentification in [36, 37]) and IsROM_HaveMissROMs(TempGameVars.eGameSetStatus)) or // missing ROMs/CHDs
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [36..37])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [34..35])) or // have
       // ZiNc
       ((RefreshMode = 4) and (TempGameVars.eROMIdentification in [41..43]) and IsROM_HaveMissROMs(TempGameVars.eGameSetStatus)) or // missing ROMs/CHDs
       ((RefreshMode = 2) and (TempGameVars.eROMIdentification in [41..43])) or // miss
       ((RefreshMode = 1) and (TempGameVars.eROMIdentification in [38..40])); // have
  end;

  procedure FreeMemoryVars;
  begin
    FreeAndNil(MissingROMs);
    FreeAndNil(CompleteGamesList);
    FreeAndNil(ScanGameStatusList);

    FreeAndNil(ZipContents);
    FreeAndNil(ParentZipContents);

    FreeAndNil(DeviceSetsZipContents);
    FreeAndNil(DeviceSetsSHA1ZipContents);
    FreeAndNil(BiosSetsZipContents);
    FreeAndNil(BiosSetsSHA1ZipContents);

    SetCurrentDir(FrontendPath);
  end;

  function AddDeviceBiosArray(ItemSource: TEasyItem; DeviceListSource, BiosListSource: THashedStringList): Boolean;
  var
    LoopArray: Integer;
    tmpDeviceStr, tmpBiosStr: String;
  begin
    tmpDeviceStr:= '';
    tmpBiosStr:= '';
    if IsROM_Device(TempGameVars.eROMIdentification) then
       tmpDeviceStr:= TEasyGameInfo(ItemSource).eName
    else
    if IsROM_Bios(TempGameVars.eROMIdentification) then
       tmpBiosStr:= TEasyGameInfo(ItemSource).eName
    else
    if TEasyGameInfo(ItemSource).eBiosName <> '' then
       tmpBiosStr:= TEasyGameInfo(ItemSource).eBiosName;

    if tmpDeviceStr <> '' then
       begin
         if DeviceListSource.IndexOf(tmpDeviceStr) = -1 then
            DeviceListSource.Add(tmpDeviceStr);
       end;

    if tmpBiosStr <> '' then
       begin
         if BiosListSource.IndexOf(tmpBiosStr) = -1 then
            BiosListSource.Add(tmpBiosStr);
       end;

    // note: some bios sets have device sets in them
    tmpDeviceStr:= '';
    if TEasyGameInfo(ItemSource).eDeviceSets <> nil then
    begin
      for LoopArray:=0 to TEasyGameInfo(ItemSource).eDeviceSets.Count-1 do
      begin
        tmpDeviceStr:= TEasyGameInfo(ItemSource).eDeviceSets[LoopArray];
        if DeviceListSource.IndexOf(tmpDeviceStr) = -1 then
           DeviceListSource.Add(tmpDeviceStr);
      end;
      tmpDeviceStr:= '';
    end;
  end;

  function GetDeviceBiosROMsList(SetType: ShortInt; TempSetsList, DestinationCRC32List, DestinationSHA1List: THashedStringList): Boolean;
  var
    ArchiveItem: TZFArchiveItem;
    ArchiveItemSevenZ: I7zInArchive;
    Loop7z: Integer;
    iLoopList: Integer;
    ZipFileName: String;
    iSetNameStr: String;
    ROMFileMemoryStream: TWideMemoryStream;
    CRC32CollisionList: THashedStringList;
  begin
    // this function will get CRC32 / SHA-1 from .zip files and store in lists (device and bios)
    Result:= TempSetsList.Count > 0;
    if not Result then
       Exit;

    case SetType of
      1: FormStatus.MessageStr('Scanning devices to build CRC32 / SHA-1 checksums list.');
      2: FormStatus.MessageStr('Scanning bios to build CRC32 / SHA-1 checksums list.');
    end;

    if ValidateFile(GetCRC32CollisionFile(sysID)) then
       begin
         CRC32CollisionList:= THashedStringList.Create;
         CRC32CollisionList.LoadFromFile(GetCRC32CollisionFile(sysID));
         ROMFileMemoryStream:= TWideMemoryStream.Create;
       end;

    for iLoopList:=0 to TempSetsList.Count-1 do
    begin
      iSetNameStr:= TempSetsList[iLoopList];
      ZipFileName:= FormMain.SearchZIPFolder(iSetNameStr, sysID);
      if ZipFileName <> '' then
         begin
           if Assigned(ROMFileMemoryStream) then
              ROMFileMemoryStream.Clear;
           if SameText(ExtractFileExt(ZipFileName), '.zip') then
              begin
                // .zip file
                with ZipForge do
                begin
                  FileName:= ZipFileName;
                  // Open existing archive file
                  try
                    OpenArchive(fmOpenRead or fmShareDenyNone);
                    Result:= FileCount > 0;
                    if Result then
                       begin
                         // Search text files stored inside the archive
                         if FindFirst('*.*', ArchiveItem) then
                            begin
                              repeat
                                DestinationCRC32List.Add(iSetNameStr+'='+LowerCase(IntToHex(ArchiveItem.CRC, 8)));
                                if Assigned(CRC32CollisionList) then
                                begin
                                  if CRC32CollisionList.IndexOf(iSetNameStr) <> -1 then
                                     begin
                                       ExtractToStream(ArchiveItem.FileName, ROMFileMemoryStream);
                                       GenerateStreamSHA1(ROMFileMemoryStream, DestinationSHA1List, iSetNameStr);
                                     end;
                                end;
                              until (not FindNext(ArchiveItem));
                            end;
                       end;
                    CloseArchive;
                    ZipForge.FileName:= '';
                  except
                    CloseArchive;
                    ZipForge.FileName:= '';
                  end;
                end;
              end
           else
              begin
                // .7z file
                ArchiveItemSevenZ:= CreateInArchive(CLSID_CFormat7z);
                with ArchiveItemSevenZ do
                begin
                  // Open existing archive file
                  try
                    OpenFile(ZipFileName);
                    Result:= NumberOfItems > 0;
                    if Result then
                       begin
                         // Search text files stored inside the archive
                         for Loop7z:= 0 to NumberOfItems-1 do
                         begin
                           if not ItemIsFolder[Loop7z] then
                              begin
                                DestinationCRC32List.Add(iSetNameStr+'='+LowerCase(IntToHex(ItemCRC[Loop7z], 8)));
                                if Assigned(CRC32CollisionList) then
                                   begin
                                     if CRC32CollisionList.IndexOf(iSetNameStr) <> -1 then
                                        begin
                                          ExtractItem(Loop7z, ROMFileMemoryStream, False);
                                          GenerateStreamSHA1(ROMFileMemoryStream, DestinationSHA1List, iSetNameStr);
                                        end;
                                   end;
                              end;
                         end;
                       end;
                    Close;
                  except
                    Result:= False;
                    Close;
                  end;
                end;
              end;
         end;
    end;

    Result:= DestinationCRC32List.Count > 0;
    //if Result then
    //   DestinationCRC32List.SaveToFile(FrontendPath+'zinc-bios-zip-list.txt'); // for debugging only, do not enable (February 20, 2018)
    //if DestinationSHA1List.Count > 0 then
    //   ShowMessage(DestinationSHA1List.Text); // for debugging only, do not enable (February 20, 2018)

    if Assigned(ROMFileMemoryStream) then
       ROMFileMemoryStream.Clear;
    FreeAndNil(ROMFileMemoryStream);
    FreeAndNil(CRC32CollisionList);
  end;

begin
  Result:= 0;
  if sysID = -1 then
     Exit;
  if not CheckTotal(GamesListView) then
     Exit;
  if EmulatorFile[sysID] = '' then
     Exit;
  if (RefreshMode = 3) and (not CheckSelected(GamesListView)) then
     Exit; // single game audit

  if (RefreshMode = 5) and (not CheckMultipleSelected(GamesListView)) then
     Exit; // multiple selected games audit, if only 1 or no game is selected, can't do anything

  FormStatus.SetProgressPos(0);

  if IsMAMEBasedSys(sysID) and (not CreatingList) and (not (RefreshMode in [3, 5])) then
     begin
       if SoftwareList = '' then
       begin
         if MenuCreateMAMESoftwareListGames.HelpContext = 2 then
            Exit; // scan only if Scan MAME is "all sets" or "arcade/machines only"
       end
       else
       begin
         if MenuCreateMAMESoftwareListGames.HelpContext = 1 then
            Exit; // scan only if Scan MAME is "all sets" or "software list games only"
       end;
     end;

  FileGames:= GetGamesFolderEL(Ord(SoftwareList <> ''))+GetSystemFileName(sysID, 2, SoftwareList); // "systemname.elstatus"
  if not ValidateFile(FileGames) then
     Exit;

  //iUpdatedGames:= THashedStringList.Create;
  //iUpdatedGames.BeginUpdate;
  case RefreshMode of
    0: MissingROMsFileName:= 'All Games';
    1: MissingROMsFileName:= 'Available Games';
    2: MissingROMsFileName:= 'Missing Games';
    3: MissingROMsFileName:= 'Single Game';
    4: MissingROMsFileName:= 'Incomplete Games';
    5: MissingROMsFileName:= 'Multiple Selected Games';
  end;
  case PopupSelectScanGamesMode.Tag of
    0: MissingROMsFileName:= 'Full Scan '+MissingROMsFileName;
    1: MissingROMsFileName:= 'Quick Scan '+MissingROMsFileName;
    2: MissingROMsFileName:= 'Force '+MissingROMsFileName+' Available';
  end;

  if SoftwareList <> '' then
     begin
       case MenuCreateMAMESoftwareListGames.Tag of
         1: MissingROMsFileName:= MissingROMsFileName+' (Update Mode)';
         2: MissingROMsFileName:= MissingROMsFileName+' (Overwrite Mode)';
       end;
     end;
  CheckSevenZip(sysID);
  
  FormStatus.TitleStr(MissingROMsFileName);
  MissingROMsFileName:= '';

  if IsROMsListBasedSys(sysID) then
     begin
       MissingROMsFileName:= GetGamesFolderEL(Ord(SoftwareList <> ''), sysID)+GetSystemFileName(sysID, 3, SoftwareList); // "systemname.miss"
       if RefreshMode = 0 then
          DeleteFile(MissingROMsFileName); // scan all MAME files, delete "systemname.miss"
       if SoftwareList = '' then
          FormStatus.TitleStr(': '+GetArcadeEmulatorDescription(sysID, True), True)
       else
          FormStatus.TitleStr(': '+GetSoftwareListTitle(SoftwareList, sysID), True);
       MissingROMs:= TMemIniFile.Create(MissingROMsFileName);
     end;

  if not FormStatus.Visible then
     begin
       FormStatus.Show;
       FormStatus.StartThreadClock;
     end;

  NumGamesChanged:= 0;
  UpdateList:= False;
  CompleteGamesList:= THashedStringList.Create;
  CompleteGamesList.LoadFromFile(FileGames); // status games list file "systemname.elstatus"

  ScanGameStatusList:= THashedStringList.Create; // needed for faster game name searching containing only gamename; HashedStringList.IndexOf()
  ScanGameStatusList.LoadFromFile(FileGames);
  ScanGameStatusList.BeginUpdate;
  for CurrentIndex:=0 to ScanGameStatusList.Count-1 do
      ScanGameStatusList[CurrentIndex]:= ScanGameStatusList.Names[CurrentIndex];
  ScanGameStatusList.EndUpdate;
  //ScanGameStatusList.SaveToFile('d:\EmuLoader\test-status-gamename.txt'); // for debugging only, do not enable it

  iStatusGamesCount:= CompleteGamesList.Count;
  CompleteGamesList.BeginUpdate;

  LoadROMFolders(sysID);

  if (PopupSelectScanGamesMode.Tag = 0) and (SoftwareList = '') and // only if scan mode is Full Scan and "no" MAME software lists
     (IsMAMEBasedSys(sysID) or (sysID = idDemul) or (sysID = idZiNc) or (sysID = idSegaModel2)) then
  begin
    FormStatus.MessageStr('Generating device/bios lists to be scanned.');
    TempDevsList:= THashedStringList.Create;
    TempBiosList:= THashedStringList.Create;
    TempDevsList.BeginUpdate;
    TempBiosList.BeginUpdate;

    if sysID = idSegaModel2 then
       TempBiosList.Add('model2'); // must add "model2 board ROMs" set to the bios list or games are not scanned properly (June 28, 2018)

    if RefreshMode = 0 then
    begin
      // scan all games
      if sysID <> idSegaModel2 then
      begin // must ignore this or "TempBiosList" var gets emptied and games are not validated correctly (July 01, 2018)
        MAMEList:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID)); // only MAME/arcade, NO software lists (March 01, 2018)
        if IsMAMEBasedSys(sysID) then
           MAMEList.ReadSection('devices', TempDevsList); // read keynames only from file; note: TMemIniFile.ReadSection() already have .BeginUpdate and .EndUpdate

        MAMEList.ReadSection('bios', TempBiosList);
        FreeAndNil(MAMEList);
      end;
    end
    else
    if RefreshMode = 3 then // single game audit
    begin
      if FormMain.IsROM_Device(TEasyGameInfo(SelectedEasyItem).eROMIdentification) then
         TempDevsList.Add(TEasyGameInfo(SelectedEasyItem).eName)
      else
      if FormMain.IsROM_Bios(TEasyGameInfo(SelectedEasyItem).eROMIdentification) then
         TempBiosList.Add(TEasyGameInfo(SelectedEasyItem).eName)
      else
      if TEasyGameInfo(SelectedEasyItem).eBiosName <> '' then
         TempBiosList.Add(TEasyGameInfo(SelectedEasyItem).eBiosName);

      if TEasyGameInfo(SelectedEasyItem).eDeviceSets <> nil then
         TempDevsList.AddStrings(TEasyGameInfo(SelectedEasyItem).eDeviceSets);
    end
    else
    begin
      // scan everything else (have/miss games; selected games); must go thru all games and get devices list and bios list
      case RefreshMode of
        1, 2, 4: // all "have" or "miss" games
          begin
            TotalGamesCount:= GamesListView.Groups.ItemCount;
            CurrentIndex:= 0;
            iStatusCurrentIndex:= 0;
            if IsGroupedView then
            begin
              checkGroup:= GamesListView.Groups.FirstGroup;
              repeat
                checkItem:= GamesListView.Groups.FirstInGroup(checkGroup);
                repeat
                  if (TEasyGameInfo(checkItem).eSystemID = sysID) and (TEasyGameInfo(checkItem).eSoftwareName = '') then
                     begin
                       Inc(iStatusCurrentIndex);
                       TempGameVars.eROMIdentification:= TEasyGameInfo(checkItem).eROMIdentification;
                       TempGameVars.eGameSetStatus:= TEasyGameInfo(checkItem).eGameSetStatus;
                       if CheckSystemROM_ID then
                          begin
                            AddDeviceBiosArray(checkItem, TempDevsList, TempBiosList);
                            Application.ProcessMessages;
                          end;
                       TempGameVars.eROMIdentification:= -1; // set to default (just in case)
                       TempGameVars.eGameSetStatus:= 2; // set to default (just in case)
                     end;
                  checkItem:= GamesListView.Groups.NextInGroup(checkGroup, checkItem);
                  Inc(CurrentIndex);
                  if SoftwareList = '' then
                     FormStatus.UpdateProgressBar(CurrentIndex, TotalGamesCount); // avoid slow software list games scanning
                until (checkItem = nil) or (iStatusCurrentIndex = iStatusGamesCount);

                checkGroup:= GamesListView.Groups.NextGroup(checkGroup);
              until (checkGroup = nil) or (iStatusCurrentIndex = iStatusGamesCount);
            end
            else
            begin
              // all other view modes
              checkItem:= GamesListView.Groups.FirstItem;
              repeat
                if (TEasyGameInfo(checkItem).eSystemID = sysID) and (TEasyGameInfo(checkItem).eSoftwareName = '') then
                   begin
                     Inc(iStatusCurrentIndex);
                     TempGameVars.eROMIdentification:= TEasyGameInfo(checkItem).eROMIdentification;
                     TempGameVars.eGameSetStatus:= TEasyGameInfo(checkItem).eGameSetStatus;
                     if CheckSystemROM_ID then
                        begin
                          AddDeviceBiosArray(checkItem, TempDevsList, TempBiosList);
                          Application.ProcessMessages;
                        end;
                     TempGameVars.eROMIdentification:= -1; // set to default (just in case)
                     TempGameVars.eGameSetStatus:= 2; // set to default (just in case)
                   end;
                checkItem:= GamesListView.Groups.NextItem(checkItem);
                Inc(CurrentIndex);
                if SoftwareList = '' then
                   FormStatus.UpdateProgressBar(CurrentIndex, TotalGamesCount); // avoid slow software list games scanning
              until (checkItem = nil) or (iStatusCurrentIndex = iStatusGamesCount);
            end;
          end;
        5: // multiple selected games. only ONE system will be scanned (based on first selection), even if others are selected!
          begin
            TotalGamesCount:= GamesListView.Selection.Count;
            CurrentIndex:= 0;
            SelectedIndex:= 1;
            //TempDevsList.BeginUpdate;
            //TempBiosList.BeginUpdate;
            checkItem:= GamesListView.Selection.First;
            repeat
              if (TEasyGameInfo(checkItem).eSystemID = sysID) and (TEasyGameInfo(checkItem).eSoftwareName = '') then
                 begin
                   TempGameVars.eROMIdentification:= TEasyGameInfo(checkItem).eROMIdentification;
                   TempGameVars.eGameSetStatus:= TEasyGameInfo(checkItem).eGameSetStatus;

                   AddDeviceBiosArray(checkItem, TempDevsList, TempBiosList);
                   Application.ProcessMessages;

                   TempGameVars.eROMIdentification:= -1; // set to default (just in case)
                   TempGameVars.eGameSetStatus:= 2; // set to default (just in case)
                 end;
              checkItem:= ELV_GetNextSelected(GamesListView, checkItem, SelectedIndex);
              Inc(CurrentIndex);
              FormStatus.UpdateProgressBar(CurrentIndex, TotalGamesCount);
            until checkItem = nil;
          end;
      end;
    end;
    TempDevsList.EndUpdate;
    TempBiosList.EndUpdate;

    // 1 -> device; 2 -> bios
    // get CRC32 / SHA-1 lists from device/bios .zip files (DeviceSetsZipContents; DeviceSetsSHA1ZipContents; BiosSetsZipContents; BiosSetsSHA1ZipContents)
    DeviceSetsZipContents:= THashedStringList.Create;
    DeviceSetsSHA1ZipContents:= THashedStringList.Create;
    BiosSetsZipContents:= THashedStringList.Create;
    BiosSetsSHA1ZipContents:= THashedStringList.Create;

    DeviceSetsZipContents.BeginUpdate;
    DeviceSetsSHA1ZipContents.BeginUpdate;
    BiosSetsZipContents.BeginUpdate;
    BiosSetsSHA1ZipContents.BeginUpdate;

    GetDeviceBiosROMsList(1, TempDevsList, DeviceSetsZipContents, DeviceSetsSHA1ZipContents);
    GetDeviceBiosROMsList(2, TempBiosList, BiosSetsZipContents, BiosSetsSHA1ZipContents);

    FreeAndNil(TempDevsList);
    FreeAndNil(TempBiosList);

    DeviceSetsZipContents.EndUpdate;
    DeviceSetsSHA1ZipContents.EndUpdate;
    BiosSetsZipContents.EndUpdate;
    BiosSetsSHA1ZipContents.EndUpdate;

    if DeviceSetsZipContents.Count = 0 then
       FreeAndNil(DeviceSetsZipContents);
    if DeviceSetsSHA1ZipContents.Count = 0 then
       FreeAndNil(DeviceSetsSHA1ZipContents);
    if BiosSetsZipContents.Count = 0 then
       FreeAndNil(BiosSetsZipContents);
    if BiosSetsSHA1ZipContents.Count = 0 then
       FreeAndNil(BiosSetsSHA1ZipContents);
  end;

  if RefreshMode <> 3 then
     begin
       SetSortAudit(True);
       if (SoftwareList = '') or ((SoftwareList <> '') and (FormStatus.LabelMessage.Caption = '')) then
       begin
         case PopupSelectScanGamesMode.Tag of
           0: FormStatus.MessageStr('Searching games files to validate ROMs/CHDs (CRC32 / SHA-1 / MD5).');
           1: FormStatus.MessageStr('Searching games files (game/bios/device sets, CHDs).');
           2: FormStatus.MessageStr('Setting games available no matter what. No validation or file search is being done.');
         end;
       end;
     end
  else
     FormStatus.MessageStr('Searching for game files.');

  if not IsMultiSys then
     GamesListView.BeginUpdate;
  case RefreshMode of
    0..2, 4: // multiple games
      begin
        TotalGamesCount:= GamesListView.Groups.ItemCount;
        CurrentIndex:= 0;
        iStatusCurrentIndex:= 0;
        if IsGroupedView then
        begin
          checkGroup:= GamesListView.Groups.FirstGroup;
          repeat
            checkItem:= GamesListView.Groups.FirstInGroup(checkGroup);
            repeat
              if (TEasyGameInfo(checkItem).eSystemID = sysID) and (TEasyGameInfo(checkItem).eSoftwareName = SoftwareList) then
                 begin
                   Inc(iStatusCurrentIndex);
                   TempGameVars.eROMIdentification:= TEasyGameInfo(checkItem).eROMIdentification;
                   TempGameVars.eGameSetStatus:= TEasyGameInfo(checkItem).eGameSetStatus;
                   if CheckSystemROM_ID then
                      begin
                        FillTempGameInfo(checkItem);
                        case ScanGames(False, MissingROMs, checkItem, RefreshMode) of
                          True: // game is ok -> 0
                            begin
                              // this only gets executed if game is ok and NEEDS to be updated.
                              // otherwise, it returns False to the ScanGames()
                              Inc(NumGamesChanged);
                              ELV_UpdateGameInfo(checkItem);
                              UpdateList:= True;
                            end;
                          False: // missing ROMs/CHDs -> 1; missing -> 2
                            begin
                              // change if set status changes between 0 - have; 1 - missing ROMs/CHD; 2 - missing (no .zip files found)
                              if TEasyGameInfo(checkItem).eGameSetStatus <> TempGameVars.eGameSetStatus then
                                 begin
                                   Inc(NumGamesChanged);
                                   ELV_UpdateGameInfo(checkItem);
                                   UpdateList:= True;
                                 end;
                            end;
                        end;
                        Application.ProcessMessages;
                      end;
                 end;

              ClearMemGameInfo(TempGameVars);
              checkItem:= GamesListView.Groups.NextInGroup(checkGroup, checkItem);
              Inc(CurrentIndex);
              if SoftwareList = '' then
                 FormStatus.UpdateProgressBar(CurrentIndex, TotalGamesCount); // avoid slow software list games scanning
            until (checkItem = nil) or (iStatusCurrentIndex = iStatusGamesCount);

            checkGroup:= GamesListView.Groups.NextGroup(checkGroup);
          until (checkGroup = nil) or (iStatusCurrentIndex = iStatusGamesCount);
        end
        else
        begin
          // all other view modes
          checkItem:= GamesListView.Groups.FirstItem;
          repeat
            if (TEasyGameInfo(checkItem).eSystemID = sysID) and (TEasyGameInfo(checkItem).eSoftwareName = SoftwareList) then
               begin
                 Inc(iStatusCurrentIndex);
                 TempGameVars.eROMIdentification:= TEasyGameInfo(checkItem).eROMIdentification;
                 TempGameVars.eGameSetStatus:= TEasyGameInfo(checkItem).eGameSetStatus;
                 if CheckSystemROM_ID then
                    begin
                      FillTempGameInfo(checkItem);
                      case ScanGames(False, MissingROMs, checkItem, RefreshMode) of
                        True: // game is ok -> 0
                          begin
                            // this only gets executed if game is ok and NEEDS to be updated.
                            // otherwise, it returns False to the ScanGames()
                            Inc(NumGamesChanged);
                            ELV_UpdateGameInfo(checkItem);
                            UpdateList:= True;
                          end;
                        False: // missing ROMs/CHDs -> 1; missing -> 2
                          begin
                            // change if set status changes between 0 - have; 1 - missing ROMs/CHD; 2 - missing (no .zip files found)
                            if TEasyGameInfo(checkItem).eGameSetStatus <> TempGameVars.eGameSetStatus then
                               begin
                                 Inc(NumGamesChanged);
                                 ELV_UpdateGameInfo(checkItem);
                                 UpdateList:= True;
                               end;
                          end;
                      end;
                      Application.ProcessMessages;
                    end;
               end;

            ClearMemGameInfo(TempGameVars);
            checkItem:= GamesListView.Groups.NextItem(checkItem);
            Inc(CurrentIndex);
            if SoftwareList = '' then
               FormStatus.UpdateProgressBar(CurrentIndex, TotalGamesCount); // avoid slow software list games scanning
          until (checkItem = nil) or (iStatusCurrentIndex = iStatusGamesCount);
        end;
      end;
    3: // single game
      begin
        checkItem:= SelectedEasyItem;
        FillTempGameInfo(SelectedEasyItem);
        case ScanGames(True, MissingROMs, checkItem, RefreshMode) of
          True:
            begin
              ELV_UpdateGameInfo(checkItem);
              UpdateList:= True;
            end;
          False:
            begin
              if TEasyGameInfo(checkItem).eGameSetStatus <> TempGameVars.eGameSetStatus then
                begin
                  ELV_UpdateGameInfo(checkItem);
                  UpdateList:= True;
                end;
            end;
        end;
      end;
    5: // multiple selected games. only ONE system will be scanned (based on first selection), even if others are selected
      begin
        TotalGamesCount:= GamesListView.Selection.Count;
        CurrentIndex:= 0;
        SelectedIndex:= 1;
        checkItem:= GamesListView.Selection.First;
        repeat
          if (TEasyGameInfo(checkItem).eSystemID = sysID) and (TEasyGameInfo(checkItem).eSoftwareName = SoftwareList) then
             begin
               FillTempGameInfo(checkItem);
               case ScanGames(False, MissingROMs, checkItem, RefreshMode) of
                 True: // game is ok -> 0
                   begin
                     // this only gets executed if game is ok and NEEDS to be updated.
                     // otherwise, it returns False to the ScanGames()
                     Inc(NumGamesChanged);
                     ELV_UpdateGameInfo(checkItem);
                     UpdateList:= True;
                   end;
                 False: // missing ROMs/CHDs -> 1; missing (no gamename.zip found) -> 2
                   begin
                     if TEasyGameInfo(checkItem).eGameSetStatus <> TempGameVars.eGameSetStatus then
                        begin
                          Inc(NumGamesChanged);
                          ELV_UpdateGameInfo(checkItem);
                          UpdateList:= True;
                        end;
                   end;
               end;
               Application.ProcessMessages;
             end;
          checkItem:= ELV_GetNextSelected(GamesLisTView, checkItem, SelectedIndex);
          Inc(CurrentIndex);
          FormStatus.UpdateProgressBar(CurrentIndex, TotalGamesCount);
        until checkItem = nil;
        ClearMemGameInfo(TempGameVars);
      end;
  end;
  //iUpdatedGames.EndUpdate;
  CompleteGamesList.EndUpdate;
  FormStatus.SetProgressPos(0);
  if UpdateList then
     begin
       if SoftwareList = '' then
          FormStatus.MessageStr('Updating files.');
       CompleteGamesList.SaveToFile(FileGames);

       //if (not CreatingList) and (iUpdatedGames.Count > 0) then
       //   GenerateMessage('INFO', 'Scan games change log.', IntToStr(iUpdatedGames.Count)+' games were updated: '+#13#10+#13#10+iUpdatedGames.Text, 2); // for debuggig only
     end;

  //FreeAndNil(iUpdatedGames);
  if Assigned(MissingROMs) then
     MissingROMs.UpdateFile; // update missing ROMs file to avoid errors when game already is set as missing

  Result:= NumGamesChanged;
  if not IsMultiSys then
     GamesListView.EndUpdate(False);
  FreeMemoryVars;
  ClearMemGameInfo(TempGameVars);
  if not ValidateFile(MissingROMsFileName) then
     DeleteFile(MissingROMsFileName);
  if IsStartup then
     begin
       // if is startup, do nothing else... get the hell out of here!
       SetSortAudit(False);
       ClearMemGameInfo(MemGameInfo);
       Exit;
     end;
  if RefreshMode <> 3 then
     SetSortAudit(False);

  // NOTE: CreatingList = True: SetGameType(False); // do not load list again, not necessary as games list is loaded after CallCreateArcadeGames()
  if not CreatingList then
  begin
    // only apply filters as info in GamesListView already updated
    if RefreshMode = 3 then
       begin
         FillMemGameInfo(MemGameInfo); // single game scan only
         if UpdateList then
            begin
              if ButtonGameFilterHaveMiss.Tag <> 0 then
                 SetGameType(False) // apply filters to show/hide the single selected game
              else
                 SetSelectedGame(True); // reload game info to RAM, just in case
            end;
       end;
    //else // NOTE: do not delete this; it's a reminder for a future improvement, show a list of changed games to the user
    //   begin
    //     if NumGamesChanged <> 0 then
    //        begin
    //          //SetGameType(False); // no need as this will be called in the PopupScanAllGamesClick() function (onClick)
    //          //SetSelectedGame; // not needed here as it WILL be called in ApplyFilters() funciton
    //        end;
    //   end;

  end;

  if (not IsStartup) and (not IsMultiSys) and (not CreatingList) then
     FormStatus.Close;
end;

function TFormMain.ScanGames(SingleScan: Boolean; ScanResultsIni: TMemIniFile; ItemAudit: TEasyItem; RefreshMode: ShortInt): Boolean;
var
  GameFound, ParentGameFound, BiosFound, ChangeGameStatus, ValidateStatus,
  MissingROMsHeader, IsZiNcSystem, IsSupermodelSystem, IsSegaModel2, ContinueAudit: Boolean;
  ROMDataLine: String;
  ZipFile, CloneZipFile, BiosZipFile, DiskFile, ZiNcFilePath, CHDLine, ParentCHDLine: String;
  StatusCHD: ShortInt; // 0 -> file missing; 1-> found with bad SHA-1; 2-> file found and ok
  mIndex, CurrentGameStatus: Integer;
  CurrentScanMode: Byte;
  DeviceSetsList: TStringList;
  IsNewFileFormat: Boolean;
  //iUpdateGamesText: String;

  procedure UpdateGameInfoFile;
  var
    gIndex: Integer;
  begin
    // this function should update "system_name.elstatus"
    ChangeGameStatus:= False;
    if TEasyGameInfo(ItemAudit).eScanMode <> PopupSelectScanGamesMode.Tag then
       TEasyGameInfo(ItemAudit).eScanMode:= PopupSelectScanGamesMode.Tag;
    if TempGameVars.eScanMode <> PopupSelectScanGamesMode.Tag then
       TempGameVars.eScanMode:= PopupSelectScanGamesMode.Tag;

    ROMDataLine:= PopulateGameStatusDataLine;

    gIndex:= ScanGameStatusList.IndexOf(TempGameVars.eName); // for faster gamename searching
    if gIndex <> -1 then
       CompleteGamesList[gIndex]:= ROMDataLine
    else
       CompleteGamesList.Add(ROMDataLine); // this should NEVER happen, but to avoid game not updating...
  end;

  function GetZipContents(ZipFileName: String; const GameMode: ShortInt): Boolean;
  var
    ArchiveItem: TZFArchiveItem;
  begin
    // "ParentZipContents" could be removed, ROMs of both parent set + clone set could be added to the same list ZipContents (March 11, 2018)
    case GameMode of
      0, 2: // game (February 20, 2018) ...bios/device is no more
        begin
          ZipContents.BeginUpdate;
          if GameMode = 0 then
             ZipContents.Clear;
        end;
      1: // parent
        begin
          ParentZipContents.BeginUpdate;
          ParentZipContents.Clear;
        end;
    end;

    Result:= FileExists(ZipFileName);
    if not Result then
       Exit;
    with ZipForge do
    begin
      FileName:= ZipFileName;

      // Open existing archive file
      try
        OpenArchive(fmOpenRead or fmShareDenyNone);

        Result:= FileCount > 0;
        if Result then
           begin
             // Search text files stored inside the archive
             if FindFirst('*.*', ArchiveItem) then
                begin
                  case GameMode of
                    0, 2: // game (February 20, 2018) ...bios/device is no more
                      begin
                        repeat
                          ZipContents.Add(LowerCase(IntToHex(ArchiveItem.CRC, 8)));
                        until (not FindNext(ArchiveItem));
                      end;
                    1: // parent
                      begin
                        repeat
                          ParentZipContents.Add(LowerCase(IntToHex(ArchiveItem.CRC, 8)));
                        until (not FindNext(ArchiveItem));
                      end;
                  end;
                end
             else
                Result:= False;
           end;
        CloseArchive;
        ZipForge.FileName:= '';
      except
        Result:= False;
        CloseArchive;
        ZipForge.FileName:= '';
      end;
    end;
    case GameMode of
      0, 2: ZipContents.EndUpdate; // game (February 20, 2018) ... bios/device is no more
      1: ParentZipContents.EndUpdate; // parent
    end;
  end;

  function GetSevenZipContents(SevenZipFileName: String; const GameMode: ShortInt): Boolean;
  var
    ArchiveItem: I7zInArchive;
    Loop7z: Integer;
  begin
    case GameMode of
      0, 2: // game (February 20, 2018) ...bios/device is no more
        begin
          ZipContents.BeginUpdate;
          if GameMode = 0 then
             ZipContents.Clear;
        end;
      1: // parent
        begin
          ParentZipContents.BeginUpdate;
          ParentZipContents.Clear;
        end;
    end;

    Result:= FileExists(SevenZipFileName);
    if not Result then
       Exit;
       
    try
      ArchiveItem:= CreateInArchive(CLSID_CFormat7z);
    except
      case GameMode of
        0, 2: ZipContents.EndUpdate; // game (February 20, 2018) ...bios/device is no more
        1: ParentZipContents.EndUpdate; // parent
      end;
      Result:= False;
      Exit;
    end;

    with ArchiveItem do
    begin
      // Open existing archive file
      try
        OpenFile(SevenZipFileName);

        Result:= NumberOfItems > 0;
        if Result then
           begin
             // Search text files stored inside the archive
             for Loop7z:= 0 to NumberOfItems-1 do
             begin
               if not ItemIsFolder[Loop7z] then
                  begin
                    case GameMode of
                      0, 2: // game (February 20, 2018) ...bios/device is no more
                        begin
                          ZipContents.Add(LowerCase(IntToHex(ItemCRC[Loop7z], 8)));
                        end;
                      1: // parent
                        begin
                          ParentZipContents.Add(LowerCase(IntToHex(ItemCRC[Loop7z], 8)));
                        end;
                    end;
                  end;
             end;
           end;
        Close;
      except
        Result:= False;
        Close;
      end;
    end;
    case GameMode of
      0, 2: ZipContents.EndUpdate; // game (February 20, 2018) ...bios/device is no more
      1: ParentZipContents.EndUpdate; // parent
    end;
  end;

  function AddMissingROM(const miss_romName, miss_romCRC32, miss_romSHA1: String; romStatus: ShortInt; IsCHDFile: Boolean): Boolean;
  var
    AddGame: Boolean;
    Loop: ShortInt;
  begin
    // romStatus = 0 -> file missing; 1 -> CHD file found with bad SHA-1
    AddGame:= GameFound;
    if not AddGame then
       begin
         if not GameHaveROMs(TempGameVars.eHaveGameROMs) then // for Taito GNET and others
            begin
              AddGame:= BiosFound or (romStatus = 1);
            end
         else
         begin
           if TempGameVars.eROMsAllNoDump and IsCHDFile then
              begin
                AddGame:= romStatus = 1;
                StatusCHD:= 1;
              end
           else
           if GameIsClone(TempGameVars.eClone) and (ParentGameFound) then
              AddGame:= True;
         end;
       end;
    Result:= AddGame;
    if AddGame then
       begin
         if not MissingROMsHeader then
            begin
              ScanResultsIni.EraseSection(TempGameVars.eName);
              MissingROMsHeader:= True;

              if GameHaveROMs(TempGameVars.eHaveGameROMs) then
                 ScanResultsIni.WriteInteger(TempGameVars.eName, 'zip_game', Ord(GameFound));
              if GameIsClone(TempGameVars.eClone) then
                 begin
                   if GameHaveROMs(TempGameVars.eHaveGameROMs) then
                      ScanResultsIni.WriteInteger(TempGameVars.eName, 'zip_parentgame', Ord(ParentGameFound));
                 end;
              if IsSegaModel2 then
                 begin
                   if ValidateBiosName('model2', TempGameVars.eName) then
                      ScanResultsIni.WriteInteger(TempGameVars.eName, 'zip_bios', Ord(BiosFound));
                 end
              else
              if ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) then
                 ScanResultsIni.WriteInteger(TempGameVars.eName, 'zip_bios', Ord(BiosFound));
              if (not IsROM_Device(TempGameVars.eROMIdentification)) and (TEasyGameInfo(ItemAudit).eDeviceSets <> nil) then
                 begin
                   for Loop:=0 to DeviceSetsList.Count-1 do
                   begin
                     ScanResultsIni.WriteString(TempGameVars.eName, 'device'+IntToStr(Loop+1), DeviceSetsList.Names[Loop]);
                     ScanResultsIni.WriteString(TempGameVars.eName, 'zip_device'+IntToStr(Loop+1), DeviceSetsList.ValueFromIndex[Loop]);
                   end;
                 end;
            end;
         // romStatus (updated info to EL v5.7.5)
         // 0 -> file not found (ROM or CHD)
         // 1 -> CHD file found with bad checksum or invalid header

         // crc;sha1=0
         ScanResultsIni.WriteInteger(TempGameVars.eName, FormMain.GetMissCheckEntry(miss_romCRC32, miss_romSHA1), romStatus);
         TempGameVars.eGameSetStatus:= 1; // gamename.zip found with missing ROMs/CHDs or bad CHD checksum
       end
    else
       begin
         TempGameVars.eGameSetStatus:= 2;
       end;
  end;

  function ValidateROMs(const IsClone: Boolean; ScanMode: Byte): Boolean;
  var
    Loop, chdIndexPos: Integer;
    Continue: Boolean;
    chdName, chdParentName, chdChecksum: String;
    chdHeaderVersion: Byte;
    romDeviceName, romName, romCRC32, romSHA1, LineStr: String;
    romIsDevice, romIsBios, romIsCHD: Integer; // MAME/HBMAME only
    FoundCHD: Integer;
    FoundGameCHDs: Integer;
    GameCHDsCount: Integer;

    FoundGameROMs: Integer; // must do this to properly set a merged clone when there are CHDs and they are missing (game is still merged!)
    GameROMsCount: Integer;
    ParentGameROMsCount: Integer; // for clone sets like "redearth1"; - have CHD files and have PARENT ROM files (no clone game ROM files)

    TotalFoundGameROMs: Integer;
    TotalGameROMs: Integer;
    IsCRC32Collision, ResultCHDs, IsParentROM, CheckMerged: Boolean;
  begin
    // this function is only called in the "Full Scan" mode, quick scan mode never uses this function
    // ScanMode always default to 0: Full Scan
    Continue:= GameFound;
    case ScanMode of
      0:
        begin
          // full scan mode only
          if (not Continue) and IsClone then
             Continue:= ParentGameFound;

          if (not Continue) and (not IsSegaModel2) then
             Continue:= BiosFound; // only continues if is not SegaModel2 system as model2 board ROMs is fixed! (to avoid mark a game as missing ROMs if no parent or clone sets are found)
        end;
      1:
        begin
          // this situation should never happen (September 25, 2016)
        end;
    end;

    FoundCHD:= 0;
    FoundGameCHDs:= 0;
    GameCHDsCount:= 0;
    StatusCHD:= 0; // all CHD files are missing ; 0: missing; 1: found with bad SHA-1; 2: found and OK

    FoundGameROMs:= 0; // must do this to properly set a merged clone when there are CHDs and they are missing (game is still merged!!!!
    GameROMsCount:= 0; // cannot count parent game ROMs, only game ROMs and must ignore the ones with "nodump" tag
    CheckMerged:= False;

    TotalFoundGameROMs:= 0;
    TotalGameROMs:= 0;

    ParentGameROMsCount:= 0;

    if not Continue then
       begin
         if IsMAMEBasedSys(TempGameVars.eSystemID) then
            begin
              // no game ROMs, but have CHDs; create a count of CHDs and later check if all are missing
              if ((not GameHaveROMs(TempGameVars.eHaveGameROMs)) and IsMediaTypeCHD(TempGameVars.eMediaType, False)) or
                 (TempGameVars.eROMsAllNoDump and IsMediaTypeCHD(TempGameVars.eMediaType, False)) and (not TempGameVars.eGameROMsNoDump) then
                 Continue:= TempGameVars.eCHDsCount > 0;
              if not Continue then
                 begin
                   // for machine sets with no ROMs but with device ROMs (Alto-II)
                   if (not GameHaveROMs(TempGameVars.eHaveGameROMs)) and (TEasyGameInfo(ItemAudit).eDeviceSets <> nil) then
                      Continue:= True;
                 end;
            end;
       end;

    Result:= Continue;
    if not Continue then
       begin
         TempGameVars.eGameSetStatus:= 2; // missing (no .zip files found)
         Exit;
       end;

    if TEasyGameInfo(ItemAudit).eROMInfo <> nil then
    begin
      CheckMerged:= IsMAMEBasedSys(TempGameVars.eSystemID) and //(TempGameVars.eSoftwareName = '') and
                    GameIsClone(TempGameVars.eClone) and GameHaveROMs(TempGameVars.eHaveGameROMs);// and (not TempGameVars.eGameROMsNoDump);

      IsNewFileFormat:= PosEx('<name>', TEasyGameInfo(ItemAudit).eROMInfo[0]) <> 0;
      for Loop:=0 to TEasyGameInfo(ItemAudit).eROMInfo.Count-1 do
      begin
        LineStr:= TEasyGameInfo(ItemAudit).eROMInfo[Loop];
        romIsDevice:= 0;
        romIsBios:= 0;
        romIsCHD:= 0;
        if IsNewFileFormat then
           begin
             // latest format... must add detection of "IsParentSetFile" for clone sets and for proper "merged" tag detection
             // FileID MediaType IsCRC32Collision IsBadDump IsParentSetFile<name>Filename/><crc>CRC32/><sha1>/SHA-1 or MD5/><part_name>MediaID/><part_title>MediaTitle/><parentname>parent_filename/><optional>1/><mediatype_tag>media_tag_index/><devicename>device_setname/>

             // FileID MediaType CRC32_collision IsBadDump IsParentSetFile <name>...
             // 15100<name>simpbowl.chd/><sha1>72b32a863e6891ad3bfc1fdfe9cb90a2bd334d71/>

             IsCRC32Collision:= Boolean(StrToInt(LineStr[4]));
             romIsCHD:= StrToInt(LineStr[3]);
             IsParentROM:= Boolean(StrToInt(LineStr[6])); // added November 19, 2018
             GetROMDetailsInfo(LineStr, IsClone, romName, romCRC32, romSHA1, chdParentName, romDeviceName);

             if IsROMsListBasedSys(TempGameVars.eSystemID) then
                begin
                  chdIndexPos:= StrToInt(LineStr[1]+LineStr[2]);
                  if IsFileID_DeviceROM(chdIndexPos) or IsFileID_DeviceCHD(chdIndexPos) then
                     romIsDevice:= 1
                  else
                  if IsFileID_BiosROM(chdIndexPos) or IsFileID_BiosCHD(chdIndexPos) then
                     romIsBios:= 1;
                end;
             case romIsCHD of
               0: Continue:= romCRC32 <> ''; // need to set this to TRUE or games won't be audited correctly
               1: Continue:= romSHA1 <> '';  // Continue is FALSE if ROM/CHD is tagged "nodump" (no CRC32 or SHA1 checksums)
             end;
           end;

        if Continue then
           begin
             if romIsCHD = 1 then
                begin
                  chdName:= romName; // got it upstairs (August 2017)
                  DiskFile:= SearchCHDSimpleScan(TempGameVars.eSystemID, chdName, chdParentName, TempGameVars.eName, TempGameVars.eClone, TempGameVars.eBiosName, TempGameVars.eSoftwareName);
                  Continue:= DiskFile = '';

                  if IsMAMEBasedSys(TempGameVars.eSystemID) and (TempGameVars.eSoftwareName = '') then
                  begin
                    if IsROM_Bios(TempGameVars.eROMIdentification) then
                       begin
                         if IsFileID_BiosCHD(chdIndexPos) then
                            Inc(GameCHDsCount);
                       end
                    else
                    if IsROM_Device(TempGameVars.eROMIdentification) then
                       begin
                         if IsFileID_DeviceCHD(chdIndexPos) then
                            Inc(GameCHDsCount);
                       end
                    else
                       begin
                         if FormMain.IsFileID_GameCHD(chdIndexPos) then
                            Inc(GameCHDsCount);
                       end
                  end;

                  case Continue of
                    True:
                      begin
                        // CHD not found
                        Result:= False;
                        case GameHaveROMs(TempGameVars.eHaveGameROMs) of
                          True:
                            begin
                              case ScanMode of
                                0: // full scan
                                  begin
                                    AddMissingROM(chdName, romCRC32, romSHA1, 0, True);
                                    if chdParentName <> '' then
                                       AddMissingROM(chdParentName, romCRC32, romSHA1, 0, True);
                                  end;
                                1: // quick scan
                                  begin
                                    if GameFound then
                                       TempGameVars.eGameSetStatus:= 1; // gamename.zip found but one or more CHDs are missing
                                  end;
                              end;
                            end;
                          False:
                            begin
                              // no need to be here as StatusCHD is already set to 0 above
                              //StatusCHD:= 0; // missing CHD // this is for TaitoGNET and others -> have bios+chd but no game set required
                            end;
                        end;
                      end;
                    False:
                      begin
                        // file found, read version and SHA-1/MD5 from CHD's header
                        Inc(FoundCHD);
                        case ScanMode of
                          0: // full scan
                            begin
                              if IsMAMEBasedSys(TempGameVars.eSystemID) and (TempGameVars.eSoftwareName = '') then
                              begin
                                if IsROM_Bios(TempGameVars.eROMIdentification) then
                                   begin
                                     if IsFileID_BiosCHD(chdIndexPos) then
                                        Inc(FoundGameCHDs);
                                   end
                                else
                                if IsROM_Device(TempGameVars.eROMIdentification) then
                                   begin
                                     if IsFileID_DeviceCHD(chdIndexPos) then
                                        Inc(FoundGameCHDs);
                                   end
                                else
                                   begin
                                     if FormMain.IsFileID_GameCHD(chdIndexPos) then
                                        Inc(FoundGameCHDs);
                                   end
                              end;
                              case CreateCHD_SHA1(DiskFile, romSHA1, chdChecksum, chdHeaderVersion) of
                                True :
                                  begin
                                    if StatusCHD <> 2 then
                                       StatusCHD:= 1; // found and OK
                                  end;
                                False:
                                  begin
                                    Result:= False;
                                    // invalid header TAG/version or bad SHA-1 checksum
                                    // 'chdChecksum' holds the SHA-1/MD5 from .chd header (not from MAME)
                                    AddMissingROM(ExtractFileName(DiskFile), romCRC32, romSHA1, 1, True);
                                    StatusCHD:= 2; // file found with bad SHA-1/MD5
                                  end;
                              end;
                            end;
                          1: // quick scan
                            begin
                              StatusCHD:= 1; // file found but SHA-1 / MD5 is not validated here
                            end;
                        end;
                      end;
                  end;
                end
             else
                begin
                  // ROMs
                  if ScanMode = 0 then
                     begin
                       if CheckMerged then
                       begin
                         if IsROM_Bios(TempGameVars.eROMIdentification) then
                            begin
                              if FormMain.IsFileID_BiosROM(chdIndexPos) or
                                 FormMain.IsFileID_BiosCHD(chdIndexPos) then
                                 begin
                                   if not IsParentROM then
                                      Inc(GameROMsCount)
                                   else
                                      Inc(ParentGameROMsCount);
                                 end;
                            end
                         else
                         if IsROM_Device(TempGameVars.eROMIdentification) then
                            begin
                              if IsFileID_DeviceROM(chdIndexPos) or
                                 IsFileID_DeviceCHD(chdIndexPos) then
                                 begin
                                   if not IsParentROM then
                                      Inc(GameROMsCount)
                                   else
                                      Inc(ParentGameROMsCount);
                                 end;
                            end
                         else
                            begin
                              if IsFileID_GameROM(chdIndexPos) or
                                 IsFileID_GameCHD(chdIndexPos) then
                                 begin
                                   if not IsParentROM then
                                      Inc(GameROMsCount)
                                   else
                                      Inc(ParentGameROMsCount);
                                 end;
                            end;
                       end;
                       Inc(TotalGameROMs);

                       // full scan
                       if IsCRC32Collision then
                       begin
                         if romIsDevice = 1 then
                            begin
                              if Assigned(DeviceSetsSHA1ZipContents) then
                              begin
                                 if IsROM_Device(TempGameVars.eROMIdentification) then
                                    Continue:= DeviceSetsSHA1ZipContents.IndexOf(TempGameVars.eName+'='+romSHA1) = -1 // it's a device set
                                 else
                                    Continue:= DeviceSetsSHA1ZipContents.IndexOf(romDeviceName+'='+romSHA1) = -1;
                              end;
                            end
                         else
                         if romIsBios = 1 then
                            begin
                              if Assigned(BiosSetsSHA1ZipContents) then
                                begin
                                   if IsROM_Bios(TempGameVars.eROMIdentification) then
                                      Continue:= BiosSetsSHA1ZipContents.IndexOf(TempGameVars.eName+'='+romSHA1) = -1 // it's a bios set
                                   else
                                      begin
                                        if TempGameVars.eSystemID <> idSegaModel2 then
                                           begin
                                             if TempGameVars.eBiosName <> '' then
                                                Continue:= BiosSetsSHA1ZipContents.IndexOf(TempGameVars.eBiosName+'='+romSHA1) = -1;
                                           end
                                        else
                                           begin
                                             // special case for SEGA Model 2 board ROMs (model2.zip)
                                             //Continue:= BiosSetsSHA1ZipContents.IndexOf(TempGameVars.eBiosName+'='+romSHA1) = -1;
                                             Continue:= BiosSetsSHA1ZipContents.IndexOf('model2='+romSHA1) = -1;
                                           end;
                                      end;
                                end;
                            end;
                         // there is no CRC32 collision checks for game ROMs (verified until MAME 0.195) as there are no game ROMs with CRC32 collision (March 01, 2018)
                       end
                       else
                       begin
                         // search rom in device or bios "ZipContents" vars (no CRC32 collision situation)
                         if romIsDevice = 1 then
                            begin
                              if Assigned(DeviceSetsZipContents) then
                              begin
                                 if IsROM_Device(TempGameVars.eROMIdentification) then
                                    Continue:= DeviceSetsZipContents.IndexOf(TempGameVars.eName+'='+romCRC32) = -1 // it's a device set
                                 else
                                    Continue:= DeviceSetsZipContents.IndexOf(romDeviceName+'='+romCRC32) = -1;
                              end;
                            end
                         else
                         if romIsBios = 1 then
                            begin
                              if Assigned(BiosSetsZipContents) then
                                begin
                                   if IsROM_Bios(TempGameVars.eROMIdentification) then
                                      Continue:= BiosSetsZipContents.IndexOf(TempGameVars.eName+'='+romCRC32) = -1 // it's a bios set
                                   else
                                      begin
                                        if TempGameVars.eSystemID <> idSegaModel2 then
                                           begin
                                             if TempGameVars.eBiosName <> '' then
                                                Continue:= BiosSetsZipContents.IndexOf(TempGameVars.eBiosName+'='+romCRC32) = -1;
                                           end
                                        else
                                           begin
                                             // special case for SEGA Model 2 board ROMs (model2.zip)
                                             //Continue:= BiosSetsZipContents.IndexOf(TempGameVars.eBiosName+'='+romCRC32) = -1;
                                             Continue:= BiosSetsZipContents.IndexOf('model2='+romCRC32) = -1;
                                           end;
                                      end;
                                end;
                            end;

                         if Continue then
                            begin
                              // if ROM is device or bios and not found, search in gamename.zip
                              // if ROM is a game ROM, search in gamename.zip
                              if Assigned(ZipContents) then
                                 Continue:= ZipContents.IndexOf(romCRC32) = -1;
                            end;

                         if Continue and IsClone then
                            begin
                              // if ROM is device or bios and not found, search in parentgamename.zip
                              // if ROM is a game ROM, search in parentgamename.zip
                              if Assigned(ParentZipContents) then
                                 Continue:= ParentZipContents.IndexOf(romCRC32) = -1;
                            end;
                       end;

                       if not Continue then
                          begin
                            if CheckMerged then
                            begin
                              if IsROM_Bios(TempGameVars.eROMIdentification) then
                                 begin
                                   if FormMain.IsFileID_BiosROM(chdIndexPos) or
                                      FormMain.IsFileID_BiosCHD(chdIndexPos) then
                                      begin
                                        if not IsParentROM then
                                           Inc(FoundGameROMs);
                                      end;
                                 end
                              else
                              if IsROM_Device(TempGameVars.eROMIdentification) then
                                 begin
                                   if IsFileID_DeviceROM(chdIndexPos) or
                                      IsFileID_DeviceCHD(chdIndexPos) then
                                      begin
                                        if not IsParentROM then
                                           Inc(FoundGameROMs);
                                      end;
                                 end
                              else
                                 begin
                                   if FormMain.IsFileID_GameROM(chdIndexPos) or
                                      FormMain.IsFileID_GameCHD(chdIndexPos) then
                                      begin
                                        if not IsParentROM then
                                           Inc(FoundGameROMs);
                                      end;
                                 end;
                            end;
                            Inc(TotalFoundGameROMs);
                          end;
                       if Continue then
                          begin
                            Result:= False;
                            AddMissingROM(romName, romCRC32, romSHA1, 0, False);
                          end;
                     end;
                end;
           end;
      end;
    end;

    if IsMAMEBasedSys(TempGameVars.eSystemID) {and (TempGameVars.eSoftwareName = '') }and GameHaveROMs(TempGameVars.eHaveGameROMs) then
       begin
         if GameIsClone(TempGameVars.eClone) then
            begin
              if TempGameVars.eGameROMsNoDump then //and TempGameVars.eParentGameROMsNoDump then
                 begin
                   if GameCHDsCount > 0 then
                      begin
                        {if GameHaveROMs(TempGameVars.eHaveGameROMs) then
                           begin
                             if GameROMsCount <> FoundGameROMs then
                                TempGameVars.eGameSetStatus:= 2;
                           end
                        else}
                        if FoundGameCHDs = 0 then
                           begin
                             if (TotalGameROMs = 0) or
                                ((TotalGameROMs > 0) and (TotalFoundGameROMs = 0)) or
                                ((TotalGameROMs > 0) and ((not ParentGameFound) and (not TempGameVars.eParentGameROMsNoDump))) then
                                //(TotalFoundGameROMs = ParentGameROMsCount) then
                                begin
                                  Result:= False;
                                  TempGameVars.eGameSetStatus:= 2; // no game CHDs found
                                end;
                           end;
                      end
                   else
                      begin
                        if not TempGameVars.eParentGameROMsNoDump then
                           begin
                             if not ParentGameFound then
                                begin
                                  Result:= False;
                                  TempGameVars.eGameSetStatus:= 2; // no game ROMs found
                                end;
                           end
                        else
                           begin
                             if (TotalGameROMs > 0) and (TotalFoundGameROMs = 0) then
                                begin
                                  Result:= False;
                                  TempGameVars.eGameSetStatus:= 2; // no game ROMs found
                                end;
                           end;
                      end;
                 end
              else
                 begin
                   if (not GameFound) and (ParentGameFound) and (not TempGameVars.eROMsAllNoDump) then
                      begin
                        if GameROMsCount > 0 then
                           TempGameVars.eIsMerged:= GameROMsCount = FoundGameROMs;

                        if (not Result) and (TotalGameROMs > 0) then //and (FoundGameROMs > 0) then
                           begin
                             if FoundGameROMs > 0 then
                             begin
                               if TotalFoundGameROMs <> TotalGameROMs then
                               begin
                                 if ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) or (TEasyGameInfo(ItemAudit).eDeviceSets <> nil) then
                                    TempGameVars.eGameSetStatus:= 1
                                 else
                                 if GameROMsCount = FoundGameROMs then
                                    TempGameVars.eGameSetStatus:= 1
                                 else
                                    TempGameVars.eGameSetStatus:= 2;
                               end;
                             end
                             else
                             begin
                                TempGameVars.eGameSetStatus:= 2;
                             end;
                           end;

                        if TempGameVars.eGameSetStatus = 1 then
                           begin
                             if GameROMsCount > 0 then
                                begin
                                  if ParentGameROMsCount = GameROMsCount then
                                     TempGameVars.eGameSetStatus:= 2;
                                end;
                           end;
                      end;
                 end;
            end
         else
            begin
              //if TempGameVars.eGameROMsNoDump then
                 begin
                   if GameCHDsCount > 0 then
                      begin
                        if (FoundGameCHDs = 0) and (TempGameVars.eGameROMsNoDump) then
                           begin
                             Result:= False;
                             TempGameVars.eGameSetStatus:= 2; // no game CHDs found
                           end;
                      end
                   else
                      begin
                        if (TotalGameROMs > 0) and (TotalFoundGameROMs = 0) then
                           begin
                             Result:= False;
                             TempGameVars.eGameSetStatus:= 2; // no game ROMs found
                           end;
                      end;
                 end;
            end;
       end;

    if Result then
       begin
         TempGameVars.eGameSetStatus:= 0; // game is ok
         if PopupSelectScanGamesMode.Tag = 0 then // full scan
         begin
           if IsMAMEBasedSys(TempGameVars.eSystemID) or (TempGameVars.eSystemID = idSupermodel) then
           begin
             if GameIsClone(TempGameVars.eClone) then
             begin
               // merged sets only for MAME/HBMAME; sets without gamename.zip like Taito G-NET must be excluded
               //if (not IsMediaTypeCHD(TempGameVars.eMediaType, False)) and GameHaveROMs(TempGameVars.eHaveGameROMs) and
               //   (not GameFound) and (ParentGameFound) and (not TempGameVars.eROMsAllNoDump) then
               if GameHaveROMs(TempGameVars.eHaveGameROMs) and
                  (not GameFound) and (ParentGameFound) and (not TempGameVars.eROMsAllNoDump) then
                TempGameVars.eIsMerged:= True;
             end;
           end;
         end;
       end
    else
       begin
         if IsMAMEBasedSys(TempGameVars.eSystemID) then
            begin
              if IsMediaTypeCHD(TempGameVars.eMediaType, False) then
                 begin
                   case GameHaveROMs(TempGameVars.eHaveGameROMs) of
                     True:
                       begin
                         if ScanMode = 0 then
                         begin
                           if TempGameVars.eGameSetStatus = 1 then
                              begin
                                if FoundGameCHDs = 0 then
                                   begin
                                     if TempGameVars.eCHDParentROMsOnlyCloneSet or
                                        (TempGameVars.eGameROMsNoDump and TempGameVars.eParentGameROMsNoDump) then
                                        begin
                                          TempGameVars.eGameSetStatus:= 2;
                                        end;
                                   end;
                              end
                           else
                           if TempGameVars.eIsMerged then
                              TempGameVars.eGameSetStatus:= 1; // game ROMs merged but CHD is "bad checksum"
                         end
                         else
                         if ScanMode = 1 then
                         begin
                           if not GameFound then
                              TempGameVars.eGameSetStatus:= 2 // game must be set as missing
                           else
                              begin
                                if FoundCHD <> TempGameVars.eCHDsCount then
                                   TempGameVars.eGameSetStatus:= 1; // found gamename.zip but one or more CHD files are missing
                              end;
                         end;
                       end;
                     False:
                       begin
                         if FoundCHD = 0 then
                            begin
                              TempGameVars.eGameSetStatus:= 2; // game must be set as missing since no CHD files were found
                            end;
                       end;
                   end;
                 end;
            end;
       end;
    if TempGameVars.eGameSetStatus = 2 then
       ScanResultsIni.EraseSection(TempGameVars.eName);
  end;

  function FindZiNcFile(const NameString: String): String;
  begin
    Result:= '';
    if ZiNcFilePath <> '' then
       begin
         if FileExists(ZiNcFilePath+NameString+'.zip') then
            Result:= ZiNcFilePath+NameString+'.zip';
       end;
  end;

begin
  CurrentGameStatus:= TempGameVars.eGameSetStatus;
  //iUpdateGamesText:= '';
  CurrentScanMode:= TEasyGameInfo(ItemAudit).eScanMode;
  TempGameVars.eGameSetStatus:= 0;
  TempGameVars.eIsMerged:= False;
  case PopupSelectScanGamesMode.Tag of
    2: ValidateStatus:= True; // set all games available ("Force Games Available" scan mode)
    1: // quick scan
      begin
        ContinueAudit:= True;
        ValidateStatus:= False;
        TempGameVars.eGameSetStatus:= 2;
        MissingROMsHeader:= False;
        ZiNcFilePath:= '';
        IsZiNcSystem:= TempGameVars.eSystemID = idZiNc;
        IsSupermodelSystem:= TempGameVars.eSystemID = idSupermodel;
        IsSegaModel2:= TempGameVars.eSystemID = idSegaModel2;

        if IsROMsListBasedSys(TempGameVars.eSystemID) then
           begin
             if TEasyGameInfo(ItemAudit).eROMInfo = nil then
                begin
                  // there are no ROMs for the current set (MAME sets like "a2600", "nes")
                  // also for DICE emulator
                  TempGameVars.eGameSetStatus:= 0;
                  ValidateStatus:= True;
                  ContinueAudit:= False; // no need further .zip search, set as available (no ROMs detected)
                end
             else
             begin
               if TEasyGameInfo(ItemAudit).eROMsAllNoDump and (TEasyGameInfo(ItemAudit).eCHDsCount = 0) then
                  begin
                    TempGameVars.eGameSetStatus:= 0; // game is set as "good"
                    ValidateStatus:= True;
                    ContinueAudit:= False; // no need gameset validation as all ROMs are tagged nodump... there's nothing to validate
                  end;
             end;
           end;
        if ContinueAudit then
          begin
            // for all games with ROMs lists
            if GameHaveROMs(TempGameVars.eHaveGameROMs) then
               ZipFile:= SearchZIPFolder(TempGameVars.eName, TempGameVars.eSystemID, TempGameVars.eSoftwareName)
            else
               ZipFile:= '';

            GameFound:= ZipFile <> '';
                
            if (not GameFound) and GameHaveROMs(TempGameVars.eHaveGameROMs) and (TempGameVars.eCHDsCount = 0) then
               begin
                 // game have ROMs but gamename.zip is not found; do not look for other files: bios, device, CHDs
                 // necessary to avoid setting clone games as available
                 ContinueAudit:= False;
               end;
            if ContinueAudit then
            begin
              case IsROMsListBasedSys(TempGameVars.eSystemID) of
                True:
                  begin
                    // search for bios set
                    ParentGameFound:= False; // this is not used by quick scan
                    BiosFound:= False;

                    if GameFound then
                       begin
                         if IsZiNcSystem then
                            ZiNcFilePath:= ExtractFilePath(ZipFile);
                       end;

                    if IsSegaModel2 then
                       BiosFound:= True // need to detect model2.zip (Board ROMs) or "SEGA Model 2 Emulator" games do not run
                    else
                       BiosFound:= ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName);
                    if BiosFound then
                       begin
                         case IsZiNcSystem of
                           True : BiosZipFile:= FindZiNcFile(TempGameVars.eBiosName);
                           False:
                             begin
                               if IsSegaModel2 then
                                  BiosZipFile:= SearchZIPFolder('model2', TempGameVars.eSystemID)
                               else
                                  BiosZipFile:= SearchZIPFolder(TempGameVars.eBiosName, TempGameVars.eSystemID, TempGameVars.eSoftwareName);
                             end;
                         end;
                         BiosFound:= BiosZipFile <> '';
                         if not BiosFound then
                            ContinueAudit:= False;
                       end;
                    if ContinueAudit then
                    begin
                      if TEasyGameInfo(ItemAudit).eDeviceSets <> nil then
                      begin
                        for mIndex:=0 to TEasyGameInfo(ItemAudit).eDeviceSets.Count-1 do
                        begin
                          if SearchZIPFolder(TEasyGameInfo(ItemAudit).eDeviceSets[mIndex], TempGameVars.eSystemID) = '' then
                             begin
                               ContinueAudit:= False;
                               Break;
                             end;
                        end;
                      end;
                    end;
                    if ContinueAudit then
                    begin
                      // look for CHD files
                      if TempGameVars.eCHDsCount > 0 then
                      begin
                        if TEasyGameInfo(ItemAudit).eROMInfo <> nil then
                        begin
                          for mIndex:=0 to TEasyGameInfo(ItemAudit).eROMInfo.Count-1 do
                          begin
                            CHDLine:= TEasyGameInfo(ItemAudit).eROMInfo[mIndex];
                            if CHDLine[3] = '1' then // if CHDLine[3] = '0' means it's "<rom" entry, not "<disk"
                               // this is necessary because a <rom entry can be "compact flash card" type; this type can also be a <disk entry!!!
                            begin
                              if StrToInt(CHDLine[1]+CHDLine[2]) >= 12 then
                                 begin
                                   ParentCHDLine:= SoftListGetEntryValue(CHDLine, 'parentname');
                                   CHDLine:= SoftListGetEntryValue(CHDLine, 'name');
                                   DiskFile:= SearchCHDSimpleScan(TempGameVars.eSystemID, CHDLine, ParentCHDLine, TempGameVars.eName, TempGameVars.eClone, TempGameVars.eBiosName, TempGameVars.eSoftwareName);
                                   if DiskFile = '' then
                                      begin
                                        ContinueAudit:= False;
                                        Break;
                                      end;
                                 end;
                            end;
                          end;
                        end;
                      end;
                    end;
                  end;
                False:
                  begin
                    case TempGameVars.eSystemID of
                      idDaphne: ValidateStatus:= GameFound; // Daphne
                    end;
                  end;
              end;
            end;
          end;
        if ContinueAudit then
           begin
             TempGameVars.eGameSetStatus:= 0; // set it to available
             ValidateStatus:= True; // all required files found
           end;
      end;
    0: // full scan
      begin
        ContinueAudit:= True;
        ValidateStatus:= False;
        TempGameVars.eGameSetStatus:= 2;
        MissingROMsHeader:= False;
        ZiNcFilePath:= '';
        IsZiNcSystem:= TempGameVars.eSystemID = idZiNc;
        IsSupermodelSystem:= TempGameVars.eSystemID = idSupermodel;
        IsSegaModel2:= TempGameVars.eSystemID = idSegaModel2;

        if IsROMsListBasedSys(TempGameVars.eSystemID) then
           begin
             if TEasyGameInfo(ItemAudit).eROMInfo = nil then
                begin
                  // there are no ROMs for the current set (MAME sets like "a2600", "nes")
                  // also for DICE emulator
                  TempGameVars.eGameSetStatus:= 0;
                  ValidateStatus:= True;
                  ContinueAudit:= False; // no need further .zip validation, set as available (no ROMs detected)
                end
             else
             begin
               if TEasyGameInfo(ItemAudit).eROMsAllNoDump and (TEasyGameInfo(ItemAudit).eCHDsCount = 0) then
                  begin
                    TempGameVars.eGameSetStatus:= 0; // game is set as "good"
                    ValidateStatus:= True;
                    ContinueAudit:= False; // no need gameset validation as all ROMs are tagged nodump... there's nothing to validate
                  end;
             end;
           end;
        if ContinueAudit then
          begin
            // games with ROMs
            if GameHaveROMs(TempGameVars.eHaveGameROMs) then // device/bios sets are set as "Have ROMs"
               ZipFile:= SearchZIPFolder(TempGameVars.eName, TempGameVars.eSystemID, TempGameVars.eSoftwareName)
            else
               ZipFile:= '';

            GameFound:= ZipFile <> '';
            if (not GameFound) and TempGameVars.eGameROMsNoDump and GameHaveROMs(TEasyGameInfo(ItemAudit).eHaveGameROMs) then
               GameFound:= True; // added by Ciro (November 14, 2018) -> this is to try scanning sets where game ROMs are "nodump", but there might be other sets (bios, device, CHDs, parent set)

            ParentGameFound:= False;
            BiosFound:= False;
            if TEasyGameInfo(ItemAudit).eDeviceSets <> nil then
               begin
                 // full scan mode
                 // this is only used to show info in "systemname.miss" file
                 DeviceSetsList:= TStringList.Create;
                 DeviceSetsList.BeginUpdate;
                 DeviceSetsList.AddStrings(TEasyGameInfo(ItemAudit).eDeviceSets);

                 for mIndex:=0 to DeviceSetsList.Count-1 do
                     DeviceSetsList[mIndex]:= DeviceSetsList[mIndex]+'='+IntToStr(Ord(SearchZIPFolder(DeviceSetsList[mIndex], TempGameVars.eSystemID) <> ''));
                 DeviceSetsList.EndUpdate;
               end;

            if GameFound then
               begin
                 if IsROMsListBasedSys(TempGameVars.eSystemID) then
                    begin
                      ZipContents:= THashedStringList.Create;
                      if (not IsROM_Device(TempGameVars.eROMIdentification)) and (not IsROM_Bios(TempGameVars.eROMIdentification)) then
                      begin
                        // if device/bios set, there's no need to load this as they are in device/bios ZipContents vars already (February 18, 2018)
                        if SameText(ExtractFileExt(ZipFile), '.7z') then
                           GetSevenZipContents(ZipFile, 0) // parent sets and device sets
                        else
                           GetZipContents(ZipFile, 0); // parent sets and device sets
                      end;
                      if IsZiNcSystem then
                         ZiNcFilePath:= ExtractFilePath(ZipFile);
                    end;
               end;

            if GameIsClone(TempGameVars.eClone) then
               begin
                 case IsROMsListBasedSys(TempGameVars.eSystemID) of
                   True:
                     begin
                       // Supermodel SVN 591 and older need ALL ROMs inside clone .zip file
                       // Supermodel SVN 592 and newer can have all child ROMs in child set or all child ROMs in the parent set (full merged only)
                       if ParentZipContents = nil then
                          begin
                            case IsZiNcSystem of
                              True : CloneZipFile:= FindZiNcFile(TempGameVars.eClone);
                              False: CloneZipFile:= SearchZIPFolder(TempGameVars.eClone, TempGameVars.eSystemID, TempGameVars.eSoftwareName);
                            end;
                            ParentGameFound:= CloneZipFile <> '';
                            if (not ParentGameFound) and TempGameVars.eParentGameROMsNoDump and GameHaveROMs(TEasyGameInfo(ItemAudit).eHaveGameROMs) then
                               ParentGameFound:= True; // added by Ciro (November 14, 2018) -> this is to try scanning sets where game ROMs are "nodump", but there might be other sets

                            if ParentGameFound then
                               begin
                                 ParentZipContents:= THashedStringList.Create;
                                 if SameText(ExtractFileExt(CloneZipFile), '.7z') then
                                    GetSevenZipContents(CloneZipFile, 1) // clones
                                 else
                                    GetZipContents(CloneZipFile, 1); // clones
                               end;
                          end
                       else
                          begin
                            ParentGameFound:= True;
                          end;
                     end;
                   False:
                     begin
                       ParentGameFound:= (SearchZIPFolder(TempGameVars.eClone, TempGameVars.eSystemID) <> '');
                     end;
                 end;
               end;

            if IsSegaModel2 then
               BiosFound:= True // need to get contents of model2.zip
            else
               BiosFound:= ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName);
            if BiosFound then
               begin
                 case IsZiNcSystem of
                   True : BiosZipFile:= FindZiNcFile(TempGameVars.eBiosName);
                   False:
                     begin
                       if IsSegaModel2 then
                          BiosZipFile:= SearchZIPFolder('model2', TempGameVars.eSystemID)
                       else
                          BiosZipFile:= SearchZIPFolder(TempGameVars.eBiosName, TempGameVars.eSystemID, TempGameVars.eSoftwareName);
                     end;
                 end;
                 BiosFound:= BiosZipFile <> '';
               end;

            case GameIsClone(TempGameVars.eClone) of
              True:
                begin
                  case IsROMsListBasedSys(TempGameVars.eSystemID) of
                    True:
                      begin
                        if IsSegaModel2 then
                           begin
                             if GameFound or ParentGameFound then
                                ValidateStatus:= ValidateROMs(True, PopupSelectScanGamesMode.Tag);
                           end
                        else
                           begin
                             if GameFound or ParentGameFound or BiosFound or
                                (TEasyGameInfo(ItemAudit).eROMsAllNoDump and (TEasyGameInfo(ItemAudit).eCHDsCount > 0)) or
                                ((TEasyGameInfo(ItemAudit).eHaveGameROMs = 0) and (TEasyGameInfo(ItemAudit).eDeviceSets <> nil)) or // for Alto-II (no game ROMs but with device ROMs)
                                ((TEasyGameInfo(ItemAudit).eHaveGameROMs = 0) and (TEasyGameInfo(ItemAudit).eCHDsCount > 0)) // no game set but have CHDs
                                then
                                ValidateStatus:= ValidateROMs(True, PopupSelectScanGamesMode.Tag);
                           end;
                      end;
                    False:
                      begin
                        case TempGameVars.eSystemID of
                          idDaphne: ValidateStatus:= GameFound and ParentGameFound; // Daphne
                        end;
                      end;
                  end;
                end;
              False:
                begin
                  case IsROMsListBasedSys(TempGameVars.eSystemID) of
                    True:
                      begin
                        if IsSegaModel2 then
                           begin
                             if GameFound then
                                ValidateStatus:= ValidateROMs(False, PopupSelectScanGamesMode.Tag);
                           end
                        else
                           begin
                             if GameFound or BiosFound or
                                (TEasyGameInfo(ItemAudit).eROMsAllNoDump and (TEasyGameInfo(ItemAudit).eCHDsCount > 0)) or
                                ((TEasyGameInfo(ItemAudit).eHaveGameROMs = 0) and (TEasyGameInfo(ItemAudit).eDeviceSets <> nil)) or // for Alto-II (no game ROMs but with device ROMs)
                                ((TEasyGameInfo(ItemAudit).eHaveGameROMs = 0) and (TEasyGameInfo(ItemAudit).eCHDsCount > 0)) // no game set but have CHDs
                                then
                                ValidateStatus:= ValidateROMs(False, PopupSelectScanGamesMode.Tag);
                           end;
                      end;
                    False:
                      begin
                        case TempGameVars.eSystemID of
                          idDaphne: ValidateStatus:= GameFound;
                        end;
                      end;
                  end;
                end;
            end;
          end;
        FreeAndNil(DeviceSetsList);
        FreeAndNil(ZipContents);
        FreeAndNil(ParentZipContents);
      end;
  end;

  case TempGameVars.eSystemID of
    idDaphne: // no ROMs list
      begin
        if ValidateStatus then
           TempGameVars.eGameSetStatus:= 0; // found gamename.zip file (no ROMs list to audit)
      end;
  end;

  ChangeGameStatus:= True;
  case ValidateStatus of
    True:
      begin
        // game found and it's all ok - change "miss" to "have"
        case TempGameVars.eROMIdentification of
          04: TempGameVars.eROMIdentification:= 00; // MAME Parent
          05: TempGameVars.eROMIdentification:= 01; // MAME Clone
          06: TempGameVars.eROMIdentification:= 02; // MAME BIOS
          07: TempGameVars.eROMIdentification:= 03; // MAME Device

          10: TempGameVars.eROMIdentification:= 08; // Supermodel: SEGA Model 3 Parent
          11: TempGameVars.eROMIdentification:= 09; // Supermodel: SEGA Model 3 Clone

          14: TempGameVars.eROMIdentification:= 12; // Daphne Parent
          15: TempGameVars.eROMIdentification:= 13; // Daphne Clone

          19: TempGameVars.eROMIdentification:= 16; // Demul Parent
          20: TempGameVars.eROMIdentification:= 17; // Demul Clone
          21: TempGameVars.eROMIdentification:= 18; // Demul BIOS

          26: TempGameVars.eROMIdentification:= 22; // HBMAME Parent
          27: TempGameVars.eROMIdentification:= 23; // HBMAME Clone
          28: TempGameVars.eROMIdentification:= 24; // HBMAME BIOS
          29: TempGameVars.eROMIdentification:= 25; // HBMAME Device

          32: TempGameVars.eROMIdentification:= 30; // DICE Parent
          33: TempGameVars.eROMIdentification:= 31; // DICE Clone

          36: TempGameVars.eROMIdentification:= 34; // SEGA Model 2 Parent
          37: TempGameVars.eROMIdentification:= 35; // SEGA Model 2 Clone

          41: TempGameVars.eROMIdentification:= 38; // ZiNc Parent
          42: TempGameVars.eROMIdentification:= 39; // ZiNc Clone
          43: TempGameVars.eROMIdentification:= 40; // ZiNc BIOS
        else
          begin
            if (TEasyGameInfo(ItemAudit).eGameSetStatus = TempGameVars.eGameSetStatus) and
               (TEasyGameInfo(ItemAudit).eScanMode = PopupSelectScanGamesMode.Tag) and
               (TEasyGameInfo(ItemAudit).eIsMerged = TempGameVars.eIsMerged) then
               ChangeGameStatus:= False;
          end;
        end;
        if ChangeGameStatus then
           begin
             if TEasyGameInfo(ItemAudit).eScanMode <> PopupSelectScanGamesMode.Tag then
                TEasyGameInfo(ItemAudit).eScanMode:= PopupSelectScanGamesMode.Tag;
           end;
      end;
    False:
      begin
        // game not found, or game found with missing ROMs/CHDs
        // move from "have" to "miss"
        case TempGameVars.eROMIdentification of
          00: TempGameVars.eROMIdentification:= 04; // MAME Parent
          01: TempGameVars.eROMIdentification:= 05; // MAME Clone
          02: TempGameVars.eROMIdentification:= 06; // MAME BIOS
          03: TempGameVars.eROMIdentification:= 07; // MAME Device

          08: TempGameVars.eROMIdentification:= 10; // Supermodel: SEGA Model 3 Parent
          09: TempGameVars.eROMIdentification:= 11; // Supermodel: SEGA Model 3 Clone

          12: TempGameVars.eROMIdentification:= 14; // Daphne Parent
          13: TempGameVars.eROMIdentification:= 15; // Daphne Clone

          16: TempGameVars.eROMIdentification:= 19; // Demul Parent
          17: TempGameVars.eROMIdentification:= 20; // Demul Clone
          18: TempGameVars.eROMIdentification:= 21; // Demul BIOS

          22: TempGameVars.eROMIdentification:= 26; // HBMAME Parent
          23: TempGameVars.eROMIdentification:= 27; // HBMAME Clone
          24: TempGameVars.eROMIdentification:= 28; // HBMAME BIOS
          25: TempGameVars.eROMIdentification:= 29; // HBMAME Device

          30: TempGameVars.eROMIdentification:= 32; // DICE Parent
          31: TempGameVars.eROMIdentification:= 33; // DICE Clone

          34: TempGameVars.eROMIdentification:= 36; // SEGA Model 2 Parent
          35: TempGameVars.eROMIdentification:= 37; // SEGA Model 2 Clone

          38: TempGameVars.eROMIdentification:= 41; // ZiNc Parent
          39: TempGameVars.eROMIdentification:= 42; // ZiNc Clone
          40: TempGameVars.eROMIdentification:= 43; // ZiNc BIOS
        else
          begin
            if (TEasyGameInfo(ItemAudit).eGameSetStatus = TempGameVars.eGameSetStatus) and
               (TEasyGameInfo(ItemAudit).eScanMode = PopupSelectScanGamesMode.Tag) and
               (TEasyGameInfo(ItemAudit).eIsMerged = TempGameVars.eIsMerged) then
               ChangeGameStatus:= False;
          end;
          if ChangeGameStatus then
             begin
               if TEasyGameInfo(ItemAudit).eScanMode <> PopupSelectScanGamesMode.Tag then
                  TEasyGameInfo(ItemAudit).eScanMode:= PopupSelectScanGamesMode.Tag;
             end;
        end;
      end;
  end;
  // ValidateStatus: this function returns
  // True : game is OK, the game info needs to be updated (file and games list...)
  // False: game has missing ROMs / CHD, game needs no updates (has not changed status!!!!!!!)
  //if Result then // for debugging only
  //   showMessage('set '+TempGameVars.eName+#13#10+'title '+TempGameVars.eTitle+#13#10+'has changed.');

  if TEasyGameInfo(ItemAudit).eIsMerged <> TempGameVars.eIsMerged then
     TEasyGameInfo(ItemAudit).eIsMerged:= TempGameVars.eIsMerged;

  if ChangeGameStatus and (RefreshMode <> 0) then // RefreshMode 0 -> all games (no need to delete from 'system_name.miss' file)
  begin
    if TempGameVars.eGameSetStatus in [0, 2] then // 0 -> game is good; 2 -> game is missing (zero files found)
    begin
      if IsROMsListBasedSys(TempGameVars.eSystemID) then
      begin
        if Assigned(ScanResultsIni) then
           ScanResultsIni.EraseSection(TempGameVars.eName);
      end;
    end;
  end;

  Result:= ChangeGameStatus;

  if ChangeGameStatus then
     UpdateGameInfoFile; // update "system_name.elstatus" file

  //if Result then
  //   begin
  //     if CurrentGameStatus <> TempGameVars.eGameSetStatus then
  //        iUpdateGamesText:= ' -- from "'+GetGameStatusText(CurrentGameStatus, MemGameInfo.eROMIdentification)+'" to "'+
  //                           GetGameStatusText(TempGameVars.eGameSetStatus, MemGameInfo.eROMIdentification);

  //     if GameIsClone(TempGameVars.eClone) then
  //        iUpdateGamesText:= FormMain.GetSystemIniSection(TempGameVars.eSystemID, True)+': '+TempGameVars.eName+' [clone of '+TempGameVars.eClone+']'+iUpdateGamesText
  //     else
  //        iUpdateGamesText:= FormMain.GetSystemIniSection(TempGameVars.eSystemID, True)+': '+TempGameVars.eName+iUpdateGamesText;

  //     iUpdatedGames.Add(iUpdateGamesText);
  //   end;
end;

function TFormMain.IsSystemAvailable(sysID: ShortInt; IsConsoleComputerSystem: Boolean = False): Boolean;
begin
  case IsConsoleComputerSystem of
    True : Result:= ValidateFile(GetCustomGamesFile(sysID)); // console/computer systems
    False: Result:= VerifyArcadeGamesSys(sysID); // arcade systems
  end;
end;

function TFormMain.ReadAtari800CartTypeTag(iFileName: WideString): Boolean;
type
  THeaderVersionCart = record
    Tag: array[0..3] of Char; // 'C' 'A' 'R' 'T'
  end;

var
  TestFile: TWideFileStream;
  HeaderVInfo: THeaderVersionCart;
  CartMemoryStream: TWideMemoryStream;

  ArchiveItem: TZFArchiveItem;
  ArchiveItemSevenZ: I7zInArchive;
  Loop7z: Integer;
  FoundZipped: Boolean;
  FileExt: String;

const
  HexTable: String = '0123456789ABCDEF';

  function ByteToHex(Value: Byte): String;
  var
    zwVal: Byte;
  begin
    zwVal := (Value and $0F); //first mask (Lo) Byte of Value
    Result:= HexTable[zwVal + 1]; //from HexTable to Result
    zwVal := (Value and $F0) shr 4; //second mask (Hi) Byte of Value and 4Bits to the right shift
    Result:= HexTable[zwVal + 1] + Result; //add from HexTable to Result
  end;

begin
  // this will read the first 4 bytes to check for "CART" tag. The format is first 4 bytes containing 'C' 'A' 'R' 'T'.
  Result:= FileExistsW(iFileName);
  if not Result then
     Exit;

  if IsZipFile(iFileName) then
     begin
       CartMemoryStream:= TWideMemoryStream.Create;
       if SameText(ExtractFileExt(iFileName), '.zip') then
          begin
            // .zip file
            with ZipForge do
            begin
              FileName:= iFileName;
              // Open existing archive file
              try
                OpenArchive(fmOpenRead or fmShareDenyNone);
                Result:= FileCount > 0;
                if Result then
                   begin
                     // Search text files stored inside the archive
                     FoundZipped:= False;
                     if FindFirst('*', ArchiveItem) then
                        begin
                          repeat
                            FileExt:= ExtractFileExt(ArchiveItem.FileName);
                            if SameText(FileExt, '.car') or SameText(FileExt, '.bin') or SameText(FileExt, '.rom') then
                               begin
                                 FoundZipped:= True;
                                 ExtractToStream(ArchiveItem.FileName, CartMemoryStream);
                                 Sleep(10);
                               end;
                          until FoundZipped or (not FindNext(ArchiveItem));
                        end;
                   end;
                CloseArchive;
                ZipForge.FileName:= '';
              except
                CloseArchive;
                ZipForge.FileName:= '';
              end;
            end;
          end
       else
          begin
            // .7z file
            try
              ArchiveItemSevenZ:= CreateInArchive(CLSID_CFormat7z);
              with ArchiveItemSevenZ do
              begin
                // Open existing archive file
                try
                  OpenFile(iFileName);
                  Result:= NumberOfItems > 0;
                  if Result then
                     begin
                       // Search text files stored inside the archive
                       for Loop7z:= 0 to NumberOfItems-1 do
                       begin
                         if not ItemIsFolder[Loop7z] then
                            begin
                              FileExt:= ExtractFileExt(ItemPath[Loop7z]);
                              if SameText(FileExt, '.car') or SameText(FileExt, '.bin') or SameText(FileExt, '.rom') then
                                 begin
                                   FoundZipped:= True;
                                   ExtractItem(Loop7z, CartMemoryStream, False);
                                   Sleep(10);
                                   Break;
                                 end;
                            end;
                       end;
                     end;
                  Close;
                except
                  Result:= False;
                  Close;
                end;
              end;
            except
              //Result:= False;
            end;
          end;

       Result:= FoundZipped;
       if FoundZipped then
          begin
            CartMemoryStream.Position:= 0;
            CartMemoryStream.ReadBuffer(HeaderVInfo, SizeOf(HeaderVInfo));
            Result:= SameText(HeaderVInfo.Tag, 'CART');
          end;
       FreeAndNil(CartMemoryStream);
     end
  else
     begin
       // check for any file extension
       TestFile:= TWideFileStream.Create(iFileName, (fmOpenRead or fmShareDenyNone));
       TestFile.ReadBuffer(HeaderVInfo, SizeOf(HeaderVInfo));
       Result:= SameText(HeaderVInfo.Tag, 'CART');
       FreeAndNil(TestFile);
     end;
end;

function TFormMain.CreateCHD_SHA1(const DiskFileName, DiskSHA1: String; out RealSHA1Value: String; out HeaderVersion: Byte): Boolean;
type
  THeaderVersionInfoCHD = record
    Tag: array[0..7] of Char;     // 'MComprHD'
    Length: array[0..3] of Byte;  // length of header (including tag and length fields)
    Version: array[0..3] of Byte; // drive format version
  end;

  THeader1InfoCHD = record
    Tag: array[0..7] of Char;             // 'MComprHD'
    Length: array[0..3] of Byte;          // length of header (including tag and length fields)
    Version: array[0..3] of Byte;         // drive format version
    Flags: array[0..3] of Byte;
    CompressionType: array[0..3] of Byte; // compression type
    HunkSize: array[0..3] of Byte;        // seclen-byte sectors per hunk
    TotalHunks: array[0..3] of Byte;      // total # of hunks represented
    Cylinders: array[0..3] of Byte;       // number of cylinders on hard disk
    Heads: array[0..3] of Byte;           // number of heads on hard disk
    Sectors: array[0..3] of Byte;         // number of sectors on hard disk
    MD5: array[0..15] of Byte;            // MD5 checksum of raw data
    ParentMD5: array[0..15] of Byte;      // MD5 checksum of parent file
  end; // header v1

  THeader2InfoCHD = record
    Tag: array[0..7] of Char;             // 'MComprHD'
    Length: array[0..3] of Byte;          // length of header (including tag and length fields)
    Version: array[0..3] of Byte;         // drive format version
    Flags: array[0..3] of Byte;
    CompressionType: array[0..3] of Byte; // compression type
    HunkSize: array[0..3] of Byte;        // seclen-byte sectors per hunk
    TotalHunks: array[0..3] of Byte;      // total # of hunks represented
    Cylinders: array[0..3] of Byte;       // number of cylinders on hard disk
    Heads: array[0..3] of Byte;           // number of heads on hard disk
    Sectors: array[0..3] of Byte;         // number of sectors on hard disk
    MD5: array[0..15] of Byte;            // MD5 checksum of raw data
    ParentMD5: array[0..15] of Byte;      // MD5 checksum of parent file
    // disabled, not used!!!!! //SectorLength: array[0..3] of Byte;    // number of bytes per sector    
  end; // header v2

  THeader3InfoCHD = record
    Tag: array[0..7] of Char;             // 'MComprHD'
    Length: array[0..3] of Byte;          // length of header (including tag and length fields)
    Version: array[0..3] of Byte;         // drive format version
    Flags: array[0..3] of Byte;
    CompressionType: array[0..3] of Byte; // compression type
    TotalHunks: array[0..3] of Byte;      // total # of hunks represented
    LogicalBytes: array[0..7] of Byte;    // logical size of the data (in bytes)
    MetaOffset: array [0..7] of Byte;     // offset to the first blob of metadata
    MD5: array[0..15] of Byte;            // MD5 checksum of raw data
    ParentMD5: array[0..15] of Byte;      // MD5 checksum of parent file
    HunkBytes: array[0..3] of Byte;       // number of bytes per hunk
    SHA1: array[0..19] of Byte;           // SHA1 checksum of raw data
    ParentSHA1: array[0..19] of Byte;     // SHA1 checksum of parent file
  end; // header v3

  THeader4InfoCHD = record
    Tag: array[0..7] of Char;             // 'MComprHD'
    Length: array[0..3] of Byte;          // length of header (including tag and length fields)
    Version: array[0..3] of Byte;         // drive format version
    Flags: array[0..3] of Byte;
    CompressionType: array[0..3] of Byte; // compression type
    TotalHunks: array[0..3] of Byte;      // total # of hunks represented
    LogicalBytes: array[0..7] of Byte;    // logical size of the data (in bytes)
    MetaOffset: array [0..7] of Byte;     // offset to the first blob of metadata
    HunkBytes: array[0..3] of Byte;       // number of bytes per hunk
    SHA1: array[0..19] of Byte;           // combined raw+meta SHA1
    ParentSHA1 : array[0..19] of Byte;    // combined raw+meta SHA1 of parent
    RawSHA1: array[0..19] of Byte;        // raw data SHA1
  end; // header v4

  THeader5InfoCHD = record
    Tag: array[0..7] of Char;          // 'MComprHD'
    Length: array[0..3] of Byte;       // length of header (including tag and length fields)
    Version: array[0..3] of Byte;      // drive format version
    Compressors: array[0..15] of Byte; // which custom compressors are used?
    LogicalBytes: array[0..7] of Byte; // logical size of the data (in bytes)
    MapOffset: array[0..7] of Byte;    // offset to the map
    MetaOffset: array[0..7] of Byte;   // offset to the first blob of metadata
    HunkBytes: array[0..3] of Byte;    // number of bytes per hunk (512k maximum)
    UnitBytes: array[0..3] of Byte;    // number of bytes per unit within each hunk
    RawSHA1: array[0..19] of Byte;     // raw data SHA1
    SHA1: array[0..19] of Byte;        // combined raw+meta SHA1
    ParentSHA1: array[0..19] of Byte;  // combined raw+meta SHA1 of parent
  end;
  // info extracted from "mame\source\mame\src\lib\util\chd.h"
var
  TestFile: TFileStream;
  SHA1ChecksumFound: String;
  Loop: ShortInt;

  HeaderVInfo: THeaderVersionInfoCHD; // to check header version only
  HeaderInfo1: THeader1InfoCHD; // for MAME old builds, MD5 only
  HeaderInfo2: THeader2InfoCHD; // for MAME old builds, MD5 only
  HeaderInfo3: THeader3InfoCHD; // for ZiNc CHD files and MAME, SHA-1 only
  HeaderInfo4: THeader4InfoCHD; // for MAME, SHA-1 only
  HeaderInfo5: THeader5InfoCHD; // for MAME v0.145u1+, HBMAME and Demul 0.7+, SHA-1 only (August 18, 2016)

const
  HexTable: String = '0123456789ABCDEF';

  function ByteToHex(Value: Byte): String;
  var
    zwVal: Byte;
  begin
    zwVal := (Value and $0F); //first mask (Lo) Byte of Value
    Result:= HexTable[zwVal + 1]; //from HexTable to Result
    zwVal := (Value and $F0) shr 4; //second mask (Hi) Byte of Value and 4Bits to the right shift
    Result:= HexTable[zwVal + 1] + Result; //add from HexTable to Result
  end;

begin
  HeaderVersion:= 0;
  Result:= ValidateFile(DiskFileName);
  if not Result then
     Exit;
  try
    TestFile:= TFileStream.Create(DiskFileName, (fmOpenRead or fmShareDenyNone));
    TestFile.ReadBuffer(HeaderVInfo, SizeOf(HeaderVInfo));
    if not SameText(HeaderVInfo.Tag, 'MComprHD') then
     begin
       Result:= False;
       FreeAndNil(TestFile);
       CallMessageBox;
       AddMsgText('    Invalid header. The ');
       AddMsgText('MComprHD', MsgTxtColors.colorWarning, [fsBold]);
       AddMsgText(' tag of ');
       AddMsgText(DiskFileName, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' file was not found! Header version and checksum cannot be read.');
       GenerateMessage('Error', 'Parse CHD file header.', '', 2, False, 1);
       Exit;
     end;

    TestFile.Seek(0, soBeginning); // reset current position to zero (beginning of file)
    HeaderVersion:= HeaderVInfo.Version[High(HeaderVInfo.Version)];
    case HeaderVInfo.Version[High(HeaderVInfo.Version)] of
      1: TestFile.ReadBuffer(HeaderInfo1, SizeOf(HeaderInfo1));
      2: TestFile.ReadBuffer(HeaderInfo2, SizeOf(HeaderInfo2));
      3: TestFile.ReadBuffer(HeaderInfo3, SizeOf(HeaderInfo3));
      4: TestFile.ReadBuffer(HeaderInfo4, SizeOf(HeaderInfo4));
      5: TestFile.ReadBuffer(HeaderInfo5, SizeOf(HeaderInfo5));
      else
        begin
          Result:= False;
          FreeAndNil(TestFile);
          CallMessageBox;
          AddMsgText('File: ');
          AddMsgText(DiskFileName, MsgTxtColors.colorFileName, [fsBold]);
          AddMsgText('Header version found: ');
          AddMsgText(IntToStr(HeaderVInfo.Version[High(HeaderVInfo.Version)]), MsgTxtColors.colorWarning, [fsBold]);
          AddMsgText(#13#10+'    This version is not supported by the frontend. '+
                     'Only versions 1, 2, 3, 4 and 5 are valid. File checksum cannot be validated.');
          GenerateMessage('Error', 'Parse CHD file header.', '', 2, False, 1);
          Exit;
        end;
    end;
  except
    Result:= False;
    FreeAndNil(TestFile);
    CallMessageBox;
    AddMsgText('    An error occurred while reading the chd file. '+
               'Header version and file checksum cannot be validated.'+#13#10+
               'File: ');
    AddMsgText(DiskFileName, MsgTxtColors.colorFileName, [fsBold]);
    GenerateMessage('Error', 'Parse CHD file header.', '', 2, False, 1);
    Exit;
  end;
  FreeAndNil(TestFile);
  
  SHA1ChecksumFound:= '';
  //CompressionType:= HeaderInfo5.CompressionType[High(HeaderInfo5.CompressionType)];
  case HeaderVInfo.Version[High(HeaderVInfo.Version)] of
    1:
      begin
        for Loop:=Low(HeaderInfo1.MD5) to High(HeaderInfo1.MD5) do
            SHA1ChecksumFound:= SHA1ChecksumFound+ByteToHex(HeaderInfo1.MD5[Loop]); // put all hexa values together
      end;
    2:
      begin
        for Loop:=Low(HeaderInfo2.MD5) to High(HeaderInfo2.MD5) do
            SHA1ChecksumFound:= SHA1ChecksumFound+ByteToHex(HeaderInfo2.MD5[Loop]); // put all hexa values together
      end;
    3:
      begin
        for Loop:=Low(HeaderInfo3.SHA1) to High(HeaderInfo3.SHA1) do
            SHA1ChecksumFound:= SHA1ChecksumFound+ByteToHex(HeaderInfo3.SHA1[Loop]); // put all hexa values together
      end;
    4:
      begin
        for Loop:=Low(HeaderInfo4.SHA1) to High(HeaderInfo4.SHA1) do
            SHA1ChecksumFound:= SHA1ChecksumFound+ByteToHex(HeaderInfo4.SHA1[Loop]); // put all hexa values together
      end;
    5:
      begin
        for Loop:=Low(HeaderInfo5.SHA1) to High(HeaderInfo5.SHA1) do
            SHA1ChecksumFound:= SHA1ChecksumFound+ByteToHex(HeaderInfo5.SHA1[Loop]); // put all hexa values together
      end;
  end;
  SHA1ChecksumFound:= LowerCase(SHA1ChecksumFound);
  RealSHA1Value:= SHA1ChecksumFound;
  Result:= (SHA1ChecksumFound = DiskSHA1);
end;

function TFormMain.SearchCHDSimpleScan(SystemID: Integer; const chdName, chdParentName, GameName, CloneOf, BiosName: String; SoftwareList: String = ''): String;
var
  Continue, IsClone: Boolean;
  DiskFile, ZiNcFilePath: String;
begin
  // validate CHD files
  Result:= '';
  IsClone:= GameIsClone(CloneOf);

  case SystemID = idZiNc of
    True : DiskFile:= SearchZiNcCHDFolder(chdName, GameName, ZiNcFilePath);
    False: DiskFile:= SearchCHDFolder(chdName, GameName, BiosName, CloneOf, SystemID, SoftwareList);
  end;
  Continue:= DiskFile = '';
  if Continue and IsClone then
     begin
       case SystemID = idZiNc of
         True : DiskFile:= SearchZiNcCHDFolder(chdName, CloneOf, ZiNcFilePath);
         False: DiskFile:= SearchCHDFolder(chdName, CloneOf, BiosName, CloneOf, SystemID, SoftwareList);
       end;
       Continue:= DiskFile = '';
       if Continue and (chdParentName <> '') then
          begin
            case SystemID = idZiNc of
              True : DiskFile:= SearchZiNcCHDFolder(chdParentName, GameName, ZiNcFilePath);
              False: DiskFile:= SearchCHDFolder(chdParentName, GameName, BiosName, CloneOf, SystemID, SoftwareList);
            end;
            Continue:= DiskFile = '';
            if Continue then
               begin
                 case SystemID = idZiNc of
                   True : DiskFile:= SearchZiNcCHDFolder(chdParentName, CloneOf, ZiNcFilePath);
                   False: DiskFile:= SearchCHDFolder(chdParentName, CloneOf, BiosName, CloneOf, SystemID, SoftwareList);
                 end;
                 Continue:= DiskFile = '';
               end;
          end;
     end;
  Result:= DiskFile;
end;

procedure TFormMain.GetROMDetailsInfo(const LineStr: String; IsClone: Boolean; out VarName: String; out VarCRC32: String; out VarSHA1: String; out VarParentNameCHD: String; out VarROMDeviceName: String);
begin
  if LineStr = '' then
     Exit;
  VarName:= SoftListGetEntryValue(LineStr, 'name');
  VarCRC32:= SoftListGetEntryValue(LineStr, 'crc');
  VarSHA1:= SoftListGetEntryValue(LineStr, 'sha1');
  if VarSHA1 = '' then
     VarSHA1:= SoftListGetEntryValue(LineStr, 'md5');
  if IsClone then //and (StrToInt(LineStr[1]+LineStr[2]) >= 12) then
     VarParentNameCHD:= SoftListGetEntryValue(LineStr, 'parentname');

  VarROMDeviceName:= SoftListGetEntryValue(LineStr, 'devicename');
end;

function TFormMain.GetMissCheckEntry(const CRC32Str, SHA1Str: String): String;
begin
  Result:= '';
  if CRC32Str <> '' then
     Result:= CRC32Str;

  if SHA1Str <> '' then
     begin
       if Result <> '' then
          Result:= Result+';';
       Result:= Result+SHA1Str;
     end;
end;

function TFormMain.IsDecoCassMachine(const DriverName: String): Boolean;
begin
  Result:= PosEx('decocass', DriverName) <> 0;
end;

function TFormMain.IsSEGASystem24Machine(const DriverName: String): Boolean;
begin
  Result:= PosEx('segas24', DriverName) <> 0;
end;

function TFormMain.ValidateIniFilesDir(sysID: ShortInt; const windowCaption: String): Boolean;
begin
  Result:= IniFilesDir[sysID] <> '';

  if not Result then
     GenerateMessage('Error: Set Custom Options', windowCaption, '    The ini folder is not selected! '+
                     'Please go to main menu "Default Settings / "'+GetArcadeEmulatorDescription(sysID)+
                     '" and make sure that a valid folder is set.', 2);
end;

function TFormMain.GetGameStatusText(StatusIndex: ShortInt; romID: Integer): String;
begin
  // 0 - have; 1 - missing ROMs/CHDs; 2 - missing (no .zip files found)
  case StatusIndex of
    0: Result:= 'Available';
    1: Result:= 'Missing ROMs/CHDs';
    2: Result:= 'Not Available';
  else
       Result:= 'Unknown';
  end;
end;

procedure TFormMain.SetCustomOptions(GameName: String; IsDriver: Boolean);
var
  iniFile, iSourcePath: String;
  iVersion: Integer;

  function CreateFull: Boolean;
  begin
    if not Assigned(FormMAMESettings) then
       FormMAMESettings:= TFormMAMESettings.Create(nil);
  end;

  function CreateBasic: Boolean;
  begin
    if not Assigned(FormMAMESettings_SimpleMode) then
       FormMAMESettings_SimpleMode:= TFormMAMESettings_SimpleMode.Create(nil);
    FormMAMESettings_SimpleMode.iVersion:= iVersion;
  end;
  
  function SetFileID(NumberID: ShortInt; TitleStr: String): String;
  begin
    //IniFilesArray[1]:= 'debug.ini';
    //IniFilesArray[2]:= 'vertical.ini';
    //IniFilesArray[3]:= 'horizont.ini';
    //IniFilesArray[4]:= 'arcade.ini';
    //IniFilesArray[5]:= 'console.ini';
    //IniFilesArray[6]:= 'computer.ini';
    //IniFilesArray[7]:= ''; //othersys.ini // systype_ini ??????
    //IniFilesArray[8]:= 'raster.ini'; 'vector.ini'; 'lcd.ini'; 'svg.ini'
    //IniFilesArray[9]:= ''; // source\sourcefile.ini or sourcefile.ini // source_ini
    //IniFilesArray[10]:= ''; // biosname.ini   // grandparent_ini
    //IniFilesArray[11]:= ''; // parentgame.ini // parent_ini (if current game is clone)
    //IniFilesArray[12]:= ''; // gamename.ini   // driver_ini

    if Assigned(FormMAMESettings) then
       FormMAMESettings.ActiveFileID:= NumberID
    else
    if Assigned(FormMAMESettings_SimpleMode) then
       FormMAMESettings_SimpleMode.ActiveFileID:= NumberID;

    Result:= TitleStr;
  end;

  function SetFormCaption: String;
  begin
    Result:= 'Settings: ';
    if Assigned(FormMAMESettings) then
       FormMAMESettings.SystemIcon.Tag:= 1
    else
    if Assigned(FormMAMESettings_SimpleMode) then
       FormMAMESettings_SimpleMode.SystemIcon.Tag:= 1;

    if IsDriver then
       Result:= SetFileID(9, 'Driver '+Result)
    else
    if SameText('horizont', GameName) then
       Result:= SetFileID(3, 'Horizontal Game '+Result)
    else
    if SameText('vertical', GameName) then
       Result:= SetFileID(2, 'Vertical Game '+Result)
    else
    if SameText('vector', GameName) then
       Result:= SetFileID(8, 'Vector Game '+Result)
    else
    if SameText('debug', GameName) then
       Result:= SetFileID(1, 'Debug '+Result)
    else
    if SameText('arcade', GameName) then
       Result:= SetFileID(4, 'Arcade Game '+Result)
    else
    if SameText('console', GameName) then
       Result:= SetFileID(5, 'Console Game '+Result)
    else
    if SameText('computer', GameName) then
       Result:= SetFileID(6, 'Computer Game '+Result)
    else
    if SameText('othersys', GameName) then
       Result:= SetFileID(7, 'Other System '+Result)
    else
    if SameText('raster', GameName) or SameText('lcd', GameName) or SameText('svg', GameName) then
       Result:= SetFileID(8, 'Screen '+Result)
    else
    if FormMain.IsROM_Bios(MemGameInfo.eROMIdentification) then
       begin
         Result:= SetFileID(10, 'BIOS '+Result);
         if Assigned(FormMAMESettings) then
            FormMAMESettings.SystemIcon.Tag:= 0
         else
         if Assigned(FormMAMESettings_SimpleMode) then
            FormMAMESettings_SimpleMode.SystemIcon.Tag:= 0;
       end
    else
       begin
         case GameIsClone(MemGameInfo.eClone) of
           True : Result:= SetFileID(12, 'Game '+Result); // clone game
           False: Result:= SetFileID(11, 'Game '+Result); // parent game
         end;
         if Assigned(FormMAMESettings) then
            FormMAMESettings.SystemIcon.Tag:= 0
         else
         if Assigned(FormMAMESettings_SimpleMode) then
            FormMAMESettings_SimpleMode.SystemIcon.Tag:= 0;
       end;
  end;

begin
  Screen.Cursor:= crHourGlass;
  iSourcePath:= '';
  case IsMAMEBasedSys(MemGameInfo.eSystemID) of
    True:
      begin
        if not ValidateIniFilesDir(MemGameInfo.eSystemID, SetFormCaption) then
           begin
             Screen.Cursor:= crDefault;
             Exit;
           end;
        iniFile:= GetArcadeEmuIniFileName(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID]);

        iVersion:= GetMAMEBuild(MemGameInfo.eSystemID);

        if IsDriver and (iVersion > 118) then
           iSourcePath:= 'source\';
           
        if not FileExists(iniFile) then
           begin
             CreateMAMEIniFile(EmulatorFile[MemGameInfo.eSystemID]);
             LoadFolders_MAME(MemGameInfo.eSystemID);
             iniFile:= GetArcadeEmuIniFileName(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID]);
           end;

        if (iVersion > 124) or (iVersion = -1) then
           CreateFull
        else
           CreateBasic;

        if Assigned(FormMAMESettings) then
           begin
             FormMAMESettings.sysID:= MemGameInfo.eSystemID;
             FormMAMESettings.Tag:= 1; // "1" is custom options
             FormMAMESettings.emuFileExec:= EmulatorFile[MemGameInfo.eSystemID];
             FormMAMESettings.emuVersionStr:= EmulatorVersion[MemGameInfo.eSystemID];
             FormMAMESettings.ActiveFileID:= -1; // no custom settings ID was set
             FormMAMESettings.iVersion:= iVersion;
             FormMAMESettings.Caption:= SetFormCaption;

             FormMAMESettings.GameIni:= IniFilesDir[MemGameInfo.eSystemID];

             FormMAMESettings.GameIni:= FormMAMESettings.GameIni+iSourcePath+GameName+'.ini';

             FormMAMESettings.emuIni:= iniFile;
             FormMAMESettings.Caption:= FormMAMESettings.Caption+FormMAMESettings.GameIni;
             FormMAMESettings.ShowModal;
             FreeAndNil(FormMAMESettings);
           end
        else
        if Assigned(FormMAMESettings_SimpleMode) then
           begin
             FormMAMESettings_SimpleMode.sysID:= MemGameInfo.eSystemID;
             FormMAMESettings_SimpleMode.Tag:= 1; // "1" is custom options
             FormMAMESettings_SimpleMode.emuFileExec:= EmulatorFile[MemGameInfo.eSystemID];
             FormMAMESettings_SimpleMode.emuVersionStr:= EmulatorVersion[MemGameInfo.eSystemID];
             FormMAMESettings_SimpleMode.ActiveFileID:= -1; // no custom settings ID was set
             FormMAMESettings_SimpleMode.Caption:= SetFormCaption;

             FormMAMESettings_SimpleMode.GameIni:= IniFilesDir[MemGameInfo.eSystemID];

             FormMAMESettings_SimpleMode.GameIni:= FormMAMESettings_SimpleMode.GameIni+iSourcePath+GameName+'.ini';

             FormMAMESettings_SimpleMode.emuIni:= iniFile;
             FormMAMESettings_SimpleMode.Caption:= FormMAMESettings_SimpleMode.Caption+FormMAMESettings_SimpleMode.GameIni;
             FormMAMESettings_SimpleMode.ShowModal;
             FreeAndNil(FormMAMESettings_SimpleMode);
           end;

        LoadFolders_MAME(MemGameInfo.eSystemID);
      end;
    False:
      begin
        case MemGameInfo.eSystemID of
          idSupermodel: // Supermodel: SEGA Model 3
            begin
               if not Assigned(FormSupermodelSettings) then
                 FormSupermodelSettings:= TFormSupermodelSettings.Create(nil);
              FormSupermodelSettings.Tag:= 1; // "1" is custom options
              FormSupermodelSettings.emuFileExec:= EmulatorFile[MemGameInfo.eSystemID];
              FormSupermodelSettings.emuVersionStr:= EmulatorVersion[MemGameInfo.eSystemID];
              iniFile:= GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID)+FormMain.GetArcadeEmuIniFileName(MemGameInfo.eSystemID);
              FormSupermodelSettings.Caption:= SetFormCaption;
              FormSupermodelSettings.emuIni:= iniFile;
              FormSupermodelSettings.GameIni:= GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID)+GameName+'.ini';
              FormSupermodelSettings.LabelReadFileIni.Caption:= FormSupermodelSettings.GameIni;
              FormSupermodelSettings.ShowModal;
              FreeAndNil(FormSupermodelSettings);
              LoadFoldersArcade2(MemGameInfo.eSystemID);
            end;
          idZiNc: // ZiNc
            begin
              if not Assigned(FormZiNcSettings) then
                 FormZiNcSettings:= TFormZiNcSettings.Create(nil);
              FormZiNcSettings.Tag:= 1; // "1" is custom options
              FormZiNcSettings.emuFileExec:= EmulatorFile[MemGameInfo.eSystemID];
              FormZiNcSettings.emuVersionStr:= EmulatorVersion[MemGameInfo.eSystemID];
              iniFile:= GetArcadeEmuIniFileName(MemGameInfo.eSystemID);
              FormZiNcSettings.Caption:= SetFormCaption;
              FormZiNcSettings.emuIni:= iniFile;
              FormZiNcSettings.GameIni:= GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID)+GameName+'.cfg';
              FormZiNcSettings.LabelReadFileIni.Caption:= FormZiNcSettings.GameIni;
              FormZiNcSettings.ShowModal;
              FreeAndNil(FormZiNcSettings);
              LoadFoldersArcade2(MemGameInfo.eSystemID);
            end;
        end;
      end;
  end;
  SetCurrentDir(FrontendPath);
end;

procedure TFormMain.DeleteCustomOptions(GameName: String; IsDriver: Boolean);
var
  iniFile, iSourcePath: String;
  iVersion: Integer;
begin
  iSourcePath:= '';
  case IsMAMEBasedSys(MemGameInfo.eSystemID) of
    True:
      begin
        iVersion:= GetMAMEBuild(MemGameInfo.eSystemID);

        if IsDriver and (iVersion > 118) then
           iSourcePath:= 'source\';

        iniFile:= IniFilesDir[MemGameInfo.eSystemID];
        iniFile:= iniFile+iSourcePath+GameName+'.ini';
      end;
    False:
      begin
        if MemGameInfo.eSystemID in [idSupermodel, idZiNc] then
           begin
             iniFile:= GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID)+GameName;
             if MemGameInfo.eSystemID = idZiNc then
                iniFile:= iniFile+'.cfg'  // ZiNc
             else
                iniFile:= iniFile+'.ini'; // Supermodel: SEGA Model 3
           end;
      end;
  end;
  if FileExists(iniFile) then
     begin
       CallMessageBox;
       AddMsgText('    Are you sure you want to delete ');
       AddMsgText(iniFile, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' file ? Recycle bin is not supported. Click No to abort.');
       if GenerateMessage('Delete File', 'Delete custom settings file.', '', 1, False, 2) = mrYes then
          DeleteFile(iniFile);
     end;
end;

// MAME v0.171 and newer: ... support for a new ui.ini file
// from "src\frontend\mame\emuopts.h" (MAME 0.191 and newer) ... October 29, 2017
// from src\emu\emuopts.h (older MAME builds)

// command-line options are HIGH priority
// OPTION_PRIORITY_CMDLINE = OPTION_PRIORITY_HIGH,

// INI-based options are NORMAL priority, in increasing order:
// OPTION_PRIORITY_INI = OPTION_PRIORITY_NORMAL,
// OPTION_PRIORITY_MAME_INI,
// OPTION_PRIORITY_DEBUG_INI,
// OPTION_PRIORITY_ORIENTATION_INI,
// OPTION_PRIORITY_SYSTYPE_INI,
// OPTION_PRIORITY_SCREEN_INI,
// OPTION_PRIORITY_SOURCE_INI,
// OPTION_PRIORITY_GPARENT_INI,
// OPTION_PRIORITY_PARENT_INI,
// OPTION_PRIORITY_DRIVER_INI,
// OPTION_PRIORITY_INI

// load settings from file in the following order

// mame.ini
// debug.ini
// vertical.ini // orientation_ini
// horizont.ini // orientation_ini
// arcade.ini   // systype_ini
// console.ini  // systype_ini
// computer.ini // systype_ini
// othersys.ini // systype_ini ??????
// raster.ini   // vector.ini  // lcd.ini // svg.ini
// source\sourcefile.ini // source_ini
// sourcefile.ini        // source_ini
// biosname.ini   // grandparent_ini
// parentgame.ini // parent_ini (if current game is clone)
// gamename.ini   // driver_ini

function TFormMain.GetCustomIniFileMAME(FileID: ShortInt): String;
begin
  Result:= '';
  case FileID of
     1: Result:= 'debug';
     2:
       begin
         if MemGameInfo.eScreenOrientation = 1 then
            Result:= 'vertical';
       end;
     3:
       begin
         if MemGameInfo.eScreenOrientation = 0 then
            Result:= 'horizont';
       end;
     4:
       begin
         if (MemGameInfo.eSoftwareName = '') or (MemGameInfo.eSystemType = 0) then
            Result:= 'arcade';   // MAME v0.163 and newer
       end;
     5:
       begin
         if (MemGameInfo.eSoftwareName <> '') or (MemGameInfo.eSystemType = 1) then
            Result:= 'console';  // MAME v0.163 and newer
       end;
     6:
       begin
         if (MemGameInfo.eSoftwareName <> '') or (MemGameInfo.eSystemType = 1) then
            Result:= 'computer'; // MAME v0.163 and newer
       end;
     7:
       begin
         if (MemGameInfo.eSoftwareName <> '') or (MemGameInfo.eSystemType = 1) then
            Result:= 'othersys'; // othersys // systype_ini for MAME v0.163 and newer
       end;
     8:
       begin
         //  -1 -> none; 0 -> raster; 1 -> vector; 2 -> LCD; 3 -> SVG; 4 -> unknown
         // MAME v0.167 and newer
         case MemGameInfo.eScreenType of
           0: Result:= 'raster';
           1: Result:= 'vector';
           2: Result:= 'lcd';
           3: Result:= 'svg'; // MAME v0.191 and newer
         else
              Result:= 'raster';
         end;
       end;
     9: Result:= ChangeFileExt(MemGameInfo.eDriverName, ''); // source\sourcefile.ini or sourcefile.ini // source_ini
    10: Result:= MemGameInfo.eBiosName; // biosname.ini   // grandparent_ini
    11: Result:= MemGameInfo.eClone;    // parentgame.ini // parent_ini (if current game is clone)
    12: Result:= MemGameInfo.eName;     // gamename.ini   // driver_ini
  end;
end;

function TFormMain.SetColumnsMemList(IniFileName: TMemIniFile; IsMachinesSidePanel: Boolean = False): Boolean;
var
  Loop: Integer;
  ColPos: Integer;
begin
  SetLength(ColumnsPosList, Length(aColumnsWidth));
  Result:= Length(ColumnsPosList) > 0;
  if not Result then
     begin
       GenerateMessage('Error', 'Columns Profile'+#13#10+'Failed to initialize columns positions array.',
                       '    Could not load the columns array into memory. Aborting...', 2, False, 1);
       Exit;
     end;

  ColumnsPosList[0]:= 0;
  if IsMachinesSidePanel then
  begin
    // set default positions in the temp array
    for Loop:=1 to GamesListView.Header.Columns.Count-1 do
    begin
      ColPos:= -1;
      if IsValidSoftwareListColumn(Loop) then
         ColPos:= GetSoftwareListDefaultColumnPos(Loop);
      if ColPos <> -1 then
         ColumnsPosList[ColPos]:= Loop;
    end;
  end;
  // need to get positions correctly
  for Loop:=1 to Length(ColumnsPosList)-1 do
  begin
    case IsMachinesSidePanel of
      True:
        begin
          ColPos:= IniFileName.ReadInteger('Position_SoftwareList', aColumns[Loop, 0], -1);
          if ColPos <> -1 then
             ColumnsPosList[ColPos]:= Loop;
        end;
      False:
        begin
          ColPos:= IniFileName.ReadInteger('Position', aColumns[Loop, 0], Loop);
          if ColPos >= GamesListView.Header.Columns.Count then
             begin
               Result:= False;
               Break;
             end
          else
             ColumnsPosList[ColPos]:= Loop;
        end;
    end;

  end;
  if not Result then
     begin
       // column index out of range, need to restore default settings
       for Loop:=1 to Length(ColumnsPosList)-1 do
           ColumnsPosList[Loop]:= Loop;
       Result:= True;
     end;
end;

procedure TFormMain.ReadColumnProfile;
var
  Loop: Byte;
  columnFile: TMemIniFile;
  iSortDirection: Integer;
begin
  if not FileExists(GetColumnProfile) then
     Exit;
  try
    columnFile:= TMemIniFile.Create(GetColumnProfile);
    if not SetColumnsMemList(columnFile) then
       begin
         FreeAndNil(columnFile);
         Exit;
       end;
    GamesListView.BeginUpdate;

    for Loop:=0 to GamesListView.Header.Columns.Count-1 do
        GamesListView.Header.Columns[Loop].Width:= columnFile.ReadInteger('Width', aColumns[Loop, 0], aColumnsWidth[Loop]);

    for Loop:= 1 to GamesListView.Header.Columns.Count-1 do
        GamesListView.Header.Columns[Loop].Visible:= Boolean(columnFile.ReadInteger('Visible', aColumns[Loop, 0], 1));

    for Loop:= 1 to GamesListView.Header.Columns.Count-1 do
    begin
      if GamesListView.Header.Columns[ColumnsPosList[Loop]].Position <> Loop then
         GamesListView.Header.Columns[ColumnsPosList[Loop]].Position:= Loop;
    end;

    GamesListView.Header.Columns[LastColumnSorted].SortDirection:= esdNone; // reset current sort column
    LastColumnSorted:= columnFile.ReadInteger('Sort', 'ColumnIndex', 0);
    iSortDirection:= columnFile.ReadInteger('Sort', 'Direction', 0);
    LastColumnSortDirection:= TEasySortDirection(iSortDirection+1); // +1 for EasyListView component
    GamesListView.Header.Columns[LastColumnSorted].SortDirection:= LastColumnSortDirection;

    GamesListView.EndUpdate;
  finally
    for Loop:=0 to Length(ColumnsPosList) do
        Finalize(ColumnsPosList);
    FreeAndNil(columnFile);
  end;
end;

procedure TFormMain.UpdateColumnProfile;
var
  columnFile: TMemIniFile;
  gColumn: TEasyColumn;
begin
  if CheckReadOnly(GetColumnProfile) then
     Exit;
  if IsStartup then
     Exit;
  if PanelMachinesList.Visible then
     Exit; // do not update columns profile if machines list side panel is enabled

  columnFile:= TMemIniFile.Create(GetColumnProfile);
  columnFile.EraseSection('Position');
  columnFile.EraseSection('Width');
  columnFile.EraseSection('Visible');
  columnFile.EraseSection('Sort');
  
  gColumn:= GamesListView.Header.FirstColumn;
  repeat
    if gColumn.Index <> 0 then
       begin
         if gColumn.Position <> gColumn.Index then
            columnFile.WriteInteger('Position', aColumns[gColumn.Index, 0], gColumn.Position);
       end;
    if gColumn.Width <> aColumnsWidth[gColumn.Index] then
       columnFile.WriteInteger('Width', aColumns[gColumn.Index, 0], gColumn.Width);

    if not gColumn.Visible then
       columnFile.WriteInteger('Visible', aColumns[gColumn.Index, 0], 0);
       
    gColumn:= GamesListView.Header.NextColumn(gColumn);
  until gColumn = nil;

  if (LastColumnSorted = 0) and (LastColumnSortDirection = esdAscending) then
     begin
       // do nothing
     end
  else
     begin
       columnFile.WriteInteger('Sort', 'ColumnIndex', LastColumnSorted);
       columnFile.WriteInteger('Sort', 'Direction',
                               Ord(GamesListView.Header.Columns[LastColumnSorted].SortDirection = esdDescending)); // 0 -> Ascending; 1 -> Descending
     end;

  columnFile.UpdateFile;
  FreeAndNil(columnFile);
end;

// procedures to load icons into TImageList
procedure TFormMain.SetIcon(SourceHolder, Source2Holder, DestHolder: TImageList; SourceIndex, DestIndex: Integer);
var
  FileIcon: TIcon;
  iImageList: TImageList;
begin
  // it seems to be used only in "uMain.PopulateMenuItemCustomEmuParameter" function
  iImageList:= SourceHolder;
  if Source2Holder <> nil then
     begin
       if SourceHolder.Height = DestHolder.Height then
          iImageList:= SourceHolder
       else
          iImageList:= Source2Holder;
     end;
     
  if iImageList.Height = DestHolder.Height then
     begin
       FileIcon:= TIcon.Create;
       FileIcon.Width:= SourceHolder.Width;
       FileIcon.Height:= SourceHolder.Height;
       FileIcon.Transparent:= True;
       iImageList.GetIcon(SourceIndex, FileIcon);
       if not FileIcon.Empty then
          DestHolder.ReplaceIcon(DestIndex, FileIcon);
       FreeAndNil(FileIcon);
     end
  else
     GenerateMessage('Error', 'Set ImageList Icon. Size mismatch.',
                     '    Icon size of source imagelist and destination imagelist are not the same!'+#13#10+
                     'Source: '+iImageList.Name+#13#10+'Destination: '+DestHolder.Name, 2, False, 1);
end;

procedure TFormMain.LoadImageLayoutThumbIcon(ImageHolder: TImage; LayoutIndex: ShortInt; OverlayIndex: Integer = -1; ForceLightMode: Boolean = False);
var
  fIcon: TExIcon;
  tmpIcon: TIcon;
  icoLoop: Integer;
begin
  if LayoutIndex = -1 then
     Exit;
  fIcon:= TExIcon.Create;                                                 //.ico
  fIcon.LoadFromFile(GetFolderFull(32)+GetScrLayoutImageFile(LayoutIndex, False));
  for icoLoop:=0 to fIcon.ImageCount-1 do
  begin
    if (fIcon.Images[icoLoop].Width = ImageHolder.Width) and
       (fIcon.Images[icoLoop].Height = ImageHolder.Height) then
       begin
         fIcon.CurrentImage:= icoLoop;
         Break;
       end;
  end;
  tmpIcon:= TIcon.Create;
  tmpIcon.Handle:= fIcon.Handle;
  ImageHolder.Picture.Icon:= nil; // clear it first
  ImageHolder.Picture.Icon:= tmpIcon;
  FreeAndNil(tmpIcon);
  fIcon.Releasehandle;
  FreeAndNil(fIcon);
end;

procedure TFormMain.LoadIconIntoImage(const IconFileName: String; DestImageHolder: TImage; OverlayIndex: Integer = -1; IsConsoleComputerSys: Boolean = False; ForceLightMode: Boolean = False; FileSubFolder: String = '');
var
  Icon32, Icon32Overlay, Icon32OverlayText: TExIcon;
  tmpIcon, tmpIconOverlay, tmpIconOverlayText, MergedIcon: TIcon;
  icoLoop, icoOverlayLoop, icoOverlayTextLoop: Integer;
  FileExt: String;
  FolderStr: String;
  OverlayFolder, OverlayCustomFolder, OverlayFileName, OverlayTextFolder, OverlayTextFileName: String;
  HaveOverlay, HaveOverlayText: Boolean;
begin
  // OverlayIndex
  // -1 -> no overlay to load
  //  0 -> games filters tool bar multi icons - "main_icons\overlay\toolbar_overlay_multi_light.ico" (replace by "_dark.ico" in night mode)
  //  1 -> games filters tool bar single icon - "main_icons\overlay\toolbar_overlay_light.ico" (replace by "_dark.ico" in night mode)
  //  2 -> image category icons               - "main_icons\overlay\image_category_overlay_light.ico" (replace by "_dark.ico" in night mode)
  //       -> image category text icons       - "main_icons\overlay\img_dark\image_*.ico" (white text files for night mode, image categories)
  //  3 -> image layout text icons            - "main_icons\overlay\img_dark\img?_layout*.ico (white text files for night mode, image layouts)
  
  if IsConsoleComputerSys then
     icoLoop:= 34
  else
     icoLoop:= 32;
  FileExt:= '.ico';
  if PosEx('.ico', IconFileName) <> 0 then
     FileExt:= '';
  if FileSubFolder = '' then
     FolderStr:= GetFolderFull(icoLoop)
  else
     FolderStr:= GetFolderFull(32)+FileSubFolder;

  if (OverlayIndex = -1) and MenuUseAlternateFrontendIcons.Checked then
     begin
       if FileExists(FolderStr+'alternate\'+IconFileName+FileExt) then
          FolderStr:= FolderStr+'alternate\';
     end;
     
  if not FileExists(FolderStr+IconFileName+FileExt) then
     Exit;

  DestImageHolder.Picture.Icon:= nil; // clear it first

  HaveOverlay:= False;
  OverlayCustomFolder:= '';

  HaveOverlayText:= False;
  OverlayTextFolder:= '';
  OverlayTextFileName:= '';
  
  if OverlayIndex <> -1 then
  begin
    OverlayFolder:= GetFolderFull(32)+'overlay\';
    if SameText(ToolBarOverlayIconFolderStr, 'Default') then
       OverlayCustomFolder:= ''
    else
       OverlayCustomFolder:= ToolBarOverlayIconFolderStr+'\';

    case OverlayIndex of
      0: OverlayFileName:= 'toolbar_overlay_multi_';
      1: OverlayFileName:= 'toolbar_overlay_';
      2: OverlayFileName:= 'image_category_overlay_';
      3: OverlayFileName:= IconFileName+FileExt;
    end;
    if IsNightMode and (not ForceLightMode) then
       OverlayFileName:= OverlayFileName+'dark.ico'
    else
       OverlayFileName:= OverlayFileName+'light.ico';

    HaveOverlay:= FileExists(OverlayFolder+OverlayCustomFolder+OverlayFileName);
    if not HaveOverlay then
       begin
         if IsNightMode and (not ForceLightMode) then
            begin
              if not SameText(ToolBarOverlayIconFolderStr, 'Default') then
                 ToolBarOverlayIconFolderStr:= 'Default'; // will reset to night mode's default overlay icons if sub-folder icons are not found 
            end;
         OverlayCustomFolder:= '';
         HaveOverlay:= FileExists(OverlayFolder+OverlayFileName);
       end;

    if (OverlayIndex in [2, 3]) and (DestImageHolder.Width >= 32) then
       begin
         if IsNightMode and (not ForceLightMode) then
         begin
           // image category/layout, night mode (32x32 and higher only)
           HaveOverlayText:= FileExists(OverlayFolder+OverlayTextFolder+IconFileName+FileExt);
           if not HaveOverlayText then
              begin
                OverlayTextFolder:= 'img_dark\'; // get text icon from "overlay\img_dark\" folder
                HaveOverlayText:= FileExists(OverlayFolder+OverlayTextFolder+IconFileName+FileExt);
              end;
         end;
       end;
  end;

  //ColorDepth:= pf32bit;

  if HaveOverlay then
  begin
    HaveOverlay:= False;
    Icon32Overlay:= TExIcon.Create;
    Icon32Overlay.LoadFromFile(OverlayFolder+OverlayCustomFolder+OverlayFileName);
    for icoOverlayLoop:=0 to Icon32Overlay.ImageCount-1 do
    begin
      if (Icon32Overlay.Images[icoOverlayLoop].Width = DestImageHolder.Width) and
         (Icon32Overlay.Images[icoOverlayLoop].Height = DestImageHolder.Height) then //and
         //(Icon32Overlay.Images[icoOverlayLoop].PixelFormat = ColorDepth) then
         begin
           HaveOverlay:= True;
           Icon32Overlay.CurrentImage:= icoOverlayLoop;
           tmpIconOverlay:= TIcon.Create;
           tmpIconOverlay.Handle:= Icon32Overlay.Handle;
           Break;
         end;
    end;
    if not HaveOverlay then
       begin
         Icon32Overlay.Releasehandle;
         FreeAndNil(Icon32Overlay);
       end;
  end;

  if HaveOverlayText then
  begin
    HaveOverlayText:= False;
    Icon32OverlayText:= TExIcon.Create;
    Icon32OverlayText.LoadFromFile(OverlayFolder+OverlayTextFolder+IconFileName+FileExt);
    for icoOverlayTextLoop:=0 to Icon32OverlayText.ImageCount-1 do
    begin
      if (Icon32OverlayText.Images[icoOverlayTextLoop].Width = DestImageHolder.Width) and
         (Icon32OverlayText.Images[icoOverlayTextLoop].Height = DestImageHolder.Height) then
         //(Icon32OverlayText.Images[icoOverlayTextLoop].PixelFormat = ColorDepth) then
         begin
           HaveOverlayText:= True;
           Icon32OverlayText.CurrentImage:= icoOverlayTextLoop;
           tmpIconOverlayText:= TIcon.Create;
           tmpIconOverlayText.Handle:= Icon32OverlayText.Handle;
           Break;
         end;
    end;
    if not HaveOverlayText then
       begin
         Icon32OverlayText.ReleaseHandle;
         FreeAndNil(Icon32OverlayText);
       end;
  end;

  Icon32:= TExIcon.Create;
  Icon32.LoadFromFile(FolderStr+IconFileName+FileExt);
  for icoLoop:=0 to Icon32.ImageCount-1 do
  begin
    if (Icon32.Images[icoLoop].Width = DestImageHolder.Width) and
       (Icon32.Images[icoLoop].Height = DestImageHolder.Height) then
       begin
         Icon32.CurrentImage:= icoLoop;
         tmpIcon:= TIcon.Create;
         tmpIcon.Handle:= Icon32.Handle;

         if HaveOverlay or HaveOverlayText then
            begin
              MergedIcon:= TIcon.Create;         // front              // back
              if HaveOverlay then
                 MergedIcon.Handle:= CombineIcons(tmpIconOverlay.Handle, tmpIcon.Handle);

              if HaveOverlayText then
                 begin
                   if HaveOverlay then
                      MergedIcon.Handle:= CombineIcons(tmpIconOverlayText.Handle, MergedIcon.Handle) // overlay + text overlay
                   else
                      MergedIcon.Handle:= CombineIcons(tmpIconOverlayText.Handle, tmpIcon.Handle);   // just text overlay
                 end;

              DestImageHolder.Picture.Icon.Handle:= MergedIcon.Handle;

              //IconList.AddIcon(MergedIcon);
              MergedIcon.ReleaseHandle;
              FreeAndNil(MergedIcon);
            end
         else
            DestImageHolder.Picture.Icon.Handle:= tmpIcon.Handle; // IconList.AddIcon(tmpIcon);
            //DestImageHolder.Picture.Icon:= tmpIcon; // IconList.AddIcon(tmpIcon);

         tmpIcon.ReleaseHandle;
         FreeAndNil(tmpIcon);
         Break;
       end;
  end;

  if HaveOverlay then
     begin
       tmpIconOverlay.ReleaseHandle;
       FreeAndNil(tmpIconOverlay);
       Icon32Overlay.ReleaseHandle;
       FreeAndNil(Icon32Overlay);
     end;

  if HaveOverlayText then
     begin
       tmpIconOverlayText.ReleaseHandle;
       FreeAndNil(tmpIconOverlayText);
       Icon32OverlayText.ReleaseHandle;
       FreeAndNil(Icon32OverlayText);
     end;

  //DestImageHolder.Picture.Icon:= tmpIcon;
  //FreeAndNil(tmpIcon);
  Icon32.Releasehandle;
  FreeAndNil(Icon32);
end;

procedure TFormMain.LoadGameIconIntoImage(Arcade_SysID, ConsComp_SysID: Integer; romID: Integer; DestImage: TImage; SoftwareName: String; IsConsoleComputerSys: Boolean);
var
  fIcon: TExIcon;
  tmpIcon: TIcon;
  icoLoop: Integer;
  IconFileName, fExt, FolderStr: String;
begin
  if IsConsoleComputerSys then
     IconFileName:= SystemsListCustom[ConsComp_SysID, 1] // console/computer systems (EmuCon)
  else
     IconFileName:= GetELGameIconFileName(GetMAMEImageIndex(romID, SoftwareName)); // arcade systems

  if IsConsoleComputerSys then
     icoLoop:= 34  // EmuCon
  else
     icoLoop:= 33; // arcade
  fExt:= '.ico';
  if PosEx('.ico', IconFileName) <> 0 then
     fExt:= '';

  FolderStr:= GetFolderFull(icoLoop);

  if MenuUseAlternateFrontendIcons.Checked then
     begin
       if FileExists(FolderStr+'alternate\'+IconFileName+fExt) then
          FolderStr:= FolderStr+'alternate\';
     end;

  if not FileExists(FolderStr+IconFileName+fExt) then
     Exit;
  fIcon:= TExIcon.Create;
  fIcon.LoadFromFile(FolderStr+IconFileName+fExt);
  for icoLoop:=0 to fIcon.ImageCount-1 do
  begin
    if (fIcon.Images[icoLoop].Width = DestImage.Width) and
       (fIcon.Images[icoLoop].Height = DestImage.Height) then
       begin
         fIcon.CurrentImage:= icoLoop;
         Break;
       end;
  end;
  tmpIcon:= TIcon.Create;
  tmpIcon.Handle:= fIcon.Handle;
  DestImage.Picture.Icon:= nil; // clear it first
  DestImage.Picture.Icon:= tmpIcon;
  FreeAndNil(tmpIcon);
  fIcon.Releasehandle;
  FreeAndNil(fIcon);
end;

