procedure TFormMain.GamesListViewItemFreeing(Sender: TCustomEasyListview;
  Item: TEasyItem);
begin
  TEasyGameInfo(Item).eThumbnail.Free;
  TEasyGameInfo(Item).eThumbnail:= nil;
  FreeAndNil(TEasyGameInfo(Item).fThumbnail);
  ClearThumb(Item);

  //TEasyGameInfo(Item).eMAMu_Icon.Free;
  //TEasyGameInfo(Item).eMAMu_Icon:= nil;
  //FreeAndNil(TEasyGameInfo(Item).fMAMu_Icon);

  if TEasyGameInfo(Item).eROMInfo <> nil then
     begin
       TEasyGameInfo(Item).eROMInfo.Clear;
       TEasyGameInfo(Item).eROMInfo.Free;
       TEasyGameInfo(Item).eROMInfo:= nil;
     end;

  if TEasyGameInfo(Item).eDeviceSets <> nil then
     begin
       TEasyGameInfo(Item).eDeviceSets.Clear;
       TEasyGameInfo(Item).eDeviceSets.Free;
       TEasyGameInfo(Item).eDeviceSets:= nil;
     end;

  if Length(TEasyGameInfo(Item).eSoftwareList) > 0 then
     begin
       SetLength(TEasyGameInfo(Item).fSoftwareList, 0);
       TEasyGameInfo(Item).eSoftwareList:= TEasyGameInfo(Item).fSoftwareList;
     end;

  if Item = SelectedEasyItem then
     SelectedEasyItem:= nil;
end;

