procedure TFormMain.PopupDeleteSelectedGamesClick(Sender: TObject);
var
  Item: TEasyItem;
  dCFG, dNVRAM, sValue: String;
  ROMsContinue, Continue: Boolean;
  CheckDelROM, CheckDelCHD, CheckDelCFG, bValue, AddSysFolder: Boolean;
  CheckDelGameFromGamesList, CheckDelGameFileFromDisk: Boolean;

  function LoadIcons: Boolean;
  var
    tempFolder: String;
    Loop: ShortInt;
  begin
    Result:= True;
    if Assigned(FormDeleteMultipleGamesFiles) then
       begin
          tempFolder:= GetFolderFull(32);
          AddDefaultIcons('emucon.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          for Loop:=1 to MaxArcadeSystems do
              AddDefaultIcons(GetArcadeSystemIconFileName(Loop), tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          for Loop:=Low(aMediaType)+1 to High(aMediaType) do
              AddDefaultIcons(aMediaType[Loop, 1]+'.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          AddDefaultIcons('media_disc.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('media_flashcard.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          AddDefaultIcons('settings.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // 17

          for Loop:= 1 to Length(MediaTypeCustom) do
              AddDefaultIcons(MediaTypeCustom[Loop, 1], tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // 18..22

          AddDefaultIcons('media_vhs.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // 23
          AddDefaultIcons('media_videogamemusic.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // 24

          // show driver icon ? (June 22, 2018)
          //-1 -> none; 0 -> Good; 1 -> Imperfect; 2 -> Preliminary
          //AddDefaultIcons('scanresult_ok.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);       // 24
          //AddDefaultIcons('scanresult_missroms.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // 25
          //AddDefaultIcons('scanresult_badcrc.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);   // 26
       end;
  end;

  function CheckDelSettings(ReadMode: Boolean): Boolean;
  var
    INIFile: TMemIniFile;
    SectionStr: String;
  begin
    Result:= FileExists(GetFrontendExtraIniFile);
    if not Result then
       Exit;
    SectionStr:= 'DeleteFiles';
    if TMenuItem(Sender).Tag > 0 then
       SectionStr:= 'CopyMoveFiles';
    try
      INIFile:= TMemIniFile.Create(GetFrontendExtraIniFile);
      if ReadMode then
         begin
           CheckDelROM:= Boolean(INIFile.ReadInteger(SectionStr, 'ROM_AlwaysSelect', 1));
           CheckDelCHD:= Boolean(INIFile.ReadInteger(SectionStr, 'CHD_AlwaysSelect', Ord(TMenuItem(Sender).Tag > 0)));
           if SectionStr = 'DeleteFiles' then
              begin
                CheckDelCFG:= Boolean(INIFile.ReadInteger(SectionStr, 'CFG_AlwaysSelect', 1));

                CheckDelGameFromGamesList:= Boolean(INIFile.ReadInteger(SectionStr, 'DeleteGameFromGamesList', 1));
                CheckDelGameFileFromDisk:= Boolean(INIFile.ReadInteger(SectionStr, 'DeleteGameFileFromDisk', 1));
              end;

           if SectionStr = 'CopyMoveFiles' then
              begin
                sValue:= INIFile.ReadString(SectionStr, 'DestinationFolder', '');
                bValue:= Boolean(INIFile.ReadInteger(SectionStr, 'OverwriteFiles', 0));
                AddSysFolder:= Boolean(INIFile.ReadInteger(SectionStr, 'AddSystemFolder', 1));
              end;
         end
      else
         begin
           if INIFile.ValueExists('DeleteFiles', 'DeleteROM_AlwaysSelect') then
              begin
                INIFile.DeleteKey('DeleteFiles', 'DeleteROM_AlwaysSelect');
                INIFile.DeleteKey('DeleteFiles', 'DeleteCHD_AlwaysSelect');
                INIFile.DeleteKey('DeleteFiles', 'DeleteCFG_AlwaysSelect');
              end;
           INIFile.WriteInteger(SectionStr, 'ROM_AlwaysSelect', Ord(CheckDelROM));
           INIFile.WriteInteger(SectionStr, 'CHD_AlwaysSelect', Ord(CheckDelCHD));
           if SectionStr = 'DeleteFiles' then
              begin
                INIFile.WriteInteger(SectionStr, 'CFG_AlwaysSelect', Ord(CheckDelCFG));

                INIFile.WriteInteger(SectionStr, 'DeleteGameFromGamesList', Ord(CheckDelGameFromGamesList));
                INIFile.WriteInteger(SectionStr, 'DeleteGameFileFromDisk', Ord(CheckDelGameFileFromDisk));
              end;
              
           if SectionStr = 'CopyMoveFiles' then
              begin
                INIFile.WriteString(SectionStr, 'DestinationFolder', sValue);
                INIFile.WriteInteger(SectionStr, 'OverwriteFiles', Ord(bValue));
                INIFile.WriteInteger(SectionStr, 'AddSystemFolder', Ord(AddSysFolder));
              end;
         end;
    finally
      if not ReadMode then
         INIFile.UpdateFile;
      FreeAndNil(INIFile);
    end;
  end;

  function AddMsgEmulatorInfo: Boolean;
  begin
    AddMsgText('Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
    AddMsgText(EmulatorVersion[MemGameInfo.eSystemID]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
    AddMsgText(EmulatorFile[MemGameInfo.eSystemID]+#13#10+#13#10, clBlack, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

    if MemGameInfo.eSoftwareName <> '' then
       begin
         AddMsgText('Software List   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
         AddMsgText(MemGameInfo.eCategory+#13#10+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');//, 9);
       end;
  end;

begin
  CheckDelROM:= True; // default value
  CheckDelCHD:= (TMenuItem(Sender).Tag > 0); // default value; delete = false; copy/move = true
  CheckDelCFG:= True; // default value
  CheckDelGameFromGamesList:= True; // default value; this is for console/computer systems only
  CheckDelGameFileFromDisk:= True;  // default value; this is for console/computer systems only
  sValue:= '';
  bValue:= False;
  AddSysFolder:= True;

  if CheckMultipleSelected(GamesListView) then
     begin
       if GamesListView.Selection.Count > 10 then
          begin
            FormStatus.TitleStr(TMenuItem(Sender).Caption);
            FormStatus.MessageStr('Searching files of selected games...');
            FormStatus.Show;
            FormStatus.StartThreadClock;
            Application.ProcessMessages;
          end;
       if not Assigned(FormDeleteMultipleGamesFiles) then
          FormDeleteMultipleGamesFiles:= TFormDeleteMultipleGamesFiles.Create(nil);

       CheckDelSettings(True);

       if IsNightMode then
          begin
            FormDeleteMultipleGamesFiles.Color:= menu_background_color[1];
            SetPopupMenuNightColors(FormDeleteMultipleGamesFiles.PopupGames);
          end;
       LoadIcons;

       FormDeleteMultipleGamesFiles.DeleteROMs.Tag:= MaxArcadeSystems+0;
       FormDeleteMultipleGamesFiles.DeleteCHDs.Tag:= MaxArcadeSystems+1;
       FormDeleteMultipleGamesFiles.DeleteCFGsNVRAMs.Tag:= MaxArcadeSystems+4;
       FormDeleteMultipleGamesFiles.DeleteROMs.Checked:= CheckDelROM;
       FormDeleteMultipleGamesFiles.DeleteCHDs.Checked:= CheckDelCHD;
       FormDeleteMultipleGamesFiles.DeleteCFGsNVRAMs.Checked:= CheckDelCFG;

       FormDeleteMultipleGamesFiles.DeleteGameFromGamesList.Checked:= CheckDelGameFromGamesList;
       FormDeleteMultipleGamesFiles.DeleteGameFileFromDisk.Checked:= CheckDelGameFileFromDisk;

       FormDeleteMultipleGamesFiles.DeleteGameFromGamesList.Enabled:= TMenuItem(Sender).Tag = 0; // delete game option only
       FormDeleteMultipleGamesFiles.DeleteGameFileFromDisk.Enabled:= TMenuItem(Sender).Tag = 0; // delete game option only
       FormDeleteMultipleGamesFiles.DeleteGameConsoleComputerIcon.Enabled:= TMenuItem(Sender).Tag = 0; // delete game option only

       if FormDeleteMultipleGamesFiles.DeleteGameFromGamesList.Enabled then
          IL_MainMenuOptions.GetIcon(15, FormDeleteMultipleGamesFiles.DeleteGameConsoleComputerIcon.Picture.Icon)
       else
          begin
            FormDeleteMultipleGamesFiles.DeleteGameFromGamesList.Visible:= False;
            FormDeleteMultipleGamesFiles.DeleteGameFileFromDisk.Visible:= False;
            FormDeleteMultipleGamesFiles.DeleteGameConsoleComputerIcon.Visible:= False;
          end;
       if FormDeleteMultipleGamesFiles.DeleteGameConsoleComputerIcon.Enabled then
          IL_MainMenuOptions.GetIcon(15, FormDeleteMultipleGamesFiles.DeleteGameConsoleComputerIcon.Picture.Icon);
       //else
       //   DrawDisabledImage(FormDeleteMultipleGamesFiles.DeleteGameConsoleComputerIcon.Canvas.Handle, IL_MainMenuOptions, 15, 0, 0, menu_background_color[1]);

       FormDeleteMultipleGamesFiles.DestinationFolder.Text:= sValue;
       FormDeleteMultipleGamesFiles.CopyMoveOverwriteFiles.Checked:= bValue;
       FormDeleteMultipleGamesFiles.CopyMoveAddSystemFolder.Checked:= AddSysFolder;

       FormDeleteMultipleGamesFiles.ActionMode:= TMenuItem(Sender).Tag;
       FormDeleteMultipleGamesFiles.Hint:= TMenuItem(Sender).Caption;
       FormDeleteMultipleGamesFiles.Caption:= TMenuItem(Sender).Caption;

       FormDeleteMultipleGamesFiles.ShowModal;
       CheckDelROM:= FormDeleteMultipleGamesFiles.DeleteROMs.Checked;
       CheckDelCHD:= FormDeleteMultipleGamesFiles.DeleteCHDs.Checked;
       CheckDelCFG:= FormDeleteMultipleGamesFiles.DeleteCFGsNVRAMs.Checked;

       CheckDelGameFromGamesList:= FormDeleteMultipleGamesFiles.DeleteGameFromGamesList.Checked;
       CheckDelGameFileFromDisk:= FormDeleteMultipleGamesFiles.DeleteGameFileFromDisk.Checked;

       sValue:= FormDeleteMultipleGamesFiles.DestinationFolder.Text;
       bValue:= FormDeleteMultipleGamesFiles.CopyMoveOverwriteFiles.Checked;
       AddSysFolder:= FormDeleteMultipleGamesFiles.CopyMoveAddSystemFolder.Checked;

       CheckDelSettings(False);

       FreeAndNil(FormDeleteMultipleGamesFiles);
       FocusGamesList;
       Exit;
     end;

  if not ValidateSelectedGame then
     Exit;

  // now for single selected game
  Continue:= True;
  case MemGameInfo.eIsCustomGame of
    True:
      begin
        if (not Assigned(sysCustomFolders[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType])) or
           (sysCustomFolders[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType].Count = 0) then
           begin
             CallMessageBox;
             EnableMsgMediaTypeLabel(False);
             AddMsgText('System   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(#13#10+'    There is nothing to do as the game folder is not selected.'+#13#10);
             GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
             FocusGamesList;
             Exit; // games with no folders selected cannot be deleted/copied/moved
           end;
      end;
    False: ROMsContinue:= (Assigned(emuROMsFolders[MemGameInfo.eSystemID])) and
                          (emuROMsFolders[MemGameInfo.eSystemID].Count > 0);
  end;

  if not MemGameInfo.eIsCustomGame then
  begin
    // for MAME and arcade systems only (October 02, 2017) 
    if TMenuItem(Sender).Tag > 0 then
       begin
         if not ROMsContinue then
            begin
              CallMessageBox;
              ShowGameNameEntryMsgBox;
              AddMsgEmulatorInfo;
              AddMsgText(#13#10+'    There is nothing to do as this game uses no ROMs or CHDs files.');
              GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
              FocusGamesList;
              Exit; // games with no ROMs cannot be deleted/copied/moved
            end;
       end;

    if MemGameInfo.eSystemID = idDaphne then
       begin
         // special case. ROMs folder cannot be customized and there is no need
         // to load the DeleteGameFiles form if gamename.zip is not found
          if ROMsContinue then
             begin
               dCFG:= IncludeTrailingPathDelimiter(emuROMsFolders[idDaphne].Strings[0])+MemGameInfo.eName+'.zip';
               if not FileExists(dCFG) then
                  begin
                    CallMessageBox;
                    ShowGameNameEntryMsgBox;
                    AddMsgEmulatorInfo;
                    AddMsgText('    File does not exist, you haven''t selected a Daphne '+
                                    'executable or the ROMs folder could not be found.'+#13#10+#13#10+'Search file: ');
                    AddMsgText(dCFG, MsgTxtColors.colorFileName, [fsBold]);
                    GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
                    FocusGamesList;
                    Exit; // file not found or ROMs folder doesn't exist
                  end;
             end
          else
             begin
               CallMessageBox;
               ShowGameNameEntryMsgBox;
               AddMsgEmulatorInfo;
               AddMsgText('    ROMs folder is blank. There are no folders set for the emulator.'+
                          #13#10+'Please make sure the emulator is properly configured before using this feature.');
               GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
               FocusGamesList;
               Exit; // Daphne emulator was not selected in "Emulator Setup" screen (probably)
             end;
       end;

    if TMenuItem(Sender).Tag = 0 then
      begin
        // delete games files
        LoadFolders_ConfigFiles(MemGameInfo.eSystemID, dCFG, dNVRAM);
        case IsMAMEBasedSys(MemGameInfo.eSystemID) of
          True:
            begin
              if (dCFG = '') and (dNVRAM = '') then
                 begin
                   if not ROMsContinue then
                      Continue:= False;
                 end;
            end;
          False:
            begin
              case MemGameInfo.eSystemID of
                idDemul:
                  begin
                    if (dNVRAM = '') and (not ROMsContinue) then
                       Continue:= False;
                  end;
                idSegaModel2:
                  begin
                    if (dCFG = '') and (dNVRAM = '') and (not ROMsContinue) then
                       Continue:= False;
                  end;
                idZiNc:
                  begin
                    if (dCFG = '') and (not ROMsContinue) then
                       Continue:= False;
                  end;
              end;
            end;
        end;
        if not Continue then
           begin
             CallMessageBox;
             ShowGameNameEntryMsgBox;
             AddMsgEmulatorInfo;
             AddMsgText('    ROM, CFG, NVRAM folders are blank. There are no folders set for the emulator.'+
                        #13#10+'Please make sure the emulator is properly configured before using this feature.');
             GenerateMessage(TMenuItem(Sender).Caption, MemGameInfo.eTitle, '', 2, False, -1);
             FocusGamesList;
             Exit; // no ROMs, CHDs or config folders are set; cannot continue
           end;
      end;
    end; // end of arcade only handling (console/computer EmuCon systems only have game filenames)

  if not Assigned(FormDeleteGamesFiles) then
     FormDeleteGamesFiles:= TFormDeleteGamesFiles.Create(nil);

  CheckDelSettings(True);

  FormDeleteGamesFiles.DeleteROMs.Tag:= 0; //MaxGameID+MaxArcadeSystems+1;
  FormDeleteGamesFiles.DeleteCHDs.Tag:= 1; //MaxGameID+MaxArcadeSystems+2;
  FormDeleteGamesFiles.DeleteCFGsNVRAMs.Tag:= 2; //MaxGameID+MaxArcadeSystems+3;
  FormDeleteGamesFiles.DeleteROMs.Checked:= CheckDelROM;
  FormDeleteGamesFiles.DeleteCHDs.Checked:= CheckDelCHD;
  FormDeleteGamesFiles.DeleteCFGsNVRAMs.Checked:= CheckDelCFG;

  FormDeleteGamesFiles.DeleteGameFromGamesList.Checked:= CheckDelGameFromGamesList;
  FormDeleteGamesFiles.DeleteGameFileFromDisk.Checked:= CheckDelGameFileFromDisk;

  FormDeleteGamesFiles.FolderCFG:= dCFG;
  FormDeleteGamesFiles.FolderNVRAM:= dNVRAM;

  FormDeleteGamesFiles.DestinationFolder.Text:= sValue;
  FormDeleteGamesFiles.CopyMoveOverwriteFiles.Checked:= bValue;
  FormDeleteGamesFiles.CopyMoveAddSystemFolder.Checked:= AddSysFolder;

  FormDeleteGamesFiles.ActionMode:= TMenuItem(Sender).Tag;
  FormDeleteGamesFiles.Caption:= TMenuItem(Sender).Caption;
  FormDeleteGamesFiles.ShowModal;

  CheckDelROM:= FormDeleteGamesFiles.DeleteROMs.Checked;
  CheckDelCHD:= FormDeleteGamesFiles.DeleteCHDs.Checked;
  CheckDelCFG:= FormDeleteGamesFiles.DeleteCFGsNVRAMs.Checked;

  CheckDelGameFromGamesList:= FormDeleteGamesFiles.DeleteGameFromGamesList.Checked;
  CheckDelGameFileFromDisk:= FormDeleteGamesFiles.DeleteGameFileFromDisk.Checked;

  sValue:= FormDeleteGamesFiles.DestinationFolder.Text;
  bValue:= FormDeleteGamesFiles.CopyMoveOverwriteFiles.Checked;
  AddSysFolder:= FormDeleteGamesFiles.CopyMoveAddSystemFolder.Checked;

  CheckDelSettings(False);
  case FormDeleteGamesFiles.GameChanged of
    True:
      begin
        FreeAndNil(FormDeleteGamesFiles);
        if ButtonGameFilterHaveMiss.Tag <> 0 then
           SelectNearGame(Item);

        if MemGameInfo.eIsCustomGame then
           begin
             if CheckDelGameFromGamesList then
                begin
                  FillTempGameInfo(GamesListView.Selection.First);
                  DeleteSingleGameFromGamesListConsoleComputer(False);
                  //ClearMemGameInfo(TempGameVars); // no need, this is called in the function above
                end;
           end
        else
           PopupScanAllSelectedGames.Click; // MAME/arcade only, single scan since only one game is selected
      end;
    False: FreeAndNil(FormDeleteGamesFiles);
  end;
  FocusGamesList;
end;

function TFormMain.DeleteSingleGameFromGamesListConsoleComputer(ShowDeleteMessage: Boolean): Boolean;
var
  SelectionIndex: Integer;
  ValidGames: Boolean;
  gList: array[1..MaxConsoleComputerSystems] of THashedStringList;
  sysFile, SingleGameEntryStr, EntryStr: String;

begin
  // for single selected game only and for the "Delete Selected Game" single selection dialog
  sysFile:= GetGamesFolderEL(2)+SystemsListCustom[TempGameVars.eCustomSystemID, 2];
  if (not FileExists(sysFile)) and ShowDeleteMessage then
     begin
       CallMessageBox;
       FormMain.AddMsgText('File ');
       FormMain.AddMsgText(sysFile, MsgTxtColors.colorFileName, [fsBold]);
       FormMain.AddMsgText(' was not found. Cannot delete game from games list.');
       GenerateMessage('Error', 'Delete Selected Game From Games List', '', 2, False, 1);
       ClearMemGameInfo(TempGameVars);
       Exit;
     end;

  SingleGameEntryStr:= Format('%.3u', [TempGameVars.eCustomSystemID])+
                       IntToStr(TempGameVars.eCustomMediaType)+
                       IntToStr(Ord(TempGameVars.eIsUnicode));
  if TempGameVars.eIsUnicode then
     SingleGameEntryStr:= SingleGameEntryStr+MountGameInfoFieldStr('file', UTF8Encode(TempGameVars.eName))
  else
     SingleGameEntryStr:= SingleGameEntryStr+MountGameInfoFieldStr('file', TempGameVars.eName);

  gList[TempGameVars.eCustomSystemID]:= THashedStringList.Create;
  gList[TempGameVars.eCustomSystemID].LoadFromFile(sysFile);
  gList[TempGameVars.eCustomSystemID].BeginUpdate;

  ValidGames:= False;
  for SelectionIndex:=0 to gList[TempGameVars.eCustomSystemID].Count-1 do
  begin
    EntryStr:= gList[TempGameVars.eCustomSystemID].Strings[SelectionIndex];
    if PosEx(SingleGameEntryStr, EntryStr) <> 0 then
       begin
         ValidGames:= True;
         gList[TempGameVars.eCustomSystemID].Delete(SelectionIndex);
         Break;
       end;
  end;
  gList[TempGameVars.eCustomSystemID].EndUpdate;
  if ValidGames then
     gList[TempGameVars.eCustomSystemID].SaveToFile(sysFile);
  FreeAndNil(gList[TempGameVars.eCustomSystemID]);

  if ValidGames and CheckSingleSelected(GamesListView) then
     begin
       // try to remove the EmuCon game from main games list (cannot hide it)
       GamesListView.BeginUpdate;
       GamesListView.Items.ReIndexDisable:= True;
       GamesListView.Selection.DeleteSelected(True);
       GamesListView.Items.ReIndexDisable:= False;
       GamesListView.EndUpdate;
       FocusGamesList;
     end;

  if ShowDeleteMessage then
     begin
       CallMessageBox;
       FormMain.AddMsgText('    Game deleted...');
       FormMain.AddMsgText(#13#10+#13#10+'System: ');
       FormMain.AddMsgText(SystemsListCustom[TempGameVars.eCustomSystemID, 0], MsgTxtColors.colorFileName, [fsBold]);
       FormMain.AddMsgText(#13#10+'Title: ');
       FormMain.AddMsgText(TempGameVars.eTitle, clBlack, [fsBold]);
       FormMain.AddMsgText(#13#10+'Media Type: ');
       FormMain.AddMsgText(MediaTypeCustom[TempGameVars.eCustomMediaType, 0], clBlack, [fsBold]);

       GenerateMessage('Info', 'Delete Selected Game From Games List', '');
     end;
  ClearMemGameInfo(TempGameVars);
end;

procedure TFormMain.PopupDeleteSelectedGamesFromGamesListClick(
  Sender: TObject);
var
  Item: TEasyItem;
  SelectionIndex: Integer;
  ValidGames: Boolean;

  function LoadIcons: Boolean;
  var
    tempFolder: String;
    Loop: ShortInt;
  begin
    Result:= True;
    if Assigned(FormDeleteMultipleGamesFiles) then
       begin
          tempFolder:= GetFolderFull(32);
          AddDefaultIcons('emucon.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          for Loop:=1 to MaxArcadeSystems do
              AddDefaultIcons(GetArcadeSystemIconFileName(Loop), tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          for Loop:=Low(aMediaType)+1 to High(aMediaType) do
              AddDefaultIcons(aMediaType[Loop, 1]+'.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // zipfile.ico and chd.ico

          AddDefaultIcons('media_disc.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('media_flashcard.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);

          AddDefaultIcons('settings.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          AddDefaultIcons('bios_chip.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // 17

          for Loop:= 1 to Length(MediaTypeCustom) do
              AddDefaultIcons(MediaTypeCustom[Loop, 1], tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons); // 18..22

          //-1 -> none; 0 -> Good; 1 -> Imperfect; 2 -> Preliminary
          //AddDefaultIcons('scanresult_ok.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          //AddDefaultIcons('scanresult_missroms.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
          //AddDefaultIcons('scanresult_badcrc.ico', tempFolder, FormDeleteMultipleGamesFiles.IL_DeleteGameIcons);
       end;
  end;
       
begin
  Item:= GamesListView.Selection.First;
  SelectionIndex:= 1;
  ValidGames:= False;
  repeat
    if TEasyGameInfo(Item).eIsCustomGame then
       ValidGames:= True;
    if not ValidGames then
       Item:= ELV_GetNextSelected(GamesListView, Item, SelectionIndex);
  until (Item = nil) or ValidGames;
  if not ValidGames then
     begin
       GenerateMessage('Info', PopupDeleteSelectedGamesFromGamesList.Caption,
                       '    No valid games were found. MAME and arcade games are not supported, only console/computer/handheld games.'+
                       #13#10+'Aborting...');
       Exit;
     end;

  if CheckMultipleSelected(GamesListView) then
     begin
       if GamesListView.Selection.Count > 10 then
          begin
            FormStatus.TitleStr(TMenuItem(Sender).Caption);
            FormStatus.MessageStr('Adding games to the list...');
            FormStatus.Show;
            FormStatus.StartThreadClock;
            Application.ProcessMessages;
          end;
       if not Assigned(FormDeleteMultipleGamesFiles) then
          FormDeleteMultipleGamesFiles:= TFormDeleteMultipleGamesFiles.Create(nil);

       LoadIcons;

       FormDeleteMultipleGamesFiles.ActionMode:= TMenuItem(Sender).Tag;
       FormDeleteMultipleGamesFiles.Hint:= TMenuItem(Sender).Caption;
       FormDeleteMultipleGamesFiles.Caption:= TMenuItem(Sender).Caption;

       FormDeleteMultipleGamesFiles.ShowModal;

       FreeAndNil(FormDeleteMultipleGamesFiles);
       FocusGamesList;
       Exit;
     end;

  if not ValidateSelectedGame then
     Exit;

  // now for single selected game
  FillTempGameInfo(Item);
  CallMessageBox;
  FormMain.AddMsgText('    You are about to ');
  FormMain.AddMsgText(LowerCase(TMenuItem(Sender).Caption), MsgTxtColors.colorFileName, [fsBold]);
  FormMain.AddMsgText(#13#10+#13#10+'System: ');
  FormMain.AddMsgText(SystemsListCustom[TempGameVars.eCustomSystemID, 0], MsgTxtColors.colorFileName, [fsBold]);
  FormMain.AddMsgText(#13#10+'Title: ');
  FormMain.AddMsgText(TempGameVars.eTitle, clBlack, [fsBold]);
  FormMain.AddMsgText(#13#10+'Media Type: ');
  FormMain.AddMsgText(MediaTypeCustom[TempGameVars.eCustomMediaType, 0], clBlack, [fsBold]);
  FormMain.AddMsgText(#13#10+#13#10+'Are you sure ? The game file will not be deleted, only the game from the main games list.');

  if GenerateMessage('Confirmation', TMenuItem(Sender).Caption, '', 1, True, 2) = mrNo then
     begin
       ClearMemGameInfo(TempGameVars);
       Exit;
     end;

  DeleteSingleGameFromGamesListConsoleComputer(True);
end;

