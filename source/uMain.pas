function TFormMain.FixSortTitle(const Column: TEasyColumn): Boolean;
var
  CurColSort: ShortInt;
begin
  Result:= IsDetailsView;
  if not Result then
     Exit;
  Result:= Column.Index <> 0;
  if not Result then
     Exit;

  CurColSort:= Ord(Column.SortDirection);
  Column.SortDirection:= esdNone;
  if GamesListView.Header.Columns[0].SortDirection <> esdAscending then
     GamesListView.Header.Columns[0].SortDirection:= esdAscending;
  GamesListView.Sort.SortAll;
  Column.SortDirection:= TEasySortDirection(CurColSort);
  GamesListView.Header.Columns[0].SortDirection:= esdNone;
end;

procedure TFormMain.GamesListViewColumnClick(Sender: TCustomEasyListview;
  Button: TCommonMouseButton; ShiftState: TShiftState;
  const Column: TEasyColumn);
var
  sbPos: Integer;
begin
  if Button = cmbLeft then
     begin
       if IsDetailsView then
          begin
            Screen.Cursor:= crHourGlass;
            IsMultiColumnSort:= GetKeyState(VK_CONTROL) < 0;
            GamesListView.BeginUpdate;
            GamesListView.Sort.SortAll;
            GamesListView.EndUpdate(False);
