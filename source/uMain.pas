function TFormMain.MountMultiFloppyCommandLine2(var CmdLineVar: WideString): Boolean;
const
  SelectValidEmulatorText: String =
    '    If you''re using more than one emulator for this system, please change your selected emulator (mouse right-click on game).';
var
  GamesFiles: TStringList;
  selItem: TEasyItem;
  MediaType: ShortInt;
  sysID, DriveIndex, EmuIconIndex: Integer;
  emuFile: String;
  FileFullPath, FloppyCommand: WideString;
  IsWinUAE: Boolean;
  iMsgTitle: String;
  StrDOSName, tStr: String;
  HaveYearInfo, HaveManufacturerInfo: Boolean;

  function SearchGameFiles_MultiFloppy(const SearchName: WideString): WideString;
  var
    LoopSearch: Integer;
    FolderStr: String;
  begin
    Result:= '';
    if not Assigned(sysCustomFolders[sysID, MediaType]) then
       Exit;
    if sysCustomFolders[sysID, MediaType].Count = 0 then
       Exit;

    for LoopSearch:=0 to sysCustomFolders[sysID, MediaType].Count-1 do
    begin
      FolderStr:= sysCustomFolders[sysID, MediaType].Strings[LoopSearch];
      if FindFile(FolderStr, SearchName, Result, False) then
         begin
           StrDOSName:= GetShortFileNameW(Result); // this is mostly for WinAPE emulator
           Break;
         end;
    end;
  end;

  function ShowMsg: Boolean;
  begin
    Result:= True;
    GenerateMessage('Emu Loader', iMsgTitle);
  end;

  function GetSelectedEmulatorMulti: Boolean;
  begin
    Result:= True;
    AddMsgText('    Emulator in use not supported for multiple disks: '+#13#10);
    AddMsgText(EmulatorVersionCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10, MsgTxtColors.colorKeyTitle, [fsBold]);
    AddMsgText(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10+#13#10, MsgTxtColors.colorKeyValue, [fsBold]);//, fsItalic]);
  end;

begin
  CmdLineVar:= '';
  sysID:= MemGameInfo.eCustomSystemID; // use the system of the last selected game by the user

  Result:= sysID in [39, 44, 49, 52, 53, 56, 59, 48]; // 48 -> Atari 800 (for Altirra v2.60 beta 9 and newer)

  iMsgTitle:= 'Load Multi-Floppy Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';

  if Result then
     Result:= MemGameInfo.eCustomMediaType = IsFloppy;

  if not Result then
     begin
       CallMessageBox;
       if MemGameInfo.eCustomMediaType = IsFloppy then
          AddMsgText('    Multiple floppy disks loading is only supported on following ')
       else
          AddMsgText('    '+MediaTypeCustom[MemGameInfo.eCustomMediaType, 0]+' game selected. '+
                     'Multiple floppy disks loading is only supported on following ');
       AddMsgText('systems', MsgTxtColors.colorBoldTitle, [fsBold]); AddMsgText('/'); AddMsgText('emulators', clBlack, [fsBold]);
       AddMsgText(':'+#13#10+#13#10);
       AddMsgText('Amiga', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(': ');
       AddMsgText('FS-UAE', clBlack, [fsBold]);
       AddMsgText(' / ');
       AddMsgText('WinUAE'+#13#10, clBlack, [fsBold]);
       AddMsgText('Commodore 64 / 128 / VIC-20', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(': ');
       AddMsgText('WinVICE'+#13#10, clBlack, [fsBold]);
       AddMsgText('Atari 400/800/XL', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(': ');
       AddMsgText('Altirra', clBlack, [fsBold]);
       AddMsgText(' (15 disks max) / ');
       AddMsgText('Atari++', clBlack, [fsBold]);
       AddMsgText(' (4 disks max)'+#13#10+' / ');
       AddMsgText('Apple II', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(': ');
       AddMsgText('AppleWin', clBlack, [fsBold]);
       AddMsgText(' / ');
       AddMsgText('JACE', clBlack, [fsBold]);
       AddMsgText(' (2 disks max)'+#13#10);
       AddMsgText('Apple IIGS', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(': ');
       AddMsgText('GSport', clBlack, [fsBold]);
       AddMsgText(' / ');
       AddMsgText('KEGS32', clBlack, [fsBold]);
       AddMsgText(' (11 disks max)'+#13#10);
       AddMsgText('Amstrad CPC', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(': ');
       AddMsgText('WinAPE', clBlack, [fsBold]);
       AddMsgText(' (2 disks max)'+#13#10+#13#10+
                  '    For ');
       AddMsgText('MSX', clBlack, [fsBold]);
       AddMsgText(' multiple disks, use the ');
       AddMsgText('v-DRIVE', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' feature from ');
       AddMsgText('blueMSX', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' emulator'+#13#10+#13#10+'Aborting...');
       ShowMsg;
       Exit;
     end;

  MediaType:= IsFloppy; // floppy disks only
  emuFile:= ExtractFileName(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]]);
  case sysID of
    39, 49, 56: // Commodore 64 / Commodore 128 / VIC-20
      begin
        if not IsWinVice(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('WinVICE', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' emulator can be used to load multiple floppy disks in the command line! '+
                        'For this feature to work, WinVICE filename must be one of the following:'+#13#10);
             AddMsgText('x64.exe        x64sc.exe        x128.exe        x64dtv.exe'+#13#10, MsgTxtColors.colorFileName, [fsBold], AlignEmuGameText);
             AddMsgText(#13#10+'    Also, a ');
             AddMsgText('flip list file', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' will be created by EmuCon, named the same as the first disk, but with a ');
             AddMsgText('.vfl', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' extension. This file only needs to be created once and it is required '+
                        'by WinVICE for disk swap during the game.'+#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    44: // Amiga
      begin
        if not IsAmigaUAE(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('FS-UAE', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('WinUAE', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('FS-UAE.exe        WinUAE.exe'+#13#10, MsgTxtColors.colorFileName, [fsBold], AlignEmuGameText);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    48: // Atari 400/800/XL (Altirra only)
      begin
        if (not IsAltirra(emuFile)) and
           (not IsAtariPlusPlus(emuFile)) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('Altirra', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('Atari++', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('Altirra.exe        Altirra64.exe        atari++.exe'+#13#10, MsgTxtColors.colorFileName, [fsBold], AlignEmuGameText);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    52: // Apple II
      begin
        if (not IsAppleWinEmu(emuFile)) and
           (not SameText(emuFile, 'jace.bat')) and
           (not SameText(emuFile, 'jace.cmd')) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('AppleWin', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('JACE', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks (2 disks max) in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('AppleWin.exe        jace.bat        jace.cmd'+#13#10, MsgTxtColors.colorFileName, [fsBold], AlignEmuGameText);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    53: // Apple IIGS
      begin
        if not IsAppleIIGS(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             AddMsgText('    Only ');
             GetSelectedEmulatorMulti;
             AddMsgText('KEGS32', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' and ');
             AddMsgText('GSport', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' emulators can be used to load multiple floppy disks (11 disks max) in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('KEGS32.exe        GSport.exe'+#13#10, MsgTxtColors.colorFileName, [fsBold], AlignEmuGameText);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
    59: // Amstrad PC
      begin
        if not IsWinApe(emuFile) then
           begin
             Result:= False;
             CallMessageBox;
             GetSelectedEmulatorMulti;
             AddMsgText('    Only ');
             AddMsgText('WinApe', MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' emulator can be used to load multiple floppy disks (2 disks max) in the command line! '+
                        'For this feature to work, the emulator filename must be one of the following:'+#13#10);
             AddMsgText('WinApe.exe'+#13#10, MsgTxtColors.colorFileName, [fsBold], AlignEmuGameText);
             AddMsgText(#13#10+SelectValidEmulatorText
                        +#13#10+#13#10+'Aborting...');

             ShowMsg;
             Exit;
           end;
      end;
  end;

  HaveYearInfo:= False;
  HaveManufacturerInfo:= False;
  if not Assigned(FormConsCompMultiFloppyGames) then
     FormConsCompMultiFloppyGames:= TFormConsCompMultiFloppyGames.Create(nil);

  tStr:= GetFolderFull(32);
  AddDefaultIcons('favorite_game.ico', tStr, FormConsCompMultiFloppyGames.IL_LoadMultiFloppy); // index 0

  for DriveIndex:= 1 to Length(MediaTypeCustom) do
      AddDefaultIcons(MediaTypeCustom[DriveIndex, 1], tStr, FormConsCompMultiFloppyGames.IL_LoadMultiFloppy);

  LoadGameIconIntoImage(MemGameInfo.eSystemID, MemGameInfo.eCustomSystemID, MemGameInfo.eROMIdentification, FormConsCompMultiFloppyGames.SystemIcon, MemGameInfo.eSoftwareName, MemGameInfo.eIsCustomGame);

  FormConsCompMultiFloppyGames.LabelSystemTitle.Caption:= SystemsListCustom[sysID, 0];

  if EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]] <> '' then
     begin
       EmuIconIndex:= GetAppIcon(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]],
                     FormConsCompMultiFloppyGames.IL_EmulatorIcon);
       if EmuIconIndex <> -1 then
          FormConsCompMultiFloppyGames.IL_EmulatorIcon.GetIcon(0, FormConsCompMultiFloppyGames.EmulatorIcon.Picture.Icon)
       else
          begin
            EmuIconIndex:= 4+Ord(IsExeBatchFile(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]));
            IL_PopupPlayCustomEmulators.GetIcon(EmuIconIndex, FormConsCompMultiFloppyGames.EmulatorIcon.Picture.Icon);
          end;
       FormConsCompMultiFloppyGames.LabelEmulatorDetails.Caption:=
                 'emulator: '+EmulatorVersionCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10+
                 'filename: '+EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]];
     end;

  FormConsCompMultiFloppyGames.GamesList.BeginUpdate;
  FormConsCompMultiFloppyGames.GamesList.Items.ReIndexDisable:= True;
                                                  
  selItem:= GamesListView.Selection.First;
  repeat
    if (TEasyGameInfo(selItem).eCustomSystemID = sysID) and (TEasyGameInfo(selItem).eCustomMediaType = MediaType) then
       begin
         if (TEasyGameInfo(selItem).eIsUnicode and (sysID = 44)) or // Amiga
            (not TEasyGameInfo(selItem).eIsUnicode) then
         begin
           // add game to the list
           FileFullPath:= SearchGameFiles_MultiFloppy(TEasyGameInfo(selItem).eName);
           if FileFullPath <> '' then
           begin
             tStr:= '';
             if TEasyGameInfo(selItem).eYear <> '' then
                HaveYearInfo:= True;
             if TEasyGameInfo(selItem).eManufacturer <> '' then
                HaveManufacturerInfo:= True;

             with FormConsCompMultiFloppyGames.GamesList.Items.Add do
             begin
               ImageIndex:= -1;
               ImageIndexes[1]:= TEasyGameInfo(selItem).eCustomSystemID;
               case TEasyGameInfo(selItem).eIsFavorite of
                 True : StateImageIndexes[1]:= 0;
                 False: StateImageIndexes[1]:= 500;
               end;
               StateImageIndexes[4]:= 3;
               Captions[1]:= TEasyGameInfo(selItem).eTitle;
               Captions[2]:= TEasyGameInfo(selItem).eYear;
               Captions[3]:= TEasyGameInfo(selItem).eManufacturer;
               Captions[4]:= LowerCase(ExtractFileExtW(TEasyGameInfo(selItem).eName));
               if TEasyGameInfo(selItem).ePlayed <> 0 then
                  tStr:= IntToStr(TEasyGameInfo(selItem).ePlayed)+'x';
               if TEasyGameInfo(selItem).ePlayedDate <> 0 then
                  begin
                    if tStr <> '' then
                       tStr:= tStr+' ';
                    tStr:= tStr+GetDateTimeStr(TEasyGameInfo(selItem).ePlayedDate, True);
                  end;
               Captions[5]:= tStr;
               Captions[6]:= FileFullPath;
             end;
           end;
         end;
       end;
    selItem:= GamesListView.Selection.Next(selItem);
  until selItem = nil;

  FormConsCompMultiFloppyGames.GamesList.Height:= (FormConsCompMultiFloppyGames.GamesList.Items.Count*FormConsCompMultiFloppyGames.GamesList.CellSizes.Report.Height)+
                                                  FormConsCompMultiFloppyGames.GamesList.Header.Height+
                                                  FormConsCompMultiFloppyGames.GamesList.PaintInfoItem.Border+2;

  FormConsCompMultiFloppyGames.GamesList.Items.ReIndexDisable:= False;
  FormConsCompMultiFloppyGames.GamesList.EndUpdate(False);

  Result:= CheckTotal(FormConsCompMultiFloppyGames.GamesList);
  if not Result then
     begin
       FreeAndNil(FormConsCompMultiFloppyGames);
       Exit;
     end;

  FormConsCompMultiFloppyGames.FrameGamesList.Height:= FormConsCompMultiFloppyGames.GamesList.Height+4;

  if not HaveYearInfo then
     begin
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[2].Visible:= False;
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width:= FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width+
                                                                        FormConsCompMultiFloppyGames.GamesList.Header.Columns[2].Width;
     end;

  if not HaveManufacturerInfo then
     begin
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[3].Visible:= False;
       FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width:= FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].Width+
                                                                        FormConsCompMultiFloppyGames.GamesList.Header.Columns[3].Width;
     end;

  FloppyCommand:= '';

  FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].SortDirection:= esdAscending;
  case sysID of
    39, 49, 56: // Commodore 64 / 128 / VIC-20
      begin
        FormConsCompMultiFloppyGames.PanelWinViceLabel.Visible:= True;
        FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].SortDirection:= esdDescending;
      end;
    44: // Amiga
      begin
        isWinUAE:= SameText(emuFile, 'WinUAE.exe');
        case isWinUAE of
          True : FloppyCommand:= '"%s"'; // FloppyCommand:='-diskswapper="%s"';//  oldCODE ??? ('-s diskimage%u="%s"';) // WinUAE disk swapper (up to 20 drives!)
          False: FloppyCommand:= '--floppy_image_%u="%s"'; // FS-UAE
        end;
        DriveIndex:= 0; // starts with zero
      end;
    48: // Atari 400/800/XL
      begin
        DriveIndex:= 1; // Atari++ starts with drive #1
        if IsAltirra(emuFile) then
           FloppyCommand:= '/disk "%s"' // Altirra v2.60 beta 9 and newer
        else
           FloppyCommand:= {'-enable.%u on }'-image.%u "%s"'; // Atari++ supports 4 disk drives max
      end;
    52: // Apple II
      begin
        case IsAppleWinEmu(emuFile) of
          True : FloppyCommand:= '-d%u "%s"'; // AppleWin emulator
          False: FloppyCommand:= '-s6.d%u "%s"'; // JACE emulator
        end;
        DriveIndex:= 1; // starts with drive #1
      end;
    53: // Apple IIGS
      begin
        FloppyCommand:= '';
      end;
    59: // Amstrad CPC
      begin
        FloppyCommand:= ''; // parameter not needed here
        DriveIndex:= 0; // starts with driver #0
      end;
  end;
  FormConsCompMultiFloppyGames.GamesList.Sort.SortAll;
  FormConsCompMultiFloppyGames.GamesList.Header.Columns[1].SortDirection:= esdNone;

  FormConsCompMultiFloppyGames.ClientHeight:= FormConsCompMultiFloppyGames.FrameGamesList.Top+FormConsCompMultiFloppyGames.FrameGamesList.Height+14+
                                              FormConsCompMultiFloppyGames.PanelBottom.Height;

  Result:= FormConsCompMultiFloppyGames.ShowModal = mrYes;
  if not Result then
     begin
       FreeAndNil(FormConsCompMultiFloppyGames);
       Exit;
     end;

  if sysID in [39, 49, 56, 53, 59] then // Commodore 64 / 128 / VIC-20 / Apple IIGS / Amstrad CPC
     begin
       GamesFiles:= TStringList.Create;
       GamesFiles.BeginUpdate;
     end;
  // mount command line / write to custom emulator ini files
  selItem:= FormConsCompMultiFloppyGames.GamesList.Groups.FirstItem;
  repeat
    case sysID of
      39, 49, 56: // Commodore 64 / 128 / VIC-20
        begin
          GamesFiles.Add(selItem.Captions[6]);
        end;
      44: // Amiga
        begin
          // create the command line string
          case IsWinUAE of
            True: // WinUAE
              begin
                if CmdLineVar <> '' then
                   CmdLineVar:= CmdLineVar+',' // disk images are separated by comma, not space
                else
                   CmdLineVar:= '-0 "'+selItem.Captions[6]+'" -diskswapper=';
                CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [selItem.Captions[6]]);
              end;

            False: // FS-UAE
             begin
                if CmdLineVar <> '' then
                   CmdLineVar:= CmdLineVar+' '
                else
                   CmdLineVar:= '--floppy_drive_0="'+selItem.Captions[6]+'" ';
                 CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [DriveIndex, selItem.Captions[6]]);
              end;
          end;
        end;
      48: // Atari 400/800/XL (Altirra, Atari++)
        begin
          if CmdLineVar <> '' then
             CmdLineVar:= CmdLineVar+' ';
          if IsAltirra(emuFile) then
             CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [selItem.Captions[6]])
          else
             begin
               if DriveIndex = 1 then
                  CmdLineVar:= CmdLineVar+WideFormat('"%s"', [selItem.Captions[6]]) // first image can't have the "-image" param
               else
                  CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [DriveIndex, selItem.Captions[6]]);
             end;
        end;
      52: // Apple II
        begin
          if CmdLineVar <> '' then
             CmdLineVar:= CmdLineVar+' ';
          CmdLineVar:= CmdLineVar+WideFormat(FloppyCommand, [DriveIndex, selItem.Captions[6]]);
        end;
      53: // Apple IIGS
        begin
          GamesFiles.Add(selItem.Captions[6]);
        end;
      59:// Amstrad CPC
        begin
          GamesFiles.Add(selItem.Captions[6]);
        end;
    end;
    Inc(DriveIndex);

    selItem:= FormConsCompMultiFloppyGames.GamesList.Groups.NextItem(selItem);
  until selItem = nil;

  if sysID in [39, 49, 56, 53, 59] then // Commodore 64 / 128 / VIC-20 / Apple IIGS / Amstrad CPC
     GamesFiles.EndUpdate;

  if sysID in [39, 49, 56] then
     begin
       try
         GamesFiles.Insert(0, 'UNIT 8');
         GamesFiles.Insert(0, '');
         GamesFiles.Insert(0, '# Vice fliplist file');

         FloppyCommand:= GetFolderFull(38)+SystemsListCustom[sysID, 0]+'\';
         ForceDirectories(FloppyCommand);
         FileFullPath:= FloppyCommand+ExtractFileName(ChangeFileExt(FileFullPath, '.vfl'));
         GamesFiles.SaveToFile(FileFullPath); // save the flip list file
       except
         CallMessageBox;
         EnableMsgMediaTypeLabel(False);
         AddEmulatorHeader(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]]);
         AddMsgText('    Flip list file ');
         AddMsgText(FileFullPath, MsgTxtColors.colorFileName, [fsBold]);
         AddMsgText(' could not be saved. Please make sure the destination folder exists and try again. Aborting...');
         GenerateMessage(iMsgTitle, MemGameInfo.eTitle);
       end;
     end;
  if sysID = 53 then // Apple IIGS
     begin
       Result:= EditApple2GScfg(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]], '', GamesFiles, False);
     end;

  if sysID = 59 then // Amstrad CPC
     begin
       WinApeGetCartridgeFile(EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]], StrDOSName);
       WinApeEditIni(4, EmulatorFileCustom[sysID, EmulatorIndexToUseCustom[sysID]], StrDOSName, GamesFiles[0], GamesFiles[1], '');
     end;

  //ShowMessageW(CmdLineVar); // for debugging only, do not remove
  FreeAndNil(GamesFiles);
  FreeAndNil(FormConsCompMultiFloppyGames);
end;

function TFormMain.WinApeGetCartridgeFile(const emuFile: String; out CartVariable: String): Boolean;
var
  emuIni: TMemIniFile;
  iniStr: String;
begin
  iniStr:= ChangeFileExt(emuFile, '.ini');
  Result:= FileExists(iniStr);
  if not Result then
     begin
       CartVariable:= 'CPC_PLUS.CPR';
       Exit;
     end;
  emuIni:= TMemIniFile.Create(iniStr);
  CartVariable:= emuIni.ReadString('ROMS', 'Cartridge', 'CPC_PLUS.CPR');
  FreeAndNil(emuIni);
end;

function TFormMain.WinApeEditIni(MediaType: ShortInt; const emuFile, CartridgeFile, Floppy0File, Floppy1File, CassetteFile: String): Boolean;
var
  emuIni: TMemIniFile;
  iniStr: String;
begin
  iniStr:= ChangeFileExt(emuFile, '.ini');
  Result:= FileExists(iniStr);
  if not Result then
     begin
       CallMessageBox;
       AddMsgText('    File ');
       AddMsgText(iniStr, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not found. Unable to edit file.'+
                        #13#10+#13#10+'The game cannot be run!');
       GenerateMessage('Warning', 'Edit .ini file');
       Exit;
     end;
  emuIni:= TMemIniFile.Create(iniStr);
  emuIni.WriteString('ROMS', 'Cartridge', CartridgeFile); // must reset to "OS ROM"
  emuIni.WriteString('Tape', 'File Name', CassetteFile);

  emuIni.WriteString('Drives', 'Drive(0)', Floppy0File);
  emuIni.WriteString('Drives', 'Drive(1)', Floppy1File);

  emuIni.UpdateFile;
  FreeAndNil(emuIni);
end;

function TFormMain.FixDescriptionFormat(sysID: Byte; const tGameTitle: String; IsMechanical: Boolean): String;
var
  sPosition: Integer;
  newTitle: String;
begin
  Result:= tGameTitle;
  if (sysID = idDemul) or (IsMAMEBasedSys(sysID) and IsMechanical) then
     begin
       sPosition:= PosEx(', the', LowerCase(tGameTitle));
       if sPosition > 0 then
          begin
            newTitle:= tGameTitle;
            Delete(newTitle, sPosition, 5);
            Result:= 'The '+newTitle;
          end;
     end;
end;

procedure TFormMain.SetDescriptionFormat(LoadingGames: Boolean = False);
var
  GameTitle: String;
  Item: TEasyItem;
  Group: TEasyGroup;

  function SetFormat(NewFormat: Boolean): Boolean;
  begin
    case NewFormat of
      True:
        begin
          Result:= SameText(Copy(GameTitle, 1, 4), 'The ');
          if Result then
             GameTitle:= Copy(GameTitle, 5, Length(GameTitle))+', The'
          else
          begin
            Result:= SameText(Copy(GameTitle, 1, 3), 'Le ');
            if Result then
               GameTitle:= Copy(GameTitle, 4, Length(GameTitle))+', Le';
          end;
        end;
      False:
        begin
          Result:= SameText(Copy(GameTitle, Length(GameTitle)-4, 5), ', The');
          if Result then
             GameTitle:= 'The '+Copy(GameTitle, 1, Length(GameTitle)-5)
          else
          begin
            Result:= SameText(Copy(GameTitle, Length(GameTitle)-3, 4), ', Le');
            if Result then
               GameTitle:= 'Le '+Copy(GameTitle, 1, Length(GameTitle)-4);
          end;
        end;
    end;
  end;

begin
  if LoadingGames then
     begin
       if NewTitleFormat.Checked then
          begin
            GameTitle:= TempGameVars.eTitle;
            if SetFormat(True) then
               TempGameVars.eTitle:= GameTitle;
          end;
       Exit;
     end;

  if not CheckTotal(GamesListView) then
     Exit;
  Screen.Cursor:= crHourGlass;
  GamesListView.BeginUpdate;
  GamesListView.Items.ReIndexDisable:= True;
  if IsGroupedView then
  begin
    ShowFilterMsgBox('Alternate Title Format [Game, The]', 'Updating game titles, please wait...', True);
    Group:= GamesListView.Groups.FirstGroup;
    repeat
      Item:= GamesListView.Groups.FirstInGroup(Group);
      repeat
        GameTitle:= TEasyGameInfo(Item).eTitle;
        SetFormat(NewTitleFormat.Checked);
        if not SameText(GameTitle, TEasyGameInfo(Item).eTitle) then
           TEasyGameInfo(Item).eTitle:= GameTitle;
        Item:= GamesListView.Groups.NextInGroup(Group, Item);
      until Item = nil;
      Group:= GamesListView.Groups.NextGroup(Group);
    until Group = nil;
  end
  else
  begin
    Item:= GamesListView.Groups.FirstItem;
    repeat
      GameTitle:= TEasyGameInfo(Item).eTitle;
      SetFormat(NewTitleFormat.Checked);
      if not SameText(GameTitle, TEasyGameInfo(Item).eTitle) then
         TEasyGameInfo(Item).eTitle:= GameTitle;
      Item:= GamesListView.Groups.NextItem(Item);
    until Item = nil;
  end;
  GamesListView.Sort.SortAll;
  GamesListView.Items.ReIndexDisable:= False;
  GamesListView.EndUpdate;
  HideFilterMsgBox;
  Screen.Cursor:= crDefault;
  if CheckSelected(GamesListView) then
     SelectedEasyItem.MakeVisible(emvMiddle);
end;

procedure TFormMain.SetCustomGameTitle(ItemHolder: TEasyItem);
var
  iPos: Integer;

  function GetShortTitle: WideString;
  begin
    iPos:= Pos('(', TEasyGameInfo(ItemHolder).eTitle);
    if iPos = 0 then
       Result:= ''
    else
       Result:= Copy(TEasyGameInfo(ItemHolder).eTitle, 1, iPos-1);
  end;

begin
  if ItemHolder = nil then
     Exit; // no item to work with, I'm outta here!

  case MenuGameTitleExtraInfo.Tag of
    0: TEasyGameInfo(ItemHolder).eTitleShort:= ''; // full title (empty "eTitleShort" var to free RAM usage)
    1: // remove from parent sets only
      begin
        case GameIsClone(TEasyGameInfo(ItemHolder).eClone) of
          True : TEasyGameInfo(ItemHolder).eTitleShort:= '';
          False: TEasyGameInfo(ItemHolder).eTitleShort:= GetShortTitle;
        end;
      end;
    2: // remove from clone sets only
      begin
        case GameIsClone(TEasyGameInfo(ItemHolder).eClone) of
          True : TEasyGameInfo(ItemHolder).eTitleShort:= GetShortTitle;
          False: TEasyGameInfo(ItemHolder).eTitleShort:= '';
        end;
      end;
    3: TEasyGameInfo(ItemHolder).eTitleShort:= GetShortTitle; // remove from all sets (parent+clone)
  end;
end;

function TFormMain.FullFolderFix(const FileFolderString: String; const emuFileFullPath: String = ''; IsFileString: Boolean = False): String;
begin
  Result:= '';
  if FileFolderString = '' then
     Exit;
  if PosEx(':', FileFolderString) <> 0 then
     Result:= FileFolderString
  else
     begin
       if emuFileFullPath = '' then
          Result:= FrontendPath+FileFolderString
       else
          Result:= ExtractFilePath(emuFileFullPath)+FileFolderString; // added March 14, 2016
     end;
  if not IsFileString then
     Result:= IncludeTrailingPathDelimiter(Result);
end;

function TFormMain.FullEmuFolderFix(const FolderString: String; SysID: Byte; CheckZipExtension: Boolean; AlterMAMEIndex: Integer = -1): String;
begin
  Result:= '';
  if FolderString = '' then
     Exit;
  if PosEx(':', FolderString) <> 0 then
     Result:= FolderString
  else
     begin
       if AlterMAMEIndex = -1 then
          Result:= ExtractFilePath(EmulatorFile[SysID])+FolderString
       else
          Result:= ExtractFilePath(AlterMAMEFile[AlterMAMEIndex])+FolderString;

     end;
  case CheckZipExtension of // current being used by zipped images only...
    True:
      begin
        if (PosEx('.zip', LowerCase(Result)) = 0) then// and
           //(PosEx('.7z',  LowerCase(Result)) = 0) then // future expansion if games start to use this function (February 27, 2018)
           Result:= IncludeTrailingPathDelimiter(Result);
      end;
    False: Result:= IncludeTrailingPathDelimiter(Result);
  end;
end;

