procedure TFormMain.PopupMenuGamesListPopup(Sender: TObject);
var
  GameDriver, GameSystem, strDriver, strDriverAlt: String;
  MultiSelected, IsMAMEAvailable: Boolean;
  selCount, iLoop, iVersion, iVersionAlt: Integer;

  function GetSelectedCount(MenuHolder: TMenuItem): Boolean;
  begin
    Result:= True;
    MenuHolder.Caption:= Format(MenuHolder.Hint, [selCount]);
  end;

  function ToggleOptions(const FileName: String; PopupSetName, PopupDeleteName: TMenuItem): Boolean;
  var
    softFolderStr: String;
  begin
    PopupSetName.Enabled:= True;
    if not PopupSetName.Visible then
       PopupSetName.Visible:= True;
    if not PopupDeleteName.Visible then
       PopupDeleteName.Visible:= True;
    case IsMAMEBasedSys(MemGameInfo.eSystemID) of
       True:
         begin
           softFolderStr:= '';
           if MemGameInfo.eSoftwareName <> '' then
              softFolderStr:= MemGameInfo.eSoftwareName+'\';

           PopupDeleteName.Visible:= FileExists(IniFilesDir[MemGameInfo.eSystemID]+softFolderStr+FileName);
         end;
       False:
         begin
           if MemGameInfo.eSystemID in [idSupermodel, idZiNc] then
              PopupDeleteName.Visible:= FileExists(GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID)+FileName);
         end;
    end;
    Result:= PopupDeleteName.Visible;
  end;

  function ToggleOptionsMAME(PopupSetName, PopupDeleteName: TMenuItem): Boolean;
  begin
    Result:= MemGameInfo.eSystemID = idMAME;
    if not Result then
       begin
         PopupSetName.Visible:= False;
         PopupDeleteName.Visible:= False;
         Exit;
       end;
    PopupSetName.Enabled:= True;
    if not PopupSetName.Visible then
       PopupSetName.Visible:= True;

    PopupDeleteName.Visible:= FileExists(IniFilesDir[idMAME]+PopupSetName.Hint+'.ini');
  end;

begin

  if not ValidateSelectedGame then
     begin
       PostMessage(Handle, WM_LBUTTONDOWN, MK_LBUTTON, 0);
       PostMessage(Handle, WM_LBUTTONUP, MK_LBUTTON, 0);
       Exit;
     end;

  iVersion:= -1;
  iVersionAlt:= -1;

  IsMAMEAvailable:= ValidateArcadeEmulatorFile(idMAME);
  if IsMAMEBasedSys(MemGameInfo.eSystemID) then
     iVersion:= GetMAMEBuild(MemGameInfo.eSystemID);

  PopupMenuGamesList.BeginUpdate;
  PopupEnableAutoRunCustomGamesWithMAME.Visible:= MemGameInfo.eIsCustomGame;
  case MemGameInfo.eIsCustomGame of
    True:
      begin
        PopupPlayGameStandard.Caption:= 'Run Game with MAME v'+buildMAME;
        PopupPlayGameWithCustomSystem.Caption:= 'Run Game';
      end;
    False:
      begin
        PopupPlayGameStandard.Caption:= 'Run Game';
        PopupPlayGameWithCustomSystem.Caption:= 'Run Game (Custom Emulators)';
      end;
  end;

  PopupPlayGameWithCustomSystem.Enabled:= MemGameInfo.eIsCustomGame or
             ((MemGameInfo.eCustomSystemID <> -1) and GameHaveROMs(MemGameInfo.eHaveGameROMs) and (not MemGameInfo.eROMsAllNoDump));
  PopupPlayGameWithCustomSystem.Visible:= PopupPlayGameWithCustomSystem.Enabled;
  
  if (MemGameInfo.eSystemID = idMAME) or MemGameInfo.eIsCustomGame then
     iVersionAlt:= GetMAMEBuild(MemGameInfo.eSystemID, 1);

  // need to check for eIsCustomGame and make it visible, but also need to check if mame.exe is selected and ValidateFile()
  selCount:= GamesListView.Selection.Count;

  case MemGameInfo.eIsCustomGame of
    True:
      begin
        PopupMachineToRunGame.Visible:= (IsMAMEAvailable and (MemGameInfo.eSoftwareName <> '')) or (IsMAMEAvailable and MemGameInfo.eIsCustomGame);
        PopupPlayGameStandard.Visible:= PopupMachineToRunGame.Visible and PopupEnableAutoRunCustomGamesWithMAME.Checked;
        if PopupMachineToRunGame.Visible then
           PopupMachineToRunGame.Visible:= (selCount = 1) and (not PanelMachinesList.Visible);
      end;
    False:
      begin
        PopupMachineToRunGame.Visible:= IsMAMEBasedSys(MemGameInfo.eSystemID) and
                                        (selCount = 1) and (MemGameInfo.eSoftwareName <> '') and (not PanelMachinesList.Visible);

        PopupPlayGameStandard.Visible:= ValidateArcadeEmulatorFile(MemGameInfo.eSystemID);
      end;
  end;

  PopupRunConsoleComputerGameWithMAME.Visible:= not PopupPlayGameStandard.Visible;
  if PopupRunConsoleComputerGameWithMAME.Visible then
     PopupRunConsoleComputerGameWithMAME.Caption:= 'Run Game With MAME v'+buildMAME;

  // AlterMAME 1
  PopupAutoRunGameAlterMAME.Visible:= ((MemGameInfo.eSystemID = idMAME) and (AlterMAMEFile[1] <> '')) or (IsMAMEAvailable and (AlterMAMEFile[1] <> '') and MemGameInfo.eIsCustomGame);
  if PopupAutoRunGameAlterMAME.Visible then
     PopupAutoRunGameAlterMAME.Visible:= FileExists(AlterMAMEFile[1]);

  if PopupAutoRunGameAlterMAME.Visible then
     begin
       case MemGameInfo.eIsCustomGame of
         True:
           begin
             PopupAutoRunGameAlterMAME.Visible:= PopupEnableAutoRunCustomGamesWithMAME.Checked and ((iVersionAlt >= 162) or (iVersionAlt = -1));
           end;
         False:
           begin
             if MemGameInfo.eSoftwareName <> '' then
                PopupAutoRunGameAlterMAME.Visible:= ((iVersionAlt >= 162) or (iVersionAlt = -1))
           end;
       end;
     end;

  PopupRunGameWithAlterMAME.Visible:= PopupAutoRunGameAlterMAME.Visible;

  // AlterMAME 2
  PopupAutoRunGameAlterMAME2.Visible:= ((MemGameInfo.eSystemID = idMAME) and (AlterMAMEFile[2] <> '')) or (IsMAMEAvailable and (AlterMAMEFile[2] <> '') and MemGameInfo.eIsCustomGame);
  if PopupAutoRunGameAlterMAME2.Visible then
     PopupAutoRunGameAlterMAME2.Visible:= FileExists(AlterMAMEFile[2]);

  if PopupAutoRunGameAlterMAME2.Visible then
     begin
       case MemGameInfo.eIsCustomGame of
         True:
           begin
             PopupAutoRunGameAlterMAME2.Visible:= PopupEnableAutoRunCustomGamesWithMAME.Checked and ((iVersionAlt >= 162) or (iVersionAlt = -1));
           end;
         False:
           begin
             if MemGameInfo.eSoftwareName <> '' then
                PopupAutoRunGameAlterMAME2.Visible:= ((iVersionAlt >= 162) or (iVersionAlt = -1))
           end;
       end;
     end;

  PopupRunGameWithAlterMAME2.Visible:= PopupAutoRunGameAlterMAME2.Visible;

  // AlterMAME 1 (EmuCon systems)
  PopupRunConsoleComputerGameWithAlterMAME1.Visible:= (not PopupRunGameWithAlterMAME.Visible) and ((iVersionAlt >= 162) or (iVersionAlt = -1) and (AlterMAMEFile[1] <> ''));
  if PopupRunConsoleComputerGameWithAlterMAME1.Visible then
     PopupRunConsoleComputerGameWithAlterMAME1.Visible:= MemGameInfo.eIsCustomGame;

  if PopupRunConsoleComputerGameWithAlterMAME1.Visible then
     PopupRunConsoleComputerGameWithAlterMAME1.Caption:= 'Run Game With AlterMAME v'+buildAlterMAME[1];

  // AlterMAME 2 (EmuCon systems)
  PopupRunConsoleComputerGameWithAlterMAME2.Visible:= (not PopupRunGameWithAlterMAME2.Visible) and ((iVersionAlt >= 162) or (iVersionAlt = -1) and (AlterMAMEFile[2] <> ''));
  if PopupRunConsoleComputerGameWithAlterMAME2.Visible then
     PopupRunConsoleComputerGameWithAlterMAME2.Visible:= MemGameInfo.eIsCustomGame;

  if PopupRunConsoleComputerGameWithAlterMAME2.Visible then
     PopupRunConsoleComputerGameWithAlterMAME2.Caption:= 'Run Game With AlterMAME 2 v'+buildAlterMAME[2];

  PopupPlayGameExtraParametersMAME.Visible:= ((MemGameInfo.eSystemID = idSupermodel) or IsMAMEBasedSys(MemGameInfo.eSystemID)) and ValidateArcadeEmulatorFile(MemGameInfo.eSystemID);
  if PopupPlayGameExtraParametersMAME.Visible and (not MemGameInfo.eIsCustomGame) then
     begin
       if IsROM_Device(MemGameInfo.eROMIdentification) or IsROM_Bios(MemGameInfo.eROMIdentification) then
          PopupPlayGameExtraParametersMAME.Visible:= False
       else
          begin
            if MemGameInfo.eSystemID <> idSupermodel then
               begin
                 if not SameText(PopupPlayGameExtraParametersMAME.Caption, 'Run Game (Extra Parameters)') then
                    PopupPlayGameExtraParametersMAME.Caption:= 'Run Game (Extra Parameters)';
               end
            else
               begin
                 if not SameText(PopupPlayGameExtraParametersMAME.Caption, 'Run Game (Load a Save State)') then
                    PopupPlayGameExtraParametersMAME.Caption:= 'Run Game (Load a Save State)';
               end;
          end;
     end;

  PopupCustomSettings.Visible:= PopupPlayGameStandard.Visible and
                                (not (MemGameInfo.eSystemID in [idDaphne, idDemul, idDICE, idSegaModel2])) and (MemGameInfo.eSoftwareName = '') and (not MemGameInfo.eIsCustomGame);

  PopupCustomMAME.Visible:= PopupPlayGameStandard.Visible and (IsMAMEBasedSys(MemGameInfo.eSystemID)) and (MemGameInfo.eSoftwareName = '');

  if IsROM_Device(MemGameInfo.eROMIdentification) then
     begin
       PopupCustomSettings.Visible:= False;
     end;
  PopupDeleteSelectedGames.Visible:= PopupDeleteSelectedGames.Enabled and (PopupPlayGameStandard.Visible or MemGameInfo.eIsCustomGame);
  PopupExtraCopyMoveSelectedGames.Visible:= PopupDeleteSelectedGames.Visible;

  if selCount = 1 then
     PopupDeleteSelectedGamesFromGamesList.Visible:= MemGameInfo.eIsCustomGame;

  PopupScanGames.Visible:= PopupPlayGameStandard.Visible and (not MemGameInfo.eIsCustomGame);

  MultiSelected:= selCount > 1;// CheckMultipleSelected(GamesListView);

  PopupSelectSet.Clear;

  if GameIsClone(MemGameInfo.eClone) and (ButtonGameFilterParentClone.Tag <> 2) then
     begin
     TMenuItem(AddMenuItem(PopupSelectSet, 'Select Parent Game ['+MemGameInfo.eClone+']',
               MemGameInfo.eClone, True, False, False, 1000)).OnClick:= PopupSelectSetExtra;
     AddMenuItem(PopupSelectSet, '-', '', True, False, False);
     end;

  if ValidateBiosName(MemGameInfo.eBiosName, MemGameInfo.eName) then
     TMenuItem(AddMenuItem(PopupSelectSet, 'Select BIOS ['+MemGameInfo.eBiosName+']',
               MemGameInfo.eBiosName, True, False, False)).OnClick:= PopupSelectSetExtra;

  if TEasyGameInfo(SelectedEasyItem).eDeviceSets <> nil then
     begin
       for iLoop:=0 to TEasyGameInfo(SelectedEasyItem).eDeviceSets.Count-1 do
       begin
         TMenuItem(AddMenuItem(PopupSelectSet, 'Select Device ['+TEasyGameInfo(SelectedEasyItem).eDeviceSets[iLoop]+']',
                               TEasyGameInfo(SelectedEasyItem).eDeviceSets[iLoop], True, False, False)).OnClick:= PopupSelectSetExtra;
       end;
     end;
     
  PopupSelectSet.Visible:= PopupSelectSet.Count > 0;

  GameDriver:= ChangeFileExt(MemGameInfo.eDriverName, '');
  GameSystem:= GetArcadeSystemIniSection(MemGameInfo.eSystemID, True);

  case MultiSelected of
    True:
      begin
        PopupAddToFavorites.Visible:= (SelectedFilterName <> 'favorites');
        PopupDeleteFromFavorites.Visible:= True;
        PopupAddToSpecialList.Visible:= True;
        PopupRemoveFromSpecialList.Visible:= True;
      end;
    False:
      begin
        if selCount = 1 then
        begin
          PopupAddToFavorites.Visible:= (SelectedFilterName <> 'favorites') and (not MemGameInfo.eIsFavorite);
          PopupDeleteFromFavorites.Visible:= MemGameInfo.eIsFavorite;

          PopupAddToSpecialList.Visible:= not MemGameInfo.eIsSpecial;
          PopupRemoveFromSpecialList.Visible:= MemGameInfo.eIsSpecial;
        end;
      end;
  end;

  if PopupAddToFavorites.Visible then
     GetSelectedCount(PopupAddToFavorites);
  if PopupDeleteFromFavorites.Visible then
     GetSelectedCount(PopupDeleteFromFavorites);

  if PopupAddToFavorites.Visible then
     GetSelectedCount(PopupAddToSpecialList);
  if PopupDeleteFromFavorites.Visible then
     GetSelectedCount(PopupRemoveFromSpecialList);

  strDriver:= '';

  if IsMAMEBasedSys(MemGameInfo.eSystemID) then
     begin
       if (iVersion > 118) or (iVersion = -1) then
          strDriver:= 'source\';
       // iVersion >= 179 ... driver file only in source\drivername.ini
     end;
  if MemGameInfo.eSystemID = idMAME then
     begin
       if (iVersionAlt > 118) or (iVersionAlt = -1) then
          strDriverAlt:= 'source\';
     end;

  if PopupCustomSettings.Visible then
     begin
       if MemGameInfo.eSystemID <> idZiNc then
          begin
            if MemGameInfo.eSoftwareName <> '' then
               begin
                 PopupSetCustomOptions.Visible:= False;
                 PopupDeleteCustomOptions.Visible:= False;
               end
            else
               ToggleOptions(MemGameInfo.eName+'.ini',
                             PopupSetCustomOptions, PopupDeleteCustomOptions)
          end
       else
          ToggleOptions(MemGameInfo.eName+'.cfg',
                        PopupSetCustomOptions, PopupDeleteCustomOptions);

       PopupSetGameDriverCustomOptions.Visible:= (GameDriver <> '') and (IsMAMEBasedSys(MemGameInfo.eSystemID)); // MAME, HBMAME
       PopupDeleteGameDriverCustomOptions.Visible:= PopupSetGameDriverCustomOptions.Visible;
       case IsMAMEBasedSys(MemGameInfo.eSystemID) of
         True:
           begin
             if PopupSetCustomOptions.Visible then
                PopupSetCustomOptions.Caption:= Format(PopupSetCustomOptions.Hint, [MemGameInfo.eName+'.ini']);
             if PopupDeleteCustomOptions.Visible then
                PopupDeleteCustomOptions.Caption:= Format(PopupDeleteCustomOptions.Hint, [MemGameInfo.eName+'.ini']);
             if GameDriver <> '' then
                begin
                  //check for GameName = DriverName and do not show it
                  ToggleOptions(strDriver+GameDriver+'.ini',
                                PopupSetGameDriverCustomOptions, PopupDeleteGameDriverCustomOptions);

                  PopupSetGameDriverCustomOptions.Caption:= Format(PopupSetGameDriverCustomOptions.Hint, [strDriver+GameDriver+'.ini']);
                  PopupDeleteGameDriverCustomOptions.Caption:= Format(PopupDeleteGameDriverCustomOptions.Hint, [strDriver+GameDriver+'.ini']);
                end;
           end;
         False:
           begin
             case MemGameInfo.eSystemID of
               idSupermodel:
                 begin
                   PopupSetCustomOptions.Caption:= Format(PopupSetCustomOptions.Hint, [MemGameInfo.eName+'.ini']);
                   PopupDeleteCustomOptions.Caption:= Format(PopupDeleteCustomOptions.Hint, [MemGameInfo.eName+'.ini']);
                 end;
               idZiNc:
                 begin
                   PopupSetCustomOptions.Caption:= Format(PopupSetCustomOptions.Hint, [MemGameInfo.eName+'.cfg']);
                   PopupDeleteCustomOptions.Caption:= Format(PopupDeleteCustomOptions.Hint, [MemGameInfo.eName+'.cfg']);
                 end;
             end;
             PopupSetDebugCustomOptions.Visible:= False;
             PopupDeleteDebugCustomOptions.Visible:= False;
           end;
       end;
     end;

  if PopupCustomMAME.Visible then
     begin
       if (iVersion > 166) or (iVersion = -1) then
          begin
            ToggleOptions('raster.ini', PopupSetMAMERasterGameOptions, PopupDeleteMAMERasterGameOptions);
            ToggleOptions('lcd.ini', PopupSetMAMELCDGameOptions, PopupDeleteMAMELCDGameOptions);
          end
       else
          begin
            PopupSetMAMERasterGameOptions.Visible:= False;
            PopupDeleteMAMERasterGameOptions.Visible:= False;
            PopupSetMAMELCDGameOptions.Visible:= False;
            PopupDeleteMAMELCDGameOptions.Visible:= False;
          end;
       if (iVersion > 190) or (iVersion = -1) then
          begin
            ToggleOptions('svg.ini', PopupSetMAMESVGGameOptions, PopupDeleteMAMESVGGameOptions);
          end
       else
          begin
            PopupSetMAMESVGGameOptions.Visible:= False;
            PopupDeleteMAMESVGGameOptions.Visible:= False;
          end;

       ToggleOptions('vector.ini', PopupSetMAMEVectorGamesOptions, PopupDeleteMAMEVectorGamesOptions);
       ToggleOptions('debug.ini', PopupSetDebugCustomOptions, PopupDeleteDebugCustomOptions);
       ToggleOptions('horizont.ini', PopupSetMAMEHorizontalGamesOptions, PopupDeleteMAMEHorizontalGamesOptions);
       ToggleOptions('vertical.ini', PopupSetMAMEVerticalGamesOptions, PopupDeleteMAMEVerticalGamesOptions);

       ToggleOptionsMAME(PopupSetArcadeIniCustomOptions, PopupDeleteArcadeIniCustomOptions);
       ToggleOptionsMAME(PopupSetConsoleIniCustomOptions, PopupDeleteConsoleIniCustomOptions);
       ToggleOptionsMAME(PopupSetComputerIniCustomOptions, PopupDeleteComputerIniCustomOptions);
       ToggleOptionsMAME(PopupSetOtherSysIniCustomOptions, PopupDeleteOtherSysIniCustomOptions);
     end;

  // custom command line detection code... August 17, 2017
  {PopupPlayCustom_CommandLineGame.Visible:= FileExists(GetCustomCommandLineFileFullPath(MemGameInfo.eName, MemGameInfo.eSystemID));
  if PopupPlayCustom_CommandLineGame.Visible then
     PopupPlayCustom_CommandLineGame.Caption:= Format(PopupPlayCustom_CommandLineGame.Hint, [MemGameInfo.eName]);

  PopupPlayCustom_CommandLineDriver.Visible:= FileExists(GetCustomCommandLineFileFullPath(GameDriver, MemGameInfo.eSystemID));
  if PopupPlayCustom_CommandLineDriver.Visible then
     PopupPlayCustom_CommandLineDriver.Caption:= Format(PopupPlayCustom_CommandLineDriver.Hint, [GameDriver]);

  PopupPlayCustom_CommandLineSystem.Visible:= FileExists(GetCustomCommandLineFileFullPath(GameSystem, MemGameInfo.eSystemID));
  if PopupPlayCustom_CommandLineSystem.Visible then
     PopupPlayCustom_CommandLineSystem.Caption:= Format(PopupPlayCustom_CommandLineSystem.Hint, [GameSystem]);

  PopupPlayCustom_CommandLine.Visible:= PopupPlayCustom_CommandLineGame.Visible or
                                        PopupPlayCustom_CommandLineDriver.Visible or
                                        PopupPlayCustom_CommandLineSystem.Visible;}


  PopupScanResultsSelectedGame.Visible:= IsROMsListBasedSys(MemGameInfo.eSystemID) and
                                         (GamesListView.Selection.Count = 1) and
                                         (MemGameInfo.eGameSetStatus = 1) and (not MemGameInfo.eIsCustomGame); // only with Missing ROMs/CHDs

  PopupThumbnails.Visible:= IsThumbnailView;
  PopupThumbDeleteSelectedGameSnapshot.Visible:= IsThumbnailView and (not MultiSelected);
  if PopupThumbDeleteSelectedGameSnapshot.Visible then
     PopupThumbDeleteSelectedGameSnapshot.Visible:= TEasyGameInfo(SelectedEasyItem).eThumbnailLoaded and (not TEasyGameInfo(SelectedEasyItem).eThumbnailIsZipped);
  if PopupThumbDeleteSelectedGameSnapshot.Visible then
     PopupThumbDeleteSelectedGameSnapshot.Caption:= 'Delete Selected '+GetImageCategoryTitle(1);

  if not PopupEnableMAMu_Icons.Checked then
     PopupEnableMAMu_Icons.Enabled:= DirectoryExists(MAMu_Folder);

  PopupScanAllSelectedGames.Enabled:= (selCount > 0) and (not MemGameInfo.eIsCustomGame);
  PopupScanForceSelectedGamesAvailable.Enabled:= PopupScanAllSelectedGames.Enabled;
  if PopupScanAllSelectedGames.Enabled then
     begin
       GetSelectedCount(PopupScanAllSelectedGames);
       GetSelectedCount(PopupScanForceSelectedGamesAvailable);
     end
  else
     begin
       PopupScanAllSelectedGames.Caption:= 'Selected Games';
       PopupScanForceSelectedGamesAvailable.Caption:= 'Force Selected Games Available';
     end;
  PopupGameDetails.Enabled:= GamesListView.Selection.Count = 1;
  PopupMenuGamesList.EndUpdate;
end;

