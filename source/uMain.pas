function TFormMain.GetCustomMediaTypeID(const MAMESoftListExecParameter: String): Integer;
begin
  // this is to assign non-arcade MediaArrayCustom[] into software list games, to run MAME softlist games with custom emulators
  Result:= 1;
  if MAMESoftListExecParameter = 'cart1' then
     Result:= 1
  else
  if (MAMESoftListExecParameter = 'cdrom') or
     (MAMESoftListExecParameter = 'cdrom1') then
     Result:= 2
  else
  if MAMESoftListExecParameter = 'flop1' then
     Result:= 3
  else
  if (MAMESoftListExecParameter = 'cass1') or
     (MAMESoftListExecParameter = 'tape') then
     Result:= 4
  else
  if MAMESoftListExecParameter = 'hard1' then
     Result:= 5;
end;

function TFormMain.GetMediaTypeIconMsgBox(CustomMediaTypeIndex: Integer; IsCustomGame: Boolean; ArcadeMediaType: Integer; IconHolder: TImage; MAMESoftListExecParameter: String = ''): Integer;
var
  Continue: Boolean;
begin
  Result:= -1;
  Continue:= True;
  if IconHolder <> nil then
     Continue:= IconHolder.Tag <> -1;

  // "IconHolder = nil" is only used in "Last Played Games (MRU)"... for now! 
  if not Continue then
     Exit;

  //if IconHolder.Tag <> -1 then
  //   begin
       if CustomMediaTypeIndex <> -1 then
       begin
         // for EmuCon games only
         case CustomMediaTypeIndex of
           1: Result:= 16;
           2: Result:= 20;
           3: Result:= 17;
           4: Result:= 18;
           5: Result:= 22;
         end;
       end
       else
       begin
         if not IsCustomGame then
         begin
           // for MAME and arcade games only
           if MAMESoftListExecParameter <> '' then
              begin
                Result:= GetCustomMediaTypeID(MAMESoftListExecParameter);
                case Result of
                  1: Result:= 16;
                  2: Result:= 20;
                  3: Result:= 17;
                  4: Result:= 18;
                  5: Result:= 22;
                end;
              end
           else
              begin
                case ArcadeMediaType of
                  0: Result:= 15;
                  1: Result:= 19;
                end;
              end;
         end;
       end;

       if Result = -1 then
          Result:= 15; // default to "ROM" media type

       if IconHolder <> nil then
          IL_LeftPanel.GetIcon(Result, IconHolder.Picture.Icon);
  //   end;
end;

// load games from files into EasyListView (no filtering, all games visible)
procedure TFormMain.LoadGames(LoadArcade, LoadSoftwareListMESS, LoadCustomGames: Boolean; ClearGamesList: Boolean = False);
var
  //tempString: String;
  Loop: Integer;
  SoftwareGames: THashedStringList;
begin
  if FormStatus.Visible then
     begin
       FormStatus.TitleStr('Load Games List');
       FormStatus.MessageStr('Loading games list.');
     end;
  FormStatus.SetProgressPos(0);
  if CheckTotal(GamesListView) then
     begin
       GlobalThreadManager.FlushMessageCache(GamesListView, TID_START); // just in case...
       if ClearGamesList then
          ClearListView(GamesListView);
       Application.ProcessMessages;
     end;
  if PopupEnableMAMu_Icons.Checked then
     ResetMAMu_ImageList(True); // this will reset EL's default games icons (no need to reset item icons!!!)

  CompleteGamesList:= THashedStringList.Create;
  //CompleteGamesList.BeginUpdate; // no need as this is done in GetGamesList() function

  if LoadArcade then
  begin
    for Loop:= 1 to MaxArcadeSystems do
        GetGamesList(CompleteGamesList, Loop);
  end;

  if LoadSoftwareListMESS then
  begin
    //if IsSystemAvailable(idMAME) then
    //begin
      FormStatus.MessageStr('Loading software list games.');
      SoftwareGames:= THashedStringList.Create;
      GetFilesList(GetGamesFolderEL(1), '.el', '*.el', SoftwareGames, False, True, False);
      if SoftwareGames.Count > 0 then
         begin
           SoftwareGames.Sorted:= False;
           SoftwareGames.BeginUpdate;
           for Loop:=0 to SoftwareGames.Count-1 do
               SoftwareGames[Loop]:= ChangeFileExt(SoftwareGames[Loop], '');
           SoftwareGames.EndUpdate;

           for Loop:=0 to SoftwareGames.Count-1 do
               GetGamesList(CompleteGamesList, idMAME, 1, SoftwareGames[Loop]);
         end;
      FreeandNil(SoftwareGames);
    //end;
  end;

  if LoadCustomGames then
  begin
    FormStatus.MessageStr('Loading EmuCon games.');
    for Loop:= 1 to MaxConsoleComputerSystems do
        GetGamesListCustom(CompleteGamesList, Loop);
  end;

  //CompleteGamesList.EndUpdate; // no need; done in GetGamesList() function
  //CompleteGamesList.SaveToFile('d:\EmuLoader\completelist.txt'); // for debugging only
  //ShowMessage('stop'); // for debugging only

  // ResetNoImageLoaded; // this will be executed in ApplyFilters, which is called after loading the games list
                         // or changing between games filters...

  //ResetThumbnails; // no need since when clearing EasyListView, thumbs are freed from memory
  FormStatus.MessageStr('Adding games to games list.');
  AddGames;
  FreeAndNil(CompleteGamesList);

  if FormStatus.Visible then
     FormStatus.SetFocus;
end;

procedure TFormMain.SetMainToolBarIcon(const ButtonName: TToolButton);
var
  tempString: String;

begin
  // 00 -> main menu (never changes)
  // 01 -> view mode
  // 02 -> machine type and systems filter (arcade/console/computer/handheld/MAME)
  // 03 -> systems quick filter
  // 04 -> favorites (never changes)
  // 05 -> arcade games filters
  // 06 -> parent/clone
  // 07 -> have/miss
  // 08 -> driver status (working/non-working)
  // 09 -> MAMu_ icons (never changes)
  // 10 -> extra filters (never changes)
  // 11 -> load game with image .cue (never changes)
  // 12 -> EmuCon emulator parameters to use (never changes)
  // 13 -> last played games MRU (never changes)
  // 14 -> select main emulators to play with EmuCon (never changes)

  if ButtonName = ButtonViewMode then
     SetIcon(IL_ViewMode_Large, IL_ViewMode_Small, IL_ToolBarButtons, ButtonViewMode.Tag, 1)
  else
  if ButtonName = ButtonSystemsQuickFilter then
     begin
       if IsSystemQuickFilterEnabled then
          SetToolBarIcon('filter_systems_quick_enabled.ico', GetFolderFull(40), IL_ToolBarButtons, 3)
       else
          SetToolBarIcon('filter_systems_quick_disabled.ico', GetFolderFull(40), IL_ToolBarButtons, 3);
     end
  else
  if ButtonName = ButtonGameFilterMain then
     begin
       ButtonGameFilterMain.Enabled:= (SelectedFilterName <> 'favorites') and (not PanelMachinesList.Visible);
       tempString:= GetFolderFull(32);
       case MenuSmallToolBar.Checked of
         True:
           begin
             SetToolBarIcon('allgames', tempString+'arcade_filters\', IL_ToolBarButtons, 5);
           end;
         False:
           begin
             case ButtonGameFilterMain.Enabled of
               True : SetToolBarIcon(SelectedFilterName, tempString+'arcade_filters\', IL_ToolBarButtons, 5);
               False: SetToolBarIcon(LastFilterName, tempString+'arcade_filters\', IL_ToolBarButtons, 5);
             end;
           end;
       end;
       //ButtonGameFilterMain.Enabled:= (SelectedFilterName <> 'favorites') and (not PanelMachinesList.Visible);
     end
  else
  if ButtonName = ButtonGameFilterParentClone then
     SetIcon(IL_FilterParentClone_Large, IL_FilterParentClone_Small, IL_ToolBarButtons, ButtonGameFilterParentClone.Tag, 6)
  else
  if ButtonName = ButtonGameFilterHaveMiss then
     SetIcon(IL_FilterHaveMiss_Large, IL_FilterHaveMiss_Small, IL_ToolBarButtons, ButtonGameFilterHaveMiss.Tag, 7)
  else
  if ButtonName = ButtonGameFilterDriverStatus then
     SetIcon(IL_FilterWorkingNonWorking_Large, IL_FilterWorkingNonWorking_Small, IL_ToolBarButtons, ButtonGameFilterDriverStatus.Tag, 8);
end;

