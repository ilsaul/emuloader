procedure TFormMain.SetPopupCustomEmulators(const CustomSystemID: Integer);
var
  EmuTitle: String;
  IsDiscGame: Boolean;
  selCount: Integer;
  AssociatedApp: WideString;

  function SetEmulatorIcon(EmulatorIndex: Integer): Integer;
  begin
    if EmulatorFileCustom[CustomSystemID, EmulatorIndex] <> '' then
       begin
         //if IsExeBatchFile(EmulatorFile[SystemID, EmulatorIndex]) then
         //   beep; // for debugging only, do not remove (April 01, 2018)
         Result:= GetAppIcon(EmulatorFileCustom[CustomSystemID, EmulatorIndex], IL_PopupPlayCustomEmulators, 5+EmulatorIndex);
         if Result = -1 then
            Result:= 4+Ord(IsExeBatchFile(EmulatorFileCustom[CustomSystemID, EmulatorIndex]));
       end
    else
       begin
         Result:= -1; // emulator not defined, icon is NIL
       end;
  end;

  function SetVisible(MenuHolder: TMenuItem; IsVisible: Boolean): Boolean;
  begin
    if MenuHolder.Visible <> IsVisible then
       MenuHolder.Visible:= IsVisible;

    if MenuHolder.Visible then
       begin
         if MenuHolder <> MenuSeparatorCustomCart then
            begin
              MenuHolder.ImageIndex:= SetEmulatorIcon(MenuHolder.Tag);
              MenuHolder.Visible:= MenuHolder.Hint <> '';
            end;
       end;

  end;

  function SetEmuTitle(EmulatorIndex: Integer): String;
  begin
    case EmulatorIndex of
      1: MenuCustomPlayWithEmulator1.Hint:= EmulatorFileCustom[CustomSystemID, EmulatorIndex];
      2: MenuCustomPlayWithEmulator2.Hint:= EmulatorFileCustom[CustomSystemID, EmulatorIndex];
      3: MenuCustomPlayWithEmulator3.Hint:= EmulatorFileCustom[CustomSystemID, EmulatorIndex];
      4: MenuCustomPlayWithEmulator4.Hint:= EmulatorFileCustom[CustomSystemID, EmulatorIndex];
    end;
    if EmulatorFileCustom[CustomSystemID, EmulatorIndex] <> '' then
       begin
         Result:= EmulatorVersionCustom[CustomSystemID, EmulatorIndex];
         if Result = '' then
            Result:= ExtractFileName(EmulatorFileCustom[CustomSystemID, EmulatorIndex]);
         Result:= 'Play with '+Result;
       end
    else
       begin
         Result:= 'Play with Emulator '+IntToStr(EmulatorIndex)+' (empty)';
       end;
  end;

  function GetSelectedCount(MenuHolder: TMenuItem): Boolean;
  begin
    Result:= True;
    MenuHolder.Caption:= Format(MenuHolder.Hint, [selCount]);
  end;

begin
  PopupMenuGamesList.Tag:= CustomSystemID;
  PopupMenuGamesList.HelpContext:= 0;
  selCount:= GamesListView.Selection.Count;
  if CheckSelected(GamesListView) then
     IsDiscGame:= MemGameInfo.eCustomMediaType = 2// SystemUseDisc(SystemID);
  else
     IsDiscGame:= False;

  PopupMenuGamesList.BeginUpdate;

  case IsDiscGame of
    True:
      begin
        case EmulatorIndexToUseCustom[CustomSystemID] of
          1:
            begin
              case EmulatorMountVirtualDrive[CustomSystemID] of
                False: MenuCustomPlayWithEmulator1.Checked:= True;
                True : MenuCustomPlayWithEmulator1VirtualDrive.Checked:= True;
              end;
            end;
          2:
            begin
              case EmulatorMountVirtualDrive[CustomSystemID] of
                False: MenuCustomPlayWithEmulator2.Checked:= True;
                True : MenuCustomPlayWithEmulator2VirtualDrive.Checked:= True;
              end;
            end;
          3:
            begin
              case EmulatorMountVirtualDrive[CustomSystemID] of
                False: MenuCustomPlayWithEmulator3.Checked:= True;
                True : MenuCustomPlayWithEmulator3VirtualDrive.Checked:= True;
              end;
            end;
          4:
            begin
              case EmulatorMountVirtualDrive[CustomSystemID] of
                False: MenuCustomPlayWithEmulator4.Checked:= True;
                True : MenuCustomPlayWithEmulator4VirtualDrive.Checked:= True;
              end;
            end;
        end;
      end;
    False:
      begin
        case EmulatorIndexToUseCustom[CustomSystemID] of
          1: MenuCustomPlayWithEmulator1Cart.Checked:= True;
          2: MenuCustomPlayWithEmulator2Cart.Checked:= True;
          3: MenuCustomPlayWithEmulator3Cart.Checked:= True;
          4: MenuCustomPlayWithEmulator4Cart.Checked:= True;
        end;
      end;
  end;

  EmuTitle:= SetEmuTitle(1);
  MenuCustomPlayWithEmulator1.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator1VirtualDrive.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator1Cart.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator1Cart.Hint:= MenuCustomPlayWithEmulator1.Hint;

  EmuTitle:= SetEmuTitle(2);
  MenuCustomPlayWithEmulator2.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator2VirtualDrive.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator2Cart.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator2Cart.Hint:= MenuCustomPlayWithEmulator2.Hint;

  EmuTitle:= SetEmuTitle(3);
  MenuCustomPlayWithEmulator3.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator3VirtualDrive.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator3Cart.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator3Cart.Hint:= MenuCustomPlayWithEmulator3.Hint;

  EmuTitle:= SetEmuTitle(4);
  MenuCustomPlayWithEmulator4.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator4VirtualDrive.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator4Cart.Caption:= EmuTitle;
  MenuCustomPlayWithEmulator4Cart.Hint:= MenuCustomPlayWithEmulator4.Hint;

  SetVisible(MenuCustomPlayWithEmulator1, IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator1VirtualDrive, IsDiscGame);
  SetVisible(MenuSeparatorCustomEmu2, IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator2, IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator2VirtualDrive, IsDiscGame);
  SetVisible(MenuSeparatorCustomEmu3, IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator3, IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator3VirtualDrive, IsDiscGame);
  SetVisible(MenuSeparatorCustomEmu4, IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator4, IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator4VirtualDrive, IsDiscGame);

  SetVisible(MenuSeparatorCustomCart, not IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator1Cart, not IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator2Cart, not IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator3Cart, not IsDiscGame);
  SetVisible(MenuCustomPlayWithEmulator4Cart, not IsDiscGame);

  SeparatorCustomSystemTitle.Hint:= SystemsListCustom[CustomSystemID, 0];

  MenuCustomPlayWithAssociatedApplication.Caption:= 'Play with Associated Application';
  if MemGameInfo.eName <> '' then
     MenuCustomPlayWithAssociatedApplication.Caption:= MenuCustomPlayWithAssociatedApplication.Caption+
                                              ' ['+ExtractFileExtW(MemGameInfo.eName)+']';

  MenuCustomPlayWithAssociatedApplication.Visible:= MemGameInfo.eIsCustomGame;
  if MenuCustomPlayWithAssociatedApplication.Visible then
  begin
    AssociatedApp:= GetAssociatedApp(ExtractFileExtW(MemGameInfo.eName), True);
    MenuCustomPlayWithAssociatedApplication.Enabled:= AssociatedApp <> '';
    if AssociatedApp = '' then
       begin
         PlayWithAssociatedEmulator[CustomSystemID]:= False;
         MenuCustomPlayWithAssociatedApplication.Hint:= 'Associate file type in Windows';
         MenuCustomPlayWithAssociatedApplication.ImageIndex:= -1;
       end
    else
       begin
         MenuCustomPlayWithAssociatedApplication.Hint:= AssociatedApp;
         GetAppIcon(AssociatedApp, IL_PopupPlayCustomEmulators, 3);
         MenuCustomPlayWithAssociatedApplication.ImageIndex:= 3;
       end;

    MenuCustomPlayWithAssociatedApplication.Checked:= Boolean(PlayWithAssociatedEmulator[CustomSystemID]);
  end;

  MenuCustomPlayEditFlipListFile.Visible:= MemGameInfo.eIsCustomGame;
  if MenuCustomPlayEditFlipListFile.Visible then
     MenuCustomPlayEditFlipListFile.Visible:= FindDiskCFG(MenuCustomPlayEditFlipListFile, AssociatedApp);

  ShowRulesButton;

  PopupMenuGamesList.EndUpdate;
end;

