procedure TFormMain.ApplyFilterCPU;
var
  Item, FirstItem: TEasyItem;
  Group: TEasyGroup;
  SearchStrCPU: String;

  function ValidateGameCPU: Boolean;
  begin
    Result:= False;
    if IsMAMEBasedSys(TEasyGameInfo(Item).eSystemID) then
       begin
         if SearchStrCPU <> '' then
            Result:= PosEx(SearchStrCPU, LowerCase(TEasyGameInfo(Item).eChipCPU)) <> 0
         else
            begin
              if FilterCPUList.ItemIndex > 0 then
                 Result:= CompareText(TEasyGameInfo(Item).eChipCPU, FilterCPUList.Text) = 0;
            end;
       end;
  end;

begin
  if not PanelFilterCPU.Visible then
     Exit;

  if not CheckTotal(GamesListView) then
     begin
       BlinkBkEdit(FilterCPU);
       FocusGamesList;
       Exit;
     end;


  if (FilterCPU.Text = '') and (FilterCPUList.ItemIndex = 0) then
     begin
       //SetGameType(False);
       BlinkBkEdit(FilterCPU);
       FocusGamesList;
       Exit;
     end
  else
     begin
       // MAME based systems only
       SearchStrCPU:= LowerCase(FilterCPU.Text);
       GamesListView.BeginUpdate;
       case IsGroupedView of
         True:
           begin
             // set all visible first
             ShowFilterMsgBox('Games Filters', 'Applying CPU filters, please wait...', IsGroupedView);
             GamesListView.Groups.MakeAllVisible;
             GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
             Application.ProcessMessages;
             Group:= GamesListView.Groups.LastGroup;
             repeat
               Item:= GamesListView.Groups.FirstInGroup(Group);
               FirstItem:= Item;
               repeat
                 Item.Visible:= ValidateGameCPU;
                 if Item <> FirstItem then
                    begin
                      if Item.Visible then
                         FirstItem.Visible:= True;
                    end;
                 Item:= GamesListView.Groups.NextInGroup(Group, Item);
               until Item = nil;
               //elvGroup.Visible:= elvGroup.VisibleCount > 0; // cannot hide groups here (do not delete this)
               Group:= GamesListView.Groups.PrevGroup(Group);
             until Group = nil;
             GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
             HideGroupsFilter(GamesListView); // hide groups with no visible items for last
             HideFilterMsgBox;
           end;
         False:
           begin
             GamesListView.Groups.MakeAllVisible; // set all visible first
             GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
             Item:= GamesListView.Groups.FirstItem;
             repeat
               Item.Visible:= ValidateGameCPU;
               Item:= GamesListView.Groups.NextItem(Item);
             until Item = nil;
           end;
       end;
       GamesListView.EndUpdate;

       ClearMemGameInfo(MemGameInfo);
       case CheckTotalVisible(GamesListView) of
         True : ReselectItem(True); // "SetSelectedGame" is called in this function
         False: ClearScreenshots;
       end;
       UpdateStatusBarGame;
       UpdateTotalEntriesLabel;
      end;
  FocusGamesList;
end;

procedure TFormMain.ApplyFilterSearchBar;
var
  StrSearch, iNumPlayers, ControlStr: String;
  KeepGame: Boolean;
  sbPos: Integer;
  elvGroup: TEasyGroup;
  FirstItem: TEasyItem;
  //cStart: Integer;

  function ValidateStatusID(DriverCategoryVar: ShortInt): Boolean;
  begin
    case ButtonGameFilterDriverStatus.Tag of
      1: Result:= DrivercategoryVar in [0, 1];// working (good + imperfect)
      2: Result:= DrivercategoryVar = 0;// working (good)
      3: Result:= DrivercategoryVar = 1;// working (imperfect)
      4: Result:= DrivercategoryVar = 2;// non-working (preliminary)
    end;
  end;

  procedure ValidateFilters;
  var
    sLoop: Integer;
  begin
    KeepGame:= True;
    if KeepGame then
       begin
         if ButtonFilterControls.Tag = 0 then
         begin
           // .Tag = 0 (search with options, default behavior)
           case FilterGameTitle.Tag of
             0: KeepGame:= Pos(StrSearch, LowerCase(MemGameInfo.eTitle)) <> 0;
             1: KeepGame:= PosEx(StrSearch, LowerCase(MemGameInfo.eYear)) <> 0;
             2: KeepGame:= Pos(StrSearch, LowerCase(MemGameInfo.eManufacturer)) <> 0;
             3: KeepGame:= Pos(StrSearch, LowerCase(MemGameInfo.eCategory)) <> 0;
             4: KeepGame:= PosEx(StrSearch, LowerCase(MemGameInfo.eVersionAdded)) <> 0;
             5: KeepGame:= Pos(StrSearch, LowerCase(MemGameInfo.eLanguage)) <> 0;
             6: KeepGame:= PosEx(StrSearch, LowerCase(MemGameInfo.eDriverName)) <> 0;
             7: KeepGame:= PosEx(StrSearch, LowerCase(MemGameInfo.eBiosName)) <> 0;
             8: KeepGame:= PosEx(StrSearch, LowerCase(MemGameInfo.eScreenResolution)) <> 0;
             9: KeepGame:= PosEx(StrSearch, LowerCase(MemGameInfo.eName)) <> 0;
            10: KeepGame:= PosEx(StrSearch, LowerCase(MemGameInfo.eClone)) <> 0;
            11:
              begin
                KeepGame:= Length(TEasyGameInfo(SelectedEasyItem).eSoftwareList) > 0;
                if KeepGame then
                begin
                  KeepGame:= False;
                  for sLoop:= Low(TEasyGameInfo(SelectedEasyItem).eSoftwareList) to High(TEasyGameInfo(SelectedEasyItem).eSoftwareList) do
                  begin
                    if PosEx(StrSearch, LowerCase(TEasyGameInfo(SelectedEasyItem).eSoftwareList[sLoop])) <> 0 then
                       begin
                         KeepGame:= True;
                         Break;
                       end;
                  end;
                end;
              end;
            12:
              begin
                iNumPlayers:= MemGameInfo.eNumberPlayersIni;
                if iNumPlayers = '' then
                   iNumPlayers:= MemGameInfo.eNumberPlayers;
                KeepGame:= PosEx(StrSearch, LowerCase(iNumPlayers)) <> 0;
              end;
           end;
         end
         else
         begin
           // ButtonFilterControls.Tag = 1 ("Controls" filter search bar button)
           KeepGame:= CheckGameControlType(MemGameInfo.eSystemID, MemGameInfo.eControls, ControlStr, MemGameInfo.eSoftwareName, MemGameInfo.eButtonsCount);
           if KeepGame and MemGameInfo.eIsCustomGame then
              KeepGame:= False; // this will remove all EmuCon games from the lis; "Controls" filter is for arcade and MAME only
         end;
       end;
    if KeepGame and FilterMachineType.MAMEMachinesFilterPanel_Enabled then
       begin
         if CheckSelected(MachinesListSidePanel) then
         begin
           if MachinesListIndexOf(MemGameInfo.eSoftwareName, TMachineGameInfo(SelectedMachineItem).eSoftwareList) = -1 then
              KeepGame:= False;
         end;
       end;

    if not KeepGame then
       Exit;

    if ButtonFilterControls.Tag = 0 then
       begin
         if not FilterTextBarIncludeToolBarFilters.Checked then
            Exit;
       end
    else
       begin
         if PopupSearchBarControlsFilter.Items.Count = 0 then // to avoid crashes
            Exit;
         if not PopupSearchBarControlsFilter.Items[0].Checked then
            Exit;
       end;


    case MemGameInfo.eIsCustomGame of
      True : KeepGame:= CheckConsCompSystemFilter; // main console/computer filter (EmuCon systems)
      False: KeepGame:= CheckArcadeMainFilter; // main arcade filter
    end;

    if not KeepGame then Exit;

    if not MemGameInfo.eIsCustomGame then
    begin
      if ButtonGameFilterHaveMiss.Tag = 3 then
         KeepGame:= MemGameInfo.eGameSetStatus = 1;

      if not KeepGame then Exit;
      if ButtonGameFilterDriverStatus.Tag > 0 then
         begin
           if FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex > 0 then
              KeepGame:= IsMAMEBasedSys(MemGameInfo.eSystemID); // other systems only support "Driver Status"

           if KeepGame then
              begin
                case FormArcadeFiltersDriverStatus.DriverStatusCategory.ItemIndex of
                  0: KeepGame:= ValidateStatusID(MemGameInfo.eDriverStatus);
                  1: KeepGame:= ValidateStatusID(MemGameInfo.eEmulationStatus);
                  2: KeepGame:= ValidateStatusID(MemGameInfo.eColorStatus);
                  3: KeepGame:= ValidateStatusID(MemGameInfo.eSoundStatus);
                  4: KeepGame:= ValidateStatusID(MemGameInfo.eGraphicStatus);
                end;
              end;
         end;
      if not KeepGame then Exit;
      if (not FilterMachineType.MAMESoftwareListGames_Enabled) then
         KeepGame:= MemGameInfo.eSoftwareName = '';

      if not KeepGame then Exit;
    end;

    case MemGameInfo.eIsCustomGame of
      True:
        begin
          if SystemIsConsole(MemGameInfo.eCustomSystemID) then
             KeepGame:= FilterMachineType.ConsoleSystems_Enabled
          else
          if SystemIsComputer(MemGameInfo.eCustomSystemID) then
             KeepGame:= FilterMachineType.ComputerSystems_Enabled
          else
          if SystemIsHandheld(MemGameInfo.eCustomSystemID) then
             KeepGame:= FilterMachineType.HandheldSystems_Enabled;
        end;
      False:
        begin
          case MemGameInfo.eSystemType of
            0: KeepGame:= FilterMachineType.ArcadeSystems_Enabled; // arcade
            1:
              begin
                if Length(TEasyGameInfo(SelectedEasyItem).eSoftwareList) > 0 then
                   KeepGame:= FilterMachineType.MAMEMachinesWithSoftwareList_Enabled
                else
                   KeepGame:= FilterMachineType.MAMEMachinesWithoutSoftwareList_Enabled;
              end;
           end;
        end;
    end;
    
    if KeepGame then
       KeepGame:= ApplyMiscFilters(KeepGame);
  end;

begin
  if PanelSearchGames_ToolBar.Visible then
     begin
       if FilterGameTitle_ToolBar.Text = '' then
          begin
            BlinkBkEdit(FilterGameTitle_ToolBar);
            Exit;
          end
       else
          begin
            StrSearch:= LowerCase(FilterGameTitle_ToolBar.Text);
            ControlStr:= FilterGameTitle_ToolBar.Text;
          end;
     end
  else
  if PanelSearchGames.Visible then
     begin
       if FilterGameTitle.Text = '' then
          begin
            BlinkBkEdit(FilterGameTitle);
            Exit;
          end
       else
          begin
            StrSearch:= LowerCase(FilterGameTitle.Text);
            ControlStr:= FilterGameTitle.Text;
          end;
     end;

  //cStart:= GetTickCount;
  // ----- filters
  // System
  // Master / Clone
  // Have / Miss
  // Driver Status (Working / Non-Working filter)
  // Bios / No Bios
  // Game Title

  ShowFilterMsgBox('Search Games Filter', 'Applying filters, please wait...', IsGroupedView);

  sbPos:= GetHorizontalBarPos;

  LoadMultiSlotArray(idMAME);   // load NeoGeo MVS and ST-V multi-slow compatible games list (for arcade only)
  LoadMultiSlotArray(idHBMAME);
  GlobalThreadManager.FlushMessageCache(GamesListView, TID_START);

  GamesListView.Selection.ClearAll;
  SelectedEasyItem:= nil;

  GamesListView.BeginUpdate;

  if IsGroupedView then
  begin
    GamesListView.Groups.MakeAllVisible; // set all visible first
    GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
    elvGroup:= GamesListView.Groups.LastGroup;
    repeat
      SelectedEasyItem:= GamesListView.Groups.FirstInGroup(elvGroup);
      FirstItem:= SelectedEasyItem;
      repeat
        ClearMemGameInfo(MemGameInfo);
        FillMemGameInfo(MemGameInfo);
        ValidateFilters;
        SelectedEasyItem.Visible:= KeepGame;
        if SelectedEasyItem <> FirstItem then
           begin
             if SelectedEasyItem.Visible then
                FirstItem.Visible:= True;
           end;
        SelectedEasyItem:= GamesListView.Groups.NextInGroup(elvGroup, SelectedEasyItem);
      until SelectedEasyItem = nil;
      //elvGroup.Visible:= elvGroup.VisibleCount > 0; // cannot hide groups here (do not remove this)
      elvGroup:= GamesListView.Groups.PrevGroup(elvGroup);
    until elvGroup = nil;
    GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
    HideGroupsFilter(GamesListView); // hide groups with no visible items for last
  end
  else
  begin
    GamesListView.Groups.MakeAllVisible; // set all visible first
    GamesListView.Groups.Rebuild(True); // rebuild groups or list gets messed up
    SelectedEasyItem:= GamesListView.Groups.FirstItem;
    repeat
      ClearMemGameInfo(MemGameInfo);
      FillMemGameInfo(MemGameInfo);
      ValidateFilters;
      SelectedEasyItem.Visible:= KeepGame;
      SelectedEasyItem:= GamesListView.Groups.NextItem(SelectedEasyItem);
    until SelectedEasyItem = nil;
    GamesListView.Groups.Rebuild(True); // rebuild groups to list gets messed up
    HideGroupsFilter(GamesListView); // hide groups with no visible items for last
  end;

  GamesListView.EndUpdate(False);

  FreeAndNil(MultiCartListMAME[0]);
  FreeAndNil(MultiCartListMAME[1]);
  FreeAndNil(MultiCartListHBMAME[0]);
  FreeAndNil(MultiCartListHBMAME[1]);

  ClearMemGameInfo(MemGameInfo);

  //Screen.Cursor:= crDefault;
  HideFilterMsgBox;
  case CheckTotalVisible(GamesListView) of
    True:
      begin
        ReselectItem(True);
      end;
    False:
      begin
        ClearScreenshots;
      end;
  end;

  UpdateTotalEntriesLabel;
  RestoreHorizontalBarPos(sbPos);
  FocusGamesList;
  //ShowMessage('time: '+IntToStr(GetTickCount-cStart)); // for debugging only
end;

