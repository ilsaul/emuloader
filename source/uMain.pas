procedure TFormMain.SetImageLayout;
var
  ImgSize: array[0..1] of Integer;
  ImageEnabled: array[0..1] of Boolean;
  Continue: Boolean;

  function DestroyImageHintPanel(Index: ShortInt): Boolean;
  begin
    if Assigned(ImageHintPanel2[Index]) then
       begin
         FreeAndNil(ImageHintText2[Index]);
         FreeAndNil(ImageHintPanel2[Index]);
       end;
    Result:= not Assigned(ImageHintPanel2[Index]);
  end;

  function DestroySplitter(Index: ShortInt): Boolean;
  begin
    if Assigned(SplitterImg[Index]) then
       FreeAndNil(SplitterImg[Index]);
    Result:= not Assigned(SplitterImg[Index]);
  end;

  function DestroyImagePnl: Boolean;
  begin
    if Assigned(ImagePnl) then
       FreeAndNil(ImagePnl);
    Result:= not Assigned(ImagePnl);
  end;

  function DestroyImageScr(Index: ShortInt): Boolean;
  begin
    DestroyImageHintPanel(Index);
    
    if Assigned(ImageScr[Index]) then
       begin
         ImageScr[Index].Bitmap:= nil;
         FreeAndNil(ImageScr[Index]);
       end;
    Result:= not Assigned(ImageScr[Index]);
  end;

  function CreateImageHintPanel(Index: ShortInt): Boolean;
  begin
    if ImageHintPanel2[Index] = nil then
       begin
         ImageHintPanel2[Index]:= TPanelEx.Create(Self);
         ImageHintPanel2[Index].ParentBackground:= False;
         ImageHintPanel2[Index].Parent:= ImageScr[Index];
         ImageHintPanel2[Index].Style:= ImageHintPanel.Style;
         ImageHintPanel2[Index].Frames:= [frLeft, frTop, frRight, frBottom];
         ImageHintPanel2[Index].Color1:= ImageHintPanel.Color1;
         ImageHintPanel2[Index].ColorFrame:= ImageHintPanel.ColorFrame;
         ImageHintPanel2[Index].Opacity:= ImageHintPanel.Opacity;
         ImageHintPanel2[Index].Visible:= False;
         ImageHintPanel2[Index].Left:= 20;
         ImageHintPanel2[Index].Width:= ImageHintPanel.Width;
         ImageHintPanel2[Index].Height:= ImageHintPanel.Height;
         ImageHintPanel2[Index].Tag:= -1;

         ImageHintText2[Index]:= TShadowLabel.Create(Self);
         ImageHintText2[Index].Parent:= ImageHintPanel2[Index];
         ImageHintText2[Index].Transparent:= True;
         ImageHintText2[Index].ShowAccelChar:= False;
         ImageHintText2[Index].Font:= ImageHintText.Font;
         ImageHintText2[Index].ShadowColor:= ImageHintText.ShadowColor;
         ImageHintText2[Index].Left:= 8;
         ImageHintText2[Index].Top:= 8;
         ImageHintText2[Index].Visible:= True;
       end
    else
       begin
         if ImageHintPanel2[Index].Parent <> ImageScr[Index] then
            ImageHintPanel2[Index].Parent:= ImageScr[Index];
       end;
    Result:= Assigned(ImageHintPanel2[Index]);
    if Result then
       UpdateImageHintPanelText(Index);
  end;

  function CreateSplitter(Index: ShortInt; imgAlignment: TAlign; imgParentComponent, AlignComponent: TWinControl): Boolean;
  begin
    if SplitterImg[Index] = nil then
       begin
         SplitterImg[Index]:= TSplitterEx.Create(nil);//Self);
         SplitterImg[Index].Parent:= imgParentComponent;
         SplitterImg[Index].Style:= TTMSStyle(tsSolidColor);
         case FormPreferences.ImageEnableGripIcon.Checked of
           True : SplitterImg[Index].GripStyle:= sgDots;
           False: SplitterImg[Index].GripStyle:= sgNone;
         end;
         SplitterImg[Index].PopupMenu:= PopupSplitters;
         SplitterImg[Index].OnMoved:= ImageSplitterMovedUpd;
       end
    else
       begin
         if SplitterImg[Index].Parent <> imgParentComponent then
            SplitterImg[Index].Parent:= imgParentComponent;
       end;

    SplitterImg[Index].Width:= 7;
    SplitterImg[Index].Height:= 7;
    case imgAlignment of
      alLeft: SplitterImg[Index].Left:= AlignComponent.Width+7;
      alTop: SplitterImg[Index].Top:= AlignComponent.Height+7;
      alRight: SplitterImg[Index].Left:= AlignComponent.Left-7;
      alBottom: SplitterImg[Index].Top:= AlignComponent.Top-7;
    end;
    if SplitterImg[Index].Align <> imgAlignment then
       SplitterImg[Index].Align:= imgAlignment;

    Result:= Assigned(SplitterImg[Index]);
  end;

  function CreatePanel(imgAlignment: TAlign): Boolean;
  begin
    if ImagePnl = nil then
       begin
         ImagePnl:= TPanel.Create(Self);
         ImagePnl.Parent:= PanelImage;
         ImagePnl.BevelOuter:= bvNone;
         ImagePnl.Caption:= '';
         ImagePnl.Align:= imgAlignment;
       end
    else
       begin
         if ImagePnl.Align <> imgAlignment then
            ImagePnl.Align:= imgAlignment;
       end;
    Result:= Assigned(ImagePnl);
  end;

  function CreateImage(Index: ShortInt; imgAlignment: TAlign; imgParentComponent: TWinControl): Boolean;
  begin
    if ImageScr[Index] = nil then
       begin
         ImageScr[Index]:= TImage32.Create(Self);
         ImageScr[Index].Parent:= imgParentComponent;
         if ImageDetails[Index].ImageCategoryIndex > -1 then
            begin
              ImageScr[Index].Color:= PopupMenuImageCategories.Items[ImageDetails[Index].ImageCategoryIndex].Tag;
              //ImageScr[Index].Hint:= PopupMenuImageCategories.Items[ImageDetails[Index].ImageCategoryIndex].Caption;
            end;
         ImageScr[Index].ShowHint:= False;
         ImageScr[Index].BitmapAlign:= baCenter;
         ImageScr[Index].ScaleMode:= Images.ScaleMode;
         ImageScr[Index].Bitmap.DrawMode:= dmBlend;
         ImageScr[Index].Align:= imgAlignment;
         SetResampler(ImageScr[Index]);
         ImageScr[Index].PopupMenu:= PopupMenuImages;
       end
    else
       begin
         if ImageScr[Index].Parent <> imgParentComponent then
            ImageScr[Index].Parent:= imgParentComponent;
         if ImageScr[Index].Align <> imgAlignment then
            ImageScr[Index].Align:= imgAlignment;
       end;
    Result:= Assigned(ImageScr[Index]);
    if Result then
       begin
         if CreateImageHintPanel(Index) then
            begin
              ImageScr[Index].OnMouseEnter:= ImagePreviewMouseEnter;
              ImageScr[Index].OnMouseLeave:= ImagePreviewMouseLeave;
            end;
       end;
  end;

  function AlignMainImage(imgAlignment: TAlign; imgParentComponent: TWinControl): Boolean;
  begin
    if Images.Parent <> imgParentComponent then
       Images.Parent:= imgParentComponent;
    if Images.Align <> imgAlignment then
       Images.Align:= imgAlignment;
    Images.Color:= PopupMenuImageCategories.Items[ImageDetails[1].ImageCategoryIndex].Tag;
    //PanelImage.Color:= Images.Color;
    //PanelScreenshotsArea.Color1:= PanelImage.Color;
    //if ButtonScreenshotLayouts.Tag = 0 then
    //   Images.Hint:= ''
    //else
    //   Images.Hint:= PopupMenuImageCategories.Items[ImageDetails[1].ImageCategoryIndex].Caption;
    Result:= True;
  end;

  function DestroyAll: Boolean;
  begin
    Result:= True;
    DestroySplitter(1);
    DestroySplitter(2);

    DestroyImageHintPanel(2);
    DestroyImageHintPanel(3);

    DestroyImageScr(2);
    DestroyImageScr(3);
    DestroyImagePnl;
  end;

begin
  //if IsStartup then
  //   Exit;
  Continue:= True;
  if not IsStartup then
     begin
       FreeImageZipVars;
       InitImgZipLists(True); // clear zip images arrays
       InitImgSoftwareNameZipLists(True);
     end;

  //ImagesToolbarButtons.DoubleBuffered:= True;

  if not IsImageLayoutView then
     begin
       PanelScreenshotsArea.Canvas.Lock;
       AlignMainImage(alClient, PanelImage);
       DestroyAll;
       ImageDetails[1].ImageCategoryIndex:= ButtonImageCategory.Tag;
       Images.Hint:= '';
       UpdateImageHintPanelText(1);
       PanelScreenshotsArea.Canvas.Unlock;
       if MenuShowImages.Checked then
          MenuShowImages.OnClick(Self);
       Exit;
     end;

  PanelScreenshotsArea.Canvas.Lock;
  if FormStatus.Visible then
     FormStatus.MessageStr('Initializing layout image panels.');

  ReadScreenshotLayout(ButtonScreenshotLayouts.Tag, ImgSize, ImageEnabled);
  case ButtonScreenshotLayouts.Tag of
    1, 2:
      begin
        Continue:= ImageEnabled[0];
        if not Continue then
           AlignMainImage(alClient, PanelImage);
      end;
    3..8:
      begin
        Continue:= ImageEnabled[0] or ImageEnabled[1];
        if not Continue then
           AlignMainImage(alClient, PanelImage);
      end;
  end;

  case Continue of
    True:
      begin
        case ButtonScreenshotLayouts.Tag of
          0: // single
            begin
              AlignMainImage(alClient, PanelImage);
              DestroyAll;
            end;
          1: // dual, layout 1
            begin
              AlignMainImage(alNone, PanelImage);
              DestroyAll;
              case ImageEnabled[0] of
                True:
                  begin
                    AlignMainImage(alTop, PanelImage);
                    Images.Height:= ImgSize[0];
                    CreateSplitter(1, alTop, PanelImage, Images);
                    CreateImage(2, alClient, PanelImage);
                    //CreateImageHintPanel(2);
                  end;
                False:
                  begin
                    AlignMainImage(alClient, PanelImage);
                  end;
              end;
            end;
          2: // dual, layout 2
            begin
              AlignMainImage(alNone, PanelImage);
              DestroyAll;
              case ImageEnabled[0] of
                True:
                  begin
                    AlignMainImage(alLeft, PanelImage);
                    Images.Width:= ImgSize[0];
                    CreateSplitter(1, alLeft, PanelImage, Images);
                    CreateImage(2, alClient, PanelImage);
                    //CreateImageHintPanel(2);
                  end;
                False:
                  begin
                    AlignMainImage(alClient, PanelImage);
                  end;
              end;
            end;
          3:
            begin
              // triple, layout 1
              AlignMainImage(alTop, PanelImage); // image_1 is always top aligned!!!
              DestroyAll;
              Images.Height:= ImgSize[0];
              CreateSplitter(1, alTop, PanelImage, Images);
              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   CreateImage(3, alBottom, PanelImage);
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(2, alBottom, PanelImage, ImageScr[3]);
                   CreateImage(2, alClient, PanelImage);

                   //CreateImageHintPanel(2);
                   //CreateImageHintPanel(3);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   CreateImage(2, alClient, PanelImage);
                   //CreateImageHintPanel(2);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alClient, PanelImage);
                   //CreateImageHintPanel(3);
                 end;
            end;
          4:
            begin
              // triple, layout 2
              AlignMainImage(alLeft, PanelImage); // image_1 is always left aligned!!!
              DestroyAll;
              Images.Width:= ImgSize[0];
              CreateSplitter(1, alLeft, PanelImage, Images);
              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   CreateImage(3, alRight, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alRight, PanelImage, ImageScr[3]);
                   CreateImage(2, alClient, PanelImage);

                   //CreateImageHintPanel(2);
                   //CreateImageHintPanel(3);
                 end
              else
              if ImageEnabled[0] then
                 CreateImage(2, alClient, PanelImage)
              else
              if ImageEnabled[1] then
                 CreateImage(3, alClient, PanelImage);
            end;
          5:
            begin
              // triple, layout 3
              AlignMainImage(alNone, PanelImage);
              DestroyAll;

              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(3, alTop, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(2, alTop, PanelImage, ImageScr[3]); // only difference!!!!!!
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alTop, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(1, alTop, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
          6:
            begin
              // triple, layout 4
              AlignMainImage(alNone, PanelImage);
              DestroyAll;
              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(3, alBottom, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(2, alBottom, PanelImage, ImageScr[3]); // only difference!!!!!!
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alLeft, PanelImage);
                   Images.Width:= ImgSize[0];
                   CreateSplitter(1, alLeft, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alBottom, PanelImage); // only difference!!!!!!
                   ImageScr[3].Height:= ImgSize[1];
                   CreateSplitter(1, alBottom, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
          7:
            begin
              // triple, layout 5
              AlignMainImage(alNone, PanelImage);
              DestroyAll;

              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   CreateImage(3, alLeft, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alLeft, PanelImage, ImageScr[3]);
                   CreatePanel(alClient);
                   AlignMainImage(alTop, ImagePnl);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, ImagePnl, Images);
                   CreateImage(2, alClient, ImagePnl);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alTop, PanelImage);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alLeft, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alLeft, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
          8:
            begin
              // triple, layout 6
              AlignMainImage(alNone, PanelImage);
              DestroyAll;

              if ImageEnabled[0] and ImageEnabled[1] then
                 begin
                   // need to change this... ??? not sure if still needed (Feb 03, 2014)
                   // 1. make ImageScr[3].Align = alRight and set its width
                   // 2. make Splitter(2) Aligh = alRight for ImageScr[3]
                   // 3. make ImagePnl.Align = alClient
                   CreateImage(3, alRight, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alRight, PanelImage, ImageScr[3]);
                   CreatePanel(alClient); // "ImagePnl"
                   AlignMainImage(alTop, ImagePnl);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, ImagePnl, Images);
                   CreateImage(2, alClient, ImagePnl);
                 end
              else
              if ImageEnabled[0] then
                 begin
                   AlignMainImage(alTop, PanelImage);
                   Images.Height:= ImgSize[0];
                   CreateSplitter(1, alTop, PanelImage, Images);
                   CreateImage(2, alClient, PanelImage);
                 end
              else
              if ImageEnabled[1] then
                 begin
                   CreateImage(3, alRight, PanelImage);
                   ImageScr[3].Width:= ImgSize[1];
                   CreateSplitter(2, alRight, PanelImage, ImageScr[3]);
                   AlignMainImage(alClient, PanelImage);
                 end;
            end;
        end;
      end;
    False:
      begin
        DestroyAll;
      end;
  end;
  ButtonScreenshotLayouts.Hint:= 'Layout -> '+PopupScreenshotLayouts.Items[ButtonScreenshotLayouts.Tag].Caption+' <-';
  UpdateImageLayoutSplittersStyle;
  PanelScreenshotsArea.Canvas.Unlock;
  if MenuShowImages.Checked then
     begin
       if not IsStartUp then
          begin
            InitZippedImagesCache;
            //InitImgZipLists;
            //InitImgSoftwareNameZipLists;
          end;
       ToggleImagesPanel;
     end;
end;

