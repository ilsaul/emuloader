              CallMessageBox;
              EnableMsgMediaTypeLabel(False);
              AddEmulatorHeader;
              AddMsgText('    Game file ');
              AddMsgText(MemGameInfo.eName, $00a65300, [fsBold]);
              AddMsgText(' was not found!');
              if not GameFoldersFound(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType) then
                 AddMsgText(' Games folders are empty or not selected.');
              AddMsgText(' Aborting...');
              GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 2, False, -1);

              ResetSettings;
              Exit;
            end;
        end;
      end;
    False:
      begin
        if not VerifyArcadeGamesSys(MemGameInfo.eSystemID, MemGameInfo.eSoftwareName) then
           begin
             ResetSettings;
             Exit;
           end;
      end;
  end;

  //if IsROMsListBasedSys(MemGameInfo.eSystemID) then
  //   begin
  //     if not Check_ROMsData_File(MemGameInfo.eSystemID) then
  //        begin
  //          ResetSettings;
  //          Exit;
  //        end;
  //   end;

  GetScreenResolutions;

  if IsAlterMAME then
     IsBatchFile:= IsExeBatchFile(AlterMAMEFile)
  else
     begin
       IsBatchFile:= IsExeBatchFile(EmulatorFile[MemGameInfo.eSystemID]);
       if TryAgainAlterMAME then
          IsBatchFileAlterMAME:= IsExeBatchFile(AlterMAMEFile);
     end;

  case IsAlterMAME of
    True : CommandLine:= SystemStr+AlterMAMEFile+SystemStr+' ';
    False:
      begin
        //if not MemGameInfo.eSystemID = idZiNc then
           CommandLine:= SystemStr+EmulatorFile[MemGameInfo.eSystemID]+SystemStr+' ';
        //else
        //   CommandLine:= SystemStr+GetShortFileNameW(EmulatorFile[MemGameInfo.eSystemID])+SystemStr+' '
      end;
  end;

  if MemGameInfo.eIsCustomGame then
  begin
    if MachineNameStr = '' then
       MachineNameStr:= GetLastUsedMachineCustomGame(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType);

    if MachineNameStr = '' then
       begin
         CheckMachineToRun_CustomGame(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, MachineNameStr, False);
         if MachineNameStr = '' then
            begin
              // user hit Abort button in select machine dialog... do not display "machine blank" error message
              ResetSettings;
              Exit;
            end;
       end;

    if MachineNameStr = '' then
       begin
         GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                         '    Cannot execute because the MAME machine name is blank. '+
                         'Make sure to select a machine to play this game. Aborting...', 2, False, 1);
         ResetSettings;
         Exit;
       end;
    MachineToUse_Title:= GetTitleMachineToUse(MemGameInfo.eSystemID, MachineNameStr, MemGameInfo.eName, MemGameInfo.eSoftwareName, MAMEMachineItem);
    //if MachineNameStr <> '' then
       CommandLine:= CommandLine+MachineNameStr+' -'+MediaTypeCustom[MemGameInfo.eCustomMediaType, 2]+'1 '+TempGameVars.eName;
    //if MemGameInfo.eSoftwareExecParameter <> '' then
    //   CommandLine:= CommandLine+'-'+MemGameInfo.eSoftwareExecParameter+' '+TempGameVars.eName // MemGameInfo.eName
    //else
    //   CommandLine:= CommandLine+TempGameVars.eName; //MemGameInfo.eName;
  end
  else
  begin
    if IsMAMEBasedSys(MemGameInfo.eSystemID) and (MemGameInfo.eSoftwareName <> '') then
    begin
      if PanelMachinesList.Visible then
         begin
           if CheckSelected(MachinesListSidePanel) then
              MachineNameStr:= SelectedMachineListName;
         end;
      if MachineNameStr = '' then
         MachineNameStr:= GetLastUsedMachineSoftwareList(MemGameInfo.eSoftwareName);

      if MachineNameStr = '' then
         begin
           SelectMachineToRun(MachineNameStr, False);
           if MachineNameStr = '' then
              begin
                // user hit Abort button in select machine dialog... do not display "machine blank" error message
                ResetSettings;
                Exit;
              end;
         end;

      //if MachineNameStr = '' then
      //   MachineNameStr:= GetDefaultMachineNameToUse(MemGameInfo.eSystemID, MemGameInfo.eSoftwareName);

      if MachineNameStr = '' then
         begin
           if PanelMachinesList.Visible then
              GenerateMessage(ErrorMsgTitle, EmulatorTitle,
