      DeleteFile(GetIniFilesFolder+'folders_emulators.ini');
      INIFile:= TMemIniFile.Create(GetIniFilesFolder+'folders_emulators.ini');

      for Loop:=1 to MaxArcadeSystems do
          SaveSnapFolderZipFile(Loop);

      // Systems sections options
      for Loop:=1 to MaxArcadeSystems do
      begin
        if IsROMsFolderCustom(Loop) then
           WriteEmulatorROMsFolders(Loop);
        WriteEmulatorVariables(Loop);
      end;

      if AlterMAMEFile = '' then
         begin
           INIFile.DeleteKey(GetSystemIniSection(idMAME), 'emu_AlterMAMEFile');
           INIFile.DeleteKey(GetSystemIniSection(idMAME), 'emu_AlterMAMEBuild');
           INIFile.DeleteKey(GetSystemIniSection(idMAME), 'emu_AlterMAMEDateTime');
         end
      else
         begin
           INIFile.WriteString(GetSystemIniSection(idMAME), 'emu_AlterMAMEFile', AlterMAMEFile);
           INIFile.WriteString(GetSystemIniSection(idMAME), 'emu_AlterMAMEBuild', buildAlterMAME);
           INIFile.WriteInteger(GetSystemIniSection(idMAME), 'emu_AlterMAMEDateTime', AlterMAMEDateTime);
         end;
      if AlterMAMEVersion = '' then
         INIFile.DeleteKey(GetSystemIniSection(idMAME), 'emu_AlterMAMEVersion')
      else
         INIFile.WriteString(GetSystemIniSection(idMAME), 'emu_AlterMAMEVersion', AlterMAMEVersion);
      if AlterMAMEFile = '' then
         INIFile.DeleteKey(GetSystemIniSection(idMAME), 'emu_AlterMAMEAutorun')
      else
         INIFile.WriteInteger(GetSystemIniSection(idMAME), 'emu_AlterMAMEAutorun', Ord(PopupAutorunGameAlterMAME.Checked));

      INIFile.UpdateFile;
    finally
      FreeAndNil(INIFile);
    end;
  end;
end;

function TFormMain.CheckAllMAMEIniFiles: Boolean;
var
  Loop: ShortInt;
  ShowMsg: Boolean;
begin
  // this function seems to be called only at startup... nowhere else!
  Result:= True;
  ShowMsg:= False;
  for Loop:=1 to MaxArcadeSystems do
  begin
    if IsMAMEBasedSys(Loop) then
    begin
      if ValidateEmulatorFile(Loop) then
      begin
        if not CheckMAMEIniFile(EmulatorFile[Loop], Loop) then
           begin
             if not ShowMsg then
             begin
               CallMessageBox;
               ShowMsg:= True;
             end
             else
               AddMsgText(#13#10+#13#10);

             AddMsgText('    '+GetEmulatorDescription(Loop, True)+#13#10, clBlack, [fsBold]);
             AddMsgText('File: ');
             AddMsgText(EmulatorFile[Loop]+#13#10, clMaroon);
             AddMsgText('Initialization file is missing and failed to be created.', clBlack, [fsItalic]);

             Result:= False;
           end;
      end;
    end;
  end;

  if ShowMsg then
     GenerateMessage('Error: Startup', 'File access error.', '', 2, False, 1);
end;

function TFormMain.CheckMAMEIniFile(const EmulatorFileName: String; SystemID: Integer): Boolean;
begin
  Result:= ValidateEmulatorFile(SystemID);
  if Result then
     begin
       if not FileExists(GetEmuIniFileName(SystemID, EmulatorFileName)) then
          CreateMAMEIniFile(EmulatorFileName);
     end;
end;

function TFormMain.GetEmuIniFileName(sysID: ShortInt; const EmulatorFileName: String = ''): String;
var
  tmpSys, EmuPath, EmuIniPath: String;
  Continue: Boolean;
begin
  Result:= '';
  case isMAMEBasedSys(sysID) of
    True:
      begin
        if EmulatorFileName <> '' then
           begin
             EmuIniPath:= 'ini\';
             EmuPath:= ExtractFilePath(EmulatorFileName);
             if sysID <> idHBMAME then
                tmpSys:= 'mame.ini'
             else
                tmpSys:= 'hbmame.ini';
             Continue:= not FileExists(EmuPath+tmpSys);
             if Continue then
                begin
                  tmpSys:= EmuIniPath+tmpSys;
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= 'ume.ini';
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= EmuIniPath+tmpSys;
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= ChangeFileExt(ExtractFileName(EmulatorFileName), '.ini');
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= EmuIniPath+tmpSys;
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                tmpSys:= 'mame.ini';
             Result:= EmuPath+tmpSys;
           end;
        {
        if EmulatorFileName <> '' then
           begin
             EmuIniPath:= 'ini\';
             EmuPath:= ExtractFilePath(EmulatorFileName);
             if sysID <> idHBMAME then
                tmpSys:= 'mame.ini'
             else
                tmpSys:= 'hbmame.ini';
             Continue:= not FileExists(EmuPath+tmpSys);
             if Continue then
                begin
                  tmpSys:= 'ume.ini';
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                begin
                  tmpSys:= ChangeFileExt(ExtractFileName(EmulatorFileName), '.ini');
                  Continue:= not FileExists(EmuPath+tmpSys);
                end;
             if Continue then
                tmpSys:= 'mame.ini';
             Result:= EmuPath+tmpSys;
           end;
        }
      end;
    False:
      begin
        case sysID of
          idSupermodel: // Supermodel: SEGA Model 3
            begin
              if EmulatorFile[sysID] <> '' then
                 Result:= ExtractFileName(ChangeFileExt(EmulatorFile[sysID], '.ini'));
              // NOTE: the .ini files will be in "el\arcade\supermodel_cfg\" sub-folder!!!!!!
            end;
          idDaphne: Result:= GetFolderEmulatorIni(idDaphne, True)+'daphne_el.ini';
          idDemul: // Demul
            begin
              if EmulatorFile[sysID] <> '' then
                 Result:= ChangeFileExt(EmulatorFile[sysID], '.ini');
            end;
          idSegaModel2: // SEGA Model 2 (Elsemi emulator)
            begin
              if EmulatorFile[sysID] <> '' then
                 Result:= ExtractFilePath(EmulatorFile[sysID])+'emulator.ini'; //SEGA Model 2 (Elsemi emulators)
            end;
          idZiNc: Result:= 'zinc_el.cfg';
        end;
      end;
  end;
end;

function TFormMain.GetMAMEBinaryVersion(const EmulatorFileName: String; IsFile: Boolean = True; viFile: String = ''): String;
var
  fVersion, iHelp, tempFile, CommandLine: String;
  iFile: TStringList;
  iPos, iPos2: Integer;
  //fVersion: WideString;
begin
  Result:= '';
  if not FileExists(EmulatorFileName) then
     Exit;
  fVersion:= GetVersion(EmulatorFileName, True);//True);
  //fVersion:= GetFileInfo2(EmulatorFileName, VersionInfo[3]); // File Version (00.000 format only)

  //ShowMessage(fVersion);
  if fVersion <> '' then
     begin
       Result:= fVersion;
       Exit;
       //fVersion:= StringReplace(fVersion, ',', '.', [rfReplaceAll]);
       //iPos:= Pos('.', fVersion);
       //Result:= Trim(Copy(fVersion, 1, iPos+4));
       iPos:= PosEx('.', fVersion, 3);
       Result:= Copy(fVersion, 1, iPos-1);
       //Delete(fVersion, iPos, Length(fVersion));
       //Result:= fVersion;

       Exit;
     end;
  if not VerifyTempDirectory then
     Exit;

  if viFile = '' then
     begin
       if FormStatus.Visible then
          FormStatus.MessageStr('Parsing MAME build number.');
       tempFile:= FrontendPath+'temp\iMAMEVersion.tmp';
       CommandLine:= SystemStr+EmulatorFileName+SystemStr+' -help > '+SystemStr+tempFile+SystemStr;
       SetCurrentDir(EmulatorFileName);
       RunProcess(CommandPromptStr+SystemStr+CommandLine+SystemStr, True, GetWindowStateEmulator, False);//SW_SHOWMINIMIZED, False); // WinXP / Sev7n / 8ight
       SetCurrentDir(FrontendPath);
     end
  else
     tempFile:= viFile; // file already created in .GetEmulatorVersion() function or is from -listxml output: <mame build="0000"

  //CommandLine:= SystemStr+EmulatorFileName+SystemStr+' -help > '+SystemStr+tempFile+SystemStr;
  //SetCurrentDir(EmulatorFileName);
  //RunProcess(CommandPromptStr+SystemStr+CommandLine+SystemStr, True, SW_SHOWMINIMIZED, False); // WinXP / Sev7n / 8ight
  //SetCurrentDir(FrontendPath);
  if IsFile then
     begin
       if not ValidateFile(tempFile) then
          Exit;
       iFile:= TStringList.Create;
       iFile.LoadFromFile(tempFile);
       iHelp:= iFile[0];
     end
  else
     begin
       iHelp:= viFile; // from -listxml output... <mame build="000000"
     end;
  iPos:= PosEx(' v', iHelp);
  iPos2:= PosEx('.', iHelp, iPos+1);
  Result:= Trim(Copy(iHelp, iPos+2, (iPos2-iPos)+2));

  if IsFile then
     begin
       FreeAndNil(iFile);
       DeleteFile(tempFile);
     end;
  Application.ProcessMessages;
end;

function TFormMain.IsROMsFolderCustom(sysID: Integer): Boolean;
begin
  // ROMs folder is saved in "ini_files\folders_emulators.ini"
  Result:= sysID in [idSupermodel, idZiNc]; // Supermodel: SEGA Model 3; ZiNc
