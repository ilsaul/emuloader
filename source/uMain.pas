// ExecuteGame() function with .bat; .cmd batch files detection and NO custom .bat file support!
// RunWithAlterMAME_Index
// -1 -> no AlterMAME, run normal arcade/MAME
//  1 -> run with AlterMAME 1 (games popup menu select)
//  2 -> run with AlterMAME 2 (games popup menu select)
function TFormMain.ExecuteGame(RunWithAlterMAME_Index: ShortInt = -1; MAME_ExtraPamars: Boolean = False): Integer;
var
  msgboxTitle, EmulatorTitle, MachineNameStr, SoftwareNameFolder, MAME_ExtraParamsCommandLine: String;
  ErrorMsgTitle, MultiSlotMachineName, TempStr: String;
  ScreenResolutions: THashedStringList;
  SupermodelSettings: TStringList; // it contains Supermodel settings for "emu default settings" and then "game custom settings" (like MAME does it)
  IsBatchFile, IsDemulEmptySystem, IsMultiSlot: Boolean;
  RunWithAlterMAME, TryAgainAlterMAME, IsBatchFileAlterMAME: array[Low(AlterMAMEFile)..High(AlterMAMEFile)] of Boolean;
  ExitCode: DWORD;
  ExitCodeAlterMAME: array[Low(AlterMAMEFile)..High(AlterMAMEFile)] of DWORD;
  iPlayTime: Cardinal;
  msItem, MAMEMachineItem: TEasyItem;
  MsgType: ShortInt;
  ItemToUpdate: TEasyItem;
  CommandLine, MachineToUse_Title, NewOption, NewOption2: WideString;

  function ResetSettings: Boolean;
  begin
    Result:= True;
    if MemGameInfo.eIsCustomGame then
       MemGameInfo.eSystemID:= -1;
    FreeAndNil(ScreenResolutions);
    ThousandSeparator:= Char(',');
    DecimalSeparator:= Char('.');
    SetCurrentDir(FrontendPath);
    TempGameVars.eName:= '';
    FocusGamesList;
  end;

  function GetScreenResolutions: Boolean;
  begin
    Result:= True;
    ScreenResolutions:= THashedStringList.Create;
    ListScreenModes(ScreenResolutions, True);
  end;

  function ValidateResolution(const ResStr: String): Boolean;
  begin
    Result:= (ScreenResolutions.IndexOf(ResStr) > -1);
    if not Result then
       GenerateMessage(ErrorMsgTitle, EmulatorTitle+#13#10+'Invalid resolution.',
                       '  The Resolution '+ResStr+' is not valid for your video card and/or monitor.'+#13#10+
                       'If you try to run the emulator in full screen mode with this resolution, it might damage your monitor '+
                       'and/or your video card. Please change the resolution or run the game in window mode.'+#13#10+
                       'Aborting...', 2, False, 1);
  end;

  function ValidateAlterMAME(iIndex: Integer): Boolean;
  var
    iAltVersion: Integer;
  begin
    if AlterMAME_IsMAME[iIndex] then
       iAltVersion:= GetMAMEBuild(idMAME, iIndex)
    else
       iAltVersion:= 0; // set to zero to avoid errors with MAME version if using Raine or FBA emulators
    Result:= (MemGameInfo.eSystemID = idMAME) and (AlterMAMEFile[iIndex] <> '') and FileExists(AlterMAMEFile[iIndex]);
    RunWithAlterMAME[iIndex]:= Result and (RunWithAlterMAME_Index = iIndex);
    case iIndex of
      1: TryAgainAlterMAME[iIndex]:= Result and PopupAutoRunGameAlterMAME.Checked and (not RunWithAlterMAME[iIndex]);// and ((iAltVersion >= 162) or (iAltVersion = -1)); // always false if IsAlterMAME = true
      2: TryAgainAlterMAME[iIndex]:= Result and PopupAutoRunGameAlterMAME2.Checked and (not RunWithAlterMAME[iIndex]);// and ((iAltVersion >= 162) or (iAltVersion = -1)); // always false if IsAlterMAME = true
    end;
    
    if TryAgainAlterMAME[iIndex] then
       begin
         case MemGameInfo.eIsCustomGame of
           True:
             begin
               if AlterMAME_IsMAME[iIndex] then
                  TryAgainAlterMAME[iIndex]:= ((iAltVersion >= 162) or (iAltVersion = -1))
               else
                  TryAgainAlterMAME[iIndex]:= False; // EmuCon games are not supported by Raine or FBA emulators
             end;
           False:
             begin
               if MemGameInfo.eSoftwareName <> '' then
                  begin
                    if AlterMAME_IsMAME[iIndex] then
                       TryAgainAlterMAME[iIndex]:= ((iAltVersion >= 162) or (iAltVersion = -1))
                    else
                       TryAgainAlterMAME[iIndex]:= False; // MAME software list games are not supported by Raine or FBA emulators
                  end;
             end;
         end;
       end;
  end;

  function SetCmdLineTitle(IsCustom: Boolean = False): Boolean;
  var
    RunStr: String;
  begin
    Result:= True;
    if MemGameInfo.eIsCustomGame then
       RunStr:= 'Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game'
    else
    begin
      if (MemGameInfo.eSystemType = 0) or (MemGameInfo.eSoftwareName <> '') then
         RunStr:= 'Run Game'
      else
         RunStr:= 'Run Machine';
    end;
    case IsCustom of
      True : msgboxTitle:= RunStr+', Custom Settings - '+EmulatorTitle;
      False: msgboxTitle:= RunStr+' - '+EmulatorTitle;
    end;
  end;

  function MountSupermodelCommandLine: String;
  var
    StrValue, StrValue2: String;
    IntValue: Integer;
    RunFullScreen, UseFrequency, UseFrequencyCustom: Boolean;
  begin
    Result:= '';
    UseFrequency:= False;
    UseFrequencyCustom:= False;
    RunFullScreen:= False;
    if SupermodelSettings.Count = 0 then
       Exit;

    StrValue:= SupermodelSettings.Values['FullScreen'];
    if Strvalue <> '' then
       RunFullScreen:= StrValue = '1';

    StrValue:= SupermodelSettings.Values['Resolution'];
    if StrValue = '' then
       StrValue:= 'auto';
    case RunFullScreen of
      True:
        begin
          if SameText('auto', StrValue) then
             StrValue:= IntToStr(Screen.Width)+'x'+IntToStr(Screen.Height);

          if not ValidateResolution(StrValue) then
             StrValue:= IntToStr(Screen.Width)+'x'+IntToStr(Screen.Height);

          //if not ValidateResolution(StrValue) then
          //   begin
          //     // this should never happen!!!!
          //     Result:= 'invalid_resolution';
          //     FreeAndNil(SupermodelSettings);
          //     Exit;
          //   end;
          Result:= Result+' -res='+StringReplace(StrValue, 'x', ',', [rfIgnoreCase])+' -fullscreen';
        end;
      False:
        begin
          if not SameText('auto', StrValue) then
             Result:= Result+'-res='+StringReplace(StrValue, 'x', ',', [rfIgnoreCase])+' ';
        end;
    end;

    StrValue:= SupermodelSettings.Values['MultiThreaded'];
    if StrValue <> '' then
       if StrValue = '0' then
          Result:= Result+' -no-threads';

    StrValue:= SupermodelSettings.Values['GPUMultiThreaded'];
    if StrValue <> '' then
       if StrValue = '0' then
          Result:= Result+' -no-gpu-thread';

    StrValue:= SupermodelSettings.Values['PowerPCFrequencyEnableCustom'];
    if StrValue <> '' then
       begin
         if StrValue = '1' then
         begin
           // use custom PowerPC frequency
           StrValue2:= SupermodelSettings.Values['PowerPCFrequencyCustom'];
           if StrValue2 <> '' then
           begin
             IntValue:= StrToInt(StrValue2);
             if (IntValue >= 1) and (IntValue <= 1000) then
                UseFrequencyCustom:= True;
           end;
         end;
       end;

    if not UseFrequencyCustom then
    begin
      // no custom frequency, check if frequency parameter needs to be added to the command line
      StrValue:= SupermodelSettings.Values['PowerPCFrequency'];
      if StrValue <> '' then
         begin
           IntValue:= StrToInt(StrValue);
           if not (IntValue in [0..8]) then
              IntValue:= 5; // 50 MHz (emulator default frequency!)
           if IntValue <> 5 then
              UseFrequency:= True;
         end;
    end;

    if UseFrequencyCustom then
       Result:= Result+' -ppc-frequency='+StrValue2//+' '
    else
    if UseFrequency then
       Result:= Result+' -ppc-frequency='+IntToStr(Model3PowerPCFrequency[IntValue]);//+' ';

    StrValue:= SupermodelSettings.Values['New3DEngine']; //, 1);
    if StrValue <> '' then //case IntValue of // as listed in 3D Engine combobox in Supermodel settings screen
    begin
      if StrValue = '0' then
         Result:= Result+' -legacy3d'
      else
      if StrValue = '1' then
         Result:= Result+' -new3d';
    end;

    StrValue:= SupermodelSettings.Values['QuadRendering']; // 1
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -quad-rendering';

    StrValue:= SupermodelSettings.Values['WideScreen']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -wide-screen';

    StrValue:= SupermodelSettings.Values['Stretch']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -stretch';

    StrValue:= SupermodelSettings.Values['MultiTexture']; // 1
    if StrValue <> '' then
       if StrValue = '0' then
          Result:= Result+' -no-multi-texture';

    StrValue:= SupermodelSettings.Values['DisableThrottle']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -no-throttle';

    StrValue:= SupermodelSettings.Values['DisableVSync']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -no-vsync';

    StrValue:= SupermodelSettings.Values['ShowFrameRate']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -show-fps';

    StrValue:= SupermodelSettings.Values['DisableSound']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -no-sound';

    StrValue:= SupermodelSettings.Values['DisableMusic']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -no-dsb';

    StrValue:= SupermodelSettings.Values['FlipStereo']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+' -flip-stereo';

    StrValue:= SupermodelSettings.Values['SoundVolume']; // 100
    if StrValue <> '' then
       if StrToInt(StrValue) <> 100 then
          Result:= Result+ ' -sound-volume='+StrValue;//+' ';

    StrValue:= SupermodelSettings.Values['MusicVolume']; // 100
    if StrValue <> '' then
       if StrToInt(StrValue) <> 100 then
          Result:= Result+' -music-volume='+StrValue;//+' ';

    StrValue:= SupermodelSettings.Values['Balance']; // 0
    if StrValue <> '' then
       if StrToInt(StrValue) <> 0 then
          Result:= Result+' -balance='+StrValue;//+' ';

    StrValue:= SupermodelSettings.Values['InputSystem']; // 'dinput'
    if StrValue <> '' then
       if not SameText(StrValue, 'dinput') then
          Result:= Result+ ' -input-system='+StrValue;//+' ';

    StrValue:= SupermodelSettings.Values['Crosshairs']; // 0 = none (default)
    if StrValue <> '' then
       if StrValue <> '0' then
          Result:= Result+' -crosshairs='+StrValue;//+' ';

    StrValue:= SupermodelSettings.Values['ForceFeedback']; // 0
    if StrValue <> '' then
       if StrValue = '1' then
          Result:= Result+ ' -force-feedback';

    StrValue:= SupermodelSettings.Values['VertexShader']; // ''
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+' -vert-shader="'+StrValue+'"';

    StrValue:= SupermodelSettings.Values['FragmentShader']; // ''
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+' -frag-shader="'+StrValue+'"';

    StrValue:= SupermodelSettings.Values['VertexShaderFog']; // ''
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+' -vert-shader-fog="'+StrValue+'"';

    StrValue:= SupermodelSettings.Values['FragmentShaderFog']; // ''
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+' -frag-shader-fog="'+StrValue+'"';

    StrValue:= SupermodelSettings.Values['VertexShader2D']; // ''
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+'-vert-shader-2d="'+StrValue+'" ';

    StrValue:= SupermodelSettings.Values['FragmentShader2D']; // ''
    if (StrValue <> '') and FileExists(StrValue) then
       Result:= Result+' -frag-shader-2d="'+StrValue+'"';

    if Result <> '' then
       CommandLine:= CommandLine+TrimLeft(Result)+' '; // add parameters to the command line
  end;

  function ReadSupermodelIni(const FileStr: String; IsCustomSettings: Boolean): String;
  var
    SupermodelIni: TMemIniFile;

    function AddSupermodelSetting(const iSectionName, iKeyName, iDefaultValueString: String): Boolean;
    var
      iStr: String;
      iIndex: Integer;
    begin
      Result:= True;
      iStr:= SupermodelIni.ReadString(iSectionName, iKeyName, iDefaultValueString);
      if not IsCustomSettings then
         SupermodelSettings.Add(iKeyName+'='+iStr)
      else
         begin
           if SupermodelIni.ValueExists(iSectionName, iKeyName) then
           begin
             iIndex:= SupermodelSettings.IndexOfName(iKeyName);
             if iIndex <> -1 then
                SupermodelSettings[iIndex]:= iKeyName+'='+iStr
             else
                SupermodelSettings.Add(iKeyName+'='+iStr);
           end;
         end;
    end;

  begin
    Result:= '';
    if not FileExists(GetFolderArcadeEmulatorIni(idSupermodel)+FileStr) then
       Exit;

    SupermodelIni:= TMemIniFile.Create(GetFolderArcadeEmulatorIni(idSupermodel)+FileStr);

    SupermodelSettings.BeginUpdate;

    AddSupermodelSetting('Video', 'FullScreen', '0');
    AddSupermodelSetting('Video', 'Resolution', 'auto');

    AddSupermodelSetting('Emulation', 'MultiThreaded', '1');
    AddSupermodelSetting('Emulation', 'GPUMultiThreaded', '1');

    AddSupermodelSetting('Emulation', 'PowerPCFrequency', '2');
    AddSupermodelSetting('Emulation', 'PowerPCFrequencyEnableCustom', '0');
    AddSupermodelSetting('Emulation', 'PowerPCFrequencyCustom', '');

    AddSupermodelSetting('Video', 'New3DEngine', '1');
    AddSupermodelSetting('Video', 'QuadRendering', '1');

    AddSupermodelSetting('Video', 'WideScreen', '0');
    AddSupermodelSetting('Video', 'Stretch', '0');
    AddSupermodelSetting('Video', 'MultiTexture', '1');
    AddSupermodelSetting('Video', 'DisableThrottle', '0');
    AddSupermodelSetting('Video', 'DisableVSync', '0');
    AddSupermodelSetting('Video', 'ShowFrameRate', '0');

    AddSupermodelSetting('Audio', 'DisableSound', '0');
    AddSupermodelSetting('Audio', 'DisableMusic', '0');
    AddSupermodelSetting('Audio', 'FlipStereo', '0');

    AddSupermodelSetting('Audio', 'SoundVolume', '100');
    AddSupermodelSetting('Audio', 'MusicVolume', '100');
    AddSupermodelSetting('Audio', 'Balance', '0');

    AddSupermodelSetting('Controls', 'InputSystem', 'dinput');
    AddSupermodelSetting('Controls', 'Crosshairs', '0'); // 0 = none (default)
    AddSupermodelSetting('Controls', 'ForceFeedback', '0');

    AddSupermodelSetting('Shaders', 'VertexShader', '');
    AddSupermodelSetting('Shaders', 'FragmentShader', '');

    AddSupermodelSetting('Shaders', 'VertexShaderFog', '');
    AddSupermodelSetting('Shaders', 'FragmentShaderFog', '');

    AddSupermodelSetting('Shaders', 'VertexShader2D', '');
    AddSupermodelSetting('Shaders', 'FragmentShader2D', '');

    SupermodelSettings.EndUpdate;
    FreeAndNil(SupermodelIni);
  end;

  function ReadDaphneIni: String;
  var
    DaphneIni: TMemIniFile;
    StrValue: String;
    IntValue: Integer;
  begin
    Result:= '';
    StrValue:= GetArcadeEmuIniFileName(idDaphne);
    if not FileExists(StrValue) then
       begin
         Result:= ' vldp';
         Exit;
       end;
    DaphneIni:= TMemIniFile.Create(StrValue);
    StrValue:= DaphneIni.ReadString('General', 'LaserdiscType', 'vldp');
    Result:= ' '+StrValue;

    if StrValue = 'vldp' then
       begin
         // these settings only work when "Virtual Laser Disc Player" is used
         IntValue:= DaphneIni.ReadInteger('Audio', 'VolumeVLDP', -1);
         if IntValue <> -1 then
            Result:= Result+' -volume_vldp '+IntToStr(IntValue);

         IntValue:= DaphneIni.ReadInteger('Video', 'BlankSkips', 0);
         if Boolean(IntValue) then
            Result:= Result+' -blank_skips';

         IntValue:= DaphneIni.ReadInteger('Video', 'BlankSearches', 0);
         if Boolean(IntValue) then
            Result:= Result+' -blank_searches';
       end
    else
    if StrValue <> 'noldp' then
       begin
         // options that only work for real Laserdisc players
         IntValue:= DaphneIni.ReadInteger('General', 'StopLaserdiscOnQuit', 0);
         if Boolean(IntValue) then
            Result:= Result+' -stoponquit';
       end;

    StrValue:= DaphneIni.ReadString('Video', 'ScrResolution', 'auto');
    if StrValue <> 'auto' then
       begin
         Result:= Result+Format(' -x %s -y %s',
                            [Copy(StrValue, 1, PosEx('x', StrValue)-1),
                             Copy(StrValue, PosEx('x', StrValue)+1, Length(StrValue))]);
       end;
    IntValue:= DaphneIni.ReadInteger('Video', 'OpenGL', 0);
    if Boolean(IntValue) then
       Result:= Result+' -opengl';

    IntValue:= DaphneIni.ReadInteger('Video', 'FullScreen', 0);
    if Boolean(IntValue) then
       Result:= Result+' -fullscreen';

    IntValue:= DaphneIni.ReadInteger('Video', 'IgnoreAspectRatio', 0);
    if Boolean(IntValue) then
       Result:= Result+' -ignore_aspect_ratio';

    IntValue:= DaphneIni.ReadInteger('Video', 'FullScale', 0);
    if Boolean(IntValue) then
       Result:= Result+' -fullscale';

    IntValue:= DaphneIni.ReadInteger('Audio', 'PreferSamples', 0);
    if Boolean(IntValue) then
       Result:= Result+' -prefer_samples';

    IntValue:= DaphneIni.ReadInteger('Audio', 'NoSound', 0);
    if Boolean(IntValue) then
       Result:= Result+' -nosound';

    IntValue:= DaphneIni.ReadInteger('Input', 'NoJoysticks', 0);
    if Boolean(IntValue) then
       Result:= Result+' -nojoystick';

    IntValue:= DaphneIni.ReadInteger('General', 'NoCreateLogFile', 1);
    if not Boolean(IntValue) then
       Result:= Result+' -nolog';

    IntValue:= DaphneIni.ReadInteger('General', 'NoWarnings', 0);
    if Boolean(IntValue) then
       Result:= Result+' -noissues';

    IntValue:= DaphneIni.ReadInteger('General', 'SendUsageStatistics', 1);
    if not Boolean(IntValue) then
       Result:= Result+' -noserversend';

    IntValue:= DaphneIni.ReadInteger('General', 'IdleExit', 0);
    if Boolean(IntValue) then
       begin
         IntValue:= DaphneIni.ReadInteger('General', 'IdleExitSeconds', 30);
         Result:= Result+ ' -idleexit '+IntToStr(IntValue);
       end;

    IntValue:= DaphneIni.ReadInteger('General', 'EnableCheat', 0);
    if Boolean(IntValue) then
       Result:= Result+' -cheat';

    IntValue:= DaphneIni.ReadInteger('General', 'SRAMContinuousUpdate', 0);
    if Boolean(IntValue) then
       Result:= Result+' -sram_continuous_update';

    IntValue:= DaphneIni.ReadInteger('General', 'FastBoot', 0);
    if Boolean(IntValue) then
       Result:= Result+' -fastboot';

    FreeAndNil(DaphneIni);
  end;

  function IsDemulOldVersion: Boolean;
  var
    iDemulPos: Integer;
    iDemulVersion: ShortInt;
    iDemulStr: String;
  begin
    iDemulStr:= EmulatorVersion[idDemul];
    if iDemulStr = '' then
       Result:= False
    else
    begin
      iDemulPos:= PosEx(' v', iDemulStr);
      if iDemulPos <> 0 then
         begin
           if iDemulStr[iDemulPos+2] = '0' then
              begin
                iDemulVersion:= StrToInt(iDemulStr[iDemulPos+4]);
                Result:= iDemulVersion < 7;
              end
           else
              Result:= False;
         end
      else
         Result:= False;
    end;
  end;
  
  function GetGamesListVersion(sysID: Integer): String;
  var
    tmpFile: TMemIniFile;
  begin
    Result:= '-';
    if not FileExists(FormMain.GetGamesFolderEL+GetSystemFileName(sysID)) then
       Exit;
    tmpFile:= TMemIniFile.Create(FormMain.GetGamesFolderEL+GetSystemFileName(sysID));
    Result:= tmpFile.ReadString('info_file', 'version', '');
    FreeAndNil(tmpFile);
  end;

  function AddRaineParamNoGUI_CommandLine(const iCommandLineStr: WideString; iIsBatchFile: Boolean): WideString;
  var
    iNamePos: Integer;
  begin
    Result:= iCommandLineStr;
    if (not MemGameInfo.eIsCustomGame) and (MemGameInfo.eSystemID = idMAME) and (MemGameInfo.eSoftwareName = '') and (not iIsBatchFile) then
       begin
         if PosEx('raine', LowerCase(iCommandLineStr)) <> 0 then
            begin
              //Result:= StringReplaceW(iCommandLineStr, MemGameInfo.eName, '-nogui '+MemGameInfo.eName, [rfIgnoreCase]);
              iNamePos:= PosEx('"', iCommandLineStr, 3)+1;
              Delete(Result, iNamePos, LengthW(Result));
              Result:= Result+' -nogui '+MemGameInfo.eName;
            end;
       end;
  end;

begin
  // AlterMAME extra setting value is now "1"!!!
  Result:= 0; // all is well
  if not ValidateSelectedGame then
     Exit;

  if MemGameInfo.eIsCustomGame then
     EmulatorTitle:= SystemsListCustom[MemGameInfo.eCustomSystemID, 0]
  else
  begin
    case RunWithAlterMAME_Index of
      -1: EmulatorTitle:= GetArcadeEmulatorDescription(MemGameInfo.eSystemID);
       1: EmulatorTitle:= 'AlterMAME';
       2: EmulatorTitle:= 'AlterMAME 2';
    end;
  end;
  SetCmdLineTitle;
  ErrorMsgTitle:= 'Error: '+msgboxTitle;
  ExitCode:= 0; // all is well
  ExitCodeAlterMAME[1]:= 0; // all is well
  ExitCodeAlterMAME[2]:= 0; // all is well
  TryAgainAlterMAME[1]:= False;
  TryAgainAlterMAME[2]:= False;
  IsDemulEmptySystem:= False;
  IsBatchFile:= False;
  IsBatchFileAlterMAME[1]:= False;
  IsBatchFileAlterMAME[2]:= False;

  IsMultiSlot:= False;
  MultiSlotMachineName:= '';
  MachineNameStr:= '';
  SoftwareNameFolder:= '';
  MAME_ExtraParamsCommandLine:= '';
  MachineToUse_Title:= '';
  MAMEMachineItem:= nil;

  if MemGameInfo.eIsCustomGame then
     MemGameInfo.eSystemID:= idMAME;

  if (RunWithAlterMAME_Index = -1) or (RunWithAlterMAME_Index = 1) then
     ValidateAlterMAME(1);
  if (RunWithAlterMAME_Index = -1) or (RunWithAlterMAME_Index = 2) then
     ValidateAlterMAME(2);
  if RunWithAlterMAME_Index = -1 then
     begin
       if (not ValidateArcadeEmulatorFile(MemGameInfo.eSystemID)) then
       begin
         if EmulatorFile[MemGameInfo.eSystemID] <> '' then
            NewOption:= 'not found'
         else
            NewOption:= 'blank';
         GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                         '    Cannot execute because the emulator file is '+NewOption+'. '+
                         'Please go to Arcade Emulator Setup screen and make sure the selected emulator exists.', 2, False, 1);
         ResetSettings;
         Exit;
       end;
     end
  else
  if RunWithAlterMAME_Index in [1, 2] then
     begin
       if not RunWithAlterMAME[RunWithAlterMAME_Index] then
          begin
            CallMessageBox;
            if AlterMAMEFile[RunWithAlterMAME_Index] <> '' then
               NewOption:= 'not found'
            else
               NewOption:= 'blank';

            GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                       '    Cannot execute because the emulator file is '+NewOption+'. '+
                       'Please go to Arcade Emulator Setup screen and make sure the selected AlterMAME exists.', 2, False, 1);
            ResetSettings;
            Exit;
          end;
     end;

  if MemGameInfo.eSystemID = idDemul then
     begin
       if IsROM_Bios(MemGameInfo.eROMIdentification) then
          begin
            GenerateMessage(msgBoxTitle, MemGameInfo.eTitle,
                            'This is a BIOS set and Demul does not run BIOS sets, only games. Aborting...', 2);
            ResetSettings;
            Exit;
          end;
     end;

  TempGameVars.eName:= MemGameInfo.eName;
  case MemGameInfo.eIsCustomGame of
    True:
      begin
        case SearchGameFile(MemGameInfo.eName, MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, ButtonImageCUE.Down, True, TempGameVars.eName) of
          True:
            begin
              //if MemGameInfo.eIsUnicode then
              //   TempGameVars.eName:= GetShortFileNameW(TempGameVars.eName); // MAME command line parameter does not require convert Unicode filenames to DOS 8.3 (July 01, 2018)
              TempGameVars.eName:= '"'+TempGameVars.eName+'"';
            end;
          False:
            begin
              CallMessageBox;
              EnableMsgMediaTypeLabel(False);
              AddEmulatorHeader;
              AddMsgText('    Game file ');
              AddMsgText(MemGameInfo.eName, MsgTxtColors.colorFileName, [fsBold]);
              AddMsgText(' was not found!');
              if not GameFoldersFound(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType) then
                 AddMsgText(' Games folders are empty or not selected.');
              AddMsgText(' Aborting...');
              GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 2, False, -1);

              ResetSettings;
              Exit;
            end;
        end;
      end;
    False:
      begin
        if not VerifyArcadeGamesSys(MemGameInfo.eSystemID, MemGameInfo.eSoftwareName) then
           begin
             ResetSettings;
             Exit;
           end;
      end;
  end;

  GetScreenResolutions;

  {if IsAlterMAME[1] then
     IsBatchFile:= IsExeBatchFile(AlterMAMEFile[1])
  else
     begin
       IsBatchFile:= IsExeBatchFile(EmulatorFile[MemGameInfo.eSystemID]);
       if TryAgainAlterMAME[1] then
          IsBatchFileAlterMAME[1]:= IsExeBatchFile(AlterMAMEFile[1]);
     end;

  case IsAlterMAME[1] of
    True : CommandLine:= SystemStr+AlterMAMEFile[1]+SystemStr+' ';
    False: CommandLine:= SystemStr+EmulatorFile[MemGameInfo.eSystemID]+SystemStr+' ';
  end;}

  if RunWithAlterMAME[1] then
     IsBatchFile:= IsExeBatchFile(AlterMAMEFile[1])
  else
  if RunWithAlterMAME[2] then
     IsBatchFile:= IsExeBatchFile(AlterMAMEFile[2])
  else
     begin
       IsBatchFile:= IsExeBatchFile(EmulatorFile[MemGameInfo.eSystemID]);
       if TryAgainAlterMAME[1] then
          IsBatchFileAlterMAME[1]:= IsExeBatchFile(AlterMAMEFile[1]);
       if TryAgainAlterMAME[2] then
          IsBatchFileAlterMAME[2]:= IsExeBatchFile(AlterMAMEFile[2]);
     end;

  if RunWithAlterMAME[1] then
     CommandLine:= SystemStr+AlterMAMEFile[1]+SystemStr+' '
  else
  if RunWithAlterMAME[2] then
     CommandLine:= SystemStr+AlterMAMEFile[2]+SystemStr+' '
  else
     CommandLine:= SystemStr+EmulatorFile[MemGameInfo.eSystemID]+SystemStr+' ';

  if MemGameInfo.eIsCustomGame then
  begin
    if MachineNameStr = '' then
       MachineNameStr:= GetLastUsedMachineCustomGame(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType);

    if MachineNameStr = '' then
       begin
         CheckMachineToRun_CustomGame(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, MachineNameStr, False);
         if MachineNameStr = '' then
            begin
              // user hit Abort button in select machine dialog... do not display "machine blank" error message
              ResetSettings;
              Exit;
            end;
       end;

    if MachineNameStr = '' then
       begin
         GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                         '    Cannot execute because the MAME machine name is blank. '+
                         'Make sure to select a machine to play this game. Aborting...', 2, False, 1);
         ResetSettings;
         Exit;
       end;
    MachineToUse_Title:= GetTitleMachineToUse(MemGameInfo.eSystemID, MachineNameStr, MemGameInfo.eName, MemGameInfo.eSoftwareName, MAMEMachineItem);

    CommandLine:= CommandLine+MachineNameStr+' -'+MediaTypeCustom[MemGameInfo.eCustomMediaType, 2]+'1 '+TempGameVars.eName;
  end
  else
  begin
    if IsMAMEBasedSys(MemGameInfo.eSystemID) and (MemGameInfo.eSoftwareName <> '') then
    begin
      if PanelMachinesList.Visible then
         begin
           if CheckSelected(MachinesListSidePanel) then
              MachineNameStr:= SelectedMachineListName;
         end;
      if MachineNameStr = '' then
         MachineNameStr:= GetLastUsedMachineSoftwareList(MemGameInfo.eSoftwareName, MemGameInfo.eSystemID);

      if MachineNameStr = '' then
         begin
           SelectMachineToRun(MachineNameStr, False);
           if MachineNameStr = '' then
              begin
                // user hit Abort button in select machine dialog... do not display "machine blank" error message
                ResetSettings;
                Exit;
              end;
         end;

      if MachineNameStr = '' then
         begin
           if PanelMachinesList.Visible then
              GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                              '    Cannot execute because there is no MAME machine selected in the machines list. Aborting...', 2, False, 1)
           else
              GenerateMessage(ErrorMsgTitle, EmulatorTitle,
                              '    Cannot execute because the MAME machine name is blank. '+
                              'Make sure to select a machine to play this software list game. Aborting...', 2, False, 1);
           ResetSettings;
           Exit;
         end;

      MachineToUse_Title:= GetTitleMachineToUse(MemGameInfo.eSystemID, MachineNameStr, MemGameInfo.eName, MemGameInfo.eSoftwareName, MAMEMachineItem);

      CommandLine:= CommandLine+MachineNameStr+' ';

      TempStr:= GetSoftListGameRequiredParam(MemGameInfo.eSystemID, MemGameInfo.eName, MemGameInfo.eSoftwareName);
      if TempStr <> '' then
         CommandLine:= CommandLine+TempStr+' '; // must add the required parameter BEFORE the game (Atari 2600 Cassetes do not run otherwise)

      if MemGameInfo.eSoftwareExecParameter <> '' then
         CommandLine:= CommandLine+'-'+MemGameInfo.eSoftwareExecParameter+' '+TempGameVars.eName
      else
         CommandLine:= CommandLine+TempGameVars.eName;

      //TempStr:= GetSoftListGameRequiredParam(MemGameInfo.eSystemID, MemGameInfo.eName, MemGameInfo.eSoftwareName);
      //if TempStr <> '' then
      //   CommandLine:= CommandLine+' '+TempStr;
      SoftwareNameFolder:= MemGameInfo.eSoftwareName+'\';
    end
    else
    begin
      if (MemGameInfo.eSystemID = idDICE) and (MemGameInfo.eName = 'attack2') then
         CommandLine:= CommandLine+'attack' // for "Attack (set 2)"
      else
      if not (MemGameInfo.eSystemID in [idSupermodel, idDemul, idZiNc]) then
         begin
           MultiSlotMachineName:= ChangeFileExt(MemGameInfo.eDriverName, '');
           MachineNameStr:= MultiSlotMachineName;
           if IsNeoGeoDriver(MemGameInfo.eSystemID, MultiSlotMachineName, MemGameInfo.eBiosName) then
              MultiSlotMachineName:= 'neogeo';
           IsMultiSlot:= ValidateMultiSlot(MemGameInfo.eSystemID, MultiSlotMachineName, CommandLine, not MenuViewEmulatorFullCommandLine.Checked);
           if not IsMultiSlot then
              begin
                MultiSlotMachineName:= '';
                //if MemGameInfo.eSoftwareName = '' then
                   MachineNameStr:= '';
                if FormArcadeMultiSlotGames <> nil then
                if FormArcadeMultiSlotGames.ModalResult = mrCancel then
                   begin
                     FreeAndNil(FormArcadeMultiSlotGames);
                     ResetSettings;
                     Exit;
                   end;
                CommandLine:= CommandLine+TempGameVars.eName; // regular command line --> "emulator.exe gamename"
                // Supermodel, Demul, ZiNc need special parameters...
              end;
           MachineToUse_Title:= GetTitleMachineToUse(MemGameInfo.eSystemID, MultiSlotMachineName, MemGameInfo.eName, MemGameInfo.eSoftwareName, MAMEMachineItem);
         end;
    end;
  end;

  ItemToUpdate:= SelectedEasyItem;
  if IsBatchFile then
     CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr; // cmd.exe /c "emu-call.bat"

  case IsBatchFile of
    True:
      begin
        // cmd.exe /c "emu-call.bat"
        //CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;
      end;
    False:
      begin
        case IsMAMEBasedSys(MemGameInfo.eSystemID) of
          True:
            begin
              // "MAME_ExtraSetting" will be used only to activate "AlterMAME"... will change its var name later!!! August 26, 2016
              if MAME_ExtraPamars and (not RunWithAlterMAME[1]) and (not RunWithAlterMAME[2]) and (not IsMultiSlot) then
                 begin
                   // old tags... remove these (October 30, 2016)
                   // -1: none... invalid!
                   // 20: playback input
                   // 21: record input
                   // 22: load a save state
                   // 23: record wave
                   // 24: record mng
                   // 25: record avi
                   // 26: * left panel file select (not used anymore!!!)
                   // 27: play and use an effect overlay
                   // 28: Select Effect Overlay (MAME Settings)
                   // 29: Select Font Files, emulator (BDF)
                   // 30: Select Font Files, game, driver (BDF)
                   // 31: Select Shadow Mask Texture (MAME Settings)
                   // all these options are now MAME exclusive features

                   MAME_ExtraParamsCommandLine:= RunMAMEExtraParameters(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID], MachineNameStr);
                   // if var above is empty... no biggie, continue to run game!
                   if SameText(MAME_ExtraParamsCommandLine, 'abort') then
                      begin
                        ResetSettings;
                        Exit; // "Abort. For the 1000th time... ABORT!!!" :)
                      end;
                   //ShowMessage('"->'+MAME_ExtraParamsCommandLine+'<-"'); // for debugging only!!!
                 end;
            end;
          False:
            begin
              case MemGameInfo.eSystemID of
                idSupermodel:
                  begin
                    // Supermodel, need to add options before game, and it's .zip file with full path!
                    NewOption:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID);
                    if NewOption = '' then
                       begin
                         CallMessageBox;
                         ShowGameNameEntryMsgBox;
                         GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle,
                                         'Cannot execute because the game file was not found. Aborting...', 2, False, 0);

                         ResetSettings;
                         Exit; // game file not found, "Abort. For the 1000th time... ABORT!!!"
                       end;

                    if MAME_ExtraPamars then
                       begin
                         // 22: load a save state
                         MAME_ExtraParamsCommandLine:= RunMAMEExtraParameters(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID], MachineNameStr);
                         // if var above is empty... no biggie, continue to run game!
                         if SameText(MAME_ExtraParamsCommandLine, 'abort') then
                            begin
                              ResetSettings;
                              Exit; // "Abort. For the 1000th time... ABORT!!!"
                            end;
                         //ShowMessage('"->'+MAME_ExtraParamsCommandLine+'<-"'); // for debugging only!!!
                       end;

                    SupermodelSettings:= TStringList.Create;

                    // read "D:\EmuLoader\arcade\emulator_ini\supermodel_ini\Supermodel.ini" first
                    ReadSupermodelIni(GetArcadeEmuIniFileName(MemGameInfo.eSystemID), False);

                    // read "D:\EmuLoader\arcade\emulator_ini\supermodel_ini\gamename.ini", and overwrite current settings
                    ReadSupermodelIni(MemGameInfo.eName+'.ini', True);

                    NewOption2:= MountSupermodelCommandLine;

                    FreeAndNil(SupermodelSettings);

                    SetCmdLineTitle(True);

                    CommandLine:= CommandLine+'"'+NewOption+'"'; // add the game filename with full path
                  end;
                idDaphne:
                  begin
                    CommandLine:= CommandLine+ReadDaphneIni;
                  end;
                idDemul: // Demul, need special parameters before the game name
                  begin
                    if MemGameInfo.eDriverName <> '' then
                       CommandLine:= CommandLine+'-run='+GetDemulMachineName(MemGameInfo.eDriverName, IsDemulOldVersion)+
                                     ' -rom='+MemGameInfo.eName
                    else
                       IsDemulEmptySystem:= True;
                    // do nothing else as Demul doesn't support custom game settings
                    //if MemGameInfo.eDriverName <> '' then
                    //   CommandLine:= CommandLine+'-run='+GetDemulMachineName(MemGameInfo.eDriverName)+
                    //              ' -rom='+MemGameInfo.eName
                    //else
                    //   IsDemulEmptySystem:= True;
                    // do nothing else as Demul doesn't support custom game settings
                  end;
                idZiNc:
                  begin
                    // ZiNc, needs special parameters before the game name
                    if MemGameInfo.eScreenType <> -1 then
                       CommandLine:= CommandLine+IntToStr(MemGameInfo.eScreenType) // ZiNc stores game index in "eScreenType" var
                    else
                       begin
                         CallMessageBox;
                         ShowGameNameEntryMsgBox;
                         case IsROM_Bios(MemGameInfo.eROMIdentification) of
                           True : GenerateMessage(msgBoxTitle, MemGameInfo.eTitle,
                                         'This is a BIOS set and ZiNc does not run BIOS sets, only games. Aborting...', 2);
                           False: GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle,
                                         'Invalid ZiNc game index (-1). Please create games list again. Aborting...', 2, False, 1);
                         end;
                         ResetSettings;
                         Exit;
                       end;
                    // first driver, second game, then default emulator options
                    SetCmdLineTitle(True);

                    NewOption:= GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID);
                    NewOption2:= ChangeFileExt(MemGameInfo.eDriverName, '.cfg'); // NewOption2 holds the filename (no path)
                    if not FileExists(NewOption+NewOption2) then
                       begin
                         NewOption2:= MemGameInfo.eName+'.cfg';
                         if not FileExists(NewOption+NewOption2) then
                            begin
                              // use default emulator settings
                              NewOption2:= GetArcadeEmuIniFileName(MemGameInfo.eSystemID);
                              SetCmdLineTitle;
                            end;
                        end;

                    // function "LongToShortPath()" cannot have last backslash '\' or it won't work; the filename is also lost
                    // "NewOption" var will store the .cfg file with full path (October 10, 2016)

                    // ZiNc does not support Unicode paths or filenames
                    NewOption:= GetShortFileNameW(NewOption); //NewOption:= ExtractShortPathName(NewOption); // this doesn't work (do not remove this comment!)
                    if ValidateFile(NewOption+NewOption2) then
                       CommandLine:= CommandLine+' --use-config-file='+NewOption+NewOption2;

                    // get game.zip or parent.zip folder
                    NewOption:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID);
                    if NewOption <> '' then
                       NewOption:= GetShortFileNameW(ExtractFilePath(NewOption)) //NewOption:= ExtractShortPathName(ExtractFilePath(NewOption)) // this doesn't work (do not remove this comment!)
                    else
                    if GameIsClone(MemGameInfo.eClone) then
                       begin
                         NewOption:= SearchZIPFolder(MemGameInfo.eClone, MemGameInfo.eSystemID);
                         if NewOption <> '' then
                            NewOption:= GetShortFileNameW(ExtractFilePath(NewOption)); //NewOption:= ExtractShortPathName(ExtractFilePath(NewOption)); // this doesn't work (do not remove this comment!)
                       end;
                    if NewOption <> '' then
                       CommandLine:= CommandLine+' --roms-directory='+NewOption;
                  end;
              end;
            end;
        end;
      end;
  end;

  // need to check the correct MAME binary and also check all other emulators!!!
  if CommandLine <> '' then
    begin
      if (MemGameInfo.eSystemID = idDemul) and (CommandLine = '!error') then
         CommandLine:= '';

      if not MemGameInfo.eIsCustomGame then
      begin
        if MAME_ExtraParamsCommandLine <> '' then
           CommandLine:= CommandLine+MAME_ExtraParamsCommandLine; // playback/record input, load save state, insert memory card, record movie

        if MemGameInfo.eSoftwareName <> '' then
           begin
             // fix game snap name full folder path for software list games (path_mame.ini\softlist_name\gamename\)
             CommandLine:= CommandLine+' -statename '+MachineNameStr+'/'+MemGameInfo.eSoftwareName+'/'+MemGameInfo.eName;
             CommandLine:= CommandLine+' -snapname '+MemGameInfo.eSoftwareName+'/'+MemGameInfo.eName+'/%i';
             // fix state name full folder path for software list games (path_mame.ini\machine_name\softlist_name\gamename\)
           end;
      end;

      if MenuViewEmulatorFullCommandLine.Checked or IsDemulEmptySystem then
         begin
           CallMessageBox;
           case MemGameInfo.eIsCustomGame of
             True : EnableMsgMediaTypeLabel(False);
             False: ShowGameNameEntryMsgBox(IsMultiSlot, MultiSlotMachineName);
           end;

           FormMessageBox.ButtonYes.Caption:= 'Execute';
           FormMessageBox.ButtonNo.Caption:= 'Abort';

           case MemGameInfo.eIsCustomGame of
             True :
               begin
                 TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
                 AddMsgText(TempStr, MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                 AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
               end;
             False:
               begin
                 AddMsgText('Games list   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                 AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
               end;
           end;

           if RunWithAlterMAME[1] then
              begin
                AddMsgText('AlterMAME Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[1]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end
           else
           if RunWithAlterMAME[2] then
              begin
                AddMsgText('AlterMAME Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[2]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end
           else
              begin
                AddMsgText('Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(EmulatorVersion[MemGameInfo.eSystemID]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end;

           if IsMultiSlot then
              begin
                if MachineToUse_Title <> '' then
                   begin
                     AddMsgText(#13#10+'Multi-slot Machine   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                     AddMsgText(MachineToUse_Title+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                   end;

                msItem:= FormArcadeMultiSlotGames.GamesList.Groups.FirstItem;
                repeat
                  if not msItem.Ghosted then
                  begin
                    if msItem.Index < 9 then // msItem.Index starts at ZERO (slot #10 is actually Index 9)
                       NewOption:= '0'+IntToStr(msItem.Index+1)
                    else
                       NewOption:= IntToStr(msItem.Index+1);
                                      // two leading zeroes
                    AddMsgText(#13#10+NewOption+' ', MsgTxtColors.colorMachineMultiSlot, [], taLeftJustify);
                    AddMsgText(msItem.Captions[1], clBlack, [], taLeftJustify);
                  end;

                  msItem:= FormArcadeMultiSlotGames.GamesList.Groups.NextItem(msItem);
                until msItem = nil;
                FreeAndNil(FormArcadeMultiSlotGames);
                AddMsgText(#13#10);
              end;

           if not MemGameInfo.eIsCustomGame then
              begin
                 if MemGameInfo.eSoftwareName <> '' then
                    begin
                      AddMsgText(#13#10+'Machine   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                      AddMsgText(MachineToUse_Title+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

                      AddMsgText('Software List   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                      AddMsgText(MemGameInfo.eCategory+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                    end;
              end
           else
              begin
                AddMsgText(#13#10+'MAME Machine   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(MachineToUse_Title+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end;

           if not IsDemulEmptySystem then
              //AddMsgText(#13#10+CommandLine, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas')
              AddMsgText(#13#10+AddRaineParamNoGUI_CommandLine(CommandLine, IsBatchFile), MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas')
           else
              AddMsgText(#13#10+'    The system name is blank, Demul cannot run games without it. If this is a playable game, '+
                         'please post a message in the forum or contact by e-mail.'+#13#10+#13#10+
                         'forum: http://www.mameworld.info/ubbthreads/postlist.php?Cat=&Board=emuloader'+#13#10+
                         'e-mail: emuloader@gmail.com');


           if (not RunWithAlterMAME[1]) and TryAgainAlterMAME[1] then
              begin
                AddMsgText(#13#10+#13#10);
                AddMsgText('AlterMAME will be used to run "'+MemGameInfo.eName+'" if it fails '+
                           'to load with MAME.'+#13#10);
                AddMsgText(#13#10+'AlterMAME Emulator  ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[1]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

                NewOption:= StringReplace(CommandLine, EmulatorFile[MemGameInfo.eSystemID], AlterMAMEFile[1], [rfIgnoreCase]);
                if IsBatchFileAlterMAME[1] then
                   NewOption:= CommandPromptStr+systemStr+NewOption+SystemStr;

                AddMsgText(#13#10+AddRaineParamNoGUI_CommandLine(NewOption, IsBatchFileAlterMAME[1]), MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
              end;
           if (not RunWithAlterMAME[2]) and TryAgainAlterMAME[2] then
              begin
                AddMsgText(#13#10+#13#10);
                AddMsgText('AlterMAME 2 will be used to run "'+MemGameInfo.eName+'" if it fails '+
                           'to load with AlterMAME.'+#13#10);
                AddMsgText(#13#10+'AlterMAME 2 Emulator  ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[2]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

                NewOption:= StringReplace(CommandLine, EmulatorFile[MemGameInfo.eSystemID], AlterMAMEFile[2], [rfIgnoreCase]);
                if IsBatchFileAlterMAME[2] then
                   NewOption:= CommandPromptStr+systemStr+NewOption+SystemStr;

                AddMsgText(#13#10+AddRaineParamNoGUI_CommandLine(NewOption, IsBatchFileAlterMAME[2]), MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
              end;
           if not IsMultiSlot then
              begin
                if not MemGameInfo.eIsCustomGame then
                begin
                  if (MemGameInfo.eGameSetStatus > 0) then
                     begin
                       AddMsgText(#13#10);
                       AddMsgText(#13#10+'WARNING: One on more ROMs/CHDs are missing, "'+
                                  MemGameInfo.eName+'" might not run properly!'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                     end
                  else
                     if (MemGameInfo.eSystemID = idZiNc) and (NewOption = '') then
                        begin
                          AddMsgText(#13#10);
                          AddMsgText(#13#10+'WARNING: Zip file was not found. "'+MemGameInfo.eName+'" cannot be run!'+
                                     #13#10+'ZiNc might return "Error 1: Incorrect Function" message.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                        end;
                end;

                if (MAMEMachineItem <> nil) and (TEasyGameInfo(MAMEMachineItem).eGameSetStatus > 0) then
                   begin
                     if MemGameInfo.eGameSetStatus = 0 then
                        AddMsgText(#13#10+#13#10);

                     AddMsgText('WARNING: One on more ROMs/CHDs are missing, "'+
                                MachineNameStr+'" machine might not run properly!'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                   end;
              end;

           case IsDemulEmptySystem of
             False:
               begin
                 if not IsMultiSlot then
                    begin
                      NewOption:= MemGameInfo.eTitle;
                      MsgType:= -1;
                    end
                 else
                    begin
                      MsgType:= 4; // set this so msgbox shows the system icon...
                      if MachineNameStr = 'neogeo' then // MultiSlotMachineName (no longer used)
                         begin
                           NewOption:= 'Neo-Geo Multi Video System';
                           //MsgType:= 4; // no longer used (May 26, 2018)
                         end
                      else
                      if MachineNameStr = 'megatech' then // MultiSlotMachineName (no longer used)
                         begin
                           NewOption:= 'Sega Mega-Tech System';
                           //MsgType:= 5; // no longer used (May 26, 2018)
                         end
                      else
                      if MachineNameStr = 'playch10' then // MultiSlotMachineName (no longer used)
                         begin
                           NewOption:= 'Nintendo PlayChoice-10';
                           //MsgType:= 6; // no longer used (May 26, 2018)
                         end
                      else
                      if MachineNameStr = 'stv' then // MultiSlotMachineName (no longer used)
                         begin
                           NewOption:= 'Sega Titan Video Game System';
                           //MsgType:= 7; // no longer used (May 26, 2018)
                         end;
                    end;
                 if GenerateMessage(msgboxTitle, NewOption, '', 1, False, MsgType, MemGameInfo.eGameSetStatus) = mrNo then
                    begin
                      ResetSettings;
                      Exit;
                    end;
               end;
             True:
               begin
                 GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 2);
                 ResetSettings;
                 Exit;
               end;
           end;
         end;

      VideoPreviewPlayDummy(True); // stop current video playback by playing a dummy video
      MAMu_CloseZipArchives;

      iPlayTime:= GetTickCount;

      if RunWithAlterMAME[1] then
         SetCurrentDir(ExtractFilePath(AlterMAMEFile[1]))
      else
      if RunWithAlterMAME[2] then
         SetCurrentDir(ExtractFilePath(AlterMAMEFile[2]))
      else
         SetCurrentDir(ExtractFilePath(EmulatorFile[MemGameInfo.eSystemID]));

      //case RunWithAlterMAME[1] of
      //  True : SetCurrentDir(ExtractFilePath(AlterMAMEFile[1]));
      //  False: SetCurrentDir(ExtractFilePath(EmulatorFile[MemGameInfo.eSystemID]));
      //end;

      IsRunningGame:= True;

      ExitCode:= RunProcess(AddRaineParamNoGUI_CommandLine(CommandLine, IsBatchFile), True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game
      //ExitCode:= RunProcess(CommandLine, True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game

      if ExitCode <> 0 then // = 2 ? // files are missing error code
         begin
           if (not RunWithAlterMAME[1]) and TryAgainAlterMAME[1] then
              begin
                RunWithAlterMAME[1]:= True; // set this here to avoid problems below
                CommandLine:= StringReplace(CommandLine, EmulatorFile[MemGameInfo.eSystemID], AlterMAMEFile[1], [rfIgnoreCase]);
                if IsBatchFileAlterMAME[1] then
                   CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;

                SetCurrentDir(ExtractFilePath(AlterMAMEFile[1]));
                ExitCodeAlterMAME[1]:= RunProcess(AddRaineParamNoGUI_CommandLine(CommandLine, IsBatchFileAlterMAME[1]), True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game with AlterMAME executable
                //ExitCodeAlterMAME[1]:= RunProcess(CommandLine, True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game with AlterMAME executable

                if ExitCodeAlterMAME[1] <> 0 then
                   begin
                     if (not RunWithAlterMAME[2]) and TryAgainAlterMAME[2] then
                        begin
                          RunWithAlterMAME[2]:= True; // set this here to avoid problems below
                          CommandLine:= StringReplace(CommandLine, AlterMAMEFile[1], AlterMAMEFile[2], [rfIgnoreCase]);
                          if IsBatchFileAlterMAME[2] then
                             CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;

                          SetCurrentDir(ExtractFilePath(AlterMAMEFile[2]));
                          ExitCodeAlterMAME[2]:= RunProcess(AddRaineParamNoGUI_CommandLine(CommandLine, IsBatchFileAlterMAME[2]), True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game with AlterMAME executable
                          //ExitCodeAlterMAME[2]:= RunProcess(CommandLine, True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game with AlterMAME executable
                        end;
                   end;
              end
           else
           if (not RunWithAlterMAME[2]) and TryAgainAlterMAME[2] then
              begin
                RunWithAlterMAME[2]:= True; // set this here to avoid problems below
                CommandLine:= StringReplace(CommandLine, EmulatorFile[MemGameInfo.eSystemID], AlterMAMEFile[2], [rfIgnoreCase]);
                if IsBatchFileAlterMAME[2] then
                   CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;
                   
                SetCurrentDir(ExtractFilePath(AlterMAMEFile[2]));
                //ExitCodeAlterMAME[2]:= RunProcess(CommandLine, True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game with AlterMAME executable
                ExitCodeAlterMAME[2]:= RunProcess(AddRaineParamNoGUI_CommandLine(CommandLine, IsBatchFileAlterMAME[2]), True, GetWindowStateRunGame(MemGameInfo.eSystemID)); // run game with AlterMAME executable
              end;
         end;
      IsRunningGame:= False;

      ThousandSeparator:= Char(',');
      DecimalSeparator:= Char('.');

      case FormMain.MemGameInfo.eIsCustomGame of
        True:
          begin
            UpdatePlayedCustomGame(iPlayTime, ItemToUpdate);
          end;
        False:
          begin
            UpdatePlayedGameArcade(iPlayTime, ItemToUpdate);
          end;
      end;

      Result:= ExitCode;
      if ExitCode = 0 then
         begin
           // all is well
           if not MemGameInfo.eIsCustomGame then
           begin
             if IsMAMEBasedSys(MemGameInfo.eSystemID) then
                begin
                  NewOption:= '';
                end;
             if ImageDetails[1].NoImageLoaded then
                begin
                  ImageDetails[1].NoImageLoaded:= False;
                  ImageDetails[1].PrevNoImageLoaded:= False;
                  ImageDetails[1].NewImageLoaded:= False;
                end;
             ToggleImagesPanel(True); // force snapshot reload, in case user takes a new screenshots while gaming
             //MenuShowImages.OnClick(Self); // avoid this as EL was re-initializing the zipped image lists (do not remove this comment)
           end;
         end
      else
         begin
           CallMessageBox;
           case MemGameInfo.eIsCustomGame of
             True : EnableMsgMediaTypeLabel(False);
             False: ShowGameNameEntryMsgBox;
           end;

           case MemGameInfo.eIsCustomGame of
             True:
               begin
                 TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
                 AddMsgText(TempStr, MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                 AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
               end;
             False:
               begin
                 AddMsgText('Games list   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                 AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
               end;
           end;

           if (RunWithAlterMAME[1] and (not TryAgainAlterMAME[1])) then
              begin
                AddMsgText('AlterMAME Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[1]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end
           else
           if (RunWithAlterMAME[2] and (not TryAgainAlterMAME[2])) then
              begin
                AddMsgText('AlterMAME 2 Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[2]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end
           else
              begin
                AddMsgText('Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(EmulatorVersion[MemGameInfo.eSystemID]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end;

           if not MemGameInfo.eIsCustomGame then
              begin
                if MemGameInfo.eSoftwareName <> '' then
                   begin
                     AddMsgText(#13#10+'Machine   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                     AddMsgText(MemGameInfo.eCategory+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                   end;
              end
           else
              begin
                AddMsgText(#13#10+'Machine   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(MachineToUse_Title+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
              end;

           AddMsgText(#13#10+'Error '+IntToStr(ExitCode), MsgTxtColors.colorExitCode, [fsBold]);
           AddMsgText(': '+SysErrorMessage(ExitCode)+'.');

           // check this link for most common error messages:
           // http://www.febooti.com/products/automation-workshop/online-help/events/run-dos-cmd-command/exit-codes/
           if ExitCode = 2 then
              begin
                AddMsgText(#13#10);
                case MemGameInfo.eIsCustomGame of
                  True : AddMsgText(#13#10+'Required "'+MachineNameStr+'" machine files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                  False: AddMsgText(#13#10+'Required files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                end;
              end;

           if MemGameInfo.eSystemID = idZiNc then
              begin
                if ExitCode = 1 then
                   AddMsgText(#13#10+#13#10+'    Make sure all sets required by this game are on the same folder and that you have '+
                              'the "d3d-ogl12.zip" plugin installed. Emu Loader supports multiple ROMs folders in case you like to separate '+
                              'your games by system, but ZiNc emulator can only load a game if all sets are located on the same place '+
                              '(bios set + game set + clone set).');
              end;

           if RunWithAlterMAME[1] and TryAgainAlterMAME[1] then
              begin
                //if ExitCodeAlterMAME[1] <> 2 then // if ExitCode <> 2 then
                //   AddMsgText(#13#10);
                AddMsgText(#13#10+'AlterMAME Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[1]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

                if ExitCodeAlterMAME[1] <> 0 then
                   begin
                     AddMsgText(#13#10+'Error '+IntToStr(ExitCodeAlterMAME[1]), MsgTxtColors.colorExitCode, [fsBold]);
                     AddMsgText(': '+SysErrorMessage(ExitCodeAlterMAME[1])+'.');

                     if ExitCodeAlterMAME[1] = 2 then
                        begin
                          AddMsgText(#13#10);
                          case MemGameInfo.eIsCustomGame of
                            True : AddMsgText(#13#10+'Required "'+MachineNameStr+'" machine files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                            False: AddMsgText(#13#10+'Required files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                          end;
                        end
                     else
                     if ExitCodeAlterMAME[1] in [1, 5] then
                        AddMsgText(#13#10);
                   end
                else
                   begin
                     AddMsgText(#13#10+'Success '+IntToStr(ExitCode), MsgTxtColors.colorExitCode, [fsBold]);
                     AddMsgText(' :'+SysErrorMessage(ExitCodeAlterMAME[1])+'.');
                   end;
              end;

           if RunWithAlterMAME[2] and TryAgainAlterMAME[2] then
              begin
                //if ExitCodeAlterMAME[2] <> 2 then // if ExitCode <> 2 then
                //   AddMsgText(#13#10);
                AddMsgText(#13#10+'AlterMAME 2 Emulator   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
                AddMsgText(AlterMAMEVersion[2]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

                if ExitCodeAlterMAME[2] <> 0 then
                   begin
                     AddMsgText(#13#10+'Error '+IntToStr(ExitCodeAlterMAME[2]), MsgTxtColors.colorExitCode, [fsBold]);
                     AddMsgText(': '+SysErrorMessage(ExitCodeAlterMAME[2])+'.');

                     if ExitCodeAlterMAME[2] = 2 then
                        begin
                          AddMsgText(#13#10);
                          case MemGameInfo.eIsCustomGame of
                            True : AddMsgText(#13#10+'Required "'+MachineNameStr+'" machine files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                            False: AddMsgText(#13#10+'Required files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText, 10);
                          end;
                        end
                     else
                     if ExitCodeAlterMAME[2] in [1, 5] then
                        AddMsgText(#13#10);
                   end
                else
                   begin
                     AddMsgText(#13#10+'Success '+IntToStr(ExitCode), MsgTxtColors.colorExitCode, [fsBold]);
                     AddMsgText(' :'+SysErrorMessage(ExitCodeAlterMAME[2])+'.');
                   end;
              end;

           if ExitCode = 2 then
              begin
                if (RunWithAlterMAME[1] and (ExitCodeAlterMAME[1] = 0)) or (RunWithAlterMAME[2] and (ExitCodeAlterMAME[2] = 0)) then
                   AddMsgText(#13#10);
                if (MemGameInfo.eSoftwareName = '') and (not MemGameInfo.eIsCustomGame) then
                   AddMsgText(#13#10+'Please check for missing ROMs/CHDs. Would you like to '+
                              'view ROMs/CHDs details now ?')
                else
                   begin
                     // need to use MAMEMachineItem var here and use TempGameVars variables in GameDetails screen...
                     AddMsgText(#13#10+'Please check for missing ROMs/CHDs and make sure the machine ');
                     AddMsgText(MachineToUse_Title, MsgTxtColors.colorMachineName);//, [fsItalic]); // colorMachineMultiSlot
                     AddMsgText(' ('+MachineNameStr+') ');
                     AddMsgText('doesn''t have missing ROMs/CHDs. Would you like to view ROMs/CHDs details now ?');
                   end;
                if GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 1, False, 0, MemGameInfo.eGameSetStatus) = mrYes then
                   PopupGameDetails.Click;
              end
           else
              GenerateMessage(msgboxTitle, MemGameInfo.eTitle, '', 2);
         end;
    end
  else
    GenerateMessage(ErrorMsgTitle, 'Command line is blank.',
                    '  "D''OH!"'+#13#10+
                    'Cannot execute with an empty command line.', 2, False, 1);
  ResetSettings;
end;

procedure TFormMain.EnableMsgMediaTypeLabel(MountImage: Boolean; AssociatedApplication: Boolean = False);
begin
  FormMessageBox.IconMediaType.Tag:= 0;

  //need to improve the media icon... it will display system icon for arcade games ??????
  //perhaps make it always visible ????
  // 1: Cartridge
  // 2: Disc Image
  // 3: Floppy Disk
  // 4: Cassette Tape
  // 5: Hard Disk Drive
  with FormMessageBox do
  begin
    IconMediaType.Visible:= True;
    LabelGameName.Visible:= True;

    IconMediaType.Hint:= MediaTypeCustom[MemGameInfo.eCustomMediaType, 1];
    LabelGameName.Canvas.Lock;
    LabelGameName.Caption:= MediaTypeCustom[MemGameInfo.eCustomMediaType, 0];
    if not AssociatedApplication then
       begin
         if MountImage then
            LabelGameName.Caption:= LabelGameName.Caption+'; mount on virtual drive';
       end;

    if CheckMultipleSelected(GamesListView) then
       LabelGameName.Caption:= LabelGameName.Caption+'; '+IntToStr(GamesListView.Selection.Count)+' games selected'
    else
       LabelGameName.Caption:= LabelGameName.Caption+'; file extension '+WideLowerCase(ExtractFileExtW(MemGameInfo.eName));

    LabelGameName.Canvas.Unlock;
  end;
end;

function TFormMain.GameFoldersFound(CustomSystemID, CustomMediaType: Integer): Boolean;
begin
  Result:= Assigned(sysCustomFolders[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType]) and
           (sysCustomFolders[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType].Count > 0);
end;

function TFormMain.SearchGameFile(const GameName: WideString; CustomSystemID, CustomMediaType: Integer; SearchDiscFileCUE, ShowQuickMessageBox: Boolean; out VarFileFullPath: WideString): Boolean;
var
  LoopSearch: Integer;
  FolderStr: String;
  SearchCUE: Boolean;
  FileToSearch: WideString;
begin
  Result:= False;
  FileToSearch:= '';

  if not Assigned(sysCustomFolders[CustomSystemID, CustomMediaType]) then
     Exit;
  if sysCustomFolders[CustomSystemID, CustomMediaType].Count = 0 then
     Exit;
  if ShowQuickMessageBox then
     ShowFilterMsgBox('Execute Game', 'Searching game file, please wait...', False);

  SearchCue:= SearchDiscFileCue;
  if SearchCue then
     SearchCUE:= (CustomMediaType = 2) and ButtonImageCUE.Down;

  for LoopSearch:=0 to sysCustomFolders[CustomSystemID, CustomMediaType].Count-1 do
  begin
    FolderStr:= sysCustomFolders[CustomSystemID, CustomMediaType].Strings[LoopSearch];

    if FindFile(FolderStr, GameName, FileToSearch, SearchCUE) then
       begin
         VarFileFullPath:= FileToSearch;
         Result:= True;
         Break;
       end;
  end;

  if ShowQuickMessageBox then
     HideFilterMsgBox;
end;

procedure TFormMain.AddEmulatorHeader(const iEmulatorFile: String = '');
begin
  AddMsgText('Emulator '+IntToStr(EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID])+'   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
  if iEmulatorFile = '' then
     AddMsgText(EmulatorVersionCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS')
  else
     AddMsgText(iEmulatorFile+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
  AddMsgText(#13#10);
end;

procedure TFormMain.ExecuteGameCustom;
const
  WinViceFlipDisk: String = ' -flipname "%s"'; // Commodore 64 for multi-floppy disk games
var
  CommandLine, EmuParameters, MultiFloppyParameter, txtString: WideString;
  EmulatorString, ErrorMsgTitle,
  MountImageStr, UnmountImageStr: WideString;
  GameFileExt, TempStr: String;
  Continue, UseVirtualDrive, IsBatchFile, IsFileFound, MultiFloppy, IsWinUAE, IsViceFlipList: Boolean;
  ExtraParameters, ExtraDefaultParameters: TMemIniFile;
  IsJavaPSPEmu, IsWinApeEmu: Boolean;
  ExitCode: DWORD;

  WinApeCurrentROM: String;
  iPlayTime: Cardinal;

  function GetEmulatorFile: Boolean;
  begin
    EmulatorString:= EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]];
    Result:= (EmulatorString <> '') and FileExistsW(EmulatorString);
  end;

  function GetExecParameters(ParameterIndex: Byte; MountImagePCE: Boolean = False): Boolean;
  var
    mediaIdx: Byte;
  begin
    // ParameterIndex: 1 -> Param1; 2 -> Param2
    if MountImagePCE then
       mediaIdx:= 0
    else
       mediaIdx:= MemGameInfo.eCustomMediaType;
    EmuParameters:= ExtraParameters.ReadString(SystemsListCustom[MemGameInfo.eCustomSystemID, 0],
                                       ExtractFileName(ChangeFileExt(EmulatorString, ''))+
                                       GetMediaTypeName(mediaIdx, ParameterIndex, True), '');
    if MountImagePCE then
       Result:= True
    else
       begin
         Result:= EmuParameters <> '';
         if not Result then
            begin
              if Assigned(ExtraDefaultParameters) then
                 begin
                   EmuParameters:= ExtraDefaultParameters.ReadString(SystemsListCustom[MemGameInfo.eCustomSystemID, 0],
                                   ExtractFileName(ChangeFileExt(EmulatorString, ''))+
                                   GetMediaTypeName(mediaIdx, ParameterIndex, True), '');
                   Result:= EmuParameters <> '';
                 end;
            end;
       end;
    //ShowMessage(SystemsList[MemGameInfo.eSystemID, 0]+#13#10+
    //            ExtractFileName(ChangeFileExt(EmulatorString, ''))+
    //            GetMediaTypeName(mediaIdx, ParameterIndex, True)+#13#10+EmuParameters); // for debugging only
  end;

  function GetROMTypeAtari800: Boolean;
  var
    tmpCartStr: String;
    tmpFileSize: Integer;

    function IsExecutableFile: Boolean;
    begin
      Result:= SameText('.xex', GameFileExt) or SameText('.exe', GameFileExt) or SameText('.com', GameFileExt) or
               SameText('.bas', GameFileExt) or SameText('.lst', GameFileExt);
    end;

    function IsCARFile: Boolean;
    begin
      // read first 4 bytes of file to validate 'C' 'A' 'R' 'T' tag for Atari800, Atari800Win, Altirra
      Result:= ReadAtari800CartTypeTag(TempGameVars.eName);
    end;

  begin
    Result:= (MemGameInfo.eCustomSystemID = 48) and (MemGameInfo.eCustomMediaType = 1);
    if not Result then Exit;

    tmpFileSize:= MemGameInfo.eGameSize div 1024;
    if IsAtari800Emu(ExtractFileName(EmulatorString)) then
    begin
      // need to check if cartridge is a executable
      if IsExecutableFile then
         CommandLine:= StringReplaceW(CommandLine, '-cart',
                                     '-run', [rfIgnoreCase]) // for executable files
      else
      begin
        if IsCARFile then
           Exit;
        // see "cart.txt" for the cart type indexes
        case TmpFileSize of
            8: CommandLine:= CommandLine+' -cart-type 1';  // Standard 8 KB cartridge
           16: CommandLine:= CommandLine+' -cart-type 2';  // Standard 16 KB cartridge
           32: CommandLine:= CommandLine+' -cart-type 12'; // XEGS 32 KB cartridge
           40: CommandLine:= CommandLine+' -cart-type 18'; // Bounty Bob Strikes Back 40 KB cartridge
           64: CommandLine:= CommandLine+' -cart-type 13'; // XEGS 64 KB cartridge
          128: CommandLine:= CommandLine+' -cart-type 14'; // XEGS 128 KB cartridge
          256: CommandLine:= CommandLine+' -cart-type 23'; // XEGS 256 KB cartridge
          512: CommandLine:= CommandLine+' -cart-type 24'; // XEGS 512 KB cartridge
         1024: CommandLine:= CommandLine+' -cart-type 25'; // XEGS 1 MB cartridge
            2: CommandLine:= CommandLine+' -cart-type 57';  // Standard 2 KB cartridge ... November 2013
            4: CommandLine:= CommandLine+' -cart-type 58';  // Standard 4 KB cartridge ... November 2013
        else
          Exit;
        end;
      end;
    end
    else
    if IsAltirra(ExtractFileName(EmulatorString)) then
       begin
         if IsExecutableFile or IsCARFile then
            Exit;
         // see "src\Altirra\source\cartridge.cpp" for the cart type indexes
         case TmpFileSize of
             8: CommandLine:= CommandLine+' /cartmapper 1';  // Standard 8 KB cartridge
            16: CommandLine:= CommandLine+' /cartmapper 2';  // Standard 16 KB cartridge
            32: CommandLine:= CommandLine+' /cartmapper 12'; // XEGS 32 KB cartridge
            40: CommandLine:= CommandLine+' /cartmapper 18'; // Bounty Bob Strikes Back 40 KB cartridge
            64: CommandLine:= CommandLine+' /cartmapper 13'; // XEGS 64 KB cartridge
           128: CommandLine:= CommandLine+' /cartmapper 14'; // XEGS 128 KB cartridge
           256: CommandLine:= CommandLine+' /cartmapper 23'; // XEGS 256 KB cartridge
           512: CommandLine:= CommandLine+' /cartmapper 24'; // XEGS 512 KB cartridge
          1024: CommandLine:= CommandLine+' /cartmapper 25'; // XEGS 1 MB cartridge
             2: CommandLine:= CommandLine+' /cartmapper 57';  // Standard 2 KB cartridge
             4: CommandLine:= CommandLine+' /cartmapper 58';  // Standard 4 KB cartridge
         else
           Exit;
         end;
       end
    else
    if IsAtariPlusPlus(ExtractFileName(EmulatorString)) then
    begin
      if IsExecutableFile then
      begin
        // need to get floppy parameters for Atari++ (executable files requires it)
        MemGameInfo.eCustomMediaType:= IsFloppy;
        EmuParameters:= '';
        // get floppy parameters and set CommandLine again
        Result:= GetExecParameters(EmulatorParameterIndexToUseCustom[MemGameInfo.eCustomSystemID, 1]);
        MemGameInfo.eCustomMediaType:= 1;
        CommandLine:= SystemStr+EmulatorString+SystemStr+WideFormat(' '+EmuParameters, [TempGameVars.eName]);
        Exit;
      end
      else
      begin
      tmpCartStr:= '';
      case TmpFileSize of
          2: tmpCartStr:= '-carttype 2k'; // Standard 2 KB cartridge ... November 2013
          4: tmpCartStr:= '-carttype 4k'; // Standard 4 KB cartridge ... November 2013
          8: tmpCartStr:= '-carttype 8k'; // Standard 8 KB cartridge
         16: Exit;//tmpCartStr:= '';  // Standard 16 KB cartridge
         40: tmpCartStr:= '-carttype bountybob'; // Bounty Bob Strikes Back 40 KB cartridge
      else
         tmpCartStr:= '-carttype xegs'; // XEGS 32 KB, 64 KB, 128 KB, 256KB, 512 KB, 1 MB cartridges
      end;
      CommandLine:= StringReplaceW(CommandLine, '-carttype 16k',
                                 tmpCartStr, [rfIgnoreCase]);
      Exit;
      end;
    end
    else
      Result:= False;
  end;

  function CheckAppleIIgs(sClearEntry: Boolean): Boolean;
  var
    emuFile: String;
  begin
    Result:= True;
    emuFile:= ExtractFileName(EmulatorString);
    if IsAppleIIGS(emuFile) then
       begin
         // Apple IIgs - will check if Kegs32 or GSport emulators are being used
         // if yes, will try to edit "config.kegs" or "config.txt"
         Result:= EditApple2GScfg(EmulatorString, TempGameVars.eName, nil, sClearEntry);
         if Result then
            CommandLine:= SystemStr+EmulatorString+SystemStr;
       end;
  end;

  function ResetAppleIIgs: Boolean;
  begin
    Result:= (MemGameInfo.eCustomSystemID = 53) and (MemGameInfo.eCustomMediaType = IsFloppy);
    if Result then
       CheckAppleIIgs(True);
  end;

  function ResetWinApeIni: Boolean;
  begin
    Result:= MemGameInfo.eCustomSystemID = 59;
    if Result then
       begin
         // restore WinAPE cartridge "OS ROM" in emulator config file
         if IsWinApeEmu then
            WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, WinApeCurrentROM, '', '', '');
       end;
  end;

  //function IsKEGAFusionEmu: Boolean;
  //begin
  //  Result:= SameText(ExtractFileName(EmulatorString), 'fusion.exe');
  //end;

  function GetGamesListVersion(sysID: Integer): String;
  var
    tmpFile: TMemIniFile;
  begin
    // for MAME software lists
    Result:= '-';
    if not FileExists(GetGamesFolderEL+GetSystemFileName(sysID)) then
       Exit;
    tmpFile:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));
    Result:= tmpFile.ReadString('info_file', 'version', '');
    FreeAndNil(tmpFile);
  end;
  
  procedure ResetToFrontend;
  begin
    ClearMemGameInfo(TempGameVars);
    FreeAndNil(ExtraParameters);
    FreeAndNil(ExtraDefaultParameters);
    ThousandSeparator:= Char(',');
    DecimalSeparator:= Char('.');
    SetCurrentDir(FrontendPath);
    FocusGamesList;
    Application.ProcessMessages;
  end;

begin
  if not ValidateSelectedGame then
     Exit;

  MultiFloppy:= CheckMultipleSelected(GamesListView);
  case MemGameInfo.eIsCustomGame of
    True : ErrorMsgTitle:= 'Error: Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';
    False: ErrorMsgTitle:= 'Error: Run Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';
  end;
  if (not MultiFloppy) and (MemGameInfo.eIsCustomGame) then
    begin // don't allow this for MAME software lists, only games from EmuCon are supported
      if Boolean(PlayWithAssociatedEmulator[MemGameInfo.eCustomSystemID]) then
         begin
           ExecuteGameAssociatedApp;
           Exit;
         end;
    end;

  EmulatorString:= '';
  EmuParameters:= '';

  case ValidateFile(GetEmuParametersFile) of
    True: ExtraParameters:= TMemIniFile.Create(GetEmuParametersFile);
    False:
      begin
        CallMessageBox;
        EnableMsgMediaTypeLabel(((MemGameInfo.eCustomMediaType = 2) and (EmulatorMountVirtualDrive[MemGameInfo.eCustomSystemID])));
        AddEmulatorHeader;
        AddMsgText('    File ');
        AddMsgText(GetEmuParametersFile, MsgTxtColors.colorFileName, [fsBold]);
        AddMsgText(' was not found! The frontend can''t function properly without it. Aborting...');
        GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
        Exit;
      end;
  end;

  if not GetEmulatorFile then
     begin
       CallMessageBox;
       EnableMsgMediaTypeLabel(((MemGameInfo.eCustomMediaType = 2) and (EmulatorMountVirtualDrive[MemGameInfo.eCustomSystemID])));
       if EmulatorString <> '' then
          begin
            AddEmulatorHeader;
            AddMsgText(EmulatorString+#13#10, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
            AddMsgText(#13#10+'    Emulator file not found! Please make sure the file exists or select another emulator before running games.');
          end
       else
          begin
            AddMsgText('    Emulator '+IntToStr(EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID])+
                       ' not selected. Please select one before running games. You can also try to run this game with MAME.');
          end;
       GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);

       ResetToFrontend;
       Exit;
     end;

  ExitCode:= 0; // all is well
  IsFileFound:= False;
  UseVirtualDrive:= False;
  TempGameVars.eName:= '';

  GameFileExt:= LowerCase(ExtractFileExtW(MemGameInfo.eName));

  IsViceFlipList:= False;
  IsJavaPSPEmu:= False;
  IsWinApeEmu:= False;

  IsBatchFile:= IsExeBatchFile(EmulatorString);
  //if IsBatchFile and MultiFloppy then
  //   begin
  //     txtString:= 'System: %s'+#13#10+'    Emulator '+IntToStr(EmulatorIndexToUse[MemGameInfo.eSystemID])+
  //                 ' is a batch file and there are multiple games selected.'+#13#10+#13#10+
  //                 'This is not supported by EmuCon. Aborting...';
  //     ShowMessageApp(ErrorMsgTitle,
  //                    MemGameInfo.eTitle+#13#10+#13#10+
  //                    Format(txtString, [SystemsList[MemGameInfo.eSystemID, 0]]));
  //     ResetToFrontend;
  //     Exit;
  //   end;

  if MemGameInfo.eCustomSystemID = 59 then
     begin
       // Amstrad CPC
       // need to get the default cartridge (BASIC cart required for floppy games)
       IsWinApeEmu:= IsWinApe(ExtractFileName(EmulatorString));
       if IsWinApeEmu then
          WinApeGetCartridgeFile(EmulatorString, WinApeCurrentROM);
     end;

  case MultiFloppy of
    True:
      begin
        if (MemGameInfo.eCustomSystemID in [39, 49, 56, 59]) then
           begin
             // for Commodore 64, 128, VIC-20, Amstrad CPC
             // the first floppy will be added directly to the command line (Commodore 64, 128, VIC-20 WinVice emulator)
             // I think I'll just do it all in the MountMultiFloppyCommandLine function anyway... like the other systems!!!
             TempGameVars.eName:= MemGameInfo.eName; // floppy disk
             IsFileFound:= SearchGameFile(MemGameInfo.eName, MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, ButtonImageCUE.Down, True, TempGameVars.eName);
             if not IsFileFound then
                begin
                  CallMessageBox;
                  EnableMsgMediaTypeLabel(False);
                  AddEmulatorHeader;
                  AddMsgText('    Game file ');
                  AddMsgText(MemGameInfo.eName, MsgTxtColors.colorFileName, [fsBold]);
                  AddMsgText(' was not found! The main floppy disk could not be located.');
                  if not GameFoldersFound(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType) then
                     AddMsgText(' Games folders are empty or not selected.');
                  AddMsgText(' Aborting...');
                  GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
                  ResetToFrontend;
                  Exit;
                end;
           end;

        if not MountMultiFloppyCommandLine2(MultiFloppyParameter) then
           begin
             ResetToFrontend;
             Exit;
           end;
        IsWinUAE:= SameText(ExtractFileName(EmulatorString), 'WinUAE.exe');
      end;
    False:
      begin
        TempGameVars.eName:= MemGameInfo.eName;
        case MemGameInfo.eCustomMediaType of
          2: // disc images
            begin
              UseVirtualDrive:= EmulatorMountVirtualDrive[MemGameInfo.eCustomSystemID];
              if UseVirtualDrive then
                 begin
                   ReadDaemonToolsSettings(True);
                   if not FileExistsW(VirtualDriveFile) then
                      begin
                        CallMessageBox;
                        EnableMsgMediaTypeLabel(UseVirtualDrive);
                        AddEmulatorHeader;
                        AddMsgText('    The virtual drive executable file could not be found '+
                                   'or hasn''t been selected yet. Please go to ');
                        AddMsgText('Emulator Setup', clBlack, [fsBold]);
                        AddMsgText(' screen to select a file.'+#13#10+#13#10+
                                   '    Officially supported virtual drive tools are:'+#13#10);
                        AddMsgText('Daemon Tools ', clBlack, [fsBold]);
                        AddMsgText('http://www.daemon-tools.cc', MsgTxtColors.colorFileName);
                        AddMsgText(#13#10+'Elby Virtual CloneDrive ', clBlack, [fsBold]);
                        AddMsgText('http://www.slysoft.com', MsgTxtColors.colorFileName);
                        AddMsgText(#13#10+'Alcohol 120% ', clBlack, [fsBold]);
                        AddMsgText('http://www.alcohol-soft.com', MsgTxtColors.colorFileName);
                        AddMsgText(#13#10+#13#10+'This feature is for disc images only. Aborting...');

                        GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);

                        ResetToFrontend;
                        Exit;
                      end;
                 end;
            end;
          4: // floppy disks
            begin
              // nothing to do here, handling is done at the end (do not remove this commented code)
              // if (MemGameInfo.eSystemID in [39, 49, 56]) and (MemGameInfo.eMediaType = IsFloppy) then
              //    begin
              //      if IsWinVice(ExtractFileName(EmulatorString)) then
              //         begin
              //           // for Commodore 64 / 128 / VIC-20
              //           // search for fliplist file, for floppy disks only (WinVICE emulator only)
              //           MemGameVariables.eGameFileName:= ChangeFileExt(MemGameVariables.eGameFileName, '.vfl');
              //           IsFileFound:= SearchGameFile(MemGameVariables.eGameFileName);
              //           if IsFileFound then
              //              IsViceFlipList:= True;
              //           MemGameVariables.eGameFileName:= MemGameInfo.eGameFileName;
              //         end;
              //    end;
            end;
        end;
        case MemGameInfo.eIsCustomGame of
          True:
            begin
              if UseVirtualDrive then
                 IsFileFound:= SearchGameFile(MemGameInfo.eName, MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, False, True, TempGameVars.eName)
              else
                 IsFileFound:= SearchGameFile(MemGameInfo.eName, MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, ButtonImageCUE.Down, True, TempGameVars.eName);
            end;
          False:
            begin
              TempGameVars.eName:= '';
              if GameHaveROMs(MemGameInfo.eHaveGameROMs) then
                 TempGameVars.eName:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID, MemGameInfo.eSoftwareName);
              IsFileFound:= TempGameVars.eName <> '';
            end;
        end;

        if not IsFileFound then
           begin
             CallMessageBox;
             EnableMsgMediaTypeLabel(UseVirtualDrive);
             AddEmulatorHeader;
             AddMsgText('    Game file ');
             AddMsgText(MemGameInfo.eName, MsgTxtColors.colorFileName, [fsBold]);
             AddMsgText(' was not found!');
             case MemGameInfo.eIsCustomGame of
               True:
                 begin
                   if not GameFoldersFound(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType) then
                      AddMsgText(' Games folders are empty or not selected.');
                 end;
               False:
                 begin
                   if not (Assigned(emuROMsFolders[MemGameInfo.eSystemID]) and (emuROMsFolders[MemGameInfo.eSystemID].Count > 0)) then
                      AddMsgText(' Games folders are empty or not selected.');
                 end;
             end;

             AddMsgText(' Aborting...');
             GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
             ResetToFrontend;
             Exit;
           end;
        // special cases...
        case MemGameInfo.eCustomSystemID of
          11: begin // GP32
                if LowerCase(ExtractFileName(EmulatorString)) = 'geepee32.exe' then
                   begin
                     // for GeePee32 emulator
                     if SameText(GameFileExt, '.gxb') then
                        TempGameVars.eName:= '/GXB='+TempGameVars.eName
                     else
                     if SameText(GameFileExt, '.fxe') then
                        TempGameVars.eName:= '/FXE='+TempGameVars.eName
                     else
                     if SameText(GameFileExt, '.smc') then
                        TempGameVars.eName:= '/SMC='+TempGameVars.eName
                     else
                        begin
                          CallMessageBox;
                          EnableMsgMediaTypeLabel(UseVirtualDrive);
                          AddEmulatorHeader;
                          AddMsgText('    File extension ');
                          AddMsgText(LowerCase(GameFileExt), MsgTxtColors.colorFileName, [fsBold]);
                          AddMsgText(' not supported. Valid file extensions are: ');
                          AddMsgText('.gxb', MsgTxtColors.colorFileName, [fsBold]);
                          AddMsgText('; ');
                          AddMsgText('.fxe', MsgTxtColors.colorFileName, [fsBold]);
                          AddMsgText('; ');
                          AddMsgText('.smc', MsgTxtColors.colorFileName, [fsBold]);
                          AddMsgText(#13#10+#13#10+'Aborting...');
                          GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
                          ResetToFrontend;
                          Exit;
                        end;
                   end;
              end;
        end;
      end;
  end;

  if FileExists(GetEmuParametersFile(True, True)) then
     ExtraDefaultParameters:= TMemIniFile.Create(GetEmuParametersFile(True, True));

  Continue:= GetExecParameters(EmulatorParameterIndexToUseCustom[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType], UseVirtualDrive);
  case Continue of
    True:
      begin
        if UseVirtualDrive then
           CommandLine:= SystemStr+EmulatorString+SystemStr+' '+EmuParameters
        else
           begin
             if MemGameInfo.eCustomSystemID in [39, 49, 56] then
                begin
                  // Commodore 64 / 128 / VIC-20
                  CommandLine:= SystemStr+EmulatorString+SystemStr+WideFormat(' '+EmuParameters, [TempGameVars.eName]);
                  if IsWinVice(ExtractFileName(EmulatorString)) then
                     begin
                       // for Commodore 64 and Commodore 128
                       // search for fliplist file, for floppy disks only (WinVICE emulator only)
                       TempGameVars.eName:= GetFolderFull(38)+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+'\'+
                                            ChangeFileExtW(ExtractFileNameW(MemGameInfo.eName), '.vfl'); // WinVICE flip list file
                       if FileExistsW(TempGameVars.eName) then
                          CommandLine:= CommandLine+WideFormat(WinViceFlipDisk, [TempGameVars.eName]);
                     end;
                end
             else
             case MultiFloppy of
               True:
                 begin
                   CommandLine:= SystemStr+EmulatorString+SystemStr+' '+EmuParameters;
                 end;
               False:
                 begin
                   case IsWinApeEmu of
                     True:
                       begin
                         // Amastrad CPC
                         if MemGameInfo.eCustomMediaType = IsFloppy then
                            CommandLine:= SystemStr+EmulatorString+SystemStr+Format(' '+EmuParameters, [TempGameVars.eName])
                         else
                            CommandLine:= SystemStr+EmulatorString+SystemStr; // cartridge and cassete do not need parameters
                       end;
                     False: CommandLine:= SystemStr+EmulatorString+SystemStr+WideFormat(' '+EmuParameters, [TempGameVars.eName]);
                   end;

                   GetROMTypeAtari800; // check if it's cartridge Atari 400 / 800 / XL and set cmdline (Atari800, Atari800Win, Atari++)

                   if MemGameInfo.eCustomSystemID = 44 then
                      begin
                        // Amiga: WinUAE and FS-UAE
                        if IsAmigaUAE(ExtractFileName(EmulatorString)) then
                           begin
                             if FindDiskCFG(nil, txtString) then
                                if (txtString <> '') and FileExistsW(txtString) then
                                   begin
                                     CommandLine:= SystemStr+EmulatorString+SystemStr+' '+SystemStr+txtString+SystemStr;
                                   end;
                           end;
                      end;
                   if (MemGameInfo.eCustomSystemID = 53) and (MemGameInfo.eCustomMediaType = IsFloppy) then
                      begin
                        // Apple IIGS - will check if "Kegs32" or "GSport" emulators are being used
                        // if yes, will try to edit "config.kegs" or "config.txt"
                        if not CheckAppleIIgs(False) then
                           begin
                             ResetToFrontend;
                             Exit;
                           end;
                      end;
                   if MemGameInfo.eCustomSystemID = 59 then
                      begin
                        // Amstrad CPC
                        if IsWinApeEmu then
                           begin
                             case MemGameInfo.eCustomMediaType of
                               1: WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, TempGameVars.eName, '', '', '');
                               4: WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, WinApeCurrentROM, TempGameVars.eName, '', '');
                               5: WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, WinApeCurrentROM, '', '', TempGameVars.eName);
                             end;
                           end;
                      end;
                 end;
             end;
           end;
      end;
    False:
      begin
        CallMessageBox;
        EnableMsgMediaTypeLabel(UseVirtualDrive);
        AddEmulatorHeader;
        AddMsgText(EmulatorString+#13#10, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
        AddMsgText(#13#10+'    No parameters were found. Please make sure the emulator parameter is not empty. '+
                   'Also check the selected parameter (1 or 2) in the main tool bar buttons.'+#13#10+#13#10+
                   'If the game is a disc image, check if the emulator requires or not a parameter to load the game.');
        GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
        ResetToFrontend;
        Exit;
      end;
  end;

  if IsBatchFile then
     CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;

  if UseVirtualDrive then
     begin
       MountImageStr:= WideFormat(SystemStr+VirtualDriveFile+SystemStr+' '+VirtualDriveMount, [TempGameVars.eName]);
       UnmountImageStr:= SystemStr+VirtualDriveFile+SystemStr+' '+VirtualDriveUnmount;
     end;
  if MultiFloppy then
     begin
       // replace entries for multi-floppy disks loading
       case MemGameInfo.eCustomSystemID of
         //39: CommandLine:= CommandLine+' '+MultiFloppyParameter; // Commodore64 "WinVICE" emulator only, not used anymore ? (February 27, 2018)
         44: // Amiga
           begin
             case IsWinUAE of
               True: CommandLine:= StringReplaceW(CommandLine, '-0 "%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // Amiga FS-UAE

               False: CommandLine:= StringReplaceW(CommandLine, '--floppy_drive_0="%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // Amiga FS-UAE
             end;
           end;
         48: // Atari 400/800/XL
           begin
             if IsAltirra(ExtractFileName(EmulatorString)) then
                begin
                  CommandLine:= StringReplaceW(CommandLine, '"%s"', MultiFloppyParameter, [rfIgnoreCase]); // Altirra
                end
             else
             if IsAtariPlusPlus(ExtractFileName(EmulatorString)) then
                CommandLine:= StringReplaceW(CommandLine, '"%s"', MultiFloppyParameter, [rfIgnoreCase]); // Altirra
           end;
         52: // Apple II
           begin
             case IsAppleWinEmu(ExtractFileName(EmulatorString)) of
               True : CommandLine:= StringReplaceW(CommandLine, '-d1 "%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // AppleWin
               False: CommandLine:= StringReplaceW(CommandLine, '-s6.d1 "%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // JACE: Java Apple Computer Emulator
             end;
           end;
         53: CommandLine:= SystemStr+EmulatorString+SystemStr; // Apple IIGS
         59: // Amstrad CPC
           begin
             if IsWinApeEmu then
                CommandLine:= Format(CommandLine, [TempGameVars.eName]);
           end;
       end;
     end;

  // for debugging only, do not enable
  //ShowMessageW(EmulatorString+#13#10+CommandLine+#13#10#13#10+TEasyGameInfo(SelectedItem).eTitle+#13#10+MemGameInfo.eTitle+#13#10+#13#10+
  //             GetShortFileNameW(MemGameVariables.eGameFileName));

  if MenuViewEmulatorFullCommandLine.Checked then
     begin
       txtString:= '';
       case MemGameInfo.eIsCustomGame of
         True : ErrorMsgTitle:= 'Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game: '+SystemsListCustom[MemGameInfo.eCustomSystemID, 0];
         False: ErrorMsgTitle:= 'Run Game: '+SystemsListCustom[MemGameInfo.eCustomSystemID, 0];
       end;
       CallMessageBox;
       case MemGameInfo.eIsCustomGame of
         True:
           begin
             EnableMsgMediaTypeLabel(UseVirtualDrive);
             TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
             AddMsgText(TempStr, MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
           end;
         False:
           begin
             ShowGameNameEntryMsgBox;
             AddMsgText('Games list   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

             AddMsgText(GetArcadeSystemIniSection(MemGameInfo.eSystemID)+' Software List   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(MemGameInfo.eCategory+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
           end;
       end;
       
       AddEmulatorHeader;
       FormMessageBox.ButtonYes.Caption:= 'Execute';
       FormMessageBox.ButtonNo.Caption:= 'Abort';

       if UseVirtualDrive then
          begin
            AddMsgText('Unmount Image From Virtual Drive'+#13#10, MsgTxtColors.colorKeyTitle, [], AlignEmuGameText);
            AddMsgText(UnmountImageStr+#13#10+#13#10, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
            AddMsgText('Mount Image On Virtual Drive'+#13#10, MsgTxtColors.colorKeyTitle, [], AlignEmuGameText);
            AddMsgText(MountImageStr+#13#10#13#10, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
            AddMsgText('Execute Emulator'+#13#10, MsgTxtColors.colorKeyTitle, [], AlignEmuGameText);
            AddMsgText(CommandLine+#13#10, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
            AddMsgText(#13#10+'Unmount Image From Virtual Drive'+#13#10, MsgTxtColors.colorKeyTitle, [], AlignEmuGameText);
            AddMsgText(UnmountImageStr, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
          end
       else
          begin
            AddMsgText(CommandLine, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
          end;

       Continue:= GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle,
                                  '', 1, False, -1, MemGameInfo.eGameSetStatus) = mrYes;

       if not Continue then
          begin
            ResetWinApeIni;
            ResetAppleIIGS;
            ResetToFrontend;
            Exit;
          end;
     end;

  iPlayTime:= GetTickCount;

  SetCurrentDir(ExtractFilePath(EmulatorString));

  if UseVirtualDrive then
     begin
       // unmount first to be sure no image is mounted in virtual drive
       RunProcess(UnmountImageStr, True, SW_SHOWNORMAL);
       Sleep(20); // give it some time for virtual drive to update its status (20 ms)
       RunProcess(MountImageStr, True, SW_SHOWNORMAL);
     end;

  IsRunningGame:= True;
  ExitCode:= RunProcess(CommandLine, True);
  IsRunningGame:= False;
  
  if UseVirtualDrive then
     RunProcess(UnmountImageStr, True, SW_SHOWNORMAL); // unmount image after exiting the emulator

  case MemGameInfo.eIsCustomGame of
    True : UpdatePlayedCustomGame(iPlayTime, SelectedEasyItem);
    False: UpdatePlayedGameArcade(iPlayTime, SelectedEasyItem);
  end;

  // restore config settings to current
  ResetWinApeIni;
  ResetAppleIIgs;

  if ExitCode <> 0 then
     begin
       //if IsKEGAFusionEmu then
       //   begin
            if (ExitCode = 1) and FormPreferences.IgnoreExitCode1InvalidFunction.Checked then
               begin
                 // "KEGA Fusion" emulator have a bug that returns error code 1 even when emu and game load without errors
                 ResetToFrontend;
                 Exit;
               end;
       //   end;

       CallMessageBox;
       case MemGameInfo.eIsCustomGame of
         True:
           begin
             EnableMsgMediaTypeLabel(UseVirtualDrive);
             TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
             AddMsgText(TempStr, MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
           end;
         False:
           begin
             ShowGameNameEntryMsgBox;
             AddMsgText('Games list   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');

             AddMsgText(GetArcadeSystemIniSection(MemGameInfo.eSystemID)+' Software List   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
             AddMsgText(MemGameInfo.eCategory+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
           end;
       end;
       AddEmulatorHeader;
       AddMsgText(#13#10+'Error '+IntToStr(ExitCode), MsgTxtColors.colorExitCode, [fsBold]);
       AddMsgText(': '+SysErrorMessage(ExitCode)+'.');
       // check this link for most common error messages:
       // http://www.febooti.com/products/automation-workshop/online-help/events/run-dos-cmd-command/exit-codes/
       if ExitCode = 2 then
          begin
            AddMsgText(#13#10);
            AddMsgText(#13#10+'Required files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, MsgTxtColors.colorWarning, [fsItalic], AlignEmuGameText);
          end;
       GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 2);
     end;

  ResetToFrontend;
end;

procedure TFormMain.ExecuteGameAssociatedApp;
var
  IsFileFound: Boolean;
  CommandLine, ErrorMsgTitle, AppTitle, AssociatedApp: String;
  iPlayTime: Cardinal;

  function AddEmulatorHeader: Boolean;
  begin
    AddMsgText('Associated Application   ', MsgTxtColors.colorKeyTitle, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
    AddMsgText(AppTitle+#13#10, MsgTxtColors.colorKeyValue, [fsBold], AlignEmuGameText, -1, 'Trebuchet MS');
    AddMsgText(#13#10);
  end;
  
  procedure ResetToFrontend;
  begin
    ClearMemGameInfo(TempGameVars);
    ThousandSeparator:= Char(',');
    DecimalSeparator:= Char('.');
    SetCurrentDir(FrontendPath);
    FocusGamesList;
  end;
  
begin
  if not ValidateSelectedGame then
     Exit;

  TempGameVars.eName:= MemGameInfo.eName;

  ErrorMsgTitle:= 'Error: Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';
  AssociatedApp:= GetAssociatedApp(ExtractFileExt(MemGameInfo.eName));
  if AssociatedApp = '' then
     begin
       AppTitle:= 'error';
       CallMessageBox;
       EnableMsgMediaTypeLabel(False, True);
       AddEmulatorHeader;
       AddMsgText('File extension');
       AddMsgText(WideLowerCase(ExtractFileExt(MemGameInfo.eName)), MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' is not associated with any application!'+#13#10+#13#10+
                  '    Please associate your games files in Windows with the emulator of your choice (unzipped only).'+
                   #13#10+#13#10+'    You can disable the');
       AddMsgText('Play With Associated Emulator', MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText('setting in games popup menu (mouse right-click).');
       GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
       ResetToFrontend;
       Exit;
     end;
  AppTitle:= GetAssociatedApp(ExtractFileExt(MemGameInfo.eName), True);
  if AppTitle <> '' then
     AppTitle:= GetFileInfoW(AppTitle, VersionInfo[2])
  else
     AppTitle:= AssociatedApp;

  IsFileFound:= SearchGameFile(MemGameInfo.eName, MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, ButtonImageCUE.Down, True, TempGameVars.eName);
  if not IsFileFound then
     begin
       CallMessageBox;
       FormMessageBox.ButtonYes.Caption:= 'Execute';
       FormMessageBox.ButtonNo.Caption:= 'Abort';
       EnableMsgMediaTypeLabel(False, True);
       AddEmulatorHeader;
       AddMsgText('    File ');
       AddMsgText(MemGameInfo.eName, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(' was not found! If game is located on a removable media, insert it and try again...'+#13#10+
                   'Folders list might also be blank. Select at least one folder to point the location of your games.');
       GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
       ResetToFrontend;
       Exit;
     end;

  CommandLine:= StringReplaceW(AssociatedApp, '%1', TempGameVars.eName, [rfIgnoreCase]);

  if MenuViewEmulatorFullCommandLine.Checked then
     begin
       ErrorMsgTitle:= 'Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';
       CallMessageBox;
       EnableMsgMediaTypeLabel(False, True);
       AddEmulatorHeader;
       AddMsgText('    You have chosen to run a game with the associated application.'+#13#10+
                  'The application executable was read from Windows registry.'+#13#10+#13#10);
       AddMsgText(CommandLine, MsgTxtColors.colorCmdLine, [], taLeftJustify, 10, 'Consolas');
       if GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 1) = mrNo then
          begin
            ResetToFrontend;
            Exit;
          end;
     end;

  //SetCurrentDir(ExtractFilePath(EmulatorString)); // set current path to emulator directory, not needed ? (February 27, 2018)

  iPlayTime:= GetTickCount;
  RunProcess(CommandLine, True);

  UpdatePlayedCustomGame(iPlayTime, SelectedEasyItem);
  
  ResetToFrontend;
end;

procedure TFormMain.UpdatePlayedCustomGame(GamePlayTime: Cardinal; ELV_ItemToUpdate: TEasyItem);
var
  iSectionPlayTime: Cardinal;
  PlayedList: THashedStringList;
  iStr, iFileStr: String;
  iPos: Integer;
begin
  iSectionPlayTime:= GetTickCount-GamePlayTime; // get total play time in milliseconds

  TEasyGameInfo(ELV_ItemToUpdate).ePlayed:= MemGameInfo.ePlayed+1;
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate:= DateTimeToFileDate(Now);
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText:= GetDateTimeStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate, True, FormPreferences.LastPlayedHideSeconds.Checked);

  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime+iSectionPlayTime;
  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText:= GetPlayTime(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime, True, FormPreferences.TotalPlayTimeHideSeconds.Checked);

  if SelectedEasyItem = ELV_ItemToUpdate then
     begin
       MemGameInfo.ePlayed:= TEasyGameInfo(ELV_ItemToUpdate).ePlayed;
       MemGameInfo.ePlayedDate:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate;
       MemGameInfo.ePlayedDateText:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText;

       MemGameInfo.eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime;
       MemGameInfo.eTotalPlaytimeText:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText;

     end;
  CheckAndCreateFolder(GetFolderFull(39));
  iFileStr:= GetCustomGamePlayedFile(TEasyGameInfo(ELV_ItemToUpdate).eCustomSystemID);

  PlayedList:= THashedStringList.Create;
  PlayedList.BeginUpdate;
  if MemGameInfo.eIsUnicode then
     iStr:= '<file>'+UTF8Encode(TEasyGameInfo(ELV_ItemToUpdate).eName)+'/>'
  else
     iStr:= '<file>'+TEasyGameInfo(ELV_ItemToUpdate).eName+'/>';

  //iStr:= iStr+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eCustomMediaType)+IntToStr(Ord(TEasyGameInfo(ELV_ItemToUpdate).eIsUnicode))+' ';
  if FileExists(iFileStr) then
     begin
       PlayedList.LoadFromFile(iFileStr);
       iPos:= GetPlayedGamePosIndex(PlayedList, iStr, TEasyGameInfo(ELV_ItemToUpdate).eCustomMediaType, TEasyGameInfo(ELV_ItemToUpdate).eIsUnicode, False);
       if iPos <> -1 then
          PlayedList.Delete(iPos);
     end;

  // <file> Game filename/> MediaType IsUnicode PlayedTimes;PlayedDate;TotalPlayTime

  // <file>Knife Edge - Nose Gunner (U) [!].zip/>10 1;1191539653;124020
  PlayedList.Insert(0, iStr+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eCustomMediaType)+IntToStr(Ord(TEasyGameInfo(ELV_ItemToUpdate).eIsUnicode))+' '+
                       IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayed)+';'+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate)+';'+
                       IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime));
  PlayedList.EndUpdate;
  PlayedList.SaveToFile(iFileStr);
  FreeAndNil(PlayedList);
end;

procedure TFormMain.UpdatePlayedGameArcade(GamePlayTime: Cardinal; ELV_ItemToUpdate: TEasyItem);
var
  PlayedList: THashedStringList;
  iSectionPlayTime: Cardinal;
  iGameName, iFileStr, StrToAdd: String;
  iPos: Integer;
begin
  iSectionPlayTime:= GetTickCount-GamePlayTime; // get total play time in milliseconds

  // edit the TEasyItem directly in case the user selected another game while the emulator is running (September 08, 2015)
  TEasyGameInfo(ELV_ItemToUpdate).ePlayed:= TEasyGameInfo(ELV_ItemToUpdate).ePlayed+1;
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate:= DateTimeToFileDate(Now);
  TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText:= GetDateTimeStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate, True, FormPreferences.LastPlayedHideSeconds.Checked);

  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime+iSectionPlayTime;
  TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText:= GetPlayTime(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime, True, FormPreferences.TotalPlayTimeHideSeconds.Checked);

  if SelectedEasyItem = ELV_ItemToUpdate then
     begin
       // update MemGameInfo vars with new info
       MemGameInfo.ePlayed:= TEasyGameInfo(ELV_ItemToUpdate).ePlayed;
       MemGameInfo.ePlayedDate:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate;
       MemGameInfo.ePlayedDateText:= TEasyGameInfo(ELV_ItemToUpdate).ePlayedDateText;

       MemGameInfo.eTotalPlaytime:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime;
       MemGameInfo.eTotalPlaytimeText:= TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytimeText;
     end;

  ForceDirectories(GetFolderFull(41)); // create "arcade\played_games\" folder if it doesn't exist
  iFileStr:= GetGamesPlayedIniFile(TEasyGameInfo(SelectedEasyItem).eSystemID);

  PlayedList:= THashedStringList.Create;
  PlayedList.BeginUpdate;

  iGameName:= GetPlayedGamesNameEntry(TEasyGameInfo(ELV_ItemToUpdate).eName, TEasyGameInfo(ELV_ItemToUpdate).eSoftwareName); // software_name\gamename

  if FileExists(iFileStr) then
     begin
       PlayedList.LoadFromFile(iFileStr);
       iPos:= PlayedList.IndexOfName(iGameName);
       if iPos <> -1 then
          PlayedList.Delete(iPos);
     end;

  StrToAdd:= IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayed)+';'+IntToStr(TEasyGameInfo(ELV_ItemToUpdate).ePlayedDate)+';'+
             IntToStr(TEasyGameInfo(ELV_ItemToUpdate).eTotalPlaytime);

  PlayedList.Insert(0, iGameName+'='+StrToAdd);

  PlayedList.EndUpdate;
  PlayedList.SaveToFile(iFileStr);
  FreeAndNil(PlayedList);

  if ELV_ItemToUpdate <> nil then
     TEasyGameInfo(ELV_ItemToUpdate).Invalidate(False);
end;

procedure TFormMain.ResetPlayGameInfo(ResetOptionTag: Integer);
var
  rItem: TEasyItem;
  iniArrayArcade: packed array[1..MaxArcadeSystems] of THashedStringList;
  iniArrayConsole: packed array[1..MaxConsoleComputerSystems] of THashedStringList;

  UpdateIniArcade: array[1..MaxArcadeSystems] of Boolean;
  UpdateIniConsole: array[1..MaxConsoleComputerSystems] of Boolean;

  pFileName, GameEntryStr: String;
  GameIndex, SelectionIndex: Integer;
  Continue: Boolean;
begin
  if not CheckSelected(GamesListView) then
     Exit;

  for GameIndex:= Low(UpdateIniArcade) to High(UpdateIniArcade) do
      UpdateIniArcade[GameIndex]:= False;

  for GameIndex:= Low(UpdateIniConsole) to High(UpdateIniConsole) do
      UpdateIniConsole[GameIndex]:= False;

  GamesListView.BeginUpdate;

  rItem:= GamesListView.Selection.First;
  SelectionIndex:= 1;
  repeat
    FillTempGameInfo(rItem);

    GameIndex:= -1;
    Continue:= False;
    if TempGameVars.eIsCustomGame then
    begin
      if not Assigned(iniArrayConsole[TempGameVars.eCustomSystemID]) then
         begin
           pFileName:= GetCustomGamePlayedFile(TempGameVars.eCustomSystemID);
           if FileExists(pFileName) then
           begin
             iniArrayConsole[TempGameVars.eCustomSystemID]:= THashedStringList.Create;
             iniArrayConsole[TempGameVars.eCustomSystemID].LoadFromFile(pFileName);
             iniArrayConsole[TempGameVars.eCustomSystemID].BeginUpdate;
             Continue:= True;
           end;
         end;

      if Continue then
      begin
        if MemGameInfo.eIsUnicode then
           GameEntryStr:= '<file>'+UTF8Encode(TempGameVars.eName)+'/>'
        else
           GameEntryStr:= '<file>'+TempGameVars.eName+'/>';

        //GameEntryStr:= GameEntryStr+IntToStr(TempGameVars.eCustomMediaType)+IntToStr(Ord(TempGameVars.eIsUnicode))+' ';
        GameIndex:= GetPlayedGamePosIndex(iniArrayConsole[TempGameVars.eCustomSystemID], GameEntryStr, TempGameVars.eCustomMediaType, TempGameVars.eIsUnicode, False);
      end;
    end
    else
    begin
      if not Assigned(iniArrayArcade[TempGameVars.eSystemID]) then
         begin
           pFileName:= GetGamesPlayedIniFile(TempGameVars.eSystemID);
           if FileExists(pFileName) then
           begin
             iniArrayArcade[TempGameVars.eSystemID]:= THashedStringList.Create;
             iniArrayArcade[TempGameVars.eSystemID].LoadFromFile(pFileName);
             iniArrayArcade[TempGameVars.eSystemID].BeginUpdate;
             Continue:= True;
           end;
         end;

      if Continue then
      begin
        GameEntryStr:= GetPlayedGamesNameEntry(TempGameVars.eName, TempGameVars.eSoftwareName); // software_name\gamename
        GameIndex:= iniArrayArcade[TempGameVars.eSystemID].IndexOfName(GameEntryStr);
      end;
    end;

    if GameIndex <> -1 then
    begin
      // 0 -> reset all
      // 1 -> reset total play time
      // 2 -> reset last played
      // 3 -> reset times played

      if ResetOptionTag in [0, 1] then
         begin
           TEasyGameInfo(rItem).eTotalPlaytime:= 0;
           TEasyGameInfo(rItem).eTotalPlaytimeText:= '';
         end;

      if ResetOptionTag in [0, 2] then
         begin
           TEasyGameInfo(rItem).ePlayedDate:= 0;
           TEasyGameInfo(rItem).ePlayedDateText:= '';
         end;

      if ResetOptionTag in [0, 3] then
         begin
           TEasyGameInfo(rItem).ePlayed:= 0;
         end;

      if TempGameVars.eIsCustomGame then
         begin
           if ResetOptionTag = 0 then
              iniArrayConsole[TempGameVars.eCustomSystemID].Delete(GameIndex)
           else
              iniArrayConsole[TempGameVars.eCustomSystemID].Strings[GameIndex]:=
                       GameEntryStr+//IntToStr(TEasyGameInfo(rItem).eCustomMediaType)+IntToStr(Ord(TEasyGameInfo(rItem).eIsUnicode))+' '+
                                    IntToStr(TEasyGameInfo(rItem).ePlayed)+';'+IntToStr(TEasyGameInfo(rItem).ePlayedDate)+';'+
                                    IntToStr(TEasyGameInfo(rItem).eTotalPlaytime);

           UpdateIniConsole[TempGameVars.eCustomSystemID]:= True;
           TEasyGameInfo(rItem).Invalidate(False);
         end
      else
         begin
           if ResetOptionTag = 0 then
              iniArrayArcade[TempGameVars.eSystemID].Delete(GameIndex)
           else
              iniArrayArcade[TempGameVars.eSystemID].Strings[GameIndex]:=
                       GameEntryStr+'='+IntToStr(TEasyGameInfo(rItem).ePlayed)+';'+IntToStr(TEasyGameInfo(rItem).ePlayedDate)+';'+
                                        IntToStr(TEasyGameInfo(rItem).eTotalPlaytime);

           UpdateIniArcade[TempGameVars.eSystemID]:= True;
           TEasyGameInfo(rItem).Invalidate(False);
         end;
    end;
       
    rItem:= ELV_GetNextSelected(GamesListView, rItem, SelectionIndex);
    Application.ProcessMessages;

  until rItem = nil;

  GamesListView.EndUpdate(False);
  ClearMemGameInfo(TempGameVars);

  // check all updated lists and save their files
  for GameIndex:= Low(UpdateIniArcade) to High(UpdateIniArcade) do
  begin
    if UpdateIniArcade[GameIndex] then
       begin
         iniArrayArcade[GameIndex].EndUpdate;
         pFileName:= GetGamesPlayedIniFile(GameIndex);
         iniArrayArcade[GameIndex].SaveToFile(pFileName);
         FreeAndNil(iniArrayArcade[GameIndex]);
       end;
  end;

  for GameIndex:= Low(UpdateIniConsole) to High(UpdateIniConsole) do
  begin
    if UpdateIniConsole[GameIndex] then
       begin
         iniArrayConsole[GameIndex].EndUpdate;
         pFileName:= GetCustomGamePlayedFile(GameIndex);
         iniArrayConsole[GameIndex].SaveToFile(pFileName);
         FreeAndNil(iniArrayConsole[GameIndex]);
       end;
  end;
end;

function TFormMain.EditApple2GScfg(const emuFile, gameFile: String; GameFilesList: TStringList; ClearEntry: Boolean): Boolean;
var
  sFolder, cfgFile: String;
  sFile: THashedStringList;
  Index, IndexDisk1, Loop: Integer;
  SlotDrive7: array[1..11] of String;
  MultiDisks: Boolean;

  function GetSlotPos(const SlotIndex: Integer): Integer;
  var
    LoopIdx: Integer;
    tmpStr: String;
  begin
    Result:= -1;
    for LoopIdx:=0 to sFile.Count-1 do
    begin
      tmpStr:= 's7d'+IntToStr(SlotIndex);
      if Pos(tmpStr+' =', sFile[LoopIdx]) <> 0 then
         begin
           Result:= LoopIdx;
           Break;
         end
      else
      if Pos(tmpStr+'=', sFile[LoopIdx]) <> 0 then
         begin
           Result:= LoopIdx;
           Break;
         end;
    end;
  end;

begin
  sFolder:= ExtractFileName(emuFile);
  Result:= IsAppleIIGS(sFolder);
  if not Result then
     Exit;
  sFolder:= ExtractFilePath(emuFile);
  cfgFile:= 'config.kegs';
  Result:= FileExists(sFolder+cfgFile);
  if not Result then
     begin
       cfgFile:= 'config.txt';
       Result:= FileExists(sFolder+cfgFile);
       if not Result then
          begin
            CallMessageBox;
            EnableMsgMediaTypeLabel(False);
            AddEmulatorHeader(emuFile);
            AddMsgText('    The emulator config file was not found. ');
            AddMsgText('KEGS32', clBlack, [fsBold]);
            AddMsgText(' and ');
            AddMsgText('GSport', clBlack, [fsBold]);
            AddMsgtext(' emulators do not support loading disks from the command line. Disk file names '+
                       'must be added manually in the config file.'+#13#10+#13#10+
                       '    Please make sure file ');
            AddMsgText('config.kegs', MsgTxtColors.colorFileName, [fsBold]);
            AddMsgtext(' exist for ');
            AddMsgText('KEGS32', clBlack, [fsBold]);
            AddMsgtext(' emulator or ');
            AddMsgText('config.txt', MsgTxtColors.colorFileName, [fsBold]);
            AddMsgtext(' exist for ');
            AddMsgText('GSport', clBlack, [fsBold]);
            AddMsgtext(' emulator.'+#13#10+#13#10+'Aborting...');

            GenerateMessage('Warning! Load Floppy Game on Apple IIGS', MemGameInfo.eTitle);

            Exit;
          end;
     end;
  for Index:=Low(SlotDrive7) to High(SlotDrive7) do
      SlotDrive7[Index]:= '';
  MultiDisks:= GameFilesList <> nil;

  sFile:= THashedStringList.Create;
  sFile.LoadFromFile(sFolder+cfgFile);
  Result:= True;
  
  if ClearEntry then
     begin
       sFile.BeginUpdate;
       Index:= GetSlotPos(1);
       sFile[Index]:= 's7d1 =';
       for Loop:= 2 to High(SlotDrive7) do
       begin
         Index:= GetSlotPos(Loop);
         if Index <> -1 then
            sFile.Delete(Index);
       end;
       sFile.EndUpdate;
       sFile.SaveToFile(sFolder+cfgFile);
       FreeAndNil(sFile);
       Exit;
     end;
     
  if MultiDisks then
     begin
       for Index:= 0 to GameFilesList.Count-1 do
       begin
         if Index > 10 then
            Break;
         SlotDrive7[Index+1]:= GameFilesList[Index];
       end;
     end
  else
     begin
       SlotDrive7[1]:= gameFile;
     end;

  sFile.BeginUpdate;
  for Loop:=Low(SlotDrive7) to High(SlotDrive7) do
  begin
    if Loop = 1 then
       begin
         IndexDisk1:= GetSlotPos(1);
         Index:= IndexDisk1+1;
         sFile[IndexDisk1]:= 's7d1 = '+SlotDrive7[1];
       end
    else
       begin
         if SlotDrive7[Loop] <> '' then
            begin
              IndexDisk1:= GetSlotPos(Loop);
              if IndexDisk1 = -1 then
                 sFile.Insert(Index, 's7d'+IntToStr(Loop)+' = '+SlotDrive7[Loop])
              else
                 sFile[IndexDisk1]:= 's7d'+IntToStr(Loop)+' = '+SlotDrive7[Loop];
              Inc(Index);
            end;
       end;
  end;
  sFile.EndUpdate;
  sFile.SaveToFile(sFolder+cfgFile);
  FreeAndNil(sFile);
end;

function TFormMain.FindDiskCFG(MenuItemHolder: TMenuItem; out cfgFileFullPathVar: WideString): Boolean; //(const sysID: Integer; GameFileName: String): Boolean;
var
  emuFile, FileExt: String;
  cfgFile: WideString;
begin
  cfgFileFullPathVar:= '';
  Result:= CheckSelected(GamesListView);
  if not Result then
     Exit;
  Result:= MemGameInfo.eCustomSystemID in [39, 49, 56, 44];

  emuFile:= ExtractFileName(EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]);
  FileExt:= '';
  case MemGameInfo.eCustomSystemID of
    39, 49, 56: // Commodore 64 / 128 / VIC-20
      begin
        Result:= MemGameInfo.eCustomMediaType = IsFloppy;// 4; // flip
        if not Result then
           Exit;
        Result:= IsWinVice(emuFile);
        if not Result then
           Exit;
        cfgFile:= GetFolderFull(38)+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+'\'+
                  ChangeFileExt(MemGameInfo.eName, '.vfl'); // WinVice flip list file
        Result:= FileExists(cfgFile);
        if not Result then
           Exit;
        cfgFileFullPathVar:= cfgFile;
        if MenuItemHolder <> nil then
           begin
             MenuItemHolder.Caption:= 'Edit Flip List File with notepad.exe';
             MenuItemHolder.Hint:= '.vfl'; // WinVice flip list file

           end;
      end;
    44: // Amiga
      begin
        Result:= IsAmigaUAE(emuFile);
        if not Result then
           Exit;

        cfgFile:= FormMain.GetFolderFull(38)+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+'\'+
                  MemGameInfo.eName;

        if SameText('FS-UAE.exe', emuFile) then
           FileExt:= '.fs-uae'
        else
           FileExt:= '.uae';

        cfgFile:= ChangeFileExtW(cfgFile, FileExt);
        Result:= FileExistsW(cfgFile);
        if not Result then
           Exit;
        cfgFileFullPathVar:= cfgFile;
        if MenuItemHolder <> nil then
           begin
             MenuItemHolder.Caption:= 'Edit Game Config File with notepad.exe';
             MenuItemHolder.Hint:= FileExt; // WinVice flip list file
           end;
      end;
  end;
end;

function CompareDescending(List: TStringList; Index1, Index2: Integer): Integer;
begin
  // it must use natural sorting to sort filenames correctly, instead of "1, 2, 11, 20"
  Result:= NaturalCompareText(List[Index2], List[Index1]);
end;

