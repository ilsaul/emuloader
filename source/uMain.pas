// this function should not be needed here as this is a job for EmuCon frontend
procedure TFormMain.UpdateEmuConPlayedGamesTags;
var
  sysLoop, Loop: Integer;
  TempStr, NewValue, PlayedFileName: String;
  tIniFile: THashedStringList;
  UpdateFile: Boolean;
begin
  for sysLoop:=1 to MaxConsoleComputerSystems do
  begin
    PlayedFileName:= GetCustomGamePlayedFile(sysLoop);
    if ValidateFile(PlayedFileName) then
    begin
      UpdateFile:= False;
      tIniFile:= THashedStringList.Create;
      tIniFile.LoadFromFile(PlayedFileName);
      if PosEx('<file>', tIniFile[0]) = 0 then // only update the file if is old format
      begin
        for Loop:=tIniFile.Count-1 downto 0 do
        begin
          NewValue:= '';
          TempStr:= tIniFile[Loop];
          if TempStr <> '' then
          begin
            NewValue:= StringReplace(TempStr, '<game>', '<file>', [rfIgnoreCase]);
            if not SameText(NewValue, TempStr) then
               begin
                 UpdateFile:= True;
                 tIniFile[Loop]:= NewValue;
               end;
          end;
        end;
        if UpdateFile then
           tIniFile.SaveToFile(PlayedFileName);
      end;
      FreeAndNil(tIniFile);
    end;
  end;
  Application.ProcessMessages;
end;

procedure TFormMain.UpdateTimesPlayedIni;
var
  Loop: Integer;
  oldFile: String;
  playedTxtFile: THashedStringList;
  TempIni: TMemIniFile;
  DestFolderCreated: Boolean;
begin
  oldFile:= GetIniFilesFolder+'games_played.ini';
  if not ValidateFile(oldFile) then
     Exit;

  DestFolderCreated:= False;
  FormStatus.MessageStr('Generating new files for played arcade games.');
  TempIni:= TMemIniFile.Create(oldFile);
  playedTxtFile:= THashedStringList.Create;
  for Loop:= 1 to MaxArcadeSystems do
  begin
    if not FileExists(GetGamesPlayedIniFile(Loop)) then
       begin
         // only creates the file is it doesn't exist
         TempIni.ReadSectionValues(GetArcadeSystemIniSection(Loop), playedTxtFile);
         if playedTxtFile.Count > 0 then
            begin
              if not DestFolderCreated then
                 begin
                   ForceDirectories(GetFolderFull(41));
                   DestFolderCreated:= True;
                 end;
              playedTxtFile.SaveToFile(GetGamesPlayedIniFile(Loop));
            end;
         playedTxtFile.Clear;
       end;
  end;

  FreeAndNil(playedTxtFile);
  FreeAndNil(TempIni);

  DeleteFile(oldFile);
  Application.ProcessMessages;
end;

procedure TFormMain.UpdateMAMEsnapDir(const dirString: String; SystemID: ShortInt);
var
  MAMEIniFile: THashedStringList;
  IniFile, PathString: String;
  Loop: Integer;
begin
  // this is used by "Image Category Settings" screen only (August 07, 2016)
  if not ValidateArcadeEmulatorFile(SystemID) then
     Exit;
  iniFile:= GetArcadeEmuIniFileName(SystemID, EmulatorFile[SystemID]);
  if not FileExists(iniFile) then
     Exit;
  if CheckReadOnly(iniFile) then
     Exit;
  if dirString <> '' then
     PathString:= dirString
  else
     PathString:= 'snap';
  MAMEIniFile:= THashedStringList.Create;
  MAMEIniFile.LoadFromFile(iniFile);
  for Loop:=0 to MAMEIniFile.Count -1 do
  begin
    if Copy(MAMEIniFile[Loop], 1, 19) = ImageCategoryArray[1, 4]+' ' then // 'snapshot_directory ' then
       begin
         MAMEIniFile.Strings[Loop]:= Format('%-25s %s', ['snapshot_directory', ExcludeTrailingPathDelimiter(PathString)]);
         MAMEIniFile.SaveToFile(iniFile);
         Break;
       end;
  end;
  FreeAndNil(MAMEIniFile);
end;

function TFormMain.DialogSaveFile(FilterType: ShortInt; const DialogTitle: String; InitialFileName: String = ''; DefaultDirectory: String = ''): String;
var
  FilterStr, DefaultExtension, FileStr:String;
begin
  Result:= '';
  case FilterType of
    0: FilterStr:= 'MAME Input Files (*.inp)|*.inp';
    1: FilterStr:= 'MAME Save State Files (*.sta)|*.sta';
    2: FilterStr:= 'Data Files (*.dat; *.el)|*.dat; *.el';
    3: FilterStr:= 'Initialization Files (*.ini)|*.ini';
    4: FilterStr:= 'Text Files (*.txt)|*.txt';
    5: FilterStr:= 'All Files (*.*)|*.*';
  end;
  case FilterType of
    0: DefaultExtension:= 'inp';
    1: DefaultExtension:= 'sta';
    2: DefaultExtension:= '';
    3: DefaultExtension:= 'ini';
    4: DefaultExtension:= 'txt';
    5: DefaultExtension:= '';
  end;
  FileStr:= InitialFileName;
  if DefaultDirectory <> '' then
     DefaultDirectory:= IncludeTrailingPathDelimiter(DefaultDirectory); // last backlash is required to show desired folder correctly
  if OpenSaveFileDialog(self, DefaultExtension, FilterStr, DefaultDirectory, DialogTitle, FileStr, False, False, True, False) then
     Result:= FileStr;

  SetCurrentDir(FrontendPath);
end;

