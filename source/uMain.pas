function TFormMain.ValidateIniFilesDir(sysID: ShortInt; const windowCaption: String; IsAlterMAME: Boolean = False): Boolean;
var
  menuStr: String;
begin
  if IsAlterMAME then
     Result:= AlterMAMEIniFilesDir <> ''
  else
     Result:= IniFilesDir[sysID] <> '';
     
  menuStr:= 'Default Settings';
  if IsAlterMAME then
     menuStr:= 'AlterMAME '+menuStr
  else
     menuStr:= menuStr+' / "'+GetEmulatorDescription(sysID);
  if not Result then
     GenerateMessage('Error: Set Custom Options', windowCaption, '    The ini folder is not selected! '+
                     'Please go to main menu "'+menuStr+
                     '" and make sure that a valid folder is set.', 2);
end;

function TFormMain.GetGameStatusText(StatusIndex: ShortInt; romID: Integer): String;
begin
  // 0 - have; 1 - missing ROMs/CHDs; 2 - missing (no .zip files found)
  case StatusIndex of
    0: Result:= 'Available';
    1: Result:= 'Missing ROMs/CHDs';
    2: Result:= 'Not Available';
  else
       Result:= 'Unknown';
  end;
end;

procedure TFormMain.SetCustomOptions(GameName: String; Driver: Boolean; IsAlterMAME: Boolean = False);
var
  iniFile: String;
  iVersion: Integer;

  function CreateFull: Boolean;
  begin
    if not Assigned(FormMAMESettings) then
       FormMAMESettings:= TFormMAMESettings.Create(nil);
  end;

  function CreateBasic: Boolean;
  begin
    if not Assigned(FormMAMESettings_SimpleMode) then
       FormMAMESettings_SimpleMode:= TFormMAMESettings_SimpleMode.Create(nil);
    FormMAMESettings_SimpleMode.BuildNumber:= iVersion;
  end;
  
  function SetFileID(NumberID: ShortInt; TitleStr: String): String;
  begin
    //IniFilesArray[1]:= 'debug.ini';
    //IniFilesArray[2]:= 'vertical.ini';
    //IniFilesArray[3]:= 'horizont.ini';
    //IniFilesArray[4]:= 'arcade.ini';
    //IniFilesArray[5]:= 'console.ini';
    //IniFilesArray[6]:= 'computer.ini';
    //IniFilesArray[7]:= ''; //othersys.ini // systype_ini ??????
    //IniFilesArray[8]:= 'vector.ini';
    //IniFilesArray[9]:= ''; // source\sourcefile.ini or sourcefile.ini // source_ini
    //IniFilesArray[10]:= ''; // biosname.ini   // grandparent_ini
    //IniFilesArray[11]:= ''; // parentgame.ini // parent_ini (if current game is clone)
    //IniFilesArray[12]:= ''; // gamename.ini   // driver_ini

    if Assigned(FormMAMESettings) then
       FormMAMESettings.ActiveFileID:= NumberID
    else
    if Assigned(FormMAMESettings_SimpleMode) then
       FormMAMESettings_SimpleMode.ActiveFileID:= NumberID;

    Result:= TitleStr;
  end;

  function SetFormCaption: String;
  begin
    Result:= 'Settings: ';//+GameName;
    if Assigned(FormMAMESettings) then
       FormMAMESettings.SystemIcon.Tag:= 1
    else
    if Assigned(FormMAMESettings_SimpleMode) then
       FormMAMESettings_SimpleMode.SystemIcon.Tag:= 1;

    if Driver then
       Result:= SetFileID(9, 'Driver '+Result)
    else
    if SameText('horizont', GameName) then
       begin
         Result:= SetFileID(3, 'Horizontal Game '+Result);
         //Result:= 'Horizontal Game '+Result;
         //SetFileID(3);
       end
    else
    if SameText('vertical', GameName) then
       begin
         Result:= SetFileID(2, 'Vertical Game '+Result);
         //Result:= 'Vertical Game '+Result;
         //SetFileID(2);
       end
    else
    if SameText('vector', GameName) then
       begin
         Result:= SetFileID(8, 'Vector Game '+Result);
         //Result:= 'Vector Game '+Result;
         //SetFileID(8);
       end
    else
    if SameText('debug', GameName) then
       begin
         Result:= SetFileID(1, 'Debug '+Result);
         //Result:= 'Debug '+Result;
         //SetFileID(2);
       end
    else
    if SameText('arcade', GameName) then
       Result:= SetFileID(4, 'Arcade Game '+Result)
       //Result:= 'Arcade Game '+Result
    else
    if FormMain.IsROM_Bios(MemGameInfo.eROMIdentification) then
       begin
         Result:= SetFileID(10, 'Bios '+Result);
         //Result:= 'Bios '+Result;
         if Assigned(FormMAMESettings) then
            FormMAMESettings.SystemIcon.Tag:= 0
         else
         if Assigned(FormMAMESettings_SimpleMode) then
            FormMAMESettings_SimpleMode.SystemIcon.Tag:= 0;
       end
    else
       begin
         case GameIsClone(MemGameInfo.eClone) of
           True : Result:= SetFileID(12, 'Game '+Result); // clone game
           False: Result:= SetFileID(11, 'Game '+Result); // parent game
         end;
         //Result:= 'Game '+Result;
         if Assigned(FormMAMESettings) then
            FormMAMESettings.SystemIcon.Tag:= 0
         else
         if Assigned(FormMAMESettings_SimpleMode) then
            FormMAMESettings_SimpleMode.SystemIcon.Tag:= 0;
       end;
  end;

begin
  Screen.Cursor:= crHourGlass;
  case IsMAMEBasedSys(MemGameInfo.eSystemID) of
    True:
      begin
        if not ValidateIniFilesDir(MemGameInfo.eSystemID, SetFormCaption, IsAlterMAME) then
           begin
             Screen.Cursor:= crDefault;
             Exit;
           end;
        if IsAlterMAME then
           iniFile:= GetEmuIniFileName(MemGameInfo.eSystemID, AlterMAMEFile)
        else
           iniFile:= GetEmuIniFileName(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID]);
           
        if not FileExists(iniFile) then
           begin
             if IsAlterMAME then
                begin
                  CreateMAMEIniFile(AlterMAMEFile);
                  LoadFolders_MAME(MemGameInfo.eSystemID, True);
                end
             else
                begin
                  CreateMAMEIniFile(EmulatorFile[MemGameInfo.eSystemID]);
                  LoadFolders_MAME(MemGameInfo.eSystemID);
                end;
             if IsAlterMAME then
                iniFile:= GetEmuIniFileName(MemGameInfo.eSystemID, AlterMAMEFile)
             else
                iniFile:= GetEmuIniFileName(MemGameInfo.eSystemID, EmulatorFile[MemGameInfo.eSystemID]);
           end;
        if MemGameInfo.eSystemID = idMAME then
           begin
             iVersion:= GetMAMEBuild(IsAlterMAME);
             if (iVersion > 124) or (iVersion = -1) then
                CreateFull
             else
                CreateBasic;
           end
        else
           CreateFull;
        //if not Assigned(FormMAMESettings) then
        //   FormMAMESettings:= TFormMAMESettings.Create(nil);

        if Assigned(FormMAMESettings) then
           begin
             FormMAMESettings.sysID:= MemGameInfo.eSystemID;
             FormMAMESettings.Tag:= 1; // means custom options
             FormMAMESettings.IsAlterMAME:= IsAlterMAME;
             FormMAMESettings.ActiveFileID:= -1; // means that no custom settings ID was set!
             FormMAMESettings.Caption:= SetFormCaption;
             if IsAlterMAME then
                FormMAMESettings.GameIni:= AlterMAMEIniFilesDir
             else
                FormMAMESettings.GameIni:= IniFilesDir[MemGameInfo.eSystemID];
             if MemGameInfo.eSoftwareName <> '' then
                FormMAMESettings.GameIni:= FormMAMESettings.GameIni+MemGameInfo.eSoftwareName+'\';
             FormMAMESettings.GameIni:= FormMAMESettings.GameIni+GameName+'.ini';
             if Driver then
                begin
                  // driver custom settings is for MAME/HBMAME only
                  if not FileExists(FormMAMESettings.GameIni) then
                     begin
                       if IsAlterMAME then
                          FormMAMESettings.GameIni:= AlterMAMEIniFilesDir
                       else
                          FormMAMESettings.GameIni:= IniFilesDir[MemGameInfo.eSystemID];
                       FormMAMESettings.GameIni:= FormMAMESettings.GameIni+'source\'+GameName+'.ini';
                     end;
                end;
             FormMAMESettings.emuIni:= iniFile;
             //FormMAMESettings.LabelReadFileIni.Caption:= FormMAMESettings.GameIni;
             FormMAMESettings.Caption:= FormMAMESettings.Caption+FormMAMESettings.GameIni;
             FormMAMESettings.ShowModal;
             FreeAndNil(FormMAMESettings);
           end
        else
        if Assigned(FormMAMESettings_SimpleMode) then
           begin
             FormMAMESettings_SimpleMode.sysID:= MemGameInfo.eSystemID;
             FormMAMESettings_SimpleMode.Tag:= 1; // means custom options
             FormMAMESettings_SimpleMode.IsAlterMAME:= IsAlterMAME;
             FormMAMESettings_SimpleMode.ActiveFileID:= -1; // means that no custom settings ID was set!
             FormMAMESettings_SimpleMode.Caption:= SetFormCaption;
             if IsAlterMAME then
                FormMAMESettings_SimpleMode.GameIni:= AlterMAMEIniFilesDir
             else
                FormMAMESettings_SimpleMode.GameIni:= IniFilesDir[MemGameInfo.eSystemID];
             FormMAMESettings_SimpleMode.GameIni:= FormMAMESettings_SimpleMode.GameIni+GameName+'.ini';
             if Driver then
                begin
                  // driver custom settings is for MAME/HBMAME only
                  if not FileExists(FormMAMESettings_SimpleMode.GameIni) then
                     begin
                       if (MemGameInfo.eSystemID <> idMAME) or ((MemGameInfo.eSystemID = idMAME) and (iVersion > 118)) then
                          begin
                            if IsAlterMAME then
                               FormMAMESettings_SimpleMode.GameIni:= AlterMAMEIniFilesDir
                            else
                               FormMAMESettings_SimpleMode.GameIni:= IniFilesDir[MemGameInfo.eSystemID];
                            FormMAMESettings_SimpleMode.GameIni:= FormMAMESettings_SimpleMode.GameIni+'source\'+GameName+'.ini';
                          end;
                     end;
                end;
             FormMAMESettings_SimpleMode.emuIni:= iniFile;
             //FormMAMESettings_SimpleMode.LabelReadFileIni.Caption:= FormMAMESettings.GameIni;
             FormMAMESettings_SimpleMode.Caption:= FormMAMESettings_SimpleMode.Caption+FormMAMESettings_SimpleMode.GameIni;
             FormMAMESettings_SimpleMode.ShowModal;
             FreeAndNil(FormMAMESettings_SimpleMode);
           end;

        LoadFolders_MAME(MemGameInfo.eSystemID);
        if MemGameInfo.eSystemID = idMAME then
           LoadFolders_MAME(MemGameInfo.eSystemID, True);
      end;
    False:
      begin
        case MemGameInfo.eSystemID of
          idSupermodel: // Supermodel: SEGA Model 3
            begin
               if not Assigned(FormSupermodelSettings) then
                 FormSupermodelSettings:= TFormSupermodelSettings.Create(nil);
              FormSupermodelSettings.Tag:= 1; // means custom options
              iniFile:= GetFolderEmulatorIni(MemGameInfo.eSystemID)+FormMain.GetEmuIniFileName(MemGameInfo.eSystemID);
              FormSupermodelSettings.Caption:= SetFormCaption;
              FormSupermodelSettings.emuIni:= iniFile;
              FormSupermodelSettings.GameIni:= GetFolderEmulatorIni(MemGameInfo.eSystemID)+GameName+'.ini';
              FormSupermodelSettings.LabelReadFileIni.Caption:= FormSupermodelSettings.GameIni;
              FormSupermodelSettings.ShowModal;
              FreeAndNil(FormSupermodelSettings);
              LoadFoldersArcade2(MemGameInfo.eSystemID);
            end;
          idZiNc: // ZiNc
            begin
              if not Assigned(FormZiNcSettings) then
                 FormZiNcSettings:= TFormZiNcSettings.Create(nil);
              FormZiNcSettings.Tag:= 1; // means custom options
              iniFile:= GetEmuIniFileName(MemGameInfo.eSystemID);
              FormZiNcSettings.Caption:= SetFormCaption;
              FormZiNcSettings.emuIni:= iniFile;
              FormZiNcSettings.GameIni:= GetFolderEmulatorIni(MemGameInfo.eSystemID)+GameName+'.cfg';
              FormZiNcSettings.LabelReadFileIni.Caption:= FormZiNcSettings.GameIni;
              FormZiNcSettings.ShowModal;
              FreeAndNil(FormZiNcSettings);
              LoadFoldersArcade2(MemGameInfo.eSystemID);
            end;
        end;
      end;
  end;
  SetCurrentDir(FrontendPath);
end;

procedure TFormMain.DeleteCustomOptions(GameName: String; Driver: Boolean; IsAlterMAME: Boolean = False);
var
  iniFile: String;
begin
  case IsMAMEBasedSys(MemGameInfo.eSystemID) of
    True:
      begin
        if IsAlterMAME then
           iniFile:= AlterMAMEIniFilesDir
        else
           iniFile:= IniFilesDir[MemGameInfo.eSystemID];
        if MemGameInfo.eSoftwareName <> '' then
           iniFile:= iniFile+MemGameInfo.eSoftwareName+'\';
        iniFile:= iniFile+GameName+'.ini';
        if Driver then
           begin
             // driver custom settings if for MAME/HBMAME only
             if not FileExists(iniFile) then
                begin
                  if IsAlterMAME then
                     iniFile:= AlterMAMEIniFilesDir
                  else
                     iniFile:= IniFilesDir[MemGameInfo.eSystemID];
                  iniFile:= iniFile+'source\'+GameName+'.ini'; // MAME based
                end;
           end;
      end;
    False:
      begin
        if MemGameInfo.eSystemID in [idSupermodel, idZiNc] then
           begin
             iniFile:= GetFolderEmulatorIni(MemGameInfo.eSystemID)+GameName;
             if MemGameInfo.eSystemID = idZiNc then
                iniFile:= iniFile+'.cfg' // ZiNc
             else
                iniFile:= iniFile+'.ini'; // Supermodel: SEGA Model 3
           end;
      end;
  end;
  if FileExists(iniFile) then
     begin
       CallMessageBox;
       AddMsgText('    Are you sure you want to delete ');
       AddMsgText(iniFile, $00a65300, [fsBold]);
       AddMsgText(' file ? Recycle bin is not supported. Click No to abort.');
       if GenerateMessage('Delete File', 'Delete custom settings file.', '', 1, False, 2) = mrYes then
          DeleteFile(iniFile);
     end;
end;

function TFormMain.SetColumnsMemList(IniFileName: TMemIniFile; IsMachinesSidePanel: Boolean = False): Boolean;
var
  Loop: Integer;
  ColPos: Integer;
begin
  SetLength(ColumnsPosList, Length(aColumnsWidth));
  Result:= Length(ColumnsPosList) > 0;
  if not Result then
     begin
       GenerateMessage('Error', 'Columns Profile'+#13#10+'Failed to initialize columns positions array.',
                       '    Could not load the columns array into memory. Aborting...', 2, False, 1);
       Exit;
     end;
  //case iColumnIndex of
  //  00: Result:= 0;  // title
  //  01: Result:= 1;  // year
  //  02: Result:= 2;  // manufacturer
  //  06: Result:= 3;  // category
  //  23: Result:= 4;  // usage tip
  //  17: Result:= 5;  // times played
  //  21: Result:= 6;  // last played date/time
  //  22: Result:= 7;  // total playtime
  //  08: Result:= 8;  // game name
  //  09: Result:= 9;  // clone of
  //  12: Result:= 10; // driver status
  //  13: Result:= 11; // emulation status
  //  20: Result:= 12; // game size
  //  19: Result:= 13; // game set status
  //end;

  ColumnsPosList[0]:= 0;
  if IsMachinesSidePanel then
  begin
    // set default positions in the temp array...
    for Loop:=1 to GamesListView.Header.Columns.Count-1 do
    begin
      ColPos:= -1;
      if IsValidSoftwareListColumn(Loop) then
         ColPos:= GetSoftwareListDefaultColumnPos(Loop);
      if ColPos <> -1 then
         ColumnsPosList[ColPos]:= Loop;
    end;
  end;
  //!error... need to get positions correctly!!!!!!!!!
  for Loop:=1 to Length(ColumnsPosList)-1 do
  begin
    case IsMachinesSidePanel of
      True:
        begin
          //if IsValidSoftwareListColumn(Loop) then
             begin
               ColPos:= IniFileName.ReadInteger('Position_SoftwareList', aColumns[Loop, 0], -1);//GetSoftwareListDefaultColumnPos(Loop));
               if ColPos <> -1 then
                  ColumnsPosList[ColPos]:= Loop;
             end;
        end;
      False:
        begin
          ColPos:= IniFileName.ReadInteger('Position', aColumns[Loop, 0], Loop);
          if ColPos >= GamesListView.Header.Columns.Count then
             begin
               Result:= False;
               Break;
             end
          else
             ColumnsPosList[ColPos]:= Loop;
        end;
    end;

  end;
  if not Result then
     begin
       // column index out of range... need to restore default settings
       for Loop:=1 to Length(ColumnsPosList)-1 do
           ColumnsPosList[Loop]:= Loop;
       Result:= True;
     end;
end;

procedure TFormMain.ReadColumnProfile;
var
  Loop: Byte;
  columnFile: TMemIniFile;
  iSortDirection: Integer;
begin
  if not FileExists(GetColumnProfile) then
     Exit;
  try
    columnFile:= TMemIniFile.Create(GetColumnProfile);
    if not SetColumnsMemList(columnFile) then
       begin
         FreeAndNil(columnFile);
         Exit;
       end;
    GamesListView.BeginUpdate;

    for Loop:=0 to GamesListView.Header.Columns.Count-1 do
        GamesListView.Header.Columns[Loop].Width:= columnFile.ReadInteger('Width', aColumns[Loop, 0], aColumnsWidth[Loop]);

    for Loop:= 1 to GamesListView.Header.Columns.Count-1 do
        GamesListView.Header.Columns[Loop].Visible:= Boolean(columnFile.ReadInteger('Visible', aColumns[Loop, 0], 1));

    for Loop:= 1 to GamesListView.Header.Columns.Count-1 do
    begin
      if GamesListView.Header.Columns[ColumnsPosList[Loop]].Position <> Loop then
         GamesListView.Header.Columns[ColumnsPosList[Loop]].Position:= Loop;
    end;

    GamesListView.Header.Columns[LastColumnSorted].SortDirection:= esdNone; // reset current sort column
    LastColumnSorted:= columnFile.ReadInteger('Sort', 'ColumnIndex', 0);
    iSortDirection:= columnFile.ReadInteger('Sort', 'Direction', 0);
    LastColumnSortDirection:= TEasySortDirection(iSortDirection+1); // +1 for EasyListview!!!
    GamesListView.Header.Columns[LastColumnSorted].SortDirection:= LastColumnSortDirection;

    GamesListView.EndUpdate;
  finally
    for Loop:=0 to Length(ColumnsPosList) do
        Finalize(ColumnsPosList);
    FreeAndNil(columnFile);
  end;
end;

procedure TFormMain.UpdateColumnProfile;
var
  columnFile: TMemIniFile;
  gColumn: TEasyColumn;
begin
  if CheckReadOnly(GetColumnProfile) then
     Exit;
  if IsStartup then
     Exit;
  if PanelMachinesList.Visible then
     Exit; // do not update columns profile if machines list side panel is enabled!!!

  columnFile:= TMemIniFile.Create(GetColumnProfile);
  columnFile.EraseSection('Position');
  columnFile.EraseSection('Width');
  columnFile.EraseSection('Visible');
  columnFile.EraseSection('Sort');
  
  gColumn:= GamesListView.Header.FirstColumn;
  repeat
    if gColumn.Index <> 0 then
       begin
         if gColumn.Position <> gColumn.Index then
            columnFile.WriteInteger('Position', aColumns[gColumn.Index, 0], gColumn.Position);
       end;
    if gColumn.Width <> aColumnsWidth[gColumn.Index] then
       columnFile.WriteInteger('Width', aColumns[gColumn.Index, 0], gColumn.Width);

    if not gColumn.Visible then
       columnFile.WriteInteger('Visible', aColumns[gColumn.Index, 0], 0);
       
    gColumn:= GamesListView.Header.NextColumn(gColumn);
  until gColumn = nil;

  if (LastColumnSorted = 0) and (LastColumnSortDirection = esdAscending) then
     begin
       // do nothing...
       //if not EmptyFile then
       //   columnFile.EraseSection('Sort');
     end
  else
     begin
       columnFile.WriteInteger('Sort', 'ColumnIndex', LastColumnSorted);
       columnFile.WriteInteger('Sort', 'Direction',
                               Ord(GamesListView.Header.Columns[LastColumnSorted].SortDirection = esdDescending)); // 0 -> Ascending; 1 -> Descending
     end;

  columnFile.UpdateFile;
  FreeAndNil(columnFile);
end;

// procedures to load icons into TImageList
procedure TFormMain.SetIcon(SourceHolder, Source2Holder, DestHolder: TImageList; SourceIndex, DestIndex: Integer);
var
  FileIcon: TIcon; // this was defined in "private" section, but this is the only place this var is used!!!!!
  iImageList: TImageList;
begin
  iImageList:= SourceHolder;
  if Source2Holder <> nil then
     begin
       if SourceHolder.Height = DestHolder.Height then
          iImageList:= SourceHolder
       else
          iImageList:= Source2Holder;
     end;
     
  if iImageList.Height = {SourceHolder.Height = }DestHolder.Height then
     begin
       FileIcon:= TIcon.Create;
       FileIcon.Width:= SourceHolder.Width;
       FileIcon.Height:= SourceHolder.Height;
       FileIcon.Transparent:= True;
       iImageList{SourceHolder}.GetIcon(SourceIndex, FileIcon);
       if not FileIcon.Empty then
          DestHolder.ReplaceIcon(DestIndex, FileIcon);
       FreeAndNil(FileIcon);
     end
  else
     GenerateMessage('Error', 'Set ImageList Icon. Size mismatch.',
                     '    Icon size of source imagelist and destination imagelist are not the same!'+#13#10+
                     'Source: '+iImageList{SourceHolder}.Name+#13#10+'Destination: '+DestHolder.Name, 2, False, 1);
end;

