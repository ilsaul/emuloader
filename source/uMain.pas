procedure TFormMain.InitializeEmulatorVariables;
var
  Loop, Loop2: Integer;
begin
  // define values for all arrays or exception error will occur...
  try
    for Loop:= 1 to MaxArcadeSystems do
    begin
      IniFilesDir[Loop]:= '';
      EmulatorFile[Loop]:= '';
      EmulatorVersion[Loop]:= '';
      EmulatorDateTime[Loop]:= -1;

      emuROMsFolders[Loop]:= nil;
      VideoPreviewDir[Loop]:= '';
    end;
    buildMAME:= '';
    buildAlterMAME:= '';
    AlterMAMEIniFilesDir:= '';
    AlterMAMEDateTime:= -1;
    ArtworksDir[1]:= nil; // MAME
    ArtworksDir[0]:= nil; // HBMAME
    InputDir[1]:= ''; // MAME
    InputDir[0]:= ''; // HBMAME
    SamplesDir[1]:= nil; // MAME
    SamplesDir[0]:= nil; // HBMAME

    for Loop:=1 to MaxArcadeSystems do
    begin
      for Loop2:=0 to High(imgFolder[1]) do
          imgFolder[Loop, Loop2]:= '';
    end;
    for Loop:=Low(ImageScr) to High(ImageScr) do
        ImageScr[Loop]:= nil;
    ImagePnl:= nil;
    for Loop:=Low(SplitterImg) to High(SplitterImg) do
        SplitterImg[Loop]:= nil;
    for Loop:=Low(ImageDetails) to High(ImageDetails) do
    begin
      ImageDetails[Loop].SystemID:= -1;
      //ImageDetails[Loop].SystemType:= 0; // always reset to arcade
      ImageDetails[Loop].ImageCategoryIndex:= -1;
      ImageDetails[Loop].NoImageLoaded:= False;
      ImageDetails[Loop].PrevNoImageLoaded:= False;
      ImageDetails[Loop].IsZipped:= False;
    end;
    for Loop:=Low(UnZipActive) to High(UnZipActive) do
        UnZipActive[Loop]:= False;
    MAMu_Folder:= '';
    for Loop:=Low(FilterSys) to High(FilterSys) do
        FilterSys[Loop]:= True;
  except
    GenerateMessage('Startup', 'Failed to initialize emulator variables.',
                    '    One or more memory variables could not be initialized '+
                    '(uMain.InitializeEmulatorVariables).', 2, False, 1);
  end;
end;

