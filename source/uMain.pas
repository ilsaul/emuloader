procedure TFormMain.GetValidMAMESoftLists(ListSource: THashedStringList; ProcessExcludedList: Boolean; sysID: Integer = idMAME);
var
  Loop: Integer;
begin
  GetFilesList(GetGamesFolderEL(1, sysID), '.el', '*.el', ListSource, False, False, False); // get all files
  if ListSource.Count = 0 then
     Exit;

  ListSource.BeginUpdate;
  for Loop:=0 to ListSource.Count-1 do
      ListSource[Loop]:= ChangeFileExt(ListSource[Loop], '');
  ListSource.EndUpdate;

  if ProcessExcludedList then
     SoftListRemoveExcludedList(sysID, ListSource);
end;

function TFormMain.ScanSoftListGames(RefreshMode: Integer; IsCreatingGames: Boolean; sysID: ShortInt; SoftwareListsToProcess: THashedStringList = nil): Integer;
var
  iLoop, iCount, ChangedGamesCount: Integer;
  SoftListFiles: THashedStringList;
  RemoveSoftLists: Boolean;
begin
  // get all software list files
  Result:= 0;
  ChangedGamesCount:= 0;
  SoftListFiles:= THashedStringList.Create;
  RemoveSoftLists:= Assigned(SoftwareListsToProcess);
  if RemovesoftLists then
     SoftListFiles.AddStrings(SoftwareListsToProcess) // get a pre-built software list; this is only assigned when creating games lists
  else
  begin
    GetValidMAMESoftLists(SoftListFiles, True, sysID);

    //GetFilesList(GetGamesFolderEL(1, sysID), '.el', '*.el', SoftListFiles, False, False, False); // get all files
    //iCount:= SoftListFiles.Count;
    //if iCount > 0 then
    //begin
    //  SoftListFiles.BeginUpdate;
    //  for iLoop:=0 to iCount-1 do
    //      SoftListfiles[iLoop]:= ChangeFileExt(SoftListFiles[iLoop], '');
    //  SoftListFiles.EndUpdate;
    //
    //  SoftListRemoveExcludedList(sysID, SoftListFiles);
    //  //if MenuCreateMAMESoftwareListGames.Tag = 1 then // update mode, must remove exclude list and remove software lists with same CRC32
    //  //   begin
    //  //     SoftListValidateListsXML(sysID, SoftListfiles); // no need to do this here as this is either a clean install or all softlists must be processed (March 29, 2018)
    //  //   end;
    //end;
  end;

  iCount:= SoftListFiles.Count;
  if iCount > 0 then
     begin
       FormStatus.LabelMessage.Caption:= '';
       if not FormStatus.Visible then
          begin
            FormStatus.Show;
            FormStatus.StartThreadClock;
          end;
       SetLabelSoftwareScanCountVisible(True);
       GamesListView.BeginUpdate;
       for iLoop:=0 to iCount-1 do
       begin;
         FormStatus.LabelSoftwareScanCount.Caption:= Format(FormStatus.LabelSoftwareScanCount.Hint, [iLoop+1, iCount]);
         ChangedGamesCount:= CallScanGames(RefreshMode, IsCreatingGames, sysID, SoftListFiles[iLoop], True);
         Inc(Result, ChangedGamesCount);
       end;
       GamesListView.EndUpdate(False);
       SetLabelSoftwareScanCountVisible(False);
     end;
  FreeAndNil(SoftListFiles);
end;

procedure TFormMain.PopupScanAllGamesClick(Sender: TObject);
var
  Item: TEasyItem;
  Loop, iItemIndex, sysID: Integer;
  SysStr: String;
  ChangedGames: Boolean;
  //SysToAudit: array[1..MaxArcadeSystems] of Integer; // improvement for the future ? (March 22, 2018)

  function AllowScan(sysID: ShortInt; IsSoftwareList: Boolean): Boolean;
  begin
    Result:= True;
    // if sysID = idMAME then
    if IsMAMEBasedSys(sysID) then
       begin
         // 0 -> scan all; 1 -> arcade/machines only; 2 -> software list games only
         if IsSoftwareList then
         begin
           if MenuCreateMAMESoftwareListGames.HelpContext = 1 then
              Result:= False;
         end
         else
         begin
           if MenuCreateMAMESoftwareListGames.HelpContext = 2 then
              Result:= False;
         end;
       end;
  end;

begin
  ChangedGames:= False;
  if TMenuItem(Sender).Tag in [3, 5] then
     begin
       // 3 -> selected games using scan mode selected
       // 5 -> force all available, must change scan mode for it and restore after the scan is complete
       if TMenuItem(Sender).Tag = 5 then
          begin
            PopupSelectScanGamesMode.HelpContext:= PopupSelectScanGamesMode.Tag;
            PopupSelectScanGamesMode.Tag:= 2; // force all available
          end;
       if CheckMultipleSelected(GamesListView) then
          begin
            // Scan Selected (Multiple)
            // no need to select system. The system for the first selected game
            // will be used... all other systems will be ignored
            Item:= GamesListView.Selection.First;
            if Item = nil then
               Exit;
            sysID:= TEasyGameInfo(Item).eSystemID;
            SysStr:= TEasyGameInfo(Item).eSoftwareName;
            iItemIndex:= 1;
            repeat
              Item:= ELV_GetNextSelected(GamesListView, Item, iItemIndex);
              //Item:= GamesListView.Selection.First;
            until (Item = nil) or (TEasyGameInfo(Item).eSystemID <> sysID) or (TEasyGameInfo(Item).eSoftwareName <> SysStr);
            if Item <> nil then
               if (TEasyGameInfo(Item).eSystemID <> sysID) or (TEasyGameInfo(Item).eSoftwareName <> SysStr) then
               begin
                 if SysStr = '' then
                    SysStr:= GetArcadeSystemShortTitle(sysID)
                 else
                    SysStr:= GetArcadeSystemShortTitle(sysID)+' (software list: '+SysStr+')';

                 CallMessageBox;
                 AddMsgText('    There are games from multiple systems selected. Only ');
                 AddMsgText(SysStr, MsgTxtColors.colorFileName, [fsBold]);
                 AddMsgText(' sets will be processed.'+#13#10+'Do you want to continue ?');
                 if GenerateMessage('Info', 'Scan Selected Games', '', 1, False, 2) = mrNo then
                    Exit;
               end;
            Item:= GamesListView.Selection.First;
            if CallScanGames(5, False, TEasyGameInfo(Item).eSystemID, TEasyGameInfo(Item).eSoftwareName) > 0 then
               ChangedGames:= True;
          end
       else
          begin
            // single scan
            if not ValidateSelectedGame then
               begin
                 GenerateMessage('Error', 'Scan selected game failed.', 'Failed to parse game info details into memory.'+#13#10+
                                 'Select another game and try again. Aborting...', 2, False, 1);
                 Exit;
               end;
            CallScanGames(3, False, MemGameInfo.eSystemID, MemGameInfo.eSoftwareName);
            UpdateStatusBarGame;
          end;
       if (TMenuItem(Sender).Tag = 5) and (PopupSelectScanGamesMode.HelpContext <> -1) then
          begin
            PopupSelectScanGamesMode.Tag:= PopupSelectScanGamesMode.HelpContext;
            PopupSelectScanGamesMode.HelpContext:= -1;
          end;
     end
  else
     begin
       if TMenuItem(Sender).Tag = 4 then
          Loop:= CallSelectArcadeSystem(5) // scan games with missing ROMs only... see "ActionModeStr" var in uSelectSystem.pas // shouldn't this be #7 ???
       else
          Loop:= CallSelectArcadeSystem(4); // all other scan options

       if Loop = -1 then
          Exit; // user hit cancel button

       MAMu_CloseZipArchives;
       if Loop <= MaxArcadeSystems then
          begin
            if AllowScan(Loop, False) then // AllowScan() function is for MAME/HBMAME only
            begin
              if Loop = idMAME then
                 GamesListView.BeginUpdate;
              if CallScanGames(TMenuItem(Sender).Tag, False, Loop, '', (Loop = idMAME)) > 0 then //; // single system
                 ChangedGames:= True;
              if Loop = idMAME then
                 GamesListView.EndUpdate(False);
            end;

            if IsMAMEBasedSys(Loop) then
            begin
              if AllowScan(Loop, True) then
              begin
                if ScanSoftListGames(TMenuItem(Sender).Tag, False, Loop) > 0 then // no need for a softwarename list since all softlists must be processed (user is only auditing games)
                   ChangedGames:= True;
              end;
            end;
          end
       else
          begin
            // multiple systems selected
            SysStr:= IntToStr(Loop);
            for Loop:=1 to Length(SysStr) do
            begin
              if AllowScan(Loop, False) then
              begin
                if CallScanGames(TMenuItem(Sender).Tag, False, StrToInt(SysStr[Loop]), '', True) > 0 then
                   ChangedGames:= True;
              end;
              if IsMAMEBasedSys(Loop) then
              begin
                if AllowScan(Loop, True) then
                begin
                  if ScanSoftListGames(TMenuItem(Sender).Tag, False, Loop) > 0 then // no need for a softwarename list since all softlists must be processed (user is only auditing games)
                     ChangedGames:= True;
                end;
              end;
            end;
          end;
       FormStatus.Close;
       // restore fixed scan mode as user had selected "for this task only" option
       if PopupSelectScanGamesMode.HelpContext <> -1 then
          PopupSelectScanGamesMode.Tag:= PopupSelectScanGamesMode.HelpContext
       else
          SetScanModePopupHint(PopupSelectScanGamesMode.Tag);
       PopupSelectScanGamesMode.HelpContext:= -1; // set to null so next time sys selection screen loads the default scan mode
     end;
  if PopupScanGames.HelpContext <> -1 then
     begin
       // restore "Scan MAME Sets" setting since "For This Task Only" was checked
       MenuCreateMAMESoftwareListGames.HelpContext:= PopupScanGames.HelpContext;
       PopupScanGames.HelpContext:= -1;
     end;

  if ChangedGames then
     SetGameType(False);
  FocusGamesList;
end;

