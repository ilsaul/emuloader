              DeviceSysID:= TempGameVars.eSystemID;
            end;
       end;
    Result:= DeviceSets <> nil;
    if not Result then
       Exit;

    DeviceSets.ReadSection(TempGameVars.eName, DeviceSetsTemp);
    Result:= DeviceSetsTemp.Count > 0;
  end;

