  if ELV_Source.PaintInfoItem.CheckType = ectNone then
     begin
       if ELV_Item.Ghosted then
          CanvasDestination.Font.Color:= clMedGray;
     end
  else
     begin
       case ELV_Item.Tag of
         0: // available system
           begin
