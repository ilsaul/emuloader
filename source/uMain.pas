function TFormMain.FixMAMENVRAMFileType(const FileName: String): Integer;
var
  FileStr, FileExt: String;
begin
  // 0 -> CFG
  // 1 -> NVRAM
  // 2 -> EEPROM
  // 3 -> SRAM
  // 4 -> FLASH
  Result:= 1;
  FileExt:= LowerCase(ExtractFileExt(FileName));
  if FileExt = '.nv' then
     Exit; // for old MAME builds
  FileStr:= LowerCase(ExtractFileName(FileName));
  if PosEx('eeprom', FileStr) > 0 then
     Result:= 2
  else
  if (PosEx('sram', Filestr) > 0) or (PosEx('saveram', FileStr) > 0) then
     Result:= 3
  else
  if PosEx('flash', FileStr) > 0 then
     Result:= 4;
end;

function TFormMain.GetFileTypeText(sysID, MediaType, FileType: ShortInt): String;
begin
  case MediaType of
    -1: // for config files
      begin
        case FileType of
          0:
            begin
              if sysID <> idSegaModel2 then
                 Result:= '  Config File [.cfg]'
              else
                 Result:= '  Input File [.input]';
            end;
          1:
            begin
              if sysID <> idSegaModel2 then
                 Result:= '  Non-Volatile RAM'
              else
                 Result:= '  Non-Volatile Data [.dat]'; // for SEGA Model 2 emu

              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [NVRAM]' // MAME, HBMAME; .nv -> old NVRAM file; misc -> sub-folder!
              else
              if sysID in [idSupermodel, idDemul] then // 4, 6] then
                 Result:= Result+' [.nv]'; // Supermodel: SEGA Model 3
            end;
          2:
            begin
              Result:= '  Electrically Erasable Programmable Read-Only Memory';
              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [EEPROM]'
              else
              if sysID = idDemul then //4
                 Result:= Result+' [.eeprom]'; // for Demul
            end;
          3:
            begin
              Result:= '  Static Random Access Memory';
              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [SRAM]' // MAME, HBMAME
              else
              if sysID = idDemul then //4
                 Result:= Result+' [.sram]'; // for Demul
            end;
          4:
            begin
              Result:= '  Non-Volative Memory Storage';
              if IsMAMEBasedSys(sysID) then
                 Result:= Result+' [FLASH]'
              else
              if sysID = idDemul then //4
                 Result:= Result+' [.flash]'; // for Demul
            end;
        end;
      end;
    0:
      begin
        if SystemUseSevenZip(sysID) then
           Result:= '  Game ROMs [.zip / .7z]'
        else
           Result:= '  Game ROMs [.zip]';
      end;
    1: Result:= '  Compressed Hunks of Data [.chd]';
  end;
end;

procedure TFormMain.GetCanvasFont(gGameSetStatus: ShortInt; gDriverStatus: ShortInt; const gCloneOf: String; const CanvasHolder: TCanvas; CheckHaveMissFilter: Boolean = False);

  function CheckGameSet: Boolean;
  begin
    Result:= gGameSetStatus = 1;
    if (Result and CheckHaveMissFilter) then
       Result:= ButtonGameFilterHaveMiss.Tag <> 3;
  end;

begin
  if CheckGameSet then
     begin
       if gDriverStatus = 2 then
          CanvasHolder.Font:= Font_MissingROMsPreliminary
       else
          CanvasHolder.Font:= Font_MissingROMs;
     end
  else
  case gDriverStatus of
    2: CanvasHolder.Font:= Font_Preliminary;
  else
    case GameIsClone(gCloneOf) of
      True : CanvasHolder.Font:= Font_Clone;
      False: CanvasHolder.Font:= Font_Parent;
    end;
  end;
end;

procedure TFormMain.GetCanvasFontCustom(gGameSetStatus: ShortInt; gDriverStatus: ShortInt; const gCloneOf: String;
                                        CanvasHolder: TCanvas; CheckHaveMissFilter: Boolean = False);
var
  tmpFont: TFont;

  function CheckGameSet: Boolean;
  begin
    Result:= gGameSetStatus = 1;
    if (Result and CheckHaveMissFilter) then
       Result:= ButtonGameFilterHaveMiss.Tag <> 3;
  end;

begin
  tmpFont:= TFont.Create;
  if CheckGameSet then
     SetDefaultFont(tmpFont, 3)
  else
  case gDriverStatus of
    2: SetDefaultFont(tmpFont, 2)
  else
    SetDefaultFont(tmpFont, Ord(GameIsClone(gCloneOf)));
  end;
  CanvasHolder.Font:= tmpFont;
  FreeAndNil(tmpFont);
  //tmpFont.Free;
end;

