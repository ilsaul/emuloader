procedure TFormMain.PopupMenuGamesListPopup(Sender: TObject);
var
  GameDriver, GameSystem, strDriver, strDriverAlt{, MachineNameStr}: String;
  MultiSelected, IsMAMEAvailable: Boolean;
  selCount, iLoop, iVersion, iVersionAlt: Integer;

  function GetSelectedCount(MenuHolder: TMenuItem): Boolean;
  begin
    Result:= True;
    MenuHolder.Caption:= Format(MenuHolder.Hint, [selCount]);
  end;

  function ToggleOptions(const FileName: String; PopupSetName, PopupDeleteName: TMenuItem; IsAlterMAME: Boolean = False): Boolean;
  var
    softFolderStr: String;
  begin
    PopupSetName.Enabled:= True;
    if not PopupSetName.Visible then
       PopupSetName.Visible:= True;
    if not PopupDeleteName.Visible then
       PopupDeleteName.Visible:= True;
    case IsMAMEBasedSys(MemGameInfo.eSystemID) of
       True:
         begin
           softFolderStr:= '';
           if MemGameInfo.eSoftwareName <> '' then
              softFolderStr:= MemGameInfo.eSoftwareName+'\';
           case IsAlterMAME of
             True : PopupDeleteName.Visible:= FileExists(AlterMAMEIniFilesDir+softFolderStr+FileName);
             False: PopupDeleteName.Visible:= FileExists(IniFilesDir[MemGameInfo.eSystemID]+softFolderStr+FileName);
           end;
         end;
       False:
         begin
           if MemGameInfo.eSystemID in [idSupermodel, idZiNc] then
              PopupDeleteName.Visible:= FileExists(GetFolderArcadeEmulatorIni(MemGameInfo.eSystemID)+FileName);
         end;
    end;
    //if not PopupDeleteName.Visible then
    //   PopupDeleteName.Visible:= True;
    Result:= PopupDeleteName.Visible;
  end;

  function ToggleOptionsMAME(PopupSetName, PopupDeleteName: TMenuItem; IsAlterMAME: Boolean = False): Boolean;
  begin
    Result:= MemGameInfo.eSystemID = idMAME;
    if not Result then
       begin
         PopupSetName.Visible:= False;
         PopupDeleteName.Visible:= False;
         Exit;
       end;
    PopupSetName.Enabled:= True;
    if not PopupSetName.Visible then
       PopupSetName.Visible:= True;

    case IsAlterMAME of
      True : PopupDeleteName.Visible:= FileExists(AlterMAMEIniFilesDir+PopupSetName.Hint+'.ini');
      False: PopupDeleteName.Visible:= FileExists(IniFilesDir[idMAME]+PopupSetName.Hint+'.ini');
    end;
  end;

begin
  if not ValidateSelectedGame then
     begin
       PostMessage(Handle, WM_LBUTTONDOWN, MK_LBUTTON, 0);
       PostMessage(Handle, WM_LBUTTONUP, MK_LBUTTON, 0);
       Exit;
     end;

  iVersion:= -1;
  iVersionAlt:= -1;

  IsMAMEAvailable:= ValidateArcadeEmulatorFile(idMAME);
  if IsMAMEBasedSys(MemGameInfo.eSystemID) then
     iVersion:= GetMAMEBuild(MemGameInfo.eSystemID);

  PopupMenuGamesList.BeginUpdate;
  PopupEnableAutoRunCustomGamesWithMAME.Visible:= MemGameInfo.eIsCustomGame;
  case MemGameInfo.eIsCustomGame of
    True:
      begin
        PopupPlayGameStandard.Caption:= 'Run Game with MAME v'+buildMAME;
        PopupPlayGameWithCustomSystem.Caption:= 'Run Game';
      end;
    False:
      begin
        PopupPlayGameStandard.Caption:= 'Run Game';
        PopupPlayGameWithCustomSystem.Caption:= 'Run Game (Custom Emulators)';
      end;
  end;

  PopupPlayGameWithCustomSystem.Enabled:= MemGameInfo.eIsCustomGame or
             ((MemGameInfo.eCustomSystemID <> -1) and GameHaveROMs(MemGameInfo.eHaveGameROMs) and (not MemGameInfo.eROMsAllNoDump));// (MemGameInfo.eSoftwareName <> '');
  PopupPlayGameWithCustomSystem.Visible:= PopupPlayGameWithCustomSystem.Enabled;
  //if PopupPlayGameWithCustomSystem.Enabled then
  //   SetPopupCustomEmulators(MemGameInfo.eCustomSystemID);

  //error
  //need to check for AlterMAME and stuff... in arcade games, it is not showing!!!!
  
  if (MemGameInfo.eSystemID = idMAME) or MemGameInfo.eIsCustomGame then
     iVersionAlt:= GetMAMEBuild(MemGameInfo.eSystemID, True);

  // need to check for eIsCustomGame and make it visible, but also need to check if mame.exe is selected and ValidateFile()
  selCount:= GamesListView.Selection.Count;

  case MemGameInfo.eIsCustomGame of
    True:
      begin
        PopupMachineToRunGame.Visible:= (IsMAMEAvailable and (MemGameInfo.eSoftwareName <> '')) or (IsMAMEAvailable and MemGameInfo.eIsCustomGame);
        PopupPlayGameStandard.Visible:= PopupMachineToRunGame.Visible and PopupEnableAutoRunCustomGamesWithMAME.Checked;
        if PopupMachineToRunGame.Visible then
           PopupMachineToRunGame.Visible:= (selCount = 1) and (not PanelMachinesList.Visible);
      end;
    False:
      begin
        PopupMachineToRunGame.Visible:= IsMAMEBasedSys(MemGameInfo.eSystemID) and // (MemGameInfo.eSystemID = idMAME) and
                                        (selCount = 1) and (MemGameInfo.eSoftwareName <> '') and (not PanelMachinesList.Visible);

        PopupPlayGameStandard.Visible:= ValidateArcadeEmulatorFile(MemGameInfo.eSystemID);
      end;
  end;

  PopupRunConsoleComputerGameWithMAME.Visible:= not PopupPlayGameStandard.Visible;
  if PopupRunConsoleComputerGameWithMAME.Visible then
     PopupRunConsoleComputerGameWithMAME.Caption:= 'Run Game With MAME v'+buildMAME;

  PopupAutoRunGameAlterMAME.Visible:= ((MemGameInfo.eSystemID = idMAME) and (AlterMAMEFile <> '')) or (IsMAMEAvailable and (AlterMAMEFile <> '') and MemGameInfo.eIsCustomGame);
  if PopupAutoRunGameAlterMAME.Visible then
     PopupAutoRunGameAlterMAME.Visible:= FileExists(AlterMAMEFile);

  if PopupAutoRunGameAlterMAME.Visible then
     begin
       case MemGameInfo.eIsCustomGame of
         True:
           begin
             PopupAutoRunGameAlterMAME.Visible:= PopupEnableAutoRunCustomGamesWithMAME.Checked and ((iVersionAlt >= 162) or (iVersionAlt = -1));
           end;
         False:
