begin
  // from Emu Loader
  //AddMsgText(#13#10+'AlterMAME Emulator  ', $000053a6, [fsItalic, fsBold], taCenter);
  //AddMsgText(AlterMAMEVersion+#13#10, clGray, [fsItalic, fsBold], taCenter);
  // ... from Emu Loader

  AddMsgText('Emulator '+IntToStr(EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID])+'   ', $000053a6, [fsItalic, fsBold], taCenter);
  if iEmulatorFile = '' then
     AddMsgText(EmulatorVersionCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]]+#13#10, clGray, [fsItalic, fsBold], taCenter)
  else
     AddMsgText(iEmulatorFile+#13#10, clGray, [fsItalic, fsBold], taCenter);
  AddMsgText(#13#10);
end;

procedure TFormMain.ExecuteGameCustom;
const
  WinViceFlipDisk: String = ' -flipname "%s"'; // Commodore 64 for multi-floppy disk games
var
  CommandLine, EmuParameters, MultiFloppyParameter, txtString: WideString;
  EmulatorString, ErrorMsgTitle,
  MountImageStr, UnmountImageStr: String;
  GameFileExt, TempStr: String;
  Continue, UseVirtualDrive, IsBatchFile, IsFileFound, MultiFloppy, IsWinUAE, IsViceFlipList: Boolean;//, IsMESSEmu: Boolean;
  ExtraParameters, ExtraDefaultParameters: TMemIniFile;
  IsJavaPSPEmu, IsWinApeEmu: Boolean;
  ExitCode: DWORD;

  WinApeCurrentROM, StrDOSName: String;
  iPlayTime: Cardinal;

  function GetEmulatorFile: Boolean;
  begin
    EmulatorString:= EmulatorFileCustom[MemGameInfo.eCustomSystemID, EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID]];
    Result:= (EmulatorString <> '') and FileExists(EmulatorString);
  end;

  function GetExecParameters(ParameterIndex: Byte; MountImagePCE: Boolean = False): Boolean;
  var
    mediaIdx: Byte;
  begin
    // ParameterIndex: 1 -> Param1; 2 -> Param2
    if MountImagePCE then
       mediaIdx:= 0
    else
       mediaIdx:= MemGameInfo.eCustomMediaType;
    EmuParameters:= ExtraParameters.ReadString(SystemsListCustom[MemGameInfo.eCustomSystemID, 0],
                                       ExtractFileName(ChangeFileExt(EmulatorString, ''))+
                                       GetMediaTypeName(mediaIdx, ParameterIndex, True), '');
    if MountImagePCE then
       Result:= True
    else
       begin
         Result:= EmuParameters <> '';
         if not Result then
            begin
              if Assigned(ExtraDefaultParameters) then
                 begin
                   EmuParameters:= ExtraDefaultParameters.ReadString(SystemsListCustom[MemGameInfo.eCustomSystemID, 0],
                                   ExtractFileName(ChangeFileExt(EmulatorString, ''))+
                                   GetMediaTypeName(mediaIdx, ParameterIndex, True), '');
                   Result:= EmuParameters <> '';
                 end;
            end;
       end;
    //ShowMessage(SystemsList[MemGameInfo.eSystemID, 0]+#13#10+
    //            ExtractFileName(ChangeFileExt(EmulatorString, ''))+
    //            GetMediaTypeName(mediaIdx, ParameterIndex, True)+#13#10+EmuParameters);
  end;

  function GetROMTypeAtari800: Boolean;
  var
    tmpCartStr: String;
    tmpFileSize: Integer;
    //cFileExt: String;

    function IsExecutableFile: Boolean;
    begin
      Result:= SameText('.xex', GameFileExt) or SameText('.exe', GameFileExt) or SameText('.com', GameFileExt) or
               SameText('.bas', GameFileExt) or SameText('.lst', GameFileExt);
      //Result:= (cFileExt = '.xex') or (cFileExt = '.exe') or (cFileExt = '.com') or
      //         (cFileExt = '.bas') or (cFileExt = '.lst');
    end;

    function IsCARFile: Boolean;
    begin
      // .car files already have the cart type in the header
      // for Atari800, Atari800Win, Altirra
      Result:= SameText('.car', GameFileExt);
    end;

  begin
    Result:= (MemGameInfo.eCustomSystemID = 48) and (MemGameInfo.eCustomMediaType = 1);
    if not Result then Exit;

    //cFileExt:= ExtractFileExtW(MemGameVariables.eGameFileName);
    tmpFileSize:= MemGameInfo.eGameSize div 1024;
    if IsAtari800Emu(ExtractFileName(EmulatorString)) then
    begin
      // need to check if cartridge is a executable
      if IsExecutableFile then
         CommandLine:= StringReplaceW(CommandLine, '-cart',
                                     '-run', [rfIgnoreCase]) // for executable files
      else
      begin
        if IsCARFile then
           Exit;
        // see "cart.txt" for the cart type indexes!!!
        case TmpFileSize of
            8: CommandLine:= CommandLine+' -cart-type 1';  // Standard 8 KB cartridge
           16: CommandLine:= CommandLine+' -cart-type 2';  // Standard 16 KB cartridge
           32: CommandLine:= CommandLine+' -cart-type 12'; // XEGS 32 KB cartridge
           40: CommandLine:= CommandLine+' -cart-type 18'; // Bounty Bob Strikes Back 40 KB cartridge
           64: CommandLine:= CommandLine+' -cart-type 13'; // XEGS 64 KB cartridge
          128: CommandLine:= CommandLine+' -cart-type 14'; // XEGS 128 KB cartridge
          256: CommandLine:= CommandLine+' -cart-type 23'; // XEGS 256 KB cartridge
          512: CommandLine:= CommandLine+' -cart-type 24'; // XEGS 512 KB cartridge
         1024: CommandLine:= CommandLine+' -cart-type 25'; // XEGS 1 MB cartridge
            2: CommandLine:= CommandLine+' -cart-type 57';  // Standard 2 KB cartridge ... November 2013
            4: CommandLine:= CommandLine+' -cart-type 58';  // Standard 4 KB cartridge ... November 2013
        else
          Exit;
        end;
      end;
    end
    else
    if IsAltirra(ExtractFileName(EmulatorString)) then
       begin
         if IsExecutableFile or IsCARFile then
            Exit;
         // see "src\Altirra\source\cartridge.cpp" for the cart type indexes!!!
         case TmpFileSize of
             8: CommandLine:= CommandLine+' /cartmapper 1';  // Standard 8 KB cartridge
            16: CommandLine:= CommandLine+' /cartmapper 2';  // Standard 16 KB cartridge
            32: CommandLine:= CommandLine+' /cartmapper 12'; // XEGS 32 KB cartridge
            40: CommandLine:= CommandLine+' /cartmapper 18'; // Bounty Bob Strikes Back 40 KB cartridge
            64: CommandLine:= CommandLine+' /cartmapper 13'; // XEGS 64 KB cartridge
           128: CommandLine:= CommandLine+' /cartmapper 14'; // XEGS 128 KB cartridge
           256: CommandLine:= CommandLine+' /cartmapper 23'; // XEGS 256 KB cartridge
           512: CommandLine:= CommandLine+' /cartmapper 24'; // XEGS 512 KB cartridge
          1024: CommandLine:= CommandLine+' /cartmapper 25'; // XEGS 1 MB cartridge
             2: CommandLine:= CommandLine+' /cartmapper 57';  // Standard 2 KB cartridge
             4: CommandLine:= CommandLine+' /cartmapper 58';  // Standard 4 KB cartridge
         else
           Exit;
         end;
       end
    else
    if IsAtariPlusPlus(ExtractFileName(EmulatorString)) then
    begin
      if IsExecutableFile then
      begin
        // need to get floppy parameters for Atari++ (executable files requires it)
        MemGameInfo.eCustomMediaType:= IsFloppy;
        EmuParameters:= '';
        // get floppy parameters and set CommandLine again...
        Result:= GetExecParameters(EmulatorParameterIndexToUseCustom[MemGameInfo.eCustomSystemID, 1]);
        MemGameInfo.eCustomMediaType:= 1;
        CommandLine:= SystemStr+EmulatorString+SystemStr+WideFormat(' '+EmuParameters, [TempGameVars.eName]);
        Exit;
      end
      else
      begin
      tmpCartStr:= '';
      case TmpFileSize of
          2: tmpCartStr:= '-carttype 2k'; // Standard 2 KB cartridge ... November 2013
          4: tmpCartStr:= '-carttype 4k'; // Standard 4 KB cartridge ... November 2013
          8: tmpCartStr:= '-carttype 8k'; // Standard 8 KB cartridge
         16: Exit;//tmpCartStr:= '';  // Standard 16 KB cartridge
         40: tmpCartStr:= '-carttype bountybob'; // Bounty Bob Strikes Back 40 KB cartridge
      else
         tmpCartStr:= '-carttype xegs'; // XEGS 32 KB, 64 KB, 128 KB, 256KB, 512 KB, 1 MB cartridges
      end;
      CommandLine:= StringReplaceW(CommandLine, '-carttype 16k',
                                 tmpCartStr, [rfIgnoreCase]);
      Exit;
      end;
    end
    else
      Result:= False;
  end;

  function CheckAppleIIgs(sClearEntry: Boolean): Boolean;
  var
    emuFile: String;
  begin
    Result:= True;
    emuFile:= ExtractFileName(EmulatorString);
    if IsAppleIIGS(emuFile) then
       begin
         // Apple IIgs... will check if Kegs32 or GSport emulators are being used
         // if yes, will try to edit "config.kegs" or "config.txt"
         Result:= EditApple2GScfg(EmulatorString, TempGameVars.eName, nil, sClearEntry);
         if Result then
            CommandLine:= SystemStr+EmulatorString+SystemStr;
       end;
  end;

  function ResetAppleIIgs: Boolean;
  begin
    Result:= (MemGameInfo.eCustomSystemID = 53) and (MemGameInfo.eCustomMediaType = IsFloppy);
    if Result then
       CheckAppleIIgs(True);
  end;

  function ResetWinApeIni: Boolean;
  begin
    Result:= MemGameInfo.eCustomSystemID = 59;
    if Result then
       begin
         // restore WinAPE cartridge... OS ROM!!!
         if IsWinApeEmu then
            WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, WinApeCurrentROM, '', '', '');
       end;
  end;

  function IsKEGAFusionEmu: Boolean;
  begin
    Result:= SameText(ExtractFileName(EmulatorString), 'fusion.exe');
  end;

  function GetGamesListVersion(sysID: Integer): String;
  var
    tmpFile: TMemIniFile;
  begin
    // for MAME software lists
    Result:= '-';
    if not FileExists(GetGamesFolderEL+GetSystemFileName(sysID)) then
       Exit;
    tmpFile:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));
    Result:= tmpFile.ReadString('info_file', 'version', '');
    FreeAndNil(tmpFile);
  end;
  
  procedure ResetToFrontend;
  begin
    ClearMemGameInfo(TempGameVars);
    FreeAndNil(ExtraParameters);
    FreeAndNil(ExtraDefaultParameters);
    ThousandSeparator:= Char(',');
    DecimalSeparator:= Char('.');
    SetCurrentDir(FrontendPath);
    FocusGamesList;
    Application.ProcessMessages;
    //ProcessingConsole:= False;
  end;

begin
  if not ValidateSelectedGame then
     Exit;

  MultiFloppy:= CheckMultipleSelected(GamesListView);
  case MemGameInfo.eIsCustomGame of
    True : ErrorMsgTitle:= 'Error: Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';
    False: ErrorMsgTitle:= 'Error: Run Game ['+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+']';
  end;
  if (not MultiFloppy) and (MemGameInfo.eIsCustomGame) then
    begin // doesn't allow this for MAME software lists... only custom games from EmuCon are supported!!!
      if Boolean(PlayWithAssociatedEmulator[MemGameInfo.eCustomSystemID]) then
         begin
           // cannot execute with associated application if it's a .zip file!!!
           //if not IsZipFile(MemGameInfo.eGameFileName) then
              begin
                ExecuteGameAssociatedApp;
                Exit;
              end;
         end;
    end;

  EmulatorString:= '';
  EmuParameters:= '';

  case ValidateFile(GetEmuParametersFile) of
    True: ExtraParameters:= TMemIniFile.Create(GetEmuParametersFile);
    False:
      begin
        CallMessageBox;
        EnableMsgMediaTypeLabel(((MemGameInfo.eCustomMediaType = 2) and (EmulatorMountVirtualDrive[MemGameInfo.eCustomSystemID])));
        AddEmulatorHeader;
        AddMsgText('    File ');
        AddMsgText(GetEmuParametersFile, $00a65300, [fsBold]);
        AddMsgText(' was not found! The frontend can''t function properly without it. Aborting...');
        GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
        Exit;
      end;
  end;

  if not GetEmulatorFile then
     begin
       CallMessageBox;
       EnableMsgMediaTypeLabel(((MemGameInfo.eCustomMediaType = 2) and (EmulatorMountVirtualDrive[MemGameInfo.eCustomSystemID])));
       if EmulatorString <> '' then
          begin
            AddEmulatorHeader;
            AddMsgText(EmulatorString+#13#10, $00600000, [], taLeftJustify, 10, 'Consolas');
            AddMsgText(#13#10+'    Emulator file not found! Please make sure the file exists or select another emulator before running games.');
          end
       else
          begin
            AddMsgText('    Emulator '+IntToStr(EmulatorIndexToUseCustom[MemGameInfo.eCustomSystemID])+
                       ' not selected. Please select one before running games. You can also try to run this game with MAME.');
          end;
       GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);

       ResetToFrontend;
       Exit;
     end;

  ExitCode:= 0; // all is well
  IsFileFound:= False;
  //ProcessingConsole:= False;
  UseVirtualDrive:= False;
  TempGameVars.eName:= '';

  GameFileExt:= LowerCase(ExtractFileExtW(MemGameInfo.eName));

  IsViceFlipList:= False;
  IsJavaPSPEmu:= False;
  IsWinApeEmu:= False;

  IsBatchFile:= IsExeBatchFile(EmulatorString);
  //if IsBatchFile and MultiFloppy then
  //   begin
  //     txtString:= 'System: %s'+#13#10+'    Emulator '+IntToStr(EmulatorIndexToUse[MemGameInfo.eSystemID])+
  //                 ' is a batch file and there are multiple games selected.'+#13#10+#13#10+
  //                 'This is not supported by EmuCon. Aborting...';
  //     ShowMessageApp(ErrorMsgTitle,
  //                    MemGameInfo.eTitle+#13#10+#13#10+
  //                    Format(txtString, [SystemsList[MemGameInfo.eSystemID, 0]]));
  //     ResetToFrontend;
  //     Exit;
  //   end;

  if MemGameInfo.eCustomSystemID = 59 then
     begin
       // Amstrad CPC
       // need to get the default cartridge (BASIC cart required for floppy games)
       IsWinApeEmu:= IsWinApe(ExtractFileName(EmulatorString));
       if IsWinApeEmu then
          WinApeGetCartridgeFile(EmulatorString, WinApeCurrentROM);
     end;

  case MultiFloppy of
    True:
      begin
        if (MemGameInfo.eCustomSystemID in [39, 49, 56, 59]) then // and (MemGameInfo.eMediaType = IsFloppy) then
           begin
             // for Commodore 64, 128, VIC-20, Amstrad CPC
             // the first floppy will be added normally in the command line (Commodore 64, 128, VIC-20 WinVice emulator)
             // I think I'll just do it all in the MountMultiFloppyCommandLine function anyway... like the other systems!!!
             TempGameVars.eName:= MemGameInfo.eName; // floppy disk
             IsFileFound:= SearchGameFile(MemGameInfo.eName, MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, ButtonImageCUE.Down, True, TempGameVars.eName, StrDOSName);
             //IsFileFound:= SearchGameFile(TempGameVars.eName);
             if not IsFileFound then
                begin
                  CallMessageBox;
                  EnableMsgMediaTypeLabel(False);
                  AddEmulatorHeader;
                  AddMsgText('    Game file ');
                  AddMsgText(MemGameInfo.eName, $00a65300, [fsBold]);
                  AddMsgText(' was not found! The main floppy disk could not be located.');
                  if not GameFoldersFound(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType) then
                     AddMsgText(' Games folders are empty or not selected.');
                  AddMsgText(' Aborting...');
                  GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
                  ResetToFrontend;
                  Exit;
                end;
           end;

        if not MountMultiFloppyCommandLine2(MultiFloppyParameter) then
           begin
             ResetToFrontend;
             Exit;
           end;
        IsWinUAE:= SameText(ExtractFileName(EmulatorString), 'WinUAE.exe');
      end;
    False:
      begin
        TempGameVars.eName:= MemGameInfo.eName;
        case MemGameInfo.eCustomMediaType of
          2: // disc images
            begin
              // disc images!!!!
              UseVirtualDrive:= EmulatorMountVirtualDrive[MemGameInfo.eCustomSystemID];
              if UseVirtualDrive then
                 begin
                   ReadDaemonToolsSettings(True);
                   if not FileExistsW(VirtualDriveFile) then
                      begin
                        CallMessageBox;
                        EnableMsgMediaTypeLabel(UseVirtualDrive);
                        AddEmulatorHeader;
                        AddMsgText('    The virtual drive executable file could not be found '+
                                   'or hasn''t been selected yet. Please go to ');
                        AddMsgText('Emulator Setup', clBlack, [fsBold]);
                        AddMsgText(' screen to select a file.'+#13#10+#13#10+
                                   '    Officially supported virtual drive tools are:'+#13#10);
                        AddMsgText('Daemon Tools ', clBlack, [fsBold]);
                        AddMsgText('http://www.daemon-tools.cc', $00a65300);
                        AddMsgText(#13#10+'Elby Virtual CloneDrive ', clBlack, [fsBold]);
                        AddMsgText('http://www.slysoft.com', $00a65300);
                        AddMsgText(#13#10+'Alcohol 120% ', clBlack, [fsBold]);
                        AddMsgText('http://www.alcohol-soft.com', $00a65300);
                        AddMsgText(#13#10+#13#10+'This feature is for disc images only. Aborting...');

                        GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);

                        ResetToFrontend;
                        Exit;
                      end;
                 end;
            end;
          4: // floppy disks
            begin
              // nothing to do here... handling is done at the end....
              // if (MemGameInfo.eSystemID in [39, 49, 56]) and (MemGameInfo.eMediaType = IsFloppy) then
              //    begin
              //      if IsWinVice(ExtractFileName(EmulatorString)) then
              //         begin
              //           // for Commodore 64 / 128 / VIC-20
              //           // search for fliplist file, for floppy disks only (WinVICE emulator only)
              //           MemGameVariables.eGameFileName:= ChangeFileExt(MemGameVariables.eGameFileName, '.vfl');
              //           IsFileFound:= SearchGameFile(MemGameVariables.eGameFileName);
              //           if IsFileFound then
              //              IsViceFlipList:= True;
              //           MemGameVariables.eGameFileName:= MemGameInfo.eGameFileName;
              //         end;
              //    end;
            end;
        end;
        case MemGameInfo.eIsCustomGame of
          True:
            begin
              IsFileFound:= SearchGameFile(MemGameInfo.eName{ TempGameVars.eName}, MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType, ButtonImageCUE.Down, True, TempGameVars.eName, StrDOSName);
            end;
          False:
            begin
              TempGameVars.eName:= '';
              if GameHaveROMs(MemGameInfo.eHaveGameROMs) then
                 TempGameVars.eName:= SearchZIPFolder(MemGameInfo.eName, MemGameInfo.eSystemID, MemGameInfo.eSoftwareName);
              IsFileFound:= TempGameVars.eName <> '';
            end;
        end;

        if not IsFileFound then
           begin
             CallMessageBox;
             EnableMsgMediaTypeLabel(UseVirtualDrive);
             AddEmulatorHeader;
             AddMsgText('    Game file ');
             AddMsgText(MemGameInfo.eName, $00a65300, [fsBold]);
             AddMsgText(' was not found!');
             case MemGameInfo.eIsCustomGame of
               True:
                 begin
                   if not GameFoldersFound(MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType) then
                      AddMsgText(' Games folders are empty or not selected.');
                 end;
               False:
                 begin
                   if not (Assigned(emuROMsFolders[MemGameInfo.eSystemID]) and (emuROMsFolders[MemGameInfo.eSystemID].Count > 0)) then
                      AddMsgText(' Games folders are empty or not selected.');
                 end;
             end;

             AddMsgText(' Aborting...');
             GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
             ResetToFrontend;
             Exit;
           end;
        // special cases...
        case MemGameInfo.eCustomSystemID of
          11: begin // GP32
                if LowerCase(ExtractFileName(EmulatorString)) = 'geepee32.exe' then
                   begin
                     // for GeePee32 emulator
                     if SameText(GameFileExt, '.gxb') then
                        TempGameVars.eName:= '/GXB='+TempGameVars.eName
                     else
                     if SameText(GameFileExt, '.fxe') then
                        TempGameVars.eName:= '/FXE='+TempGameVars.eName
                     else
                     if SameText(GameFileExt, '.smc') then
                        TempGameVars.eName:= '/SMC='+TempGameVars.eName
                     else
                        begin
                          CallMessageBox;
                          EnableMsgMediaTypeLabel(UseVirtualDrive);
                          AddEmulatorHeader;
                          AddMsgText('    File extension ');//not supported. Valid file extensions are: ');
                          AddMsgText(GameFileExt, $00a65300, [fsBold]);
                          AddMsgText(' not supported. Valid file extensions are: ');
                          AddMsgText('.gxb', $00a65300, [fsBold]);
                          AddMsgText('; ');
                          AddMsgText('.fxe', $00a65300, [fsBold]);
                          AddMsgText('; ');
                          AddMsgText('.smc', $00a65300, [fsBold]);
                          AddMsgText(#13#10+#13#10+'Aborting...');
                          GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
                          ResetToFrontend;
                          Exit;
                        end;
                   end;
              end;
        end;
      end;
  end;

  if FileExists(GetEmuParametersFile(True, True)) then
     ExtraDefaultParameters:= TMemIniFile.Create(GetEmuParametersFile(True, True));

  Continue:= GetExecParameters(EmulatorParameterIndexToUseCustom[MemGameInfo.eCustomSystemID, MemGameInfo.eCustomMediaType], UseVirtualDrive);
  case Continue of
    True:
      begin
        if UseVirtualDrive then
           CommandLine:= SystemStr+EmulatorString+SystemStr+' '+EmuParameters
        else
           begin
             if MemGameInfo.eCustomSystemID in [39, 49, 56] then
                begin
                  // Commodore 64 / 128 / VIC-20
                  CommandLine:= SystemStr+EmulatorString+SystemStr+WideFormat(' '+EmuParameters, [TempGameVars.eName]);
                  if IsWinVice(ExtractFileName(EmulatorString)) then
                     begin
                       // for Commodore 64 and Commodore 128
                       // search for fliplist file, for floppy disks only (WinVICE emulator only)
                       TempGameVars.eName:= GetFolderFull(38)+SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+'\'+
                                            ChangeFileExtW(ExtractFileNameW(MemGameInfo.eName), '.vfl'); // WinVICE flip list file
                       if FileExistsW(TempGameVars.eName) then
                          CommandLine:= CommandLine+WideFormat(WinViceFlipDisk, [TempGameVars.eName]);
                     end;
                end
             else
             case MultiFloppy of
               True:
                 begin
                   //if not (MemGameInfo.eSystemID in [39, 49, 56]) then
                      CommandLine:= SystemStr+EmulatorString+SystemStr+' '+EmuParameters;
                 end;
               False:
                 begin
                   case IsWinApeEmu of
                     True:
                       begin
                         // Amastrad CPC
                         if MemGameInfo.eCustomMediaType = IsFloppy then
                            CommandLine:= SystemStr+EmulatorString+SystemStr+Format(' '+EmuParameters, [TempGameVars.eName])
                         else
                            CommandLine:= SystemStr+EmulatorString+SystemStr; // cartridge and cassete do not need parameters
                       end;
                     False: CommandLine:= SystemStr+EmulatorString+SystemStr+WideFormat(' '+EmuParameters, [TempGameVars.eName]);
                   end;

                   GetROMTypeAtari800; // check if it's cartridge Atari 400 / 800 / XL and set cmdline (Atari800, Atari800Win, Atari++)

                   if MemGameInfo.eCustomSystemID = 44 then
                      begin
                        // Amiga: WinUAE and FS-UAE
                        if IsAmigaUAE(ExtractFileName(EmulatorString)) then
                           begin
                             if FindDiskCFG(nil, txtString) then
                                if (txtString <> '') and FileExistsW(txtString) then
                                   begin
                                     CommandLine:= SystemStr+EmulatorString+SystemStr+' '+SystemStr+txtString+SystemStr;
                                   end;
                           end;
                      end;
                   if (MemGameInfo.eCustomSystemID = 53) and (MemGameInfo.eCustomMediaType = IsFloppy) then
                      begin
                        // Apple IIGS... will check if Kegs32 or GSport emulators are being used
                        // if yes, will try to edit "config.kegs" or "config.txt"
                        if not CheckAppleIIgs(False) then
                           begin
                             ResetToFrontend;
                             Exit;
                           end;
                      end;
                   if MemGameInfo.eCustomSystemID = 59 then
                      begin
                        // Amstrad CPC
                        if IsWinApeEmu then
                           begin
                             case MemGameInfo.eCustomMediaType of
                               1: WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, TempGameVars.eName, '', '', '');
                               4: WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, WinApeCurrentROM, TempGameVars.eName, '', '');
                               5: WinApeEditIni(MemGameInfo.eCustomMediaType, EmulatorString, WinApeCurrentROM, '', '', TempGameVars.eName);
                             end;
                           end;
                      end;
                 end;
             end;
           end;
      end;
    False:
      begin
        CallMessageBox;
        EnableMsgMediaTypeLabel(UseVirtualDrive);
        AddEmulatorHeader;
        AddMsgText(EmulatorString+#13#10, $00600000, [], taLeftJustify, 10, 'Consolas');
        AddMsgText(#13#10+'    No parameters were found. Please make sure the emulator parameter is not empty. '+
                   'Also check the selected parameter (1 or 2) in the main tool bar buttons.'+#13#10+#13#10+
                   'If the game is a disc image, check if the emulator requires or not a parameter to load the game.');
        GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle);
        ResetToFrontend;
        Exit;
      end;
  end;

  if IsBatchFile then
     CommandLine:= CommandPromptStr+SystemStr+CommandLine+SystemStr;

  if UseVirtualDrive then
     begin
       MountImageStr:= WideFormat(SystemStr+VirtualDriveFile+SystemStr+' '+VirtualDriveMount, [TempGameVars.eName]);
       UnmountImageStr:= SystemStr+VirtualDriveFile+SystemStr+' '+VirtualDriveUnmount;
     end;
  if MultiFloppy then
     begin
       // replace entries for multi-floppy disks loading
       case MemGameInfo.eCustomSystemID of
         44: // Amiga
           begin
             case IsWinUAE of
               True: CommandLine:= StringReplaceW(CommandLine, '-0 "%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // Amiga FS-UAE

               False: CommandLine:= StringReplaceW(CommandLine, '--floppy_drive_0="%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // Amiga FS-UAE
             end;
           end;
         //39: CommandLine:= CommandLine+' '+MultiFloppyParameter; // Commodore64 "WinVICE" emulator only
         48: // Atari 400/800/XL
           begin
             if IsAltirra(ExtractFileName(EmulatorString)) then
                begin
                  CommandLine:= StringReplaceW(CommandLine, '"%s"', MultiFloppyParameter, [rfIgnoreCase]); // Altirra
                end
             else
             if IsAtariPlusPlus(ExtractFileName(EmulatorString)) then
                CommandLine:= StringReplaceW(CommandLine, '"%s"', MultiFloppyParameter, [rfIgnoreCase]); // Altirra
           end;
         52: // Apple II
           begin
             //case SameText(ExtractFileName(EmulatorString), 'AppleWin.exe') of
             case IsAppleWinEmu(ExtractFileName(EmulatorString)) of
               True : CommandLine:= StringReplaceW(CommandLine, '-d1 "%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // AppleWin
               False: CommandLine:= StringReplaceW(CommandLine, '-s6.d1 "%s"',
                                                  MultiFloppyParameter, [rfIgnoreCase]); // JACE: Java Apple Computer Emulator
             end;
           end;
         53: CommandLine:= SystemStr+EmulatorString+SystemStr; // Apple IIGS
         59: // Amstrad CPC
           begin
             if IsWinApeEmu then
                CommandLine:= Format(CommandLine, [TempGameVars.eName]);
           end;
       end;
     end;

  //ShowMessageW(EmulatorString+#13#10+CommandLine+#13#10#13#10+TEasyGameInfo(SelectedItem).eTitle+#13#10+MemGameInfo.eTitle+#13#10+#13#10+
  //             GetShortFileNameW(MemGameVariables.eGameFileName));

  if MenuViewEmulatorFullCommandLine.Checked then
     begin
       txtString:= '';
       case MemGameInfo.eIsCustomGame of
         True : ErrorMsgTitle:= 'Run '+GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Game: '+SystemsListCustom[MemGameInfo.eCustomSystemID, 0];
         False: ErrorMsgTitle:= 'Run Game: '+SystemsListCustom[MemGameInfo.eCustomSystemID, 0];
       end;
       CallMessageBox;
       case MemGameInfo.eIsCustomGame of
         True:
           begin
             EnableMsgMediaTypeLabel(UseVirtualDrive);
             TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
             AddMsgText(TempStr, $000053a6, [fsItalic, fsBold], taCenter);//, 9, 'Trebuchet MS');
             AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, clGray, [fsItalic, fsBold], taCenter);
           end;
         False:
           begin
             ShowGameNameEntryMsgBox;
             AddMsgText('Games list   ', $000053a6, [fsItalic, fsBold], taCenter);//, 9, 'Trebuchet MS');
             AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, clGray, [fsItalic, fsBold], taCenter);

             AddMsgText(GetArcadeSystemIniSection(MemGameInfo.eSystemID)+' Software List   ', $000053a6, [fsItalic, fsBold], taCenter);
             AddMsgText(MemGameInfo.eCategory+#13#10, clGray, [fsItalic, fsBold], taCenter);
           end;
       end;
       
       AddEmulatorHeader;
       FormMessageBox.ButtonYes.Caption:= 'Execute';
       FormMessageBox.ButtonNo.Caption:= 'Abort';

       if UseVirtualDrive then
          begin
            AddMsgText('Unmount Image From Virtual Drive'+#13#10, $000053a6, [], taCenter);
            AddMsgText(UnmountImageStr+#13#10+#13#10, $00600000, [], taLeftJustify, 10, 'Consolas');
            AddMsgText('Mount Image On Virtual Drive'+#13#10, $000053a6, [], taCenter);
            AddMsgText(MountImageStr+#13#10#13#10, $00600000, [], taLeftJustify, 10, 'Consolas');
            AddMsgText('Execute Emulator'+#13#10, $000053a6, [], taCenter);
            AddMsgText(CommandLine+#13#10, $00600000, [], taLeftJustify, 10, 'Consolas');
            AddMsgText(#13#10+'Unmount Image From Virtual Drive'+#13#10, $000053a6, [], taCenter);
            AddMsgText(UnmountImageStr, $00600000, [], taLeftJustify, 10, 'Consolas');
          end
       else
          begin
            AddMsgText(CommandLine, $00600000, [], taLeftJustify, 10, 'Consolas');
          end;

       Continue:= GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle,
                                  '', 1, False, -1) = mrYes;

       if not Continue then
          begin
            ResetWinApeIni;
            ResetAppleIIGS;
            ResetToFrontend;
            Exit;
          end;
     end;

  iPlayTime:= GetTickCount;

  SetCurrentDir(ExtractFilePath(EmulatorString));

  if UseVirtualDrive then
     begin
       // unmount first to be sure no image is mounted in virtual drive
       RunProcess(UnmountImageStr, True, SW_SHOWNORMAL);//, False);
       Sleep(10);
       RunProcess(MountImageStr, True, SW_SHOWNORMAL);//, False);
     end;

  IsRunningGame:= True;
  ExitCode:= RunProcess(CommandLine, True);
  IsRunningGame:= False;
  
  if UseVirtualDrive then
     RunProcess(UnmountImageStr, True, SW_SHOWNORMAL);//, False); // unmount image after exiting the emulator

  case MemGameInfo.eIsCustomGame of
    True : UpdatePlayedCustomGame(iPlayTime, SelectedEasyItem);
    False: UpdatePlayedGameArcade(iPlayTime, SelectedEasyItem);
  end;
  //TEasyGameInfo(SelectedEasyItem).Invalidate(False);

  ResetWinApeIni;
  ResetAppleIIgs;


  if ExitCode <> 0 then
     begin
       if IsKEGAFusionEmu then
          begin
            if (ExitCode = 1) and FormPreferences.IgnoreExitCode1InvalidFunction.Checked then
               begin
                 // KEGA Fusion have a bug that returns error code 1 even when emu and game load without errors
                 ResetToFrontend;
                 Exit;
               end;
          end;

       CallMessageBox;
       case MemGameInfo.eIsCustomGame of
         True:
           begin
             EnableMsgMediaTypeLabel(UseVirtualDrive);
             TempStr:= GetSystemTypeTitle(MemGameInfo.eCustomSystemID, False)+' Games List   ';
             AddMsgText(TempStr, $000053a6, [fsItalic, fsBold], taCenter);//, 9, 'Trebuchet MS');
             AddMsgText(SystemsListCustom[MemGameInfo.eCustomSystemID, 0]+#13#10, clGray, [fsItalic, fsBold], taCenter);
           end;
         False:
           begin
             ShowGameNameEntryMsgBox;
             AddMsgText('Games list   ', $000053a6, [fsItalic, fsBold], taCenter);//, 9, 'Trebuchet MS');
             AddMsgText(GetGamesListVersion(MemGameInfo.eSystemID)+#13#10, clGray, [fsItalic, fsBold], taCenter);

             AddMsgText(GetArcadeSystemIniSection(MemGameInfo.eSystemID)+' Software List   ', $000053a6, [fsItalic, fsBold], taCenter);
             AddMsgText(MemGameInfo.eCategory+#13#10, clGray, [fsItalic, fsBold], taCenter);
           end;
       end;
       AddEmulatorHeader;
       AddMsgText(#13#10+'Error '+IntToStr(ExitCode), $00000060, [fsBold]);
       AddMsgText(': '+SysErrorMessage(ExitCode)+'.');
       //if ExitCode = 3221225786 then
       //   CheckPrecisionXAfterburner; // why, why, WHY ?
       // check this link for most common error messages:
       // http://www.febooti.com/products/automation-workshop/online-help/events/run-dos-cmd-command/exit-codes/
       if ExitCode = 2 then
          begin
            AddMsgText(#13#10);
            AddMsgText(#13#10+'Required files are missing, "'+MemGameInfo.eName+'" cannot be run.'+#13#10, clMaroon, [fsItalic], taCenter);
          end;
       GenerateMessage(ErrorMsgTitle, MemGameInfo.eTitle, '', 2);
     end;

  ResetToFrontend;
end;

