function TFormMain.GetArcadeEmulatorVersion(const SystemID: Byte; const strEmuFile: String; out StoreResultIn: String; out StoreMAMEBuildVersionIn: String): Boolean;
var
  CommandLine, VersionDescription, tempFile, fDateStr, fVersion: String;
  BatchFile: THashedStringList;
  Continue, IsStatusOpened: Boolean;
  {Loop, iPos, }fDate: Integer;
begin
  isStatusOpened:= FormStatus.Visible;
  SetCurrentDir(FrontendPath);
  Continue:= True;
  case SystemID of
    idMAME, idHBMAME:
      begin
        // first try to get version from Windows file details; if fails, get from "mame -help" output
        fDate:= FileAge(strEmuFile);
        fDateStr:= GetDateStr(fDate, True);
        fVersion:= GetMAMEBinaryVersion(strEmuFile, True, tempFile);
        if fVersion <> '' then
           VersionDescription:= GetArcadeEmulatorDescription(SystemID, (SystemID = idMAME), strEmuFile)+' v'+fVersion+' '+fDateStr
        else
           VersionDescription:= GetArcadeEmulatorDescription(SystemID, (SystemID = idMAME), strEmuFile)+' '+fDateStr;
        StoreMAMEBuildVersionIn:= fVersion;
        Continue:= False;
      end;
    idDaphne:
      begin
        StoreResultIn:=  'Daphne v1.0 build v'+GetVersion(strEmuFile);
        fDate:= FileAge(strEmuFile);
        fDateStr:= GetDateStr(fDate, True);
        if fDateStr <> '' then
           StoreResultIn:= StoreResultIn+' '+fDateStr;
        Result:= True;
        Exit;
      end;
    idDICE: // DICE
      begin
        VersionDescription:= GetArcadeEmuVersionXML(idDICE);
        Continue:= False;
      end;
    idSegaModel2: // SEGA Model 2 Emu
      begin
        if IsSEGAModel2NewVersion(strEmuFile) then
           StoreResultIn:= 'SEGA Model 2 Emulator v1.1a (Jan 02 2014)'
        else
           StoreResultIn:= 'SEGA Model 2 Emulator v1.0 (Dec 31 2010)';
        Result:= True;
        Exit;
      end;
    idZiNc:
      begin
        VersionDescription:= GetArcadeEmuVersionXML(idZiNc);
        Continue:= False;
      end;
  end;

  if Continue then
  begin
    // for Supermodel3 and Demul emulators only... still need to get version info from "-help" output
    if VerifyTempDirectory then
       begin
         tempFile:= FrontendPath+'temp\'+GetArcadeSystemIniSection(SystemID)+'Version.tmp';
         case SystemID of
           idSupermodel: CommandLine:= SystemStr+strEmuFile+SystemStr+' -h > '+SystemStr+tempFile+SystemStr; // Supermodel: SEGA Model 3 Emu
           idDemul: CommandLine:= SystemStr+strEmuFile+SystemStr+' -version > '+SystemStr+tempFile+SystemStr; // Demul
         end;

         SetCurrentDir(strEmuFile);
         RunProcess(CommandPromptStr+SystemStr+CommandLine+SystemStr, True, GetWindowStateEmulator);//, False); //SW_SHOWMINIMIZED, False); // WinXP / Sev7n / 8ight
         SetCurrentDir(FrontendPath);

         if ValidateFile(tempFile) then
            begin
              BatchFile:= THashedStringList.Create;
              BatchFile.LoadFromFile(tempFile);
              fDateStr:= '';
              VersionDescription:= BatchFile[0];
              case SystemID of
                idSupermodel: // Supermodel: SEGA Model 3 Emu
                  begin
                    Delete(VersionDescription, Length(VersionDescription), 1);
                    VersionDescription:= StringReplace(VersionDescription, '(Version ', 'v', [rfIgnoreCase]);
                    fDate:= FileAge(strEmuFile);
                    fDateStr:= GetDateStr(fDate, True);
                    if fDateStr <> '' then
                       VersionDescription:= VersionDescription+' '+fDateStr;
                  end;
                idDemul:
                  begin
                    VersionDescription:= Trim(Copy(VersionDescription, PosEx(')', VersionDescription)+1, Length(VersionDescription)));
                    VersionDescription:= FormMain.GetArcadeEmulatorDescription(idDemul, False, strEmuFile)+' '+VersionDescription;
                    VersionDescription:= VersionDescription+' ('+Copy(BatchFile[1], 13, Length(BatchFile[1]))+')';
                    //VersionDescription:= Format('%s (%s)', [VersionDescription, Copy(BatchFile[1], 13, Length(BatchFile[1]))]);
                    //Delete(VersionDescription, (Pos('(', VersionDescription)-1), 18);
                    //VersionDescription:= Format('%s (%s)', [VersionDescription, Copy(BatchFile[1], 13, Length(BatchFile[1]))]);
                  end;
              end;
              FreeAndNil(BatchFile);
              DeleteFile(tempFile);
              Application.ProcessMessages;
            end;
       end;
  end;

  if VersionDescription = '' then
     VersionDescription:= 'Unknown';

  StoreResultIn:= VersionDescription;
  Result:= VersionDescription <> '';
  if isStatusOpened and Result then
     FormStatus.Visible:= True;
end;

