function TFormMain.GetBatchFileFieldIndex(ParameterIndex: String): String;
begin
  Result:= '-1';
  case StrToInt(ParameterIndex) of
    0: Result:= '0';  // description
    1: Result:= '9';  // name
    2: Result:= '10'; // clone of
