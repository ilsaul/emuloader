procedure TFormMain.MenuThumbnailSettingsClick(Sender: TObject);
begin
  FormThumbnailView:= TFormThumbnailView.Create(nil);
  FormThumbnailView.Tag:= 1;

  FormThumbnailView.IL_Thumbnail.Width:= IL_StandardIconsThumbnail.Width;
  FormThumbnailView.IL_Thumbnail.Height:= IL_StandardIconsThumbnail.Height;

  AddDefaultIcons(GetELGameIconFileName(0), GetFolderFull(33), FormThumbnailView.IL_Thumbnail); // parent MAME
  AddDefaultIcons(GetELGameIconFileName(22), GetFolderFull(33), FormThumbnailView.IL_Thumbnail); // parent HBMAME

  FormThumbnailView.ELV_ThumbnailPreview.CellSizes.Thumbnail.Width:= ThumbnailSettings.Width;
  FormThumbnailView.ELV_ThumbnailPreview.CellSizes.Thumbnail.Height:= ThumbnailSettings.Height;

  AssignRGBQuickEditPopupToColorBoxEx(FormThumbnailView.BorderColor);

  FormThumbnailView.ShowModal;
  if FormThumbnailView.iModalResult = mrOk then
     begin
       ThumbnailSettings.Width:= FormThumbnailView.GridWidthSize.Position;
       ThumbnailSettings.Height:= FormThumbnailView.GridHeightSize.Position;
       if FormThumbnailView.IL_Thumbnail.Width <> IL_StandardIconsThumbnail.Width then
          begin
            IL_StandardIconsThumbnail.Width:= FormThumbnailView.IL_Thumbnail.Width;
            IL_StandardIconsThumbnail.Height:= FormThumbnailView.IL_Thumbnail.Height;
            if IsThumbnailView then
               begin
                 GamesListView.BeginUpdate;
                 AddGamesSystemsIcons(IL_StandardIconsThumbnail, False);
                 GamesListView.EndUpdate;
               end;
          end;
     end;
  FreeAndNil(FormThumbnailView);
end;

procedure TFormMain.PopupThumbDeleteSelectedGameSnapshotClick(
  Sender: TObject);
begin
  if not IsThumbnailView then
     Exit;
  if CheckMultipleSelected(GamesListView) then
     Exit;

  if not CheckSelected(GamesListView) then
     Exit;

  if TEasyGameInfo(SelectedEasyItem).eThumbnailLoaded and (not TEasyGameInfo(SelectedEasyItem).eThumbnailIsZipped) then
     begin
       if not Assigned(FormImageDeleteRename) then
          FormImageDeleteRename:= TFormImageDeleteRename.Create(nil);
       FormImageDeleteRename.Tag:= 0; // 0 -> delete image; 1 -> rename image
       FormImageDeleteRename.ImageFileName:= TEasyGameInfo(SelectedEasyItem).eThumbnailFileName;
       FormImageDeleteRename.ImageCategoryIcon.Tag:= 1; // always "in-game snapshot" image category
       FormImageDeleteRename.ShowModal;
       if FormImageDeleteRename.mmResult = mrOk then
          begin
            GamesListView.BeginUpdate;
            DeleteFileW(PWideChar(TEasyGameInfo(SelectedEasyItem).eThumbnailFileName));
            ClearThumb(SelectedEasyItem);
            SelectedEasyItem.Initialized:= False;
            GamesListView.EndUpdate;
            Sleep(50);
          end;
       FreeAndNil(FormImageDeleteRename);
     end;
end;

