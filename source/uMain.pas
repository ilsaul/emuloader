        end
        else
        begin
          if ImageDetails[1].ImageCategoryIndex_AllSystems <> -1 then
             ImgZipParseFilesSoftwareList(sysID, ImageDetails[1].ImageCategoryIndex_AllSystems, SoftwareNameIndex, SoftwareName);

          for imgLoop:=2 to MaxImagePanels do
