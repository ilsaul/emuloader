procedure TFormMain.FormShow(Sender: TObject);
var
  GamesListFound: packed array[1..MaxArcadeSystems] of Boolean;
  //CustomGamesListFound: packed array[1..MaxConsoleComputerSystems] of Boolean;
  Loop, NewDateTime: Integer;
  ErrorStr, ErrorMsgTitle: String;
  tmpString: String;
  Continue, ScanModeSelected, IsFirstTimeRun: Boolean;
  iVersion: String;
  CreateListArcade, CreateListConsoleComputer: Boolean;
  //IsFreshInstall: Boolean;
  //MachinesList: TStringList;

  function ShowScanModeSelectDialog: Boolean;
  begin
    Result:= not ScanModeSelected;
    if Result then
       begin
         PopupSelectScanGamesMode.Click;
         ScanModeSelected:= True;
       end;
  end;

  function SetMAMEBuild(sysID: Byte; IsAlterMAME: Boolean = False): Boolean;
  begin
    Result:= IsMAMEBasedSys(sysID); // sysID = idMAME;
    if not Result then
       Exit;
    case IsAlterMAME of
      True : buildAlterMAME:= iVersion;
      False:
        begin
          case sysID of
            idMAME: buildMAME:= iVersion;
            idHBMAME: buildHBMAME:= iVersion;
          end;
        end;
    end;
  end;

  function UpdateEmulatorVersionInfo(sysID: Byte; IsAlterMAME: Boolean = False): Boolean;
  begin
    if IsAlterMAME then
       Result:= AlterMAMEFile <> ''
    else
       Result:= EmulatorFile[sysID] <> '';
    if not Result then
       Exit;

    if IsAlterMAME then
       NewDateTime:= FileAgeW(AlterMAMEFile)
    else
       NewDateTime:= FileAgeW(EmulatorFile[sysID]);
    Application.ProcessMessages;
    Result:= NewDateTime <> -1;
    if not Result then
       Exit;

    if IsAlterMAME then
       begin
         Result:= AlterMAMEDateTime <> NewDateTime;
         if Result then
         begin
           AlterMAMEDateTime:= NewDateTime;
           GetArcadeEmulatorVersion(sysID, AlterMAMEFile, AlterMAMEVersion, iVersion);
           SetMAMEBuild(sysID, True);
         end;
       end
    else
       begin
         Result:= EmulatorDateTime[sysID] <> NewDateTime;
         if Result then
         begin
           EmulatorDateTime[sysID]:= NewDateTime;
           GetArcadeEmulatorVersion(sysID, EmulatorFile[sysID], EmulatorVersion[sysID], iVersion);
           SetMAMEBuild(sysID);
         end;
       end;
  end;

  function CallCreateGamesList(SystemID: ShortInt): Boolean;
  begin
    // for fresh install, create games list call
    // for MAME/HBMAME

    Result:= True;
    case ValidateArcadeEmulatorFile(SystemID) of
      True : SetCurrentDir(ExtractFilePath(EmulatorFile[SystemID]));
      False: Exit;
    end;

    ShowScanModeSelectDialog;
    CreateGamesListMAME(SystemID);
    GamesListFound[SystemID]:= False;

    SetCurrentDir(FrontendPath);
  end;

  function CallCreateGames2(sysID: ShortInt): Boolean;
  begin
    // fresh install, create games list call (non MAME emulators)
    Result:= True;
    GamesListFound[sysID]:= not ValidateArcadeEmulatorFile(sysID);
    if not GamesListFound[sysID] then
       RunCreateGamesSysArcade(sysID);
  end;

  function CreateGamesFirstRunArcade(SystemID: ShortInt): Boolean;
  begin
    Result:= True;
    case IsMAMEBasedSys(SystemID) of
      True : CallCreateGamesList(SystemID); // MAME based only
      False: CallCreateGames2(SystemID); // other arcade systems
    end;
  end;

  function CreateGamesFirstRunConsoleComputer: Boolean;
  var
    cLoop: Integer;
    IgnoreFileExtension: THashedStringList;
  begin
    Result:= True;
    IgnoreFileExtension:= THashedStringList.Create;
    PopulateIgnoreFileExt_ConsoleComputer(IgnoreFileExtension);
    for cLoop:=1 to MaxConsoleComputerSystems do
    begin
      CreateCustomGamesList(cLoop, True, IgnoreFileExtension, False);
      if MenuCreateCustomGamesList.HelpContext = 1 then
         Break;
    end;
    FreeAndNil(IgnoreFileExtension);
  end;

  function ForceApplicationTerminate: Boolean;
  begin
    Result:= True;
    TerminateEmuLoader:= True;
    Application.Terminate;
    PostMessage(Handle, wm_Close, 0, 0);
  end;

  function ReadSettingsCleanInstall: Boolean;
  var
    extraIni: TMemIniFile;
  begin
    if not FileExists(GetFrontendExtraIniFile) then
       Exit;
    extraIni:= TMemIniFile.Create(GetFrontendExtraIniFile);

    FormCleanInstallGuide.Option_SelectArcadeEmulators.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'SelectArcadeEmulators', 1));
    FormCleanInstallGuide.Option_CreateArcadeGamesList.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'CreateArcadeGamesList', 1));
    FormCleanInstallGuide.Option_SelectConsoleComputerEmulators.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'SelectConsoleComputerEmulators', 1));
    FormCleanInstallGuide.Option_SelectConsoleComputerGamesFolders.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'SelectConsoleComputerGamesFolders', 1));
    FormCleanInstallGuide.Option_CreateConsoleComputerGamesList.Checked:= Boolean(extraIni.ReadInteger('CleanInstall', 'CreateConsoleComputerGamesList', 1));

    FreeAndNil(extraIni);
  end;

  function WriteSettingsCleanInstall: Boolean;
  var
    extraIni: TMemIniFile;
  begin
    if (not FormCleanInstallGuide.Option_SelectArcadeEmulators.Checked) and
       (not FormCleanInstallGuide.Option_CreateArcadeGamesList.Checked) and
       (not FormCleanInstallGuide.Option_SelectConsoleComputerEmulators.Checked) and
       (not FormCleanInstallGuide.Option_SelectConsoleComputerGamesFolders.Checked) and
       (not FormCleanInstallGuide.Option_CreateConsoleComputerGamesList.Checked) then
       Exit; // if none of the options are selected, do not update the .ini file

    if CheckReadOnly(GetFrontendExtraIniFile) then
       Exit;
    try
      extraIni:= TMemIniFile.Create(GetFrontendExtraIniFile);

      extraIni.WriteInteger('CleanInstall', 'SelectArcadeEmulators', Ord(FormCleanInstallGuide.Option_SelectArcadeEmulators.Checked));
      extraIni.WriteInteger('CleanInstall', 'CreateArcadeGamesList', Ord(FormCleanInstallGuide.Option_CreateArcadeGamesList.Checked));
      extraIni.WriteInteger('CleanInstall', 'SelectConsoleComputerEmulators', Ord(FormCleanInstallGuide.Option_SelectConsoleComputerEmulators.Checked));
      extraIni.WriteInteger('CleanInstall', 'SelectConsoleComputerGamesFolders', Ord(FormCleanInstallGuide.Option_SelectConsoleComputerGamesFolders.Checked));
      extraIni.WriteInteger('CleanInstall', 'CreateConsoleComputerGamesList', Ord(FormCleanInstallGuide.Option_CreateConsoleComputerGamesList.Checked));

      extraIni.UpdateFile;
    finally
      FreeAndNil(extraIni);
    end;
  end;

begin
  if TerminateEmuLoader then
     begin
       ForceApplicationTerminate;
       Exit;
     end;
     
  ScanModeSelected:= False;
  ErrorMsgTitle:= 'Error: Startup';
  //AbortExecution:= True;
  IsFirstTimeRun:= False;
  CreateListArcade:= False;
  CreateListConsoleComputer:= False;
  for Loop:=1 to MaxArcadeSystems do
      GamesListFound[Loop]:= True;

  //for Loop:=1 to MaxConsoleComputerSystems do
  //    CustomGamesListFound[Loop]:= True; // this is not needed since EmuCon games do not need ROM/CHD validation

