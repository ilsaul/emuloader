  function ParseVideoEntry: Boolean;
  begin
    Result:= True;
    // build 0.106u9 down to 0.75
    if GetScreenRes then
       Exit; // already got the video info

    GetScreenRes:= True;
    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'screen');
    if TempString <> '' then
       TempGameVars.eScreenType:= Ord(TempString = 'vector');

    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'orientation');
    if TempString <> '' then
       TempGameVars.eScreenOrientation:= Ord(TempString = 'vertical');

    TempString:= XML_GetEntryValue(FileLine, 'width');
    if TempString <> '' then
       TempGameVars.eScreenResolution:= TempString+'x'+XML_GetEntryValue(FileLine, 'height');

    TempString:= XML_GetEntryValue(FileLine, 'refresh');
    if TempString <> '' then
       TempGameVars.eScreenRefreshRate:= TempString;
  end;

  function ParseDisplayEntry: Boolean;
  begin
    Result:= True;
    // for 0.106u12 and newer
    if GetScreenRes then
       Exit; // already got the screen info

    GetScreenRes:= True;
    TempString:= XML_GetEntryValue(FileLine, 'type');
    if TempString <> '' then
       TempGameVars.eScreenType:= GetScreenTypeIndex(TempString);

    TempString:= XML_GetEntryValue(FileLine, 'rotate');
    if TempString = '' then
       TempString:= '-1';

    case StrToInt(TempString) of
       0, 180: TempGameVars.eScreenOrientation:= 0; // horizontal
      90, 270: TempGameVars.eScreenOrientation:= 1; // vertical
    end;

    TempString:= '';
    case TempGameVars.eScreenOrientation of
      -1, 0: TempString:= XML_GetEntryValue(FileLine, 'width'); // horizontal orientation
          1: TempString:= XML_GetEntryValue(FileLine, 'height'); // vertical orientation
    end;
    if TempString <> '' then
       begin
         case TempGameVars.eScreenOrientation of
           -1, 0: TempGameVars.eScreenResolution:= TempString+'x'+XML_GetEntryValue(FileLine, 'height'); // horizontal orientation
               1: TempGameVars.eScreenResolution:= TempString+'x'+XML_GetEntryValue(FileLine, 'width'); // vertical orientation
         end;
       end;

    TempString:= XML_GetEntryValue(FileLine, 'refresh');
    if TempString <> '' then
       TempGameVars.eScreenRefreshRate:= TempString;
  end;

  function ParseSaveStateInfo: Boolean;
  begin
    TempString:= XML_GetEntryValue(FileLine, 'savestate');
    Result:= TempString <> '';
    if TempString <> '' then
       begin
         // supported|unsupported (from -listxml output)
         Result:= SameText(TempString, 'supported');
         TempGameVars.eSaveState:= Ord(Result);
       end;
  end;
  
  function ParseDriverStatusInfo: Boolean;
  begin
    Result:= True;
    TempGameVars.eDriverStatus:= SetIntegerValue('status', True);
    TempGameVars.eEmulationStatus:= SetIntegerValue('emulation', True);
    TempGameVars.eColorStatus:= SetIntegerValue('color', True);
    TempGameVars.eSoundStatus:= SetIntegerValue('sound', True);
    TempGameVars.eGraphicStatus:= SetIntegerValue('graphic', True);
    ParseSaveStateInfo;
  end;

  function ParseFeatureInfo: Boolean;
  var
    FeatureStr: String;
  begin
    // added August 28, 2017
    Result:= True;
    TempString:= XML_GetEntryValue(FileLine, 'type');
    if SameText(TempString, 'sound') then
       begin
         if TempGameVars.eSoundStatus = -1 then // <driver entry always comes first... if that changes, hell with brake loose!!!
            begin
              FeatureStr:= XML_GetEntryValue(FileLine, 'status');
              if FeatureStr = '' then
                 FeatureStr:= XML_GetEntryValue(FileLine, 'overall');

              if FeatureStr <> '' then
                 begin
                   if SameText(FeatureStr, 'unemulated') then
                      FeatureStr:= 'preliminary';
                   TempGameVars.eSoundStatus:= GetStatusIndex(FeatureStr);
                 end;
            end;
       end
    else
    if SameText(TempString, 'graphics') then
       begin
         if TempGameVars.eGraphicStatus = -1 then // <driver entry always comes first... if that changes, hell with brake loose!!!
            begin
              FeatureStr:= XML_GetEntryValue(FileLine, 'status');
              if FeatureStr = '' then
                 FeatureStr:= XML_GetEntryValue(FileLine, 'overall');

              if FeatureStr <> '' then
                 begin
                   if SameText(FeatureStr, 'unemulated') then
                      FeatureStr:= 'preliminary';
                   TempGameVars.eGraphicStatus:= GetStatusIndex(FeatureStr);
                 end;
            end;
       end;
  end;

  function ParseMainCPUInfo: Boolean;
  begin
    if CPUisAdded then
       Exit;
    TempString:= XML_GetEntryValue(FileLine, 'tag');
    if ((TempString = 'maincpu') or
        (TempString = ':maincpu')) then
       begin
         CPUisAdded:= True;
         ListCPU.Add(TempGameVars.eName+'='+XML_GetEntryValue(FileLine, 'name'));
       end;
  end;
  
  function ParseAudioDiscrete: Boolean;
  begin
    Result:= True;
    if IsDiscreteAudio then
       Exit; // if game is tagged as discrete audio, there's no need to check it again... it saves some CPU cycles !!! :)
    TempString:= XML_GetEntryValue(FileLine, 'name');
    if SameText(TempString, 'discrete') then
       begin
         IsDiscreteAudio:= True;
         TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
       end;
  end;

  function ParseDeviceRef: Boolean;
  var
    LoopDevice, DeviceIndex: Integer;
  begin
    Result:= True;
    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'name');
    if SameText(TempString, 'discrete') then
       begin
         IsDiscreteAudio:= True;
         TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
         Exit;
       end;
    if SameText(TempString, 'software_list') then
       Exit;

    DeviceIndex:= ListROMsDeviceSet.IndexOf('['+TempString+']');
    if DeviceIndex <> -1 then
       begin
         TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(GetDeviceSetSize(TempString));
         ListDeviceROMsGame.WriteString(TempGameVars.eName, TempString, '1');
         //DeviceIndex:= ListROMsDeviceSet.IndexOf('['+TempString+']');
         //if DeviceIndex <> -1 then
         //   begin
              for LoopDevice:= DeviceIndex+1 to ListROMsDeviceSet.Count-1 do
              begin
                if ListROMsDeviceSet[LoopDevice] = '' then
                   Break
                else
                   begin
                     if not ROMsHeaderAdded then
                        begin
                          if ROMsList.Count > 0 then
                             ROMsList.Add('');
                          ROMsList.Add('['+TempGameVars.eName+']');
                          ROMsHeaderAdded:= True;
                        end;
                     ROMsList.Add(ListROMsDeviceSet[LoopDevice]); // add the device ROM into the game set; this must contain the full new ROM info from "ROMInfoFull" var
                                                                  // the ROMInfoFull var is filled and added to "ListROMsDeviceSet" in ParseROMDiskEntry() function
                   end;
              end;
         //   end
         //else // not needed anymore as EL no longer add device sets with no ROMs ???
         //   GenerateMessage(TitleErrorMsg, 'Device set not found.', 'Could not find the device set to extract the ROMs list!'+#13#10+
         //                    'Game Name: '+TempGameVars.eName+#13#10+
         //                    'Device Set: '+TempString, 2, False, 1);
       end;
  end;

  function ParseROMDiskEntry(FileID: ShortInt): Boolean; // FileID (type of ROM being scanned) -> 1: Device; 2: BIOS; 0: Game
  var
    FixedID, newFileID, IsBadDump: ShortInt; //IndexCHD
    ROMInfoFull, BiosInfoROM: String;
  begin
    ROMInfoFull:= '';
    RegionTagStr:= '';
    newFileID:= FileID;
    romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD
    romName:= DecodeHTML(romName);

    romCRC32:= XML_GetEntryValue(FileLine, 'crc');
    romSHA1:= XML_GetEntryValue(FileLine, 'sha1');

    IsCHDFile:= PosEx('<disk ', FileLine) <> 0;

    IsOptionalROM:= PosEx('optional="yes"', FileLine) <> 0;

    romNameMerge:= XML_GetEntryValue(FileLine, 'merge'); // name of the file (ROM/CHD/Cart/Floppy/Cassette/Disc...) from parent game
    romNameMerge:= DecodeHTML(romNameMerge);

    //if IsUnicodeStr(romName) then
    //   ShowMessage('unicode ROM name: '+romName+#13#10+'game name: '+TempGameVars.eName);

    if not IsCHDFile then
    begin
      if MAMEVersionNumber >= 130 then
       begin
         if (iDriver = 'segas24') or (iDriver = 'decocass') or (iDriver = 'ksys573') then
            RegionTagStr:= XML_GetEntryValue(FileLine, 'region');
       end;

      TempString:= romName+' == '+romCRC32+' == '+romSHA1;
      if ListDuplicateROMs.IndexOf(TempString) = -1 then
         ListDuplicateROMs.Add(TempString)
      else
         Exit; // file already added in the ROMs list... skip it
    end;

    if IsCHDFile then
       begin
         RegionTagStr:= XML_GetEntryValue(FileLine, 'region');
         case FileID of
           0: newFileID:= 12; // IndexCHD:= 12; // Game CHD files have '3' in front
           1: newFileID:= 13; // IndexCHD:= 13; // Device CHD files have '5' in front
           2: newFileID:= 14; // IndexCHD:= 14; // BIOS CHD files have '4' in front
         else
              newFileID:= 12; // IndexCHD:= 12; // default value is Game CHD!
         end;

         // romName:= IndexCHD+romName; // CHD files have '#' in front // '3 wargods.chd' (commented September 07, 2016)

         TempGameVars.eMediaType:= 1;
         if romNameMerge <> '' then
            begin
              if not SameText(ExtractFileExt(romNameMerge), '.chd') then
                 romNameMerge:= romNameMerge+'.chd';
            end;
         if not SameText(ExtractFileExt(romName), '.chd') then
            romName:= romName+'.chd';

         if romSHA1 = '' then
            romSHA1:= XML_GetEntryValue(FileLine, 'md5'); // for MAME 0.77 down to 0.69
       end
    else
       begin
         // FileID -> 1: Device; 2: BIOS; 0: Game
         // (commented September 07, 2016)
         //if FileID <> 0 then // device/bios sets parsing (1st, 2nd pass parse)
         //   romName:= IntToStr(FileID)+' '+romName; // '1 ' in front means it's a Device ROM
       end;

    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'size');
    if TempString <> '' then
       TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(TempString);
    TempString:= '';

    IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
    ROMInfoFull:= MountROMInfo(newFileID, 0, IsCHDFile, romName, romCRC32, romSHA1, IsBadDump);

    if FileID = 0 then
       begin
         FixedID:= newFileID;
         // check is ROM is a bios ROM or normal ROM ... for games parsing only (4th pass parse)
         if FormMain.ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) then
            begin
              // here, I need to check for "BiosInfoROM=BiosName"
              BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;
              //if ListROMsBiosSet.IndexOf(TempString+'='+TempGameVars.eBiosName) <> -1 then
              if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                 begin
                   // ROMInfoFull:= 01 ; 02; 03; 04;... 20 (two chars, pos1 and pos2)
                   case IsCHDFile of
                     True : newFileID:= 14; // ROMInfoFull[2]:= '4'; // it's a bios CHD, change ID to #14
                     False: newFileID:= 02; // ROMInfoFull[2]:= '2';// it's a bios ROM, change ID to #2
                   end;
                 end
              else
                 begin
                   if not IsCHDFile then
                      newFileID:= 00;

                   if romNameMerge <> '' then
                      ROMInfoFull[6]:= '1';
                 end;
            end
         else
            begin
              if not IsCHDFile then
                 newFileID:= 00;

              if romNameMerge <> '' then
                 ROMInfoFull[6]:= '1';
            end;
         if newFileID <> FixedID then
            begin
              // update the file entry with the new FileID tag
              TempString:= Format('%.2u', [newFileID]);
              ROMInfoFull[1]:= TempString[1];
              ROMInfoFull[2]:= TempString[2];
              TempString:= '';
            end;
       end;

    if FileID = 2 then // parsing bios sets
       BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;

    if not ROMsHeaderAdded then
       begin
         if ROMsList.Count > 0 then
            begin
              ROMsList.Add('');
              case FileID of
                1: ListROMsDeviceSet.Add(''); // temp device ROMs list!!!
                2: ListROMsBiosSet.Add(''); // temp bios ROMs list!!!
              end;
            end;
         ROMsList.Add('['+TempGameVars.eName+']');
         if FileID = 1 then // for Device parse only
            ListROMsDeviceSet.Add('['+TempGameVars.eName+']'); // temp device ROMs list!!!
         ROMsHeaderAdded:= True;
       end;

    // here I need to check the region="" tag and change it
    if RegionTagStr <> '' then
       begin
         FixedID:= FixFileIDRegionROMCHD(newFileID, RegionTagStr, iDriver, IsCHDFile);
         if FixedID <> newFileID then
            begin
              TempString:= Format('%.2u', [FixedID]);
              ROMInfoFull[1]:= TempString[1];
              ROMInfoFull[2]:= TempString[2];
              TempString:= '';
            end;
       end;
    if SameText(romNameMerge, romName) then
       romNameMerge:= ''; // set to emtpy since the name is the same as of the file from parent game

    //ROMInfoFull --> 020000<name>sp-u2.sp1/><crc>e72943de/><sha1>5c6bba07d2ec8ac95776aa3511109f5e1e2e92eb/>
    if romNameMerge <> '' then
       ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('parentname', romNameMerge);

    if IsOptionalROM then
       ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('optional', '1');

    ROMsList.Add(ROMInfoFull);
    
       //ROMsList.Add(ROMInfoFull+'<parentname>'+romNameMerge+'/>');
       // [konam80a]
       // 1510<name>826aaa01.chd/><sha1>be5f8b31fd18ba631fe98c2132c56abf20193419/><parentname>826eaa01.chd/>
                                                                    // TempString here is the SHA-1 / MD5 checksum
       //ROMsList.Add(romName+'_"parentchd"_'+DiskMergeFileName+'='+TempString);

    case FileID of
      1: ListROMsDeviceSet.Add(ROMInfoFull); // temp device ROMs list!!! This must contain the full new ROM info from "ROMInfoFull" var
      2: ListROMsBiosSet.Add(BiosInfoROM); // 04399ab8=neogeo ----temp bios ROMs list (CRC32 only, MD5 for MAME 0.159 and newer... CHDs)!!!
    end;
    //ListROMsBiosSet: --> <name>sp-u2.sp1<crc>e72943de<sha1>5c6bba07d2ec8ac95776aa3511109f5e1e2e92eb=neogeo

    if FileID = 1 then // changed June 03, 2015
       HasROMs:= True; // this is used only when creating device sets list!!!!!
  end;

begin
  EmuTitle:= GetArcadeEmulatorDescription(sysID, True);
  TitleErrorMsg:= 'Error: Create Games List ['+EmuTitle+']';

  FormStatus.SetProgressPos(0);
  //FormStatus.TitleStr('Create Games List: '+EmulatorVersion[sysID]);

  tempFile:= GetArcadeSystemIniSection(sysID, True)+'_listxml.xml';
  IsGameEntry:= True;

  Result:= True;

  WarningMessagesList:= THashedStringList.Create;
  WarningMessagesList.BeginUpdate;
  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(GetGamesFolderEL+tempFile);

  if ListXML.Count > 0 then
  begin
    FormStatus.MessageStr('Parsing "'+tempFile+'" (1st pass).'+#13#10+
                            'Creating device sets list.');

    ListCPU:= THashedStringList.Create;
    //if FileExists(GetIniFilesFolder+'cpu.ini') then
    //   begin
    //     tempCPU:= TMemIniFile.Create(GetIniFilesFolder+'cpu.ini');
    //     if tempCPU.SectionExists(GetSystemIniSection(sysID, True)) then
    //        begin
    //          tempCPU.EraseSection(GetSystemIniSection(sysID, True));
    //          tempCPU.UpdateFile;
    //        end;
    //     FreeAndNil(tempCPU);
    //     ListCPU.LoadFromFile(GetIniFilesFolder+'cpu.ini');
    //     if ListCPU.Count > 0 then
    //        begin
    //          if ListCPU[ListCPU.Count-1] <> '' then
    //             ListCPU.Add(' ');
    //        end;
    //   end;
    //ListCPU.Add('['+GetSystemIniSection(sysID, True)+']');
  end;

  ListSamples:= THashedStringList.Create;
  ListSamples.BeginUpdate;

  ListROMsDeviceSet:= THashedStringList.Create; // will hold a temp list of ROMs for each device set

  DeviceSetSize:= THashedStringList.Create; // will hold device sets with their ROMs size "devicename=size"
  ListDeviceROMsGame:= TMemIniFile.Create(GetDeviceSetsFile(sysID));
  ListROMsBiosSet:= THashedStringList.Create; // will hold a temp list of ROMs for each bios set

  ListDuplicateROMs:= THashedStringList.Create; // will hold a temp list of ROMs to check for duplicates (CHDs are out of this list)
                                                // romname == CRC32 == SHA1

  BiosSet:= TMemIniFile.Create(GetBiosSetFile(sysID));

  Application.ProcessMessages;
  FormStatus.SetFocus;
  if ListXML.Count > 0 then
  begin
    //DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID));
    //for MainLoop:=1 to 4 do
    //    DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID, MainLoop));

    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));
    ListGames.WriteString('info_file', 'description', '');

    ROMsList:= THashedStringList.Create;
    ROMsList.BeginUpdate;

    GetScreenRes:= False;
    CPUisAdded:= False;

    // start parsing device sets here!!!!

    IsResource:= False;
    ListROMsDeviceSet.BeginUpdate;
    DeviceSetSize.BeginUpdate;
    ListROMsBiosSet.BeginUpdate;
    // first tricky part, get all device sets before any game or bios
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
         begin
           GameIsDeviceSet:= IsDeviceSet;
           if GameIsDeviceSet then // isdevice="yes"
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                ROMsDetailsLine:= '';
                TempString:= '';
                SampleName:= '';

                Delete(FileLine, 1, 6);
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                // fix driver name only for device sets!!!!!
                TempGameVars.eDriverName:= FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile'));
                
                TempGameVars.eMechanical:= IsMechanical;//(FileLine);
                SampleName:= XML_GetEntryValue(FileLine, 'sampleof');
                TempGameVars.eGameSetStatus:= 2; // missing

                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');

                if (TempGameVars.eClone = '') and (ROMOf <> '') then
                   TempGameVars.eClone:= ROMOf;
                   
                HasROMs:= False;
                GetScreenRes:= False;
                ROMsHeaderAdded:= False;
                IsDiscreteAudio:= PosEx('discrete', LowerCase(TempGameVars.eDriverName)) <> 0; // for UME and MAME 0.162+
                if IsDiscreteAudio then
                   TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
                TempString:= '';

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
                ListDuplicateROMs.BeginUpdate;
                IsResource:= True;
              end;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              begin
                TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15));
              end
           else
           // detection of CHD for device sets... MAME 0.159 - February 28, 2015
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then // device "<disk" entry for MAME 0.159 and newer
              ParseROMDiskEntry(1)
           else
           if XML_CheckData(FileLine, '<sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, '<chip type="cpu" ') then
              ParseMainCPUInfo
           else

           if XML_CheckData(FileLine, '<chip type="audio" ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, '<display ') then
              ParseDisplayEntry
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                TempGameVars.eControls:= XML_GetEntryValue(FileLine, 'control');
                GetButtonsEntry(False); // get buttons count (for MAME v0.172 and older)
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // 0.107 to 0.139 use type="joy4way"... etc
                // for 0.144 and newer, get type="joy" and "ways="; "ways2="; "ways3="
                TempString:= XML_GetEntryValue(FileLine, 'type');
                if TempString <> '' then
                begin
                  if GetNewControlTags(TempString) then // will get new control tags "joy" "ways=?" only if there is "type" in <control entry!!!
                     GetButtonsEntry(True); // for MAME v0.173 and newer (no more buttons="" tag in "<input" entry need to sum all buttons (includes buttons frp, keypad, keyboard, mahjong)
                     // only add if control is not found in "eControls" to avoid duplicating buttons count!!!! April 27, 2016
                end;
              end
           else
           {if XML_CheckData(FileLine, '<dipswitch ') then
              begin
                // do nothing... added this check to make parsing a little bit faster
                // it makes no difference... June 06, 2016
              end
           else
           if XML_CheckData(FileLine, '</dipswitch>') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else}
           if XML_CheckData(FileLine, '<driver ') then
              ParseDriverStatusInfo
           else
           if XML_CheckData(FileLine, '<feature ') then
              ParseFeatureInfo
           else
           //if CheckDeviceTag(True) then // no longer used!!!! June 09, 2015
           //   begin
           //     TempGameVars.eSystemType:= 1;
           //   end
           //else
           //if XML_CheckData(FileLine, '<softwarelist ') then // no need to check for software lists in device sets... yet!
           //   begin
           //   end
           //else
           if XML_CheckData(FileLine, '</machine>') or XML_CheckData(FileLine, '</game>') then
              begin
                // device ID
                case sysID of
                  idMAME  : TempGameVars.eROMIdentification:= 07; // MAME
                  idHBMAME: TempGameVars.eROMIdentification:= 29; // HBMAME
                end;
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;

                if HasROMs or (MenuAddMAMEDeviceSetsWithNoROMs.Tag = 1) then // prevent from adding device sets with no ROMs... pointless to Emu Loader
                   begin
                     ROMDataLine:= PopulateROMDataLineArcade; // new populate with new list format
                     //ShowMessage(ROMDataLine);
                     ListGames.WriteString('devices', TempGameVars.eName, ROMDataLine);
                     GameStatusList.Add(PopulateGameStatusDataLine);
                                        
                     if TempGameVars.eGameSize > 0 then
                        DeviceSetSize.Add(TempGameVars.eName+'='+IntToStr(TempGameVars.eGameSize)); // fix May 17, 2015 (add game size of device set for games later)
                   end;
                // not used anymore... ? June 06, 2016
                //if not HasROMs then
                //   begin
                //     //DevicesWithNoROMs.Add(TempGameVars.eName);
                //     //DeviceSetSize.Add(TempGameVars.eName+'='+IntToStr(TempGameVars.eGameSize));
                //   end;
                //if ListDuplicateROMs.Count > 0 then
                //   ShowMessage('device "'+TempGameVars.eName+'": '+TempGameVars.eTitle+#13#10+#13#10+ListDuplicateROMs.Text);
                ListDuplicateROMs.Clear;
                ListDuplicateROMs.EndUpdate;

                iDriver:= '';
                IsResource:= False;
              end;
         end;
      Application.ProcessMessages;
    end;
    ListGames.UpdateFile;
    ListROMsDeviceSet.EndUpdate;
    //DevicesWithNoROMs.EndUpdate;
    DeviceSetSize.EndUpdate;

    // now the 2nd tricky part, get all bios sets before games
    FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass).'+#13#10+
                        'Creating BIOS sets list.');

    //FormStatus.SetProgressPos(0);
    IsResource:= False;
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
         begin
           if IsBiosSet then
              begin
                //addedSoftList:= False;
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                ROMsDetailsLine:= '';
                TempString:= '';
                SampleName:= '';
                Delete(FileLine, 1, 6);
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                TempGameVars.eBiosName:= TempGameVars.eName;
                TempGameVars.eMechanical:= IsMechanical;
                GameIsDeviceSet:= IsDeviceSet;
                TempGameVars.eGameSetStatus:= 2; // missing
                IsResource:= True;
                CPUisAdded:= False;
                GetScreenRes:= False;
                BiosTitleAdded:= False;
                DefaultBiosAdded:= False;
                ROMsHeaderAdded:= False;
                IsDiscreteAudio:= False;
                TempGameVars.eDriverName:= XML_GetEntryValue(FileLine, 'sourcefile');// FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile'));
                SampleName:= XML_GetEntryValue(FileLine, 'sampleof');

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');

                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');

                if (TempGameVars.eClone = '') and (ROMOf <> '') then
                   TempGameVars.eClone:= ROMOf;

                ListDuplicateROMs.BeginUpdate;
              end;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
                BiosSet.WriteString('Descriptions', TempGameVars.eName, TempGameVars.eTitle); // write description
                BiosTitleAdded:= True;
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              begin
                TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15));
              end
           else
           if XML_CheckData(FileLine, '<biosset ') then
              begin
                if not BiosTitleAdded then
                   begin
                     BiosSet.WriteString('Descriptions', TempGameVars.eName, TempGameVars.eTitle);
                     BiosTitleAdded:= True;
                   end;
                ROMsDetailsLine:= XML_GetEntryValue(FileLine, 'name'); // name of the biosset
                TempString:= DecodeHTML(XML_GetEntryValue(FileLine, 'description')); // description of the biosset
                if not DefaultBiosAdded then
                   begin
                     BiosSet.WriteString(TempGameVars.eName, 'default_bios', '');
                     DefaultBiosAdded:= True;
                   end;
                if PosEx('default="yes"', FileLine) <> 0 then
                   BiosSet.WriteString(TempGameVars.eName, 'default_bios', ROMsDetailsLine);
                BiosSet.WriteString(TempGameVars.eName, ROMsDetailsLine, TempString);
              end
           else
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then // bios "<disk" entry for MAME 0.159 and newer
              ParseROMDiskEntry(2)
           else
           if XML_CheckData(FileLine, '<device_ref ') then
              ParseDeviceRef
           else
           if XML_CheckData(FileLine, '<sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, '<chip type="cpu" ') then
              ParseMainCPUInfo
           else
           if XML_CheckData(FileLine, '<chip type="audio" ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, '<video ') then
              ParseVideoEntry // build 0.106u9 down to 0.70
           else
           if XML_CheckData(FileLine, '<display ') then
              ParseDisplayEntry // for 0.106u12 and newer
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                TempGameVars.eControls:= XML_GetEntryValue(FileLine, 'control');
                GetButtonsEntry(False); // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // 0.107 to 0.139 use type="joy4way"... etc
                // for 0.144 and newer, get type="joy" and "ways="; "ways2="; "ways3="
                TempString:= XML_GetEntryValue(FileLine, 'type');
                if TempString <> '' then
                begin
                  if GetNewControlTags(TempString) then // will get new control tags "joy" "ways=?" only if there is "type" in <control entry!!!
                     GetButtonsEntry(True); // for MAME v0.173 and newer (no more buttons="" tag in "<input" entry need to sum all buttons (includes buttons from keypad, keyboard, mahjong)
                      // only add if control is not found in "eControls" to avoid duplicating buttons count!!!! April 27, 2016
                end;
              end
           else
           {if XML_CheckData(FileLine, '<dipswitch ') then
              begin
                // it makes no difference (June 06, 2016)
                // do nothing... added this check to make parsing a little bit faster
              end
           else
           if XML_CheckData(FileLine, '</dipswitch>') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else}
           if XML_CheckData(FileLine, '<driver ') then
              ParseDriverStatusInfo
           else
           if XML_CheckData(FileLine, '<feature ') then
              ParseFeatureInfo
           else
           //if XML_CheckData(FileLine, '<softwarelist ') then // no need to check for software lists in BIOS sets... yet!
           //   begin
           //   end
           //else
           if XML_CheckData(FileLine, '</machine>') or XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty!!!
                // bios ID
                case sysID of
                  idMAME  : TempGameVars.eROMIdentification:= 06; // MAME
                  idHBMAME: TempGameVars.eROMIdentification:= 28; // HBMAME
                end;
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade; // new populate with new list format
                ListGames.WriteString('bios', TempGameVars.eName, ROMDataLine);
                GameStatusList.Add(PopulateGameStatusDataLine);

                //if ListDuplicateROMs.Count > 0 then
                //   ShowMessage('bios "'+TempGameVars.eName+'": '+TempGameVars.eTitle+#13#10+#13#10+ListDuplicateROMs.Text);
                ListDuplicateROMs.Clear;
                ListDuplicateROMs.EndUpdate;

                iDriver:= '';
                IsResource:= False;
              end;
         end;
      Application.ProcessMessages;
    end;
    ListROMsBiosSet.EndUpdate;
    BiosSet.UpdateFile;
    ListGames.UpdateFile;

    FreeAndNil(ListGames); // new code November 23
    tmpList:= THashedStringList.Create;
    tmpList.LoadFromFile(GetGamesFolderEL+GetSystemFileName(sysID));
    tmpList.BeginUpdate;

    // get name, cloneof, romof fields
    // if romof, check if a bios is part of the game (parent games only!)
    FormStatus.MessageStr('Parsing "'+tempFile+'" (3rd pass).'+#13#10+
                          'Creating parent games sections and a temporary list of parent games with BIOS.');
    games_bios:= THashedStringList.Create; // this will hold parent games that have bios
    games_bios.BeginUpdate;
    //FormStatus.SetProgressPos(0);
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
         begin
           if (PosEx('cloneof="', FileLine) = 0) then
              begin
                if (not IsBiosSet) and (not IsDeviceSet) then
                   begin
                     TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                     tmpList.Add(' ');
                     tmpList.Add('['+TempGameVars.eName+']');
                     tmpList.Add(TempGameVars.eName+'=');
                     ROMOf:= XML_GetEntryValue(FileLine, 'romof');
                     if ROMOf <> '' then
                        games_bios.Add(TempGameVars.eName+'='+ROMOf);
                   end;
              end;
         end;
      //FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1); // no need as 3rd pass is very fast (June 06, 2016)
      //Application.ProcessMessages; // re-enabled this!!!! ???????????????????????????????????????????
    end;
    games_bios.EndUpdate;
    //ListGames.UpdateFile;
    tmpList.EndUpdate;
    tmpList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID));
    FreeAndNil(tmpList);
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    FormStatus.MessageStr('Parsing "'+tempFile+'" (4th and final pass).'+#13#10+
                          'Creating games list.');
    FormStatus.SetProgressPos(0);

    // now, the normal games, but no resources this time (bios)
    IsGameEntry:= False;
    //IsMAME0107:= False;
    GetScreenRes:= False;
    CPUisAdded:= False;
    NeoGeoMemcardAdded:= False;
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<machine ') or XML_CheckData(FileLine, '<game ') then
      //if (Pos('<game ', FileLine) <> 0) then
         begin
           if ((not IsBiosSet) and
               (not IsDeviceSet)) then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                SampleName:= '';
                ROMsDetailsLine:= '';
                TempString:= '';
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');
                SampleName:= XML_GetEntryValue(FileLine, 'sampleof');
                TempGameVars.eDriverName:= XML_GetEntryValue(FileLine, 'sourcefile');//FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile'));
                TempGameVars.eMechanical:= IsMechanical;
                TempGameVars.eGameSetStatus:= 2; // missing
                ROMsHeaderAdded:= False;
                SoftListHeaderAdded:= False;
                MemcardsCount:= 0;
                IsGameEntry:= True;
                CPUisAdded:= False;
                IsDiscreteAudio:= PosEx('discrete', LowerCase(TempGameVars.eDriverName)) <> 0; // for UME and MAME v0.162+
                if IsDiscreteAudio then
                   TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
                GetScreenRes:= False;
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if Assigned(BiosSet) then
                       begin
                         if BiosSet.ValueExists('Descriptions', ROMOf) and (TempGameVars.eBiosName = '') then
                            TempGameVars.eBiosName:= ROMOf;
                       end;
                   end;

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
                ListDuplicateROMs.BeginUpdate;
              end
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              begin
                TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15));
              end
           else
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then
              ParseROMDiskEntry(0)
           else
           if XML_CheckData(FileLine, '<device_ref ') then
              ParseDeviceRef
           else
           if XML_CheckData(FileLine, '<sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, '<chip type="cpu" ') then
              ParseMainCPUInfo
           else
           if XML_CheckData(FileLine, '<chip type="audio" ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, '<video ') then
              ParseVideoEntry // build 0.106u9 down to 0.70
           else
           if XML_CheckData(FileLine, '<display ') then
              ParseDisplayEntry // for 0.106u12 and newer
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                TempGameVars.eControls:= XML_GetEntryValue(FileLine, 'control');
                GetButtonsEntry(False); // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // 0.107 to 0.139 use type="joy4way"... etc
                // for 0.144 and newer, get type="joy" and "ways="; "ways2="; "ways3="
                TempString:= XML_GetEntryValue(FileLine, 'type');
                if TempString <> '' then
                begin
                  if GetNewControlTags(TempString) then // will get new control tags "joy" "ways=?" only if there is "type" in <control entry!!!
                     GetButtonsEntry(True); // for MAME v0.173 and newer (no more buttons="" tag in "<input" entry need to sum all buttons (includes buttons from keypad, keyboard, mahjong)
                      // only add if control is not found in "eControls" to avoid duplicating buttons count!!!! April 27, 2016
                end;
              end
           else
           {if XML_CheckData(FileLine, '<dipswitch ') then
              begin
                // it makes no difference (June 06, 2016)
                // do nothing... added this check to make parsing a little bit faster
              end
           else
           if XML_CheckData(FileLine, '</dipswitch>') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else}
           if XML_CheckData(FileLine, '<driver ') then
              ParseDriverStatusInfo
           else
           if XML_CheckData(FileLine, '<feature ') then
              ParseFeatureInfo
           else
           {if CheckDeviceTag then // no longer used...? June 06, 2016
              begin
                TempGameVars.eSystemType:= 1;
              end
           else}
           if XML_CheckData(FileLine, '<device type="memcard" ') then
              ParseMemCardDeviceTag(MainLoop)
           else
           if XML_CheckData(FileLine, '<softwarelist ') then
              begin
                TempString:= XML_GetEntryValue(FileLine, 'name');
                TempString2:= XML_GetEntryValue(FileLine, 'filter');
                if not IsMultiSlotSoftwareList(TempString) then
                   begin
                     //TempGameVars.eSystemType:= 1;
                     AddSoftListEntry(TempString, TempString2); // add to machines list
                     AddToListSoftwareListXML(TempString);

                     AddSoftwareListMachine(TempString, TempGameVars.eName); // add to software names list with supported machines
                   end;
                if TempGameVars.eName = 'vectrex' then // vectrex is not arcade...
                   begin
                     AddSoftListEntry(TempString, TempString2);
                     AddToListSoftwareListXML(TempString);
                     AddSoftwareListMachine(TempString, TempGameVars.eName);
                   end;
                TempString:= '';
                TempString2:= '';
              end
           else
           if XML_CheckData(FileLine, '</machine>') or XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty!!!
                // must verify if is clone or parent, neogeo or classic, raster or vector
                if TempGameVars.eClone = '' then
                   begin
                     // it's a parent game
                     case sysID of
                       idMAME  : TempGameVars.eROMIdentification:= 04; // MAME Parent
                       idHBMAME: TempGameVars.eROMIdentification:= 26; // HBMAME Parent
                     end;
                   end
                else
                   begin
                     // it's a clone game
                     case sysID of
                       idMAME  : TempGameVars.eROMIdentification:= 05; // MAME Clone
                       idHBMAME: TempGameVars.eROMIdentification:= 27; // HBMAME Clone
                     end;
                   end;
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);

                //if ListDuplicateROMs.Count > 0 then
                //   ShowMessage('game "'+TempGameVars.eName+'": '+TempGameVars.eTitle+#13#10+#13#10+ListDuplicateROMs.Text);
                iDriver:= '';
                ListDuplicateROMs.Clear;
                ListDuplicateROMs.EndUpdate;
                
                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    ListDeviceROMsGame.UpdateFile;
    GameStatusList.EndUpdate;
    if Assigned(SoftList) then
       SoftList.EndUpdate;

    if Assigned(SoftwareListsToCreate) then
       begin
         SoftwareListsToCreate.EndUpdate;
         SoftwareListsToCreate.Sorted:= False;
       end;
  end;

  WarningMessagesList.EndUpdate;
  if WarningMessagesList.Count > 0 then
     begin
       GenerateMessage('Warning', 'Warning messages.', WarningMessagesList.Text); 
     end;
  FormStatus.MessageStr('Saving files and freeing memory.');

  FreeAndNil(WarningMessagesList);
  FreeAndNil(ListDuplicateROMs); // free this THashedStringList here since it will not be used for software list games....


  ListCPU.SaveToFile(GetMainCPUFile(sysID));//GetIniFilesFolder+'cpu.ini');
  ListSamples.SaveToFile(GetAudioSamplesFile(sysID));
  
  //SoftList.EndUpdate;
  //if SoftList.Count > 0 then
  //   SoftList.SaveToFile(FrontendPath+'SoftList.txt'); // no longer used...? June 06, 2016
  Application.ProcessMessages;
  ListGames.WriteString('info_file', 'description', EmuTitle+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[sysID]);

  ListGames.UpdateFile;
  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 2));

  DeleteFile(GetGamesFolderEL+tempFile); // delete temp listxml.xml file

  if sysID = idMAME then
  begin
    if Assigned(SoftList) then
       begin
         if SoftList.Count > 0 then
            SoftList.SaveToFile(GetGamesFolderEL+GetSystemFileName(idMAME, 5));
       end;
  end;
  if Assigned(SoftNameMachinesList) then
     SoftNameMachinesList.UpdateFile;

  if Assigned(MemCardMachineList) then
     begin
       MemCardMachineList.EndUpdate;
       if MemCardMachineList.Count > 0 then
          MemCardMachineList.SaveToFile(GetMemcardListFile(sysID));
       FreeAndNil(MemCardMachineList);
     end;

  Application.ProcessMessages;
  if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
     ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1))
  else
     begin
       CallMessageBox;
       AddMsgText('ROMs list file ');
       AddMsgText(GetGamesFolderEL+GetSystemFileName(sysID, 1), $00a65300, [fsBold]);
       AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
       GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
     end;
  FreeMemVariables;

  if MAMEVersionNumber >= 177 then
     CheckCRC32Collisions(sysID);
     
  if sysID = idMAME then
  begin
    // this loop will remove the = sign from the machine names
    if FileExists(GetMAMEMachineSoftListFile(False)) then
       begin
         SoftList:= TStringList.Create;
         SoftList.LoadFromFile(GetMAMEMachineSoftListFile(False));
         SoftList.BeginUpdate;

         for MainLoop:= SoftList.Count-1 downto 0 do
         begin
           TempString:= SoftList[MainLoop];
           if (TempString <> '') and (TempString[1] <> '[') then
           begin
             TempString:= Copy(TempString, 1, Length(TempString)-1);
             SoftList[MainLoop]:= TempString;
           end;
         end;

         SoftList.EndUpdate;
         SoftList.SaveToFile(GetMAMEMachineSoftListFile(False));
         FreeAndNil(SoftList);
       end;
  end;

  case ValidateFile(GetDeviceSetsFile(sysID)) of
    True:
      begin
        ListDuplicateROMs:= THashedStringList.Create;
        ListDuplicateROMs.LoadFromFile(GetDeviceSetsFile(sysID));
        IsGameEntry:= False;
        ListDuplicateROMs.BeginUpdate;
        for MainLoop:=0 to ListDuplicateROMs.Count-1 do
        begin
          TempString:= ListDuplicateROMs[MainLoop];
          iCount:= PosEx('=', TempString);
          if iCount <> 0 then
             begin
               IsGameEntry:= True;
               Delete(TempString, iCount, 2);
               ListDuplicateROMs[MainLoop]:= TempString;
             end;
        end;
        ListDuplicateROMs.EndUpdate;
        if IsGameEntry then
           ListDuplicateROMs.SaveToFile(GetDeviceSetsFile(sysID));
        FreeAndNil(ListDuplicateROMs);        
      end;
    False: DeleteFile(GetDeviceSetsFile(sysID));
  end;

  Application.ProcessMessages;
  if IsMAMEBasedSys(sysID) then
     begin
       FormStatus.TitleStr('Create Software List: '+EmuTitle);
       CreateSoftwareListXML(sysID, 'neogeo', True);
       CreateSoftwareListXML(sysID, 'stv', True);
       //CreateSoftwareListXML(idMAME, 'neogeo', True);
       //CreateSoftwareListXML(idMAME, 'stv', True);
     end;

  if sysID = idMAME then
     begin
       //FormStatus.TitleStr('Create Software List: '+EmuTitle);
       //CreateSoftwareListXML(idMAME, 'neogeo', True);
       //CreateSoftwareListXML(idMAME, 'stv', True);

       if Assigned(SoftwareListsToCreate) then
          begin
            // this holds a list of all MESS software lists to create their games list; 'eldir\softwarelist' folder
            if MenuCreateMAMESoftwareListGames.Tag = 1 then // 0 -> no software list games; 1 -> yes, create software list games
            begin
              if SoftwareListsToCreate.Count > 0 then
                 begin
                   SoftListRemoveExcludedList(sysID, SoftwareListsToCreate);

                   iCount:= SoftwareListsToCreate.Count;
                   if iCount > 1 then
                      FormStatus.LabelSoftwareScanCount.Visible:= True;

                   for MainLoop:= 0 to SoftwareListsToCreate.Count-1 do
                   begin
                     if FormStatus.LabelSoftwareScanCount.Visible then
                        FormStatus.LabelSoftwareScanCount.Caption:= Format('[%.3u of %u]', [MainLoop+1, iCount]);
                     CreateSoftwareListXML(sysID, SoftwareListsToCreate[MainLoop], False);
                   end;
                   FormStatus.LabelSoftwareScanCount.Visible:= False;
                 end;
            end;
            FreeAndNil(SoftwareListsToCreate);
          end;
     end;
  //else
  //if sysID = idHBMAME then
  //   begin
  //     FormStatus.TitleStr('Create Software List: '+EmuTitle);
  //     CreateSoftwareListXML(idHBMAME, 'neogeo', True);
  //     CreateSoftwareListXML(idHBMAME, 'stv', True);
  //   end;
end;

function TFormMain.CreateGamesList_ListInfo(sysID: Byte): Boolean;
var
  ListXML, ROMsList, games_bios, ListCPU, ListSamples, ListROMsBiosSet, ListDrivers: THashedStringList;
  FileLine, ROMsDetailsLine, TempString, ROMDataLine, ROMOf{, DiskMergeFileName}: String;
  MainLoop{, LoopDevice, DeviceIndex}: Integer;
  IsResource, IsGameEntry, IsCHDFile, GetScreenRes: Boolean;
  BiosSet: TMemIniFile;
  tempFile, tempDriverFile, romName, romCRC32, romSHA1, SampleName: String;
  CPUisAdded, BiosTitleAdded, DefaultBiosAdded: Boolean;
  TitleErrorMsg, EmuTitle: String;
  tmpList: THashedStringList;
  HasROMs, ROMsHeaderAdded, IsDiscreteAudio: Boolean;
  GameStatusList: TStringList;
  IsBadDump: ShortInt;
  //iVersion: String;

  function GetStatusIndex(const StatusString: String): ShortInt;
  begin
    Result:= -1;
    if SameText(StatusString, 'good') then
       Result:= 0
    else
    if SameText(StatusString, 'imperfect') then
       Result:= 1
    else
    if SameText(StatusString, 'preliminary') then
       Result:= 2;
  end;

  function GetScreenTypeIndex(const ScreenTypeString: String): Integer;
  begin
    Result:= -1;
    if SameText(ScreenTypeString, 'raster') then
       Result:= 0
    else
    if SameText(ScreenTypeString, 'vector') then
       Result:= 1
    else
    if SameText(ScreenTypeString, 'lcd') then
       Result:= 2
    else
    if SameText(ScreenTypeString, 'svg') then
       Result:= 3
    else
    if SameText(ScreenTypeString, 'unknown') then
       Result:= 4
    else
       begin
         CallMessageBox;
         AddMsgText('New screen type found: ');
         AddMsgText(ScreenTypeString, $00a65300, [fsBold]);
         AddMsgText(#13#10+'Game: ');
         AddMsgText(TempGameVars.eTitle, $00a65300, [fsBold]);
         AddMsgText(#13#10+'Name: ');
         AddMsgText(TempGameVars.eName, $00a65300, [fsBold]);
         AddMsgText(#13#10+'Driver: ');
         AddMsgText(TempGameVars.eDriverName, $00a65300, [fsBold]);
         AddMsgText(#13#10+#13#10+'   This type is not yet supported. Please contact the author '+
                         'with this new info. In the mean time, the screen type for this '+
                         'game will be set as "none".');
         GenerateMessage(TitleErrorMsg, 'Screen type', '', 2);
       end;
  end;

  function SetIntegerValue(const strValue: String; DriverStatus: Boolean): Integer;
  begin
    Result:= -1;
    TempString:= '';
    TempString:= ListInfo_GetEntryValue(FileLine, strValue, ' '); //XML_GetEntryValue(FileLine, strValue);
    if TempString <> '' then
       begin
         case DriverStatus of
           True : Result:= GetStatusIndex(TempString);
           False: Result:= StrToInt(TempString);
         end;
       end;
  end;

  function AddButtonsControl: Boolean;
  begin
    Result:= TempGameVars.eButtonsCount > 0;
    if not Result then
       Exit;
    if TempGameVars.eControls = '' then
       TempGameVars.eControls:= 'buttons';
  end;

  function GetButtonsEntry: Boolean;
  var
    bStr: String;
  begin
    bStr:= ListInfo_GetEntryValue(FileLine, 'buttons', ' ');
    Result:= bStr <> '';
    if Result then
       TempGameVars.eButtonsCount:= StrToInt(bStr);
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ListDrivers);
    FreeAndNil(ROMsList);
    FreeAndNil(BiosSet);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    FreeAndNil(ListCPU);
    FreeAndNil(games_bios);
    FreeAndNil(ListROMsBiosSet); // new Jan 10, 2014
    FreeAndNil(ListSamples);
    Result:= False;
  end;

  function ReplaceChar(const iText: String; CharToReplace, NewChar: Char): String;
  var
    iPos: Integer;
  begin
    Result:= iText;
    iPos:= PosEx(CharToReplace, iText);
    while iPos > 0 do
    begin
      Result[iPos]:= NewChar;
      iPos:= PosEx(CharToReplace, iText);
    end;
  end;
  //function ReplaceChar(s:string;c:char;charrep:char):string;
  //begin
  //  while pos(c,s)>0 do
  //      s[pos(c,s)]:=charrep;
  //   ReplaceChar:=s;
  //end;

  function ParseVideoEntry: Boolean;
  begin
    Result:= True;
    // build v0.37 beta 15 to v0.68
    if GetScreenRes then
       Exit; // already got the video info

    GetScreenRes:= True;
    TempString:= '';
    TempGameVars.eScreenType:= Ord(PosEx('screen vector', FileLine) <> 0);

    TempGameVars.eScreenOrientation:= Ord(PosEx('orientation vertical', FileLine) <> 0);

    TempString:= ListInfo_GetEntryValue(FileLine, 'x', ' ');
    if TempString <> '' then
       TempGameVars.eScreenResolution:= TempString+'x'+ListInfo_GetEntryValue(FileLine, 'y', ' ');

    TempString:= ListInfo_GetEntryValue(FileLine, 'freq', ' ');
    if TempString <> '' then
       TempGameVars.eScreenRefreshRate:= TempString;
  end;

  function ParseDriverStatusInfo: Boolean;
  begin
    Result:= True;
    TempGameVars.eDriverStatus:= SetIntegerValue('status', True);
    //TempGameVars.eEmulationStatus:= SetIntegerValue('emulation', True);
    TempGameVars.eColorStatus:= SetIntegerValue('color', True);
    TempGameVars.eSoundStatus:= SetIntegerValue('sound', True);
    //TempGameVars.eGraphicStatus:= SetIntegerValue('graphic', True);
  end;

  function ParseMainCPUInfo: Boolean;
  begin
    if CPUisAdded then
       Exit;
    TempString:= ListInfo_GetEntryValue(FileLine, 'name', ' ');
    CPUisAdded:= True;
    if TempString <> '' then
       ListCPU.Add(TempGameVars.eName+'='+TempString);
  end;
  
  function ParseAudioDiscrete: Boolean;
  begin
    Result:= True;
    if IsDiscreteAudio then
       Exit; // is game is tagged as discrete audio, there's no need to check it again... it saves some CPU cycles !!! :)
    if PosEx('discrete', LowerCase(FileLine)) <> 0 then
       begin
         IsDiscreteAudio:= True;
         TempGameVars.eAudioType:= 1; // 0 -> chip (normal) -- 1 -> discrete
       end;
  end;

  function ParseROMDiskEntry(FileID: ShortInt; IsDisk: Boolean = False): Boolean; // FileID (type of ROM being scanned) -> 1: Device; 2: BIOS; 0: Game
  var
    ROMInfoFull, BiosInfoROM: String;
    IndexCHD: ShortInt;
  begin
    //DiskMergeFileName:= '';
    romName:= ListInfo_GetEntryValue(FileLine, 'name', ' '); //name of the ROM // XML_GetEntryValue(FileLine, 'name');
    romName:= DecodeHTML(romName);

    romCRC32:= ListInfo_GetEntryValue(FileLine, 'crc', ' '); // XML_GetEntryValue(FileLine, 'crc');
    romSHA1:= ListInfo_GetEntryValue(FileLine, 'sha1', ' '); // XML_GetEntryValue(FileLine, 'sha1');
    
    //romName:= FixROMNameEqualSign(romName); // remove equal sign from file name

    IsCHDFile:= IsDisk;//Pos('<disk ', FileLine) <> 0;

    if IsCHDFile then
       begin
         TempGameVars.eMediaType:= 1;
         if not SameText(ExtractFileExt(romName), '.chd') then
            romName:= romName+'.chd';
         IndexCHD:= 12; // it's a normal CHD file... old MAME builds do not have the region="" tag...
         //romName:= '3 '+romName;

         if romSHA1 = '' then // for MAME 0.159 and newer
            romSHA1:= ListInfo_GetEntryValue(FileLine, 'md5', ' '); // for MAME 0.77 down to 0.69
       end;

    // FileID -> 1: Device (not used by -listinfo); 2: BIOS; 0: Game
    //if FileID <> 0 then // device/bios sets parsing (1st, 2nd pass parse)
    //   romName:= IntToStr(FileID)+' '+romName; // '2 ' in front means it's a BIOS ROM

    TempString:= '';
    TempString:= ListInfo_GetEntryValue(FileLine, 'size', ' ');
    if TempString <> '' then
       TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(TempString);
    TempString:= '';

    IsBadDump:= PosEx('baddump', FileLine);
    case IsCHDFile of
      True : ROMInfoFull:= MountROMInfo(IndexCHD, 0, IsCHDFile, romName, romCRC32, romSHA1, IsBadDump);
      False: ROMInfoFull:= MountROMInfo(FileID, 0, IsCHDFile, romName, romCRC32, romSHA1, IsBadDump);
    end;

    if (FileID = 0) and (not IsCHDFile) then
       begin
         // check is ROM is a BIOS ROM or normal ROM ... for games parsing only (4th pass parse)
         BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;

         if FormMain.ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) then
            begin
              //if ListROMsBiosSet.IndexOf(TempString+'='+TempGameVars.eBiosName) <> -1 then
              if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                 ROMInfoFull[2]:= '2' // yes, it's a BIOS ROM, it contains the '2' in front
                 //romName:= '2 '+romName // yes, it's a BIOS ROM, it contains the '2' in front
              else
                 ROMInfoFull[2]:= '0'; // no, it's a game ROM... it contains the '0' in front
                 //romName:= '0 '+romName; // no, it's a game ROM... it contains the '0' in front
            end
         else
            ROMInfoFull[2]:= '0'; // set game ID tag
            //romName:= '0 '+romName; // set game ID tag
       end;

    if FileID = 2 then // parsing BIOS sets
       BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;

    if not ROMsHeaderAdded then
       begin
         if ROMsList.Count > 0 then
            begin
              ROMsList.Add(' ');
              if FileID = 2 then
                 ListROMsBiosSet.Add(' '); // temp bios ROMs list!!!
            end;
         ROMsList.Add('['+TempGameVars.eName+']');
         //if FileID = 1 then // for Device parse only
         //   ListROMsDeviceSet.Add('['+TempGameVars.eName+']'); // temp device ROMs list!!! // not used by -listinfo
         ROMsHeaderAdded:= True;
       end;

    //ROMsList.Add(romName+'='+TempString); // add ROM to ROMs list
    ROMsList.Add(ROMInfoFull); // add ROM to ROMs list
    if FileID = 2 then
       ListROMsBiosSet.Add(BiosInfoROM); // 04399ab8=neogeo ----temp bios ROMs list (CRC32 only, MD5 for MAME 0.159 and newer... CHDs)!!!
       //ListROMsBiosSet: --> <name>sp-u2.sp1<crc>e72943de<sha1>5c6bba07d2ec8ac95776aa3511109f5e1e2e92eb=neogeo
       
    if not IsCHDFile then
       HasROMs:= True;
  end;

begin
  EmuTitle:= GetArcadeEmulatorDescription(sysID, True);
  TitleErrorMsg:= 'Error: Create Games List ['+EmuTitle+']';

  FormStatus.SetProgressPos(0);
  //CheckAndCreateFolder(GetGamesFolderEL);

  tempFile:= GetArcadeSystemIniSection(sysID, True)+'_listinfo.txt';
  tempDriverFile:= GetArcadeSystemIniSection(sysID, True)+'_listdetails.txt';
  IsGameEntry:= True;
  //FormStatus.TitleStr('Create Games List: '+EmuTitle);

  Result:= True;
  FormStatus.MessageStr('Parsing "'+tempDriverFile+'"');
  ListDrivers:= THashedStringList.Create;
  ListDrivers.LoadFromFile(GetGamesFolderEL+tempDriverFile);
  ListDrivers.BeginUpdate;
  for MainLoop:=0 to ListDrivers.Count -1 do
      ListDrivers[MainLoop]:= Trim(Copy(ListDrivers[MainLoop], 1, 8))+'='+Trim(Copy(ListDrivers[MainLoop], 10, 10));
  ListDrivers.EndUpdate;

  FormStatus.MessageStr('Parsing "'+tempFile+'" (1st pass).'+#13#10+
                          'Creating BIOS sets list.');
  
  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(GetGamesFolderEL+tempFile);

  ListCPU:= THashedStringList.Create;
  //if FileExists(GetIniFilesFolder+'cpu.ini') then
  //   begin
  //     tempCPU:= TMemIniFile.Create(GetIniFilesFolder+'cpu.ini');
  //     if tempCPU.SectionExists(GetSystemIniSection(sysID, True)) then
  //        begin
  //          tempCPU.EraseSection(GetSystemIniSection(sysID, True));
  //          tempCPU.UpdateFile;
  //        end;
  //     FreeAndNil(tempCPU);
  //     ListCPU.LoadFromFile(GetIniFilesFolder+'cpu.ini');
  //     if ListCPU.Count > 0 then
  //        begin
  //          if ListCPU[ListCPU.Count-1] <> '' then
  //             ListCPU.Add(' ');
  //        end;
  //   end;
  //ListCPU.Add('['+GetSystemIniSection(sysID, True)+']');

  //DeleteFile(GetBiosSetFile);
  //DeleteFile(GetDeviceSetsFile(sysID)); // -listinfo doesn't have device sets

  //DeleteFile(GetGamesFolderEL+'multicart_neogeo.ini'); // no software list support
  //DeleteFile(GetGamesFolderEL+'multicart_stv.ini'); // no software list support

  ListSamples:= THashedStringList.Create;
  ListSamples.BeginUpdate;
  ListROMsBiosSet:= THashedStringList.Create; // will hold a temp list of ROMs for each bios set

  BiosSet:= TMemIniFile.Create(GetBiosSetFile(sysID));

  Application.ProcessMessages;
  FormStatus.SetFocus;
  if ListXML.Count > 0 then
  begin
    //DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID));
    //for MainLoop:=1 to 4 do
    //    DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID, MainLoop));

    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;

    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    ListGames.WriteString('info_file', 'description', '');

    ROMsList:= THashedStringList.Create;
    ROMsList.BeginUpdate;

    GetScreenRes:= False;
    CPUisAdded:= False;

    IsResource:= False;
    ListROMsBiosSet.BeginUpdate;

    // the tricky part, get all bios sets before games
    // there's nothing beyond rom () entry... no need to check for them!!!!!!!!!! April 04, 2015
    //FormStatus.SetProgressPos(0);
    IsResource:= False;
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, 'resource (') then
         begin
           ClearMemGameInfo(TempGameVars);
           TempGameVars.eSystemID:= sysID;
           ROMsDetailsLine:= '';
           TempString:= '';
           SampleName:= '';
           ROMOf:= '';
           TempGameVars.eGameSetStatus:= 2; // missing
           IsResource:= True;
           CPUisAdded:= False;
           GetScreenRes:= False;
           BiosTitleAdded:= False;
           DefaultBiosAdded:= False;
           ROMsHeaderAdded:= False;
           IsDiscreteAudio:= False;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, 'name ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eName:= FileLine;// ListInfo_GetEntryValue(FileLine, 'name', ' ');
                TempGameVars.eBiosName:= TempGameVars.eName;
                TempGameVars.eDriverName:= TempGameVars.eName+'.c';// ListDrivers.Values[TempGameVars.eName]; // bios drivers not listed in -listdetails!!!
              end
           else
           if XML_CheckData(FileLine, 'description ') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, Length(FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, False);
                BiosSet.WriteString('Descriptions', TempGameVars.eName, TempGameVars.eTitle); // write description
                BiosTitleAdded:= True;
              end
           else
           if XML_CheckData(FileLine, 'year ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eYear:= FileLine;  // Copy(FileLine, 7, Pos('</year>', FileLine)-7)
              end
           else
           if XML_CheckData(FileLine, 'manufacturer ') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, Length(FileLine)-15)) //Pos('</manufacturer>', FileLine)-15));
           else
           if XML_CheckData(FileLine, 'history ') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else
           if XML_CheckData(FileLine, 'rom ') then // bios "<disk" entry for MAME 0.159 and newer
              ParseROMDiskEntry(2)
           else
           {if XML_CheckData(FileLine, 'sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, 'chip ( type cpu ') then
              ParseMainCPUInfo
           else
           if XML_CheckData(FileLine, 'chip ( type audio ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, 'video ') then
              ParseVideoEntry
           else
           if XML_CheckData(FileLine, 'input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= ListInfo_GetEntryValue(FileLine, 'players', ' ');
                TempGameVars.eControls:= ListInfo_GetEntryValue(FileLine, 'control', ' ');
                GetButtonsEntry; // get buttons count
              end
           else
           if XML_CheckData(FileLine, 'driver ') then
              ParseDriverStatusInfo
           else}
           {if XML_CheckData(FileLine, 'dipswitch ') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else}
           if FileLine = ')' then
           //if XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty!!!
                // bios ID
                TempGameVars.eROMIdentification:= 06; // MAME
                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade; // new populate with new list format
                ListGames.WriteString('bios', TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);
                                        //TempGameVars.eName+'='+IntToStr(TempGameVars.eROMIdentification)+
                                        //                       IntToStr(TempGameVars.eGameSetStatus+
                                        //                       IntToStr(TempGameVars.eScanMode)); // new, experimental !!!!!!
                IsResource:= False;
              end;
         end;
      Application.ProcessMessages;
    end;
    ListROMsBiosSet.EndUpdate;
    BiosSet.UpdateFile;
    ListGames.UpdateFile;

    //ShowMessage(ListROMsBiosSet.Text);
    FreeAndNil(ListGames); // new code November 23
    tmpList:= THashedStringList.Create;
    tmpList.LoadFromFile(GetGamesFolderEL+GetSystemFileName(sysID));
    tmpList.BeginUpdate;

    // get name, cloneof, romof fields
    // if romof, check if a bios is part of the game (parent games only!)
    FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass).'+#13#10+
                          'Creating parent games sections and a temporary list of parent games with BIOS.');
    games_bios:= THashedStringList.Create; // this will hold parent games that have bios
    games_bios.BeginUpdate;
    //FormStatus.SetProgressPos(0);
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, 'game (') then
         begin
           ClearMemGameInfo(TempGameVars);
           TempString:= '';
           IsResource:= True;
           ROMOf:= '';
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, 'name ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eName:= FileLine;// ListInfo_GetEntryValue(FileLine, 'name', ' ');
              end
           else
           if XML_CheckData(FileLine, 'history ') then
              begin
                // do nothing...
              end
           else
           if XML_CheckData(FileLine, 'cloneof ') then
              begin
                Delete(FileLine, 1, 8);
                TempGameVars.eClone:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'romof ') then
              begin
                Delete(FileLine, 1, 6);
                ROMOf:= FileLine;
              end
           else
           {if XML_CheckData(FileLine, 'dipswitch ') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else}
           if FileLine = ')' then
              begin
                IsResource:= False;
                if TempGameVars.eClone = '' then
                   begin
                     // add parent game entry in games list file "mame.el"
                     tmpList.Add(' ');
                     tmpList.Add('['+TempGameVars.eName+']');
                     tmpList.Add(TempGameVars.eName+'=');
                     if ROMOf <> '' then
                        games_bios.Add(TempGameVars.eName+'='+ROMOf); // temporary parent games with bios sets
                   end;
              end;
         end;
           {if (Pos('cloneof="', FileLine) = 0) then
              begin
                if (not IsBiosSet) and (not IsDeviceSet) then
                   begin
                     TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                     tmpList.Add('');
                     tmpList.Add('['+TempGameVars.eName+']');
                     tmpList.Add(TempGameVars.eName+'=');
                     ROMOf:= XML_GetEntryValue(FileLine, 'romof');
                     if ROMOf <> '' then
                        games_bios.Add(TempGameVars.eName+'='+ROMOf);
                   end;
              end;}
      //FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      //Application.ProcessMessages; // re-enabled this!!!! ???????????????????????????????????????????
    end;
    games_bios.EndUpdate;
    //ListGames.UpdateFile;
    tmpList.EndUpdate;
    tmpList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID));
    //ShowMessage(tmpList.Text);
    FreeAndNil(tmpList);
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    FormStatus.MessageStr('Parsing "'+tempFile+'" (3rd and final pass).'+#13#10+
                          'Creating games list.');
    FormStatus.SetProgressPos(0);

    // now, the normal games, but no resources this time (BIOS)
    IsGameEntry:= False;
    GetScreenRes:= False;
    CPUisAdded:= False;
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, 'game (') then
         begin
           ClearMemGameInfo(TempGameVars);
           TempGameVars.eSystemID:= sysID;
           SampleName:= '';
           ROMsDetailsLine:= '';
           TempString:= '';
           ROMOf:= '';
           TempGameVars.eGameSetStatus:= 2; // missing
           ROMsHeaderAdded:= False;
           IsGameEntry:= True;
           CPUisAdded:= False;
           IsDiscreteAudio:= False;
           GetScreenRes:= False;
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, 'name ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eName:= FileLine;// ListInfo_GetEntryValue(FileLine, 'name', ' ');
                TempGameVars.eDriverName:= ListDrivers.Values[TempGameVars.eName];
              end
           else
           if XML_CheckData(FileLine, 'description ') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, Length(FileLine)-14));
                TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, False);
              end
           else
           if XML_CheckData(FileLine, 'year ') then
              begin
                Delete(FileLine, 1, 5);
                TempGameVars.eYear:= FileLine; // Copy(FileLine, 7, Pos('</year>', FileLine)-7)
              end
           else
           if XML_CheckData(FileLine, 'manufacturer ') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, Length(FileLine)-15)) //Pos('</manufacturer>', FileLine)-15));
           else
           if XML_CheckData(FileLine, 'history ') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else
           if XML_CheckData(FileLine, 'cloneof ') then
              begin
                Delete(FileLine, 1, 8);
                TempGameVars.eClone:= FileLine;
              end
           else
           if XML_CheckData(FileLine, 'romof ') then
              begin
                Delete(FileLine, 1, 6);
                ROMOf:= FileLine;
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if Assigned(BiosSet) then
                       begin
                         if BiosSet.ValueExists('Descriptions', ROMOf) and (TempGameVars.eBiosName = '') then
                            TempGameVars.eBiosName:= ROMOf;
                       end;
                   end;
              end
           else
           if XML_CheckData(FileLine, 'rom ') then
              ParseROMDiskEntry(0)
           else
           if XML_CheckData(FileLine, 'disk ') then
              ParseROMDiskEntry(0, True)
           else
           if XML_CheckData(FileLine, 'sampleof ') then
              begin
                Delete(FileLine, 1, 9);
                SampleName:= FileLine; // ListInfo_GetEntryValue(FileLine, 'sampleof', ' ')
              end
           else
           if XML_CheckData(FileLine, 'sample ') then
              begin
                if SampleName = '' then
                   SampleName:= TempGameVars.eName;
              end
           else
           if XML_CheckData(FileLine, 'chip ( type cpu ') then
              ParseMainCPUInfo
           else
           if XML_CheckData(FileLine, 'chip ( type audio ') then
              ParseAudioDiscrete
           else
           if XML_CheckData(FileLine, 'video ') then
              ParseVideoEntry
           else
           if XML_CheckData(FileLine, 'input ') then
              begin
                // previous 0.107 gets the controls from "<input" entry
                TempGameVars.eNumberPlayers:= ListInfo_GetEntryValue(FileLine, 'players', ' ');
                TempGameVars.eControls:= ListInfo_GetEntryValue(FileLine, 'control', ' ');
                GetButtonsEntry; // get buttons count
              end
           else
           {if XML_CheckData(FileLine, 'dipswitch ') then
              begin
                // do nothing... added this check to make parsing a little bit faster
              end
           else}
           if XML_CheckData(FileLine, 'driver ') then
              ParseDriverStatusInfo
           else
           if FileLine = ')' then
           //if XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty!!!
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if Assigned(BiosSet) then
                       begin
                         if BiosSet.ValueExists('Descriptions', ROMOf) and (TempGameVars.eBiosName = '') then
                            TempGameVars.eBiosName:= ROMOf;
                       end;
                   end;

                // must verify if is clone or parent, neogeo or classic, raster or vector
                if TempGameVars.eClone = '' then
                   TempGameVars.eROMIdentification:= 04 // MAME Parent
                else
                   TempGameVars.eROMIdentification:= 05; // MAME Clone

                if SampleName <> '' then
                   begin
                     TempGameVars.eAudioType:= 2;
                     ListSamples.Add(TempGameVars.eName+'='+SampleName);
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);
                                   //TempGameVars.eName+'='+IntToStr(TempGameVars.eROMIdentification)+
                                   //                       IntToStr(TempGameVars.eGameSetStatus+
                                   //                       IntToStr(TempGameVars.eScanMode)); // new, experimental !!!!!!
                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    GameStatusList.EndUpdate;
  end;
  FormStatus.MessageStr('Saving files and freeing memory.');
  ListCPU.SaveToFile(GetMainCPUFile(sysID));// GetIniFilesFolder+'cpu.ini');

  ListSamples.SaveToFile(GetGamesFolderEL+GetArcadeSystemIniSection(sysID, True)+'_samples.el');
  //FormStatus.MessageStr('Extracting emulator version.');
  //GetEmulatorVersion(sysID, EmulatorFile[sysID], EmulatorVersion[sysID], iVersion);
  //if tmpEmuVersion = '' then
  //   begin
  //     FormStatus.MessageStr('Extracting emulator version.');
  //     GetEmulatorVersion(sysID, EmulatorFile[sysID], EmulatorVersion[sysID]);
  //   end
  //else
  //   EmulatorVersion[sysID]:= tmpEmuVersion;
  Application.ProcessMessages;
  ListGames.WriteString('info_file', 'description', EmuTitle+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[sysID]);
  //if sysID = idMAME then
  //   begin
  //     if buildMAME <> iVersion then
  //        buildMAME:= iVersion;//Copy(iVersion, 3, 3);
  //   end;
  ListGames.UpdateFile;

  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 2));

  DeleteFile(GetGamesFolderEL+tempFile); // delete temp lisinfo.txt file
  DeleteFile(GetGamesFolderEL+tempDriverFile);

  //GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemIniSection(1, True)+'_gamestatus.el');
  //FreeAndNil(GameStatusList);

  Application.ProcessMessages;
  if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
     ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1))
  else
     begin
       CallMessageBox;
       AddMsgText('ROMs list file ');
       AddMsgText(GetGamesFolderEL+GetSystemFileName(sysID, 1), $00a65300, [fsBold]);
       AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
       GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
     end;
  FreeMemVariables;
  Application.ProcessMessages;
end;

procedure TFormMain.CheckCRC32Collisions(sysID: Byte);
var
  ROMsFileDB, CRC32List, FullChecksumList: THashedStringList;
  Loop, CollisionIndex, FirstROMIndex: Integer;
  LineStr, PrevLineStr, romCRC32, romSHA1, SetName, ChecksumStr: String;
  IsModified, NewGame: Boolean;
  //SetsList: THashedStringList;
begin
  if not FileExists(GetGamesFolderEL+GetSystemFileName(sysID, 1)) then
     Exit;

  if FormStatus.Visible then
     FormStatus.MessageStr('Checking for CRC32 collisions in the same set.');
  //if GetMAMEBuild(sysID) < 177 then
  //   Exit; // only MAME v0.177+ have CRC32 collisions...

  IsModified:= False;
  NewGame:= False;

  ROMsFileDB:= THashedStringList.Create;
  ROMsFileDB.LoadFromFile(GetGamesFolderEL+GetSystemFileName(sysID, 1));
  ROMsFileDB.BeginUpdate;

  CRC32List:= THashedStringList.Create;
  CRC32List.BeginUpdate;

  FullChecksumList:= THashedStringList.Create;
  FullChecksumList.BeginUpdate;

  //SetsList:= THashedStringList.Create;
  //SetsList.Duplicates:= dupIgnore;
  //SetsList.Sorted:= True;
  //SetsList.BeginUpdate;
  for Loop:=0 to ROMsFileDB.Count-1 do
  begin
    LineStr:= ROMsFileDB[Loop];
    if LineStr = '' then
       begin
         NewGame:= False;
       end
    else
    if NewGame then
    begin
      if FirstROMIndex = -1 then
         FirstROMIndex:= Loop;
      romCRC32:= SoftListGetEntryValue(LineStr, 'crc');
      romSHA1:= SoftListGetEntryValue(LineStr, 'sha1');
      ChecksumStr:= romCRC32+'='+romSHA1;

      if StrToInt(LineStr[1]+LineStr[2]) < 12 then // only check ROMs... avoid wasting time with CHD files
      begin
        if romCRC32 <> '' then
        begin
          //romSHA1:= SoftListGetEntryValue(LineStr, 'sha1');
          //ChecksumStr:= romCRC32+'='+romSHA1;
          if FullChecksumList.IndexOf(ChecksumStr) = -1 then
          begin
            CollisionIndex:= CRC32List.IndexOf(romCRC32);
            if CollisionIndex <> -1 then
            begin
              LineStr[4]:= '1';
              ROMsFileDB[Loop]:= LineStr;
              PrevLineStr:= ROMsFileDB[FirstROMIndex+CollisionIndex];
              if PrevLineStr[4] <> '1' then
                 begin
                   PrevLineStr[4]:= '1';
                   ROMsFileDB[FirstROMIndex+CollisionIndex]:= PrevLineStr;
                 end;
              IsModified:= True;
              //SetsList.Add(SetName+'=mame'); // for the favorites list
            end;
          end;
        end;
      end;

      // always add the current ROM being scanned AFTER the collision check... ALL ROMs and CHD files must be added or the CollisionIndex will be messed up!
      CRC32List.Add(romCRC32);
      FullChecksumList.Add(ChecksumStr);
    end
    else
    begin
      if LineStr[1] = '[' then
         begin
           NewGame:= True;
           FirstROMIndex:= -1;
           CollisionIndex:= -1;
           CRC32List.Clear;
           FullChecksumList.Clear;
           SetName:= LineStr;
           Delete(SetName, 1, 1);
           Delete(SetName, Length(SetName), 1);
         end;
    end;
    if not NewGame then
    begin
      CRC32List.Clear;
      FullChecksumList.Clear;
      FirstROMIndex:= -1;
      CollisionIndex:= -1;
    end;
    Application.ProcessMessages;
  end;

  ROMsFileDB.EndUpdate;
  CRC32List.EndUpdate;
  FreeAndNil(CRC32List);
  FullChecksumList.EndUpdate;
  FreeAndNil(FullChecksumList);

  if IsModified then
     ROMsFileDB.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1));
  FreeAndNil(ROMsFileDB);
  //SetsList.EndUpdate;

  //if not FormStatus.Visible then
  //begin
  //  if SetsList.Count > 0 then
  //     SetsList.SaveToFile(FrontendPath+'Sets with CRC32 Collision.txt');
  //  //ShowMessage('done'); // this is for debugging only... make sure it's COMMENTED OUT
  //end;
  //FreeAndNil(SetsList);
end;

function TFormMain.CreateGamesListDaphne: Boolean;
var
  configXML: THashedStringList;
  TempString, ROMDataLine,
  strMainDescription, strMainDriverName, FileLine: String;
  MainLoop: Integer;
  IsGameEntry, XML_IsGameList: Boolean;
  iVersion: String;
  GameStatusList: TStringList;
begin
  Result:= FileExists(EmulatorFile[idDaphne]);
  if not Result then
     Exit;
  CheckAndCreateFolder(GetGamesFolderEL);
  TempString:= ExtractFilePath(EmulatorFile[idDaphne])+'config.xml';
  if not ValidateFile(TempString) then
     begin
       CallMessageBox;
       AddMsgText('File ');
       AddMsgText(TempString, $00a65300, [fsBold]);
       AddMsgText(' was not found or is blank. Aborting...');
       GenerateMessage('Error', GetArcadeEmulatorDescription(idDaphne)+#13#10+'File access error.', '', 2, False, 1);
       Result:= False;
       Exit;
     end;
  FormStatus.SetProgressPos(0);
  FormStatus.TitleStr('Create Games List: '+GetArcadeEmulatorDescription(idDaphne));
  FormStatus.MessageStr('Parsing "config.xml" (1st pass).'+#13#10+
                        'Creating parent games sections in .ini file.');
  if not FormStatus.Visible then
     FormStatus.Show;
  configXML:= THashedStringList.Create;
  configXML.LoadFromFile(TempString);
  if configXML.Count > 0 then
  begin
    DeleteFile(GetGamesFolderEL+GetSystemFileName(idDaphne));
    DeleteFile(GetGamesFolderEL+GetSystemFileName(idDaphne, 2));

    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;
    
    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(idDaphne));
    ListGames.WriteString('info_file', 'description', '');
    XML_IsGameList:= False;

    // get all parent names first
    for MainLoop:=0 to configXML.Count -1 do
    begin
      FileLine:= TrimLeft(configXML[MainLoop]);
      if XML_CheckData(FileLine, '<gamelist>') then
         XML_IsGameList:= True
      else
      if XML_IsGameList then
         begin
           if (XML_CheckData(FileLine, '<game ')) then
              begin
                FileLine:= TrimLeft(configXML[MainLoop+1]);
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= idDaphne;
                TempString:= '';
                Delete(FileLine, 1, 6);
                TempGameVars.eName:= ChangeFileExt(XML_GetEntryValue(FileLine, 'driver'), '');
                if not ListGames.SectionExists(TempGameVars.eName) then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, '');
              end
           else
           if (XML_CheckData(FileLine, '</gamelist>')) then
              Break;
         end;
      Application.ProcessMessages;
    end;

    FormStatus.MessageStr('Parsing "config.xml" (2nd and final pass).'+#13#10+
                          'Creating games list.');
    IsGameEntry:= False;
    for MainLoop:=0 to configXML.Count -1 do
    begin
      FileLine:= TrimLeft(configXML[MainLoop]);
      if XML_CheckData(FileLine, '<gamelist>') then
         begin
           XML_IsGameList:= True;
           strMainDescription:= '';
         end
      else
      if XML_IsGameList then
         begin
           if XML_CheckData(FileLine, '<game ') then
              begin
                TempString:= '';
                Delete(FileLine, 1, 6);
                strMainDescription:= XML_GetEntryValue(FileLine, 'name');
                strMainDriverName:= '';
                IsGameEntry:= True;
              end
           else
           if IsGameEntry then
              begin
                if XML_CheckData(FileLine, '<!-- ') then
                   Delete(FileLine, 1, 5);
                if XML_CheckData(FileLine, '--> ') then
                   Delete(FileLine, 1, 4);
                FileLine:= TrimLeft(configXML[MainLoop]);

                if XML_CheckData(FileLine, '<version ') then
                   begin
                     ClearMemGameInfo(TempGameVars);
                     TempGameVars.eSystemID:= idDaphne;
                     if StrMainDriverName = '' then
                        strMainDriverName:= ChangeFileExt(XML_GetEntryValue(FileLine, 'driver'), '');
                     TempString:= XML_GetEntryValue(FileLine, 'name');
                     if TempString <> '' then
                        begin
                          if strMainDriverName <> 'astron' then
                             TempGameVars.eTitle:= strMainDescription+ '('+TempString+')'
                          else
                             TempGameVars.eTitle:= TempString;
                        end;

                     TempGameVars.eName:= XML_GetEntryValue(FileLine, 'driver');
                     if TempGameVars.eName <> StrMainDriverName then
                        TempGameVars.eClone:= StrMainDriverName;

                     if TempGameVars.eClone = '' then
                        TempGameVars.eROMIdentification:= 14 // it's a parent game
                     else
                        TempGameVars.eROMIdentification:= 15; // it's a clone game

                     TempGameVars.eDriverName:= strMainDriverName+'.c';
                     // set values non-existant on xml file :_(
                     TempGameVars.eMediaType:= 1; // laserdisc
                     TempGameVars.eScreenType:= 0; // raster
                     TempGameVars.eScreenOrientation:= 0; // horizontal

                     //TempGameVars.eNumberPlayers:= '1';
                     TempGameVars.eDriverStatus:= 0; // good //SetIntegerValue('status', True);
                     TempGameVars.eGameSetStatus:= 2; // missing

                     ROMDataLine:= PopulateROMDataLineArcade;
                     case GameIsClone(TempGameVars.eClone) of
                       True:
                         begin
                           TempString:= ListGames.ReadString(TempGameVars.eClone, TempGameVars.eName, '');
                           if TempString = '' then
                              ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);
                         end;
                       False: ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine);
                     end;

                     GameStatusList.Add(PopulateGameStatusDataLine);
                                        //TempGameVars.eName+'='+IntToStr(TempGameVars.eROMIdentification)+
                                        //                       IntToStr(TempGameVars.eGameSetStatus+
                                        //                       IntToStr(TempGameVars.eScanMode)); // new, experimental !!!!!!
                   end
                 else
                 if XML_CheckData(FileLine, '</game>') then
                    begin
                      IsGameEntry:= False;
                    end;
              end
           else
           if (XML_CheckData(FileLine, '</gamelist>')) then
              Break;
         end;
      FormStatus.UpdateProgressBar(MainLoop, configXML.Count-1);
      Application.ProcessMessages;
    end;
    GameStatusList.EndUpdate;
  end;

  FormStatus.MessageStr('Saving files and freeing memory.');
  FreeAndNil(configXML);
  EmulatorDateTime[idDaphne]:= FileAge(EmulatorFile[idDaphne]);
  GetArcadeEmulatorVersion(idDaphne, EmulatorFile[idDaphne], EmulatorVersion[idDaphne], iVersion);
  ListGames.WriteString('info_file', 'description', GetArcadeEmulatorDescription(idDaphne)+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[idDaphne]);
  ListGames.UpdateFile;
  FreeAndNil(ListGames);
  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(idDaphne, 2));
  FreeAndNil(GameStatusList);

  Application.ProcessMessages;
end;

function TFormMain.CreateGamesClrMAMEProXML(sysID: Byte): Boolean;
var
  ListXML, ROMsList, games_bios, MAMEGames, BiosSet, DemulDriverName, ListROMsBiosSet, ListDuplicateROMs: THashedStringList;
  FileLine, ROMsDetailsLine, TempString, ROMDataLine, ROMOf: String;
  MainLoop, tmpIndex: Integer;
  IsResource, IsGameEntry, IsCHDFile, ROMsHeaderAdded: Boolean;
  tempFile, tmpEmuVersion, romName, romNameMerge, romCRC32, romSHA1, iDriver: String;
  TitleErrorMsg: String;
  DemulROMOf: String;
  iVersion: String;
  GameStatusList: TStringList;
  newFileID: ShortInt;
  ROMInfoFull, BiosInfoROM: String;
  IsOldDemulVersion: Boolean;
  IsBadDump: ShortInt;

  function Check_Temp_Files(const tempFileName: String): Boolean;
  begin
    Result:= FileExists(tempFileName);
    case Result of
      True:
        begin
          Result:= (GetFileSize(tempFileName) > 0);
          if not Result then
             begin
               CallMessageBox;
               AddMsgText('File ');
               AddMsgText(tempFileName, $00a65300, [fsBold]);
               AddMsgText(' is empty! Aborting...');
               GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
               DeleteFile(tempFileName);
             end
        end;
      False:
        begin
          CallMessageBox;
          AddMsgText('File ');
          AddMsgText(tempFileName, $00a65300, [fsBold]);
          AddMsgText(' was not found! Aborting...');
          GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
        end;
    end;
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ROMsList);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    FreeAndNil(games_bios);
    FreeAndNil(BiosSet);
    FreeAndNil(MAMEGames);
    FreeAndNil(ListROMsBiosSet);
    if sysID = idDemul then
       FreeAndNil(DemulDriverName);
    Result:= False;
  end;

  function IsBiosSet(const StringLine: String): Boolean;
  begin
    Result:= PosEx('isbios="yes"', StringLine) <> 0;
    //if not Result then
    //   begin
    //     if sysID = idSegaModel2 then
    //        Result:= Pos('<game name="model2", StringLine) <> 0;
    //   end;
  end;

  function IsDemulGD(const StringLine: String): Boolean;
  begin
    // this function is only used by old Demul builds v0.583 and older; the new v0.7 doesn't need this!!!
    Result:= (StringLine = 'naomigd') or
             (StringLine = 'naomi2gd');
  end;

  function FixDemulBiosTitle: String;
  begin
    if TempGameVars.eName = 'crp' then
       Result:= 'CRP Bios'
    else
    if TempGameVars.eName = 'dc' then
       Result:= 'Dreamcast BIOS'
    else
    if TempGameVars.eName = 'awbios' then
       Result:= 'Atomiswave BIOS'
    else
    if TempGameVars.eName ='naomi2' then
       Result:= 'Naomi 2 BIOS'
    else
    if TempGameVars.eName = 'naomi' then
       Result:= 'Naomi BIOS'
    else
    if TempGameVars.eName = 'aurora' then
       Result:= 'Aurora BIOS'
    else
    if TempGameVars.eName = 'mie' then
       //Result:= 'MIE Bios'
       Result:= 'Sega 315-6146 MIE'
    else
    if TempGameVars.eName = 'hikaru' then
       Result:= 'Hikaru BIOS'
    else
    if TempGameVars.eName = 'segasp' then
       Result:= 'Sega System SP (Spider) BIOS'
    else
    if TempGameVars.eName = 'dimm' then
       Result:= 'DIMM BIOS'
    else
       Result:= TempGameVars.eTitle;
  end;

  function FixDemulBiosName: Boolean;
  begin
    // due to a discrepancy between Demul's internal bios name set
    // and the listxml output :_((
    Result:= (sysID = idDemul) and (ROMOf <> '');
    if not Result then
       Exit;
    DemulROMOf:= ROMOf;
    if SameText(ROMOf, 'awave') then
       ROMOf:= 'awbios'
    else
    if SameText(ROMOf, 'naomigd') then
       ROMOf:= 'naomi'
    else
    if SameText(ROMOf, 'naomi2gd') then
       ROMOf:= 'naomi2';
  end;

  function FixCRCEmptySpaces(const CRC32String: String): String;
  var
    crcLoop: Integer;
  begin
    Result:= CRC32String;
    if sysID <> idDemul then // for Demul only!!!!!
       Exit;

    if Result = '' then
       Exit;

    if Result[1] <> ' ' then
       Exit;

    for crcLoop:= 1 to 8 do
    begin
      if Result[crcLoop] = ' ' then
         Result[crcLoop]:= '0'
      else
         Break;
    end;
  end;

  procedure SetDefaultSettings(const sysID: Byte);
  var
    FoundMAMEList: Boolean;
  begin
    if sysID = idDICE then
       begin
         TempGameVars.eDriverStatus:= 0; // good
         TempGameVars.eScreenType:= 0; // raster
         TempGameVars.eGameSize:= 0;
         Exit; // do not get extra info for DICE games....
       end;
    FoundMAMEList:= Assigned(MAMEGames);
    if FoundMAMEList then
       begin
         tmpIndex:= MAMEGames.IndexOfName(TempGameVars.eName);
         if tmpIndex <> -1 then
            GetROMFields(MAMEGames, tmpIndex, sysID);
       end;
    TempGameVars.eDriverStatus:= 0;
    TempGameVars.eGameSetStatus:= 2; // missing
    TempGameVars.eGameSize:= 0;
    case sysID of
      idZiNc:
        begin
          TempGameVars.eScreenType:= -1; // game index is -1 if not found in .xml file (for bios sets)
          if TempGameVars.eScreenResolution = '' then
             TempGameVars.eScreenResolution:= '640x480';
          if TempGameVars.eScreenRefreshRate = '' then
             TempGameVars.eScreenRefreshRate:= '60.000000';
        end;
      idDemul:
        begin
          TempGameVars.eClone:= '';
          TempGameVars.eBiosName:= '';
          TempGameVars.eDriverName:= '';
        end;
      idSegaModel2:
        begin
          TempGameVars.eClone:= '';
          if TempGameVars.eScreenOrientation = -1 then
             TempGameVars.eScreenOrientation:= 0; // horizontal games
          if TempGameVars.eScreenResolution = '' then
             TempGameVars.eScreenResolution:= '496x384';
          if TempGameVars.eScreenRefreshRate = '' then
             TempGameVars.eScreenRefreshRate:= '57.524160';
          if TempGameVars.eDriverName = '' then
             TempGameVars.eDriverName:= 'model2.cpp';
        end;
      idSupermodel:
        begin
          TempGameVars.eClone:= '';
          if TempGameVars.eScreenOrientation = -1 then
             TempGameVars.eScreenOrientation:= 0; // horizontal games
          if TempGameVars.eScreenResolution = '' then
             TempGameVars.eScreenResolution:= '496x384';
          if TempGameVars.eScreenRefreshRate = '' then
             TempGameVars.eScreenRefreshRate:= '60.000000';
          if TempGameVars.eDriverName = '' then
             TempGameVars.eDriverName:= 'model3.cpp';

          // nothing more ?
        end;
      idDICE: // not being used anymore...
        begin
          TempGameVars.eClone:= '';
          TempGameVars.eBiosName:= '';
          // wrong!!! TempGameVars.eAudioType:= 1; // discrete audio...
        end;
    end;
    TempGameVars.eSystemID:= sysID;
  end;

  function AddControlsList(const ctrlString: String): Boolean;
  begin
    Result:= True;
    if TempGameVars.eControls <> '' then
       TempGameVars.eControls:= TempGameVars.eControls+','+ctrlString
    else
       TempGameVars.eControls:= ctrlString;
  end;

  function AddButtonsControl: Boolean;
  begin
    Result:= TempGameVars.eButtonsCount > 0;
    if not Result then
       Exit;
    if TempGameVars.eControls = '' then
       TempGameVars.eControls:= 'buttons';
  end;

  function GetButtonsEntry: Boolean;
  var
    bStr: String;
  begin
    bStr:= XML_GetEntryValue(FileLine, 'buttons');
    Result:= bStr <> '';
    if Result then
       TempGameVars.eButtonsCount:= StrToInt(bStr);
  end;

begin
  // still need to get xml version info!!!!!!!
  TitleErrorMsg:= 'Error: Create Games List ['+GetArcadeEmulatorDescription(sysID)+']';
  if not FileExists(EmulatorFile[sysID]) then
     begin
       CallMessageBox;
       AddMsgText('File ');
       AddMsgText(EmulatorFile[sysID], $00a65300, [fsBold]);
       AddMsgText(' was not found. This task will be terminated.');
       GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
       Result:= False;
       Exit;
     end;
  FormStatus.SetProgressPos(0);
  if sysID = idSegaModel2 then
     begin
       if IsSEGAModel2NewVersion(EmulatorFile[sysID]) then
          tempFile:= GetFolderFull(42)+GetArcadeSystemIniSection(sysID)+'_xml.dat'
       else
          tempFile:= GetFolderFull(42)+GetArcadeSystemIniSection(sysID)+'-v1.0_xml.dat';

       //if IsSEGAModel2NewVersion(EmulatorFile[sysID]) then
       //   tempFile:= FrontendPath+GetSystemIniSection(sysID)+'_xml.dat'
       //else
       //   tempFile:= FrontendPath+GetSystemIniSection(sysID)+'-v1.0_xml.dat';
     end
  else
     tempFile:= GetFolderFull(42)+GetArcadeSystemIniSection(sysID)+'_xml.dat';

  if not FileExists(tempFile) then
     begin
       if sysID <> idDemul then
          begin
            //if GenerateMessage(TitleErrorMsg, 'File not found.', 'ClrMAMEPro XML data file was not found ['+ExtractFileName(tempFile)+'].'+#13#10+
            //                'Make sure that the file exists and click "Yes" to try again or "No" to abort.'+#13#10+
            //                'File: '+tempFile+#13#10+#13#10+'Continue ?', 1, False, 1) = mrNo then

            CallMessageBox;
            AddMsgText('ClrMAME XML database file ');
            AddMsgText(tempFile, $00a65300, [fsBold]);
            AddMsgText(' was not found. Make sure the file exists and click ');
            AddMsgText('Yes', $00a65300, [fsBold]);
            AddMsgText(' to try again or ');
            AddMsgText('No', $00a65300, [fsBold]);
            AddMsgText(' to abort.'+#13#10+#13#10+'Continue ?');
            if GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 1, False, 1) = mrNo then
               begin
                 Result:= False;
                 Exit;
               end
            else
               begin
                 if not FileExists(tempFile) then
                    begin
                      CallMessageBox;
                      AddMsgText('ClrMAME XML database file ');
                      AddMsgText(tempFile, $00a65300, [fsBold]);
                      AddMsgText(' still was not found. This task will be terminated...');
                      GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
                      Result:= False;
                      Exit;
                    end;
               end;
          end
       else
          begin
            // Demul, generate listxml with -listxml cmdline parameter
            tempFile:= FrontendPath+'temp\demul-listxml.dat';
            FileLine:= SystemStr+EmulatorFile[sysID]+SystemStr+' -listxml > '+SystemStr+tempFile+SystemStr; // -listxml
            SetCurrentDir(ExtractFilePath(EmulatorFile[sysID]));
            RunProcess(CommandPromptStr+SystemStr+FileLine+SystemStr, True, GetWindowStateEmulator);//, False); //SW_SHOWMINIMIZED, False); // WinXP / Sev7n
            SetCurrentDir(FrontendPath);
            if not FileExists(tempFile) then
               begin
                 GenerateMessage(TitleErrorMsg, 'Could not create the games list.', '    Failed to create '+
                                 'a list of ROMs for Demul (-listxml output). This task will be terminated.', 2, False, 1);
                 Result:= False;
                 Exit;
               end
            else
               romName:= tempFile;
            FileLine:= '';
          end;
     end;

  CheckAndCreateFolder(GetGamesFolderEL);

  Result:= Check_Temp_Files(tempFile);
  if not Result then
     Exit;

  tmpEmuVersion:= '';
  iVersion:= '';

  FormStatus.TitleStr('Create Games List: '+GetArcadeEmulatorDescription(sysID));
  FormStatus.MessageStr('', False);
  if not FormStatus.Visible then
     FormStatus.Show;
  FormStatus.StartThreadClock;
  SetCurrentDir(FrontendPath);
  FileLine:= '';

  if FormMain.Visible then
     FormMain.Refresh;

  MAMEGames:= THashedStringList.Create;
  if not GetGamesList(MAMEGames, 1) then
     FreeAndNil(MAMEGames);

  FormStatus.MessageStr('Parsing "'+tempFile+'" (1st pass).'+#13#10+
                        'Creating BIOS sets list.');
  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(tempFile);

  BiosSet:= THashedStringList.Create; // temporary list of bios sets, to handle romof="gameset" entry
  ListROMsBiosSet:= THashedStringList.Create; // will hold a temp list of ROMs for each bios set
  ListROMsBiosSet.BeginUpdate;

  if sysID = idDemul then
     ListDuplicateROMs:= THashedStringList.Create; // will hold a temp list of ROMs to check for duplicates (CHDs are out of this list)
                                                   // romname == CRC32 == SHA1

  FormStatus.SetFocus;
  if ListXML.Count > 0 then
  begin
    DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID));
    for MainLoop:=1 to 3 do
        DeleteFile(GetGamesFolderEL+GetSystemFileName(sysID, MainLoop));

    GameStatusList:= TStringList.Create;
    GameStatusList.BeginUpdate;

    ListGames:= TMemIniFile.Create(GetGamesFolderEL+GetSystemFileName(sysID));

    ListGames.WriteString('info_file', 'description', '');

    ROMsList:= THashedStringList.Create;
    ROMsList.BeginUpdate;
    IsResource:= False;
    GetArcadeEmulatorVersion(sysID, EmulatorFile[sysID], tmpEmuVersion, iVersion);

    BiosSet.BeginUpdate;
    // now is the tricky part, get all bios sets first
    for MainLoop:=0 to ListXML.Count-1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<game ') then
         begin
           if IsBiosSet(FileLine) then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                ROMsDetailsLine:= '';
                TempString:= '';
                Delete(FileLine, 1, 6);
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                SetDefaultSettings(sysID); // parse info from MAME
                if sysID <> idSupermodel then
                   TempGameVars.eDriverName:= FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile')); // for DICE and ZiNc...

                TempGameVars.eBiosName:= TempGameVars.eName;
                ROMsHeaderAdded:= False;

                if sysID = idDemul then
                   ListDuplicateROMs.BeginUpdate;

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
                IsResource:= True;
                //SetDefaultSettings(sysID); // get all fixed values for the system
              end;
         end
      else
      if IsResource then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                if sysID = idDemul then
                   TempGameVars.eTitle:= FixDemulBiosTitle;
                //TempGameVars.eDescription:= FixDescriptionFormat(TempGameVars.eDescription); // no need this here!!!!!!!!!
                BiosSet.Add(TempGameVars.eName);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15))
           else
           {if XML_CheckData(FileLine, '<biosset ') then
              begin
                // only usefull for Demul emulator!!!!!!!!!!!
                if not BiosSet.ValueExists('Descriptions', MemGameVariables.eName) then
                   BiosSet.WriteString('Descriptions', MemGameVariables.eName, MemGameVariables.eDescription);
                ROMsDetailsLine:= XML_GetEntryValue(FileLine, 'name'); // name of the biosset
                TempString:= DecodeHTML(XML_GetEntryValue(FileLine, 'description')); // description of the biosset
                if not BiosSet.ValueExists(MemGameVariables.eName, 'default_bios') then
                   BiosSet.WriteString(MemGameVariables.eName, 'default_bios', '');
                if not BiosSet.ValueExists(MemGameVariables.eName, 'selected_bios') then
                   BiosSet.WriteString(MemGameVariables.eName, 'selected_bios', '');
                if Pos('default="yes"', FileLine) <> 0 then
                   BiosSet.WriteString(MemGameVariables.eName, 'default_bios', ROMsDetailsLine);
                BiosSet.WriteString(MemGameVariables.eName, ROMsDetailsLine, TempString);
              end
           else}
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then // device "<disk" entry for Demul v0.7 (August 18, 2016) and newer
              begin
                ROMInfoFull:= '';
                
                romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD
                romName:= DecodeHTML(romName);

                romCRC32:= XML_GetEntryValue(FileLine, 'crc');
                romCRC32:= FixCRCEmptySpaces(romCRC32); // for Demul emulator only
                romSHA1:= XML_GetEntryValue(FileLine, 'sha1');

                TempString:= '';
                TempString:= XML_GetEntryValue(FileLine, 'size');
                if TempString <> '' then
                   TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(TempString);
                TempString:= '';

                newFileID:= 2; // newFileID is the that will be used to generate the final "ROMInfoFull" string
                BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eName;

                IsCHDFile:= PosEx('<disk ', FileLine) <> 0; // this will always be false because there is no bios CHD files
                if sysID <> idSupermodel then
                   newFileID:= 2 // is BIOS ROM, Supermodel 3 uses no BIOS sets...
                else
                   newFileID:= 0; // set game ROM for Supermodel 3... just in case

                if (sysID = idDemul) and (not IsCHDFile) then
                   begin
                      TempString:= romName+' == '+romCRC32+' == '+romSHA1;
                      if ListDuplicateROMs.IndexOf(TempString) = -1 then
                         ListDuplicateROMs.Add(TempString)
                      else
                         Exit; // file already added in the ROMs list... skip it
                    end;

                if sysID <> idSupermodel then
                   ListROMsBiosSet.Add(BiosInfoROM); // ----temp bios ROMs list (CRC32 only)!!!

                // this will go last......!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
                IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
                ROMInfoFull:= MountROMInfo(newfileID, 0, IsCHDFile, romName, romCRC32, romSHA1, IsBadDump);
                //ROMsDetailsLine:= TempString;
                if not ROMsHeaderAdded then
                   begin
                     if ROMsList.Count > 0 then
                        ROMsList.Add('');
                     ROMsList.Add('['+TempGameVars.eName+']');
                     ROMsHeaderAdded:= True;
                   end;
                ROMsList.Add(ROMInfoFull);
              end
           else
           if XML_CheckData(FileLine, '<display ') then
              begin
                TempString:= XML_GetEntryValue(FileLine, 'orientation');
                if TempString <> '' then
                   TempGameVars.eScreenOrientation:= Ord(TempString = 'vertical');
              end
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                GetButtonsEntry; // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // type="joy4way"... etc
                TempString:= XML_GetEntryValue(FileLine, 'type');
                AddControlsList(TempString);
              end
           else
           if XML_CheckData(FileLine, '</game>') then
              begin
                AddButtonsControl; // add the buttons entry only if controls is empty!!!
                // bios ID
                case sysID of
                  idDemul: TempGameVars.eROMIdentification:= 21; // Demul
                  idZiNc : TempGameVars.eROMIdentification:= 43; // ZiNc
                  // idSupermodel: TempGameVars.eROMIdentification:= 33; // Supermodel: SEGA Model 3... no more bios sets for this system!!!
                  //idSegaModel2: TempGameVars.eROMIdentification:= 27; // SEGA Model 2... no more bios sets for this system!!!
                end;
                ROMDataLine:= PopulateROMDataLineArcade;
                ListGames.WriteString('bios', TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);
                                   //TempGameVars.eName+'='+IntToStr(TempGameVars.eROMIdentification)+
                                   //                       IntToStr(TempGameVars.eGameSetStatus+
                                   //                       IntToStr(TempGameVars.eScanMode)); // new, experimental !!!!!!

                if sysID = idDemul then
                   begin
                     ListDuplicateROMs.Clear;
                     ListDuplicateROMs.EndUpdate;
                   end;
                iDriver:= '';
                IsResource:= False;
              end;
         end;
    end;
    BiosSet.EndUpdate;
    ListROMsBiosSet.EndUpdate;
    ListGames.UpdateFile;
  
    // get name, cloneof, romof fields
    // if romof, check if a bios is part of the game (parent games only!)
    FormStatus.MessageStr('Parsing "'+tempFile+'" (2nd pass).'+#13#10+
                          'Creating parent games sections in .ini file and a temporary list with parent games.');
    games_bios:= THashedStringList.Create; // this will hold parent games that have bios
    games_bios.BeginUpdate;
    FormStatus.SetProgressPos(0);
    if sysID = idDemul then
       begin
         DemulDriverName:= THashedStringList.Create; // this will hold parent game and their driver names (machine name for Demul)
         DemulDriverName.BeginUpdate;
       end;
    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if XML_CheckData(FileLine, '<game ') then
         begin
           if (PosEx('cloneof="', FileLine) = 0) then
              begin
                if not IsBiosSet(FileLine) then
                   begin
                     TempGameVars.eName:= '';
                     TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                     //TempGameVars.eDriverName:= FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile')); // no need for this here!
                     if not ListGames.SectionExists(TempGameVars.eName) then
                        ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, '');

                     if PosEx('romof="', FileLine) <> 0 then
                        begin
                          ROMOf:= XML_GetEntryValue(FileLine, 'romof');
                          if sysID = idDemul then
                             begin
                               TempGameVars.eDriverName:= ROMOf+'.c';
                               DemulDriverName.Add(TempGameVars.eName+'='+TempGameVars.eDriverName);
                             end;
                          FixDemulBiosName; // fix bios name from "awave" "awbios" and NaomiGD/Naomi2GD (Demul only!!!!!)
                          if BiosSet.IndexOf(ROMOf) <> -1 then
                             games_bios.Add(TempGameVars.eName+'='+ROMOf); // add parent game to the temp list
                        end;
                   end;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    games_bios.EndUpdate;
    if sysID = idDemul then
       DemulDriverName.EndUpdate;

    FormStatus.SetProgressPos(0);
    FormStatus.MessageStr('Parsing "'+tempFile+'" (3rd and final pass).'+#13#10+
                          'Creating games list.');
    // now, the normal games, but no resources this time (BIOS)
    IsGameEntry:= False;
    IsOldDemulVersion:= False;

    for MainLoop:=0 to ListXML.Count -1 do
    begin
      FileLine:= TrimLeft(ListXML[MainLoop]);
      if (PosEx('<game ', FileLine) <> 0) then
         begin
           if not IsBiosSet(FileLine) then
              begin
                ClearMemGameInfo(TempGameVars);
                TempGameVars.eSystemID:= sysID;
                TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                SetDefaultSettings(sysID); // get all fixed values for the system
                if sysID <> idSupermodel then
                   TempGameVars.eDriverName:= FixDriverSourceName(XML_GetEntryValue(FileLine, 'sourcefile')); // for DICE and ZiNc

                if sysID = idZiNc then
                   begin
                     // set game index for ZiNc emulator
                     TempString:= XML_GetEntryValue(FileLine, 'gameindex');
                     if TempString <> '' then
                        TempGameVars.eScreenType:= StrToInt(TempString);
                   end;

                ROMsDetailsLine:= '';
                TempString:= '';
                TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                ROMOf:= XML_GetEntryValue(FileLine, 'romof');

                if sysID = idDemul then
                   begin
                     // get the correct driver name for the machine name
                     if TempGameVars.eClone <> '' then
                        TempGameVars.eDriverName:= DemulDriverName.Values[TempGameVars.eClone]
                     else
                        TempGameVars.eDriverName:= DemulDriverName.Values[TempGameVars.eName];
                     if ROMOf = 'spider' then
                        TempGameVars.eBiosName:= 'segasp'; // manual fix
                   end;

                FixDemulBiosName;
                ROMsHeaderAdded:= False;
                IsGameEntry:= True;
                if TempGameVars.eClone <> '' then
                   TempGameVars.eBiosName:= games_bios.Values[TempGameVars.eClone]
                else
                if ROMOf <> '' then
                   begin
                     if (BiosSet.IndexOf(ROMOf) <> -1) and (TempGameVars.eBiosName = '') then
                        TempGameVars.eBiosName:= ROMOf;
                   end;
                if sysID = idDICE then
                   TempGameVars.eBiosName:= XML_GetEntryValue(FileLine, 'versionadded');
                if ((sysID = idSegaModel2) and (TempGameVars.eName = 'model2')) then
                   ListROMsBiosSet.BeginUpdate;

                if sysID = idDemul then
                   ListDuplicateROMs.BeginUpdate;

                iDriver:= ChangeFileExt(TempGameVars.eDriverName, '');
              end
         end
      else
      if IsGameEntry then
         begin
           if XML_CheckData(FileLine, '<description>') then
              begin
                TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                if sysID = idDemul then // Demul stil need to fix "Kind of Fighters, The" :_((
                  TempGameVars.eTitle:= FixDescriptionFormat(idDemul, TempGameVars.eTitle, False);
              end
           else
           if XML_CheckData(FileLine, '<year>') then
              TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
           else
           if XML_CheckData(FileLine, '<manufacturer>') then
              TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 15, PosEx('</manufacturer>', FileLine)-15))
           else
           if XML_CheckData(FileLine, '<rom ') or XML_CheckData(FileLine, '<disk ') then
              begin
                ROMInfoFull:= '';

                romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD
                romName:= DecodeHTML(romName);

                romNameMerge:= XML_GetEntryValue(FileLine, 'merge'); // name of the file (ROM/CHD/Cart/Floppy/Cassette/Disc/HD/Flash Card...) from parent game
                romNameMerge:= DecodeHTML(romNameMerge);

                romCRC32:= XML_GetEntryValue(FileLine, 'crc');
                romCRC32:= FixCRCEmptySpaces(romCRC32); // for Demul emulator only
                romSHA1:= XML_GetEntryValue(FileLine, 'sha1');

                IsCHDFile:= PosEx('<disk ', FileLine) <> 0;

                TempString:= '';
                TempString:= XML_GetEntryValue(FileLine, 'size');
                if TempString <> '' then
                   TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(TempString);
                TempString:= '';

                newFileID:= 0; // newFileID is the that will be used to generate the final "ROMInfoFull" string
                

                if (not IsCHDFile) and (sysID = idDemul) then
                   begin
                     IsCHDFile:= isDemulGD(DemulROMOf); // for Demul v0.582 and older
                     if IsCHDFile then
                        IsOldDemulVersion:= True;
                   end;

                if IsCHDFile then
                   begin
                     newFileID:= 12; // CHD files have '12' in frontend, it's not a device ROM or a bios ROM
                     //if (sysID = idDemul) and IsOldDemulVersion then
                     //   newFileID:= 0; // old Demul versions use a (.bin ISO inside gameset.zip) must be handled as regular ROMs

                     if sysID = idZiNc then
                        newFileID:= 15; // ZiNc games use CDs and not HDDs
                        
                     if sysID <> idDemul then
                        TempGameVars.eMediaType:= 1
                     else
                        begin
                          if IsOldDemulVersion then
                             TempGameVars.eMediaType:= 0; // have to set media type to ROMs because old Demul uses .bin files instead CHDs and they cannot be handled as CHDs
                        end;

                     if romNameMerge <> '' then
                        begin
                          if not SameText(ExtractFileExt(romNameMerge), '.chd') then
                             romNameMerge:= romNameMerge+'.chd';

                          //case SameText(romNameMerge, romName) of
                          //  True: romNameMerge:= '';
                          //  False:
                          //    begin
                          //      if not SameText(ExtractFileExt(romNameMerge), '.chd') then
                          //         romNameMerge:= romNameMerge+'.chd';
                          //    end;
                          //end;
                        end;
                     // Demul v0.7 use .chd files; same as MAME; old Demul builds do not have .chd files... they have .bin files inside gamename.zip
                     //if (sysID <> idDemul) or (not IsOldDemulVersion) then // Demul does not need the .chd extension as it uses .bin
                     if not IsOldDemulVersion then
                        begin
                          if not SameText(ExtractFileExt(romName), '.chd') then
                             romName:= romName+'.chd';
                        end;
                   end;

                BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName;
                if sysID = idSegaModel2 then
                   begin
                     if TempGameVars.eName <> 'model2' then
                        begin
                          //if ListROMsBiosSet.IndexOf(TempString+'=model2') <> -1 then
                          if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                             newFileID:= 2 // yes, it's a board ROM, it contains the '2' in front
                          else
                             newFileID:= 0; // no, it's a game ROM... it contains the '0' in front
                        end
                     else
                        begin
                          newFileID:= 2; // is Board ROM, SEGA Model 2 uses this internally as a bios... kinda
                          BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eName;
                          ListROMsBiosSet.Add(BiosInfoROM); // add the bios ROM from the model2.zip file (board ROMs)
                          //ListROMsBiosSet.Add(TempString+'='+TempGameVars.eName); // 04399ab8=neogeo ----temp bios ROMs list (CRC32 only)!!!
                        end;
                   end
                else
                   begin
                     if sysID = idSupermodel then
                        newFileID:= 0
                     else
                        begin
                        if not IsCHDFile then
                        // check if ROM is a bios ROM or nor... Supermodel 3 emulator doesn't have any bios sets
                           begin
                             if FormMain.ValidateBiosName(TempGameVars.eBiosName, TempGameVars.eName) then
                                begin
                                  //BiosInfoROM:='<name>'+romName+'<crc>'+romCRC32+'<sha1>'+romSHA1+'='+TempGameVars.eBiosName; // line of code already above "if sysID = idSegaModel2 then"
                                  //if ListROMsBiosSet.IndexOf(TempString+'='+TempGameVars.eBiosName) <> -1 then
                                  if ListROMsBiosSet.IndexOf(BiosInfoROM) <> -1 then
                                     newFileID:= 2 // yes, it's a bios ROM, it contains the '2' in front
                                  else
                                     newFileID:= 0; // no, it's a game ROM... it contains the '0' in front
                                end
                             else
                                newFileID:= 0;
                           end;
                        end;
                   end;
                if sysID = idDemul then
                   begin
                     if IsCHDFile then
                        begin
                          if IsOldDemulVersion then
                             begin
                               IsCHDFile:= False; // need to remove the IsCHD tag because older Demul builds v5.8.2 files (naomi2gd, naomigd) cannot be handled as CHD files!!!!!
                               newFileID:= 15; //older Demul builds v5.8.2 uses .bin files and should NOT be considered as CHD files!!!!!
                             end
                          else
                          begin
                            if TempGameVars.eDriverName = 'spider.c' then
                               newFileID:= 18 // "spider" machine name is from naomi and it requires 'segasp' bios (SEGA SP System); it's a Flash Card, not a CD or HDD
                            else
                               newFileID:= 15; // all other <disk entries are CD, not HDD
                          end;
                        end;
                   end;

                // this will go last......!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
                IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
                ROMInfoFull:= MountROMInfo(newFileID, 0, IsCHDFile, romName, romCRC32, romSHA1, IsBadDump);

                if romNameMerge <> '' then
                   ROMInfoFull[6]:= '1'; // it's a file from the parent set

                if SameText(romNameMerge, romName) then
                   romNameMerge:= ''; // set to emtpy since the name is the same as of the file from parent game

                if romNameMerge <> '' then
                   ROMInfoFull:= ROMInfoFull+MountGameInfoFieldStr('parentname', romNameMerge);

                //ROMsDetailsLine:= TempString;
                if not ROMsHeaderAdded then
                   begin
                     if ROMsList.Count > 0 then
                        ROMsList.Add('');
                     ROMsList.Add('['+TempGameVars.eName+']');
                     ROMsHeaderAdded:= True;
                   end;

                ROMsList.Add(ROMInfoFull);
              end
           else
           if XML_CheckData(FileLine, '<display ') then
              begin
                TempString:= XML_GetEntryValue(FileLine, 'orientation');
                if TempString <> '' then
                   TempGameVars.eScreenOrientation:= Ord(TempString = 'vertical');
              end
           else
           if XML_CheckData(FileLine, '<input ') then
              begin
                TempGameVars.eNumberPlayers:= XML_GetEntryValue(FileLine, 'players');
                GetButtonsEntry; // get buttons count
              end
           else
           if XML_CheckData(FileLine, '<control ') then
              begin
                // type="joy4way"... etc
                TempString:= XML_GetEntryValue(FileLine, 'type');
                AddControlsList(TempString);
              end
           else
           if XML_CheckData(FileLine, '</game>') then
              begin
                GetButtonsEntry; // get buttons count
                if ((sysID = idSegaModel2) and (TempGameVars.eName = 'model2')) then
                   ListROMsBiosSet.EndUpdate;

                // must verify if is clone or parent
                if TempGameVars.eClone = '' then
                   begin
                     // it's a parent game
                     case sysID of
                       idSupermodel: TempGameVars.eROMIdentification:= 10; // Supermodel: SEGA Model 3
                       idDemul     : TempGameVars.eROMIdentification:= 19; // Demul
                       idDICE      : TempGameVars.eROMIdentification:= 32; // DICE
                       idSegaModel2: TempGameVars.eROMIdentification:= 36; // SEGA Model 2
                       idZiNc      : TempGameVars.eROMIdentification:= 41; // ZiNc
                     end;
                   end
                else
                   begin
                     // it's a clone game
                     case sysID of
                       idSupermodel: TempGameVars.eROMIdentification:= 11; // Supermodel: SEGA Model 3
                       idDemul     : TempGameVars.eROMIdentification:= 20; // Demul
                       idDICE      : TempGameVars.eROMIdentification:= 33; // DICE
                       idSegaModel2: TempGameVars.eROMIdentification:= 37; // SEGA Model 2
                       idZiNc      : TempGameVars.eROMIdentification:= 42; // ZiNc
                     end;
                   end;
                ROMDataLine:= PopulateROMDataLineArcade;
                if TempGameVars.eClone = '' then
                   ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                else
                   ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                GameStatusList.Add(PopulateGameStatusDataLine);

                if sysID = idDemul then
                   begin
                     ListDuplicateROMs.Clear;
                     ListDuplicateROMs.EndUpdate;
                   end;

                iDriver:= '';
                IsGameEntry:= False;
              end;
         end;
      FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
      Application.ProcessMessages;
    end;
    ROMsList.EndUpdate;
    GameStatusList.EndUpdate;
  end;
  FormStatus.MessageStr('Saving files and freeing memory.');

  if sysID = idDemul then
     FreeAndNil(ListDuplicateROMs); // free this THashedStringList here

  EmulatorDateTime[sysID]:= FileAge(EmulatorFile[sysID]);
  if tmpEmuVersion = '' then
     begin
       FormStatus.MessageStr('Extracting emulator version.');
       GetArcadeEmulatorVersion(sysID, EmulatorFile[sysID], EmulatorVersion[sysID], iVersion);
     end
  else
     EmulatorVersion[sysID]:= tmpEmuVersion;
  ListGames.WriteString('info_file', 'description', GetArcadeEmulatorDescription(sysID)+' Games List');
  ListGames.WriteString('info_file', 'version', EmulatorVersion[sysID]);
  ListGames.UpdateFile;

  GameStatusList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 2));
  
  if sysID = idDemul then
     begin
       FreeAndNil(DemulDriverName);
       if FileExists(FrontendPath+'temp\demul-listxml.dat') then
          DeleteFile(FrontendPath+'temp\demul-listxml.dat');
     end;

  if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
     ROMsList.SaveToFile(GetGamesFolderEL+GetSystemFileName(sysID, 1))
  else
     begin
       CallMessageBox;
       AddMsgText('ROMs list file ');
       AddMsgText(GetGamesFolderEL+GetSystemFileName(sysID, 1), $00a65300, [fsBold]);
       AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
       GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
     end;

  FreeMemVariables;
  Application.ProcessMessages;
  if sysID = idDemul then
     CheckCRC32Collisions(sysID);
end;

function TFormMain.ReadMAMEHashFolder(sysID: ShortInt; EmulatorFileName: String; out HashFolderVar: String): Boolean;
var
  MAMEIniFile: THashedStringList;
  TextLine, IniFile, EntryString: String;
  Loop: Integer;
begin
  HashFolderVar:= '';
  iniFile:= GetArcadeEmuIniFileName(sysID, EmulatorFileName);
  if not FileExists(iniFile) then
     Exit;

  MAMEIniFile:= THashedStringList.Create;
  MAMEIniFile.LoadFromFile(iniFile);
  for Loop:=0 to MAMEIniFile.Count -1 do
  begin
    TextLine:= MAMEIniFile[Loop];
    if TextLine <> '' then
       begin
         EntryString:= XML_GetEntryName(TextLine);
         if EntryString <> '' then
            EntryString:= EntryString+' ';
         if (EntryString = 'hashpath ') or
            (EntryString = 'hash_directory ') or
            (EntryString = 'hash ') then
            HashFolderVar:= ExtractMAMEIniValue(TextLine);
       end;
  end;
  FreeAndNil(MAMEIniFile);
  if HashFolderVar = '' then
     HashFolderVar:= 'hash';
  //HashFolderVar:= FullEmuFolderFix(HashFolderVar, sysID, False);
  HashFolderVar:= FullFolderFix(HashFolderVar, EmulatorFileName);
end;

function TFormMain.FixMediaParameterStr(const ParamStr: string): String;
begin
  Result:= ParamStr;
  if (ParamStr = 'cart') or (ParamStr = 'flop') or (ParamStr = 'cass') or
     (ParamStr = 'hard')  then
     Result:= ParamStr+'1'
  else
  if (ParamStr = 'card') or (ParamStr = 'card1') or (ParamStr = 'rom') or
     (ParamStr = 'rom1') or (ParamStr = 'socket') then
     Result:= 'cart1'
  else
  if (ParamStr = 'cpm1') or (PosEx('disk', ParamStr) <> 0) or
     (PosEx('flop', ParamStr) <> 0) then
     Result:= 'flop1'
  else
  if (PosEx('cass', ParamStr) <> 0) then
     Result:= 'cass1'
  else
  if (ParamStr = 'hdd') or (ParamStr = 'hdd1') then
     Result:= 'hard1'
  else
  if (ParamStr = 'disc') then
     Result:= 'cdrom'
  else
  if (PosEx('cdrom', ParamStr) <> 0) then
     Result:= 'cdrom';
end;

function TFormMain.CreateSoftwareListXML(sysID: Byte; const SoftwareListName: String; IsMultiSlot: Boolean): Boolean;
var
  ListXML, ROMsList{, MAMEList}: THashedStringList;
  FileLine, {ROMsDetailsLine, }TempString, ROMDataLine: String;
  MainLoop: Integer;
  IsGameEntry, GetGameFiles{, HasSoftListData}, IsComment, ParseData: Boolean;
  tempFile, romName, romCRC32, romSHA1: String;
  PartName, PartTitle: String;
  TitleErrorMsg, EmuTitle: String;
  tmpList: THashedStringList;
  HasROMs, ROMsHeaderAdded, MediaTypeAdded: Boolean;
  gFileFullPath, HashFolder: String;
  GameStatusList: TStringList;
  //SoftListVars: TGameInfo;

  {function ReadHashFolder: Boolean;
  var
    MAMEIniFile: THashedStringList;
    TextLine, IniFile, EntryString: String;
    Loop: Integer;
  begin
    iniFile:= GetEmuIniFileName(sysID, EmulatorFile[sysID]);
    if not FileExists(iniFile) then
       Exit;

    MAMEIniFile:= THashedStringList.Create;
    MAMEIniFile.LoadFromFile(iniFile);
    for Loop:=0 to MAMEIniFile.Count -1 do
    begin
      TextLine:= MAMEIniFile[Loop];
      if TextLine <> '' then
         begin
           EntryString:= XML_GetEntryName(TextLine);
           if EntryString <> '' then
              EntryString:= EntryString+' ';
           if (EntryString = 'hashpath ') or
              (EntryString = 'hash_directory ') or
              (EntryString = 'hash ') then
              HashFolder:= ExtractMAMEIniValue(TextLine);
         end;
    end;
    FreeAndNil(MAMEIniFile);
    if HashFolder = '' then
       HashFolder:= 'hash';
    HashFolder:= FullEmuFolderFix(HashFolder, sysID, False);
  end;}

  function ParseROMDiskEntry(FileID: ShortInt): Boolean; // FileID (type of ROM being scanned) -> 0: <rom; 3: <disk
  var
    //IndexCHD: String[2];
    //IndexCHD: ShortInt;
    ROMInfoFull: String;
    newID, FixedID, IsBadDump: ShortInt;
    IsCHDFile: Boolean;
  begin
    // FileID for software list games (console/handheld/computer) ?????????????? July 19, 2015 ... I think NOT!
    // 0: cartridge
    // 1: disc/cd/image
    // 2: floppy disk
    // 3: cassette
    // 4: executable ??? xegs.xml (Atari 800)
    Result:= True;
    ROMInfoFull:= '';
    romName:= XML_GetEntryValue(FileLine, 'name'); // name of the ROM or CHD/ISO/Disk/Disc
    romName:= DecodeHTML(romName);

    romCRC32:= XML_GetEntryValue(FileLine, 'crc');
    romSHA1:= XML_GetEntryValue(FileLine, 'sha1');

    newID:= FileID;
    //if IsUnicodeStr(romName) then
    //   ShowMessage('unicode ROM name: '+romName+#13#10+'game name: '+TempGameVars.eName);

    //romName:= FixROMNameEqualSign(romName); // remove equal sign from file name /// REMOVE ME!!!!!!!!!!
    //IndexCHD:= IntToStr(FileID)+' '; // not needed anymore (September 07, 2016)
    //IndexCHD:= FileID; // not needed anymore (September 07, 2016)
    //IsCHDFile:= Pos('<disk ', FileLine) <> 0;
    //romName:= IndexCHD+romName; // files have '#' in front // '1 bust-a-move (1995)(snk)(jp-us)[!][puzzle bobble].chd'
    IsCHDFile:= FileID = 3;
    if IsCHDFile then // game CHD
       begin
         newID:= 12; // CHD game...
         TempGameVars.eMediaType:= 1;
         if not SameText(ExtractFileExt(romName), '.chd') then
            romName:= romName+'.chd';

         if romSHA1 = '' then
            romSHA1:= XML_GetEntryValue(FileLine, 'md5'); // for MAME 0.77 down to 0.69 .... whaa? MD5 will never be found in software list games ("mamedir\hash\" folder)
       end;

    TempString:= '';
    TempString:= XML_GetEntryValue(FileLine, 'size');
    if (TempString <> '') and (TempString[1] <> '?') then
       TempGameVars.eGameSize:= TempGameVars.eGameSize+StrToInt64(TempString);
    TempString:= '';

    // 0000<name>goonies, the (japan) (alt 2).rom/><crc>38f04741/><sha1>b7b4d5c83d8c336dbfe32833bba974cea7f0cb8d/>

    IsBadDump:= Ord(PosEx('status="baddump"', FileLine) <> 0);
    ROMInfoFull:= MountROMInfo(newID, 0, IsCHDFile, romName, romCRC32, romSHA1, IsBadDump);
    FixedID:= newID;

    if TempGameVars.eSoftwareExecParameter <> '' then
    begin
      if IsCHDFile then
        begin
          if (TempGameVars.eSoftwareExecParameter = 'cdrom') or
             (TempGameVars.eSoftwareExecParameter = 'cdrom1') then
             FixedID:= newID+3;
        end
      else
        begin
          if TempGameVars.eSoftwareExecParameter = 'cart1' then
             FixedID:= 3
          else
          if TempGameVars.eSoftwareExecParameter = 'flop1' then
             FixedID:= 6
          else
          if (TempGameVars.eSoftwareExecParameter = 'cass1') or
             (TempGameVars.eSoftwareExecParameter = 'tape') then
             FixedID:= 9;
        end;
    end;
    if FixedID <> newID then
    begin
      TempString:= Format('%.2u', [FixedID]);
      ROMInfoFull[1]:= TempString[1];
      ROMInfoFull[2]:= TempString[2];
      TempString:= '';
    end;

    if not ROMsHeaderAdded then
       begin
         if ROMsList.Count > 0 then
            ROMsList.Add(' ');            
         ROMsList.Add('['+TempGameVars.eName+']');
         ROMsHeaderAdded:= True;
       end;
    if PartName <> '' then
       begin
         ROMInfoFull:= ROMInfoFull+'<part_name>'+PartName+'/>';
         if PartTitle <> '' then
            ROMInfoFull:= ROMInfoFull+'<part_title>'+PartTitle+'/>';
       end;
    ROMsList.Add(ROMInfoFull);
    //ROMsList.Add(romName+'='+TempString);
    PartName:= '';  // force to clear this var for multi disks/cassettes
    PartTitle:= ''; // force to clear this var for multi disks/cassettes
    HasROMs:= True;
  end;

  function FreeMemVariables: Boolean;
  begin
    FreeAndNil(ListXML);
    FreeAndNil(ROMsList);
    FreeAndNil(ListGames);
    FreeAndNil(GameStatusList);
    Result:= False;
  end;

  function ReplaceChar(const iText: String; CharToReplace, NewChar: Char): String;
  var
    iPos: Integer;
  begin
    Result:= iText;
    iPos:= PosEx(CharToReplace, iText);
    while iPos > 0 do
    begin
      Result[iPos]:= NewChar;
      iPos:= PosEx(CharToReplace, iText);
    end;
  end;
  // old function... not used anymore
  //function ReplaceChar(s:string;c:char;charrep:char):string;
  //begin
  //  while pos(c,s)>0 do
  //      s[pos(c,s)]:=charrep;
  //   ReplaceChar:=s;
  //end;

  function CheckCommentInOut(const LineStr: String): Boolean;
  var
    commentInStr, commentOutStr: String;

  begin
    // July 19, 2015 - seems to be detecting comments correctly...
    Result:= LineStr <> '';
    //if not Result then
    //   Exit;
    if LineStr = '<!--' then
       IsComment:= True
    else
    if LineStr = '-->' then
       IsComment:= False
    else
    begin
      commentInStr:= Copy(LineStr, 1, 4);
      commentOutStr:= Copy(LineStr, Length(LineStr)-2, 3);

      if (commentInStr = '<!--') and (commentOutStr = '-->') then
         IsComment:= False
      else
      if commentInStr = '<!--' then
         IsComment:= True
      else
      if commentOutStr = '-->' then
         IsComment:= False;
    end;
  end;

begin
  EmuTitle:= GetArcadeEmulatorDescription(sysID, True);
  TitleErrorMsg:= 'Error: Create Software List ['+EmuTitle+']';
  if not FileExists(EmulatorFile[sysID]) then
     begin
       CallMessageBox;
       AddMsgText('File ');
       AddMsgText(EmulatorFile[sysID], $00a65300, [fsBold]);
       AddMsgText(' was not found. This task will be terminated.');
       GenerateMessage(TitleErrorMsg, 'Invalid file.', '', 2, False, 1);
       Result:= False;
       Exit;
     end;

  ReadMAMEHashFolder(sysID, EmulatorFile[sysID], HashFolder);
  tempFile:= HashFolder+SoftwareListName+'.xml';
  if not FileExists(tempFile) then
     begin
       // the file will no longer be created; user MUST have the .xml file in mamedir\hash\ folder; this is MANDATORY!!!
       //FormStatus.MessageStr('Creating "'+tempFile+'" file.');
       //if not FormStatus.Visible then
       //   FormStatus.Show;
       //FileLine:= SystemStr+EmulatorFile[sysID]+SystemStr+' -getsoftlist '+SoftwareListName+' > '+SystemStr+tempFile+SystemStr;
       //SetCurrentDir(ExtractFilePath(EmulatorFile[sysID]));
       //RunProcess(CommandPromptStr+SystemStr+FileLine+SystemStr, True, SW_SHOWMINIMIZED, False); // WinXP / Sev7n
       //SetCurrentDir(FrontendPath);
       //if not ValidateFile(tempFile) then
       //   begin
            FreeMemVariables;
            Application.ProcessMessages;
            Exit;
       //   end;
     end;
  FormStatus.SetProgressPos(0);
  //FormStatus.TitleStr('Create Software List: '+EmuTitle);
  FormStatus.MessageStr('Parsing "'+SoftwareListName+'.xml" file.');

  //if IsMultiSlot then
  //   FormStatus.MessageStr('Parsing "'+SoftwareListName+'.xml".'+#13#10+
  //                         'Creating list of multi-slot game names.') // for Neo-Geo and ST-V arcade multi-slot loading feature
  //else
  //   FormStatus.MessageStr('Parsing "'+SoftwareListName+'.xml".'+#13#10+
  //                          'Creating games list.');
  //   //FormStatus.MessageStr('Parsing "'+SoftwareListName+'.xml" (1st pass).'+#13#10+
  //   //                      'Creating parent games sections.');

  if not FormStatus.Visible then
     FormStatus.Show;
  if not IsMultiSlot then // no need for neogeo, stv as this function will be called when creating MAME games list
     FormStatus.StartThreadClock; // only for MESS softwarelist.xml files (mamedir\hash\ folder)

  ListXML:= THashedStringList.Create;
  ListXML.LoadFromFile(tempFile);

  gFileFullPath:= GetGamesFolderEL(Ord(not IsMultiSlot));
  FormStatus.SetFocus;

  if IsMultiSlot then
  begin
    // generates a list of games for the arcade multi-slot loading (neogeo; stv)
    if ListXML.Count > 0 then
    begin
      CheckAndCreateFolder(gFileFullPath);
      DeleteFile(gFileFullPath+GetMultiCartFileName(sysID, SoftwareListName, False));
      //DeleteFile(gFileFullPath+SoftwareListName+'.ini');

      tmpList:= THashedStringList.Create;
      tmpList.BeginUpdate;
      for MainLoop:=0 to ListXML.Count -1 do
      begin
        FileLine:= TrimLeft(ListXML[MainLoop]);
        if FileLine <> '' then
        begin
          if XML_CheckData(FileLine, '<software ') then
             begin
               if PosEx('supported="no"', FileLine) = 0 then
                  begin
                    TempGameVars.eName:= '';
                    TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                    if TempGameVars.eName <> '' then
                       tmpList.Add(TempGameVars.eName);
                  end;
             end;
        end;
        Application.ProcessMessages;
      end;
      tmpList.EndUpdate;
      tmpList.SaveToFile(gFileFullPath+GetMultiCartFileName(sysID, SoftwareListName, False));
      //tmpList.SaveToFile(gFileFullPath+'multicart_'+SoftwareListName+'.ini');
      FreeAndNil(tmpList);
    end;
  end
  else
  begin
    // generates a list of games with full info and ROMs list (vectrex and others from mamedir\hash folder... only if MESS machine have softwarelist tag!
    // will have to support Ansi title and Unicode titles... possibly manufacturer field as well ?
    // usage have HTML texts... it needs DecodeHTML();
    if ListXML.Count > 0 then
    begin
      CheckAndCreateFolder(gFileFullPath);
      for MainLoop:=0 to 3 do
          DeleteFile(gFileFullPath+GetSystemFileName(sysID, MainLoop, SoftwareListName));
      //DeleteFile(gFileFullPath+SoftwareListName+'.el');
      //DeleteFile(gFileFullPath+SoftwareListName+'.elrom');

      ParseData:= False;
      IsComment:= False;

      tmpList:= THashedStringList.Create;
      tmpList.BeginUpdate;

      tmpList.Add('[info_file]');
      tmpList.Add('description=');
      tmpList.Add('filedatetime='+IntToStr(FileAge(tempFile)));

      GameStatusList:= TStringList.Create;
      GameStatusList.BeginUpdate;

      // 1st pass. create EL's games list file with parent sets and their .ini sections

      for MainLoop:=0 to ListXML.Count -1 do
      begin
        FileLine:= TrimLeft(ListXML[MainLoop]);
        if FileLine <> '' then
        begin
          if not ParseData then
             begin
               if XML_CheckData(FileLine, '<softwarelist') then
                  ParseData:= True;
             end
          else
          begin
            CheckCommentInOut(FileLine);
            if not IsComment then
            begin
              if XML_CheckData(FileLine, '<software ') then
                 begin
                   if (PosEx('cloneof="', FileLine) = 0) then
                      begin
                        TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                        tmpList.Add(' ');
                        tmpList.Add('['+TempGameVars.eName+']');
                        tmpList.Add(TempGameVars.eName+'=');
                      end;
                 end;
            end;
          end;
        end;
      end;

      {for MainLoop:=0 to ListXML.Count -1 do
      begin
        FileLine:= TrimLeft(ListXML[MainLoop]);
        CheckCommentInOut(FileLine);
        if not IsComment then
        begin
          if XML_CheckData(FileLine, '<software ') then
             begin
               if (Pos('cloneof="', FileLine) = 0) then
                  begin
                    TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                    tmpList.Add('');
                    tmpList.Add('['+TempGameVars.eName+']');
                    tmpList.Add(TempGameVars.eName+'=');
                  end;
             end;
        end;
      end;}
      tmpList.EndUpdate;
      tmpList.SaveToFile(gFileFullPath+GetSystemFileName(sysID, 0, SoftwareListName));
      //tmpList.SaveToFile(gFileFullPath+SoftwareListName+'.el');
      FreeAndNil(tmpList);
      Application.ProcessMessages;
      //FormStatus.MessageStr('Parsing "'+SoftwareListName+'.xml" (2nd and final pass).'+#13#10+
      //                      'Creating games list.');
      ListGames:= TMemIniFile.Create(gFileFullPath+GetSystemFileName(sysID, 0, SoftwareListName));
      //ListGames:= TMemIniFile.Create(gFileFullPath+SoftwareListName+'.el');

      ROMsList:= THashedStringList.Create;
      ROMsList.BeginUpdate;

      IsGameEntry:= False;
      ParseData:= False;
      IsComment:= False;
      for MainLoop:=0 to ListXML.Count-1 do
      begin
        //'<softwarelist name="neogeo" description="SNK Neo-Geo cartridges">
        FileLine:= TrimLeft(ListXML[MainLoop]);
        if FileLine <> '' then
        begin
          if not ParseData then
             begin
               if XML_CheckData(FileLine, '<softwarelist') then
                  begin
                    ParseData:= True;
                    TempString:= DecodeHTML(XML_GetEntryValue(FileLine, 'description'));
                    if TempString = '' then
                       TempString:= SoftwareListName;
                    ListGames.WriteString('info_file', 'description', TempString);
                   end
             end
          else
          begin
            CheckCommentInOut(FileLine);
            if not IsComment then
            begin
            // <software name="bstarsh" cloneof="bstars">
              if (PosEx('<software ', FileLine) <> 0) then
                 begin
                   ClearMemGameInfo(TempGameVars);
                   HasROMs:= False;
                   TempGameVars.eSystemID:= sysID;
                   TempGameVars.eSystemType:= 1; // is non-arcade 0: arcade; 1: mess machines/software lists
                   TempGameVars.eName:= XML_GetEntryValue(FileLine, 'name');
                   TempGameVars.eClone:= XML_GetEntryValue(FileLine, 'cloneof');
                   // driver status
                   // -1 -> none; 0 -> Good; 1 -> Imperfect; 2 -> Preliminary
                   TempGameVars.eDriverStatus:= 0;
                   TempGameVars.eEmulationStatus:= 0;
                   if PosEx('supported="no"', FileLine) <> 0 then
                      begin
                        // means the game support is preliminary and might not work; set to Impefect driver and emulation
                        TempGameVars.eDriverStatus:= 2;
                        TempGameVars.eEmulationStatus:= 2;
                      end
                   else
                   if PosEx('supported="partial"', FileLine) <> 0 then
                      begin
                        // means the game support is imperfect and might not work; set to Impefect driver and emulation
                        TempGameVars.eDriverStatus:= 1;
                        TempGameVars.eEmulationStatus:= 1;
                      end;

                   if SoftwareListName = 'vectrex' then
                      begin
                        TempGameVars.eScreenType:= 1; // vector
                        TempGameVars.eScreenOrientation:= 1; // vertical orientation
                      end;

                   IsGameEntry:= True;
                   GetGameFiles:= False;
                   ROMsHeaderAdded:= False;
                   MediaTypeAdded:= False;
                   PartName:= '';
                   PartTitle:= '';
                 end
              else
              if IsGameEntry then
                 begin
                   if XML_CheckData(FileLine, '<description>') then
                      begin
                        TempGameVars.eTitle:= DecodeHTML(Copy(FileLine, 14, PosEx('</description>', FileLine)-14));
                        TempGameVars.eTitle:= FixDescriptionFormat(sysID, TempGameVars.eTitle, TempGameVars.eMechanical);
                      end
                   else
                   if XML_CheckData(FileLine, '<year>') then
                      TempGameVars.eYear:= Copy(FileLine, 7, PosEx('</year>', FileLine)-7)
                   else
                   if XML_CheckData(FileLine, '<publisher>') then
                      TempGameVars.eManufacturer:= DecodeHTML(Copy(FileLine, 12, PosEx('</publisher>', FileLine)-12))
                   else
                   if XML_CheckData(FileLine, '<info name="alt_title"') then
                      TempGameVars.ePlayedDateText:= XML_GetEntryValue(FileLine, 'value') // usually this is a Unicode string
                   else
                   if XML_CheckData(FileLine, '<sharedfeat name="compatibility"') then
                      TempGameVars.eSoftwareCompatible:= XML_GetEntryValue(FileLine, 'value')
                   else
                   // <info name="usage" value="Requires a Japanese system" />
                   // <info name="usage" value="Requires an Arabic MSX2" />
                   // <info name="usage" value="Requires F-Zero X cart" />
                   if XML_CheckData(FileLine, '<info name="usage"') then
                      TempGameVars.eSoftwareUsageTip:= DecodeHTML(XML_GetEntryValue(FileLine, 'value')); // value="Requires a Japanese system" />
                   // amigaaga_flop.xml
                   // <part name="flop7" interface="floppy_3_5">
                   //    <feature name="part_id" value="Disk 7" />
                   //      <dataarea name="flop" size="1049612">
                   // 	     <rom name="(sps442)biing!_diskette7.ipf" size="1049612" crc="6053d78d" sha1="b0b9ff5e400c7bc29da10d902da540b42f6370fb" offset="0"/>
                   //      </dataarea>
                   // </part>

                   // neocd.xml
                   // <part name="cdrom" interface="neocd_cdrom">
                   //   <diskarea name="cdrom">
                   //     <disk name="art of fighting 3 - path of the warrior (1996)(snk)(jp-us)[!][art of fighting - ryuuko no ken gaiden][ngcd-096, ngcd-096e]" sha1="39502261dc15f4279659ed074b1b4e62b683f266"/>
                   //   </diskarea>
                   // </part>
                   if XML_CheckData(FileLine, '<part ') then // this is the cmdline parameters that is used to load game (cart, disk, cass, flop ???)
                      begin
                        GetGameFiles:= True;
                        PartName:= XML_GetEntryValue(FileLine, 'name');
                        if not MediaTypeAdded then
                           begin
                             //PartName:= XML_GetEntryValue(FileLine, 'name');
                             TempGameVars.eSoftwareExecParameter:= FixMediaParameterStr(PartName);
                             MediaTypeAdded:= True;
                           end;
                      end
                   else
                   // <rom name="nus-ngee-0.u1" size="12582912" crc="8b70cb5b" sha1="7dd376e996d77d108316ac7ced087125c5674fa4" offset="000000" />
                   //if XML_CheckData(FileLine, '<dataarea ') or XML_CheckData(FileLine, '<diskarea ') then
                   //   begin
                   if XML_CheckData(FileLine, '<feature ') then
                      begin
                        if PosEx('name="part_id"', FileLine) <> 0 then
                           begin
                             PartTitle:= XML_GetEntryValue(FileLine, 'value');
                             PartTitle:= DecodeHTML(PartTitle);
                           end;
                      end
                   else
                   if XML_CheckData(FileLine, '<rom ') then
                      begin
                        if GetGameFiles then
                           ParseROMDiskEntry(0);
                      end
                   else
                   if XML_CheckData(FileLine, '<disk ') then
                      begin
                        if GetGameFiles then
                           ParseROMDiskEntry(3);
                      end
                   else
                   if XML_CheckData(FileLine, '</software>') then
                      begin
                        // must verify if is clone or parent, neogeo or classic, raster or vector
                        // HBMAME doesn't have software lists and it seems it never will
                        if TempGameVars.eClone = '' then
                           begin
                             // it's a parent game
                             TempGameVars.eROMIdentification:= 04; // MAME Parent
                             //case sysID of
                             //  idMAME  : TempGameVars.eROMIdentification:= 04; // MAME Parent
                             //  idHBMAME: TempGameVars.eROMIdentification:= 26; // HBMAME Parent
                             //end;
                           end
                        else
                           begin
                             // it's a clone game
                             TempGameVars.eROMIdentification:= 05; // MAME Clone
                             //case sysID of
                             //  idMAME  : TempGameVars.eROMIdentification:= 05; // MAME Clone
                             //  idHBMAME: TempGameVars.eROMIdentification:= 27; // HBMAME Clone
                             //end;
                           end;

                        ROMDataLine:= PopulateROMDataLineArcade(1); // PopulateGameLine;
                        if TempGameVars.eClone = '' then
                           ListGames.WriteString(TempGameVars.eName, TempGameVars.eName, ROMDataLine)
                        else
                           ListGames.WriteString(TempGameVars.eClone, TempGameVars.eName, ROMDataLine);

                        GameStatusList.Add(PopulateGameStatusDataLine);
                      
                        IsGameEntry:= False;
                        MediaTypeAdded:= False; // really need to be here ??? I think not...
                      end;
                 end;
              //FormStatus.UpdateProgressBar(MainLoop, ListXML.Count-1);
            end;
          end;
          Application.ProcessMessages;
        end; // end of "if FileLine <> '' then"
      end;
    end;
    //FormStatus.MessageStr('Saving files and freeing memory.');

    ListGames.UpdateFile;
    GameStatusList.EndUpdate;
    Application.ProcessMessages;
    GameStatusList.SaveToFile(gFileFullPath+GetSystemFileName(sysID, 2, SoftwareListName));

    // software lists do not have ROMs list... at least not yet!
    if (Assigned(ROMsList)) and (ROMsList.Count > 0) then
       ROMsList.SaveToFile(gFileFullPath+GetSystemFileName(sysID, 1, SoftwareListName));
    //else
    //   begin
    //     CallMessageBox;
    //     AddMsgText('ROMs list file ');
    //     AddMsgText(GetGamesFolderEL+GetSystemROMFileName(sysID), $00a65300, [fsBold]);
    //     AddMsgText(' was not created. You will not be able to scan and audit games. Please try again.');
    //     GenerateMessage(TitleErrorMsg, 'File error.', '', 2);
    //   end;
  end;
  FreeMemVariables;
  Application.ProcessMessages;
  //if not IsStartup then
  //   begin
  //     FormStatus.Close;
  //     FocusGamesList;
  //   end;
end;

procedure TFormMain.CreateListMediaMAME(sysID: ShortInt; const EmulatorFileName: String);
var
  Loop, iVersion, iPos: Integer;
  iFile, MachineName, LineStr, FullMediaStr: String; // MediaName, 
  CartridgeCount, FloppyDiskCount, CassetteCount, HardDiskCount, DiscCount: Integer;
  IsNewMachine, Continue: Boolean;
  MediaList, MediaListMachines: THashedStringList;

  function AddMediaStr(const MediaName: String; MediaCount: Integer): String;
  begin
    if MediaCount > 0 then
       FullMediaStr:= FullMediaStr+'<'+MediaName+'>'+IntToStr(MediaCount)+'/>';
  end;

begin
  //FormMain.buildMAME
  //FormMain.buildHBMAME
  if not FileExists(EmulatorFileName) then
     Exit;
  if not IsMAMEBasedSys(sysID) then
     Exit;

  iVersion:= GetMAMEBuild(sysID);
  if iVersion < 162 then
     Exit; // non-arcade machines and software lists require MAME v0.162 minimum

  iFile:= GetGamesFolderEL+GetArcadeSystemIniSection(sysID, True)+'_listmedia.tmp';

  LineStr:= SystemStr+EmulatorFileName+SystemStr+' -listmedia > '+SystemStr+iFile+SystemStr;
  SetCurrentDir(ExtractFilePath(EmulatorFileName));
  RunProcess(CommandPromptStr+SystemStr+LineStr+SystemStr, True, GetWindowStateEmulator);//, False); //SW_SHOWMINIMIZED, False); // WinXP / Sev7n
  SetCurrentDir(FrontendPath);
  LineStr:= '';

  if not ValidateFile(iFile) then
     begin
       DeleteFile(iFile);
       Exit;
     end;

  IsNewMachine:= False;
  Continue:= True;
  MediaListMachines:= THashedStringList.Create;
  MediaListMachines.BeginUpdate;
  MediaList:= THashedStringList.Create;
  MediaList.LoadFromFile(iFile);
  for Loop:=2 to MediaList.Count-1 do
  begin
    LineStr:= MediaList[Loop];
    if LineStr <> '' then
       begin
         LineStr:= LowerCase(LineStr);
         if (LineStr[1] <> '') and (not IsNewMachine) then
            begin
              AddMediaStr('cartridge', CartridgeCount);
              AddMediaStr('floppydisk', FloppyDiskCount);
              AddMediaStr('cassette', CassetteCount);
              AddMediaStr('harddisk', HardDiskCount);
              AddMediaStr('disc', DiscCount);
              if FullMediaStr <> '' then
                 MediaListMachines.Add(MachineName+FullMediaStr);

              CartridgeCount:= 0;
              FloppyDiskCount:= 0;
              CassetteCount:= 0;
              HardDiskCount:= 0;
              DiscCount:= 0;
              FullMediaStr:= '';

              MachineName:= '';
              IsNewMachine:= True;
            end;

         if IsNewMachine then
            begin
              Continue:= (PosEx('(none)', LineStr) = 0) and (PosEx('memcard', LineStr) = 0);
              if Continue then
              begin
                iPos:= PosEx(' ', LineStr);
                MachineName:= Trim(Copy(LineStr, 1, iPos));
                IsNewMachine:= False;
              end;
           end;

         if Continue then
            begin
              if PosEx('cartridge', LineStr) <> 0 then
                 Inc(CartridgeCount)
              else
              if PosEx('floppydisk', LineStr) <> 0 then
                 Inc(FloppyDiskCount)
              else
              if PosEx('cassette', LineStr) <> 0 then
                 Inc(CassetteCount)
              else
              if PosEx('harddisk', LineStr) <> 0 then
                 Inc(FloppyDiskCount)
              else
              if PosEx('cdrom', LineStr) <> 0 then
                 Inc(DiscCount);
            end;
       end;
  end;
  MediaListMachines.EndUpdate;
  if MediaListMachines.Count > 0 then
     MediaListMachines.SaveToFile(GetGamesFolderEL+GetArcadeSystemIniSection(sysID, True)+'_listmedia.txt');
  FreeAndNil(MediaListMachines);
  FreeAndNil(MediaList);
  DeleteFile(iFile);
end;

procedure TFormMain.UpdateGamesFilterHint;
var
  filters_file: THashedStringList;
  strFilter: String;
begin
  if SelectedFilterName = 'favorites' then
     Exit;
  if not FileExists(GetFolderFull(43)+'mame_filters.ini') then
     Exit;

  try
    filters_file:= THashedStringList.Create;
    filters_file.LoadFromFile(GetFolderFull(43)+'mame_filters.ini');
    strFilter:= filters_file.Values[SelectedFilterName];
  finally
    FreeAndNil(filters_file);
  end;
  if strFilter <> '' then
     ButtonGameFilterMain.Hint:= 'Selected MAME and arcade games filter'+#13#10+' -> '+strFilter
  else
     ButtonGameFilterMain.Hint:= 'Selected MAME and arcade games filter';
end;

function TFormMain.GetROMFields(const ListHolder: THashedStringList; Index: Integer; ForceSysID: ShortInt = -1): Boolean;
var
  TempField, tmpString: String;
  BiosEmptyMsg, IsArcadeEntry: Boolean;
begin
  TempField:= '';
  TempGameVars.eName:= ListHolder.Names[Index];
  TempGameVars.eMechanical:= False; // reset mechanical tag to FALSE to avoid errors
  TempGameVars.eGameSize:= 0; // set to zero just in case...
  tmpString:= ListHolder.ValueFromIndex[Index];
  Result:= tmpString <> '';
  if not Result then
     Exit;

  BiosEmptyMsg:= False;

  IsArcadeEntry:= PosEx('<softfile>', tmpString) = 0; // </softfile> tag is always added to software list games... and not for games from -listxml output!!!!

  // ROM_ID GameSetStatus ScanMode MergedSet are merged into the final string (uMain.GetGamesList())
  // for arcade games and MESS softwarelist games
  TempGameVars.eROMIdentification:= StrToInt(tmpString[1]+tmpString[2]);
  TempGameVars.eGameSetStatus:= StrToInt(tmpString[3]); // 0 - have; 1 - missing ROMs/CHDs; 2 - missing
  TempGameVars.eScanMode:= StrToInt(tmpString[4]); // 0 -> full scan; 1 -> quick scan; 2 -> force available
  TempGameVars.eIsMerged:= Boolean(StrToInt(tmpString[5]));

  if ForceSysID = -1 then
  begin
    case TempGameVars.eROMIdentification of
          -1: TempGameVars.eSystemID:= -1; // Unknown, error... this case will NEVER happen!!!
      00..07: TempGameVars.eSystemID:= idMAME;      //1;  // MAME
      08..11: TempGameVars.eSystemID:= idSupermodel;//2;  // Supermodel: SEGA Model 3
      12..15: TempGameVars.eSystemID:= idDaphne;    //3;  // Daphne
      16..21: TempGameVars.eSystemID:= idDemul;     //4;  // Demul
      22..29: TempGameVars.eSystemID:= idHBMAME;    //5;  // HBMAME
      30..33: TempGameVars.eSystemID:= idDICE;      //6;  // DICE
      34..37: TempGameVars.eSystemID:= idSegaModel2;//7;  // SEGA Model 2
      38..43: TempGameVars.eSystemID:= idZiNc;      //8;  // ZiNc
    end;
  end;
  
  {
    Result:= Result+MountGameInfoFieldStr('title', TempGameVars.eTitle);
    Result:= Result+MountGameInfoFieldStr('year', TempGameVars.eYear);
    Result:= Result+MountGameInfoFieldStr('manuf', TempGameVars.eManufacturer);
    Result:= Result+MountGameInfoFieldStr('ctrl', TempGameVars.eControls);
    Result:= Result+MountGameInfoFieldStr('btn', IntToStr(TempGameVars.eButtonsCount));
    Result:= Result+MountGameInfoFieldStr('scrtype', IntToStr(TempGameVars.eScreenType));
    Result:= Result+MountGameInfoFieldStr('scrorient', IntToStr(TempGameVars.eScreenOrientation));
    Result:= Result+MountGameInfoFieldStr('scrres', TempGameVars.eScreenResolution);
    Result:= Result+MountGameInfoFieldStr('scrrefresh', TempGameVars.eScreenRefreshRate);
    Result:= Result+MountGameInfoFieldStr('audiotype', IntToStr(TempGameVars.eAudioType));
    Result:= Result+MountGameInfoFieldStr('drvstat', IntToStr(TempGameVars.eDriverStatus));
    Result:= Result+MountGameInfoFieldStr('bios', TempGameVars.eBiosName);
    Result:= Result+MountGameInfoFieldStr('cloneof', TempGameVars.eClone);
    Result:= Result+MountGameInfoFieldStr('drvname', TempGameVars.eDriverName);
    Result:= Result+MountGameInfoFieldStr('nplayer', TempGameVars.eNumberPlayers);
    Result:= Result+MountGameInfoFieldStr('mech', IntToStr(Ord(TempGameVars.eMechanical)));
    Result:= Result+MountGameInfoFieldStr('size', IntToStr(TempGameVars.eGameSize));
  }
  //if not IsArcadeEntry then
  //   FormStatus.MessageStr('Adding softwarelist game: '+TempGameVars.eName);
  if IsArcadeEntry then
  begin
    TempGameVars.eMediaType:= StrToInt(tmpString[6]); // 0 -> roms; 1 -> CHD

    TempGameVars.eTitle:= SoftListGetEntryValue(tmpString, 'title');
    TempGameVars.eYear:= SoftListGetEntryValue(tmpString, 'year');
    TempGameVars.eManufacturer:= SoftListGetEntryValue(tmpString, 'manuf');
    TempGameVars.eControls:= SoftListGetEntryValue(tmpString, 'ctrl');
    TempField:= SoftListGetEntryValue(tmpString, 'btn');
    if TempField <> '' then
       TempGameVars.eButtonsCount:= StrToInt(TempField);

    TempField:= SoftListGetEntryValue(tmpString, 'scrtype');
    if TempField <> '' then
       TempGameVars.eScreenType:= StrToInt(TempField);

    TempField:= SoftListGetEntryValue(tmpString, 'scrorient');
    if TempField <> '' then
       TempGameVars.eScreenOrientation:= StrToInt(TempField);

    TempGameVars.eScreenResolution:= SoftListGetEntryValue(tmpString, 'scrres');
    TempGameVars.eScreenRefreshRate:= SoftListGetEntryValue(tmpString, 'scrrefresh');

    TempField:= SoftListGetEntryValue(tmpString, 'audiotype');
    if TempField <> '' then
       TempGameVars.eAudioType:= StrToInt(TempField);

    TempField:= SoftListGetEntryValue(tmpString, 'drvstat');
    if TempField <> '' then
       TempGameVars.eDriverStatus:= StrToInt(TempField);
    TempGameVars.eBiosName:= SoftListGetEntryValue(tmpString, 'bios');
    TempGameVars.eClone:= SoftListGetEntryValue(tmpString, 'cloneof');
    TempGameVars.eDriverName:= SoftListGetEntryValue(tmpString, 'drvname');
    TempGameVars.eNumberPlayers:= SoftListGetEntryValue(tmpString, 'nplayer');

    if PosEx('<mech>', tmpString) <> 0 then
       TempGameVars.eMechanical:= True;

    TempField:= SoftListGetEntryValue(tmpString, 'size');
    if TempField = '' then
       TempField:= '0';
    TempGameVars.eGameSize:= StrToInt64(TempField);

    if TempGameVars.eSystemID = idDaphne then
       begin
         TempGameVars.eROMsAllNoDump:= False;
         TempGameVars.eHaveGameROMs:= 1; // game have ROMs... this is needed so EL can search for gamename.zip files...!!! (October 10, 2017)
       end;

    if TempGameVars.eSystemID in [idMAME, idHBMAME] then
    begin
      if TempGameVars.eDriverStatus = 0 then // good
      begin
        TempGameVars.eEmulationStatus:= 0;
        TempGameVars.eColorStatus:= 0;
        TempGameVars.eSoundStatus:= 0;
        TempGameVars.eGraphicStatus:= 0;
      end
      else
      begin
        TempField:= SoftListGetEntryValue(tmpString, 'emustat'); // MAME and HBMAME only
        if TempField <> '' then
           TempGameVars.eEmulationStatus:= StrToInt(TempField); // MAME and HBMAME only

        TempField:= SoftListGetEntryValue(tmpString, 'clrstat'); // MAME and HBMAME only
        if TempField <> '' then
           TempGameVars.eColorStatus:= StrToInt(TempField); // MAME and HBMAME only

        TempField:= SoftListGetEntryValue(tmpString, 'sndstat'); // MAME and HBMAME only
        if TempField <> '' then
           TempGameVars.eSoundStatus:= StrToInt(TempField); // MAME and HBMAME only

        TempField:= SoftListGetEntryValue(tmpString, 'grpstat'); // MAME and HBMAME only
        if TempField <> '' then
           TempGameVars.eGraphicStatus:= StrToInt(TempField); // MAME and HBMAME only
      end;
      TempField:= SoftListGetEntryValue(tmpString, 'sta'); // MAME and HBMAME only
      if TempField <> '' then
         TempGameVars.eSaveState:= StrToInt(TempField); // MAME and HBMAME only
    end;
  end
  else
  begin
    // MESS games from software lists (mame\hash\ folder)
    // MESS machines are handled as arcade since they are from mame -listxml output
    // title, publisher might have Unicode strings and the ¬ cannot be used to separate fields

    // gamename = MediaType (1 char) <title>.........
    // polepos=1<title>Pole Position</title><year>1983</year><publisher>GCE / Namco Ltd.</publisher><media>cart</media>
    // poleposa=1<title>Pole Position (Alt)</title><year>1983</year><publisher>GCE / Namco Ltd.</publisher><cloneof>polepos</cloneof><media>cart</media>

    //TempField:= tmpString[1]+tmpString[2];
    //TempGameVars.eROMIdentification:= StrToInt(tmpString[1]+tmpString[2]);
    //TempGameVars.eGameSetStatus:= StrToInt(tmpString[3]); // 0 - have; 1 - missing ROMs/CHDs; 2 - missing
    //TempGameVars.eScanMode:= StrToInt(tmpString[4]); // 0 -> full scan; 1 -> quick scan; 2 -> force available
    //TempGameVars.eIsMerged:= Boolean(StrToInt(tmpString[5]));
    
    TempGameVars.eMediaType:= StrToInt(tmpString[6]); // 0 -> roms/cart/floppy/cassette/card; 1 -> CHD
    TempGameVars.eDriverStatus:= StrToInt(tmpString[7]); // 0 -> good; 1 -> imperfect; 2 -> preliminary (game="mygame" supported="no" supported="partial")
    TempGameVars.eEmulationStatus:= StrToInt(tmpString[8]);

    //TempGameVars.eScreenType:= StrToInt(tmpString[9]+tmpString[10]); // for future improvements if software list games have the screen type tag ??
    //TempGameVars.eScreenOrientation:= StrToInt(tmpString[11]+tmpString[12]); // for future improvements if software list games have the screen orientation tag ??

    TempGameVars.eTitle:= SoftListGetEntryValue(tmpString, 'title');
    TempGameVars.eYear:= SoftListGetEntryValue(tmpString, 'year');
    TempGameVars.eManufacturer:= SoftListGetEntryValue(tmpString, 'publisher');
    //TempGameVars.eControls:= '';
    //TempGameVars.eButtonsCount:= StrToInt(TempField);

    TempGameVars.eScreenType:= 0; // set to raster by default
    TempGameVars.eScreenOrientation:= 0; // set to horizontal by default
    //TempGameVars.eScreenResolution:= TempField;
    //TempGameVars.eScreenRefreshRate:= TempField;
    TempGameVars.eAudioType:= 0; // set to chip audio by default; there are no wav samples or discrete audio in software list games
    //TempGameVars.eDriverStatus:= StrToInt(TempField);
    //TempGameVars.eBiosName:= TempField; // not used by software lists
    TempGameVars.eClone:= SoftListGetEntryValue(tmpString, 'cloneof');
    //TempGameVars.eDriverName:= TempField;
    //TempGameVars.eNumberPlayers:= TempField;
    //TempGameVars.eMechanical:= Boolean(StrToInt(TempField));

    TempField:= SoftListGetEntryValue(tmpString, 'size');
    if TempField = '' then
       TempField:= '0';
    TempGameVars.eGameSize:= StrToInt64(TempField);

    TempGameVars.eSoftwareName:= SoftListGetEntryValue(tmpString, 'softfile');
    TempGameVars.eSoftwareExecParameter:= SoftListGetEntryValue(tmpString, 'media');
    TempGameVars.eSoftwareCompatible:= SoftListGetEntryValue(tmpString, 'compat');
    TempGameVars.eSoftwareUsageTip:= SoftListGetEntryValue(tmpString, 'usage');
    TempGameVars.eCategory:= SoftListGetEntryValue(tmpString, 'softtitle'); // description of software list files...

    //if (TempGameVars.eSoftwareExecParameter = 'cdrm') or (TempGameVars.eSoftwareExecParameter = 'hard1') then
    //   TempGameVars.eMediaType:= 1; // 0 -> rom, cart, flop, cass, card; 1 -> CHD, ISO, CD, etc

    //TempGameVars.eEmulationStatus:= StrToInt(TempField); // MAME and HBMAME only
    //TempGameVars.eColorStatus:= StrToInt(TempField); // MAME and HBMAME only
    //TempGameVars.eSoundStatus:= StrToInt(TempField); // MAME and HBMAME only
    //TempGameVars.eGraphicStatus:= StrToInt(TempField); // MAME and HBMAME only
    TempGameVars.eSystemType:= 1; // is non-arcade since game is from MESS software lists (mame\hash\ folder)

    if TempGameVars.eSoftwareName = 'vectrex' then
       begin
         TempGameVars.eScreenType:= 1; // (Vectrex is vector screen type);
         TempGameVars.eScreenOrientation:= 1; // Vextrex is a vertical oriented videogame)
       end;
  end;

  if not IsArcadeEntry then
     Exit;

  if (TempGameVars.eBiosName = '') and (TempGameVars.eSystemID <> idDICE) then
     begin
       if IsROM_Bios(TempGameVars.eROMIdentification) then
          begin
            if TempGameVars.eBiosName <> TempGameVars.eName then
               begin
                 BiosEmptyMsg:= True;
                 TempGameVars.eBiosName:= TempGameVars.eName; // this is a bios game, set bios name = game name, for MAMu_ icons (no needed anymore!!!!!)
               end;
          end;
     end;
  if BiosEmptyMsg then
     begin
       CallMessageBox;
       AddMsgText('    This is a BIOS set but ');
       AddMsgText('eBiosName', $00a65300, [fsBold]);
       AddMsgText(' field is blank! Emu Loader requires this field to have the same value as ');
       AddMsgText('eName', $00a65300, [fsBold]);
       AddMsgText(' field, except for DICE. '+#13#10+
                  'Please contact the author with details about this error.'+#13#10+#13#10+
                  'Title: ');
       AddMsgText(TempGameVars.eTitle, $00a65300, [fsBold]);
       AddMsgText(#13#10+'Name: ');
       AddMsgText(TempGameVars.eName, $00a65300, [fsBold]);
       AddMsgText(#13#10+'Driver: ');
       AddMsgText(TempGameVars.eDriverName, $00a65300, [fsBold]);
       AddMsgText(#13#10+'System: ');
       AddMsgText(GetArcadeSystemShortTitle(TempGameVars.eSystemID), $00a65300, [fsBold]);
       GenerateMessage('Warning', 'BIOS set name is blank.', '', 2, False, 1);
     end;

  //case TempGameVars.eSystemID of
  //  idDICE:
  //    begin
  //      // need to find a way to not run this when creating games lists.....
  //      TempGameVars.eVersionAdded:= TempGameVars.eBiosName;
  //      TempGameVars.eBiosName:= '';
  //    end;
  //  idSupermodel, idDemul, idSegaModel2:
  //    begin
  //      //TempGameVars.eSaveState:= 1; // supported on all games... ???
  //    end;
  //end;

  if TempGameVars.eSystemID = idDICE then
     begin
       // need to find a way to not do this when creating games lists..... ???
       // DICE doesn't have bios sets and probably never will (May 18, 2015)
       // version added is stored in the bios name, that's all (May 18, 2015)
       TempGameVars.eVersionAdded:= TempGameVars.eBiosName;
       TempGameVars.eBiosName:= '';
     end;
end;

