function TFormMain.RunProcess(const AppPath: WideString; MustWait: Boolean = False;
                              Visibility: Word = SW_SHOWNORMAL;
                              PositionX: Integer = -1; PositionY: Integer = -1): DWORD;
var
  SI: TStartupInfo;
  SIW: TStartupInfoW;
  PI: TProcessInformation;
  Proc: THandle;
  ErrorMsg: DWORD;
  AnsiStr: String;
  UnicodeStr, pExecFile: Boolean;
begin
  AnsiStr:= AppPath;
  UnicodeStr:= True; //UnicodeStr:= AnsiStr <> AppPath;
  if UnicodeStr then
     begin
       FillChar(SIW, SizeOf(SIW), #0);
       SIW.cb:= SizeOf(SIW);
       SIW.dwFlags:= StartF_UseShowWindow or StartF_UsePosition;
       //if (PositionX <> -1) or (PositionY <> -1) then
       //   SIW.dwFlags:= SIW.dwFlags or StartF_UsePosition;
       SIW.wShowWindow:= Visibility;
       if PositionX <> -1 then
          SIW.dwX:= PositionX; // left position... it works!!!
       if PositionY <> -1 then
          SIW.dwY:= PositionY; // right position... it works!!!

       pExecFile:= CreateProcessW(nil, PWideChar(AppPath),
                                  nil, nil, False, Create_New_Console+Normal_Priority_Class, nil, nil, SIW, PI);
     end
  else
     begin
       FillChar(SI, SizeOf(SI), 0);
       SI.cb:= SizeOf(SI);
       SI.dwFlags:= StartF_UseShowWindow or StartF_UsePosition;

       //if (PositionX <> -1) or (PositionY <> -1) then
       //   SI.dwFlags:= SI.dwFlags or StartF_UsePosition;

       SI.wShowWindow:= Visibility;
       if PositionX <> -1 then
          SI.dwX:= PositionX; // left position... it works!!!
       if PositionY <> -1 then
          SI.dwY:= PositionY; // right position... it works!!!

       pExecFile:= CreateProcess(nil, PChar(AnsiStr), //PChar(AppPath), // cannot use AppPath (WideString) or CreateProcess will generate an illegal operation
                                 nil, nil, False, Create_New_Console+Normal_Priority_Class, nil, nil, SI, PI);
     end;

  if not pExecFile then
     begin
       ErrorMsg:= GetLastError;
       CallMessageBox;
       AddMsgText('    Failed to create the process.'+#13#10);
       AddMsgText(AppPath, MsgTxtColors.colorFileName, [fsBold]);
       AddMsgText(#13#10+'Error Code ');
       AddMsgText(IntToStr(ErrorMsg)+': '+SysErrorMessage(ErrorMsg), clBlack, [fsBold]);
       GenerateMessage('Error', 'Run Process', '', 2, False, 1);
     end;

  Proc:= PI.hProcess;

  CloseHandle(PI.hThread);

  if IsRunningGame then
     begin
       if not FormPreferences.DisableMinimize.Checked then
          ShowWindow(Handle, SW_MINIMIZE);
     end;

  if MustWait then
     begin
       GetExitCodeProcess(Proc, Result);
       while (Result = STILL_ACTIVE) do
       begin
         Application.ProcessMessages;
         if WaitForSingleObject(Proc, 10) <> Wait_Failed then
            GetExitCodeProcess(Proc, Result);
       end;
     end;

  CloseHandle(Proc);
  Sleep(10); // give some milliseconds to update the screen after exiting the emulator
  if IsRunningGame then
     begin
       if not FormPreferences.DisableMinimize.Checked then
          begin
            ShowWindow(Handle, SW_RESTORE);
            Application.BringToFront;
            SetActiveWindow(Application.Handle);
          end;
       Application.BringToFront;
       Application.Restore;
       FormMain.SetFocus;
     end;

{---PARAMETERS------------------------------------------------------------------
AppPath: The full path and Application Name to run ie. c:winnt notepad.exe

MustWait: true if the code must be paused until the termination of the launched
  Application. false if the code must run directly after launching the app.

AppParams: Commandline params to send to the app.

Visibility:
Can have any of the following values:
  Value Meaning
  SW_HIDE Hides the window and activates another window.
  SW_MAXIMIZE Maximizes the specified window.
  SW_MINIMIZE Minimizes the specified window and activates the next top-level
    window in the Z order.
  SW_RESTORE Activates and displays the window. If the window is minimized or
    maximized, Windows restores it to its original size and position. An
    application should specify this flag when restoring a minimized window.
  SW_SHOW Activates the window and displays it in its current size and position.
  SW_SHOWDEFAULT Sets the show state based on the SW_ flag specified in the
    STARTUPINFO structure passed to the CreateProcess function by the program
    that started the application.
  SW_SHOWMAXIMIZED Activates the window and displays it as a maximized window.
  SW_SHOWMINIMIZED Activates the window and displays it as a minimized window.
  SW_SHOWMINNOACTIVE Displays the window as a minimized window. The active
    window remains active.
  SW_SHOWNA Displays the window in its current state. The active window remains
    active.
  SW_SHOWNOACTIVATE Displays a window in its most recent size and position.
    The active window remains active.
  SW_SHOWNORMAL Activates and displays a window. If the window is minimized or
    maximized, Windows restores it to its original size and position. An
    application should specify this flag when displaying the window for the
    first time.

  StartUpInfo ->
  STARTF_USEPOSITION execute and place the app to a pre-defined position in screen ????
-------------------------------------------------------------------------------}
end;

